## Lowering stage — transforms the semantically-checked `Program` into an
## `ir.Program`.  This is the decoupled middle-end: it reads only the loader's
## retained per-module `Analysis` values and emits `ir`, never reaching into the
## C backend.
##
## Mirrors the Ruby Lowering entry (lib/milk_tea/core/lowering.rb `Lowering.lower`),
## its C-name mangling (lowering/utils.rb), and root-main entry-point synthesis
## (lowering/async.rb `build_root_main_entrypoint`).
##
## The lowering walks the AST directly and resolves types from the retained
## `Analysis` (`functions` sigs and `resolved_expr_types`), falling back to
## structural type resolution when the analyzer's recorded types are permissive
## (`ty_error`).

import std.vec as vec
import std.map as map_mod
import std.str
import std.string as string
import std.stdio as stdio
import std.fmt as fmt
import std.mem.heap as heap_mod

import mtc.ir as ir
import mtc.loader.module_loader as loader
import mtc.semantic.analyzer as analyzer
import mtc.semantic.expressions as sem_exprs
import mtc.semantic.control_flow.builder as flow_builder
import mtc.semantic.control_flow.graph as flow_graph
import mtc.semantic.types as types
import mtc.parser.ast as ast
import mtc.parser.literal_parsing as lparse
import mtc.c_naming as naming
import mtc.lowering.async as async_mod
import mtc.lowering.utils as utils
import mtc.lowering.proc_renumber as proc_renumber


## A lowering-stage error.  The lowering resolves types structurally and
## uses `ty_error` as a permissive fallback; `LoweringError` is raised for
## truly unrecoverable situations.
public struct LoweringError:
    message: str
    line: ptr_uint
    column: ptr_uint
    path: str


## How a guard-style binding's visible value is read out of its storage local.
## An ordinary binding is `plain`; a `let x = v else:` / `let x = v?` binding
## reads through the projection its storage kind implies, mirroring the host's
## `local_binding(... projection:)` + `lower_bound_identifier`.
## `plain` is arm 0, so a `LocalBinding` literal that omits `projection` (every
## non-guard binding) is zero-initialised to it.
variant BindingProjection:
    plain
    nullable_storage(storage_ty: types.Type)
    option_some_value(storage_ty: types.Type)
    result_success_value(storage_ty: types.Type)
    result_failure_error(storage_ty: types.Type)


## A local/parameter binding in scope during function-body lowering: the source
## name, its C linkage name, resolved type, whether it is held by pointer, and
## how a read of the name projects the value out of `c_name`.
struct LocalBinding:
    name: str
    c_name: str
    ty: types.Type
    # The host's optional `pointer` on the read it produces: `none` for an async
    # parameter binding (`__mt_frame->param_<name>`), whose `Name` the host
    # leaves unset (frame_builder.rb's `async_resume_env_for`).
    pointer: Option[bool]
    projection: BindingProjection


## One lexical block's pending `defer` cleanups, in the order they were
## encountered.  Each `cleanups` entry is one already-lowered defer's statement
## sequence (a `defer expr` lowers to one expression statement; a `defer:` block
## lowers to several).  On block exit and before every `return`, the groups are
## flushed innermost-first and, within each group, in reverse encounter order —
## mirroring Ruby's `active_defers`/`local_defers` + `cleanup_statements`.
struct DeferGroup:
    cleanups: vec.Vec[span[ir.Stmt]]


## A foreign function's lowering info: the C function it maps to, its return
## type, and its declared parameters (carrying `as cstr` boundary projections).
## `simple` is true when the mapping is a bare name (`= c.InitWindow`) so the
## call lowers 1:1; otherwise `mapping` holds the full inline mapping
## expression (`= c.GuiSetStyle(int<-control, property, value)`) that is
## expanded with argument substitution at each call site.
struct ForeignInfo:
    c_name: str
    return_ty: types.Type
    params: span[ast.ForeignParam]
    mapping: ptr[ast.Expr]?
    simple: bool
    ## The module that declares the foreign function — an inline mapping's
    ## aliases resolve against this module's imports, not the caller's.
    owner_module: str
    ## The wrapper's type parameters, inferred from the call's arguments so a
    ## `T as const_ptr[void]` boundary resolves to the specialized type (the
    ## host's `binding.type_substitutions`).
    type_params: span[ast.TypeParam]


## A simple mapping's callee as its receiver expression and member name
## (`c.getenv`), the pair `mapping_call_return_type` resolves through the
## owner module's imports.
struct SimpleCallee:
    receiver: ptr[ast.Expr]
    name: str


## The callee of a simple mapping, unwrapping the shapes `resolve_foreign_c_name`
## recurses through: a member access is itself, a call or prefix cast unwraps
## to its callee.  None for a bare identifier (a same-module target has no
## receiver to resolve).
function simple_mapping_callee(mapping: ptr[ast.Expr]) -> Option[SimpleCallee]:
    unsafe:
        match read(mapping):
            ast.Expr.expr_member_access as ma:
                return Option[SimpleCallee].some(value = SimpleCallee(receiver = ma.receiver, name = ma.member_name))
            ast.Expr.expr_prefix_cast as pc:
                return simple_mapping_callee(pc.expression)
            ast.Expr.expr_call as call:
                return simple_mapping_callee(call.callee)
            _:
                return Option[SimpleCallee].none


## One arm of a variant, as needed by lowering: its name, payload field names and
## resolved types (empty for a no-payload arm).  The discriminant index is the
## arm's position in the owning `VariantInfo.arms`.
struct VariantArmInfo:
    name: str
    field_names: span[str]
    field_types: span[types.Type]


## Lowering-time info for a declared variant: its arms in declaration order (so a
## match/`is` can map an arm name to its discriminant index) plus the owning
## module (for cross-module resolution).
struct VariantInfo:
    module_name: str
    arms: span[VariantArmInfo]


## lower the expressions eagerly, deferring monomorphization to the worklist pass.
struct PendingSpecialization:
    module_name: str
    callee_name: str
    type_params: span[ast.TypeParam]
    type_args: span[ast.TypeArgument]
    args: span[ast.Argument]
    call_ep: ptr[ast.Expr]
    ast_function_decl: ptr[ast.Decl]


## Statement-position hoisting mode (see `begin_stmt_setup`).
enum HoistMode:
    # No window: a multi-step expression setup falls back to the inline StmtExpr.
    hm_off
    # A `return` value: the value must survive the cleanups, so the foreign
    # lowering materializes it into a `__mt_foreign_result_N` temp that the
    # cleanups (the cstr frees) follow, all before the return (the host's
    # `lower_foreign_call_statement`).
    hm_return
    # A local initializer or assignment value: the call is the statement's value
    # and the cstr frees run after the statement (the host's
    # `lower_foreign_call_components` shape).
    hm_value
    # A discarded expression (an expression statement or `let _ =`): a foreign
    # call at the root is emitted by the foreign lowering itself, without the
    # statement's line/path, and the frees follow it (the host's
    # `discard_result` shape).
    hm_discard


## The state saved when a hoisting window opens, plus the statements a closed
## window collected: `stmts` are emitted before the statement, `cleanups` after.
struct HoistSaved:
    mode: HoistMode
    stmts: vec.Vec[ir.Stmt]
    cleanups: vec.Vec[ir.Stmt]
    stmt_emitted: bool
    root_ep: ptr[ast.Expr]?
    # The statement's root expression when its expected/storage type is an
    # array: an array-returning call there is not materialized (the host's
    # `materialize_array_calls: !array_type?(…)` at return/assignment/local).
    array_exempt: ptr[ast.Expr]?


struct LowerCtx:
    module_name: str
    analysis: analyzer.Analysis
    # True while lowering the program's root module: the root async `main`'s
    # synthesized proc calls its `__async_main` constructor, not a plain `main`.
    is_root_module: bool
    locals: vec.Vec[LocalBinding]
    # Lowering-side flow refinements — the host's `FlowScope` stack
    # (`lowering/utils.rb:567-650`).  Each entry maps a local (or module-level
    # value) to its *visible*, narrowed type; `lookup_local` still answers the
    # storage type, so reads keep the declared type while inference
    # (`infer_expression_type`) and assignment targets see the refinement.
    # `lower_block` truncates the stack at block exit (the host duplicates its
    # env per block), except for the host's post-if rule, which leaves the
    # falsy refinements of a terminating else-less `if` for the rest of the
    # block.
    flow_scopes: vec.Vec[map_mod.Map[str, types.Type]]
    temp_counter: ptr_uint
    foreign_map: map_mod.Map[str, ForeignInfo]
    extern_map: map_mod.Map[str, str]
    function_returns: map_mod.Map[str, types.Type]
    inside_async: bool
    # True while lowering an async resume body: `lower_stmt` rewrites `return
    # expr` and a `?`-propagation failure into the host's inline frame
    # completion (`async_complete_statements`: result store, ready, waiter
    # wake, return) instead of a native `return`.  Set during both the
    # no-await and the CPS resume body lowering.
    async_completion_active: bool
    # True while lowering a no-await async body (the host's
    # `lower_async_non_await_statements`): its plain locals are declared without
    # a source line/path (the host's LocalDecl carries neither).
    async_nonawait_body: bool
    # Same-module variant declarations, keyed by variant name, so arm
    # constructors and match arms can resolve discriminants and payload fields.
    variants: map_mod.Map[str, VariantInfo]
    # Shared across all modules: function return types keyed by C linkage name,
    # so cross-module calls (`mod.func(...)`) can resolve their result type.
    # Borrowed pointer into the map owned by `lower`.
    # Per-module counter for `__mt_match_N` labels in struct-pattern (if/goto)
    # variant matches; mirrors Ruby's @match_label_counter.
    match_label_counter: ptr_uint
    program_returns: ptr[map_mod.Map[str, types.Type]]
    # Shared across all modules: concrete prelude (Option/Result) arm payload
    # field types, keyed by the arm's payload struct C name
    # (`Result_std_string_String_std_fs_Error_success` → `std_string_String`).
    # Populated when any context emits a concrete generic variant decl
    # (`ensure_generic_variant`), so a match in a consuming module can recover
    # `s.value` / `f.error` types even though the concrete decl was created in the
    # defining module's (separate) context.  Borrowed pointer into a map owned by
    # `lower`, mirroring `program_returns`.
    prelude_arm_field_types: ptr[map_mod.Map[str, types.Type]]
    # Specialization worklist: entries for generic function calls encountered
    # during lowering, processed after all root modules are lowered.
    pending_specializations: vec.Vec[PendingSpecialization]
    # Cache of already-monomorphized generic function bodies, keyed by the
    # specialization's qualified C name (e.g. "lib_first_int").
    specialization_cache: map_mod.Map[str, ir.Function]
    # Concrete generic struct declarations emitted during lowering, keyed by C
    # type name.  When a `Pair[int, int](...)` constructor is lowered, the
    # concrete struct decl (with resolved field types) is recorded here so it can
    # be appended to the module's structs span.
    generic_struct_decls: map_mod.Map[str, ir.StructDecl]
    # Map from a concrete struct's qualified C name (`std_vec_Vec_int`) to the
    # generic struct instance info (owner module, name, type args), enabling
    # method resolution on variables whose type has been collapsed to
    # `ty_named` by the C backend qualification pass.  Shared program-wide (via
    # pointer) so a generic instance registered while lowering one module
    # (e.g. `Vec[Server]` when qualifying a cross-module return type) is visible
    # to every other module's method resolution.
    generic_struct_instances: ptr[map_mod.Map[str, GenericReceiver]]
    spec_infos: ptr[map_mod.Map[str, SpecInfo]]
    # Map from a variant arm payload struct's C name (the `ty_named` given to a
    # match-arm binding, e.g. `mtc_parser_ast_Expr_expr_unary_op`) to that arm's
    # field info, so member access on the binding resolves field types.
    arm_payload_fields: map_mod.Map[str, VariantArmInfo]
    # All module analyses in dependency order, for cross-module lookups.
    program_analyses: span[analyzer.Analysis]
    # Raw loaded modules with parsed source files, for cross-module generic
    # function lookups. The analysis copies are occasionally incomplete
    # (mirroring Ruby's @ctx.imports ModuleBinding access).
    loaded_modules: span[loader.LoadedModule]
    # Set of specialization keys currently being lowered, used to detect cyclic
    # generic instantiations (A[T] calls B[T] calls A[T] in monomorphized
    # bodies).
    spec_in_progress: map_mod.Map[str, bool]
    # Active type-parameter substitution during monomorphized body lowering.
    # Always points to a valid map (empty during normal lowering, populated
    # during monomorphized function lowering).
    type_substitution: map_mod.Map[str, types.Type]
    # Linkage name of the function whose body is currently being lowered.  A
    # specialization created while this is set records it as its creator, which
    # the driver's wave ordering uses to place instances exactly when the host's
    # `lower_functions` fixpoint does.  Empty outside a function body.
    current_function_linkage: str
    # Whether the body currently being lowered is analyzer-instantiated source.
    # A specialization created in this context is pre-instantiated too (the
    # host's analyzer recursively analyzes generic instance bodies); synthesized
    # lowering calls clear it so their instances stay creator-gated.
    pre_instantiated_context: bool
    # Pending synthetic functions (invoke/release/retain) emitted during
    # proc lowering, to be appended after the main module iteration.
    pending_synthetic_functions: vec.Vec[ir.Function]
    # External (raw-module ABI) struct layouts registered for equality, keyed
    # by `naming.type_c_key`.  Raw modules emit no IR declarations, so the C
    # backend cannot find their fields; this carries them to
    # `Program.external_structs` (the host reads them from the type object).
    pending_external_structs: vec.Vec[ir.ExternalStructLayout]
    external_struct_keys: map_mod.Map[str, bool]
    # Pending dyn struct types (`mt_dyn_<Iface>`) and vtable artifacts.  The host's
    # C backend derives the `Types::Dyn` value structs from the dyn types in use
    # rather than carrying them in the IR, so they are routed to
    # `Program.monomorphized_structs` (see below).
    pending_dyn_structs: vec.Vec[ir.StructDecl]
    pending_dyn_vtable_structs: vec.Vec[ir.StructDecl]
    pending_dyn_constants: vec.Vec[ir.Constant]
    dyn_generated_vtables: map_mod.Map[str, bool]
    # str_buffer[N] struct type cache: N → struct_linkage_name
    str_buffer_structs: map_mod.Map[str, str]
    # Event runtime: per-event-type synthetic info (capacity, payload, linkage names).
    event_runtimes: map_mod.Map[str, EventRuntimeInfo]
    # Synthetic enums (the builtin `EventError`), the host's
    # `@artifacts.synthetic_enums`; appended after every module's enums at the
    # program level, deduped by linkage.
    pending_synthetic_enums: vec.Vec[ir.EnumDecl]
    # Pending generic variant declarations emitted during type qualification.
    pending_generic_variants: vec.Vec[ir.VariantDecl]
    # Concrete proc value structs (`mt_proc_*`).  The host's C backend collects
    # these from the proc types in use rather than carrying them in the IR, so
    # they are routed to `Program.monomorphized_structs`.
    pending_proc_structs: vec.Vec[ir.StructDecl]
    # Every synthetic value struct created while lowering (tuple `mt_tuple_*`,
    # proc envs and capture caps, async frames, dyn vtables, event runtime
    # structs and str buffers), in creation order.  Mirrors the host's single
    # `@artifacts.synthetic_structs` list, which `assemble_modules` appends
    # after all module declarations; drained there in the same order.
    pending_synthetic_structs: vec.Vec[ir.StructDecl]
    # Declarations produced by lowering an `emit` statement (the host's
    # `@artifacts.emitted_declarations`): appended after the program's synthetic
    # declarations by the driver.  Borrowed pointers into vecs owned by `lower`.
    pending_emitted_functions: ptr[vec.Vec[ir.Function]]?
    pending_emitted_structs: ptr[vec.Vec[ir.StructDecl]]?
    pending_emitted_constants: ptr[vec.Vec[ir.Constant]]?
    pending_tuple_linkages: map_mod.Map[str, bool]
    # Emitted-once guards for shared runtime types.
    subscription_emitted: bool
    event_error_emitted: bool
    # Active comptime element during inline for unrolling — used by lower_expr to
    # substitute loop variable member accesses (.type, .value) with known values.
    inline_for_element: Option[ComptimeElement]
    # Stack of pending `defer` cleanup groups, one per open lexical block during
    # function-body lowering.  `defer` appends its lowered cleanup to the top
    # group; block exit and `return` flush the groups (innermost-first, each in
    # reverse encounter order).  Mirrors Ruby's active_defers/local_defers.
    defer_stack: vec.Vec[DeferGroup]
    # Statement-position hoisting window (the host's `prepare_expression_with_cleanups`
    # split): while a statement lowers its root expression, multi-step setups
    # that used to become a `StmtExpr` (a statement-lowered foreign call's cstr/
    # address temps, call and frees) are collected here instead — `hoist_stmts`
    # is emitted before the statement, `hoist_cleanups` after it, and the mode
    # selects the host's per-statement shape.  Lazily-evaluated sub-expressions
    # suspend the window (`suspend_stmt_setup`), keeping the inline StmtExpr.
    hoist_mode: HoistMode
    hoist_stmts: vec.Vec[ir.Stmt]
    hoist_cleanups: vec.Vec[ir.Stmt]
    # Set by the foreign lowering when it emitted the statement-position call
    # itself (an `hm_discard` root): the statement arm then skips its own
    # ExpressionStmt, matching the host's `discard_result` shape (no line/path).
    hoist_stmt_emitted: bool
    # The statement-root AST expression of the current window, so the foreign
    # lowering can tell the root call from a nested one (pointer identity).
    hoist_root_ep: ptr[ast.Expr]?
    # Set by a statement arm whose expected/storage type is an array (a return
    # of an array, an array-typed assignment target or local): the root call
    # keeps its inline form instead of hoisting `__mt_array_call_<N>`.
    array_call_exempt: ptr[ast.Expr]?
    # Dynamic format-string result naming (the host's `env[:fmt_counter]` and
    # `env[:current_local_name]`): `fmt_dest_name` is the most recent local
    # declaration's C name in the current block (and its ancestors), which names
    # a format string's result temp `__fmt_<name>`; `fmt_counter` counts the
    # results per destination per function (`_2`, `_3` … suffixes).  Both reset
    # at every function body.
    fmt_dest_name: str
    fmt_counter: map_mod.Map[str, ptr_uint]
    # Whether the *current env* holds the counter map.  The host creates it
    # lazily (`env[:fmt_counter] ||= {}`) on a `duplicate_env`'d child, so a
    # child's count is invisible to the parent and to sibling blocks — only a
    # block that already inherits a visible counter continues the numbering.
    fmt_counter_visible: bool
    # Locals whose `str`/`cstr` value is backed by a C-string buffer that
    # outlives the enclosing statement — the host's `cstr_backed` bindings: a
    # string-literal initializer, a `cstr`-typed local, another cstr-backed
    # local, or a dynamic format string's result temp.  A `str as cstr` foreign
    # argument that names one of these passes its `data` pointer directly
    # instead of allocating an `mt_foreign_str_to_cstr_temp` copy
    # (`cstr_backed_expression?`); per-function, cleared at every body.
    cstr_backed_names: map_mod.Map[str, bool]
    # Inline foreign-mapping substitutions: an argument value the host does not
    # temporary-bind is bound here (parameter name → the lowered value
    # expression) and `lower_expr`'s identifier arm resolves it ahead of the
    # locals.  Populated and restored per mapping walk
    # (`lower_inline_foreign_mapping`), so nested mapping calls compose.
    mapping_replacements: map_mod.Map[str, ptr[ir.Expr]]
    # Return type of the function currently being lowered, for use by `?`
    # propagation when the propagated type differs from the enclosing function's
    # return type (e.g. `Result[bool, E]?` inside a function returning
    # `Result[Bytes, E]`).  Defaults to `void`; set in `lower_function` and
    # `lower_specialized_method` before the body is lowered.
    current_fn_return_type: types.Type
    # --- Async CPS state (active only while lowering an async function body
    # through the continuation-passing state machine). When `async_cps_active`
    # is true, `lower_stmt` spills `let`/`var` to frame fields, intercepts
    # await-valued statements into suspend/resume, and rewrites `return` to a
    # frame-result store + goto the completion label. See `lower_async_fn`.
    async_cps_active: bool
    async_frame_ptr_ty: types.Type
    async_resume_c: str
    async_result_ty: types.Type
    async_result_is_void: bool
    async_await_counter: ptr_uint
    # The host's per-function normalization temp counter
    # (`fresh_async_temp_name`, normalization.rb:475): hoisted awaits become
    # `__mt_async_tmp_<N>` local decls (field `local___mt_async_tmp_<N>`).
    async_tmp_counter: ptr_uint
    async_local_fields: vec.Vec[ir.Field]
    async_await_fields: vec.Vec[ir.Field]
    async_local_seen: map_mod.Map[str, bool]
    # Frame fields holding a dynamic format string's result, in first-encounter
    # order: the local's temp release is dropped and the frame's release/cancel
    # functions free the field instead (the host's `format_str_fields`).
    async_format_str_fields: vec.Vec[str]
    # Prepass-assigned field names for match arms whose body awaits, keyed by the
    # arm's address.  The lowering pass emits the field after the arm body (the
    # host's post-order analysis registration).
    async_match_binding_names: map_mod.Map[ptr_uint, str]
    # The frame-field index an `and`/`or` temp must occupy, captured before
    # `async_hoist_awaits` recurses into its operands and keyed by the rewritten
    # node: the host normalizer allocates the temp name after the operand
    # setups but emits its declaration first, so the field registers ahead of
    # the operand await temps that were numbered earlier.
    async_and_or_field_indices: map_mod.Map[ptr_uint, ptr_uint]
    # While-condition mode: `async_hoist_awaits` keeps each and/or operand's
    # await setup (instead of flattening it into the caller's output), so the
    # lowering can emit the normalizer's `[temp decl] ++ left_setup ++ IfStmt`
    # order.  Keyed by the rewritten and/or node.
    async_structured_setup: bool
    # One-shot: the next `lower_block` keeps CPS for its top-level statements
    # even when the body itself has no await.  The host normalizes a while
    # condition into the loop body and lowers that body as a unit; an await in
    # the condition setup therefore forces the original body onto the CF path.
    async_force_cps_body: bool
    # One-shot override for the next specialization created: whether the host
    # analyzer also *validated* that specialization's body.  The iterator
    # protocol instantiates `iter`/`next` without checking their bodies
    # (`iterator_loop_type`), so their nested instances are lowering-created
    # even though the bindings themselves are analyzer-created.
    next_spec_body_validated: Option[bool]
    async_and_or_left_setup: map_mod.Map[ptr_uint, vec.Vec[ir.Stmt]]
    async_and_or_right_setup: map_mod.Map[ptr_uint, vec.Vec[ir.Stmt]]
    # When non-null, `async_emit_await` and `async_register_local_field` push
    # through these pointers instead of the vec fields above.  This makes a
    # function's field collection immune to nested `lower_async_fn` calls — even
    # if a nested call reassigns `ctx.async_await_fields`, the pointer still
    # targets the local vec declared in this function's `has_await` branch.
    async_await_fields_ptr: ptr[vec.Vec[ir.Field]]?
    async_local_fields_ptr: ptr[vec.Vec[ir.Field]]?
    async_format_str_fields_ptr: ptr[vec.Vec[str]]?
    # Current loop's break / continue goto labels.  When non-empty, `break` and
    # `continue` statements emit `stmt_goto` to these labels instead of C's
    # native `break`/`continue`, so they correctly exit the enclosing loop even
    # when the `break`/`continue` appears inside a match lowered to a C `switch`.
    loop_break_label: str
    loop_continue_label: str
    # True while lowering a plain `while` body whose C shape makes a native
    # `continue` reach the same point as the label (the loop's condition).
    # A `continue` then lowers to `IR::ContinueStmt` (the host's
    # `loop_exit_continue` kind) instead of a goto; desugared loops (for-range
    # post statements, while-true rewrites) keep the label/goto form.
    loop_continue_native: bool
    # True while lowering a plain `while` body where a native `break` exits
    # exactly the enclosing loop (the host's `loop_exit_statement` `:break`
    # kind).  Cleared around the switch-backed match arms' bodies: a native
    # `break` inside a C `switch` would exit the switch, not the loop, so those
    # arms keep the label/goto form (the host's `switch_loop_flow`).
    loop_break_native: bool
    # `ctx.defer_stack`'s length at the current loop's entry.  A `break`/
    # `continue` flushes the defer groups opened inside the loop (the host's
    # `lower_loop_exit` cleanup preamble) before its goto; the enclosing
    # scopes' defers are untouched.
    loop_defer_depth: ptr_uint
    # Cached commonly-used types to avoid repeated ty_primitive/ty_generic calls.
    bool_ty: types.Type
    void_ty: types.Type
    ptr_void_ty: types.Type
    # Program-wide set of opaque type C keys (e.g. `std_c_stdio_FILE`), so a
    # nullable over an opaque base (`FILE?`) lowers to a nullable C pointer
    # rather than an invalid value-optional struct over an incomplete C type.
    opaque_keys: map_mod.Map[str, bool]


## Per-event runtime linkage information.  Each declared `event Name[N]`
## produces one of these; it drives the synthetic slot struct, event struct,
## and runtime functions (subscribe / subscribe_once / unsubscribe / emit).
struct EventRuntimeInfo:
    name: str
    linkage_name: str
    capacity: ptr_uint
    ## The declaring struct's sanitized owner path, empty for a module-level
    ## event (the host's `Types::Event#owner_type_name`).
    owner: str
    has_payload: bool
    payload_type: types.Type
    slot_c_name: str
    event_c_name: str
    subscribe_c_name: str
    subscribe_once_c_name: str
    subscribe_stateful_c_name: str
    subscribe_once_stateful_c_name: str
    unsubscribe_c_name: str
    emit_c_name: str
    wait_c_name: str
    wait_frame_c_name: str
    wait_ready_c_name: str
    wait_set_waiter_c_name: str
    wait_release_c_name: str
    wait_take_result_c_name: str
    wait_result_ty: types.Type


## The runtime's `Types::Event` value type (the host's `Types::Event`): the
## initialized `milkTea/debugInfo`/dump form carries name, capacity and payload,
## while the C backend renders it through the linkage.
function event_value_type(info: ref[EventRuntimeInfo]) -> types.Type:
    var ev_payload: ptr[types.Type]? = null
    if info.has_payload:
        ev_payload = types.alloc_type(info.payload_type)
    return types.Type.ty_event(
        name = info.name,
        capacity = info.capacity,
        payload_type = ev_payload,
        linkage_name = info.event_c_name,
    )


## The typed stateless listener: the host's `event_listener_function_type`,
## `fn <event>__listener(payload?) -> void`.
function event_listener_type(info: ref[EventRuntimeInfo]) -> types.Type:
    var params = vec.Vec[types.Type].create()
    var names = vec.Vec[str].create()
    if info.has_payload:
        params.push(info.payload_type)
        names.push("payload")
    return types.Type.ty_function(name = j2(info.name, "__listener"), params = params.as_span(), return_type = types.alloc_type(types.primitive("void")), variadic = false, is_proc = false, param_names = names.as_span())


## The typed stateful listener: the host's `event_stateful_listener_function_type`,
## `fn <event>__stateful_listener(ptr[void], payload?) -> void`.
function event_stateful_listener_type(info: ref[EventRuntimeInfo]) -> types.Type:
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    var params = vec.Vec[types.Type].create()
    var names = vec.Vec[str].create()
    params.push(void_ptr_ty)
    names.push("state")
    if info.has_payload:
        params.push(info.payload_type)
        names.push("payload")
    return types.Type.ty_function(name = j2(info.name, "__stateful_listener"), params = params.as_span(), return_type = types.alloc_type(types.primitive("void")), variadic = false, is_proc = false, param_names = names.as_span())


# =============================================================================
#  str_buffer[N] builtin struct
# =============================================================================

## Ensure a str_buffer[N] struct declaration is registered.  The struct has fields
## { data: array[char, N+1]; len: ptr_uint; dirty: bool }.  N is a literal integer
## encoded as ty_literal_int.  Only emits once per N.
function ensure_str_buffer_struct(ctx: ref[LowerCtx], sb_ty: types.Type) -> void:
    # Extract the string representation of the capacity arg from ty_generic("str_buffer", [N]).
    var n_str = "?"
    match sb_ty:
        types.Type.ty_generic as g:
            if g.args.len >= 1:
                unsafe:
                    n_str = types.type_to_string(read(g.args.data + 0))
        _:
            pass
    let c_name = j3("mt_str_buffer_", n_str, "")
    if ctx.str_buffer_structs.contains(c_name):
        return
    ctx.str_buffer_structs.set(c_name, c_name)
    var fields = vec.Vec[ir.Field].create()
    let char_ty = types.primitive("char")
    let ptr_uint_ty = types.primitive("ptr_uint")
    let bool_ty = ctx.bool_ty
    # The inline storage is `char data[N + 1]` (N usable bytes plus a NUL), so
    # the buffer's declared capacity is honoured rather than a fixed size.
    let n_val = parse_decimal(n_str)
    var data_ty = types.Type.ty_generic(name = "array", args = sp_type2(char_ty, types.literal_int(n_val + 1)))
    fields.push(ir.Field(name = "data", ty = data_ty))
    fields.push(ir.Field(name = "len", ty = ptr_uint_ty))
    fields.push(ir.Field(name = "dirty", ty = bool_ty))
    ctx.pending_synthetic_structs.push(ir.StructDecl(
        name = c_name, linkage_name = c_name,
        fields = fields.as_span(), packed = false, alignment = 0,
        source_module = Option[str].none,
    ))

## Lower a checked program to IR.  Every non-external module is lowered in
## dependency-first order (the root module is the last retained analysis) and the
## fragments are concatenated into one program — mirroring Ruby's
## `lower_modules` / `assemble_modules`.

## Look up the backing C type name, following type aliases across modules.
## For `type uv_handle_s = c.uv_handle_s` in `std.libuv`, this follows the
## import to `std.c.libuv.uv_handle_s` and looks up its `c_name = "uv_handle_t"`.
## For `type NativeHandle = libuv.uv_handle_t` where `libuv.uv_handle_t` is
## itself a type alias, the recursive `ty_imported` branch walks the chain.
function lookup_decl_c_name_cross(analysis: analyzer.Analysis, tv: types.Type, type_name: str, analyses: span[analyzer.Analysis]) -> Option[str]:
    # First try the current module's declarations.
    match lookup_decl_c_name(analysis, type_name):
        Option.some as cn:
            return Option[str].some(value = cn.value)
        Option.none:
            pass
    # If the type is an imported type, follow the import chain.
    match tv:
        types.Type.ty_imported as im:
            # std.c.* raw ABI types — they ARE the C types.
            if im.module_name.starts_with("std.c."):
                return lookup_decl_c_name_in_module(im.module_name, im.name, analyses)
            # Non-std.c imported types may be type aliases themselves
            # (e.g. `type uv_handle_t = c.uv_handle_t` in `std.libuv`).
            # Follow the chain through the imported module's type aliases.
            var found_a: analyzer.Analysis
            var has_a = false
            var ai: ptr_uint = 0
            while ai < analyses.len:
                var a: analyzer.Analysis
                unsafe:
                    a = read(analyses.data + ai)
                if a.module_name == im.module_name:
                    found_a = a
                    has_a = true
                    break
                ai += 1
            if has_a and found_a.type_alias_types.contains(im.name):
                let resolved_ptr = found_a.type_alias_types.get(im.name) else:
                    fatal(c"lowering: chained type alias lookup inconsistency")
                return lookup_decl_c_name_cross(analysis, unsafe: read(resolved_ptr), im.name, analyses)
        _:
            pass
    return Option[str].none


## Look up the backing c_name of a type in a specific module's analysis.
function lookup_decl_c_name_in_module(module_name: str, type_name: str, analyses: span[analyzer.Analysis]) -> Option[str]:
    var ai: ptr_uint = 0
    while ai < analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(analyses.data + ai)
        if a.module_name == module_name:
            return lookup_decl_c_name(a, type_name)
        ai += 1
    return Option[str].none


## Look up the backing C type name (`= c"..."`) for a struct, opaque, or union
## declaration by scanning the analysis' source file.  Returns `Option[str].none`
## when no backing name was provided.
function lookup_decl_c_name(analysis: analyzer.Analysis, type_name: str) -> Option[str]:
    var i: ptr_uint = 0
    while i < analysis.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(analysis.source_file.declarations.data + i)
        match d:
            ast.Decl.decl_struct as s:
                if s.name == type_name:
                    return s.c_name
            ast.Decl.decl_opaque as op:
                if op.name == type_name:
                    return op.c_name
            ast.Decl.decl_union as u:
                if u.name == type_name:
                    return u.c_name
            _:
                pass
        i += 1
    return Option[str].none


public function lower(program: loader.Program) -> ir.Program:
    let count = program.analyses.len()
    if count == 0:
        return ir.empty_program("(anonymous)", "")
    let root_ptr = program.analyses.get(program.root_index) else:
        return ir.empty_program("(anonymous)", "")
    var root = unsafe: read(root_ptr)
    let root_name = root.module_name
    # Per-compile counters (the host resets these in `Lowering#initialize`).
    async_binding_cnt = 0
    proc_counter = 0

    # Shared cross-module function return types, keyed by C linkage name, so a
    # `mod.func(...)` call in one module can resolve the result type of a
    # function defined in another.
    var program_returns = map_mod.Map[str, types.Type].create()
    # Shared prelude arm-payload field types (see LowerCtx.prelude_arm_field_types).
    # Populated by `collect_program_returns` (which resolves every function's
    # return type, emitting the concrete Option/Result decls) so it is available
    # before any module body is lowered.
    var prelude_arm_field_types = map_mod.Map[str, types.Type].create()
    # Program-wide generic-struct instance registry, shared across every module's
    # lowering so a `Vec[T]` instance registered while qualifying one module's
    # types is visible to method resolution in every other module.
    var generic_instances = map_mod.Map[str, GenericReceiver].create()
    collect_program_returns(program, ref_of(program_returns), ref_of(prelude_arm_field_types), ref_of(generic_instances))

    var constants = vec.Vec[ir.Constant].create()
    var globals = vec.Vec[ir.Global].create()
    var opaques = vec.Vec[ir.OpaqueDecl].create()
    var structs = vec.Vec[ir.StructDecl].create()
    var unions = vec.Vec[ir.UnionDecl].create()
    var enums = vec.Vec[ir.EnumDecl].create()
    var variants = vec.Vec[ir.VariantDecl].create()
    var static_asserts = vec.Vec[ir.StaticAssert].create()
    var type_aliases = vec.Vec[ir.TypeAlias].create()
    var functions = vec.Vec[ir.Function].create()

    var i: ptr_uint = 0
    var seen_structs = map_mod.Map[str, bool].create()
    var seen_variants = map_mod.Map[str, bool].create()
    var seen_functions = map_mod.Map[str, bool].create()
    var monomorphized_structs = vec.Vec[ir.StructDecl].create()
    var monomorphized_variants = vec.Vec[ir.VariantDecl].create()
    var pending_synthetic_structs = vec.Vec[ir.StructDecl].create()
    var external_structs = vec.Vec[ir.ExternalStructLayout].create()
    var seen_external_structs = map_mod.Map[str, bool].create()
    var spec_infos = map_mod.Map[str, SpecInfo].create()
    # Each module's declaration list with module-level `when` blocks expanded in
    # place.  Lowering and the placement pass must share it: the host's
    # `expanded_declarations` expands in place for both.
    var expanded_decls = map_mod.Map[str, span[ast.Decl]].create()
    var module_fragments = vec.Vec[ir.Program].create()
    var module_analyses = vec.Vec[analyzer.Analysis].create()
    var synthetic_functions = vec.Vec[ir.Function].create()
    var synthetic_enums = vec.Vec[ir.EnumDecl].create()
    # `emit`-produced declarations (the host's `@artifacts.emitted_declarations`),
    # appended after the synthetic declarations in lowering order.
    var emitted_functions = vec.Vec[ir.Function].create()
    var emitted_structs = vec.Vec[ir.StructDecl].create()
    var emitted_constants = vec.Vec[ir.Constant].create()
    while i < count:
        let a_ptr = program.analyses.get(i) else:
            i += 1
            continue
        var analysis = unsafe: read(a_ptr)
        if is_raw_module(analysis.module_kind):
            i += 1
            continue
        let is_root = i == program.root_index
        var fragment = lower_module(analysis, ref_of(program_returns), ref_of(prelude_arm_field_types), is_root, program.analyses.as_span(), program.modules.as_span(), ref_of(generic_instances), ref_of(monomorphized_structs), ref_of(monomorphized_variants), ref_of(pending_synthetic_structs), ref_of(synthetic_functions), ref_of(synthetic_enums), ptr_of(emitted_functions), ptr_of(emitted_structs), ptr_of(emitted_constants), ref_of(spec_infos), ref_of(expanded_decls))
        module_fragments.push(fragment)
        module_analyses.push(analysis)
        globals.append_span(fragment.globals)
        opaques.append_span(fragment.opaques)
        dedup_append_structs(ref_of(structs), fragment.structs, ref_of(seen_structs))
        unions.append_span(fragment.unions)
        enums.append_span(fragment.enums)
        dedup_append_variants(ref_of(variants), fragment.variants, ref_of(seen_variants))
        static_asserts.append_span(fragment.static_asserts)
        constants.append_span(fragment.constants)
        # External-struct layouts for the C backend's equality helpers, deduped
        # across modules (several modules can compare the same raw struct type).
        var efx: ptr_uint = 0
        while efx < fragment.external_structs.len:
            let layout = unsafe: read(fragment.external_structs.data + efx)
            if not seen_external_structs.contains(layout.key):
                seen_external_structs.set(layout.key, true)
                external_structs.push(layout)
            efx += 1
        # Functions are appended after the loop, reordered per module.
        i += 1

    # Synthetic enums (the builtin `EventError`) follow every module's enums —
    # the host's `all_enums.concat(@artifacts.synthetic_enums.uniq {
    # |e| e.linkage_name })`.
    var seen_enums = map_mod.Map[str, bool].create()
    var se_i: ptr_uint = 0
    while se_i < synthetic_enums.len():
        let en_decl_ptr = synthetic_enums.get(se_i) else:
            break
        var en_decl = unsafe: read(en_decl_ptr)
        if not seen_enums.contains(en_decl.linkage_name):
            seen_enums.set(en_decl.linkage_name, true)
            enums.push(en_decl)
        se_i += 1

    # Synthetic value structs registered while lowering (the host's
    # `synthetic_structs` synthetics) follow the module declarations.  The
    # `str_buffer[N]` structs are the exception: the host synthesizes them in
    # the *C backend* from the type universe, so they ride
    # `Program.str_buffer_structs` and the dumper never sees them (session 44,
    # item 8b).
    var plain_synthetic = vec.Vec[ir.StructDecl].create()
    var str_buffer_synthetic = vec.Vec[ir.StructDecl].create()
    let all_synthetic = pending_synthetic_structs.as_span()
    var syn_i: ptr_uint = 0
    while syn_i < all_synthetic.len:
        unsafe:
            let sd = read(all_synthetic.data + syn_i)
            if sd.linkage_name.starts_with("mt_str_buffer_"):
                str_buffer_synthetic.push(sd)
            else:
                plain_synthetic.push(sd)
        syn_i += 1
    dedup_append_structs(ref_of(structs), plain_synthetic.as_span(), ref_of(seen_structs))
    var ems_i: ptr_uint = 0
    while ems_i < emitted_structs.len():
        let ems_ptr = emitted_structs.get(ems_i) else:
            break
        structs.push(unsafe: read(ems_ptr))
        ems_i += 1

    # Place every module's functions in the host's order (`lower_functions` and
    # its fixpoint): a declaration pass over all modules, then further passes
    # for instances created by later declaration visits.
    var all_by_linkage = map_mod.Map[str, ir.Function].create()
    var fi: ptr_uint = 0
    while fi < module_fragments.len():
        let frag_ptr = module_fragments.get(fi) else:
            break
        let frag = unsafe: read(frag_ptr)
        var ffi: ptr_uint = 0
        while ffi < frag.functions.len:
            var f: ir.Function
            unsafe:
                f = read(frag.functions.data + ffi)
            if not all_by_linkage.contains(f.linkage_name):
                all_by_linkage.set(f.linkage_name, f)
            ffi += 1
        fi += 1
    let ordered = order_module_functions(module_analyses.as_span(), module_fragments.as_span(), ref_of(all_by_linkage), ref_of(spec_infos), ref_of(expanded_decls))
    dedup_append_functions(ref_of(functions), ordered.as_span(), ref_of(seen_functions))
    let module_fn_count = functions.len()
    # The host's program-level synthetic function list (proc invoke/release/
    # retain bodies and pfor/spawn workers) follows every module's functions.
    dedup_append_functions(ref_of(functions), synthetic_functions.as_span(), ref_of(seen_functions))
    var emf_i: ptr_uint = 0
    while emf_i < emitted_functions.len():
        let emf_ptr = emitted_functions.get(emf_i) else:
            break
        functions.push(unsafe: read(emf_ptr))
        emf_i += 1
    var emc_i: ptr_uint = 0
    while emc_i < emitted_constants.len():
        let emc_ptr = emitted_constants.get(emc_i) else:
            break
        constants.push(unsafe: read(emc_ptr))
        emc_i += 1

    # Collect type aliases from all non-raw modules. Raw (external) modules
    # define C-level types that already exist — we never emit typedefs for
    # them.  Non-raw-module aliases whose target is a std.c.* type still need a
    # C typedef when the target can be resolved to a valid C name, so the
    # module-qualified name (e.g. `std_net_NativeSocketStorage`) maps to the raw
    # C type (e.g. `struct sockaddr_storage`).
    var tai: ptr_uint = 0
    while tai < program.analyses.len():
        let ta_ptr = program.analyses.get(tai) else:
            break
        var ta_analysis = unsafe: read(ta_ptr)
        if is_raw_module(ta_analysis.module_kind):
            tai += 1
            continue
        var ta_keys = ta_analysis.type_alias_types.keys()
        while true:
            let kp = ta_keys.next() else:
                break
            let kn = unsafe: read(kp)
            let tvp = ta_analysis.type_alias_types.get(kn) else:
                break
            let tv = unsafe: read(tvp)
            # When the alias target is a std.c.* type, only emit a typedef if the
            # target has a known C declaration in the external module (e.g.
            # `sockaddr_storage` with `= c"struct sockaddr_storage"`).  Targets
            # without explicit declarations (e.g. enum fields used as types like
            # `uv_tcp_flags`) have no valid C type to map to and are skipped.
            if type_is_from_std_c(tv):
                match lookup_decl_c_name_cross(ta_analysis, tv, kn, program.analyses.as_span()):
                    Option.some:
                        pass
                    Option.none:
                        continue
            # Register the shared proc struct for a proc type alias so that
            # e.g. `type IntGenerator = proc() -> int` emits a typedef to
            # `mt_proc_proc_int` instead of a raw function pointer.  The alias's
            # target stays the proc's own function type; the C name comes from
            # the backend's type mapping.
            var qualified_tv = tv
            match tv:
                types.Type.ty_function as fnt:
                    if fnt.is_proc:
                        let proc_name = naming.proc_type_c_name(tv)
                        # An alias that is only ever referenced as a typedef
                        # never reaches `resolve_type_ref`, so nothing else
                        # registers the shared proc value struct it points at.
                        # The struct is a C-backend artifact (`Program.
                        # monomorphized_structs`), so the dumper never sees it.
                        if not proc_type_has_type_var(tv):
                            var already_registered = false
                            var mpi: ptr_uint = 0
                            while mpi < monomorphized_structs.len():
                                let existing = monomorphized_structs.get(mpi) else:
                                    break
                                if unsafe: read(existing).linkage_name == proc_name:
                                    already_registered = true
                                mpi += 1
                            if not already_registered:
                                monomorphized_structs.push(proc_struct_decl(proc_name, tv))
                _:
                    pass
            type_aliases.push(ir.TypeAlias(
                name = kn,
                qualified_name = naming.qualified_c_name(ta_analysis.module_name, kn),
                target_type = qualified_tv,
                backing_c_name = lookup_decl_c_name_cross(ta_analysis, tv, kn, program.analyses.as_span()),
            ))
        tai += 1

    let assembled = ir.Program(
        module_name = root_name,
        includes = collect_includes(program),
        constants = constants.as_span(),
        globals = globals.as_span(),
        opaques = collect_opaque_decls(program),
        structs = structs.as_span(),
        unions = unions.as_span(),
        enums = enums.as_span(),
        variants = variants.as_span(),
        static_asserts = static_asserts.as_span(),
        functions = functions.as_span(),
        type_aliases = type_aliases.as_span(),
        source_path = root.source_path,
        monomorphized_structs = monomorphized_structs.as_span(),
        monomorphized_variants = monomorphized_variants.as_span(),
        external_structs = external_structs.as_span(),
        str_buffer_structs = str_buffer_synthetic.as_span(),
    )
    return proc_renumber.renumber_program_procs(assembled, module_fn_count)


## True when a module is an external (`raw`) file, which has no lowerable body.
function is_raw_module(kind: ast.ModuleKind) -> bool:
    match kind:
        ast.ModuleKind.module_raw:
            return true
        _:
            return false


## True when a type originates from a std.c.* raw-ABI module (so its C name
## already exists in the external headers and we must not emit a typedef for
## it). Mirrors Ruby's skipping of raw-module type aliases.
function type_is_from_std_c(tv: types.Type) -> bool:
    match tv:
        types.Type.ty_imported as im:
            return im.module_name.starts_with("std.c.")
        types.Type.ty_named as n:
            return n.module_name.starts_with("std.c.")
        types.Type.ty_generic as g:
            var i: ptr_uint = 0
            while i < g.args.len:
                if type_is_from_std_c(unsafe: read(g.args.data + i)):
                    return true
                i += 1
            return false
        _:
            return false


## Append structs, deduplicating by linkage_name.
function dedup_append_structs(sink: ref[vec.Vec[ir.StructDecl]], src: span[ir.StructDecl], seen: ref[map_mod.Map[str, bool]]) -> void:
    var i: ptr_uint = 0
    while i < src.len:
        let sd = unsafe: read(src.data + i)
        if not seen.contains(sd.linkage_name):
            seen.set(sd.linkage_name, true)
            sink.push(sd)
        i += 1


## Append variants, deduplicating by linkage_name.
function dedup_append_variants(sink: ref[vec.Vec[ir.VariantDecl]], src: span[ir.VariantDecl], seen: ref[map_mod.Map[str, bool]]) -> void:
    var i: ptr_uint = 0
    while i < src.len:
        let vd = unsafe: read(src.data + i)
        if not seen.contains(vd.linkage_name):
            seen.set(vd.linkage_name, true)
            sink.push(vd)
        i += 1


## Append functions, deduplicating by linkage_name.  Monomorphized generic
## methods carry owner-module-qualified names (e.g. `std_vec_Vec_int_push`), so
## the same specialization reached from multiple caller modules is emitted once.
function dedup_append_functions(sink: ref[vec.Vec[ir.Function]], src: span[ir.Function], seen: ref[map_mod.Map[str, bool]]) -> void:
    var i: ptr_uint = 0
    while i < src.len:
        let func_decl = unsafe: read(src.data + i)
        if not seen.contains(func_decl.linkage_name):
            seen.set(func_decl.linkage_name, true)
            sink.push(func_decl)
        i += 1


## Search a source file's declarations for a function by name.  Unlike
## the analysis-based helpers, this reads the raw parsed source file directly.
function find_func_in_source(sf: ast.SourceFile, name: str) -> Option[ast.Decl]:
    var di: ptr_uint = 0
    while di < sf.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(sf.declarations.data + di)
        match d:
            ast.Decl.decl_function as f:
                if f.name == name:
                    return Option[ast.Decl].some(value = d)
            _:
                pass
        di += 1
    return Option[ast.Decl].none


## Find an imported module's analysis by its module name.  The `program_analyses`
## span is in dependency-first order; returns the first analysis whose
## `module_name` matches.
function find_imported_analysis(ctx: ref[LowerCtx], module_name: str) -> Option[analyzer.Analysis]:
    var i: ptr_uint = 0
    while i < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + i)
        if a.module_name == module_name:
            return Option[analyzer.Analysis].some(value = a)
        i += 1
    return Option[analyzer.Analysis].none


## True when `name` is a struct declared in any loaded module — searches the
## current module first, then imported modules, so generics that reference
## structs from other modules resolve during monomorphisation.
function struct_exists_in_imports(ctx: ref[LowerCtx], name: str) -> bool:
    if ctx.analysis.structs.contains(name):
        return true
    # Check imported modules.
    var import_values = ctx.analysis.imports.values()
    while true:
        let target_ptr = import_values.next() else:
            break
        let target_module = unsafe: read(target_ptr)
        match find_imported_analysis(ctx, target_module):
            Option.some as imported:
                if imported.value.structs.contains(name):
                    return true
            Option.none:
                pass
    return false


# =============================================================================
#  Monomorphized function lowering
# =============================================================================

## Lower a function body with type-parameter substitution applied: every reference
## to a type param (e.g. `T`) in locals, expressions, and the return type is
## replaced by the corresponding concrete type from `sub`.
function lower_specialized_function(ctx: ref[LowerCtx], name: str, spec_key: str, params: span[ast.Param], return_type: ptr[ast.TypeRef]?, body: ptr[ast.Stmt]?, sub: ref[map_mod.Map[str, types.Type]], body_validated: bool) -> ir.Function:
    # Reset function-level state
    ctx.locals.clear()
    ctx.temp_counter = 0
    ctx.fmt_dest_name = ""
    ctx.fmt_counter.clear()
    ctx.fmt_counter_visible = false
    ctx.cstr_backed_names.clear()
    ctx.function_returns.clear()
    var saved_current_fn = ctx.current_function_linkage
    ctx.current_function_linkage = spec_key
    # Calls inside this body were analyzer-instantiated only when the host
    # validated the specialization's body (a concrete call site); an
    # instance created by other paths (the iterator protocol) is not validated,
    # so its nested concrete calls are lowering-created and creator-gated.
    var saved_pre_instantiated = ctx.pre_instantiated_context
    ctx.pre_instantiated_context = body_validated
    var saved_type_subst = ctx.type_substitution
    ctx.type_substitution = read(sub)
    var ir_params = vec.Vec[ir.Param].create()
    var param_setup = vec.Vec[ir.Stmt].create()
    var pi: ptr_uint = 0
    while pi < params.len:
        var p: ast.Param
        unsafe:
            p = read(params.data + pi)
        # For proc/fn types, resolve via ty_function first so that type params
        # get substituted *before* proc struct conversion (otherwise unresolved
        # params leak into struct names like mt_proc_T).
        var fn_tref = p.param_type
        var p_ty: types.Type
        if fn_tref.is_proc or fn_tref.is_fn:
            let fn_type = resolve_function_type_ref(ctx, ptr_of(fn_tref))
            let substituted = substitute_type_params(ctx, fn_type, sub)
            p_ty = qualify_type(ctx, substituted)
        else:
            p_ty = qualify_type(ctx, substitute_type_params(ctx, resolve_field_type_ref(ctx, fn_tref), sub))
        let p_c = utils.c_local_name(p.name)
        let p_ptr = false
        let p_link = array_param_input_name(p_ty, p_c, ref_of(param_setup))
        ir_params.push(ir.Param(name = p.name, linkage_name = p_link, ty = p_ty, pointer = Option[bool].some(value = p_ptr)))
        ctx.locals.push(LocalBinding(name = p.name, c_name = p_c, ty = p_ty, pointer = Option[bool].some(value = p_ptr)))
        pi += 1
    var ret_ty = ctx.void_ty
    if return_type != null:
        let rt_raw = unsafe: read(unsafe: ptr[ast.TypeRef]<-return_type)
        if rt_raw.is_proc or rt_raw.is_fn:
            let fn_type = resolve_function_type_ref(ctx, unsafe: ptr[ast.TypeRef]<-return_type)
            let substituted = substitute_type_params(ctx, fn_type, sub)
            ret_ty = qualify_type(ctx, substituted)
        else:
            ret_ty = qualify_type(ctx, substitute_type_params(ctx, resolve_field_type_ref(ctx, rt_raw), sub))
    # Register the specialization's return type before lowering its body so a
    # recursive self-call resolves its type from here instead of the analyzer's
    # unsubstituted generic-body record.
    ctx.function_returns.set(spec_key, ret_ty)
    var saved_sub = ctx.type_substitution
    ctx.type_substitution = read(sub)
    # The substituted return type is the body's contextual type: `return null`
    # in `alloc[T](…) -> own[T]?` types the literal `Nullable(own[int])`, not
    # `void` (the host's `lower_return_stmt` contextual lowering).
    var saved_fn_ret = ctx.current_fn_return_type
    ctx.current_fn_return_type = ret_ty
    let body_ir = prepend_param_setup(ref_of(param_setup), lower_function_body(ctx, body))
    ctx.current_fn_return_type = saved_fn_ret
    ctx.type_substitution = saved_sub
    ctx.type_substitution = saved_type_subst
    ctx.current_function_linkage = saved_current_fn
    ctx.pre_instantiated_context = saved_pre_instantiated
    return ir.Function(
        name = name,
        linkage_name = name,
        params = ir_params.as_span(),
        return_type = ret_ty,
        body = body_ir,
        entry_point = false, public_export = false,
        method_receiver_param = false,
    )


## Replace type-parameter references (`ty_var`) in a type with their concrete
## values from the substitution map.  Other type variants pass through unchanged.
function substitute_type_params(ctx: ref[LowerCtx], ty: types.Type, sub: ref[map_mod.Map[str, types.Type]]) -> types.Type:
    match ty:
        types.Type.ty_var as v:
            let concrete = sub.get(v.name)
            if concrete != null:
                return unsafe: read(concrete)
            return ty
        types.Type.ty_imported as im:
            let concrete = sub.get(im.name)
            if concrete != null:
                return unsafe: read(concrete)
            if im.args.len > 0:
                var args = vec.Vec[types.Type].create()
                var i: ptr_uint = 0
                while i < im.args.len:
                    unsafe:
                        args.push(substitute_type_params(ctx, read(im.args.data + i), sub))
                    i += 1
                return types.Type.ty_imported(module_name = im.module_name, name = im.name, args = args.as_span())
            return ty
        types.Type.ty_named as n:
            let concrete = sub.get(n.name)
            if concrete != null:
                return unsafe: read(concrete)
            return ty
        types.Type.ty_generic as g:
            var args = vec.Vec[types.Type].create()
            var i: ptr_uint = 0
            while i < g.args.len:
                unsafe:
                    args.push(substitute_type_params(ctx, read(g.args.data + i), sub))
                i += 1
            return types.Type.ty_generic(name = g.name, args = args.as_span())
        types.Type.ty_nullable as nl:
            return types.Type.ty_nullable(base = types.alloc_type(substitute_type_params(ctx, unsafe: read(nl.base), sub)))
        types.Type.ty_function as fnt:
            var fn_params = vec.Vec[types.Type].create()
            var pi: ptr_uint = 0
            while pi < fnt.params.len:
                unsafe:
                    fn_params.push(substitute_type_params(ctx, read(fnt.params.data + pi), sub))
                pi += 1
            return types.Type.ty_function(name = fnt.name, params = fn_params.as_span(), return_type = types.alloc_type(substitute_type_params(ctx, unsafe: read(fnt.return_type), sub)), variadic = fnt.variadic, is_proc = fnt.is_proc, param_names = fnt.param_names)
        _:
            return ty


## Accessors for the shared program-wide generic-struct instance registry
## (`ctx.generic_struct_instances` is a raw pointer to the one shared map).
function generic_instance_get(ctx: ref[LowerCtx], name: str) -> ptr[GenericReceiver]?:
    return unsafe: read(ctx.generic_struct_instances).get(name)


function generic_instance_set(ctx: ref[LowerCtx], name: str, value: GenericReceiver) -> void:
    unsafe: read(ctx.generic_struct_instances).set(name, value)


function generic_instance_contains(ctx: ref[LowerCtx], name: str) -> bool:
    return unsafe: read(ctx.generic_struct_instances).contains(name)


## Create a fully initialised LowerCtx for a single module.  Every field is
## set explicitly so all code paths start from a known clean state.
function new_lowering_context(analysis: analyzer.Analysis, prog_returns: ptr[map_mod.Map[str, types.Type]], pl_field_types: ptr[map_mod.Map[str, types.Type]], prog_analyses: span[analyzer.Analysis], lod_modules: span[loader.LoadedModule], gen_instances: ptr[map_mod.Map[str, GenericReceiver]], spec_infos: ptr[map_mod.Map[str, SpecInfo]]) -> LowerCtx:
    return LowerCtx(
        module_name = analysis.module_name,
        analysis = analysis,
        is_root_module = false,
        locals = vec.Vec[LocalBinding].create(),
        flow_scopes = vec.Vec[map_mod.Map[str, types.Type]].create(),
        temp_counter = 0,
        fmt_dest_name = "",
        fmt_counter = map_mod.Map[str, ptr_uint].create(),
        fmt_counter_visible = false,
        cstr_backed_names = map_mod.Map[str, bool].create(),
        foreign_map = map_mod.Map[str, ForeignInfo].create(),
        extern_map = map_mod.Map[str, str].create(),
        function_returns = map_mod.Map[str, types.Type].create(),
        variants = map_mod.Map[str, VariantInfo].create(),
        match_label_counter = 0,
        program_returns = prog_returns,
        prelude_arm_field_types = pl_field_types,
        pending_specializations = vec.Vec[PendingSpecialization].create(),
        specialization_cache = map_mod.Map[str, ir.Function].create(),
        generic_struct_decls = map_mod.Map[str, ir.StructDecl].create(),
        generic_struct_instances = gen_instances,
        spec_infos = spec_infos,
        arm_payload_fields = map_mod.Map[str, VariantArmInfo].create(),
        program_analyses = prog_analyses,
        loaded_modules = lod_modules,
        spec_in_progress = map_mod.Map[str, bool].create(),
        type_substitution = map_mod.Map[str, types.Type].create(),
        current_function_linkage = "",
        pre_instantiated_context = true,
        pending_synthetic_functions = vec.Vec[ir.Function].create(),
        pending_external_structs = vec.Vec[ir.ExternalStructLayout].create(),
        external_struct_keys = map_mod.Map[str, bool].create(),
        pending_dyn_structs = vec.Vec[ir.StructDecl].create(),
        pending_dyn_vtable_structs = vec.Vec[ir.StructDecl].create(),
        pending_dyn_constants = vec.Vec[ir.Constant].create(),
        dyn_generated_vtables = map_mod.Map[str, bool].create(),
        str_buffer_structs = map_mod.Map[str, str].create(),
        event_runtimes = map_mod.Map[str, EventRuntimeInfo].create(),
        pending_synthetic_enums = vec.Vec[ir.EnumDecl].create(),
        pending_generic_variants = vec.Vec[ir.VariantDecl].create(),
        pending_proc_structs = vec.Vec[ir.StructDecl].create(),
        pending_synthetic_structs = vec.Vec[ir.StructDecl].create(),
        pending_emitted_functions = null,
        pending_emitted_structs = null,
        pending_emitted_constants = null,
        pending_tuple_linkages = map_mod.Map[str, bool].create(),
        subscription_emitted = false,
        event_error_emitted = false,
        inline_for_element = Option[ComptimeElement].none,
        defer_stack = vec.Vec[DeferGroup].create(),
        hoist_mode = HoistMode.hm_off,
        hoist_stmts = vec.Vec[ir.Stmt].create(),
        hoist_cleanups = vec.Vec[ir.Stmt].create(),
        hoist_stmt_emitted = false,
        hoist_root_ep = null,
        array_call_exempt = null,
        mapping_replacements = map_mod.Map[str, ptr[ir.Expr]].create(),
        inside_async = false,
        async_completion_active = false,
        async_nonawait_body = false,
        current_fn_return_type = types.primitive("void"),
        async_cps_active = false,
        async_frame_ptr_ty = types.primitive("void"),
        async_resume_c = "",
        async_result_ty = types.primitive("void"),
        async_result_is_void = true,
        async_await_counter = 0,
        async_tmp_counter = 0,
        async_local_fields = vec.Vec[ir.Field].create(),
        async_await_fields = vec.Vec[ir.Field].create(),
        async_local_seen = map_mod.Map[str, bool].create(),
        async_format_str_fields = vec.Vec[str].create(),
        async_match_binding_names = map_mod.Map[ptr_uint, str].create(),
        async_and_or_field_indices = map_mod.Map[ptr_uint, ptr_uint].create(),
        async_structured_setup = false,
        async_force_cps_body = false,
        next_spec_body_validated = Option[bool].none,
        async_and_or_left_setup = map_mod.Map[ptr_uint, vec.Vec[ir.Stmt]].create(),
        async_and_or_right_setup = map_mod.Map[ptr_uint, vec.Vec[ir.Stmt]].create(),
        async_await_fields_ptr = null,
        async_local_fields_ptr = null,
        async_format_str_fields_ptr = null,
        loop_break_label = "",
        loop_continue_label = "",
        loop_continue_native = false,
        loop_break_native = false,
        loop_defer_depth = 0,
        bool_ty = types.primitive("bool"),
        void_ty = types.primitive("void"),
        ptr_void_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void"))),
        opaque_keys = collect_opaque_keys(prog_analyses),
    )


## Build the program-wide set of opaque type C keys by scanning every module's
## declarations (including raw external `std.c.*` files) for `opaque` decls.
## Keyed by `naming.type_c_key(ty_imported(module, name))` so lowering can
## recognise an opaque type after import/alias resolution.
function collect_opaque_keys(prog_analyses: span[analyzer.Analysis]) -> map_mod.Map[str, bool]:
    var keys = map_mod.Map[str, bool].create()
    var mi: ptr_uint = 0
    while mi < prog_analyses.len:
        var analysis: analyzer.Analysis
        unsafe:
            analysis = read(prog_analyses.data + mi)
        var di: ptr_uint = 0
        while di < analysis.source_file.declarations.len:
            var d: ast.Decl
            unsafe:
                d = read(analysis.source_file.declarations.data + di)
            match d:
                ast.Decl.decl_opaque as op:
                    keys.set(naming.type_c_key(types.Type.ty_imported(module_name = analysis.module_name, name = op.name, args = span[types.Type]())), true)
                _:
                    pass
            di += 1
        mi += 1
    return keys


## Pre-scan every module's function declarations and record each one's resolved
## return type keyed by its C linkage name, so cross-module calls can look them
## up regardless of lowering order.
function collect_program_returns(program: loader.Program, sink: ref[map_mod.Map[str, types.Type]], prelude_arm_field_types: ref[map_mod.Map[str, types.Type]], gen_instances: ref[map_mod.Map[str, GenericReceiver]]) -> void:
    # Specialization metadata is only meaningful for the module fragments the
    # driver assembles; this pass discards it.
    var discarded_spec_infos = map_mod.Map[str, SpecInfo].create()
    var mi: ptr_uint = 0
    while mi < program.analyses.len():
        let a_ptr = program.analyses.get(mi) else:
            mi += 1
            continue
        var analysis = unsafe: read(a_ptr)
        var ctx = new_lowering_context(analysis, ptr_of(read(sink)), ptr_of(read(prelude_arm_field_types)), program.analyses.as_span(), program.modules.as_span(), ptr_of(read(gen_instances)), ptr_of(discarded_spec_infos))
        var di: ptr_uint = 0
        while di < analysis.source_file.declarations.len:
            var d: ast.Decl
            unsafe:
                d = read(analysis.source_file.declarations.data + di)
            match d:
                ast.Decl.decl_function as fun:
                    # A generic function's return type still carries type
                    # parameters; resolving it here (with no substitution
                    # context) would instantiate bogus concrete types.  Its
                    # specializations record their own return types.
                    if fun.type_params.len == 0:
                        let ret = resolve_return_type(ref_of(ctx), lookup_fn_sig(ref_of(ctx), fun.name), fun.return_type)
                        sink.set(naming.qualified_c_name(analysis.module_name, fun.name), ret)
                ast.Decl.decl_extern_function as ext:
                    # External functions use their bare C name as the linkage name
                    # (no module prefix), so a cross-module call `c.func(...)` can
                    # resolve the result type from that same bare-name key.
                    let ext_ret = if ext.return_type != null: resolve_return_type(ref_of(ctx), Option[analyzer.FnSig].none, ext.return_type) else: types.primitive("void")
                    sink.set(ext.name, ext_ret)
                ast.Decl.decl_foreign_function as ff:
                    # Foreign functions are called cross-module by their Milk Tea
                    # name (`libc.get_environment_variable(...)`), lowered to a
                    # module-qualified C wrapper, so register the resolved return
                    # type under that same qualified linkage key.  Without this a
                    # cross-module foreign call resolves to void and its result
                    # local is emitted `void`.
                    let ff_ret = qualify_type(ref_of(ctx), resolve_type_ref(ref_of(ctx), ff.return_type))
                    sink.set(naming.qualified_c_name(analysis.module_name, ff.name), ff_ret)
                _:
                    pass
            di += 1
        mi += 1


## The last component of a type reference's name (`Vec[T]` -> "Vec",
## `vec.Vec[T]` -> "Vec").
function type_ref_last_name(tref_ptr: ptr[ast.TypeRef]) -> str:
    let tref = unsafe: read(tref_ptr)
    if tref.name.parts.len == 0:
        return ""
    unsafe:
        return read(tref.name.parts.data + (tref.name.parts.len - 1))


## Render a type the way the host's `Type#to_s` does for the fixpoint's
## `sort_by { instance.type_arguments.map(&:to_s).join(",") }` key.  Nominal
## types (structs, variants, enums) are module-qualified; builtin generics
## (`ptr`, `span`, `array`, `Task`, …) are bare; the prelude variants belong to
## `std.option` / `std.result`.  This is intentionally separate from
## `c_naming.type_to_s_qualified`, whose output feeds C name mangling.
function spec_arg_type_to_s(t: types.Type) -> str:
    match t:
        types.Type.ty_primitive as p:
            return p.name
        types.Type.ty_str:
            return "str"
        types.Type.ty_named as n:
            if n.module_name.len > 0:
                return j3(n.module_name, ".", n.name)
            return n.name
        types.Type.ty_imported as im:
            var buf = string.String.create()
            if im.module_name.len > 0:
                buf.append(im.module_name)
                buf.append(".")
            buf.append(im.name)
            if im.args.len > 0:
                buf.append("[")
                var i: ptr_uint = 0
                while i < im.args.len:
                    if i > 0:
                        buf.append(", ")
                    unsafe:
                        buf.append(spec_arg_type_to_s(read(im.args.data + i)))
                    i += 1
                buf.append("]")
            return buf.as_str()
        types.Type.ty_generic as g:
            var buf = string.String.create()
            if g.name == "Option":
                buf.append("std.option.")
            else if g.name == "Result":
                buf.append("std.result.")
            buf.append(g.name)
            if g.args.len > 0:
                buf.append("[")
                var i: ptr_uint = 0
                while i < g.args.len:
                    if i > 0:
                        buf.append(", ")
                    unsafe:
                        buf.append(spec_arg_type_to_s(read(g.args.data + i)))
                    i += 1
                buf.append("]")
            return buf.as_str()
        types.Type.ty_nullable as nl:
            var buf = string.String.create()
            unsafe:
                buf.append(spec_arg_type_to_s(read(nl.base)))
            buf.append("?")
            return buf.as_str()
        types.Type.ty_tuple as tup:
            var buf = string.String.create()
            buf.append("(")
            var i: ptr_uint = 0
            while i < tup.elements.len:
                if i > 0:
                    buf.append(", ")
                unsafe:
                    buf.append(spec_arg_type_to_s(read(tup.elements.data + i)))
                i += 1
            buf.append(")")
            return buf.as_str()
        types.Type.ty_function as fnt:
            if fnt.is_proc:
                var buf = string.String.create()
                buf.append("proc(")
                var i: ptr_uint = 0
                while i < fnt.params.len:
                    if i > 0:
                        buf.append(", ")
                    unsafe:
                        buf.append(spec_arg_type_to_s(read(fnt.params.data + i)))
                    i += 1
                buf.append(") -> ")
                unsafe:
                    buf.append(spec_arg_type_to_s(read(fnt.return_type)))
                return buf.as_str()
            if fnt.name.len > 0:
                return j2("fn ", fnt.name)
            return "fn "
        types.Type.ty_var as v:
            return v.name
        types.Type.ty_opaque as o:
            if o.module_name.len > 0:
                return j3(o.module_name, ".", o.name)
            return o.name
        _:
            return types.type_to_string(t)


## A single visit in the host's `lower_functions` declaration walk.  A
## non-instance visit emits one function by linkage; an instance visit emits
## every *available* instance of a generic declaration / extending block method.
struct DeclVisit:
    instance: bool
    linkage: str
    owner_module: str
    decl_key: str
    ## `owner_module` + `decl_key`, precomputed for the availability map.
    owner_key: str
    is_main: bool


## Join an owner module and declaration key into one map key.  Module names and
## declaration keys never contain `@@`.
function spec_owner_key(owner_module: str, decl_key: str) -> str:
    var b = string.String.create()
    b.append(owner_module)
    b.append("@@")
    b.append(decl_key)
    return b.as_str()


## Build one module's declaration visit sequence in the host's order
## (`expanded_declarations`, `functions.rb:18-73`): functions in source order,
## an extending block's methods in source order.
function build_decl_visits(analysis: analyzer.Analysis, analyses: span[analyzer.Analysis], expanded_decls: ref[map_mod.Map[str, span[ast.Decl]]]) -> vec.Vec[DeclVisit]:
    var visits = vec.Vec[DeclVisit].create()
    let module_name = analysis.module_name
    var source_decls = analysis.source_file.declarations
    let expanded_ptr = expanded_decls.get(module_name)
    if expanded_ptr != null:
        source_decls = unsafe: read(expanded_ptr)
    var di: ptr_uint = 0
    while di < source_decls.len:
        var d: ast.Decl
        unsafe:
            d = read(source_decls.data + di)
        match d:
            ast.Decl.decl_function as fun:
                if fun.type_params.len == 0:
                    visits.push(DeclVisit(
                        instance = false,
                        linkage = naming.qualified_c_name(module_name, fun.name),
                        owner_module = "", decl_key = "", owner_key = "",
                        is_main = fun.name == "main",
                    ))
                else:
                    let dk = j2("fn:", fun.name)
                    visits.push(DeclVisit(
                        instance = true, linkage = "",
                        owner_module = module_name, decl_key = dk,
                        owner_key = spec_owner_key(module_name, dk), is_main = false,
                    ))
            ast.Decl.decl_extending_block as ex:
                let bare = unsafe: type_ref_last_name(ex.type_name)
                # Resolve the receiver the same way `lower_extending_block` does,
                # so the linkage name looked up here is the one it emitted.
                var recv_name = bare
                var receiver_ty = extending_receiver_type(module_name, bare)
                match extending_receiver_target(analyses, analysis, ex.type_name):
                    Option.some as resolved:
                        receiver_ty = resolved.value
                        match named_type_name(resolved.value):
                            Option.some as resolved_name:
                                recv_name = resolved_name.value
                            Option.none:
                                pass
                    Option.none:
                        # A nested struct target (`extending Rectangle.Edge:`)
                        # resolves through the analysis' registered types, the
                        # same way `lower_extending_block` names the method.
                        let target_parts = unsafe: read(ex.type_name).name.parts
                        match nested_type_in_analysis(analysis, target_parts):
                            Option.some as nested:
                                receiver_ty = nested.value
                            Option.none:
                                pass
                var mi: ptr_uint = 0
                while mi < ex.methods.len:
                    var m: ast.Method
                    unsafe:
                        m = read(ex.methods.data + mi)
                    if m.type_params.len > 0 or unsafe: ex.type_name.arguments.len > 0:
                        var dk = string.String.create()
                        dk.append("method:")
                        dk.append(bare)
                        dk.append(".")
                        dk.append(m.name)
                        visits.push(DeclVisit(
                            instance = true, linkage = "",
                            owner_module = module_name, decl_key = dk.as_str(),
                            owner_key = spec_owner_key(module_name, dk.as_str()), is_main = false,
                        ))
                    else:
                        visits.push(DeclVisit(
                            instance = false,
                            linkage = method_c_name_for_receiver(receiver_ty, module_name, recv_name, m.name, m.method_kind),
                            owner_module = "", decl_key = "", owner_key = "", is_main = false,
                        ))
                    mi += 1
            _:
                pass
        di += 1
    return visits


## An instance is available once the function that created it has been lowered.
## Instances created outside any function body (module constants/globals,
## synthetic setup) are available from the start; a creator that the declaration
## walk never emits is treated the same way.
function spec_creator_ready(info: SpecInfo, emittable: ref[map_mod.Map[str, bool]], emitted: ref[map_mod.Map[str, bool]], setup_reached: ref[map_mod.Map[str, bool]]) -> bool:
    if info.pre_instantiated:
        return true
    if info.creator == "":
        if info.setup_module == "":
            return true
        return setup_reached.contains(info.setup_module)
    if not emittable.contains(info.creator):
        return true
    return emitted.contains(info.creator)


## Append a function to one module's ordered result list.
function push_module_function(per_module: ref[vec.Vec[vec.Vec[ir.Function]]], mi: ptr_uint, f: ir.Function) -> void:
    let fp = per_module.get(mi) else:
        return
    unsafe: read(fp).push(f)


## Order the whole program's functions like the host's `lower_modules`: an
## initial declaration pass over every module, then `lower_functions` fixpoint
## passes until no function is lowered.  Within one visit the available
## instances are sorted by their type-argument key (the host's `sort_by`), and a
## function's instances become available at its own visit — so an instance
## created by an earlier declaration in the same pass can still be emitted later
## in that pass, while one created after its declaration was seen waits for the
## next pass.
function order_module_functions(analyses: span[analyzer.Analysis], fragments: span[ir.Program], all_by_linkage: ref[map_mod.Map[str, ir.Function]], spec_infos: ref[map_mod.Map[str, SpecInfo]], expanded_decls: ref[map_mod.Map[str, span[ast.Decl]]]) -> vec.Vec[ir.Function]:
    var visits = vec.Vec[vec.Vec[DeclVisit]].create()
    var emittable = map_mod.Map[str, bool].create()
    var specs_by_decl = map_mod.Map[str, vec.Vec[str]].create()
    var mi: ptr_uint = 0
    while mi < analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(analyses.data + mi)
        let module_visits = build_decl_visits(a, analyses, expanded_decls)
        var vi: ptr_uint = 0
        while vi < module_visits.len():
            let vp = module_visits.get(vi) else:
                break
            let v = unsafe: read(vp)
            if not v.instance:
                emittable.set(v.linkage, true)
            vi += 1
        visits.push(module_visits)
        mi += 1

    # The analyzer ran before lowering, so its instantiation/validation of a
    # specialization does not depend on which call site lowering reached first.
    # Recompute the classification from the creation graph: a normal call from
    # an analyzed context means the analyzer validated the callee's body (its
    # nested calls are analyzer-created), and an instance is analyzer-created
    # whenever an analyzed context (directly or transitively) created it.
    var spec_key_list = vec.Vec[str].create()
    var spec_key_iter = spec_infos.keys()
    while true:
        let kp = spec_key_iter.next() else:
            break
        spec_key_list.push(unsafe: read(kp))
    var bv_changed = true
    while bv_changed:
        bv_changed = false
        var ski: ptr_uint = 0
        while ski < spec_key_list.len():
            let kp = spec_key_list.get(ski) else:
                break
            let key = unsafe: read(kp)
            let info_ptr = spec_infos.get(key)
            if info_ptr != null:
                var info = unsafe: read(info_ptr)
                if not info.body_validated:
                    var analyzed = false
                    var ri: ptr_uint = 0
                    while ri < info.reachers.len():
                        let rp = info.reachers.get(ri) else:
                            break
                        let reacher = unsafe: read(rp)
                        if reacher.len == 0:
                            analyzed = true
                        else:
                            let cp = spec_infos.get(reacher)
                            if cp == null:
                                analyzed = true
                            else if unsafe: read(cp).body_validated:
                                analyzed = true
                        ri += 1
                    if analyzed:
                        info.body_validated = true
                        spec_infos.set(key, info)
                        bv_changed = true
            ski += 1
    var pre_changed = true
    while pre_changed:
        pre_changed = false
        var pki: ptr_uint = 0
        while pki < spec_key_list.len():
            let kp = spec_key_list.get(pki) else:
                break
            let key = unsafe: read(kp)
            let info_ptr = spec_infos.get(key)
            if info_ptr != null:
                var info = unsafe: read(info_ptr)
                var pre = info.pre_instantiated
                var ri2: ptr_uint = 0
                while ri2 < info.reachers.len():
                    let rp = info.reachers.get(ri2) else:
                        break
                    let reacher = unsafe: read(rp)
                    if reacher.len == 0:
                        pre = true
                    else:
                        let cp = spec_infos.get(reacher)
                        if cp == null:
                            pre = true
                        else if unsafe: read(cp).body_validated:
                            pre = true
                    ri2 += 1
                if pre != info.pre_instantiated:
                    info.pre_instantiated = pre
                    spec_infos.set(key, info)
                    pre_changed = true
            pki += 1

    var spec_keys = spec_infos.keys()
    while true:
        let kp = spec_keys.next() else:
            break
        let key = unsafe: read(kp)
        let info_ptr = spec_infos.get(key)
        if info_ptr == null:
            continue
        let info = unsafe: read(info_ptr)
        let dk = spec_owner_key(info.owner_module, info.decl_key)
        var list = vec.Vec[str].create()
        let existing = specs_by_decl.get(dk)
        if existing != null:
            list = unsafe: read(existing)
        list.push(key)
        specs_by_decl.set(dk, list)
        emittable.set(key, true)

    var per_module = vec.Vec[vec.Vec[ir.Function]].create()
    mi = 0
    while mi < analyses.len:
        per_module.push(vec.Vec[ir.Function].create())
        mi += 1

    var emitted = map_mod.Map[str, bool].create()
    var setup_reached = map_mod.Map[str, bool].create()
    var first_pass = true
    var changed = true
    while changed:
        changed = false
        mi = 0
        while mi < analyses.len:
            let visits_ptr = visits.get(mi) else:
                break
            if first_pass:
                # The host's setup loop has already lowered this module's
                # constants/globals/synthetics when its declaration walk starts,
                # so instances created there are available from this visit on.
                let setup_analysis = unsafe: read(analyses.data + mi)
                setup_reached.set(setup_analysis.module_name, true)
            let module_visits = unsafe: read(visits_ptr)
            var vi: ptr_uint = 0
            while vi < module_visits.len():
                let vp = module_visits.get(vi) else:
                    break
                let v = unsafe: read(vp)
                if v.instance:
                    let list_ptr = specs_by_decl.get(v.owner_key)
                    if list_ptr != null:
                        let list = unsafe: read(list_ptr)
                        var picked = vec.Vec[ir.Function].create()
                        var pkeys = vec.Vec[str].create()
                        var li: ptr_uint = 0
                        while li < list.len():
                            let kp = list.get(li) else:
                                break
                            let key = unsafe: read(kp)
                            if not emitted.contains(key):
                                let info_ptr = spec_infos.get(key)
                                if info_ptr != null:
                                    let info = unsafe: read(info_ptr)
                                    if spec_creator_ready(info, ref_of(emittable), ref_of(emitted), ref_of(setup_reached)):
                                        let fp = all_by_linkage.get(key)
                                        if fp != null:
                                            picked.push(unsafe: read(fp))
                                            pkeys.push(info.args_key)
                            li += 1
                        # Insertion sort by the host's type-argument key.
                        var si: ptr_uint = 1
                        while si < picked.len():
                            var j = si
                            while j > 0:
                                let a_ptr = pkeys.get(j - 1) else:
                                    break
                                let b_ptr = pkeys.get(j) else:
                                    break
                                var a: str
                                var b: str
                                unsafe:
                                    a = read(a_ptr)
                                    b = read(b_ptr)
                                if str_less_than(a, b):
                                    break
                                picked.swap(j - 1, j)
                                pkeys.swap(j - 1, j)
                                j -= 1
                            si += 1
                        var pi: ptr_uint = 0
                        while pi < picked.len():
                            let fp = picked.get(pi) else:
                                break
                            var f = unsafe: read(fp)
                            if not emitted.contains(f.linkage_name):
                                emitted.set(f.linkage_name, true)
                                push_module_function(ref_of(per_module), mi, f)
                                changed = true
                            pi += 1
                else:
                    if not emitted.contains(v.linkage):
                        let fp = all_by_linkage.get(v.linkage)
                        if fp != null:
                            emitted.set(v.linkage, true)
                            push_module_function(ref_of(per_module), mi, unsafe: read(fp))
                            changed = true
                            if v.is_main and not emitted.contains("main"):
                                let mp = all_by_linkage.get("main")
                                if mp != null:
                                    emitted.set("main", true)
                                    push_module_function(ref_of(per_module), mi, unsafe: read(mp))
                vi += 1
            mi += 1
        first_pass = false

    # Leftovers: functions from `when`-expanded declarations and any fragment
    # function the declaration walk does not name (kept in creation order).
    mi = 0
    while mi < analyses.len:
        let frag = unsafe: read(fragments.data + mi)
        var fi: ptr_uint = 0
        while fi < frag.functions.len:
            var f: ir.Function
            unsafe:
                f = read(frag.functions.data + fi)
            if not emitted.contains(f.linkage_name):
                emitted.set(f.linkage_name, true)
                push_module_function(ref_of(per_module), mi, f)
            fi += 1
        mi += 1

    var result = vec.Vec[ir.Function].create()
    mi = 0
    while mi < per_module.len():
        let mf_ptr = per_module.get(mi) else:
            break
        let module_functions = unsafe: read(mf_ptr)
        var fi: ptr_uint = 0
        while fi < module_functions.len():
            let fp = module_functions.get(fi) else:
                break
            result.push(unsafe: read(fp))
            fi += 1
        mi += 1
    return result


## Append the declarations of a module-level `when`'s selected branch to `out`.
function append_selected_when_decls(ctx: ref[LowerCtx], discriminant: ptr[ast.Expr], branches: span[ast.WhenDeclBranch], dest: ref[vec.Vec[ast.Decl]]) -> void:
    match try_evaluate_const_expr(ctx, discriminant):
        Option.some as dv:
            var bi: ptr_uint = 0
            var found = false
            while bi < branches.len and not found:
                let br = unsafe: read(branches.data + bi)
                match try_evaluate_const_expr(ctx, br.pattern):
                    Option.some as pv:
                        if const_values_eq(dv.value, pv.value):
                            var ddi: ptr_uint = 0
                            while ddi < br.body.len:
                                unsafe:
                                    dest.push(read(br.body.data + ddi))
                                ddi += 1
                            found = true
                    Option.none:
                        pass
                bi += 1
        Option.none:
            pass


## The host's per-module setup order (`lower_modules`): `lower_constants`, then
## `lower_globals` (vars and events), then the type/opaque declarations, then
## `lower_functions`.  Proc symbols are allocated while lowering, so this pass
## order is observable in the generated names.
function decl_lowering_pass(d: ast.Decl) -> ptr_uint:
    match d:
        ast.Decl.decl_const:
            return 0
        ast.Decl.decl_var:
            return 1
        ast.Decl.decl_event:
            return 1
        ast.Decl.decl_function:
            return 3
        ast.Decl.decl_extending_block:
            return 3
        _:
            return 2


function lower_module(analysis: analyzer.Analysis, program_returns: ref[map_mod.Map[str, types.Type]], prelude_arm_field_types: ref[map_mod.Map[str, types.Type]], is_root: bool, program_analyses: span[analyzer.Analysis], loaded_modules: span[loader.LoadedModule], gen_instances: ref[map_mod.Map[str, GenericReceiver]], monomorphized: ref[vec.Vec[ir.StructDecl]], monomorphized_variants: ref[vec.Vec[ir.VariantDecl]], pending_synthetic_structs: ref[vec.Vec[ir.StructDecl]], synthetic_functions: ref[vec.Vec[ir.Function]], synthetic_enums: ref[vec.Vec[ir.EnumDecl]], emitted_functions: ptr[vec.Vec[ir.Function]], emitted_structs: ptr[vec.Vec[ir.StructDecl]], emitted_constants: ptr[vec.Vec[ir.Constant]], spec_infos: ref[map_mod.Map[str, SpecInfo]], expanded_decls: ref[map_mod.Map[str, span[ast.Decl]]]) -> ir.Program:
    var ctx = new_lowering_context(analysis, ptr_of(read(program_returns)), ptr_of(read(prelude_arm_field_types)), program_analyses, loaded_modules, ptr_of(read(gen_instances)), ptr_of(read(spec_infos)))
    ctx.is_root_module = is_root
    ctx.pending_emitted_functions = emitted_functions
    ctx.pending_emitted_structs = emitted_structs
    ctx.pending_emitted_constants = emitted_constants
    collect_foreign_functions(ref_of(ctx), analysis.source_file.declarations)
    collect_function_returns(ref_of(ctx), analysis.source_file.declarations)
    collect_variants(ref_of(ctx), analysis.source_file.declarations)
    install_prelude_variants(ref_of(ctx))
    var functions = vec.Vec[ir.Function].create()
    var enums = vec.Vec[ir.EnumDecl].create()
    var structs = vec.Vec[ir.StructDecl].create()
    var unions = vec.Vec[ir.UnionDecl].create()
    var variants = vec.Vec[ir.VariantDecl].create()
    var globals = vec.Vec[ir.Global].create()
    var constants = vec.Vec[ir.Constant].create()
    var module_static_asserts = vec.Vec[ir.StaticAssert].create()
    # Module-level `when` blocks expand in place to the declarations of their
    # selected branch, so those declarations keep their source order (the host
    # emits them inline rather than deferring them to the end of the module).
    var decls = vec.Vec[ast.Decl].create()
    var wi: ptr_uint = 0
    while wi < analysis.source_file.declarations.len:
        var wd: ast.Decl
        unsafe:
            wd = read(analysis.source_file.declarations.data + wi)
        match wd:
            ast.Decl.decl_when as w:
                append_selected_when_decls(ctx, w.discriminant, w.branches, ref_of(decls))
            _:
                decls.push(wd)
        wi += 1
    expanded_decls.set(analysis.module_name, decls.as_span())

    # The host's `lower_globals` ensures every module-level event's runtime
    # before any struct declaration lowers, so the synthetic structs' creation
    # order leads with the module events in declaration order, then each
    # struct's own events in struct order.
    var evi: ptr_uint = 0
    while evi < decls.len():
        let ev_decl_ptr = decls.get(evi) else:
            break
        match unsafe: read(ev_decl_ptr):
            ast.Decl.decl_event as ev:
                let _ = ensure_event_runtime(ref_of(ctx), "", ev.name)
            _:
                pass
        evi += 1

    var phase: ptr_uint = 0
    while phase < 4:
        var i: ptr_uint = 0
        while i < decls.len():
            var d: ast.Decl
            let d_ptr = decls.get(i) else:
                break
            unsafe:
                d = read(d_ptr)
            if decl_lowering_pass(d) != phase:
                i += 1
                continue
            match d:
                ast.Decl.decl_function as fun:
                    if fun.is_async:
                        # All async functions use full CPS lowering (frame struct,
                        # resume state machine, vtable, constructor).  A 0-await
                        # function is the single-state case.  An async `main`
                        # constructor carries the host's `__async_main` linkage
                        # (`function_binding_c_name`, utils.rb:1089-1092).
                        let link_base = if is_root and fun.name == "main": naming.qualified_c_name(ctx.module_name, "__async_main") else: naming.qualified_c_name(ctx.module_name, fun.name)
                        lower_async_fn(ref_of(ctx), fun.name, link_base, Option[types.Type].none, false, fun.method_params, fun.return_type, fun.body, ref_of(functions), is_root and fun.name == "main")
                        if is_root and fun.name == "main":
                            match build_async_main_entrypoint(ref_of(ctx), fun.name):
                                Option.some as entry:
                                    functions.push(entry.value)
                                Option.none:
                                    pass
                    else if lowerable_function(fun.type_params, fun.body):
                        functions.push(lower_function(ref_of(ctx), fun.name, fun.method_params, fun.return_type, fun.body, false, fun.visibility))
                        if is_root and fun.name == "main":
                            match build_root_main_entrypoint(ref_of(ctx), fun.name, fun.method_params):
                                Option.some as entry:
                                    functions.push(entry.value)
                                Option.none:
                                    pass
                ast.Decl.decl_enum as en:
                    enums.push(lower_enum_decl(ref_of(ctx), en.name, en.backing_type, en.enum_members, false))
                ast.Decl.decl_flags as fl:
                    enums.push(lower_enum_decl(ref_of(ctx), fl.name, fl.backing_type, fl.flags_members, true))
                ast.Decl.decl_static_assert as sa:
                    module_static_asserts.push(lower_static_assert(ref_of(ctx), sa.condition, sa.message))
                ast.Decl.decl_struct as s:
                    # Skip generic structs — only their concrete specializations
                    # (emitted by `ensure_generic_struct_decl`) carry resolved
                    # field types.  Structs with only lifetime parameters (`@a`)
                    # are not generic in the monomorphization sense and should
                    # be emitted directly.
                    if not has_non_lifetime_type_params(s.type_params):
                        match lower_struct_decl(ref_of(ctx), s.name, s.packed, s.alignment, Option[str].none, s.name):
                            Option.some as sd:
                                structs.push(sd.value)
                            Option.none:
                                pass
                        lower_nested_struct_decls(ref_of(ctx), s.nested_types, s.name, s.name, ref_of(structs))
                ast.Decl.decl_union as u:
                    unions.push(lower_union_decl(ref_of(ctx), u.name, u.union_fields))
                ast.Decl.decl_variant as vr:
                    if vr.type_params.len == 0:
                        variants.push(lower_variant_decl(ref_of(ctx), vr.name, vr.variant_arms))
                ast.Decl.decl_extending_block as ex:
                    lower_extending_block(ctx, ref_of(functions), ex.type_name, ex.methods)
                ast.Decl.decl_var as v:
                    var g_ty = types.primitive("void")
                    if v.var_type != null:
                        var vt: ptr[ast.TypeRef] = unsafe: ptr[ast.TypeRef]<-v.var_type
                        # `qualify_type` (not just `resolve_type_ref`) registers the
                        # generic instance and produces the monomorphized C name, so a
                        # module-level `var m: Map[str, str]` declares
                        # `std_map_Map_str_str m` rather than the unspecialized
                        # `std_map_Map` (which is never defined).
                        g_ty = qualify_type(ctx, resolve_type_ref(ctx, vt))
                    # A tuple in the global's declared type registers its value
                    # struct even when no literal mentions it (the host's
                    # `ensure_registered_storage_type_types`).
                    var g_seen = map_mod.Map[str, bool].create()
                    ensure_storage_type_tuples(ctx, g_ty, ref_of(g_seen))
                    # A top-level `var` initializer must be static-storage-safe (the
                    # analyzer enforces this), so it lowers to a C static initializer.
                    # A no-capture `proc` initializer, for example, becomes a static
                    # aggregate of function pointers — without it the proc's invoke
                    # pointer stays null and calling it segfaults.
                    var g_val = alloc_expr(ir.Expr.expr_zero_init(ty = g_ty))
                    if v.value != null:
                        # A top-level initializer is evaluated in an empty local
                        # scope: clear any locals left over from a previously-lowered
                        # function so a no-capture `proc` initializer is not treated
                        # as capturing stale bindings.
                        ctx.locals.clear()
                        # A compile-time-known initializer folds to its constant value
                        # — a literal, a constant reference (an imported module's
                        # constant included) or a `const` function/method call — as the
                        # host's `lower_static_storage_initializer` folds
                        # `compile_time_const_value` through `lower_compile_time_literal`.
                        # Anything else lowers as an ordinary expression.
                        var init_env = map_mod.Map[str, ptr[ir.Expr]].create()
                        match try_const_typed_value_ir(ctx, unsafe: ptr[ast.Expr]<-v.value, ref_of(init_env), g_ty):
                            Option.some as g_cv:
                                g_val = alloc_expr(coerce_const_value(ctx, unsafe: read(g_cv.value), g_ty))
                            Option.none:
                                g_val = lower_expr(ctx, unsafe: ptr[ast.Expr]<-v.value)
                                # A literal initializer takes the global's declared type, as
                                # the host's contextual literal inference gives it one
                                # (`var shorts: short = 0` is a `short` literal, not `int`).
                                g_val = int_literal_to_context_type(unsafe: ptr[ast.Expr]<-v.value, g_ty, g_val)
                                g_val = float_literal_to_context_type(unsafe: ptr[ast.Expr]<-v.value, g_ty, g_val)
                                g_val = string_literal_to_context_type(unsafe: ptr[ast.Expr]<-v.value, g_ty, g_val)
                                g_val = null_literal_to_context_type(unsafe: ptr[ast.Expr]<-v.value, g_ty, g_val)
                    globals.push(ir.Global(name = v.name, linkage_name = naming.qualified_c_name(ctx.module_name, v.name), ty = g_ty, value = g_val))
                ast.Decl.decl_const as c:
                    var c_ty = resolve_type_ref(ctx, c.const_type)
                    # A tuple in the constant's declared type registers its value
                    # struct, as the host's `ensure_registered_storage_type_types`
                    # does before the value is lowered.
                    var c_seen = map_mod.Map[str, bool].create()
                    ensure_storage_type_tuples(ctx, c_ty, ref_of(c_seen))
                    let val_ptr = c.value
                    # The host's `lower_constants` routes an expression-list or
                    # call/specialization constant value through
                    # `lower_const_value_literal` rather than the storage-initializer
                    # path.
                    var const_value_literal_path = false
                    if val_ptr != null:
                        match unsafe: read(ptr[ast.Expr]<-val_ptr):
                            ast.Expr.expr_expression_list:
                                const_value_literal_path = true
                            ast.Expr.expr_call:
                                const_value_literal_path = true
                            ast.Expr.expr_specialization:
                                const_value_literal_path = true
                            _:
                                pass
                    # Type constants (->type) are compile-time only; they don't
                    # have a C representation (mirrors Ruby).
                    var is_type_meta = false
                    match c_ty:
                        types.Type.ty_type_meta:
                            is_type_meta = true
                        _:
                            pass
                    if is_type_meta:
                        pass
                    else if val_ptr == null:
                        var bv = alloc_expr(ir.Expr.expr_zero_init(ty = c_ty))
                        if c.block_body != null:
                            var empty_env = map_mod.Map[str, ptr[ir.Expr]].create()
                            match try_const_value_body(ctx, c.block_body, ref_of(empty_env)):
                                Option.some as body_val:
                                    bv = alloc_expr(coerce_const_value(ctx, unsafe: read(body_val.value), c_ty))
                                Option.none:
                                    pass
                        constants.push(ir.Constant(name = c.name, linkage_name = naming.qualified_c_name(ctx.module_name, c.name), ty = c_ty, value = bv, line = c.line, path = ctx.analysis.source_path))
                    else:
                        # `const EQ: bool = A == B` over constant aggregates folds
                        # at compile time; a C function call is not a constant
                        # initializer.
                        var folded: Option[bool] = Option[bool].none
                        match c_ty:
                            types.Type.ty_primitive as cp:
                                if cp.name == "bool":
                                    folded = try_const_equality(ctx, unsafe: ptr[ast.Expr]<-val_ptr)
                            _:
                                pass
                        match folded:
                            Option.some as fb:
                                constants.push(ir.Constant(name = c.name, linkage_name = naming.qualified_c_name(ctx.module_name, c.name), ty = c_ty, value = alloc_expr(ir.Expr.expr_boolean_literal(value = fb.value, ty = c_ty)), line = c.line, path = ctx.analysis.source_path))
                            Option.none:
                                var const_env = map_mod.Map[str, ptr[ir.Expr]].create()
                                match try_const_typed_value_ir(ctx, unsafe: ptr[ast.Expr]<-val_ptr, ref_of(const_env), c_ty):
                                    Option.some as cv2:
                                        var c_val = unsafe: read(cv2.value)
                                        # The host's `lower_const_value_literal` path
                                        # (an expression-list or call constant) emits a
                                        # tuple constant as an `IR::ArrayLiteral`.
                                        if const_value_literal_path:
                                            match const_tuple_array_literal(c_val, c_ty):
                                                Option.some as al:
                                                    c_val = al.value
                                                Option.none:
                                                    pass
                                        # A plain expression constant takes the host's
                                        # `lower_compile_time_literal` path: the folded
                                        # value is typed but *not* width-masked
                                        # (`~268435455` stays `-268435456` in a `uint`),
                                        # unlike the `lower_const_value_literal` paths.
                                        var coerced: ptr[ir.Expr]
                                        if const_value_literal_path:
                                            coerced = alloc_expr(coerce_const_value(ctx, c_val, c_ty))
                                        else:
                                            # `lower_compile_time_literal` returns nil when a
                                            # leaf value cannot be represented (an integer for
                                            # a `char` field, for instance); the host then
                                            # falls back to rewriting the imported constant
                                            # reference to its declaration initializer and
                                            # lowering that AST with the expected type.
                                            if not const_value_ir_representable(ctx, c_val, c_ty):
                                                match lower_imported_const_initializer(ctx, unsafe: ptr[ast.Expr]<-val_ptr, c_ty):
                                                    Option.some as iv:
                                                        c_val = unsafe: read(iv.value)
                                                    Option.none:
                                                        pass
                                            coerced = alloc_expr(retype_const_literal(c_val, c_ty))
                                        constants.push(ir.Constant(name = c.name, linkage_name = naming.qualified_c_name(ctx.module_name, c.name), ty = c_ty, value = coerced, line = c.line, path = ctx.analysis.source_path))
                                    Option.none:
                                        constants.push(ir.Constant(name = c.name, linkage_name = naming.qualified_c_name(ctx.module_name, c.name), ty = c_ty, value = lower_expr(ctx, unsafe: ptr[ast.Expr]<-val_ptr), line = c.line, path = ctx.analysis.source_path))
                ast.Decl.decl_event as ev:
                    var info = ensure_event_runtime(ctx, "", ev.name)
                    # The global's declared type is the event itself (`Types::Event`),
                    # whose C name is the runtime struct; the linkage name is the
                    # module-qualified event name.
                    var ev_payload: ptr[types.Type]? = null
                    if info.has_payload:
                        ev_payload = types.alloc_type(info.payload_type)
                    let ev_ty = types.Type.ty_event(
                        name = ev.name,
                        capacity = info.capacity,
                        payload_type = ev_payload,
                        linkage_name = info.event_c_name,
                    )
                    let ev_zero = alloc_expr(ir.Expr.expr_zero_init(ty = ev_ty))
                    globals.push(ir.Global(name = ev.name, linkage_name = naming.qualified_c_name(ctx.module_name, ev.name), ty = ev_ty, value = ev_zero))
                ast.Decl.decl_when as w:
                    # Expanded by the pre-pass above; unreachable here.
                    pass
                _:
                    pass
            i += 1
        phase += 1

    # Concrete generic struct instances are not part of the IR's declaration
    # sections (host parity: its C backend collects them from the types in
    # use).  Hand them to the driver, which exposes them to the C backend
    # through `Program.monomorphized_structs`.
    var gs_iter = ctx.generic_struct_decls.values()
    while true:
        let gs_ptr = gs_iter.next() else:
            break
        monomorphized.push(unsafe: read(gs_ptr))
    var ps_iter = ctx.pending_proc_structs.iter()
    while true:
        let ps_ptr = ps_iter.next() else:
            break
        monomorphized.push(unsafe: read(ps_ptr))

    # Synthetic value structs join `Program.structs` after every module's
    # declarations, in creation order (the host's `assemble_modules` appends its
    # single `synthetic_structs` list last), so they bypass the per-module
    # fragment.
    var ss_iter = ctx.pending_synthetic_structs.iter()
    while true:
        let ss_ptr = ss_iter.next() else:
            break
        pending_synthetic_structs.push(unsafe: read(ss_ptr))

    # Append any monomorphized generic functions from the specialization cache.
    var spec_iter = ctx.specialization_cache.values()
    while true:
        let spec_ptr = spec_iter.next() else:
            break
        functions.push(unsafe: read(spec_ptr))

    # Synthetic proc/worker functions go to the program-level creation-ordered
    # tail (the host's `@artifacts.synthetic_functions`, appended after every
    # module's functions by `assemble_modules`), not to this module's list.
    var sf_iter = ctx.pending_synthetic_functions.iter()
    while true:
        let sf_ptr = sf_iter.next() else:
            break
        synthetic_functions.push(unsafe: read(sf_ptr))

    # Synthetic enums (the builtin `EventError`) join the program-level list;
    # `lower()` appends them after every module's enums.
    var se_iter = ctx.pending_synthetic_enums.iter()
    while true:
        let se_ptr = se_iter.next() else:
            break
        synthetic_enums.push(unsafe: read(se_ptr))

    var ds_iter = ctx.pending_dyn_structs.iter()
    while true:
        let ds_ptr = ds_iter.next() else:
            break
        monomorphized.push(unsafe: read(ds_ptr))

    var dyn_constants = vec.Vec[ir.Constant].create()
    var dci: ptr_uint = 0
    while dci < ctx.pending_dyn_constants.len():
        let dc_ptr = ctx.pending_dyn_constants.get(dci) else:
            break
        dyn_constants.push(unsafe: read(dc_ptr))
        dci += 1

    # Append dyn vtable constants to the main constants list so they are
    # emitted into the C output (previously they were collected but never
    # written, causing `mt_vtable_..._Shape undeclared`).
    var di: ptr_uint = 0
    while di < dyn_constants.len():
        let c_ptr = dyn_constants.get(di) else:
            break
        constants.push(unsafe: read(c_ptr))
        di += 1

    # Concrete Option/Result instances are kept outside the IR's `:variants`
    # section (host parity) and handed to the driver for the C backend.
    var gv_iter = ctx.pending_generic_variants.iter()
    while true:
        let gv_ptr = gv_iter.next() else:
            break
        monomorphized_variants.push(unsafe: read(gv_ptr))

    return ir.Program(
        module_name = analysis.module_name,
        includes = span[ir.Include](),
        constants = constants.as_span(),
        globals = globals.as_span(),
        opaques = span[ir.OpaqueDecl](),
        structs = structs.as_span(),
        unions = unions.as_span(),
        enums = enums.as_span(),
        variants = variants.as_span(),
        static_asserts = module_static_asserts.as_span(),
        functions = functions.as_span(),
        type_aliases = span[ir.TypeAlias](),
        source_path = "",
        external_structs = ctx.pending_external_structs.as_span(),
    )


## Returns true for functions that can be lowered directly (non-generic and
## not an external/foreign/async declaration — async functions take the CPS
## path in `lower_async_fn`).
function lowerable_function(type_params: span[ast.TypeParam], body: ptr[ast.Stmt]?) -> bool:
    if type_params.len > 0:
        return false
    if body == null:
        return false
    return true


## Collect every non-raw module's `opaque` declarations (host `lower_opaques`):
## each keeps its *declared* name, and its C type is the resolved backing —
## the explicit `= c"..."` C name when present, else the module-qualified name
## the backend's forward declaration defines (`opaque_c_type_name`).  A backing
## that is a plain C identifier is forward-declarable (`typedef struct X X;`);
## raw (`external`) modules' opaques are the headers' own types and their
## fragments are skipped entirely, exactly as the host skips them.
function collect_opaque_decls(program: loader.Program) -> span[ir.OpaqueDecl]:
    var opaques = vec.Vec[ir.OpaqueDecl].create()
    var mi: ptr_uint = 0
    while mi < program.analyses.len():
        let a_ptr = program.analyses.get(mi) else:
            mi += 1
            continue
        var analysis = unsafe: read(a_ptr)
        if is_raw_module(analysis.module_kind):
            mi += 1
            continue
        var di: ptr_uint = 0
        while di < analysis.source_file.declarations.len:
            var d: ast.Decl
            unsafe:
                d = read(analysis.source_file.declarations.data + di)
            match d:
                ast.Decl.decl_opaque as op:
                    var linkage = ""
                    match op.c_name:
                        Option.some as cn:
                            linkage = cn.value
                        Option.none:
                            linkage = naming.qualified_c_name(analysis.module_name, op.name)
                    opaques.push(ir.OpaqueDecl(
                        name = op.name,
                        linkage_name = linkage,
                        forward_declarable = naming.is_c_identifier(linkage),
                        source_module = Option[str].some(value = analysis.module_name),
                    ))
                _:
                    pass
            di += 1
        mi += 1
    # Raw (external) modules' forward-declarable opaques (the host's
    # `lower_imported_external_opaques`, `declarations.rb:194-203`): an
    # unnamed external opaque (`opaque X`, no `= c"..."`) keeps its bare C name;
    # a c-named opaque keeps its declared linkage and is not forward-declared.
    var seen_raw = map_mod.Map[str, bool].create()
    var ri: ptr_uint = 0
    while ri < program.analyses.len():
        let ra_ptr = program.analyses.get(ri) else:
            break
        var ra = unsafe: read(ra_ptr)
        if is_raw_module(ra.module_kind):
            var rdi: ptr_uint = 0
            while rdi < ra.source_file.declarations.len:
                var rd: ast.Decl
                unsafe:
                    rd = read(ra.source_file.declarations.data + rdi)
                match rd:
                    ast.Decl.decl_opaque as rop:
                        if rop.c_name.is_none():
                            let linkage = rop.name
                            if naming.is_c_identifier(linkage) and not seen_raw.contains(linkage):
                                seen_raw.set(linkage, true)
                                opaques.push(ir.OpaqueDecl(
                                    name = rop.name,
                                    linkage_name = linkage,
                                    forward_declarable = true,
                                    source_module = Option[str].some(value = ra.module_name),
                                ))
                    _:
                        pass
                rdi += 1
        ri += 1
    return opaques.as_span()


## Which built-in the include scan looks for (host scans.rb).
const SCAN_FATAL: int = 0
const SCAN_OFFSETOF: int = 1


## True when an expression is a `fatal(...)` call (mode 0) or an `offsetof`
## expression (mode 1).
function expr_matches_scan(ep: ptr[ast.Expr], mode: int) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_call as c:
                if mode == SCAN_FATAL:
                    match read(c.callee):
                        ast.Expr.expr_identifier as id:
                            if id.name == "fatal":
                                return true
                        _:
                            pass
            ast.Expr.expr_offsetof:
                if mode == SCAN_OFFSETOF:
                    return true
            _:
                pass
    return false


function expr_args_use_scan(args: span[ast.Argument], mode: int) -> bool:
    var i: ptr_uint = 0
    while i < args.len:
        let a = unsafe: read(args.data + i)
        if expr_uses_scan(a.arg_value, mode):
            return true
        i += 1
    return false


function match_arms_use_scan(arms: span[ast.MatchArm], mode: int) -> bool:
    var i: ptr_uint = 0
    while i < arms.len:
        let a = unsafe: read(arms.data + i)
        if expr_uses_scan(a.pattern, mode):
            return true
        if stmt_uses_scan(a.body, mode):
            return true
        i += 1
    return false


function match_expr_arms_use_scan(arms: span[ast.MatchExprArm], mode: int) -> bool:
    var i: ptr_uint = 0
    while i < arms.len:
        let a = unsafe: read(arms.data + i)
        if expr_uses_scan(a.pattern, mode):
            return true
        if expr_uses_scan(a.value, mode):
            return true
        i += 1
    return false


function if_branches_use_scan(branches: span[ast.IfBranch], mode: int) -> bool:
    var i: ptr_uint = 0
    while i < branches.len:
        let b = unsafe: read(branches.data + i)
        if expr_uses_scan(b.condition, mode):
            return true
        if stmt_uses_scan(b.body, mode):
            return true
        i += 1
    return false


function expr_list_uses_scan(items: span[ast.Expr], mode: int) -> bool:
    var i: ptr_uint = 0
    while i < items.len:
        if expr_uses_scan(unsafe: items.data + i, mode):
            return true
        i += 1
    return false


## Walk an expression tree for `fatal`/`offsetof` (host
## `expression_uses_pattern?`).
function expr_uses_scan(ep: ptr[ast.Expr]?, mode: int) -> bool:
    if ep == null:
        return false
    let p = ptr[ast.Expr]<-ep
    if expr_matches_scan(p, mode):
        return true
    unsafe:
        match read(p):
            ast.Expr.expr_await as x:
                return expr_uses_scan(x.expression, mode)
            ast.Expr.expr_call as x:
                return expr_uses_scan(x.callee, mode) or expr_args_use_scan(x.args, mode)
            ast.Expr.expr_binary_op as x:
                return expr_uses_scan(x.left, mode) or expr_uses_scan(x.right, mode)
            ast.Expr.expr_range as x:
                return expr_uses_scan(x.start_expr, mode) or expr_uses_scan(x.end_expr, mode)
            ast.Expr.expr_if as x:
                return expr_uses_scan(x.condition, mode) or expr_uses_scan(x.then_expr, mode) or expr_uses_scan(x.else_expr, mode)
            ast.Expr.expr_match as x:
                return expr_uses_scan(x.scrutinee, mode) or match_expr_arms_use_scan(x.arms, mode)
            ast.Expr.expr_unsafe as x:
                return expr_uses_scan(x.expression, mode)
            ast.Expr.expr_prefix_cast as x:
                return expr_uses_scan(x.expression, mode)
            ast.Expr.expr_unary_op as x:
                return expr_uses_scan(x.operand, mode)
            ast.Expr.expr_member_access as x:
                return expr_uses_scan(x.receiver, mode)
            ast.Expr.expr_index_access as x:
                return expr_uses_scan(x.receiver, mode) or expr_uses_scan(x.index, mode)
            ast.Expr.expr_specialization as x:
                return expr_uses_scan(x.callee, mode)
            _:
                pass
    return false


## Walk a statement tree for `fatal`/`offsetof` (host
## `statement_uses_expression_pattern?`; unhandled kinds are false there too).
function stmt_uses_scan(sp: ptr[ast.Stmt]?, mode: int) -> bool:
    if sp == null:
        return false
    let p = ptr[ast.Stmt]<-sp
    unsafe:
        match read(p):
            ast.Stmt.stmt_local as x:
                return expr_uses_scan(x.value, mode)
            ast.Stmt.stmt_assignment as x:
                return expr_uses_scan(x.target, mode) or expr_uses_scan(x.value, mode)
            ast.Stmt.stmt_if as x:
                return if_branches_use_scan(x.branches, mode) or stmt_uses_scan(x.else_body, mode)
            ast.Stmt.stmt_match as x:
                return expr_uses_scan(x.scrutinee, mode) or match_arms_use_scan(x.arms, mode)
            ast.Stmt.stmt_static_assert as x:
                return expr_uses_scan(x.condition, mode) or expr_uses_scan(x.message, mode)
            ast.Stmt.stmt_for as x:
                return expr_list_uses_scan(x.iterables, mode) or stmt_uses_scan(x.body, mode)
            ast.Stmt.stmt_unsafe as x:
                return stmt_uses_scan(x.body, mode)
            ast.Stmt.stmt_while as x:
                return expr_uses_scan(x.condition, mode) or stmt_uses_scan(x.body, mode)
            ast.Stmt.stmt_ret as x:
                return expr_uses_scan(x.value, mode)
            ast.Stmt.stmt_expression as x:
                return expr_uses_scan(x.expression, mode)
            ast.Stmt.stmt_defer as x:
                return stmt_uses_scan(x.body, mode) or expr_uses_scan(x.expression, mode)
            ast.Stmt.stmt_block as x:
                var bi: ptr_uint = 0
                while bi < x.statements.len:
                    if stmt_uses_scan(unsafe: x.statements.data + bi, mode):
                        return true
                    bi += 1
            _:
                pass
    return false


## True when any non-raw module's functions or extending methods use the
## scanned construct (host `program_uses_fatal?` / `program_uses_offsetof?`).
function program_uses_scan(program: loader.Program, mode: int) -> bool:
    var ai: ptr_uint = 0
    while ai < program.analyses.len():
        let a_ptr = program.analyses.get(ai) else:
            break
        var analysis = unsafe: read(a_ptr)
        if not is_raw_module(analysis.module_kind):
            var di: ptr_uint = 0
            while di < analysis.source_file.declarations.len:
                var decl: ast.Decl
                unsafe:
                    decl = read(analysis.source_file.declarations.data + di)
                match decl:
                    ast.Decl.decl_function as f:
                        if stmt_uses_scan(f.body, mode):
                            return true
                    ast.Decl.decl_extending_block as e:
                        var mi: ptr_uint = 0
                        while mi < e.methods.len:
                            let m = unsafe: read(e.methods.data + mi)
                            if stmt_uses_scan(m.body, mode):
                                return true
                            mi += 1
                    _:
                        pass
                di += 1
        ai += 1
    return false


## Collect the full include set: the base C runtime headers plus every `include`
## directive from raw (`external`) module analyses (e.g. `std.c.fs` →
## `fs_support.h`).  Mirrors Ruby's `collect_includes` so external ABI struct
## types declared in those headers are in scope.  Deduplicated, base headers first.
function collect_includes(program: loader.Program) -> span[ir.Include]:
    var includes = vec.Vec[ir.Include].create()
    var seen = map_mod.Map[str, bool].create()
    includes.push(ir.Include(header = "<stdbool.h>"))
    includes.push(ir.Include(header = "<stdint.h>"))
    includes.push(ir.Include(header = "<string.h>"))
    seen.set("<stdbool.h>", true)
    seen.set("<stdint.h>", true)
    seen.set("<string.h>", true)

    if program_uses_scan(program, SCAN_OFFSETOF):
        includes.push(ir.Include(header = "<stddef.h>"))
        seen.set("<stddef.h>", true)
    if program_uses_scan(program, SCAN_FATAL):
        includes.push(ir.Include(header = "<stdio.h>"))
        seen.set("<stdio.h>", true)

    # External-binding headers follow the host's analysis-cache insertion
    # order: its loader checks each module's imports on demand (in declaration
    # order) and inserts a module's analysis only after its imports are cached
    # — a DFS post-order from the root.  Raw modules are leaves, so their
    # directives are appended when they are popped.  `program.analyses` is the
    # canonical dependency-first order and cannot supply this.
    var by_name = map_mod.Map[str, analyzer.Analysis].create()
    var ai: ptr_uint = 0
    while ai < program.analyses.len():
        let a_ptr = program.analyses.get(ai) else:
            break
        var a = unsafe: read(a_ptr)
        if not by_name.contains(a.module_name):
            by_name.set(a.module_name, a)
        ai += 1

    var include_visited = map_mod.Map[str, bool].create()
    if program.analyses.len() > 0:
        let a_ptr = program.analyses.get(program.root_index) else:
            fatal(c"collect_includes: root analysis missing")
        emit_raw_module_includes(ref_of(by_name), ref_of(include_visited), ref_of(includes), ref_of(seen), unsafe: read(a_ptr).module_name)

    return includes.as_span()


## Append raw-binding include directives in the host's cache order: recurse
## into a module's imports in declaration order first, then emit the module's
## own directives when it is a raw module (DFS post-order).
function emit_raw_module_includes(by_name: ref[map_mod.Map[str, analyzer.Analysis]], visited: ref[map_mod.Map[str, bool]], includes: ref[vec.Vec[ir.Include]], seen: ref[map_mod.Map[str, bool]], name: str) -> void:
    if visited.contains(name):
        return
    visited.set(name, true)
    let ap = by_name.get(name) else:
        return
    let analysis = unsafe: read(ap)
    var i: ptr_uint = 0
    while i < analysis.source_file.imports.len:
        var import_decl: ast.Decl
        unsafe:
            import_decl = read(analysis.source_file.imports.data + i)
        match import_decl:
            ast.Decl.decl_import as imported:
                emit_raw_module_includes(by_name, visited, includes, seen, analyzer.qname_to_str(imported.path))
            _:
                pass
        i += 1
    if is_raw_module(analysis.module_kind):
        var di: ptr_uint = 0
        while di < analysis.directives.len:
            var directive: ast.Decl
            unsafe:
                directive = read(analysis.directives.data + di)
            match directive:
                ast.Decl.decl_include as inc:
                    let header = normalized_include_header(inc.value)
                    if not seen.contains(header):
                        seen.set(header, true)
                        includes.push(ir.Include(header = header))
                _:
                    pass
            di += 1


## In-place ascending insertion sort of a `str` vector by byte order.
function sort_str_vec(items: ref[vec.Vec[str]]) -> void:
    var i: ptr_uint = 1
    while i < items.len():
        var j = i
        while j > 0:
            let a_ptr = items.get(j - 1) else:
                break
            let b_ptr = items.get(j) else:
                break
            var a: str
            var b: str
            unsafe:
                a = read(a_ptr)
                b = read(b_ptr)
            if str_less_than(a, b):
                break
            items.swap(j - 1, j)
            j -= 1
        i += 1


## True when `left` sorts strictly before `right` in byte order.
function str_less_than(left: str, right: str) -> bool:
    var index: ptr_uint = 0
    let shared = if left.len < right.len: left.len else: right.len
    while index < shared:
        let lb = left.byte_at(index)
        let rb = right.byte_at(index)
        if lb < rb:
            return true
        if lb > rb:
            return false
        index += 1
    return left.len < right.len


## Wrap an include header: standard C runtime headers use `<angle>` brackets,
## everything else uses `"quotes"` (mirrors Ruby's normalized_include_header).
function normalized_include_header(header_name: str) -> str:
    if standard_c_runtime_header(header_name):
        return j3("<", header_name, ">")
    return j3("\"", header_name, "\"")


function standard_c_runtime_header(header_name: str) -> bool:
    return (
        header_name == "stdbool.h" or header_name == "stdint.h"
        or header_name == "stdlib.h" or header_name == "string.h"
        or header_name == "stddef.h" or header_name == "stdio.h"
        or header_name == "time.h"
    )


# =============================================================================
#  Function lowering
# =============================================================================

## The `this` receiver type for an `extending` block: the concrete primitive or
## `str` type for primitive receivers (so `this` renders as `mt_str` / `int`
## rather than a bogus `<module>_<type>` struct name), and a nominal
## `ty_imported` type otherwise.
function extending_receiver_type(module_name: str, type_name: str) -> types.Type:
    if type_name == "str":
        return types.Type.ty_str
    if is_builtin_type_name(type_name):
        return types.primitive(type_name)
    return types.Type.ty_imported(module_name = module_name, name = type_name, args = span[types.Type]())


## The resolved receiver type of an `extending` target, mirroring the host's
## `resolve_extending_receiver_type`: a single-part target follows the declaring
## module's own alias chain (`type Color = c.Color` in std.raylib attaches the
## block to the raw `std.c.raylib.Color`), a qualified target follows its import
## alias into the target module's chain (`extending b3.Vec3:` -> `b3Vec3`).
## Returns none when the target names no alias, leaving the caller on the
## literal-name scheme.
function extending_receiver_target(analyses: span[analyzer.Analysis], analysis: analyzer.Analysis, type_ref_ptr: ptr[ast.TypeRef]) -> Option[types.Type]:
    let parts = unsafe: read(type_ref_ptr).name.parts
    if parts.len == 0:
        return Option[types.Type].none
    let last = unsafe: read(parts.data + (parts.len - 1))
    if parts.len == 1:
        let target = analysis.type_alias_types.get(last) else:
            return Option[types.Type].none
        return Option[types.Type].some(value = unsafe: read(target))
    let alias_name = unsafe: read(parts.data + 0)
    let module_ptr = analysis.imports.get(alias_name) else:
        return Option[types.Type].none
    return resolve_imported_alias_type(analyses, unsafe: read(module_ptr), last)


## Lower all methods in an extending block to IR functions.  Each method becomes
## a C function with the receiver as the first parameter (pointer for editable,
## by value for plain, omitted for static).
function lower_extending_block(ctx: ref[LowerCtx], functions: ref[vec.Vec[ir.Function]], type_ref_ptr: ptr[ast.TypeRef], methods: span[ast.Method]) -> void:
    var type_name: str
    var bare_name: str
    unsafe:
        let type_ref = read(type_ref_ptr)
        bare_name = read(type_ref.name.parts.data + (type_ref.name.parts.len - 1))
        if type_ref.name.parts.len == 1:
            type_name = bare_name
        else:
            var buf = string.String.create()
            var bi: ptr_uint = 0
            while bi < type_ref.name.parts.len:
                if bi > 0:
                    buf.append(".")
                buf.append(read(type_ref.name.parts.data + bi))
                bi += 1
            type_name = buf.as_str()
    # Skip generic extending blocks (e.g. `extending Vec[T]:`) — their methods
    # are monomorphized by `lower_monomorphized_call` when concrete calls occur.
    if unsafe: read(type_ref_ptr).arguments.len > 0:
        return
    # An alias target attaches to the *resolved* type: `extending Color:` in
    # std.raylib (with `type Color = c.Color`) and `extending b3.Vec3:` in
    # examples.box3d.common (with `type Vec3 = c.b3Vec3` in std.box3d) both
    # declare methods on the raw C struct, which is the type a call site derives
    # from the receiver — and the type the host names the linkage after.
    var receiver_ty = extending_receiver_type(ctx.module_name, bare_name)
    match extending_receiver_target(ctx.program_analyses, ctx.analysis, type_ref_ptr):
        Option.some as resolved:
            receiver_ty = resolved.value
            match named_type_name(resolved.value):
                Option.some as resolved_name:
                    bare_name = resolved_name.value
                Option.none:
                    pass
        Option.none:
            # A nested struct target (`extending Rectangle.Edge:`): the
            # registered type carries the parent-qualified linkage name, which
            # both the method's C name and its `this` type use.
            let target_parts = unsafe: read(type_ref_ptr).name.parts
            match local_nested_type(ctx, target_parts):
                Option.some as nested:
                    receiver_ty = nested.value
                Option.none:
                    pass
    var mi: ptr_uint = 0
    while mi < methods.len:
        var m: ast.Method
        unsafe:
            m = read(methods.data + mi)
        # Generic methods are monomorphized on demand by `lower_monomorphized_call`.
        if m.type_params.len > 0:
            mi += 1
            continue
        let c_name = method_c_name_for_receiver(receiver_ty, ctx.module_name, bare_name, m.name, m.method_kind)
        # Async methods are lowered through the full CPS path, with the receiver
        # (`this`) as an implicit param — except static async methods, which have
        # no receiver.
        if m.is_async:
            var recv_opt = Option[types.Type].none
            if m.method_kind != ast.MethodKind.mk_static:
                # The parameter keeps the declared receiver type; the editable
                # pointer lives in the frame field and the C declarator (the
                # host's `param_type` vs `field_type` split).
                recv_opt = Option[types.Type].some(value = receiver_ty)
            lower_async_fn(ctx, m.name, c_name, recv_opt, m.method_kind == ast.MethodKind.mk_editable, m.method_params, m.return_type, m.body, functions, false)
            mi += 1
            continue
        functions.push(lower_method(ctx, c_name, receiver_ty, m))
        mi += 1


## Lower a single method to an IR function.  The receiver (`this`) is bound as a
## local parameter (pointer for editable methods, value for plain).
function lower_method(ctx: ref[LowerCtx], c_name: str, receiver_ty: types.Type, m: ast.Method) -> ir.Function:
    ctx.locals.clear()
    ctx.temp_counter = 0
    ctx.fmt_dest_name = ""
    ctx.fmt_counter.clear()
    ctx.fmt_counter_visible = false
    ctx.cstr_backed_names.clear()
    var saved_current_fn = ctx.current_function_linkage
    ctx.current_function_linkage = c_name
    let sig = lookup_fn_sig(ctx, m.name)

    var ir_params = vec.Vec[ir.Param].create()
    var param_setup = vec.Vec[ir.Stmt].create()
    if m.method_kind != ast.MethodKind.mk_static:
        # A pointer-lowered receiver carries its base type with `pointer = true`;
        # the C `*` is added by the backend.  Editable methods borrow, and so do
        # sync methods whose receiver type contains array storage.  Mirrors the
        # host's `pointer_lowered_sync_method_receiver?`.
        let recv_is_ptr = receiver_by_pointer(ctx, receiver_ty, m.method_kind, m.is_async)
        ir_params.push(ir.Param(name = "this", linkage_name = utils.c_local_name("this"), ty = receiver_ty, pointer = Option[bool].some(value = recv_is_ptr)))
        ctx.locals.push(LocalBinding(name = "this", c_name = utils.c_local_name("this"), ty = receiver_ty, pointer = Option[bool].some(value = recv_is_ptr)))
    var pi: ptr_uint = 0
    while pi < m.method_params.len:
        var p: ast.Param
        unsafe:
            p = read(m.method_params.data + pi)
        let param_ty = resolve_param_type(ctx, sig, pi, p.param_type)
        let c_pname = utils.c_local_name(p.name)
        # Params are never pointer-lowered: `ptr`/`ref`/`own` types already
        # render as C pointers.  Matches the host (always `pointer: false`).
        let is_ptr = false
        let link_name = array_param_input_name(param_ty, c_pname, ref_of(param_setup))
        ir_params.push(ir.Param(name = p.name, linkage_name = link_name, ty = param_ty, pointer = Option[bool].some(value = is_ptr)))
        ctx.locals.push(LocalBinding(name = p.name, c_name = c_pname, ty = param_ty, pointer = Option[bool].some(value = is_ptr)))
        pi += 1

    let ret_ty = resolve_return_type(ctx, sig, m.return_type)
    var saved_fn_ret = ctx.current_fn_return_type
    ctx.current_fn_return_type = ret_ty
    let body_stmts = prepend_param_setup(ref_of(param_setup), lower_function_body(ctx, m.body))
    ctx.current_fn_return_type = saved_fn_ret
    ctx.current_function_linkage = saved_current_fn

    return ir.Function(
        name = m.name,
        linkage_name = c_name,
        params = ir_params.as_span(),
        return_type = ret_ty,
        body = body_stmts,
        entry_point = false, public_export = false,
        method_receiver_param = m.method_kind != ast.MethodKind.mk_static,
    )


## A single-element `span[types.Type]` convenience helper.
function sp_type(t: types.Type) -> span[types.Type]:
    return utils.sp_type(t)


function sp_fields(field1: ir.AggregateField) -> span[ir.AggregateField]:
    return utils.sp_fields(field1)


function sp_fields2(f1: ir.AggregateField, f2: ir.AggregateField) -> span[ir.AggregateField]:
    return utils.sp_fields2(f1, f2)


function sp_type2(t1: types.Type, t2: types.Type) -> span[types.Type]:
    return utils.sp_type2(t1, t2)


function sp_expr(expr: ptr[ir.Expr]) -> span[ir.Expr]:
    return utils.sp_expr(expr)


## A canonical string name for a concrete type, used as a vtable identifier suffix.
function canonical_type_name(module_name: str, t: types.Type) -> str:
    match t:
        types.Type.ty_primitive as p:
            return p.name
        types.Type.ty_named as n:
            var buf = string.String.create()
            buf.append(naming.module_c_prefix(module_name))
            buf.append("_")
            buf.append(n.name)
            return buf.as_str()
        types.Type.ty_imported as im:
            if im.args.len > 0:
                # A monomorphized instance's canonical name is its C name
                # (`std_vec_Vec_int`), matching `generic_struct_c_name` keys.
                return naming.qualified_c_name(im.module_name, generic_c_type_raw(im.name, im.args))
            var buf = string.String.create()
            buf.append(naming.module_c_prefix(im.module_name))
            buf.append("_")
            buf.append(im.name)
            return buf.as_str()
        types.Type.ty_generic as g:
            var buf = string.String.create()
            buf.append(g.name)
            var i: ptr_uint = 0
            while i < g.args.len:
                buf.append("_")
                buf.append(canonical_type_name(module_name, unsafe: read(g.args.data + i)))
                i += 1
            return naming.sanitize_identifier(buf.as_str())
        types.Type.ty_str:
            return "str"
        _:
            return "unknown"


## For an array-typed by-value parameter, C decays the array argument to a
## pointer, so the IR parameter is renamed `<c>_input` and a `<c> = <c>_input`
## local decl is appended to `setup` (the C backend renders it as an array
## declaration plus memcpy), preserving pass-by-value semantics and keeping
## `&<c>` a pointer-to-array for checked-index helpers.  For every other type
## the linkage name passes through unchanged.  Mirrors Ruby's
## `input_linkage_name` handling in lowering/functions.rb.
function array_param_input_name(param_ty: types.Type, c_name: str, setup: ref[vec.Vec[ir.Stmt]]) -> str:
    if not is_array_type(param_ty):
        return c_name
    let input_name = j2(c_name, "_input")
    let input_ref = alloc_expr(ir.Expr.expr_name(name = input_name, ty = param_ty, pointer = Option[bool].some(value = false)))
    setup.push(ir.Stmt.stmt_local(name = c_name, linkage_name = c_name, ty = param_ty, value = input_ref, line = 0, source_path = ""))
    return input_name


## Prepend `setup` (array-parameter copies) to a lowered function body.
function prepend_param_setup(setup: ref[vec.Vec[ir.Stmt]], body_stmts: span[ir.Stmt]) -> span[ir.Stmt]:
    if setup.len() == 0:
        return body_stmts
    var full_body = vec.Vec[ir.Stmt].create()
    append_span_stmts(ref_of(full_body), setup.as_span())
    append_span_stmts(ref_of(full_body), body_stmts)
    return full_body.as_span()


## A bare string literal returned from a `-> cstr` function is a C string, not
## an `mt_str`.  When the enclosing function returns `cstr` and the return value
## is a plain (non-`c"..."`) string literal, re-emit it as a cstr literal so the
## C return type matches.  Mirrors Ruby's contextual string-literal coercion.
function coerce_return_literal_to_cstr(ctx: ref[LowerCtx], value: ptr[ast.Expr], lowered: ptr[ir.Expr]) -> ptr[ir.Expr]:
    var is_cstr_ret = false
    match ctx.current_fn_return_type:
        types.Type.ty_primitive as p:
            if p.name == "cstr":
                is_cstr_ret = true
        _:
            pass
    if not is_cstr_ret:
        return lowered
    unsafe:
        match read(value):
            ast.Expr.expr_string_literal as lit:
                if not lit.is_cstring:
                    return alloc_expr(ir.Expr.expr_string_literal(value = lit.value, ty = types.primitive("cstr"), cstring = true))
            _:
                pass
    return lowered


## Multi-string join helpers (mirror c_backend j2, j6).
function lower_function(ctx: ref[LowerCtx], name: str, params: span[ast.Param], return_type: ptr[ast.TypeRef]?, body: ptr[ast.Stmt]?, is_async: bool, public_export: bool) -> ir.Function:
    ctx.locals.clear()
    ctx.temp_counter = 0
    ctx.fmt_dest_name = ""
    ctx.fmt_counter.clear()
    ctx.fmt_counter_visible = false
    ctx.cstr_backed_names.clear()
    var saved_current_fn = ctx.current_function_linkage
    ctx.current_function_linkage = naming.qualified_c_name(ctx.module_name, name)
    let sig = lookup_fn_sig(ctx, name)

    var ir_params = vec.Vec[ir.Param].create()
    var param_setup = vec.Vec[ir.Stmt].create()
    var pi: ptr_uint = 0
    while pi < params.len:
        var p: ast.Param
        unsafe:
            p = read(params.data + pi)
        let param_ty = resolve_param_type(ctx, sig, pi, p.param_type)
        let c_name = utils.c_local_name(p.name)
        let f_ptr = false
        let link_name = array_param_input_name(param_ty, c_name, ref_of(param_setup))
        ir_params.push(ir.Param(name = p.name, linkage_name = link_name, ty = param_ty, pointer = Option[bool].some(value = f_ptr)))
        ctx.locals.push(LocalBinding(name = p.name, c_name = c_name, ty = param_ty, pointer = Option[bool].some(value = f_ptr)))
        pi += 1

    var ret_ty = resolve_return_type(ctx, sig, return_type)
    if is_async:
        ret_ty = make_task_type(ret_ty)
    ctx.inside_async = is_async
    var saved_fn_ret = ctx.current_fn_return_type
    ctx.current_fn_return_type = ret_ty
    let body_stmts = prepend_param_setup(ref_of(param_setup), lower_function_body(ctx, body))
    ctx.current_fn_return_type = saved_fn_ret
    ctx.inside_async = false
    ctx.current_function_linkage = saved_current_fn

    return ir.Function(
        name = name,
        linkage_name = naming.qualified_c_name(ctx.module_name, name),
        params = ir_params.as_span(),
        return_type = ret_ty,
        body = body_stmts,
        entry_point = false,
        public_export = public_export,
        method_receiver_param = false,
    )


## Synthesize the C entry point `int main(...)` that calls the user's root
## `main`.  Supports a no-parameter `main` (`int main(void)`) and a single
## `span[str]` parameter (`int main(int argc, char** argv)` with the argv →
## `span[str]` bridge), each returning `int` or `void`.  Mirrors Ruby's
## build_root_main_entrypoint (:none / :span_str signatures).
function build_root_main_entrypoint(ctx: ref[LowerCtx], name: str, params: span[ast.Param]) -> Option[ir.Function]:
    let sig = lookup_fn_sig(ctx, name)
    let user_return = fn_sig_return_type(sig)
    if not (types.is_void(user_return) or is_int_type(user_return)):
        return Option[ir.Function].none

    let int_ty = types.primitive("int")
    let user_linkage = naming.qualified_c_name(ctx.module_name, name)

    if params.len == 0:
        let call = alloc_expr(ir.Expr.expr_call(callee = user_linkage, arguments = span[ir.Expr](), ty = user_return))
        var body = vec.Vec[ir.Stmt].create()
        append_entry_call_and_return(ref_of(body), call, user_return, int_ty)
        return Option[ir.Function].some(value = ir.Function(
            name = name, linkage_name = "main", params = span[ir.Param](),
            return_type = int_ty, body = body.as_span(), entry_point = true, public_export = false, method_receiver_param = false,
        ))

    # Single `span[str]` parameter: emit `int main(int argc, char** argv)`, build a
    # `span[str]` from argv via the runtime bridge, call the user main, then free.
    if params.len == 1 and main_param_is_span_str(ctx, params):
        let span_str_ty = types.Type.ty_generic(name = "span", args = sp_type(types.Type.ty_str))
        let items_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.Type.ty_str))
        let char_ptr_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("char")))))

        var body = vec.Vec[ir.Stmt].create()
        # mt_str* __mt_args_items = NULL; (the host's null literal, not a `NULL`
        # name — the C backend renders the null literal as `NULL`).
        let items_null = alloc_expr(ir.Expr.expr_null_literal(ty = items_ty))
        body.push(ir.Stmt.stmt_local(name = "__mt_args_items", linkage_name = "__mt_args_items", ty = items_ty, value = items_null, line = 0, source_path = ""))
        let items_ref = alloc_expr(ir.Expr.expr_name(name = "__mt_args_items", ty = items_ty, pointer = Option[bool].some(value = false)))
        # mt_span_str __mt_args = mt_entry_argv_to_span_str(argc, argv, &__mt_args_items);
        let argc_expr = alloc_expr(ir.Expr.expr_name(name = "argc", ty = int_ty, pointer = Option[bool].some(value = false)))
        let argv_expr = alloc_expr(ir.Expr.expr_name(name = "argv", ty = char_ptr_ptr, pointer = Option[bool].some(value = false)))
        let items_addr = alloc_expr(ir.Expr.expr_address_of(expression = items_ref, ty = types.Type.ty_generic(name = "ptr", args = sp_type(items_ty))))
        var bridge_args = vec.Vec[ir.Expr].create()
        unsafe:
            bridge_args.push(read(argc_expr))
            bridge_args.push(read(argv_expr))
            bridge_args.push(read(items_addr))
        let bridge_call = alloc_expr(ir.Expr.expr_call(callee = "mt_entry_argv_to_span_str", arguments = bridge_args.as_span(), ty = span_str_ty))
        body.push(ir.Stmt.stmt_local(name = "__mt_args", linkage_name = "__mt_args", ty = span_str_ty, value = bridge_call, line = 0, source_path = ""))
        let args_ref = alloc_expr(ir.Expr.expr_name(name = "__mt_args", ty = span_str_ty, pointer = Option[bool].some(value = false)))

        var call_args = vec.Vec[ir.Expr].create()
        unsafe:
            call_args.push(read(args_ref))
        let call = alloc_expr(ir.Expr.expr_call(callee = user_linkage, arguments = call_args.as_span(), ty = user_return))

        # Capture the user result, free the argv strings, then return.
        if types.is_void(user_return):
            body.push(ir.Stmt.stmt_expression(expression = call, line = 0, source_path = ""))
            append_free_argv_items(ref_of(body), items_ref)
            let zero = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = int_ty))
            body.push(ir.Stmt.stmt_return(value = zero, line = 0, source_path = ""))
        else:
            body.push(ir.Stmt.stmt_local(name = "__mt_result", linkage_name = "__mt_result", ty = int_ty, value = call, line = 0, source_path = ""))
            append_free_argv_items(ref_of(body), items_ref)
            let exit_ref = alloc_expr(ir.Expr.expr_name(name = "__mt_result", ty = int_ty, pointer = Option[bool].some(value = false)))
            body.push(ir.Stmt.stmt_return(value = exit_ref, line = 0, source_path = ""))

        var entry_params = vec.Vec[ir.Param].create()
        entry_params.push(ir.Param(name = "argc", linkage_name = "argc", ty = int_ty, pointer = Option[bool].some(value = false)))
        entry_params.push(ir.Param(name = "argv", linkage_name = "argv", ty = char_ptr_ptr, pointer = Option[bool].some(value = false)))
        return Option[ir.Function].some(value = ir.Function(
            name = name, linkage_name = "main", params = entry_params.as_span(),
            return_type = int_ty, body = body.as_span(), entry_point = true, public_export = false, method_receiver_param = false,
        ))

    return Option[ir.Function].none


## Append the user-main call and the `int` return to an entry-point body:
## `main() ; return 0;` for a void user main, or `return main();` for an int one.
function append_entry_call_and_return(body: ref[vec.Vec[ir.Stmt]], call: ptr[ir.Expr], user_return: types.Type, int_ty: types.Type) -> void:
    if types.is_void(user_return):
        body.push(ir.Stmt.stmt_expression(expression = call, line = 0, source_path = ""))
        let zero = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = int_ty))
        body.push(ir.Stmt.stmt_return(value = zero, line = 0, source_path = ""))
    else:
        body.push(ir.Stmt.stmt_return(value = call, line = 0, source_path = ""))


## Append `mt_free_entry_argv_strs(__mt_args_items);` to an entry-point body.
function append_free_argv_items(body: ref[vec.Vec[ir.Stmt]], items_ref: ptr[ir.Expr]) -> void:
    var free_args = vec.Vec[ir.Expr].create()
    unsafe:
        free_args.push(read(items_ref))
    let free_call = alloc_expr(ir.Expr.expr_call(callee = "mt_free_entry_argv_strs", arguments = free_args.as_span(), ty = types.primitive("void")))
    body.push(ir.Stmt.stmt_expression(expression = free_call, line = 0, source_path = ""))


## True when the root main's single parameter is `span[str]`.
function main_param_is_span_str(ctx: ref[LowerCtx], params: span[ast.Param]) -> bool:
    if params.len != 1:
        return false
    var p: ast.Param
    unsafe:
        p = read(params.data + 0)
    let resolved = resolve_type_ref(ctx, ptr_of(p.param_type))
    match resolved:
        types.Type.ty_generic as g:
            if g.name == "span" and g.args.len == 1:
                return types.type_to_string(unsafe: read(g.args.data + 0)) == "str"
        _:
            pass
    return false


# =============================================================================
#  Statement lowering
# =============================================================================

## Push a fresh (empty) defer group for a newly-opened lexical block.
function push_defer_scope(ctx: ref[LowerCtx]) -> void:
    ctx.defer_stack.push(DeferGroup(cleanups = vec.Vec[span[ir.Stmt]].create()))


## Pop the innermost defer group when its block closes.
function pop_defer_scope(ctx: ref[LowerCtx]) -> void:
    let _dropped = ctx.defer_stack.pop()


## Record one lowered `defer` cleanup (a statement sequence) in the innermost
## open block's group, in encounter order.
function record_defer(ctx: ref[LowerCtx], cleanup: span[ir.Stmt]) -> void:
    let top = ctx.defer_stack.last() else:
        fatal(c"lowering: defer outside any block scope")
    unsafe:
        read(top).cleanups.push(cleanup)


## Append one defer group's cleanups in reverse encounter order (mirrors Ruby's
## `local_defers.reverse.flat_map`).
function flush_defer_group(group_ptr: ptr[DeferGroup], output: ref[vec.Vec[ir.Stmt]]) -> void:
    unsafe:
        let cleanups = read(group_ptr).cleanups
        if cleanups.len() == 0:
            return
        var i = cleanups.len()
        while i > 0:
            i -= 1
            let span_ptr = cleanups.get(i) else:
                fatal(c"lowering: defer group missing cleanup")
            append_span_stmts(output, read(span_ptr))


## Flush the innermost open block's pending defers (reverse order).  Used at the
## fall-through end of a non-terminating block.
function flush_top_defers(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]]) -> void:
    let top = ctx.defer_stack.last() else:
        return
    flush_defer_group(top, output)


## Flush every open block's pending defers, innermost-first, each in reverse
## encounter order.  Used before a `return` so all active defers run.  Mirrors
## Ruby's `cleanup_statements(local_defers, active_defers)` where active_defers
## is the outer-to-inner concatenation and the whole is reversed.
function flush_all_defers(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]]) -> void:
    var count = ctx.defer_stack.len()
    while count > 0:
        count -= 1
        let group_ptr = ctx.defer_stack.get(count) else:
            fatal(c"lowering: defer stack missing group")
        flush_defer_group(group_ptr, output)


## True when a defer group opened inside the current loop still has pending
## cleanups — the host's `local_defers`/`break_defers` check in `lower_loop_exit`.
function has_loop_defers(ctx: ref[LowerCtx]) -> bool:
    var i = ctx.loop_defer_depth
    while i < ctx.defer_stack.len():
        let group_ptr = ctx.defer_stack.get(i) else:
            return false
        unsafe:
            if read(group_ptr).cleanups.len() > 0:
                return true
        i += 1
    return false


## Flush the defer groups opened inside the current loop, innermost first,
## without popping them (the block's fall-through path emits its own copy).
## The host's `lower_loop_exit`: with a cleanup the exit becomes
## `cleanup...; goto <label>`.
function flush_loop_defers(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]]) -> void:
    var count = ctx.defer_stack.len()
    while count > ctx.loop_defer_depth:
        count -= 1
        let group_ptr = ctx.defer_stack.get(count) else:
            fatal(c"lowering: loop defer stack missing group")
        flush_defer_group(group_ptr, output)


## True when the innermost open block (or any enclosing block) has a pending
## defer, so a `return` needs a cleanup preamble.
function has_pending_defers(ctx: ref[LowerCtx]) -> bool:
    var i: ptr_uint = 0
    while i < ctx.defer_stack.len():
        let group_ptr = ctx.defer_stack.get(i) else:
            return false
        unsafe:
            if read(group_ptr).cleanups.len() > 0:
                return true
        i += 1
    return false


## True for a trivial return expression (a bare literal) whose value cannot be
## invalidated by running defers, so it need not be hoisted into a temp before
## the cleanup preamble.  Mirrors Ruby's `cleanup_safe_return_expression?`.
function cleanup_safe_return_expr(ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_integer_literal:
                return true
            ast.Expr.expr_float_literal:
                return true
            ast.Expr.expr_string_literal:
                return true
            ast.Expr.expr_bool_literal:
                return true
            ast.Expr.expr_null_literal:
                return true
            _:
                return false


## Open a statement-position hoisting window so multi-step expression setups
## (a statement-lowered foreign call's cstr/address temps, call and frees) are
## collected instead of wrapped in an inline `StmtExpr`, mirroring the host's
## `prepare_expression_with_cleanups`.  Returns the enclosing state; close the
## window with `collect_stmt_setup`.
function begin_stmt_setup(ctx: ref[LowerCtx], mode: HoistMode) -> HoistSaved:
    let saved = HoistSaved(mode = ctx.hoist_mode, stmts = ctx.hoist_stmts, cleanups = ctx.hoist_cleanups, stmt_emitted = ctx.hoist_stmt_emitted, root_ep = ctx.hoist_root_ep, array_exempt = ctx.array_call_exempt)
    ctx.hoist_mode = mode
    ctx.hoist_stmts = vec.Vec[ir.Stmt].create()
    ctx.hoist_cleanups = vec.Vec[ir.Stmt].create()
    ctx.hoist_stmt_emitted = false
    ctx.hoist_root_ep = null
    ctx.array_call_exempt = null
    return saved


## Close a hoisting window: restore the enclosing state and return what the
## window collected (`stmts` before the statement, `cleanups` after it).
function collect_stmt_setup(ctx: ref[LowerCtx], saved: HoistSaved) -> HoistSaved:
    let collected = HoistSaved(mode = ctx.hoist_mode, stmts = ctx.hoist_stmts, cleanups = ctx.hoist_cleanups, stmt_emitted = ctx.hoist_stmt_emitted, root_ep = ctx.hoist_root_ep, array_exempt = ctx.array_call_exempt)
    ctx.hoist_mode = saved.mode
    ctx.hoist_stmts = saved.stmts
    ctx.hoist_cleanups = saved.cleanups
    ctx.hoist_stmt_emitted = saved.stmt_emitted
    ctx.hoist_root_ep = saved.root_ep
    ctx.array_call_exempt = saved.array_exempt
    return collected


## Insert a window's `stmts` into `output` at `base`, so they precede every
## statement the statement lowering contributed.
function emit_hoist_setup(output: ref[vec.Vec[ir.Stmt]], base: ptr_uint, collected: HoistSaved) -> void:
    var i: ptr_uint = 0
    while i < collected.stmts.len:
        let stmt = collected.stmts.get(i) else:
            fatal(c"lowering: missing hoisted setup statement")
        let _ = output.insert(base + i, unsafe: read(stmt))
        i += 1


## Append a window's cstr-temp frees only — the async statement paths drop the
## prepared-expression cleanups but still free the foreign argument copies.
function append_cstr_temp_cleanups(output: ref[vec.Vec[ir.Stmt]], collected: HoistSaved) -> void:
    var i: ptr_uint = 0
    while i < collected.cleanups.len:
        let stmt = collected.cleanups.get(i) else:
            fatal(c"lowering: missing hoisted cleanup statement")
        if is_cstr_temp_free_stmt(unsafe: read(stmt)):
            output.push(unsafe: read(stmt))
        i += 1


function is_cstr_temp_free_stmt(stmt: ir.Stmt) -> bool:
    match stmt:
        ir.Stmt.stmt_expression as es:
            match unsafe: read(es.expression):
                ir.Expr.expr_call as c:
                    return c.callee == "mt_free_foreign_cstr_temp"
                _:
                    pass
        _:
            pass
    return false


## Append a window's `cleanups` after the statement that used its value.
function append_hoist_cleanups(output: ref[vec.Vec[ir.Stmt]], collected: HoistSaved) -> void:
    var i: ptr_uint = 0
    while i < collected.cleanups.len:
        let stmt = collected.cleanups.get(i) else:
            fatal(c"lowering: missing hoisted cleanup statement")
        output.push(unsafe: read(stmt))
        i += 1


## A return value lowered inside a `hm_return` window: the hoisted setup has
## already been emitted before the statement, and `cleanups` must run after the
## value is stored (the host's `prepared_cleanup_list`).
struct HoistedValue:
    value: ptr[ir.Expr]
    cleanups: vec.Vec[ir.Stmt]


## Lower a statement-root value expression with a `hm_return` window open: the
## hoisted setup (argument temps, a `__mt_foreign_result_N` temp and the cstr
## frees) is inserted before the statement and the lowered value returned with
## the window's post-statement cleanups.
function lower_expr_hoisting(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], ep: ptr[ast.Expr], array_exempt: bool) -> HoistedValue:
    let base = output.len()
    let saved = begin_stmt_setup(ctx, HoistMode.hm_return)
    # A return value is a statement root: the host passes
    # `allow_root_statement_foreign: true`, so a foreign call keeps its inline
    # shape rather than materializing a `__mt_foreign_expr_N` value.
    ctx.hoist_root_ep = ep
    if array_exempt:
        ctx.array_call_exempt = ep
    let lowered = lower_expr(ctx, ep)
    let collected = collect_stmt_setup(ctx, saved)
    emit_hoist_setup(output, base, collected)
    return HoistedValue(value = lowered, cleanups = collected.cleanups)


## Append a cleanup vec's statements to `output`.
function append_cleanup_stmts(output: ref[vec.Vec[ir.Stmt]], cleanups: vec.Vec[ir.Stmt]) -> void:
    var i: ptr_uint = 0
    while i < cleanups.len:
        let stmt = cleanups.get(i) else:
            break
        output.push(unsafe: read(stmt))
        i += 1


## The IR type of an expression lowered only to discover it (a generic
## method's type-argument inference).  The speculative lowering must not leak
## statement setup into the enclosing window: an array-returning call would
## hoist a `__mt_array_call_<N>` that the real argument lowering then duplicates
## (`infer_type_param_from_args`).  The window is suspended, so the speculative
## pass takes the same inline forms a lazily-evaluated region uses.
function speculative_expr_type(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> types.Type:
    let saved = suspend_stmt_setup(ctx)
    let ty = ir_expr_type(lower_expr(ctx, ep))
    resume_stmt_setup(ctx, saved)
    return ty


## A one-statement span, for recording a hoisted cleanup as a defer group.
function single_stmt_span(stmt: ir.Stmt) -> span[ir.Stmt]:
    var buf = vec.Vec[ir.Stmt].create()
    buf.push(stmt)
    return buf.as_span()


## Place a local declaration's / assignment's hoisted cleanups.  A dynamic
## format string's release is a *prepared* cleanup: the host adds it to
## `local_defers`, so it runs at scope exit or before a return, in reverse
## encounter order.  A foreign call's cstr-temp free is the call's own
## `cleanup_statements`, which the host emits immediately after the statement;
## keep that shape.  (The self's single cleanup channel carries both, so classify
## by the cleanup's callee.)
function record_or_emit_local_cleanups(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], cleanups: vec.Vec[ir.Stmt]) -> void:
    var i: ptr_uint = 0
    while i < cleanups.len:
        let stmt = cleanups.get(i) else:
            break
        let value = unsafe: read(stmt)
        if is_format_release_stmt(value):
            record_defer(ctx, single_stmt_span(value))
        else:
            output.push(value)
        i += 1


## Drop a return value's format-string release when the return type owns the
## buffer (str/cstr or a struct containing one) — the host's `reject_format_
## releases_for_assignment` rule in `lower_return_stmt`.
function filter_return_format_cleanups(ctx: ref[LowerCtx], return_ty: types.Type, cleanups: vec.Vec[ir.Stmt]) -> vec.Vec[ir.Stmt]:
    if not format_owning_target_type(ctx, return_ty, 0):
        return cleanups
    var kept = vec.Vec[ir.Stmt].create()
    var i: ptr_uint = 0
    while i < cleanups.len:
        let stmt = cleanups.get(i) else:
            break
        if not is_format_release_stmt(unsafe: read(stmt)):
            kept.push(unsafe: read(stmt))
        i += 1
    return kept


## Suspend the window around a lazily-evaluated sub-expression (an if/match
## branch, a short-circuit right operand, a proc body): a region that may not
## run must not hoist its setup out, so it keeps the inline `StmtExpr` form.
function suspend_stmt_setup(ctx: ref[LowerCtx]) -> HoistSaved:
    let saved = HoistSaved(mode = ctx.hoist_mode, stmts = ctx.hoist_stmts, cleanups = ctx.hoist_cleanups, stmt_emitted = ctx.hoist_stmt_emitted, root_ep = ctx.hoist_root_ep, array_exempt = ctx.array_call_exempt)
    ctx.hoist_mode = HoistMode.hm_off
    return saved


## Restore the state saved by `suspend_stmt_setup`.
function resume_stmt_setup(ctx: ref[LowerCtx], saved: HoistSaved) -> void:
    ctx.hoist_mode = saved.mode
    ctx.array_call_exempt = saved.array_exempt
    ctx.hoist_stmts = saved.stmts
    ctx.hoist_cleanups = saved.cleanups
    ctx.hoist_stmt_emitted = saved.stmt_emitted
    ctx.hoist_root_ep = saved.root_ep


function lower_block(ctx: ref[LowerCtx], body_ptr: ptr[ast.Stmt]?) -> span[ir.Stmt]:
    var stmts = vec.Vec[ir.Stmt].create()
    push_defer_scope(ctx)
    # The host lowers a nested body that contains no `await` with
    # `lower_async_non_await_statements` (plain locals), even inside a CPS
    # function; returns and `?` still complete the frame because
    # `async_completion_active` stays set.  A block with an await keeps CPS.
    let saved_cps_active = ctx.async_cps_active
    let force_cps = ctx.async_force_cps_body
    ctx.async_force_cps_body = false
    if saved_cps_active and not force_cps and not async_mod.body_has_await(body_ptr):
        # The host's async *analysis* records a frame field for every local
        # declaration regardless of the lowering path, so register this body's
        # fields up front (their lowering still uses plain locals).
        async_register_normalized_body_fields(ctx, body_ptr)
        ctx.async_cps_active = false
    defer: ctx.async_cps_active = saved_cps_active
    # A no-await async body's plain locals carry no source line/path (the
    # host's `lower_async_non_await_statements` LocalDecl omits both).
    let saved_nonawait = ctx.async_nonawait_body
    ctx.async_nonawait_body = ctx.async_completion_active and not ctx.async_cps_active
    defer: ctx.async_nonawait_body = saved_nonawait
    # Flow refinements are block-scoped: the host duplicates its env per block
    # (`block.rb:16`), so a refinement pushed while lowering this block's
    # statements must not escape it.
    let flow_saved = ctx.flow_scopes.len()
    defer: restore_flow_refinements(ctx, flow_saved)
    # `fmt_dest_name` is block-scoped (the host's per-block `env` copy): a local
    # declared inside this block names this block's format results, and the
    # name is restored on exit so sibling blocks are unaffected.
    let fmt_dest_saved = ctx.fmt_dest_name
    defer: ctx.fmt_dest_name = fmt_dest_saved
    # The dynamic format-string counter is created lazily *at the first use in
    # an env* and shared with descendants by reference (the host's
    # `env[:fmt_counter] ||= {}` on a duplicated env): an env whose parent
    # holds no counter starts with none, so sibling blocks each restart at 1
    # (`convex_hull.mt`'s two branches both emit `__fmt_index_cap`), while a
    # child of an env that already counted continues the numbering.
    let fmt_visible_saved = ctx.fmt_counter_visible
    if not fmt_visible_saved:
        ctx.fmt_counter.clear()
    defer:
        if not fmt_visible_saved:
            ctx.fmt_counter.clear()
            ctx.fmt_counter_visible = false
    let bp = body_ptr else:
        pop_defer_scope(ctx)
        return stmts.as_span()
    unsafe:
        match read(bp):
            ast.Stmt.stmt_block as blk:
                var i: ptr_uint = 0
                while i < blk.statements.len:
                    lower_stmt(ctx, ref_of(stmts), blk.statements.data + i)
                    i += 1
            _:
                lower_stmt(ctx, ref_of(stmts), bp)
    # Run this block's defers on fall-through exit (skipped when the block
    # already ends in a terminator such as return/break/continue/goto, whose
    # lowering flushed the relevant defers itself).
    # The host decides an async body's fall-through cleanup with its AST CFG
    # (`cfg_block_always_terminates?`, `async_lowering.rb:314,747`); the sync
    # path keeps its shallow IR check (`terminating_ir_statement?`).
    var terminates = stmts_terminate(stmts.as_span())
    if ctx.async_completion_active:
        terminates = async_body_always_terminates(body_ptr)
    if not terminates:
        flush_top_defers(ctx, ref_of(stmts))
    pop_defer_scope(ctx)
    return stmts.as_span()


## True when the AST body always transfers control away (the host's
## `cfg_block_always_terminates?`).
function async_body_always_terminates(body_ptr: ptr[ast.Stmt]?) -> bool:
    let b = body_ptr else:
        return false
    var cfg = flow_builder.empty_cfg()
    defer: flow_builder.cfg_release(ref_of(cfg))
    var graph = flow_graph.empty_graph()
    defer: flow_graph.graph_release(ref_of(graph))
    flow_builder.build_graph_into(ref_of(cfg), ref_of(graph), span[ast.Param](), b)
    # The host builds the block with the graph's exit as its continuation and
    # asks whether the exit is reachable (`Termination.block_always_terminates?`).
    # `graph.entry_id` is the body entry `build_graph_body` returned.
    let entry = graph.entry_id
    if entry == 0:
        return false
    return not flow_graph.graph_reaches(ref_of(graph), entry, graph.exit_id)


## Lower a function/method/proc body with an isolated defer stack.  Generic
## methods and functions are monomorphized lazily *during* the expression
## lowering of an unrelated enclosing body, so they must not observe or flush the
## enclosing body's pending defers.  This mirrors Ruby, where each function body
## carries its defers in its own `local_env` rather than a shared context.  The
## outer stack is saved, replaced by a fresh empty one for the duration of the
## body, and restored afterwards.
function lower_function_body(ctx: ref[LowerCtx], body_ptr: ptr[ast.Stmt]?) -> span[ir.Stmt]:
    let saved = ctx.defer_stack
    let saved_flow = ctx.flow_scopes
    ctx.defer_stack = vec.Vec[DeferGroup].create()
    ctx.flow_scopes = vec.Vec[map_mod.Map[str, types.Type]].create()
    let result = lower_block(ctx, body_ptr)
    ctx.defer_stack = saved
    ctx.flow_scopes = saved_flow
    return result


function lower_stmt(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], sp: ptr[ast.Stmt]) -> void:
    unsafe:
        match read(sp):
            ast.Stmt.stmt_ret as r:
                # An async resume body completes the frame inline (the host's
                # `async_complete_statements`): the return value stores into
                # `frame->result`, then ready + waiter wake + return follow.
                # This way returns inside nested blocks (if/while/for/switch)
                # reach the waiter-wake + void-return epilogue instead of
                # returning directly with a value from a void function.
                if ctx.async_completion_active:
                    let rv = r.value
                    let ret_ty = ctx.current_fn_return_type
                    if rv != null and not types.is_void(ret_ty):
                        # `return await X`: suspend, then store the awaited result.
                        if ctx.async_cps_active and expr_is_direct_await(rv):
                            lower_async_await_into(ctx, output, direct_await_inner(rv), Option[ptr[ir.Expr]].some(value = async_result_target(ctx, ret_ty)))
                            flush_all_defers(ctx, output)
                            async_complete_statements(ctx, output, ret_ty, Option[ptr[ir.Expr]].none)
                            return
                        # Hoist any embedded awaits in the return value first.
                        var rvh = rv
                        if ctx.async_cps_active and async_mod.expr_has_await(rv):
                            rvh = async_hoist_awaits(ctx, output, rv)
                        let lowered = lower_expr(ctx, rvh)
                        # The host stores the result before the cleanups only for
                        # a non-literal value when cleanups exist
                        # (`async_lowering.rb:1105`); a literal can be stored by
                        # the completion after the cleanups run.
                        if has_pending_defers(ctx) and not cleanup_safe_return_expr(rv):
                            output.push(ir.Stmt.stmt_assignment(
                                target = async_result_target(ctx, ret_ty),
                                operator = "=",
                                value = lowered,
                            ))
                            flush_all_defers(ctx, output)
                            async_complete_statements(ctx, output, ret_ty, Option[ptr[ir.Expr]].none)
                        else:
                            flush_all_defers(ctx, output)
                            async_complete_statements(ctx, output, ret_ty, Option[ptr[ir.Expr]].some(value = lowered))
                        return
                    # A void return (or no value): cleanups precede completion.
                    flush_all_defers(ctx, output)
                    async_complete_statements(ctx, output, ret_ty, Option[ptr[ir.Expr]].none)
                    return
                # `return expr?` — handle ? propagation inline before lowering
                # the return value so the ? is resolved to an if/failure pattern
                # rather than emitted as a raw ? prefix in C.
                let rval = r.value
                if rval != null:
                    unsafe:
                        match read(rval):
                            ast.Expr.expr_unary_op as un:
                                if un.operator == "?":
                                    flush_all_defers(ctx, output)
                                    lower_propagate_return(ctx, output, un.operand, r.line, ctx.analysis.source_path)
                                    return
                            _:
                                pass
                let value = r.value else:
                    flush_all_defers(ctx, output)
                    # In async functions (inside_async / async_resume_return_label),
                    # a bare `return;` produces a completed Task[void] aggregate
                    # rather than a void return.
                    if ctx.inside_async:
                        let void_ret_val = alloc_expr(ir.Expr.expr_zero_init(ty = ctx.void_ty))
                        let wrapped = make_task_literal(void_ret_val)
                        output.push(ir.Stmt.stmt_return(value = wrapped, line = r.line, source_path = ctx.analysis.source_path))
                    else:
                        output.push(ir.Stmt.stmt_return(value = null, line = r.line, source_path = ctx.analysis.source_path))
                    return
                # `return match ...`: a match expression has no direct C form, so
                # hoist it into a synthetic temp local (a switch / if-chain that
                # assigns each arm's value), run any active defers, then return the
                # temp.
                match read(value):
                    ast.Expr.expr_match as me:
                        let ret_ty = current_return_type(ctx, value)
                        let temp = fresh_c_temp_name(ctx, "match_expr")
                        let tc = utils.c_local_name(temp)
                        let zero_init = alloc_expr(ir.Expr.expr_zero_init(ty = ret_ty))
                        output.push(ir.Stmt.stmt_local(name = temp, linkage_name = tc, ty = ret_ty, value = zero_init, line = 0, source_path = ""))
                        let result_ref = alloc_expr(ir.Expr.expr_name(name = tc, ty = ret_ty, pointer = Option[bool].some(value = false)))
                        lower_match_expr_to_ref(ctx, output, me.scrutinee, me.arms, result_ref)
                        flush_all_defers(ctx, output)
                        let ret_ref = alloc_expr(ir.Expr.expr_name(name = tc, ty = ret_ty, pointer = Option[bool].some(value = false)))
                        output.push(ir.Stmt.stmt_return(value = ret_ref, line = r.line, source_path = ctx.analysis.source_path))
                        return
                    _:
                        pass
                # Plain `return expr`: when defers or hoisted cleanups are active
                # they must run after the return value is computed but before
                # control leaves.  If the value is not a trivial literal, hoist
                # it into a temp so the cleanups cannot invalidate it (the host's
                # return-value hoist + cleanup preamble, `block.rb:495-511`).
                let hoisted = lower_expr_hoisting(ctx, output, value, is_array_type(ctx.current_fn_return_type))
                let lowered = coerce_return_literal_to_cstr(ctx, value, hoisted.value)
                # Re-type an integer literal return value against the function's
                # return type (e.g. `return 0` in a `ptr_uint` function), matching
                # the host's contextual numeric literal inference.
                let ret_ty0 = ctx.current_fn_return_type
                let ret_lit = int_literal_to_context_type(value, ret_ty0, lowered)
                let ret_flt = float_literal_to_context_type(value, ret_ty0, ret_lit)
                # A bare `null` return takes the function's return type (the
                # analyzer may record only `void` for it).
                let ret_null = null_literal_to_context_type(value, ret_ty0, ret_flt)
                # A conditional return value takes the return type on both
                # branches (`return if b: 1 else: 0` in a `long` function).
                let ret_cond = conditional_value_to_context_type(ctx, value, ret_ty0, ret_null)
                # The host's return-site contextual conversion: a folded numeric
                # constant that fits, and int→float for a float/double return.
                let ret_typed = contextual_numeric_cast(ctx, value, ret_cond, ret_ty0, types.is_float_type(ret_ty0) and not is_foreign_call_initializer(ctx, value), false)
                let wrapped = if ctx.inside_async: make_task_literal(ret_typed) else: ret_typed
                # A returned str/cstr (or a struct containing one) transfers the
                # dynamic format temp's buffer to the caller, so its release is
                # dropped; every other return type keeps the release.
                let ret_cleanups = filter_return_format_cleanups(ctx, ctx.current_fn_return_type, hoisted.cleanups)
                # A returned proc-containing value is retained before the defers
                # (whose proc releases would otherwise free it) when it is not a
                # fresh literal — the host's `needs_proc_retain` rule
                # (`block.rb:503-509`).
                let ret_needs_proc_retain = has_pending_defers(ctx) and contains_proc_storage_type(ctx, ctx.current_fn_return_type) and not proc_expr_contains_proc_expr(value)
                if ((ret_cleanups.len > 0 or has_pending_defers(ctx)) and not cleanup_safe_return_expr(value)) or ret_needs_proc_retain:
                    # The host's hoist declares the temp with the *function's*
                    # return type (`block.rb:508`), not the value's own type
                    # (`return <own[String]>` from an `own[String]?` function
                    # carries `Nullable(ptr[String])`).
                    var ret_ty = ir_expr_type(wrapped)
                    if not types.is_void(ctx.current_fn_return_type) and not types.is_error(ctx.current_fn_return_type):
                        ret_ty = ctx.current_fn_return_type
                    let rtemp = fresh_c_temp_name(ctx, "return_value")
                    let rc = utils.c_local_name(rtemp)
                    output.push(ir.Stmt.stmt_local(name = rtemp, linkage_name = rc, ty = ret_ty, value = wrapped, line = 0, source_path = ""))
                    let rref = alloc_expr(ir.Expr.expr_name(name = rc, ty = ret_ty, pointer = Option[bool].some(value = false)))
                    if ret_needs_proc_retain:
                        proc_contained_retain_stmts(ctx, rref, ret_ty, output)
                    append_cleanup_stmts(output, ret_cleanups)
                    flush_all_defers(ctx, output)
                    output.push(ir.Stmt.stmt_return(value = rref, line = r.line, source_path = ctx.analysis.source_path))
                    return
                append_cleanup_stmts(output, ret_cleanups)
                flush_all_defers(ctx, output)
                output.push(ir.Stmt.stmt_return(value = wrapped, line = r.line, source_path = ctx.analysis.source_path))
            ast.Stmt.stmt_local as loc:
                # Async CPS: spill every `let`/`var` to a frame field and, when the
                # initializer is a direct `await`, split into suspend/resume.
                if ctx.async_cps_active and loc.destructure_bindings.is_none() and loc.else_body == null:
                    lower_async_local(ctx, output, loc.name, loc.value, loc.stmt_type, loc.line)
                    return
                match loc.destructure_bindings:
                    Option.some as binds:
                        lower_destructure(ctx, output, binds.value, loc.destructure_type_name, loc.value)
                        return
                    Option.none:
                        pass
                # Guard form: `let x = expr else: <exit>` (and var).  The else body
                # runs on the absent/failure case; on success `x` binds the
                # unwrapped value.
                if loc.else_body != null and loc.value != null:
                    lower_guard_local(ctx, output, loc.name, loc.else_binding, loc.value, loc.else_body, loc.line)
                    return
                # A `_` binding keeps the host's declaration shape: the IR name
                # is `_` and the linkage is a fresh discard temp (`__mt___N`,
                # `let_else_storage_c_name`).  The value is evaluated and stored
                # like any other local — `let _ = expr?` still propagates.
                let c_name = if loc.name == "_": fresh_c_temp_name(ctx, "_") else: utils.c_local_name(loc.name)
                let init_val = loc.value
                if init_val != null:
                    # The host's `env[:current_local_name]`: a dynamic format
                    # string later in this block names its result temp after the
                    # most recent local declaration (`__fmt_<name>`).  Only the
                    # synchronous `lower_local_decl_stmt` records it; the async
                    # statement paths never do, so an async body's format result
                    # uses the `fmt_str` counter (`__mt_fmt_str_N`).
                    if not ctx.inside_async:
                        ctx.fmt_dest_name = c_name
                    unsafe:
                        match read(init_val):
                            ast.Expr.expr_unary_op as un:
                                if un.operator == "?":
                                    # The host allocates the discard binding's
                                    # temp name *before* preparing the value
                                    # (`let_else_storage_c_name` precedes
                                    # `prepare_expression_with_cleanups`), so the
                                    # `__mt___N` counter value is the statement's
                                    # own, not one past the propagation temp's.
                                    lower_propagate_let(ctx, output, loc.name, un.operand, loc.line, false, c_name)
                                    return
                            # `let x = <cast>(inner?)` — the `?` is nested inside a
