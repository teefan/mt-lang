                let while_flow_saved = push_flow_refinements(ctx, ref_of(while_refs))
                let body_span = lower_block(ctx, w.body)
                restore_flow_refinements(ctx, while_flow_saved)
                var body = vec.Vec[ir.Stmt].create()
                append_span_stmts(ref_of(body), body_span)
                if contains_label_target(body.as_span(), cl):
                    body.push(ir.Stmt.stmt_label(name = cl))
                var wrap = vec.Vec[ir.Stmt].create()
                wrap.push(ir.Stmt.stmt_while(condition = cond, body = body.as_span()))
                if contains_label_target(body.as_span(), bl):
                    wrap.push(ir.Stmt.stmt_label(name = bl))
                if ctx.async_cps_active:
                    # The host's CF path emits the while directly (no scoping
                    # block); only the sync path wraps it.
                    var wi: ptr_uint = 0
                    while wi < wrap.len():
                        let wsp = wrap.get(wi) else:
                            break
                        output.push(unsafe: read(wsp))
                        wi += 1
                else:
                    output.push(ir.Stmt.stmt_block(body = wrap.as_span()))
                ctx.loop_break_label = saved_break
                ctx.loop_continue_label = saved_continue
                ctx.loop_continue_native = saved_continue_native
                ctx.loop_break_native = saved_break_native
                ctx.loop_defer_depth = saved_loop_depth
            ast.Stmt.stmt_for as f:
                if f.is_inline:
                    lower_inline_for_stmt(ctx, output, f.bindings, f.iterables, f.body)
                    return
                if f.threaded:
                    lower_parallel_for(ctx, output, f.bindings, f.iterables, f.body)
                    return
                # A for-loop's desugared post statement sits after its continue
                # point, so its body keeps the label/goto form.
                let saved_continue_native = ctx.loop_continue_native
                ctx.loop_continue_native = false
                lower_for_range(ctx, output, f.bindings, f.iterables, f.body)
                ctx.loop_continue_native = saved_continue_native
            ast.Stmt.stmt_expression as ex:
                # Async CPS: bare `await Y` splits into suspend/resume, discarding
                # the awaited result.
                if ctx.async_cps_active and expr_is_direct_await(ex.expression):
                    lower_async_await_into(ctx, output, direct_await_inner(ex.expression), Option[ptr[ir.Expr]].none)
                    return
                # Bare `expr?` propagation: unwrap the result and return on failure.
                unsafe:
                    match read(ex.expression):
                        ast.Expr.expr_unary_op as un:
                            if un.operator == "?":
                                lower_propagate_let(ctx, output, "_", un.operand, ex.line, true, "")
                                return
                        _:
                            pass
                # Assertion intrinsics are statement-only: lower to
                # `if (!condition) fatal(message)`.
                unsafe:
                    match read(ex.expression):
                        ast.Expr.expr_call as call:
                            match read(call.callee):
                                ast.Expr.expr_identifier as id:
                                    if id.name == "assert" or id.name == "expect" or id.name == "expect_eq" or id.name == "expect_ne":
                                        lower_assert_stmt(ctx, output, id.name, call.args, ex.line)
                                        return
                                _:
                                    pass
                        _:
                            pass
                # Explicit format sinks (`String`/`str_buffer` append_format/
                # assign_format, and `std.fmt.append_format/assign_format`) are
                # statement-only: the host streams the format into the
                # destination instead of building a `str` and copying it.  An
                # async body lowers its statements through
                # `lower_async_expression_statement`, which has no sink case, so
                # the ordinary call form is emitted there.
                if not ctx.async_completion_active:
                    if lower_explicit_format_sink_stmt(ctx, output, ex.expression, ex.line):
                        return
                let stmt_base = output.len()
                let stmt_saved = begin_stmt_setup(ctx, HoistMode.hm_discard)
                ctx.hoist_root_ep = ex.expression
                let lowered = lower_expr(ctx, ex.expression)
                let stmt_collected = collect_stmt_setup(ctx, stmt_saved)
                emit_hoist_setup(output, stmt_base, stmt_collected)
                if not stmt_collected.stmt_emitted:
                    output.push(ir.Stmt.stmt_expression(expression = lowered, line = ex.line, source_path = ctx.analysis.source_path))
                # A consuming foreign call nulls its argument bindings after the
                # call (the host's `consuming_foreign_release_assignments`),
                # before the statement's cstr cleanups.
                append_foreign_consuming_releases(ctx, output, ex.expression)
                # The host's async statement paths (`lower_async_expression_
                # statement` / `lower_async_non_await_statements`) never drain
                # `prepared_expression_cleanups`, so an async body's prepared
                # temps (a dynamic format string's release) are dropped there;
                # the cstr temps of the same window are still freed.
                if ctx.async_completion_active:
                    append_cstr_temp_cleanups(output, stmt_collected)
                else:
                    append_hoist_cleanups(output, stmt_collected)
            ast.Stmt.stmt_when as wn:
                lower_when_stmt(ctx, output, wn.discriminant, wn.branches, wn.else_body)
            ast.Stmt.stmt_parallel_block as pb:
                lower_parallel_block(ctx, output, pb.bodies)
            ast.Stmt.stmt_gather as gth:
                lower_gather_stmt(ctx, output, gth.handles)
            ast.Stmt.stmt_pass:
                pass
            ast.Stmt.stmt_if as iff:
                if iff.is_inline:
                    lower_inline_if_statement(ctx, output, iff.branches, iff.else_body)
                    return
                # Async CPS: hoist an await in a single `if` condition into
                # preceding statements (the condition is evaluated exactly once).
                # else-if chains with awaits in later conditions are left to the
                # normal path (rare; would need nested restructuring).
                if ctx.async_cps_active and iff.branches.len == 1:
                    let br0 = unsafe: read(iff.branches.data + 0)
                    if async_mod.expr_has_await(br0.condition):
                        let cond_hoisted = async_hoist_awaits(ctx, output, br0.condition)
                        var new_branches = vec.Vec[ast.IfBranch].create()
                        new_branches.push(ast.IfBranch(condition = cond_hoisted, body = br0.body, line = br0.line, column = br0.column))
                        var async_if_stmts = vec.Vec[ir.Stmt].create()
                        lower_if_chain(ctx, ref_of(async_if_stmts), new_branches.as_span(), 0, iff.else_body)
                        output.append_span(async_if_stmts.as_span())
                        return
                # An inline-for body lowers with the host's constant folding
                # (`@bypass_sema_type_cache`): a condition over the comptime
                # element (`member.name == "red"`, `field.type != float`) picks
                # exactly one branch.
                if ctx.inline_for_element.is_some():
                    lower_inline_for_if_fold(ctx, output, iff.branches, iff.else_body)
                    return
                if iff.branches.len > 0:
                    lower_if_chain(ctx, output, iff.branches, 0, iff.else_body)
            ast.Stmt.stmt_match as m:
                if m.is_inline:
                    lower_inline_match_statement(ctx, output, m.scrutinee, m.arms)
                    return
                # In an async CPS body, an `await` embedded in the match scrutinee
                # (`match await expr: ...`) must be hoisted to a frame field and
                # split into a suspend/resume point before the switch is emitted;
                # otherwise the whole match (scrutinee + arms) is dropped.
                var match_scrutinee = m.scrutinee
                if ctx.async_cps_active and async_mod.expr_has_await(m.scrutinee):
                    match_scrutinee = async_hoist_awaits(ctx, output, m.scrutinee)
                lower_match(ctx, output, match_scrutinee, m.arms)
            ast.Stmt.stmt_break:
                # A loop-scoped cleanup forces the label/goto form: the defers
                # run before the jump (the host's `lower_loop_exit`).
                if has_loop_defers(ctx) and ctx.loop_break_label != "":
                    flush_loop_defers(ctx, output)
                    output.push(ir.Stmt.stmt_goto(label = ctx.loop_break_label))
                else if ctx.loop_break_native:
                    output.push(ir.Stmt.stmt_break())
                else if ctx.loop_break_label != "":
                    output.push(ir.Stmt.stmt_goto(label = ctx.loop_break_label))
                else:
                    output.push(ir.Stmt.stmt_break())
            ast.Stmt.stmt_continue:
                if has_loop_defers(ctx) and ctx.loop_continue_label != "":
                    flush_loop_defers(ctx, output)
                    output.push(ir.Stmt.stmt_goto(label = ctx.loop_continue_label))
                else if ctx.loop_continue_native:
                    output.push(ir.Stmt.stmt_continue())
                else if ctx.loop_continue_label != "":
                    output.push(ir.Stmt.stmt_goto(label = ctx.loop_continue_label))
                else:
                    output.push(ir.Stmt.stmt_continue())
            ast.Stmt.stmt_static_assert as sa:
                let assertion = lower_static_assert(ctx, sa.condition, sa.message)
                output.push(ir.Stmt.stmt_static_assert(condition = assertion.condition, message = assertion.message))
            ast.Stmt.stmt_unsafe as u:
                if u.body != null:
                    # Lower the unsafe body into its own statement list and wrap it
                    # in an IR block, so its locals get a distinct C scope (`{ }`).
                    # Without this, sibling `unsafe:` blocks that each declare the
                    # same local name (e.g. `let t = read(tok)`) collide in the flat
                    # function scope ("redefinition of 't'").  The parser wraps an
                    # indented body in a `stmt_block`, which must be unwrapped here
                    # so the result is a single block (matching the host).
                    var body_stmts = vec.Vec[ir.Stmt].create()
                    # The wrapped body is its own C `{ }` scope, so it needs its
                    # own defer group: a `defer` declared inside must replay
                    # inside the block, not after it (where its locals are gone).
                    push_defer_scope(ctx)
                    unsafe:
                        match read(ptr[ast.Stmt]<-u.body):
                            ast.Stmt.stmt_block as blk:
                                var bi: ptr_uint = 0
                                while bi < blk.statements.len:
                                    lower_stmt(ctx, ref_of(body_stmts), blk.statements.data + bi)
                                    bi += 1
                            _:
                                lower_stmt(ctx, ref_of(body_stmts), ptr[ast.Stmt]<-u.body)
                    if not stmts_terminate(body_stmts.as_span()):
                        flush_top_defers(ctx, ref_of(body_stmts))
                    pop_defer_scope(ctx)
                    if ctx.async_completion_active:
                        # The async lowerers splice an unsafe body's statements
                        # (`async_lowering.rb:289,736`) instead of wrapping them
                        # in a block.
                        append_span_stmts(output, body_stmts.as_span())
                    else:
                        output.push(ir.Stmt.stmt_block(body = body_stmts.as_span()))
                return
            ast.Stmt.stmt_block as blk:
                var block_stmts = vec.Vec[ir.Stmt].create()
                push_defer_scope(ctx)
                var i: ptr_uint = 0
                while i < blk.statements.len:
                    unsafe:
                        lower_stmt(ctx, ref_of(block_stmts), ptr[ast.Stmt]<-(blk.statements.data + i))
                    i += 1
                if not stmts_terminate(block_stmts.as_span()):
                    flush_top_defers(ctx, ref_of(block_stmts))
                pop_defer_scope(ctx)
                output.push(ir.Stmt.stmt_block(body = block_stmts.as_span()))
            ast.Stmt.stmt_defer as d:
                # A `defer` does not emit at its declaration site.  Lower its
                # cleanup into its own statement span and record it in the
                # innermost open block; the span is replayed on block exit and
                # before every `return` (reverse order).  Mirrors Ruby's
                # lower_defer_cleanup_expression / lower_defer_cleanup_body.
                var cleanup = vec.Vec[ir.Stmt].create()
                if d.expression != null:
                    cleanup.push(ir.Stmt.stmt_expression(
                        expression = lower_expr(ctx, ptr[ast.Expr]<-d.expression),
                        line = 0, source_path = "",
                    ))
                if d.body != null:
                    # The host's `lower_defer_cleanup_body` is `lower_block` — a
                    # *flat* statement list — so a braced body splices its
                    # statements into the cleanup span instead of wrapping them
                    # in an `IR::BlockStmt` (`examples/box3d/common.mt`'s `run`
                    # replays `UnloadModel`, `b3DestroyWorld`, `CloseWindow` as
                    # siblings).
                    let defer_body = lower_block(ctx, ptr[ast.Stmt]<-d.body)
                    append_span_stmts(ref_of(cleanup), defer_body)
                record_defer(ctx, cleanup.as_span())
            ast.Stmt.stmt_emit as em:
                # The host lowers the emitted declaration a second time here
                # (`lower_emit_stmt`) and appends it to
                # `@artifacts.emitted_declarations`; the analyzer's own
                # expansion (`expand_emit_declarations`) already produced the
                # ordinary declaration, so both copies exist in the IR.
                let emitted_decl = em.declaration else:
                    return
                lower_emitted_decl(ctx, unsafe: read(emitted_decl))
                return
            _:
                fatal(c"lowering: unsupported statement")


## Lower an `emit` declaration into the program's emitted-declaration tail (the
## host's `lower_emit_stmt` + `@artifacts.emitted_declarations`).  The emitted
## names use the host's prefix concatenation (no separator):
## `<module_prefix><decl_name>`.
function lower_emitted_decl(ctx: ref[LowerCtx], decl: ast.Decl) -> void:
    let prefix = naming.module_c_prefix(ctx.module_name)
    match decl:
        ast.Decl.decl_function as fun:
            let sig = lookup_fn_sig(ctx, fun.name)
            let ret_ty = resolve_return_type(ctx, sig, fun.return_type)
            var params = vec.Vec[ir.Param].create()
            let saved_locals_len = ctx.locals.len()
            var pi: ptr_uint = 0
            while pi < fun.method_params.len:
                var p: ast.Param
                unsafe:
                    p = read(fun.method_params.data + pi)
                let p_ty = resolve_param_type(ctx, sig, pi, p.param_type)
                let pc = utils.c_local_name(p.name)
                params.push(ir.Param(name = p.name, linkage_name = pc, ty = p_ty, pointer = Option[bool].some(value = false)))
                ctx.locals.push(LocalBinding(name = p.name, c_name = pc, ty = p_ty, pointer = Option[bool].some(value = false)))
                pi += 1
            let saved_ret = ctx.current_fn_return_type
            ctx.current_fn_return_type = ret_ty
            let saved_fmt = ctx.fmt_dest_name
            ctx.fmt_dest_name = ""
            let body = lower_block(ctx, fun.body)
            ctx.fmt_dest_name = saved_fmt
            ctx.current_fn_return_type = saved_ret
            while ctx.locals.len() > saved_locals_len:
                let _popped = ctx.locals.pop()
            push_emitted_function(ctx, ir.Function(
                name = fun.name,
                linkage_name = j2(prefix, fun.name),
                params = params.as_span(),
                return_type = ret_ty,
                body = body,
                entry_point = false, public_export = false,
                method_receiver_param = false,
            ))
        ast.Decl.decl_struct as st:
            var fields = vec.Vec[ir.Field].create()
            var fi: ptr_uint = 0
            while fi < st.struct_fields.len:
                var f: ast.Field
                unsafe:
                    f = read(st.struct_fields.data + fi)
                fields.push(ir.Field(name = f.name, ty = resolve_field_type_ref(ctx, f.field_type)))
                fi += 1
            push_emitted_struct(ctx, ir.StructDecl(
                name = st.name,
                linkage_name = j2(prefix, st.name),
                fields = fields.as_span(),
                packed = st.packed,
                alignment = 0,
                source_module = Option[str].none,
            ))
        ast.Decl.decl_const as c:
            let c_ty = resolve_type_ref(ctx, c.const_type)
            var c_val = alloc_expr(ir.Expr.expr_zero_init(ty = c_ty))
            let c_value = c.value
            if c_value != null:
                var lowered = lower_expr(ctx, unsafe: ptr[ast.Expr]<-c_value)
                lowered = literal_value_to_context_type(ctx, unsafe: ptr[ast.Expr]<-c_value, c_ty, lowered)
                c_val = lowered
            push_emitted_constant(ctx, ir.Constant(
                name = c.name,
                linkage_name = naming.qualified_c_name(ctx.module_name, c.name),
                ty = c_ty,
                value = c_val,
                line = c.line,
                path = ctx.analysis.source_path,
            ))
        _:
            pass


function push_emitted_function(ctx: ref[LowerCtx], f: ir.Function) -> void:
    let sink = ctx.pending_emitted_functions
    if sink != null:
        unsafe: read(sink).push(f)


function push_emitted_struct(ctx: ref[LowerCtx], s: ir.StructDecl) -> void:
    let sink = ctx.pending_emitted_structs
    if sink != null:
        unsafe: read(sink).push(s)


function push_emitted_constant(ctx: ref[LowerCtx], c: ir.Constant) -> void:
    let sink = ctx.pending_emitted_constants
    if sink != null:
        unsafe: read(sink).push(c)


## The declared type of a local (resolved from its annotation when present and
## scalar), else the inferred type of its initializer.
function local_decl_type(ctx: ref[LowerCtx], declared: ptr[ast.TypeRef]?, value: ptr[ast.Expr]) -> types.Type:
    let annotation = declared else:
        return qualify_type(ctx, expr_type(ctx, value))
    let resolved = resolve_type_ref(ctx, annotation)
    if types.is_error(resolved):
        return qualify_type(ctx, expr_type(ctx, value))
    return qualify_type(ctx, resolved)


## Lower a guard local `let name = value else: <else_body>` (and the `var` form).
## The initializer has an `Option[T]`, `Result[T, E]`, or nullable `T?` storage
## type; the `else` body runs on the absent/failure case and must exit control
## flow.  On success `name` reads the unwrapped success value `T`.  Mirrors Ruby's
## let-else lowering (block.rb): store the value in the storage local, emit
## `if (failure) { <else_body> }`, then register `name` as a projection binding
## over that storage local (the host projects at each use site).
function lower_guard_local(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], name: str, else_binding: Option[str], value: ptr[ast.Expr]?, else_body: ptr[ast.Stmt]?, line: ptr_uint) -> void:
    let value_ptr = value else:
        fatal(c"lowering: guard local requires an initializer")
    # Hidden storage local holding the full Option/Result/nullable value.  The
    # host names it after the user binding (`memory`) so the C local name is
    # stable; `_` and discarded bindings get a fresh temp.  It is allocated
    # *before* the initializer's temps (the host's `lower_local_decl_stmt`
    # computes `linkage_name` first) and becomes the block's format
    # destination, so a later `f"..."` in this block (the guard's own else body
    # included) is named `__fmt_<storage>`.
    let storage_c = if name == "_": fresh_c_temp_name(ctx, "let_else_discard") else: utils.c_local_name(name)
    # The same sync-only `current_local_name` rule as a plain local: the async
    # statement paths never record it.
    if not ctx.inside_async:
        ctx.fmt_dest_name = storage_c
    var storage_ty: types.Type
    var storage_ref: ptr[ir.Expr]
    if ctx.async_cps_active and expr_is_direct_await(value_ptr):
        # The host normalizer hoists the guard's direct await, and the CF
        # lowering takes the awaited result straight into the guard's frame
        # storage field (the field holds the full Result/Option; there is no
        # separate temp field and no second store).
        var inner = direct_await_inner(value_ptr)
        if async_mod.expr_has_await(inner):
            inner = async_hoist_awaits(ctx, output, inner)
        let task_ir = lower_expr(ctx, inner)
        let task_ty = normalize_awaited_task_type(ir_expr_type(task_ir))
        storage_ty = extract_task_element_type(ctx, task_ty)
        let gfield = if name == "_": j2("local_discard_", pw1_str(line)) else: j2("local_", name)
        async_register_unused_field(ctx, gfield, storage_ty)
        let frame_ref = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false)))
        let target = alloc_expr(ir.Expr.expr_member(receiver = frame_ref, member = gfield, ty = storage_ty))
        async_emit_await(ctx, output, task_ir, task_ty, storage_ty, Option[ptr[ir.Expr]].some(value = target), inner)
        storage_ref = alloc_expr(ir.Expr.expr_member(receiver = frame_ref, member = gfield, ty = storage_ty))
    else:
        # The initializer is a prepared position: a foreign call's argument/cleanup
        # temporaries hoist into the statement stream before the storage local (the
        # host's `prepare_expression_with_cleanups` with `allow_root_statement_foreign`).
        let hoist_base = output.len()
        let hoist_saved = begin_stmt_setup(ctx, HoistMode.hm_value)
        ctx.hoist_root_ep = value_ptr
        let value_ir = lower_expr(ctx, value_ptr)
        let hoist_collected = collect_stmt_setup(ctx, hoist_saved)
        emit_hoist_setup(output, hoist_base, hoist_collected)
        # The storage type is the host's inference of the initializer
        # (`infer_expression_type`): a foreign wrapper call's declared return
        # (`cstr?`) rather than the simple mapping's raw `ptr[char]` call type.
        storage_ty = qualify_type(ctx, ir_expr_type(value_ir))
        unsafe:
            match read(value_ptr):
                ast.Expr.expr_call as call:
                    match foreign_wrapper_call_return_type(ctx, call.callee):
                        Option.some as declared:
                            storage_ty = declared.value
                        Option.none:
                            pass
                _:
                    pass

        if ctx.async_cps_active:
            # The host's CF path spills the guard's storage to the frame field and
            # binds the success name to that same field (no plain local, no copy).
            let gfield = if name == "_": j2("local_discard_", pw1_str(line)) else: j2("local_", name)
            async_register_unused_field(ctx, gfield, storage_ty)
            let frame_ref = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false)))
            output.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_member(receiver = frame_ref, member = gfield, ty = storage_ty)), operator = "=", value = value_ir))
            # The guard condition reads the field as a member expression (the host's
            # `async_frame_field_expression`); later binding reads use the text name.
            storage_ref = alloc_expr(ir.Expr.expr_member(receiver = frame_ref, member = gfield, ty = storage_ty))
        else:
            # The host's no-await async body declares its plain locals without a
            # source line/path (`lower_async_non_await_statements`); its sync path
            # carries both.
            let guard_line = if ctx.async_nonawait_body: 0z else: line
            let guard_path = if ctx.async_nonawait_body: "" else: ctx.analysis.source_path
            output.push(ir.Stmt.stmt_local(name = storage_c, linkage_name = storage_c, ty = storage_ty, value = value_ir, line = guard_line, source_path = guard_path))
            storage_ref = alloc_expr(ir.Expr.expr_name(name = storage_c, ty = storage_ty, pointer = Option[bool].some(value = false)))
        let guard_cleanups = if format_owning_target_type(ctx, storage_ty, 0):
            drop_format_release_cleanups(hoist_collected)
        else:
            hoist_collected
        record_or_emit_local_cleanups(ctx, output, guard_cleanups.cleanups)

    let kind = guard_storage_kind(ctx, storage_ty)

    # else body: for a Result `else as error:` guard, register the failure error
    # binding so the else body can reference it.
    var else_stmts = vec.Vec[ir.Stmt].create()
    if kind == "result" and else_binding.is_some():
        register_result_failure_binding(ctx, storage_c, storage_ty, else_binding.unwrap())
    append_span_stmts(ref_of(else_stmts), lower_block(ctx, else_body))
    let else_ir = else_stmts.as_span()

    # `if (<failure condition>) { <else body> }`
    let cond = guard_failure_condition(ctx, kind, storage_ty, storage_ref)
    output.push(ir.Stmt.stmt_if(condition = cond, then_body = else_ir, else_body = Option[span[ir.Stmt]].none))

    # Bind `name` to the unwrapped success value (unless discarded with `_`).
    if name == "_":
        return
    let success_ty = guard_success_type(ctx, kind, storage_ty)
    if ctx.async_cps_active:
        # The frame field stores the *full* storage value (the host's spilled
        # guard storage, e.g. `Nullable(ptr[PendingReliable])`); reads of the
        # binding project the success value out of it, so a suspend/resume keeps
        # the absent case as well as the payload.  The field already holds the
        # initializer (spilled above), so no copy is emitted.
        let gfield = j2("local_", name)
        let gcname = j2("__mt_frame->", gfield)
        async_register_unused_field(ctx, gfield, storage_ty)
        ctx.locals.push(LocalBinding(name = name, c_name = gcname, ty = success_ty, pointer = Option[bool].some(value = false), projection = guard_binding_projection(kind, storage_ty)))
        return
    # No second local: reads project the success value out of the storage local.
    ctx.locals.push(LocalBinding(name = name, c_name = storage_c, ty = success_ty, pointer = Option[bool].some(value = false), projection = guard_binding_projection(kind, storage_ty)))


## The projection a guard storage kind implies for its binding.
function guard_binding_projection(kind: str, storage_ty: types.Type) -> BindingProjection:
    if kind == "option":
        return BindingProjection.option_some_value(storage_ty = storage_ty)
    if kind == "result":
        return BindingProjection.result_success_value(storage_ty = storage_ty)
    return BindingProjection.nullable_storage(storage_ty = storage_ty)


## Lower `let name = expr?` — the `?` postfix propagation operator lowers to
## a guard-like unwrap: on failure, return the failure value from the enclosing
## function; on success, bind `name` to the unwrapped success value.  This
## mirrors the Ruby compiler's `prepare_result_propagation_for_inline_lowering`.
## Like lower_propagate_let, but for `return expr?`: propagate the ? into
## an if/failure-return pattern, then return the unwrapped success value.
function lower_propagate_return(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], operand: ptr[ast.Expr], line: ptr_uint, source_path: str) -> void:
    # The host's normalization hoists an embedded await out of a `?` operand
    # into a `__mt_async_tmp_<N>` local before the propagation lowers it
    # (`normalize_async_expression`'s AwaitExpr case).
    var actual = operand
    if ctx.async_cps_active and async_mod.expr_has_await(operand):
        actual = async_hoist_awaits(ctx, output, operand)
    # The host prepares the `?` operand with the enclosing statement's window,
    # so an operand temp materializes before the propagation storage local.
    let had_window = ctx.hoist_mode != HoistMode.hm_off
    let window_saved = begin_stmt_setup(ctx, HoistMode.hm_value)
    let value_ir = lower_expr(ctx, actual)
    let window_collected = collect_stmt_setup(ctx, window_saved)
    if had_window:
        append_span_stmts(ref_of(ctx.hoist_stmts), window_collected.stmts.as_span())
        append_span_stmts(ref_of(ctx.hoist_cleanups), window_collected.cleanups.as_span())
    else:
        append_span_stmts(output, window_collected.stmts.as_span())
    let storage_ty = ir_expr_type(value_ir)

    let storage_c = fresh_c_temp_name(ctx, "propagate")
    output.push(ir.Stmt.stmt_local(name = storage_c, linkage_name = storage_c, ty = storage_ty, value = value_ir, line = 0, source_path = ""))
    if not had_window:
        append_span_stmts(output, window_collected.cleanups.as_span())
    let storage_ref = alloc_expr(ir.Expr.expr_name(name = storage_c, ty = storage_ty, pointer = Option[bool].some(value = false)))

    let kind = guard_storage_kind(ctx, storage_ty)
    if kind != "option" and kind != "result" and kind != "nullable":
        output.push(ir.Stmt.stmt_return(value = storage_ref, line = 0, source_path = source_path))
        return

    if kind == "option" or kind == "result":
        let outer_c = variant_base_c_name(storage_ty, ctx.module_name)
        let success_arm = if kind == "result": "success" else: "some"
        let arm_c = variant_arm_type_name(outer_c, success_arm)
        if not ctx.arm_payload_fields.contains(arm_c):
            var base_name = ""
            if is_prelude_variant_name(outer_c):
                if outer_c.starts_with("std_result_"):
                    base_name = "Result"
                else if outer_c.starts_with("std_option_"):
                    base_name = "Option"
            if base_name.len > 0:
                let vi_ptr = ctx.variants.get(base_name)
                if vi_ptr != null:
                    let vi = unsafe: read(vi_ptr)
                    register_arm_payload_fields(ctx, arm_c, vi, success_arm, storage_ty)

    var fail_value = storage_ref
    let ret_ty = ctx.current_fn_return_type
    if not types.type_equals(ret_ty, storage_ty):
        var is_task_ret = false
        match ret_ty:
            types.Type.ty_generic as tg:
                if tg.name == "Task":
                    is_task_ret = true
            types.Type.ty_named as tn:
                if tn.name.starts_with("mt_task_"):
                    is_task_ret = true
            _:
                pass
        if kind == "result":
            let (error_member, _) = guard_failure_projection(ctx, storage_ty, storage_ref)
            if is_task_ret:
                var result_fail_fields = vec.Vec[ir.AggregateField].create()
                result_fail_fields.push(ir.AggregateField(name = "error", value = error_member))
                let result_failure = extract_task_element_type(ctx, ret_ty)
                let failure_result = alloc_expr(ir.Expr.expr_variant_literal(ty = result_failure, arm_name = "failure", fields = result_fail_fields.as_span()))
                var task_fields = vec.Vec[ir.AggregateField].create()
                let void_zero = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ctx.ptr_void_ty))
                task_fields.push(ir.AggregateField(name = "value", value = failure_result))
                task_fields.push(ir.AggregateField(name = "frame", value = void_zero))
                task_fields.push(ir.AggregateField(name = "ready", value = void_zero))
                task_fields.push(ir.AggregateField(name = "set_waiter", value = void_zero))
                task_fields.push(ir.AggregateField(name = "release", value = void_zero))
                task_fields.push(ir.AggregateField(name = "take_result", value = void_zero))
                task_fields.push(ir.AggregateField(name = "cancel", value = void_zero))
                fail_value = alloc_expr(ir.Expr.expr_aggregate_literal(ty = ret_ty, fields = task_fields.as_span()))
            else:
                var fail_fields = vec.Vec[ir.AggregateField].create()
                fail_fields.push(ir.AggregateField(name = "error", value = error_member))
                fail_value = alloc_expr(ir.Expr.expr_variant_literal(ty = ret_ty, arm_name = "failure", fields = fail_fields.as_span()))
        else if kind == "option":
            fail_value = alloc_expr(ir.Expr.expr_variant_literal(ty = ret_ty, arm_name = "none", fields = span[ir.AggregateField]()))

    # Failure branch: return the appropriate failure value.
    var fail_body = vec.Vec[ir.Stmt].create()
    flush_all_defers(ctx, ref_of(fail_body))
    fail_body.push(ir.Stmt.stmt_return(value = fail_value, line = 0, source_path = source_path))

    let cond = guard_failure_condition(ctx, kind, storage_ty, storage_ref)
    output.push(ir.Stmt.stmt_if(condition = cond, then_body = fail_body.as_span(), else_body = Option[span[ir.Stmt]].none))

    # On success, return the unwrapped value.
    let success_ty = guard_success_type(ctx, kind, storage_ty)
    let success_val = guard_success_projection(ctx, kind, storage_ty, storage_ref, success_ty)
    output.push(ir.Stmt.stmt_return(value = success_val, line = line, source_path = source_path))



## The hidden storage a `?` propagation lowers into: the temp's name, the full
## Option/Result storage type and the guard kind.  The caller builds the success
## read — the host's prepared-temp projection, inlined where the value is used.
struct PropagatedTemp:
    name: str
    storage_ty: types.Type
    kind: str


## Lower a `?` operand into the host's hidden storage temp and its failure guard
## (`prepare_result_propagation_for_inline_lowering`).  The operand lowers first,
## so its own temps take the lower counter values; `__mt_propagate_<N>` is named
## after it, and the failure branch returns (or completes the frame early in
## CPS).  Returns the temp so the caller can read its success projection.
function lower_propagate_storage(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], operand: ptr[ast.Expr]) -> PropagatedTemp:
    # The host's normalization hoists an embedded await out of a `?` operand
    # into a `__mt_async_tmp_<N>` local before the propagation lowers it
    # (`normalize_async_expression`'s AwaitExpr case).
    var actual = operand
    if ctx.async_cps_active and async_mod.expr_has_await(operand):
        actual = async_hoist_awaits(ctx, output, operand)
    # The host prepares the `?` operand with the enclosing statement's window,
    # so a proc literal argument materializes as its own `__mt_proc_expr_<N>`
    # local before the propagation storage.  A caller that already opened a
    # window gets the operand's setup merged into it; otherwise raise a local
    # window so the operand's temps precede the storage local.
    let had_window = ctx.hoist_mode != HoistMode.hm_off
    let window_saved = begin_stmt_setup(ctx, HoistMode.hm_value)
    let value_ir = lower_expr(ctx, actual)
    let window_collected = collect_stmt_setup(ctx, window_saved)
    if had_window:
        append_span_stmts(ref_of(ctx.hoist_stmts), window_collected.stmts.as_span())
        append_span_stmts(ref_of(ctx.hoist_cleanups), window_collected.cleanups.as_span())
    else:
        append_span_stmts(output, window_collected.stmts.as_span())
    let storage_ty = ir_expr_type(value_ir)

    # Hidden storage local holding the full Option/Result value.
    let storage_c = fresh_c_temp_name(ctx, "propagate")
    output.push(ir.Stmt.stmt_local(name = storage_c, linkage_name = storage_c, ty = storage_ty, value = value_ir, line = 0, source_path = ""))
    if not had_window:
        append_span_stmts(output, window_collected.cleanups.as_span())
    let storage_ref = alloc_expr(ir.Expr.expr_name(name = storage_c, ty = storage_ty, pointer = Option[bool].some(value = false)))

    let kind = guard_storage_kind(ctx, storage_ty)
    # Pre-register arm payload fields for Option/Result so that
    # guard_success_type can find the specialized field type via
    # arm_payload_fields (P43 fallback). Without this, concrete variant
    # types like Result[UdpSocket, Error] fall back to returning the
    # storage type itself, causing `invalid initializer` C errors.
    if kind == "option" or kind == "result":
        let outer_c = variant_base_c_name(storage_ty, ctx.module_name)
        let success_arm = if kind == "result": "success" else: "some"
        let arm_c = variant_arm_type_name(outer_c, success_arm)
        if not ctx.arm_payload_fields.contains(arm_c):
            var base_name = ""
            if is_prelude_variant_name(outer_c):
                if outer_c.starts_with("std_result_"):
                    base_name = "Result"
                else if outer_c.starts_with("std_option_"):
                    base_name = "Option"
            if base_name.len > 0:
                let vi_ptr = ctx.variants.get(base_name)
                if vi_ptr != null:
                    let vi = unsafe: read(vi_ptr)
                    register_arm_payload_fields(ctx, arm_c, vi, success_arm, storage_ty)

    # Build the failure return value.  When the propagation type (e.g.
    # `Result[bool, Error]`) differs from the enclosing function's return type
    # (e.g. `Result[Bytes, Error]`), extract the error from the propagated
    # failure arm and wrap it in the return type's failure arm so the C types
    # are compatible.  Mirrors Ruby's `storage_type == return_type` check in
    # `prepare_result_propagation_for_inline_lowering`.
    var fail_value = storage_ref
    let ret_ty = ctx.current_fn_return_type
    if not types.type_equals(ret_ty, storage_ty):
        # When the enclosing function returns a Task wrapping the error Result
        # (e.g. `async function -> Task[Result[int, int]]`), the failure
        # return must construct a Task struct containing the failure Result
        # in its `.value` field, not a Result variant literal.
        var is_task_ret = false
        match ret_ty:
            types.Type.ty_generic as tg:
                if tg.name == "Task":
                    is_task_ret = true
            types.Type.ty_named as tn:
                if tn.name.starts_with("mt_task_"):
                    is_task_ret = true
            _:
                pass
        if kind == "result":
            # Extract the error from the storage's failure arm via
            # storage_ref.data.failure.error (three-level member access through
            # the variant's data union and failure arm struct).
            let (error_member, _) = guard_failure_projection(ctx, storage_ty, storage_ref)
            if is_task_ret:
                # Construct a Task struct: all vtable fields zeroed, value
                # field carries the failure Result variant literal.
                # Build the failure Result first, then put it in .value.
                var result_fail_fields = vec.Vec[ir.AggregateField].create()
                result_fail_fields.push(ir.AggregateField(name = "error", value = error_member))
                let result_failure = extract_task_element_type(ctx, ret_ty)
                let failure_result = alloc_expr(ir.Expr.expr_variant_literal(
                    ty = result_failure,
                    arm_name = "failure",
                    fields = result_fail_fields.as_span(),
                ))
                var task_fields = vec.Vec[ir.AggregateField].create()
                let void_zero = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ctx.ptr_void_ty))
                task_fields.push(ir.AggregateField(name = "value", value = failure_result))
                task_fields.push(ir.AggregateField(name = "frame", value = void_zero))
                task_fields.push(ir.AggregateField(name = "ready", value = void_zero))
                task_fields.push(ir.AggregateField(name = "set_waiter", value = void_zero))
                task_fields.push(ir.AggregateField(name = "release", value = void_zero))
                task_fields.push(ir.AggregateField(name = "take_result", value = void_zero))
                task_fields.push(ir.AggregateField(name = "cancel", value = void_zero))
                fail_value = alloc_expr(ir.Expr.expr_aggregate_literal(ty = ret_ty, fields = task_fields.as_span()))
            else:
                var fail_fields = vec.Vec[ir.AggregateField].create()
                fail_fields.push(ir.AggregateField(name = "error", value = error_member))
                fail_value = alloc_expr(ir.Expr.expr_variant_literal(
                    ty = ret_ty,
                    arm_name = "failure",
                    fields = fail_fields.as_span(),
                ))
        else if kind == "option":
            fail_value = alloc_expr(ir.Expr.expr_variant_literal(ty = ret_ty, arm_name = "none", fields = span[ir.AggregateField]()))

    # Failure branch: return the appropriate failure value.
    var fail_body = vec.Vec[ir.Stmt].create()
    flush_all_defers(ctx, ref_of(fail_body))
    if ctx.async_completion_active:
        # In an async resume (void-returning), a failure `?` stores the
        # propagated value into the frame result and completes the frame inline
        # (the host's `async_complete_statements`) rather than emitting a
        # value-returning `return`.
        if not ctx.async_result_is_void:
            fail_body.push(ir.Stmt.stmt_assignment(
                target = async_result_target(ctx, ctx.async_result_ty),
                operator = "=",
                value = fail_value,
            ))
        async_complete_statements(ctx, ref_of(fail_body), ctx.async_result_ty, Option[ptr[ir.Expr]].none)
    else:
        fail_body.push(ir.Stmt.stmt_return(value = fail_value, line = 0, source_path = ctx.analysis.source_path))

    # `if (<failure condition>) { return storage; }`
    let cond = guard_failure_condition(ctx, kind, storage_ty, storage_ref)
    output.push(ir.Stmt.stmt_if(condition = cond, then_body = fail_body.as_span(), else_body = Option[span[ir.Stmt]].none))
    return PropagatedTemp(name = storage_c, storage_ty = storage_ty, kind = kind)


function lower_propagate_let(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], name: str, operand: ptr[ast.Expr], line: ptr_uint, emit_success_read: bool, discard_c: str) -> void:
    let temp = lower_propagate_storage(ctx, output, operand)
    let storage_ty = temp.storage_ty
    let kind = temp.kind
    let storage_ref = alloc_expr(ir.Expr.expr_name(name = temp.name, ty = storage_ty, pointer = Option[bool].some(value = false)))

    # Bind `name` to the unwrapped success value (unless discarded with `_`).
    if name == "_":
        # A bare `expr?` statement still reads the success projection as its
        # expression statement (the host's prepared-temp read); a `let _ = expr?`
        # declares the discard binding itself (IR name `_`, fresh `__mt___N`
        # linkage), exactly like the host's ordinary local-decl path.
        if emit_success_read:
            let discard_ty = guard_success_type(ctx, kind, storage_ty)
            if not types.is_void(discard_ty):
                let discard_val = guard_success_projection(ctx, kind, storage_ty, storage_ref, discard_ty)
                output.push(ir.Stmt.stmt_expression(expression = discard_val, line = line, source_path = ctx.analysis.source_path))
        else:
            let discard_ty = guard_success_type(ctx, kind, storage_ty)
            if not types.is_void(discard_ty):
                let discard_val = guard_success_projection(ctx, kind, storage_ty, storage_ref, discard_ty)
                let dc = if discard_c.len > 0: discard_c else: fresh_c_temp_name(ctx, "_")
                output.push(ir.Stmt.stmt_local(name = "_", linkage_name = dc, ty = discard_ty, value = discard_val, line = line, source_path = ctx.analysis.source_path))
        return
    let success_ty = guard_success_type(ctx, kind, storage_ty)
    if ctx.async_cps_active:
        # The `?` binding's frame field holds the *success* value (the host's
        # spilled prepared temp), unlike a `let … else:` guard whose field keeps
        # the full storage.
        let success_val = guard_success_projection(ctx, kind, storage_ty, storage_ref, success_ty)
        let afield = j2("local_", name)
        let acname = j2("__mt_frame->", afield)
        async_register_local_field(ctx, name, afield, acname, success_ty)
        output.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_member(receiver = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false))), member = afield, ty = success_ty)), operator = "=", value = success_val))
        return
    # The host materializes the success value into a real local named after the
    # binding (`let raw_value = build_raw_value(value)?`), initialized from the
    # propagation temp's projection; reads then take the plain local.
    let c_name = utils.c_local_name(name)
    let success_val = guard_success_projection(ctx, kind, storage_ty, storage_ref, success_ty)
    output.push(ir.Stmt.stmt_local(name = c_name, linkage_name = c_name, ty = success_ty, value = success_val, line = line, source_path = ctx.analysis.source_path))
    ctx.locals.push(LocalBinding(name = name, c_name = c_name, ty = success_ty, pointer = Option[bool].some(value = false)))


## Lower `target = expr?` (assignment form of `?` propagation).  Mirrors
## `lower_propagate_let` but assigns the unwrapped success value into an existing
## lvalue target rather than introducing a `let` binding.  The failure branch is
## identical (return the wrapped failure, or complete the frame early in CPS).
function lower_propagate_assign(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], target_ast: ptr[ast.Expr], operand: ptr[ast.Expr]) -> void:
    # The host's normalization hoists an embedded await out of a `?` operand
    # into a `__mt_async_tmp_<N>` local before the propagation lowers it
    # (`normalize_async_expression`'s AwaitExpr case).
    var actual = operand
    if ctx.async_cps_active and async_mod.expr_has_await(operand):
        actual = async_hoist_awaits(ctx, output, operand)
    # The host prepares the `?` operand with the enclosing statement's window,
    # so an operand temp materializes before the propagation storage local.
    let had_window = ctx.hoist_mode != HoistMode.hm_off
    let window_saved = begin_stmt_setup(ctx, HoistMode.hm_value)
    let value_ir = lower_expr(ctx, actual)
    let window_collected = collect_stmt_setup(ctx, window_saved)
    if had_window:
        append_span_stmts(ref_of(ctx.hoist_stmts), window_collected.stmts.as_span())
        append_span_stmts(ref_of(ctx.hoist_cleanups), window_collected.cleanups.as_span())
    else:
        append_span_stmts(output, window_collected.stmts.as_span())
    let storage_ty = ir_expr_type(value_ir)

    let storage_c = fresh_c_temp_name(ctx, "propagate")
    output.push(ir.Stmt.stmt_local(name = storage_c, linkage_name = storage_c, ty = storage_ty, value = value_ir, line = 0, source_path = ""))
    if not had_window:
        append_span_stmts(output, window_collected.cleanups.as_span())
    let storage_ref = alloc_expr(ir.Expr.expr_name(name = storage_c, ty = storage_ty, pointer = Option[bool].some(value = false)))

    let kind = guard_storage_kind(ctx, storage_ty)
    if kind == "option" or kind == "result":
        let outer_c = variant_base_c_name(storage_ty, ctx.module_name)
        let success_arm = if kind == "result": "success" else: "some"
        let arm_c = variant_arm_type_name(outer_c, success_arm)
        if not ctx.arm_payload_fields.contains(arm_c):
            var base_name = ""
            if is_prelude_variant_name(outer_c):
                if outer_c.starts_with("std_result_"):
                    base_name = "Result"
                else if outer_c.starts_with("std_option_"):
                    base_name = "Option"
            if base_name.len > 0:
                let vi_ptr = ctx.variants.get(base_name)
                if vi_ptr != null:
                    let vi = unsafe: read(vi_ptr)
                    register_arm_payload_fields(ctx, arm_c, vi, success_arm, storage_ty)

    # Failure branch: build the wrapped failure value and return / complete early.
    var fail_value = storage_ref
    let ret_ty = ctx.current_fn_return_type
    if not types.type_equals(ret_ty, storage_ty):
        var is_task_ret = false
        match ret_ty:
            types.Type.ty_generic as tg:
                if tg.name == "Task":
                    is_task_ret = true
            types.Type.ty_named as tn:
                if tn.name.starts_with("mt_task_"):
                    is_task_ret = true
            _:
                pass
        if kind == "result":
            let (error_member, _) = guard_failure_projection(ctx, storage_ty, storage_ref)
            if is_task_ret:
                var result_fail_fields = vec.Vec[ir.AggregateField].create()
                result_fail_fields.push(ir.AggregateField(name = "error", value = error_member))
                let result_failure = extract_task_element_type(ctx, ret_ty)
                let failure_result = alloc_expr(ir.Expr.expr_variant_literal(ty = result_failure, arm_name = "failure", fields = result_fail_fields.as_span()))
                var task_fields = vec.Vec[ir.AggregateField].create()
                let void_zero = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ctx.ptr_void_ty))
                task_fields.push(ir.AggregateField(name = "value", value = failure_result))
                task_fields.push(ir.AggregateField(name = "frame", value = void_zero))
                task_fields.push(ir.AggregateField(name = "ready", value = void_zero))
                task_fields.push(ir.AggregateField(name = "set_waiter", value = void_zero))
                task_fields.push(ir.AggregateField(name = "release", value = void_zero))
                task_fields.push(ir.AggregateField(name = "take_result", value = void_zero))
                task_fields.push(ir.AggregateField(name = "cancel", value = void_zero))
                fail_value = alloc_expr(ir.Expr.expr_aggregate_literal(ty = ret_ty, fields = task_fields.as_span()))
            else:
                var fail_fields = vec.Vec[ir.AggregateField].create()
                fail_fields.push(ir.AggregateField(name = "error", value = error_member))
                fail_value = alloc_expr(ir.Expr.expr_variant_literal(ty = ret_ty, arm_name = "failure", fields = fail_fields.as_span()))
        else if kind == "option":
            fail_value = alloc_expr(ir.Expr.expr_variant_literal(ty = ret_ty, arm_name = "none", fields = span[ir.AggregateField]()))

    var fail_body = vec.Vec[ir.Stmt].create()
    flush_all_defers(ctx, ref_of(fail_body))
    if ctx.async_completion_active:
        if not ctx.async_result_is_void:
            fail_body.push(ir.Stmt.stmt_assignment(
                target = async_result_target(ctx, ctx.async_result_ty),
                operator = "=",
                value = fail_value,
            ))
        async_complete_statements(ctx, ref_of(fail_body), ctx.async_result_ty, Option[ptr[ir.Expr]].none)
    else:
        fail_body.push(ir.Stmt.stmt_return(value = fail_value, line = 0, source_path = ctx.analysis.source_path))

    let cond = guard_failure_condition(ctx, kind, storage_ty, storage_ref)
    output.push(ir.Stmt.stmt_if(condition = cond, then_body = fail_body.as_span(), else_body = Option[span[ir.Stmt]].none))

    # Assign the unwrapped success value into the target lvalue.
    let success_ty = guard_success_type(ctx, kind, storage_ty)
    let success_val = guard_success_projection(ctx, kind, storage_ty, storage_ref, success_ty)
    let target_ir = lower_expr(ctx, target_ast)
    output.push(ir.Stmt.stmt_assignment(target = target_ir, operator = "=", value = success_val))


## Classify a guard's storage type: "option", "result", or "nullable".
function guard_storage_kind(ctx: ref[LowerCtx], storage_ty: types.Type) -> str:
    if types.is_nullable_type(storage_ty):
        return "nullable"
    let gv = generic_variant_name(storage_ty)
    if gv.is_some():
        let base = guard_variant_base(gv.unwrap())
        if base == "Result":
            return "result"
        return "option"
    # A collapsed concrete name (Option_str / Result_..._).
    let tn = named_type_name(storage_ty)
    if tn.is_some():
        if tn.unwrap().starts_with("Result_"):
            return "result"
        if tn.unwrap().starts_with("Option_"):
            return "option"
    return "nullable"


## Wrap a non-nullable value in a nullable aggregate literal, producing
## `{ has_value: true, value: <value_expr> }` for the mt_opt_* struct.
function nullable_some_literal(nullable_ty: types.Type, value_expr: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let bool_ty = types.primitive("bool")
    let true_lit = alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = bool_ty))
    return alloc_expr(ir.Expr.expr_aggregate_literal(
        ty = nullable_ty,
        fields = sp_fields2(
            ir.AggregateField(name = "has_value", value = true_lit),
            ir.AggregateField(name = "value", value = value_expr),
        ),
    ))


## True when a nullable type has a pointer-like base (ptr, const_ptr, ref, cstr,
## function, proc, opaque).  These use NULL as the absent sentinel.  Value-type
## nullables (int?, bool?, struct?) use mt_opt_* structs with has_value tags.
function is_nullable_pointer_like(t: types.Type) -> bool:
    match t:
        types.Type.ty_nullable as nl:
            unsafe:
                let base = read(nl.base)
                match base:
                    types.Type.ty_generic as g:
                        return g.name == "ptr" or g.name == "const_ptr" or g.name == "own" or g.name == "ref"
                    types.Type.ty_primitive as p:
                        return p.name == "cstr"
                    types.Type.ty_function:
                        return true
                    types.Type.ty_opaque:
                        return true
                    _:
                        return false
        _:
            return false


## The base variant name from a possibly-qualified name (`Result_int_Error` →
## "Result"; `Result` → "Result").
function guard_variant_base(name: str) -> str:
    match prelude_variant_base(name):
        Option.some as base:
            return base.value
        Option.none:
            return name


## The failure/absent condition for a guard: `storage == null` for nullable,
## `storage.kind == <none/failure>` for Option/Result.
function guard_failure_condition(ctx: ref[LowerCtx], kind: str, storage_ty: types.Type, storage_ref: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let bool_ty = ctx.bool_ty
    if kind == "nullable":
        # mt_subscription is a plain struct without nullable/null wrapper;
        # failure is indicated by slot == 0.
        let tn = named_type_name(storage_ty)
        if tn.is_some() and (tn.unwrap() == "Subscription" or tn.unwrap() == "mt_subscription"):
            let slot_expr = alloc_expr(ir.Expr.expr_member(receiver = storage_ref, member = "slot", ty = types.primitive("ptr_uint")))
            let zero = alloc_expr(ir.Expr.expr_integer_literal(value = 0z, ty = types.primitive("ptr_uint")))
            return alloc_expr(ir.Expr.expr_binary(operator = "==", left = slot_expr, right = zero, ty = bool_ty))
        let null_lit = alloc_expr(ir.Expr.expr_null_literal(ty = storage_ty))
        return alloc_expr(ir.Expr.expr_binary(operator = "==", left = storage_ref, right = null_lit, ty = bool_ty))
    let outer_c = variant_base_c_name(storage_ty, ctx.module_name)
    let absent_arm = if kind == "result": "failure" else: "none"
    let int_ty = types.primitive("int")
    let kind_expr = alloc_expr(ir.Expr.expr_member(receiver = storage_ref, member = "kind", ty = int_ty))
    let absent_const = alloc_expr(ir.Expr.expr_name(name = variant_kind_const_name(outer_c, absent_arm), ty = int_ty, pointer = Option[bool].some(value = false)))
    return alloc_expr(ir.Expr.expr_binary(operator = "==", left = kind_expr, right = absent_const, ty = bool_ty))


## The unwrapped success type `T` of a guard's storage type.
function guard_success_type(ctx: ref[LowerCtx], kind: str, storage_ty: types.Type) -> types.Type:
    if kind == "nullable":
        let inner = types.unwrap_nullable(storage_ty)
        if is_nullable_pointer_like(storage_ty):
            match inner:
                types.Type.ty_opaque as op:
                    # A re-exported opaque's value representation already is a
                    # pointer (`<module>_<Name>*`), so the guard's success type
                    # is the opaque itself; a raw module's opaque needs the
                    # explicit `ptr[T]` wrapper to reach the pointer form.
                    if op.module_name.starts_with("std.c."):
                        return types.Type.ty_generic(name = "ptr", args = sp_type(inner))
                    return inner
                _:
                    return inner
        return inner
    # Option[T] / Result[T, E] in generic form: first type arg is T.
    let args = variant_type_args(storage_ty)
    if args.len > 0:
        return qualify_type(ctx, unsafe: read(args.data + 0))
    # Collapsed concrete form (Option_str / Result_..._): recover the success
    # payload field type via the program-wide prelude arm registry (the
    # concrete decl may have been emitted in another module's context, e.g.
    # `Result[Value, Error]` from an imported `json.parse`), then the local
    # pending decls, then the scrutinee's own type args.
    let outer_c = variant_base_c_name(storage_ty, ctx.module_name)
    let success_arm = if kind == "result": "success" else: "some"
    let payload_c = variant_arm_type_name(outer_c, success_arm)
    match concrete_prelude_field_type(ctx, payload_c, success_arm, storage_ty):
        Option.some as ft:
            return ft.value
        Option.none:
            pass
    # Concrete variant (e.g. Result[UdpSocket, Error]): look up the success
    # payload field type from the arm_payload_fields registry populated during
    # variant lowering.
    let arm_ptr = ctx.arm_payload_fields.get(payload_c)
    if arm_ptr != null:
        let arm_info = unsafe: read(arm_ptr)
        if arm_info.field_types.len > 0:
            return unsafe: read(arm_info.field_types.data + 0)
    return storage_ty


## The success-value projection for a guard: the storage itself for nullable,
## `storage.data.<some/success>.value` for Option/Result.
function guard_success_projection(ctx: ref[LowerCtx], kind: str, storage_ty: types.Type, storage_ref: ptr[ir.Expr], success_ty: types.Type) -> ptr[ir.Expr]:
    if kind == "nullable":
        if types.is_nullable_type(storage_ty) and not is_nullable_pointer_like(storage_ty):
            return alloc_expr(ir.Expr.expr_member(receiver = storage_ref, member = "value", ty = success_ty))
        return storage_ref
    let outer_c = variant_base_c_name(storage_ty, ctx.module_name)
    let success_arm = if kind == "result": "success" else: "some"
    let (decl_name, decl_module) = variant_declared_identity(storage_ty, ctx.module_name)
    let payload_ty = variant_arm_payload_binding(decl_name, decl_module, outer_c, success_arm)
    let data_member = alloc_expr(ir.Expr.expr_member(receiver = storage_ref, member = "data", ty = types.Type.ty_nil))
    let arm_data = alloc_expr(ir.Expr.expr_member(receiver = data_member, member = success_arm, ty = payload_ty))
    return alloc_expr(ir.Expr.expr_member(receiver = arm_data, member = "value", ty = success_ty))


## The failure projection of a Result storage: `storage.data.failure.error`,
## typed with the storage's error type argument.  Used both for the `else as
## error:` binding and for a propagation binding's error read.
function guard_failure_projection(ctx: ref[LowerCtx], storage_ty: types.Type, storage_ref: ptr[ir.Expr]) -> (ptr[ir.Expr], types.Type):
    let outer_c = variant_base_c_name(storage_ty, ctx.module_name)
    let (decl_name, decl_module) = variant_declared_identity(storage_ty, ctx.module_name)
    let payload_ty = variant_arm_payload_binding(decl_name, decl_module, outer_c, "failure")
    var error_ty = ctx.void_ty
    let args = variant_type_args(storage_ty)
    if args.len >= 2:
        error_ty = qualify_type(ctx, unsafe: read(args.data + 1))
    else:
        # Collapsed concrete form: recover the error field type via the
        # program-wide prelude arm registry (the concrete decl may come from
        # another module's context), then the local pending decls.
        match concrete_prelude_field_type(ctx, variant_arm_type_name(outer_c, "failure"), "failure", storage_ty):
            Option.some as ft:
                error_ty = ft.value
            Option.none:
                pass
    let data_member = alloc_expr(ir.Expr.expr_member(receiver = storage_ref, member = "data", ty = types.Type.ty_nil))
    let arm_data = alloc_expr(ir.Expr.expr_member(receiver = data_member, member = "failure", ty = payload_ty))
    let error_val = alloc_expr(ir.Expr.expr_member(receiver = arm_data, member = "error", ty = error_ty))
    return (error_val, error_ty)


## Register the `else as error:` binding for a Result guard so the else body
## resolves the name to the storage's failure projection (the host registers the
## same projection on the else env; no local is emitted).
function register_result_failure_binding(ctx: ref[LowerCtx], storage_c: str, storage_ty: types.Type, error_name: str) -> void:
    let storage_ref = alloc_expr(ir.Expr.expr_name(name = storage_c, ty = storage_ty, pointer = Option[bool].some(value = false)))
    let (_, error_ty) = guard_failure_projection(ctx, storage_ty, storage_ref)
    ctx.locals.push(LocalBinding(name = error_name, c_name = storage_c, ty = error_ty, pointer = Option[bool].some(value = false), projection = BindingProjection.result_failure_error(storage_ty = storage_ty)))


## Read a bound name.  A guard/propagation binding is projected out of its
## storage local (`x.data.some.value` for an Option, the storage itself for a
## pointer-like nullable), mirroring the host's `lower_bound_identifier`.
function lower_binding_read(ctx: ref[LowerCtx], lb: LocalBinding) -> ptr[ir.Expr]:
    match lb.projection:
        BindingProjection.plain:
            # The host's `lower_bound_identifier` reads `binding[:type]`, the
            # flow-refined visible type; its storage type stays the binding's.
            # A nullable refined to its (non-pointer-like) base projects
            # `.value`; a pointer-like base keeps the storage name.
            match flow_scope_binding(ctx, lb.name):
                Option.some as refined:
                    let visible = refined.value
                    let storage_ty = lb.ty
                    if types.type_equals(visible, storage_ty):
                        return alloc_expr(ir.Expr.expr_name(name = lb.c_name, ty = storage_ty, pointer = lb.pointer))
                    if types.is_nullable_type(storage_ty) and types.type_equals(types.unwrap_nullable(storage_ty), visible):
                        let storage_ref = alloc_expr(ir.Expr.expr_name(name = lb.c_name, ty = storage_ty, pointer = lb.pointer))
                        if is_nullable_pointer_like(storage_ty):
                            return storage_ref
                        return alloc_expr(ir.Expr.expr_member(receiver = storage_ref, member = "value", ty = visible))
                    return alloc_expr(ir.Expr.expr_name(name = lb.c_name, ty = visible, pointer = lb.pointer))
                Option.none:
                    return alloc_expr(ir.Expr.expr_name(name = lb.c_name, ty = lb.ty, pointer = lb.pointer))
        BindingProjection.nullable_storage as p:
            let storage_ref = alloc_expr(ir.Expr.expr_name(name = lb.c_name, ty = p.storage_ty, pointer = lb.pointer))
            return guard_success_projection(ctx, "nullable", p.storage_ty, storage_ref, lb.ty)
        BindingProjection.option_some_value as p:
            let storage_ref = alloc_expr(ir.Expr.expr_name(name = lb.c_name, ty = p.storage_ty, pointer = lb.pointer))
            return guard_success_projection(ctx, "option", p.storage_ty, storage_ref, lb.ty)
        BindingProjection.result_success_value as p:
            let storage_ref = alloc_expr(ir.Expr.expr_name(name = lb.c_name, ty = p.storage_ty, pointer = lb.pointer))
            return guard_success_projection(ctx, "result", p.storage_ty, storage_ref, lb.ty)
        BindingProjection.result_failure_error as p:
            let storage_ref = alloc_expr(ir.Expr.expr_name(name = lb.c_name, ty = p.storage_ty, pointer = lb.pointer))
            let (error_val, _) = guard_failure_projection(ctx, p.storage_ty, storage_ref)
            return error_val


## Lower an assignment's target with the host's `lower_assignment_binding_target`
## rule (`utils.rb:1237`): the target's `IR::Name` carries the *visible*
## (flow-refined) type when that is the storage type itself or the storage
## nullable's base, and the storage type otherwise.
function lower_assignment_target(ctx: ref[LowerCtx], target_ast: ptr[ast.Expr]) -> ptr[ir.Expr]:
    unsafe:
        match read(target_ast):
            ast.Expr.expr_identifier as id:
                match lookup_local(ctx, id.name):
                    Option.some as lb:
                        match lb.value.projection:
                            BindingProjection.plain:
                                let storage_ty = lb.value.ty
                                match flow_scope_binding(ctx, id.name):
                                    Option.some as refined:
                                        if assignment_target_visible(storage_ty, refined.value):
                                            return alloc_expr(ir.Expr.expr_name(name = lb.value.c_name, ty = refined.value, pointer = lb.value.pointer))
                                    Option.none:
                                        pass
                                return alloc_expr(ir.Expr.expr_name(name = lb.value.c_name, ty = storage_ty, pointer = lb.value.pointer))
                            _:
                                pass
                    Option.none:
                        # A module-level value is a binding in the host's env
                        # too, so a guard-narrowed one takes the visible type
                        # on an assignment target the same way
                        # (`lint_reserved_out` inside `if != null`).
                        match lookup_qualified_constant(ctx, id.name):
                            Option.some as qc:
                                let declared = ctx.analysis.value_types.get(id.name)
                                if declared != null:
                                    let storage_ty = read(declared)
                                    match flow_scope_binding(ctx, id.name):
                                        Option.some as refined:
                                            if assignment_target_visible(storage_ty, refined.value):
                                                return alloc_expr(ir.Expr.expr_name(name = qc.value, ty = refined.value, pointer = Option[bool].some(value = false)))
                                        Option.none:
                                            pass
                                    return alloc_expr(ir.Expr.expr_name(name = qc.value, ty = storage_ty, pointer = Option[bool].some(value = false)))
                            Option.none:
                                pass
            _:
                pass
    return lower_expr(ctx, target_ast)


## The host's target-type test: the visible type is the storage type itself or
## the nullable storage's base.
function assignment_target_visible(storage_ty: types.Type, visible: types.Type) -> bool:
    if types.type_equals(visible, storage_ty):
        return true
    if types.is_nullable_type(storage_ty):
        return types.type_equals(types.unwrap_nullable(storage_ty), visible)
    return false


## Lower `let (a, b) = expr` (tuple) / `let Name(x, y) = expr` (struct) by
## evaluating the source into a temp and binding each component from it.
function lower_destructure(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], bindings: span[str], type_name: Option[str], value: ptr[ast.Expr]?) -> void:
    let val = value else:
        fatal(c"lowering: destructuring requires an initializer")
    let lowered_val = lower_expr(ctx, val)
    let val_ty = ir_expr_type(lowered_val)
    let temp = fresh_c_temp_name(ctx, "destructure_val")
    output.push(ir.Stmt.stmt_local(name = temp, linkage_name = temp, ty = val_ty, value = lowered_val, line = 0, source_path = ""))

    var i: ptr_uint = 0
    while i < bindings.len:
        var binding: str
        unsafe:
            binding = read(bindings.data + i)
        # `_` discards bind nothing — skip them (emitting a local for each would
        # collide, and there is no name to reference).  Mirrors Ruby's
        # `next if name == "_"`.
        if binding == "_":
            i += 1
            continue
        var member_name: str
        var member_ty: types.Type
        match type_name:
            Option.some:
                let fields_opt = struct_fields_of(ctx, val_ty)
                match fields_opt:
                    Option.some as fields:
                        member_name = struct_field_name_at(fields.value, i)
                        member_ty = qualify_type(ctx, struct_field_type_at(fields.value, i))
                    Option.none:
                        member_name = ""
                        member_ty = types.Type.ty_error
            Option.none:
                member_name = tuple_field_name(i)
                member_ty = tuple_element_type(val_ty, i)
                match val_ty:
                    types.Type.ty_tuple as tup:
                        match tup.field_names:
                            Option.some as fnames:
                                if i < fnames.value.len:
                                    member_name = unsafe: read(fnames.value.data + i)
                            Option.none:
                                pass
                    _:
                        pass
        let receiver = alloc_expr(ir.Expr.expr_name(name = temp, ty = val_ty, pointer = Option[bool].some(value = false)))
        let member = alloc_expr(ir.Expr.expr_member(receiver = receiver, member = member_name, ty = member_ty))
        let binding_c = utils.c_local_name(binding)
        output.push(ir.Stmt.stmt_local(name = binding, linkage_name = binding_c, ty = member_ty, value = member, line = 0, source_path = ""))
        ctx.locals.push(LocalBinding(name = binding, c_name = binding_c, ty = member_ty, pointer = Option[bool].some(value = false)))
        i += 1


## True when `ty` is a struct declared by a raw (external C binding) module — the
## only structs the C backend cannot build an equality helper for, because raw
## modules never lower their declarations into `Program.structs`.  The analyzer
## still knows their fields, so the helper can be synthesized from those.
function is_equality_struct_type(ctx: ref[LowerCtx], ty: types.Type) -> bool:
    match ty:
        types.Type.ty_imported as im:
            if not im.module_name.starts_with("std.c."):
                return false
        _:
            return false
    if types.is_void(ty) or types.is_error(ty):
        return false
    match struct_fields_of(ctx, ty):
        Option.some as fields:
            return fields.value.len > 0
        Option.none:
            return false


## Register an external (raw-module ABI) struct type's field layout for the C
## backend's `mt_struct_eq_<T>` helper synthesis.  Raw modules emit no IR
## declarations, so `Program.external_structs` carries the fields the host reads
## from its type objects.  Returns false — leaving the comparison untouched —
## when the type's fields are unknown.  Nested external structs a field needs
## are registered too (C structs nest by value, so the recursion terminates).
function register_external_struct_layout(ctx: ref[LowerCtx], ty: types.Type) -> bool:
    let key = naming.type_c_key(ty)
    if ctx.external_struct_keys.contains(key):
        return true
    let fields = struct_fields_of(ctx, ty) else:
        return false
    var fi: ptr_uint = 0
    while fi < fields.len:
        let field_ty = unsafe: read(fields.data + fi).ty
        if is_equality_struct_type(ctx, field_ty):
            if not register_external_struct_layout(ctx, field_ty):
                return false
        fi += 1
    var ir_fields = vec.Vec[ir.Field].create()
    var gj: ptr_uint = 0
    while gj < fields.len:
        let fe = unsafe: read(fields.data + gj)
        ir_fields.push(ir.Field(name = fe.name, ty = fe.ty))
        gj += 1
    ctx.external_struct_keys.set(key, true)
    ctx.pending_external_structs.push(ir.ExternalStructLayout(key = key, fields = ir_fields.as_span()))
    return true


## The struct fields of the type a destructuring initializer evaluates to.  The
## fields live in the DECLARING module's struct table, and the source-level type
## name may be import-qualified (`types.Transform` for `engine.types`), which a
## lookup by that written name in the current module would miss — the value's own
## type carries the authoritative module and name.
function struct_fields_of(ctx: ref[LowerCtx], t: types.Type) -> Option[span[analyzer.FieldEntry]]:
    var module_name: str
    var struct_name: str
    match t:
        types.Type.ty_imported as im:
            module_name = im.module_name
            struct_name = im.name
        types.Type.ty_named as n:
            module_name = if n.module_name.len > 0: n.module_name else: ctx.module_name
            struct_name = n.name
        _:
            return Option[span[analyzer.FieldEntry]].none
    match find_imported_analysis(ctx, module_name):
        Option.some as a:
            let fields_ptr = a.value.structs.get(struct_name) else:
                return Option[span[analyzer.FieldEntry]].none
            return Option[span[analyzer.FieldEntry]].some(value = unsafe: read(fields_ptr))
        Option.none:
            return Option[span[analyzer.FieldEntry]].none


## The name of a struct's field at `index` (empty when out of range).
function struct_field_name_at(fields: span[analyzer.FieldEntry], index: ptr_uint) -> str:
    if index < fields.len:
        unsafe:
            return read(fields.data + index).name
    return ""


## The declared type of a struct's field at `index` (`ty_error` when out of range).
function struct_field_type_at(fields: span[analyzer.FieldEntry], index: ptr_uint) -> types.Type:
    if index < fields.len:
        unsafe:
            return read(fields.data + index).ty
    return types.Type.ty_error


## Qualify a bare local named type (`ty_named`) with the current module so the
## backend can produce its module-prefixed C name (`State` -> `en_State`).
## Primitives, `str`, and already-qualified imported types pass through.
## For imported generic types with concrete args, monomorphize the struct
## declaration via `ensure_generic_struct_decl` and return a named type with
## the module-qualified concrete C name.  Recurses into generic, nullable,
## and pointer types so nested imported generics are also resolved.
## Raw type parameters (`T`, `K`, `V`, etc.) inside generic bodies are
## replaced with `void` to avoid undeclared C type names.
## True when a resolved type is a declared opaque type (`opaque X = c"..."`),
## looked up by its C key in the program-wide opaque set.
function is_opaque_base(ctx: ref[LowerCtx], t: types.Type) -> bool:
    match t:
        types.Type.ty_imported:
            if ctx.opaque_keys.get(naming.type_c_key(t)) != null:
                return true
            return module_has_opaque(ctx, t)
        types.Type.ty_named:
            if ctx.opaque_keys.get(naming.type_c_key(t)) != null:
                return true
            return module_has_opaque(ctx, t)
        _:
            return false


struct OpaqueName:
    module_name: str
    name: str


function opaque_module_name_and_name(t: types.Type) -> OpaqueName:
    match t:
        types.Type.ty_imported as im:
            return OpaqueName(module_name = im.module_name, name = im.name)
        types.Type.ty_named as n:
            return OpaqueName(module_name = n.module_name, name = n.name)
        _:
            return OpaqueName(module_name = "", name = "")


function module_has_opaque(ctx: ref[LowerCtx], t: types.Type) -> bool:
    match t:
        types.Type.ty_imported as im:
            return find_imported_opaque_decl(ctx, im.module_name, im.name)
        types.Type.ty_named as n:
            if n.module_name.len > 0:
                return find_imported_opaque_decl(ctx, n.module_name, n.name)
            return find_imported_opaque_decl(ctx, ctx.module_name, n.name)
        _:
            return false


function find_imported_opaque_decl(ctx: ref[LowerCtx], module_name: str, name: str) -> bool:
    let analysis = find_imported_analysis(ctx, module_name) else:
        return false
    var di: ptr_uint = 0
    while di < analysis.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(analysis.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_opaque as op:
                if op.name == name:
                    return true
            _:
                pass
        di += 1
    return false


function qualify_type(ctx: ref[LowerCtx], t: types.Type) -> types.Type:
    match t:
        types.Type.ty_named as n:
            if is_raw_type_param_name(n.name):
                return ctx.void_ty
            # A nested struct's named type carries the parent-qualified C
            # linkage (`<module>_Rectangle_Edge`); converting it to
            # `ty_imported` would drop it and re-derive `<module>_Edge`.
            if n.linkage_name.is_some():
                return t
            # Built-in registered types (`EventError`, `Subscription`) carry no
            # owning module and must not be module-qualified.
            if n.module_name.len == 0:
                let registered_ptr = ctx.analysis.types.get(n.name)
                if registered_ptr != null:
                    unsafe:
                        match read(registered_ptr):
                            types.Type.ty_named as rn:
                                if rn.module_name.len == 0:
                                    return t
                            _:
                                pass
            # Already-monomorphized concrete names (e.g. std_map_Node_str_bool)
            # are fully qualified: pass them through so re-qualifying in a
            # different module context does not double-prefix them.
            if generic_instance_contains(ctx, n.name) or ctx.generic_struct_decls.contains(n.name):
                return t
            # Concrete C names produced by generic_struct_c_name always contain
            # at least one underscore (module_prefix_Name_Arg).  Bare names
            # without underscores (like the type param `T`) should follow the
            # normal qualify path.
            if n.name.find_byte('_').is_some():
                return t
            # Prelude variant instances (Option_str, Result_int_Error) and proc
            # typedefs (mt_proc_...) have global C names and must not be
            # module-prefixed.
            if is_prelude_variant_name(n.name) or n.name.starts_with("mt_proc_"):
                return t
            # A bare type name may be a type imported from another module (e.g.
            # `Diag` used in `analyzer` but defined in `definite_assignment`).
            # Qualify it against its OWNER module, not the current one, so it does
            # not become a mis-attributed `<current_module>_Diag`.
            match imported_type_module(ctx, n.name):
                Option.some as owner:
                    return types.Type.ty_imported(module_name = owner.value, name = n.name, args = span[types.Type]())
                Option.none:
                    pass
            # The name may be declared in a module the current one does not
            # import (e.g. a reflected struct type from the caller's module,
            # reached through `fields_of(T)`): find its defining module
            # program-wide so it is not mis-attributed to the current module.
            match find_declaring_module(ctx, n.name):
                Option.some as owner:
                    return types.Type.ty_imported(module_name = owner.value, name = n.name, args = span[types.Type]())
                Option.none:
                    pass
            # Resolve type aliases to their target type so the C backend sees
            # the concrete type (e.g. IntCallback → fn(...)) rather than an
            # opaque ty_imported.  Aliases targeting std.c.* types are NOT
            # resolved — the C typedef (e.g. `typedef struct sockaddr_storage
            # std_net_NativeSocketStorage`) handles the mapping, and keeping
            # the alias name avoids raw C type names (e.g. `sockaddr_storage`
            # without `struct` prefix) in function signatures / struct fields.
            if ctx.analysis.type_alias_types.contains(n.name):
                let resolved_ptr = ctx.analysis.type_alias_types.get(n.name) else:
                    fatal(c"lowering: type alias lookup inconsistency")
                let resolved_val = unsafe: read(resolved_ptr)
                if not type_is_from_std_c(resolved_val):
                    return qualify_type(ctx, resolved_val)
            # A named type that already carries its owning module is qualified
            # against it, not the current module: lowering std.result's
            # `map_error[F]` with `ty_named("Error", "map_err_probe")` must not
            # produce `std.result.Error`.
            let owner = if n.module_name.len > 0: n.module_name else: ctx.module_name
            return types.Type.ty_imported(module_name = owner, name = n.name, args = span[types.Type]())
        types.Type.ty_imported as im:
            if is_raw_type_param_name(im.name):
                return ctx.void_ty
            # Resolve type aliases defined in the owning module (e.g.
            # `NativeBuffer` in `std.net` → `uv_buf_t` in `std.c.libuv`).
            if im.args.len == 0 and not is_prelude_variant_name(im.name):
                let owner_a_opt = find_imported_analysis(ctx, im.module_name)
                if owner_a_opt.is_some():
                    let owner_a = owner_a_opt.unwrap()
                    if owner_a.type_alias_types.contains(im.name):
                        let resolved_ptr = owner_a.type_alias_types.get(im.name) else:
                            fatal(c"lowering: imported type alias lookup inconsistency")
                        return qualify_type(ctx, unsafe: read(resolved_ptr))
            var resolved_args = span[types.Type]()
            if im.args.len > 0:
                var args_vec = vec.Vec[types.Type].create()
                var ai: ptr_uint = 0
                while ai < im.args.len:
                    unsafe:
                        args_vec.push(qualify_type(ctx, read(im.args.data + ai)))
                    ai += 1
                resolved_args = args_vec.as_span()
            # Prelude variants (Option/Result) have global, un-prefixed C names
            # (Option_str, not <module>_Option_str) and are emitted as generic
            # variants, so keep them in generic form rather than monomorphizing a
            # module-qualified struct.
            if is_prelude_variant_name(im.name):
                return types.Type.ty_generic(name = im.name, args = resolved_args)
            if resolved_args.len > 0:
                var has_unresolved = false
                var ui: ptr_uint = 0
                while ui < resolved_args.len:
                    unsafe:
                        if type_contains_type_var(read(resolved_args.data + ui)):
                            has_unresolved = true
                    ui += 1
                if has_unresolved:
                    return t
                let concrete_name = naming.qualified_c_name(im.module_name, generic_struct_c_name(im.name, resolved_args))
                # A generic VARIANT instance has no struct fields to extract, so
                # register its concrete declaration and stop: it is emitted as a
                # variant, not a struct.
                match find_imported_analysis(ctx, im.module_name):
                    Option.some as owner:
                        if ensure_generic_variant_decl(ctx, owner.value, im.name, resolved_args, concrete_name):
                            return types.Type.ty_imported(module_name = im.module_name, name = im.name, args = resolved_args)
                    Option.none:
                        pass
                ensure_generic_struct_decl_named(ctx, im.name, span[ast.TypeArgument](), resolved_args, concrete_name)
                generic_instance_set(ctx, concrete_name, GenericReceiver(owner_name = im.name, concrete_args = resolved_args, owner_module = im.module_name))
                return types.Type.ty_imported(module_name = im.module_name, name = im.name, args = resolved_args)
            return t
        types.Type.ty_generic as g:
            var args = vec.Vec[types.Type].create()
            var gi: ptr_uint = 0
            while gi < g.args.len:
                unsafe:
                    args.push(qualify_type(ctx, read(g.args.data + gi)))
                gi += 1
            # Monomorphize user-defined generic structs used as field types
            # (e.g. Node[str, bool] from std/map), skipping builtins handled
            # directly by the C backend.
            let resolved = try_monomorphize_generic(ctx, g.name, args.as_span())
            if not types.is_error(resolved):
                return resolved
            return types.Type.ty_generic(name = g.name, args = args.as_span())
        types.Type.ty_nullable as nl:
            let qbase = qualify_type(ctx, unsafe: read(nl.base))
            # An opaque type is an incomplete C type used only through pointers,
            # so `Opaque?` is a nullable C pointer.  Wrap the base in `ptr[...]`
            # so it flows through the existing pointer-nullable machinery
            # (rendered as `<backing>*`) instead of an invalid value-optional
            # struct over an incomplete type.
            if is_opaque_base(ctx, qbase):
                let op_parts = opaque_module_name_and_name(qbase)
                if op_parts.module_name.len > 0:
                    let op_ty = types.Type.ty_opaque(module_name = op_parts.module_name, name = op_parts.name)
                    return types.Type.ty_nullable(base = types.alloc_type(op_ty))
                let ptr_base = types.Type.ty_generic(name = "ptr", args = sp_type(qbase))
                return types.Type.ty_nullable(base = types.alloc_type(ptr_base))
            return types.Type.ty_nullable(base = types.alloc_type(qbase))
        types.Type.ty_function as fnt:
            if fnt.is_proc:
                # A proc value's IR type is the closure's own function type (the
                # host's `Types::Proc`); the `mt_proc_*` C struct is synthesized
                # from it by the backend.  Register the struct declaration and
                # carry the type itself.
                let _registered = proc_ensure_struct_decl(ctx, naming.proc_type_c_name(t), t)
            return t
        _:
            return t


## When `name` is a generic struct (local or imported) with concrete args,
## monomorphize it and return the concrete `ty_named`.  Returns `ty_error` for
## builtins (ptr/span/ref/...) and unknown names — the caller should fall back
## to `ty_generic`.
function try_monomorphize_generic(ctx: ref[LowerCtx], name: str, args: span[types.Type]) -> types.Type:
    if is_builtin_pointer_generic(name):
        return types.Type.ty_error
    # Inside a generic body the arguments may still be type variables; such a
    # reference stays generic until substitution binds them.
    var gi: ptr_uint = 0
    while gi < args.len:
        unsafe:
            if type_contains_type_var(read(args.data + gi)):
                return types.Type.ty_error
        gi += 1
    if name == "Option" or name == "Result":
        # A bare `Option`/`Result` reference (no arguments) is the generic form,
        # not an instance; monomorphizing it would register an empty-arm variant.
        if (name == "Option" and args.len < 1) or (name == "Result" and args.len < 2):
            return types.Type.ty_error
        return ensure_generic_variant(ctx, name, args)
    # A user-defined generic variant (`Outcome[int, EngineError]`) is emitted as a
    # concrete variant declaration, not a struct.
    if ensure_generic_variant_decl(ctx, ctx.analysis, name, args, naming.qualified_c_name(ctx.module_name, generic_struct_c_name(name, args))):
        return types.Type.ty_imported(module_name = ctx.module_name, name = name, args = args)
    var vimport_values = ctx.analysis.imports.values()
    while true:
        let vtarget_ptr = vimport_values.next() else:
            break
        let vtarget_module = unsafe: read(vtarget_ptr)
        match find_imported_analysis(ctx, vtarget_module):
            Option.some as vimported:
                if ensure_generic_variant_decl(ctx, vimported.value, name, args, naming.qualified_c_name(vtarget_module, generic_struct_c_name(name, args))):
                    return types.Type.ty_imported(module_name = vtarget_module, name = name, args = args)
            Option.none:
                pass
    # Try current module first.
    if ctx.analysis.structs.contains(name):
        let concrete_name = naming.qualified_c_name(ctx.module_name, generic_struct_c_name(name, args))
        ensure_generic_struct_decl_named(ctx, name, span[ast.TypeArgument](), args, concrete_name)
        generic_instance_set(ctx, concrete_name, GenericReceiver(owner_name = name, concrete_args = args, owner_module = ctx.module_name))
        return types.Type.ty_imported(module_name = ctx.module_name, name = name, args = args)
    # Try imported modules — search both public and private structs,
    # and fall back to extracting from the AST directly.
    var import_values = ctx.analysis.imports.values()
    while true:
        let target_ptr = import_values.next() else:
            break
        let target_module = unsafe: read(target_ptr)
        match find_imported_analysis(ctx, target_module):
            Option.some as imported:
                var has_struct = imported.value.structs.contains(name)
                if not has_struct:
                    has_struct = struct_in_source(imported.value, name)
                if has_struct:
                    let concrete_name = naming.qualified_c_name(target_module, generic_struct_c_name(name, args))
                    ensure_generic_struct_decl_named(ctx, name, span[ast.TypeArgument](), args, concrete_name)
                    generic_instance_set(ctx, concrete_name, GenericReceiver(owner_name = name, concrete_args = args, owner_module = target_module))
                    return types.Type.ty_imported(module_name = target_module, name = name, args = args)
            Option.none:
                pass
    # Fall back to a program-wide search: a concrete type argument may be
    # defined in a module neither the caller nor the container's module imports
    # (e.g. `Vec[StateHooks[...]]` where std.vec has no reason to import
    # std.fsm).  Only a unique owner is usable: an ambiguous simple name
    # (Node in both std.map and std.linked_map) must not be guessed.
    match find_declaring_module(ctx, name):
        Option.some as owner:
            let owner_mod = owner.value
            let concrete_name = naming.qualified_c_name(owner_mod, generic_struct_c_name(name, args))
            ensure_generic_struct_decl_named(ctx, name, span[ast.TypeArgument](), args, concrete_name)
            generic_instance_set(ctx, concrete_name, GenericReceiver(owner_name = name, concrete_args = args, owner_module = owner_mod))
            return types.Type.ty_imported(module_name = owner_mod, name = name, args = args)
        Option.none:
            pass
    return types.Type.ty_error


## The module that declares a type named `name`, searching every program
## analysis (not just the current module's imports).
function find_declaring_module(ctx: ref[LowerCtx], name: str) -> Option[str]:
    # A locally-declared type takes precedence: the caller qualifies against
    # ctx.module_name.  (Same precedence as `imported_type_module`.)
    if ctx.analysis.type_names.contains(name) or ctx.analysis.structs.contains(name) or type_declared_in_source(ctx.analysis, name):
        return Option[str].none
    # Only a unique owner is usable: with the same simple name in several
    # modules (e.g. `Field` in both mtc.parser.ast and mtc.ir) picking one
    # would mis-attribute the type.
    var found: str = ""
    var ambiguous = false
    var i: ptr_uint = 0
    while i < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + i)
        if a.module_name != ctx.module_name and (a.type_names.contains(name) or a.structs.contains(name)):
            if found.len == 0:
                found = a.module_name
            else if found != a.module_name:
                ambiguous = true
        i += 1
    if found.len > 0 and not ambiguous:
        return Option[str].some(value = found)
    return Option[str].none


## The owner module of a bare type `name` when it is defined in an imported
## module (struct, variant, or enum) rather than the current one.  Used by
## `qualify_type` so an imported bare type name qualifies against its defining
## module instead of being mis-attributed to the current module.  Returns none
## when the name is defined locally or not found in any import.
function imported_type_module(ctx: ref[LowerCtx], name: str) -> Option[str]:
    # A locally-declared type takes precedence — never redirect it to an import.
    if ctx.analysis.structs.contains(name) or type_declared_in_source(ctx.analysis, name):
        return Option[str].none
    var import_values = ctx.analysis.imports.values()
    while true:
        let target_ptr = import_values.next() else:
            break
        let target_module = unsafe: read(target_ptr)
        match find_imported_analysis(ctx, target_module):
            Option.some as imported:
                if imported.value.structs.contains(name) or type_declared_in_source(imported.value, name) or imported.value.type_alias_types.contains(name):
                    # When the type is a re-exported alias (e.g. type Mesh = c.Mesh),
                    # follow the chain to the originating module so bare C names
                    # from std.c.* are used.
                    let opt_alias = resolve_single_imported_type(ctx, target_module, name)
                    match opt_alias:
                        Option.some as resolved:
                            match resolved.value:
                                types.Type.ty_imported as aim:
                                    return Option[str].some(value = aim.module_name)
                                types.Type.ty_named as nm:
                                    if nm.module_name.len > 0:
                                        return Option[str].some(value = nm.module_name)
                                _:
                                    pass
                        Option.none:
                            pass
                    return Option[str].some(value = target_module)
            Option.none:
                pass
    return Option[str].none


## True when a module's AST declares a struct, variant, or enum named `name`.
function type_declared_in_source(module_analysis: analyzer.Analysis, name: str) -> bool:
    var di: ptr_uint = 0
    while di < module_analysis.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(module_analysis.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_struct as s:
                if s.name == name:
                    return true
            ast.Decl.decl_variant as vr:
                if vr.name == name:
                    return true
            ast.Decl.decl_enum as en:
                if en.name == name:
                    return true
            _:
                pass
        di += 1
    return false


## Check if a struct named `name` exists in a module's source file AST.
function struct_in_source(module_analysis: analyzer.Analysis, name: str) -> bool:
    var di: ptr_uint = 0
    while di < module_analysis.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(module_analysis.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_struct as s:
                if s.name == name:
                    return true
            _:
                pass
        di += 1
    return false

## The type of a concrete generic variant instance.  A prelude `Option`/`Result`
## instance keeps its global, un-prefixed C name (`std_option_Option_int`), while
## a user-defined variant instance is named after its declaring module
## (`engine_types_Outcome_int_engine_types_EngineError`).
function generic_variant_instance_type(ctx: ref[LowerCtx], variant_name: str, concrete_args: span[types.Type]) -> types.Type:
    if is_prelude_variant_name(variant_name):
        return types.Type.ty_generic(name = variant_name, args = concrete_args)
    match variant_declaring_module(ctx, variant_name):
        Option.some as owner:
            return types.Type.ty_imported(module_name = owner.value, name = variant_name, args = concrete_args)
        Option.none:
            return types.Type.ty_generic(name = variant_name, args = concrete_args)


## The module declaring a variant named `name`, searching the current module then
## the imports.  `none` when no loaded module declares it.
function variant_declaring_module(ctx: ref[LowerCtx], name: str) -> Option[str]:
    if variant_in_source(ctx.analysis, name):
        return Option[str].some(value = ctx.module_name)
    var import_values = ctx.analysis.imports.values()
    while true:
        let target_ptr = import_values.next() else:
            break
        let target_module = unsafe: read(target_ptr)
        match find_imported_analysis(ctx, target_module):
            Option.some as imported:
                if variant_in_source(imported.value, name):
                    return Option[str].some(value = target_module)
            Option.none:
                pass
    return Option[str].none


## True when a module's AST declares a generic variant named `name`.
function variant_in_source(module_analysis: analyzer.Analysis, name: str) -> bool:
    var di: ptr_uint = 0
    while di < module_analysis.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(module_analysis.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_variant as vr:
                if vr.name == name:
                    return true
            _:
                pass
        di += 1
    return false

## The IR type of a concrete Option/Result instance: the host models these as
## `Types::VariantInstance` (base name + module + arguments), not a mangled
## named type.
function prelude_variant_instance_type(name: str, args: span[types.Type]) -> types.Type:
    if name == "Option":
        return types.Type.ty_imported(module_name = "std.option", name = "Option", args = args)
    return types.Type.ty_imported(module_name = "std.result", name = "Result", args = args)


## Ensure a concrete variant declaration exists for `Option[T]` or `Result[T,E]`.
function ensure_generic_variant(ctx: ref[LowerCtx], name: str, args: span[types.Type]) -> types.Type:
    var base_name = name
    if name == "Option":
        base_name = j2("std_option_", name)
    if name == "Result":
        base_name = j2("std_result_", name)
    let c_name = generic_c_type_raw(base_name, args)
    var si: ptr_uint = 0
    while si < ctx.pending_generic_variants.len():
        let vp = ctx.pending_generic_variants.get(si) else:
            break
        unsafe:
            if read(vp).linkage_name == c_name:
                return prelude_variant_instance_type(name, args)
        si += 1
    var arms = vec.Vec[ir.VariantArm].create()
    if name == "Option" and args.len >= 1:
        let elem = unsafe: read(args.data + 0)
        var sf = vec.Vec[ir.Field].create()
        sf.push(ir.Field(name = "value", ty = elem))
        arms.push(ir.VariantArm(name = "some", linkage_name = j3(c_name, "_", "some"), fields = sf.as_span()))
        arms.push(ir.VariantArm(name = "none", linkage_name = j3(c_name, "_", "none"), fields = span[ir.Field]()))
        unsafe: read(ctx.prelude_arm_field_types).set(j3(c_name, "_", "some"), elem)
    else if name == "Result" and args.len >= 2:
        let ok = unsafe: read(args.data + 0)
        let err = unsafe: read(args.data + 1)
        var sf = vec.Vec[ir.Field].create()
        sf.push(ir.Field(name = "value", ty = ok))
        var ef = vec.Vec[ir.Field].create()
        ef.push(ir.Field(name = "error", ty = err))
        arms.push(ir.VariantArm(name = "success", linkage_name = j3(c_name, "_", "success"), fields = sf.as_span()))
        arms.push(ir.VariantArm(name = "failure", linkage_name = j3(c_name, "_", "failure"), fields = ef.as_span()))
        unsafe: read(ctx.prelude_arm_field_types).set(j3(c_name, "_", "success"), ok)
        unsafe: read(ctx.prelude_arm_field_types).set(j3(c_name, "_", "failure"), err)
    ctx.pending_generic_variants.push(ir.VariantDecl(
        name = c_name, linkage_name = c_name,
        arms = arms.as_span(), source_module = Option[str].none,
    ))
    return prelude_variant_instance_type(name, args)


## True when `ty` is a `ty_generic` whose name refers to a user-defined generic
## struct (not a builtin constructor like ptr/own/span/str_buffer etc.).  Used
## to trigger struct monomorphization via `qualify_type` when a local variable
## declaration references a generic struct without any explicit method call.
function is_user_generic_struct(ctx: ref[LowerCtx], ty: types.Type) -> bool:
    match ty:
        types.Type.ty_generic as g:
            if is_builtin_pointer_generic(g.name):
                return false
            if g.name == "Option" or g.name == "Result":
                return false
            return g.args.len > 0
        _:
            return false

## True when `name` is a pointer-like generic type handled directly by C.
function is_builtin_pointer_generic(name: str) -> bool:
    return (
        name == "ptr" or name == "const_ptr" or name == "own" or name == "ref"
        or name == "span" or name == "array" or name == "str_buffer"
        or name == "atomic" or name == "Task" or name == "SoA"
    )

function generic_c_type_raw(name: str, args: span[types.Type]) -> str:
    var buf = string.String.create()
    buf.append(name)
    var i: ptr_uint = 0
    while i < args.len:
        buf.append("_")
        unsafe:
            buf.append(naming.type_c_key(read(args.data + i)))
        i += 1
    return buf.as_str()

## Follow a type alias chain across module boundaries.  When `target_module`
## re-exports `type_name` as an alias (e.g. `std.raylib` has `type CameraMode = c.CameraMode`),
## follow the chain through the alias target to get the underlying type from the
## originating module (e.g. `ty_imported("std.c.raylib", "CameraMode")`).
## Returns none if `type_name` is not a type alias in the target module.
function resolve_single_imported_type(ctx: ref[LowerCtx], target_module: str, type_name: str) -> Option[types.Type]:
    return resolve_imported_alias_type(ctx.program_analyses, target_module, type_name)


## `resolve_single_imported_type` over an explicit analysis list, so callers
## without a `LowerCtx` (the function-ordering pass) resolve identically.
function resolve_imported_alias_type(analyses: span[analyzer.Analysis], target_module: str, type_name: str) -> Option[types.Type]:
    var ai: ptr_uint = 0
    while ai < analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(analyses.data + ai)
        if a.module_name == target_module:
            let alias_target = a.type_alias_types.get(type_name) else:
                return Option[types.Type].none
            unsafe:
                var at = read(alias_target)
                var base = at
                if types.is_nullable_type(base):
                    base = types.unwrap_nullable(base)
                match base:
                    types.Type.ty_imported as aim:
                        return Option[types.Type].some(value = types.Type.ty_imported(module_name = aim.module_name, name = aim.name, args = aim.args))
                    types.Type.ty_named as nm:
                        return Option[types.Type].some(value = types.Type.ty_named(linkage_name = Option[str].none, module_name = nm.module_name, name = nm.name))
                    _:
                        return Option[types.Type].some(value = at)
        ai += 1
    return Option[types.Type].none


## The C name for a member resolved through an import alias.
## When the member is a type alias re-exporting from std.c.* (e.g.
## `type CameraMode = c.CameraMode`), use the bare C name from the
## originating module.  Otherwise use the standard qualified name.
function imported_member_c_name(ctx: ref[LowerCtx], imported: analyzer.Analysis, target_module: str, member: str) -> str:
    if is_raw_module(imported.module_kind):
        return member
    let opt_alias = resolve_single_imported_type(ctx, target_module, member)
    match opt_alias:
        Option.some as alias_ty:
            match alias_ty.value:
                types.Type.ty_imported as aim:
                    if aim.module_name.starts_with("std.c."):
                        return aim.name
                    return naming.qualified_c_name(aim.module_name, aim.name)
                types.Type.ty_named as nm:
                    if nm.module_name.starts_with("std.c."):
                        return nm.name
                    if nm.module_name.len > 0:
                        return naming.qualified_c_name(nm.module_name, nm.name)
                    return nm.name
                _:
                    return naming.qualified_c_name(target_module, member)
        Option.none:
            return naming.qualified_c_name(target_module, member)


## The analyzer's resolved type for a locally declared type reference.  A
## nested struct's registry entry carries its parent-qualified `linkage_name`
## (`<module>_Rectangle_Edge`) while its `name` is the short one, so the
## lowering must read it from the analysis rather than rebuild a type from the
## reference's parts.  `None` for a name the analysis did not register as a
## nested (linked) named type.
function local_nested_type(ctx: ref[LowerCtx], parts: span[str]) -> Option[types.Type]:
    return nested_type_in_analysis(ctx.analysis, parts)


## The registered nested struct type for a dotted name (`Rectangle.Edge`) in an
## analysis: a `ty_named` carrying a parent-qualified linkage name.
function nested_type_in_analysis(a: analyzer.Analysis, parts: span[str]) -> Option[types.Type]:
    var buf = string.String.create()
    var i: ptr_uint = 0
    while i < parts.len:
        if i > 0:
            buf.append(".")
        unsafe:
            buf.append(read(parts.data + i))
        i += 1
    let registered_ptr = a.types.get(buf.as_str()) else:
        return Option[types.Type].none
    let registered = unsafe: read(registered_ptr)
    match registered:
        types.Type.ty_named as n:
            match n.linkage_name:
                Option.some:
                    return Option[types.Type].some(value = registered)
                Option.none:
                    return Option[types.Type].none
        _:
            return Option[types.Type].none


## Resolve the interface type arguments of a `dyn[Iface[args]]` annotation.
function dyn_type_args(ctx: ref[LowerCtx], qn: ast.QualifiedName) -> span[types.Type]:
    var args = vec.Vec[types.Type].create()
    var i: ptr_uint = 0
    while i < qn.type_arguments.len:
        args.push(resolve_type_ref(ctx, unsafe: qn.type_arguments.data + i))
        i += 1
    return args.as_span()


## Resolve a syntactic `ast.TypeRef` to a `types.Type`, producing module-
## qualified named types and modelling `array[T, N]` (N as `ty_literal_int`) and
## `span[T]` / `ptr[T]` / `const_ptr[T]` / `ref[T]` as generic instances.  Returns
## `ty_error` only for truly unresolvable forms, and `dyn`/`ty_error` for scalar
## type refs; callers should fall back to the analyzer's inferred type.
function resolve_type_ref(ctx: ref[LowerCtx], tp: ptr[ast.TypeRef]) -> types.Type:
    unsafe:
        let t = read(tp)
        if t.is_fn or t.is_proc:
            let fun = resolve_function_type_ref(ctx, tp)
            if t.is_proc:
                let _registered = proc_ensure_struct_decl(ctx, naming.proc_type_c_name(fun), fun)
                return fun
            if t.nullable:
                return types.Type.ty_nullable(base = types.alloc_type(fun))
            return fun
        if t.is_dyn:
            return types.Type.ty_dyn(iface = naming.dyn_iface_declared_name(unsafe: analyzer.qname_to_str(t.dyn_interface)), args = dyn_type_args(ctx, t.dyn_interface))
        if t.is_tuple:
            var elems = vec.Vec[types.Type].create()
            var i: ptr_uint = 0
            while i < t.arguments.len:
                elems.push(resolve_type_ref(ctx, t.arguments.data + i))
                i += 1
            let result = types.Type.ty_tuple(elements = elems.as_span(), field_names = Option[span[str]].none)
            if t.nullable:
                return types.Type.ty_nullable(base = types.alloc_type(result))
            return result
        var resolved = types.Type.ty_error
        if t.arguments.len > 0:
            resolved = resolve_generic_type_ref(ctx, t)
        else if t.name.parts.len >= 2:
            var alias: str
            var type_name: str
            unsafe:
                alias = read(t.name.parts.data + 0)
                type_name = read(t.name.parts.data + 1)
            # Inline for substitution: `field.type` resolves to the field's type.
            if type_name == "type":
                let subst = inline_for_type_subst(ctx, alias)
                if not types.is_error(subst):
                    resolved = subst
                    if t.nullable:
                        return types.Type.ty_nullable(base = types.alloc_type(resolved))
                    return resolved
            let mod_ptr = ctx.analysis.imports.get(alias)
            if mod_ptr != null:
                let target_module = unsafe: read(mod_ptr)
                # If the imported module re-exports the type as an alias
                # (e.g. `type CameraMode = c.CameraMode`), follow the chain
                # so the C name comes from the originating `std.c.*` module.
                if find_imported_opaque_decl(ctx, target_module, type_name):
                    resolved = types.Type.ty_opaque(module_name = target_module, name = type_name)
                else:
                    let opt_alias = resolve_single_imported_type(ctx, target_module, type_name)
                    match opt_alias:
                        Option.some as alias_ty:
                            resolved = proc_alias_struct_type(ctx, alias_ty.value)
                        Option.none:
                            resolved = types.Type.ty_imported(module_name = target_module, name = type_name, args = span[types.Type]())
            else:
                # Not an import alias: may be a nested struct, e.g.
                # `Rectangle.Edge` or `Level1.Level2.Level3`.  Its type carries
                # the parent-qualified linkage (`<module>_Rectangle_Edge`).
                match local_nested_type(ctx, t.name.parts):
                    Option.some as nested:
                        resolved = nested.value
                    Option.none:
                        pass
        else if t.name.parts.len == 1:
            let name = read(t.name.parts.data + 0)
            # A name bound by the enclosing generic's substitution is a type
            # parameter and must be substituted even when the current module
            # declares a same-named type (e.g. `StateHooks[State, Context]`
            # inside `extending StateMachine[State, Event, Context]`).
            let subst_ptr = ctx.type_substitution.get(name)
            if subst_ptr != null:
                resolved = unsafe: read(subst_ptr)
            else if name == "str":
                resolved = types.Type.ty_str
            else if name == "type":
                resolved = types.Type.ty_type_meta
            else if is_builtin_type_name(name):
                resolved = types.primitive(name)
            else if ctx.analysis.type_names.contains(name):
                if find_imported_opaque_decl(ctx, ctx.module_name, name):
                    # A declared `opaque X` (optionally with a C backing name) is
                    # `Types::Opaque`, not a struct.
                    resolved = types.Type.ty_opaque(module_name = ctx.module_name, name = name)
                    if t.nullable:
                        return types.Type.ty_nullable(base = types.alloc_type(resolved))
                    return resolved
                # Follow the type alias chain so that type aliases pointing to
                # imported types (e.g. `type Color = c.Color`) resolve to the
                # originating module's C name rather than the re-exporting
                # module's qualified name.
                var alias_target = ctx.analysis.type_alias_types.get(name)
                if alias_target != null:
                    resolved = proc_alias_struct_type(ctx, unsafe: read(alias_target))
                else:
                    match local_nested_type(ctx, t.name.parts):
                        Option.some as nested:
                            resolved = nested.value
                        Option.none:
                            resolved = types.Type.ty_imported(module_name = ctx.module_name, name = name, args = span[types.Type]())
            else:
                let concrete_ptr = ctx.type_substitution.get(name)
                if concrete_ptr != null:
                    resolved = unsafe: read(concrete_ptr)
                else:
                    resolved = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = name)
        if t.nullable and not types.is_error(resolved):
            return types.Type.ty_nullable(base = types.alloc_type(resolved))
        return resolved


## The type a type alias denotes.  A `type Callback = proc(int) -> int` alias
## denotes its closure struct (`mt_proc_...`), not a bare function pointer, so a
## proc-typed alias matches direct `proc(...)` syntax wherever it is used — as an
## array element, a field, a parameter, or a local annotation.  Any other alias
## target passes through.
function proc_alias_struct_type(ctx: ref[LowerCtx], target: types.Type) -> types.Type:
    match target:
        types.Type.ty_function as fnt:
            if fnt.is_proc:
                return proc_ensure_struct_decl(ctx, naming.proc_type_c_name(target), target)
        _:
            pass
    return target


function resolve_generic_type_ref(ctx: ref[LowerCtx], t: ast.TypeRef) -> types.Type:
    if t.name.parts.len == 2:
        var alias: str
        var type_name: str
        unsafe:
            alias = read(t.name.parts.data + 0)
            type_name = read(t.name.parts.data + 1)
        let mod_ptr = ctx.analysis.imports.get(alias)
        if mod_ptr != null:
            let target_module = unsafe: read(mod_ptr)
            # A re-exported type alias resolves to its target's type (e.g.
            # `aio.Runtime` -> `std.async.libuv_runtime.Runtime`), matching the
            # analyzer's alias erasure; a plain imported name stays imported.
            match resolve_single_imported_type(ctx, target_module, type_name):
                Option.some as alias_ty:
                    return alias_ty.value
                Option.none:
                    pass
            var resolved_args = vec.Vec[types.Type].create()
            var ai: ptr_uint = 0
            while ai < t.arguments.len:
                unsafe:
                    resolved_args.push(resolve_type_ref(ctx, t.arguments.data + ai))
                ai += 1
            return types.Type.ty_imported(module_name = target_module, name = type_name, args = resolved_args.as_span())
        return types.Type.ty_error
    if t.name.parts.len != 1:
        return types.Type.ty_error
    let name = unsafe: read(t.name.parts.data + 0)
    if name == "array" and t.arguments.len == 2:
        var args = vec.Vec[types.Type].create()
        unsafe:
            args.push(resolve_type_ref(ctx, t.arguments.data + 0))
        args.push(resolve_array_length_type(ctx, unsafe: t.arguments.data + 1))
        return types.Type.ty_generic(name = "array", args = args.as_span())
    # simd[T, N]: the lane count resolves like an array length (a literal, a
    # bound type parameter, or a module constant), never as a type name.
    if name == "simd" and t.arguments.len == 2:
        var simd_args = vec.Vec[types.Type].create()
        unsafe:
            simd_args.push(resolve_type_ref(ctx, t.arguments.data + 0))
        simd_args.push(resolve_array_length_type(ctx, unsafe: t.arguments.data + 1))
        return types.Type.ty_generic(name = "simd", args = simd_args.as_span())
    # SoA[T, N]: the count is an integer argument like simd's lane count (the
    # host stores a plain Integer in `Types::SoA#count`).
    if name == "SoA" and t.arguments.len == 2:
        var soa_args = vec.Vec[types.Type].create()
        unsafe:
            soa_args.push(resolve_type_ref(ctx, t.arguments.data + 0))
        soa_args.push(resolve_array_length_type(ctx, unsafe: t.arguments.data + 1))
        return types.Type.ty_generic(name = "SoA", args = soa_args.as_span())
    # str_buffer[N]: ensure the struct type exists and return the resolved type.
    if name == "str_buffer" and t.arguments.len == 1:
        var sb_args = vec.Vec[types.Type].create()
        # The capacity N is an integer type argument: resolve it (like
        # `array[T, N]`) so it folds a literal, a generic type parameter bound by
        # the current specialization (`str_buffer[N]` with `N = 16`), or a
        # module-level constant to a `ty_literal_int`.  A plain
        # `resolve_array_length` would leave a substituted `N` as 0.
        sb_args.push(resolve_array_length_type(ctx, unsafe: t.arguments.data + 0))
        let sb_ty = types.Type.ty_generic(name = "str_buffer", args = sb_args.as_span())
        ensure_str_buffer_struct(ctx, sb_ty)
        return sb_ty
    # span / ptr / const_ptr / ref and other generics: resolve each type argument.
    var args = vec.Vec[types.Type].create()
    var i: ptr_uint = 0
    while i < t.arguments.len:
        unsafe:
            args.push(resolve_type_ref(ctx, t.arguments.data + i))
        i += 1
    return types.Type.ty_generic(name = name, args = args.as_span())


## Resolve an `fn(...) -> T` or `proc(...) -> T` type ref to a `ty_function`
## type.  Both `fn` and `proc` share the same runtime C representation (function
## pointer), so they are lowered to the same `ty_function` variant.
function resolve_function_type_ref(ctx: ref[LowerCtx], tp: ptr[ast.TypeRef]) -> types.Type:
    let t = unsafe: read(tp)
    var param_types = vec.Vec[types.Type].create()
    var param_names = vec.Vec[str].create()
    var i: ptr_uint = 0
    while i < t.fn_params.len:
        var p: ast.Param
        unsafe:
            p = read(t.fn_params.data + i)
        let pty = resolve_type_ref(ctx, ptr_of(p.param_type))
        param_types.push(pty)
        param_names.push(p.name)
        i += 1
    var ret = ctx.void_ty
    let fr = t.fn_return
    if fr != null:
        unsafe:
            ret = resolve_type_ref(ctx, fr)
    return types.Type.ty_function(name = "", params = param_types.as_span(),
        return_type = types.alloc_type(ret),
        variadic = false,
        is_proc = t.is_proc,
        param_names = param_names.as_span(),
    )


## The compile-time length of an array type argument (`array[int, 3]` -> 3),
## parsed from the argument's decimal name.  Non-literal lengths (named
## constants) resolve later.
function resolve_array_length(tp: ptr[ast.TypeRef]) -> long:
    let t = unsafe: read(tp)
    if t.name.parts.len != 1:
        return 0
    let text = unsafe: read(t.name.parts.data + 0)
    return parse_decimal(text)


## Resolve an array-length type argument to a `ty_literal_int`.  A numeric
## literal (`4`) parses directly.  A named length parameter (`N` in
## `array[T, N]`) resolves through `ctx.type_substitution` when the enclosing
## generic is being specialized (`N -> ty_literal_int(4)`); a module-level
## integer constant (`array[T, ENV_ITEM_COUNT]`) folds through
## `ctx.analysis.const_values`; otherwise it is left as a `ty_named` so a later
## `substitute_type_params` can fill it in.
function resolve_array_length_type(ctx: ref[LowerCtx], tp: ptr[ast.TypeRef]) -> types.Type:
    let t = unsafe: read(tp)
    if t.name.parts.len == 1:
        let text = unsafe: read(t.name.parts.data + 0)
        if text.len > 0 and text.byte_at(0) >= '0' and text.byte_at(0) <= '9':
            return types.literal_int(parse_decimal(text))
        # A named length parameter: substitute if bound, else keep the name.
        let concrete_ptr = ctx.type_substitution.get(text)
        if concrete_ptr != null:
            return unsafe: read(concrete_ptr)
        # A module-level integer constant used as a length: fold to its value.
        let const_ptr = ctx.analysis.const_values.get(text)
        if const_ptr != null:
            return types.literal_int(const_eval_int(ctx, unsafe: read(const_ptr)))
        return types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = text)
    # A module-qualified constant (`array[b3.BodyId, human.BONE_COUNT]`): fold it
    # through the alias's module, evaluating the constant's value expression in
    # the module that declares it (the host's
    # `resolve_imported_module_const_value`).
    if t.name.parts.len == 2:
        let alias = unsafe: read(t.name.parts.data + 0)
        let member = unsafe: read(t.name.parts.data + 1)
        let target_ptr = ctx.analysis.imports.get(alias)
        if target_ptr != null:
            match find_imported_analysis(ctx, unsafe: read(target_ptr)):
                Option.some as owner:
                    var saved_module = ctx.module_name
                    var saved_analysis = ctx.analysis
                    ctx.module_name = owner.value.module_name
                    ctx.analysis = owner.value
                    var folded = Option[long].none
                    let chain = ctx.analysis.const_values.get(member)
                    if chain != null:
                        folded = try_const_eval_int(ctx, unsafe: read(chain))
                    ctx.module_name = saved_module
                    ctx.analysis = saved_analysis
                    match folded:
                        Option.some as value:
                            return types.literal_int(value.value)
                        Option.none:
                            pass
                Option.none:
                    pass
    return types.literal_int(resolve_array_length(tp))


function parse_decimal(text: str) -> long:
    var value: long = 0
    var i: ptr_uint = 0
    while i < text.len:
        let b = text.byte_at(i)
        if b == '_':
            i += 1
            continue
        if b < '0' or b > '9':
            break
        value = value * 10 + long<-(b - '0')
        i += 1
    return value


## Lower an `if`/`else if`/`else` chain into nested `IR::IfStmt`s.  A branch
## condition's hoisted setup (a statement-lowered foreign call's argument temps)
## is emitted *before* its `IfStmt` — for an `else if` that is the enclosing
## branch's else body — and the condition's cleanups head *both* branches, the
## host's `lower_if_chain` shape.
##
## Each branch is lowered with the host's flow refinements (`block.rb:656-709`):
## the condition and body see the accumulated falsy refinements of the earlier
## branches, the body adds the condition's truthy refinements, and an else-less
## `if` whose branches all terminate narrows the enclosing block after the
## statement.
function lower_if_chain(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], branches: span[ast.IfBranch], index: ptr_uint, else_body: ptr[ast.Stmt]?) -> void:
    var prior_false = map_mod.Map[str, types.Type].create()
    lower_if_chain_at(ctx, output, branches, index, else_body, ref_of(prior_false), true)


function lower_if_chain_at(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], branches: span[ast.IfBranch], index: ptr_uint, else_body: ptr[ast.Stmt]?, prior_false: ref[map_mod.Map[str, types.Type]], top: bool) -> void:
    var branch: ast.IfBranch
    unsafe:
        branch = read(branches.data + index)
    let base_saved = push_flow_refinements(ctx, prior_false)
    let cond_base = output.len()
    # A condition is a *prepared* position: a statement-lowered foreign call
    # materializes into `__mt_foreign_result_N` with its cleanups before the
    # `IfStmt` (the host's `prepare_statement_lowered_foreign_call` +
    # `materialize_prepared_expression`), the shape `hm_return` produces.
    let cond_saved = begin_stmt_setup(ctx, HoistMode.hm_return)
    let cond = lower_expr(ctx, branch.condition)
    let cond_collected = collect_stmt_setup(ctx, cond_saved)
    emit_hoist_setup(output, cond_base, cond_collected)

    # The body's visible env: the prior falsy refinements plus this
    # condition's truthy refinements (the host's `merge_refinements`).
    var true_refs = map_mod.Map[str, types.Type].create()
    merge_flow_refinements(ref_of(true_refs), prior_false)
    var cond_true = lowering_flow_refinements(ctx, branch.condition, true)
    merge_flow_refinements(ref_of(true_refs), ref_of(cond_true))
    var then_body = vec.Vec[ir.Stmt].create()
    append_hoist_cleanups(ref_of(then_body), cond_collected)
    let then_saved = push_flow_refinements(ctx, ref_of(true_refs))
    then_body.append_span(lower_block(ctx, branch.body))
    restore_flow_refinements(ctx, then_saved)

    # The cumulative falsy refinements for the next branch.
    var next_false = map_mod.Map[str, types.Type].create()
    merge_flow_refinements(ref_of(next_false), prior_false)
    var cond_false = lowering_flow_refinements(ctx, branch.condition, false)
    merge_flow_refinements(ref_of(next_false), ref_of(cond_false))

    # A source-level `if` always carries an else body in the host's IR — an
    # empty one when the source has no else clause.
    var else_inner = vec.Vec[ir.Stmt].create()
    if index + 1 < branches.len:
        lower_if_chain_at(ctx, ref_of(else_inner), branches, index + 1, else_body, ref_of(next_false), false)
    else:
        let else_saved = push_flow_refinements(ctx, ref_of(next_false))
        else_inner.append_span(lower_block(ctx, else_body))
        restore_flow_refinements(ctx, else_saved)
    var else_stmts = vec.Vec[ir.Stmt].create()
    append_hoist_cleanups(ref_of(else_stmts), cond_collected)
    else_stmts.append_span(else_inner.as_span())

    # The sync path always carries an else body — an empty list when the source
    # has none (`block.rb:682-701`).  The async non-await path instead emits
    # `nil` for an empty effective else (`async_lowering.rb:667`).
    var else_opt = Option[span[ir.Stmt]].some(value = else_stmts.as_span())
    if ctx.async_nonawait_body and else_stmts.len() == 0:
        else_opt = Option[span[ir.Stmt]].none
    output.push(ir.Stmt.stmt_if(condition = cond, then_body = then_body.as_span(), else_body = else_opt))
    restore_flow_refinements(ctx, base_saved)

    # The host's post-if rule (`block.rb:707`): an else-less `if` whose branches
    # all terminate narrows the enclosing block's env after the statement.
    # `break`/`continue` count as falling through here (the host's termination
    # builder has no loop targets), which is why the guard-break shape does not
    # refine.  The pushed scope is released by the enclosing `lower_block`.
    if top and else_body == null and if_branches_all_terminate(branches):
        var final_false = map_mod.Map[str, types.Type].create()
        var bi: ptr_uint = 0
        while bi < branches.len:
            var cond_false_i = lowering_flow_refinements(ctx, unsafe: read(branches.data + bi).condition, false)
            merge_flow_refinements(ref_of(final_false), ref_of(cond_false_i))
            bi += 1
        let _post_scope = push_flow_refinements(ctx, ref_of(final_false))


function if_branches_all_terminate(branches: span[ast.IfBranch]) -> bool:
    if branches.len == 0:
        return false
    var i: ptr_uint = 0
    while i < branches.len:
        var br: ast.IfBranch
        unsafe:
            br = read(branches.data + i)
        if not ast_block_always_terminates(br.body):
            return false
        i += 1
    return true


## Lower `for i in start..stop:` into a scope block holding an optional hoisted
## stop temporary and a C `for` loop.  Mirrors lowering/loops.rb
## lower_range_for_stmt, including the always-allocated (here unused) continue /
## break label temporaries so the fresh-temp counter advances identically.
function lower_for_range(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], bindings: span[ast.ForBinding], iterables: span[ast.Expr], body_ptr: ptr[ast.Stmt]?) -> void:
    if bindings.len != 1 or iterables.len != 1:
        lower_multi_for(ctx, output, bindings, iterables, body_ptr)
        return

    var index_name: str
    unsafe:
        index_name = read(bindings.data + 0).name

    var start: ptr[ast.Expr]
    var stop: ptr[ast.Expr]
    unsafe:
        match read(iterables.data + 0):
            ast.Expr.expr_range as rng:
                start = rng.start_expr
                stop = rng.end_expr
            _:
                lower_collection_for(ctx, output, index_name, iterables.data + 0, body_ptr)
                return

    # The host's `infer_range_loop_type`: an integer-literal bound takes the
    # other bound's type, so `for i in 0..span.len` is a `ptr_uint` loop.
    var loop_type = expr_type(ctx, start)
    var stop_ty = expr_type(ctx, stop)
    if not types.type_equals(loop_type, stop_ty):
        if ast_is_integer_literal(start) and types.is_integer_type(stop_ty):
            loop_type = stop_ty
        else if ast_is_integer_literal(stop) and types.is_integer_type(loop_type):
            stop_ty = loop_type
    if types.is_error(loop_type):
        loop_type = types.primitive("int")

    let index_c = utils.c_local_name(index_name)
    let stop_c = fresh_c_temp_name(ctx, "for_stop")

    # The host inlines the stop value when it is a compile-time numeric
    # constant expression (`compile_time_numeric_const_expression?`) — a literal,
    # a module constant, an enum member or a fold of those — and hoists the
    # `__mt_for_stop_N` temp only otherwise.
    let inline_stop = is_numeric_const_expression(ctx, stop)

    let saved_break = ctx.loop_break_label
    let saved_continue = ctx.loop_continue_label
    let saved_continue_native = ctx.loop_continue_native
    let saved_break_native = ctx.loop_break_native
    let cl = fresh_c_temp_name(ctx, "loop_continue")
    let bl = fresh_c_temp_name(ctx, "loop_break")
    ctx.loop_break_label = bl
    ctx.loop_continue_label = cl
    # A native `continue` reaches the generated loop's post statement and a
    # native `break` exits it (the host's ContinueStmt/BreakStmt); the labels
    # remain for the defer-flush paths and for arms inside a switch.
    ctx.loop_continue_native = true
    ctx.loop_break_native = true

    # In CPS mode, spill the induction variable and (if not inline) the stop value
    # to frame fields so they survive an `await` inside the loop body.
    var index_linkage: str = index_c
    var stop_linkage: str = stop_c
    if ctx.async_cps_active:
        let idx_field = j2("local_for_", index_name)
        index_linkage = j2("__mt_frame->", idx_field)
        async_register_local_field(ctx, index_name, idx_field, index_linkage, loop_type)
        if not inline_stop:
            let stp_field = j2("local_", stop_c)
            stop_linkage = j2("__mt_frame->", stp_field)
            async_register_local_field(ctx, stop_c, stp_field, stop_linkage, loop_type)
    else:
        ctx.locals.push(LocalBinding(name = index_name, c_name = index_c, ty = loop_type, pointer = Option[bool].some(value = false)))

    let saved_loop_depth = ctx.loop_defer_depth
    ctx.loop_defer_depth = ctx.defer_stack.len()
    let body_span = lower_block(ctx, body_ptr)
    var body = vec.Vec[ir.Stmt].create()
    append_span_stmts(ref_of(body), body_span)
    if contains_label_target(body.as_span(), cl):
        body.push(ir.Stmt.stmt_label(name = cl))

    let index_ref = alloc_expr(ir.Expr.expr_name(name = index_linkage, ty = loop_type, pointer = Option[bool].some(value = false)))
    # The host lowers both bounds with the loop type as the expected type
    # (`lower_expression(..., expected_type: loop_type)`).
    let start_value = int_literal_to_context_type(start, loop_type, lower_expr(ctx, start))
    let stop_lowered = int_literal_to_context_type(stop, loop_type, lower_expr(ctx, stop))
    var init: ptr[ir.Stmt]
    if ctx.async_cps_active:
        init = alloc_stmt(ir.Stmt.stmt_assignment(target = index_ref, operator = "=", value = start_value))
    else:
        init = alloc_stmt(ir.Stmt.stmt_local(
            name = index_name,
            linkage_name = index_c,
            ty = loop_type,
            value = start_value,
            line = 0,
            source_path = "",
        ))
    let stop_value = if inline_stop: stop_lowered else: alloc_expr(ir.Expr.expr_name(name = stop_linkage, ty = loop_type, pointer = Option[bool].some(value = false)))
    let condition = alloc_expr(ir.Expr.expr_binary(operator = "<", left = index_ref, right = stop_value, ty = ctx.bool_ty))
    let post_target = alloc_expr(ir.Expr.expr_name(name = index_linkage, ty = loop_type, pointer = Option[bool].some(value = false)))
    let one = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = loop_type))
    let post = alloc_stmt(ir.Stmt.stmt_assignment(target = post_target, operator = "+=", value = one))
    let for_stmt = ir.Stmt.stmt_for(init = init, condition = condition, post = post, body = body.as_span())

    var block_stmts = vec.Vec[ir.Stmt].create()
    if not inline_stop:
        if ctx.async_cps_active:
            block_stmts.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_name(name = stop_linkage, ty = loop_type, pointer = Option[bool].some(value = false))), operator = "=", value = stop_lowered))
        else:
            block_stmts.push(ir.Stmt.stmt_local(
                name = stop_c,
                linkage_name = stop_c,
                ty = loop_type,
                value = stop_lowered,
                line = 0,
                source_path = "",
            ))
    block_stmts.push(for_stmt)
    if contains_label_target(body.as_span(), bl):
        block_stmts.push(ir.Stmt.stmt_label(name = bl))
    output.push(ir.Stmt.stmt_block(body = block_stmts.as_span()))

    ctx.loop_break_label = saved_break
    ctx.loop_continue_label = saved_continue
    ctx.loop_continue_native = saved_continue_native
    ctx.loop_break_native = saved_break_native
    ctx.loop_defer_depth = saved_loop_depth


## True when `ep` is an integer-literal expression (the host's
## `AST::IntegerLiteral` checks in `infer_range_loop_type`).
function ast_is_integer_literal(ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_integer_literal:
                return true
            _:
                return false


## True when `ep` folds to a numeric compile-time constant (the host's
## `compile_time_numeric_const_expression?`): a literal, a module constant
## (recursively), an enum member's value, or an arithmetic fold of those.
function is_numeric_const_expression(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> bool:
    match try_evaluate_const_expr(ctx, ep):
        Option.some as value:
            match value.value:
                ConstValue.cv_int:
                    return true
                _:
                    return false
        Option.none:
            return false


## Lower `for v in xs:` (array) / `for v in s:` (span) into a scope block that
## copies the iterable into a temp and drives a C index loop.  Mirrors
## lowering/loops.rb lower_collection_for_stmt (including the always-allocated
## continue/break label temporaries so the fresh-temp counter matches).
function lower_collection_for(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], binding_name: str, iterable: ptr[ast.Expr], body_ptr: ptr[ast.Stmt]?) -> void:
    let iterable_type = index_receiver_type(ctx, iterable)
    let element_type = generic_first_arg(iterable_type)
    let is_arr = is_array_type(iterable_type)
    # Only arrays and spans are index-driven collections.  Every other iterable
    # (Vec, Queue, map entries, ...) goes through the iterator protocol
    # (`iter()` / `next()` / `current()`).
    if not is_arr and not is_span_type(iterable_type):
        if not ctx.async_cps_active:
            lower_custom_iter_for(ctx, output, binding_name, iterable, body_ptr)
        return
    let ptr_uint_ty = types.primitive("ptr_uint")

    let items_c = fresh_c_temp_name(ctx, "for_items")
    let index_c = fresh_c_temp_name(ctx, "for_index")

    let binding_c = utils.c_local_name(binding_name)
    let saved_break = ctx.loop_break_label
    let saved_continue = ctx.loop_continue_label
    let saved_continue_native = ctx.loop_continue_native
    let saved_break_native = ctx.loop_break_native
    let cl = fresh_c_temp_name(ctx, "loop_continue")
    let bl = fresh_c_temp_name(ctx, "loop_break")
    ctx.loop_break_label = bl
    ctx.loop_continue_label = cl
    # A native `continue` reaches the generated loop's post statement and a
    # native `break` exits it (the host's ContinueStmt/BreakStmt); the labels
    # remain for the defer-flush paths and for arms inside a switch.
    ctx.loop_continue_native = true
    ctx.loop_break_native = true

    # In CPS mode, register the index and element binding as frame fields so they
    # survive an `await` inside the loop body.
    var idx_linkage: str = index_c
    var items_linkage: str = items_c
    if ctx.async_cps_active:
        let idx_field = j2("local_", index_c)
        idx_linkage = j2("__mt_frame->", idx_field)
        async_register_local_field(ctx, index_c, idx_field, idx_linkage, ptr_uint_ty)
        let items_field = j2("local_", items_c)
        items_linkage = j2("__mt_frame->", items_field)
        async_register_local_field(ctx, items_c, items_field, items_linkage, iterable_type)

    ctx.locals.push(LocalBinding(name = binding_name, c_name = binding_c, ty = element_type, pointer = Option[bool].some(value = false)))
    let saved_loop_depth = ctx.loop_defer_depth
    ctx.loop_defer_depth = ctx.defer_stack.len()
    let body_span = lower_block(ctx, body_ptr)

    # item value: array -> items[index]; span -> items.data[index]
    var item_value: ptr[ir.Expr]
    let index_ref_item = alloc_expr(ir.Expr.expr_name(name = idx_linkage, ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    if is_arr:
        let items_ref = alloc_expr(ir.Expr.expr_name(name = items_linkage, ty = iterable_type, pointer = Option[bool].some(value = false)))
        item_value = alloc_expr(ir.Expr.expr_index(receiver = items_ref, index = index_ref_item, ty = element_type))
    else:
        let items_ref = alloc_expr(ir.Expr.expr_name(name = items_linkage, ty = iterable_type, pointer = Option[bool].some(value = false)))
        var ptr_args = vec.Vec[types.Type].create()
        ptr_args.push(element_type)
        let data_ty = types.Type.ty_generic(name = "ptr", args = ptr_args.as_span())
        let data_ref = alloc_expr(ir.Expr.expr_member(receiver = items_ref, member = "data", ty = data_ty))
        item_value = alloc_expr(ir.Expr.expr_index(receiver = data_ref, index = index_ref_item, ty = element_type))

    # stop value: array -> N; span -> items.len
    var stop_value: ptr[ir.Expr]
    if is_arr:
        stop_value = alloc_expr(ir.Expr.expr_integer_literal(value = array_length_of(iterable_type), ty = ptr_uint_ty))
    else:
        let items_ref_stop = alloc_expr(ir.Expr.expr_name(name = items_linkage, ty = iterable_type, pointer = Option[bool].some(value = false)))
        stop_value = alloc_expr(ir.Expr.expr_member(receiver = items_ref_stop, member = "len", ty = ptr_uint_ty))

    var loop_body = vec.Vec[ir.Stmt].create()
    if ctx.async_cps_active:
        let elt_field = j2("local_for_elt_", binding_name)
        let elt_cname = j2("__mt_frame->", elt_field)
        async_register_local_field(ctx, binding_name, elt_field, elt_cname, element_type)
        loop_body.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_name(name = elt_cname, ty = element_type, pointer = Option[bool].some(value = false))), operator = "=", value = item_value))
    else:
        loop_body.push(ir.Stmt.stmt_local(name = binding_name, linkage_name = binding_c, ty = element_type, value = item_value, line = 0, source_path = ""))
    var bi: ptr_uint = 0
    while bi < body_span.len:
        unsafe:
            loop_body.push(read(body_span.data + bi))
        bi += 1
    if contains_label_target(loop_body.as_span(), cl):
        loop_body.push(ir.Stmt.stmt_label(name = cl))

    var init: ptr[ir.Stmt]
    if ctx.async_cps_active:
        init = alloc_stmt(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_name(name = idx_linkage, ty = ptr_uint_ty, pointer = Option[bool].some(value = false))), operator = "=", value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty))))
    else:
        init = alloc_stmt(ir.Stmt.stmt_local(name = index_c, linkage_name = index_c, ty = ptr_uint_ty, value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty)), line = 0, source_path = ""))
    let index_ref_cond = alloc_expr(ir.Expr.expr_name(name = idx_linkage, ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let condition = alloc_expr(ir.Expr.expr_binary(operator = "<", left = index_ref_cond, right = stop_value, ty = ctx.bool_ty))
    let post_target = alloc_expr(ir.Expr.expr_name(name = idx_linkage, ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let post = alloc_stmt(ir.Stmt.stmt_assignment(target = post_target, operator = "+=", value = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = ptr_uint_ty))))
    let for_stmt = ir.Stmt.stmt_for(init = init, condition = condition, post = post, body = loop_body.as_span())

    var block_stmts = vec.Vec[ir.Stmt].create()
    if ctx.async_cps_active:
        block_stmts.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_name(name = items_linkage, ty = iterable_type, pointer = Option[bool].some(value = false))), operator = "=", value = lower_expr(ctx, iterable)))
    else:
        block_stmts.push(ir.Stmt.stmt_local(name = items_c, linkage_name = items_c, ty = iterable_type, value = lower_expr(ctx, iterable), line = 0, source_path = ""))
    block_stmts.push(for_stmt)
    if contains_label_target(loop_body.as_span(), bl):
        block_stmts.push(ir.Stmt.stmt_label(name = bl))
    output.push(ir.Stmt.stmt_block(body = block_stmts.as_span()))

    ctx.loop_break_label = saved_break
    ctx.loop_continue_label = saved_continue
    ctx.loop_continue_native = saved_continue_native
    ctx.loop_break_native = saved_break_native
    ctx.loop_defer_depth = saved_loop_depth


## Lower `for x in custom_iterable` over the iterator protocol.  The `iter()`
## / `next()` / `current()` calls are synthesized as AST and lowered through the
## normal call path so generic receivers (a `Vec[int]` collapses to a concrete
## struct) monomorphize exactly like a source-level method call.  Two shapes
## are supported, mirroring the host's `iterator_loop_info`:
##   * nullable item: `Iter it = xs.iter(); while (true) { T* x = it.next();
##     if (x == null) break; body }`
##   * ready flag: `Iter it = xs.iter(); while (true) { bool ready = it.next();
##     if (!ready) break; T x = it.current(); body }`
function lower_custom_iter_for(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], binding_name: str, iterable: ptr[ast.Expr], body_ptr: ptr[ast.Stmt]?) -> void:
    # The host's `iterator_loop_type` instantiates `iter`/`next`/`current` while
    # analyzing the loop but never validates their bodies, so those
    # specializations' nested calls are lowering-created.
    let iter_callee = alloc_ast_expr(ast.Expr.expr_member_access(receiver = iterable, member_name = "iter", line = 0, column = 0))
    ctx.next_spec_body_validated = Option[bool].some(value = false)
    let iter_call = lower_call(ctx, iter_callee, span[ast.Argument](), iter_callee)
    ctx.next_spec_body_validated = Option[bool].none
    let iter_ty = ir_expr_type(iter_call)
    if types.is_error(iter_ty) or types.is_void(iter_ty):
        return

    let it_c = fresh_c_temp_name(ctx, "for_iterator")
    ctx.locals.push(LocalBinding(name = it_c, c_name = it_c, ty = iter_ty, pointer = Option[bool].some(value = false)))

    let it_id = alloc_ast_expr(ast.Expr.expr_identifier(name = it_c, line = 0, column = 0))
    let next_callee = alloc_ast_expr(ast.Expr.expr_member_access(receiver = it_id, member_name = "next", line = 0, column = 0))
    ctx.next_spec_body_validated = Option[bool].some(value = false)
    let next_call = lower_call(ctx, next_callee, span[ast.Argument](), next_callee)
    ctx.next_spec_body_validated = Option[bool].none
    let next_ty = ir_expr_type(next_call)
    if types.is_error(next_ty) or types.is_void(next_ty):
        return
    let nullable_item = is_nullable_pointer_like(next_ty)

    var cur_call = next_call
    var cur_ty = next_ty
    if not nullable_item:
        let it_id2 = alloc_ast_expr(ast.Expr.expr_identifier(name = it_c, line = 0, column = 0))
        let cur_callee = alloc_ast_expr(ast.Expr.expr_member_access(receiver = it_id2, member_name = "current", line = 0, column = 0))
        ctx.next_spec_body_validated = Option[bool].some(value = false)
        cur_call = lower_call(ctx, cur_callee, span[ast.Argument](), cur_callee)
        ctx.next_spec_body_validated = Option[bool].none
        cur_ty = ir_expr_type(cur_call)
        if types.is_error(cur_ty) or types.is_void(cur_ty):
            return

    let saved_break = ctx.loop_break_label
    let saved_continue = ctx.loop_continue_label
    let saved_continue_native = ctx.loop_continue_native
    let saved_break_native = ctx.loop_break_native
    let cl = fresh_c_temp_name(ctx, "loop_continue")
    let bl = fresh_c_temp_name(ctx, "loop_break")
    ctx.loop_break_label = bl
    ctx.loop_continue_label = cl
    # A native `continue` reaches the generated loop's post statement and a
    # native `break` exits it (the host's ContinueStmt/BreakStmt); the labels
    # remain for the defer-flush paths and for arms inside a switch.
    ctx.loop_continue_native = true
    ctx.loop_break_native = true

    let binding_c = utils.c_local_name(binding_name)
    let binding_ty = if nullable_item: types.unwrap_nullable(next_ty) else: cur_ty
    # The host registers the loop binding with the `next()` storage (nullable)
    # and the unwrapped item as its visible type (`iterator_loop_info`'s
    # `item_storage_type`/`item_type`), so a pointer-like item's reads keep the
    # storage `Nullable` and a non-pointer-like one projects `.value`.
    var binding_projection = BindingProjection.plain
    if nullable_item:
        binding_projection = guard_binding_projection("nullable", next_ty)
    ctx.locals.push(LocalBinding(name = binding_name, c_name = binding_c, ty = binding_ty, pointer = Option[bool].some(value = false), projection = binding_projection))
    let saved_loop_depth = ctx.loop_defer_depth
    ctx.loop_defer_depth = ctx.defer_stack.len()
    let body_span = lower_block(ctx, body_ptr)

    var break_body = vec.Vec[ir.Stmt].create()
    break_body.push(ir.Stmt.stmt_break())

    var loop_body = vec.Vec[ir.Stmt].create()
    if nullable_item:
        let item_ref = alloc_expr(ir.Expr.expr_name(name = binding_c, ty = next_ty, pointer = Option[bool].some(value = false)))
        loop_body.push(ir.Stmt.stmt_local(name = binding_name, linkage_name = binding_c, ty = next_ty, value = next_call, line = 0, source_path = ""))
        let null_lit = alloc_expr(ir.Expr.expr_null_literal(ty = next_ty))
        let is_null = alloc_expr(ir.Expr.expr_binary(operator = "==", left = item_ref, right = null_lit, ty = ctx.bool_ty))
        loop_body.push(ir.Stmt.stmt_if(condition = is_null, then_body = break_body.as_span(), else_body = Option[span[ir.Stmt]].none))
    else:
        let ready_c = fresh_c_temp_name(ctx, "for_ready")
        let ready_ref = alloc_expr(ir.Expr.expr_name(name = ready_c, ty = ctx.bool_ty, pointer = Option[bool].some(value = false)))
        loop_body.push(ir.Stmt.stmt_local(name = ready_c, linkage_name = ready_c, ty = ctx.bool_ty, value = next_call, line = 0, source_path = ""))
        let not_ready = alloc_expr(ir.Expr.expr_unary(operator = "not", operand = ready_ref, ty = ctx.bool_ty))
        loop_body.push(ir.Stmt.stmt_if(condition = not_ready, then_body = break_body.as_span(), else_body = Option[span[ir.Stmt]].none))
        loop_body.push(ir.Stmt.stmt_local(name = binding_name, linkage_name = binding_c, ty = cur_ty, value = cur_call, line = 0, source_path = ""))

    var bi: ptr_uint = 0
    while bi < body_span.len:
        unsafe:
            loop_body.push(read(body_span.data + bi))
        bi += 1
    if contains_label_target(loop_body.as_span(), cl):
        loop_body.push(ir.Stmt.stmt_label(name = cl))

    var block_stmts = vec.Vec[ir.Stmt].create()
    block_stmts.push(ir.Stmt.stmt_local(name = it_c, linkage_name = it_c, ty = iter_ty, value = iter_call, line = 0, source_path = ""))
    let true_lit = alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = ctx.bool_ty))
    block_stmts.push(ir.Stmt.stmt_while(condition = true_lit, body = loop_body.as_span()))
    if contains_label_target(loop_body.as_span(), bl):
        block_stmts.push(ir.Stmt.stmt_label(name = bl))
    output.push(ir.Stmt.stmt_block(body = block_stmts.as_span()))

    ctx.loop_break_label = saved_break
    ctx.loop_continue_label = saved_continue
    ctx.loop_continue_native = saved_continue_native
    ctx.loop_break_native = saved_break_native
    ctx.loop_defer_depth = saved_loop_depth


function array_length_of(t: types.Type) -> long:
    match t:
        types.Type.ty_generic as g:
            if g.args.len == 2:
                unsafe:
                    match read(g.args.data + 1):
                        types.Type.ty_literal_int as lit:
                            return lit.value
                        _:
                            pass
        _:
            pass
    return 0


## Lower `array[T, N].as_span()` to a `span[T]` aggregate literal
## `{ data = &arr[0], len = N }`, mirroring Ruby's `lower_array_to_span_expression`.
function lower_array_as_span(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], array_ty: types.Type) -> ptr[ir.Expr]:
    let elem_ty = generic_first_arg(array_ty)
    let ptr_uint_ty = types.primitive("ptr_uint")
    # Recover the length from the array type; if it lost its literal length
    # (a const/var reference whose recorded type dropped the count), resolve it
    # from the declaration's type annotation.
    var length = array_length_of(array_ty)
    if length == 0:
        length = const_array_length(ctx, receiver)
    let recv = lower_expr(ctx, receiver)
    let zero_index = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty))
    # The host's `lower_array_to_span_expression` uses a plain `IR::Index` for
    # the decay's `&array[0]` (an unchecked element pointer, not a runtime
    # subscript).
    let elem0 = alloc_expr(ir.Expr.expr_index(receiver = recv, index = zero_index, ty = elem_ty))
    let data_ptr = alloc_expr(ir.Expr.expr_address_of(
        expression = elem0,
        ty = types.Type.ty_generic(name = "ptr", args = sp_type(elem_ty)),
    ))
    let len_expr = alloc_expr(ir.Expr.expr_integer_literal(value = length, ty = ptr_uint_ty))
    var fields = vec.Vec[ir.AggregateField].create()
    fields.push(ir.AggregateField(name = "data", value = data_ptr))
    fields.push(ir.AggregateField(name = "len", value = len_expr))
    let span_ty = types.Type.ty_generic(name = "span", args = sp_type(elem_ty))
    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = span_ty, fields = fields.as_span()))


## Lower `simd[E, N].with(lane, value)` to the host's `IR::SimdLaneWith` node:
## the index takes `int` as its expected type and the value the lane's element
## type (`lower_simd_lane_with`).
function lower_simd_with_call(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], simd_ty: types.Type, args: span[ast.Argument]) -> ptr[ir.Expr]:
    let elem_ty = types.simd_element_type(simd_ty)
    let src = lower_expr(ctx, receiver)
    let index_ast = unsafe: read(args.data + 0).arg_value
    var index_ir = lower_expr(ctx, index_ast)
    index_ir = literal_value_to_context_type(ctx, index_ast, types.primitive("int"), index_ir)
    let value_ast = unsafe: read(args.data + 1).arg_value
    var value_ir = lower_expr(ctx, value_ast)
    value_ir = literal_value_to_context_type(ctx, value_ast, elem_ty, value_ir)
    return alloc_expr(ir.Expr.expr_simd_lane_with(src = src, index = index_ir, value = value_ir, ty = simd_ty))


## Lower `.with(x = val, ...)` to an aggregate literal copy with specified
## fields replaced.  Mirrors Ruby's :struct_with lowering.
function lower_with_call(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], recv_ty: types.Type, args: span[ast.Argument]) -> ptr[ir.Expr]:
    let recv = lower_expr(ctx, receiver)
    let name = nominal_type_name(recv_ty)
    var field_names = vec.Vec[str].create()
    var field_types = vec.Vec[types.Type].create()
    if is_vec_math_name(name):
        vec_math_fields(name, ref_of(field_names), ref_of(field_types))
    else:
        var struct_name = name
        if struct_name.len == 0:
            match recv_ty:
                types.Type.ty_named as n:
                    struct_name = n.name
                types.Type.ty_imported as im:
                    struct_name = im.name
                _:
                    pass
        if struct_name.len > 0:
            if ctx.analysis.structs.contains(struct_name):
                let fields_ptr = ctx.analysis.structs.get(struct_name) else:
                    fatal(c"lower_with_call: struct not found")
                let entries = unsafe: read(fields_ptr)
                var ei: ptr_uint = 0
                while ei < entries.len:
                    let entry = unsafe: read(entries.data + ei)
                    field_names.push(entry.name)
                    field_types.push(entry.ty)
                    ei += 1
            else:
                var import_values = ctx.analysis.imports.values()
                var found = false
                while not found:
                    let target_ptr = import_values.next() else:
                        break
                    let target_module = unsafe: read(target_ptr)
                    match find_imported_analysis(ctx, target_module):
                        Option.some as imported:
                            if imported.value.structs.contains(struct_name):
                                let ifields_ptr = imported.value.structs.get(struct_name) else:
                                    break
                                let ientries = unsafe: read(ifields_ptr)
                                var iei: ptr_uint = 0
                                while iei < ientries.len:
                                    let ientry = unsafe: read(ientries.data + iei)
                                    field_names.push(ientry.name)
                                    field_types.push(ientry.ty)
                                    iei += 1
                                found = true
                        Option.none:
                            pass
    if field_names.len() == 0:
        fatal(c"lower_with_call: cannot determine fields for type")
    var arg_map = map_mod.Map[str, ptr[ir.Expr]].create()
    var ai: ptr_uint = 0
    while ai < args.len:
        var a: ast.Argument
        unsafe:
            a = read(args.data + ai)
        let aname = a.arg_name else:
            fatal(c"lower_with_call: named arguments required")
        var arg_val = lower_expr(ctx, a.arg_value)
        # A literal argument takes the replaced field's type (`v.with(x = 10.0)`
        # on a double field is a double literal), the host's contextual
        # aggregate-field lowering.
        var fti: ptr_uint = 0
        while fti < field_names.len():
            let fn2 = field_names.get(fti) else:
                break
            let ft2 = field_types.get(fti) else:
                break
            if unsafe: read(fn2) == aname:
                arg_val = literal_value_to_context_type(ctx, a.arg_value, unsafe: read(ft2), arg_val)
                break
            fti += 1
        arg_map.set(aname, arg_val)
        ai += 1
    var fields = vec.Vec[ir.AggregateField].create()
    var fi: ptr_uint = 0
    while fi < field_names.len():
        let fn_ptr = field_names.get(fi) else:
            break
        let ft_ptr = field_types.get(fi) else:
            break
        let fname = unsafe: read(fn_ptr)
        let ftype = unsafe: read(ft_ptr)
        let fval_ptr = arg_map.get(fname)
        var fval: ptr[ir.Expr]
        if fval_ptr != null:
            fval = unsafe: read(fval_ptr)
        else:
            fval = alloc_expr(ir.Expr.expr_member(receiver = recv, member = fname, ty = ftype))
        fields.push(ir.AggregateField(name = fname, value = fval))
        fi += 1
    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = recv_ty, fields = fields.as_span()))


## Recover the declared length of a const/var array referenced by `receiver` by
## resolving its declaration's type annotation.  Returns 0 when the receiver is
## not a module-level const/var array identifier.
function const_array_length(ctx: ref[LowerCtx], receiver: ptr[ast.Expr]) -> long:
    var name: str
    unsafe:
        match read(receiver):
            ast.Expr.expr_identifier as id:
                name = id.name
            _:
                return 0
    var di: ptr_uint = 0
    while di < ctx.analysis.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(ctx.analysis.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_const as c:
                if c.name == name:
                    return array_length_of(resolve_type_ref(ctx, c.const_type))
            _:
                pass
        di += 1
    return 0


# =============================================================================
#  Parallel / detach / gather lowering
# =============================================================================

# =============================================================================
#  Parallel / detach / gather lowering
# =============================================================================

## Host parity for the parallel constructs (`loops.rb`):
## `@parallel_for_counter` is a single per-module counter shared by
## `parallel for` (`_pfor_`), `parallel:` (`_spawn_`) and `detach`
## (`_detach_`), incremented once per construct (not per worker).  The
## generated identifiers are `<module_prefix>_<kind>_<N>` with the construct
## prefix in front (`mt_pfor_cap_`, `mt_pfor_work_`, ...).
var parallel_cnt: ptr_uint = 0


function parallel_uid(ctx: ref[LowerCtx], kind: str) -> str:
    var buf = string.String.create()
    buf.append(naming.module_c_prefix(ctx.module_name))
    buf.append("_")
    buf.append(kind)
    buf.append("_")
    fmt.append_ptr_uint(ref_of(buf), parallel_cnt)
    return buf.as_str()


function pfor_element_type(t: types.Type) -> types.Type:
    match t:
        types.Type.ty_generic as g:
            if g.args.len > 0:
                return unsafe: read(g.args.data + 0)
            return types.Type.ty_error
        _:
            return types.Type.ty_error


function pfor_ptr_type(t: types.Type) -> types.Type:
    return types.Type.ty_generic(name = "ptr", args = sp_type(t))


## Find the LocalBinding for a name in ctx.locals, if it exists.
function find_local(ctx: ref[LowerCtx], name: str) -> Option[LocalBinding]:
    var li: ptr_uint = ctx.locals.len()
    while li > 0:
        li -= 1
        let lb_ptr = ctx.locals.get(li) else:
            fatal(c"find_local: missing local")
        let item = unsafe: read(lb_ptr)
        if item.name == name:
            return Option[LocalBinding].some(value = item)
    return Option[LocalBinding].none


function pfor_capture_name(c: ir.Expr) -> str:
    match c:
        ir.Expr.expr_name as nm:
            return nm.name
        _:
            return ""


## First-occurrence-ordered collected names: the capture order is observable
## (struct fields and aggregate literals), and a hash map does not preserve it.
struct PforNames:
    names: vec.Vec[ir.Expr]
    seen: map_mod.Map[str, bool]


## The host's `collect_pfor_ir_names_expr` (`loops.rb:1055`): names reachable
## from a lowered expression, first occurrence winning.
function collect_pfor_ir_names_expr(ep: ir.Expr, result: ref[PforNames]) -> void:
    match ep:
        ir.Expr.expr_name as nm:
            if not result.seen.contains(nm.name):
                result.seen.set(nm.name, true)
                result.names.push(ep)
        ir.Expr.expr_member as m:
            collect_pfor_ir_names_expr(unsafe: read(m.receiver), result)
        ir.Expr.expr_index as ix:
            collect_pfor_ir_names_expr(unsafe: read(ix.receiver), result)
            collect_pfor_ir_names_expr(unsafe: read(ix.index), result)
        ir.Expr.expr_checked_index as ix:
            collect_pfor_ir_names_expr(unsafe: read(ix.receiver), result)
            collect_pfor_ir_names_expr(unsafe: read(ix.index), result)
        ir.Expr.expr_checked_span_index as ix:
            collect_pfor_ir_names_expr(unsafe: read(ix.receiver), result)
            collect_pfor_ir_names_expr(unsafe: read(ix.index), result)
        ir.Expr.expr_nullable_index as ix:
            collect_pfor_ir_names_expr(unsafe: read(ix.receiver), result)
            collect_pfor_ir_names_expr(unsafe: read(ix.index), result)
        ir.Expr.expr_nullable_span_index as ix:
            collect_pfor_ir_names_expr(unsafe: read(ix.receiver), result)
            collect_pfor_ir_names_expr(unsafe: read(ix.index), result)
        ir.Expr.expr_call as call:
            var ai: ptr_uint = 0
            while ai < call.arguments.len:
                collect_pfor_ir_names_expr(unsafe: read(call.arguments.data + ai), result)
                ai += 1
        ir.Expr.expr_call_indirect as call:
            collect_pfor_ir_names_expr(unsafe: read(call.callee), result)
            var cai: ptr_uint = 0
            while cai < call.arguments.len:
                collect_pfor_ir_names_expr(unsafe: read(call.arguments.data + cai), result)
                cai += 1
        ir.Expr.expr_binary as b:
            collect_pfor_ir_names_expr(unsafe: read(b.left), result)
            collect_pfor_ir_names_expr(unsafe: read(b.right), result)
        ir.Expr.expr_unary as u:
            collect_pfor_ir_names_expr(unsafe: read(u.operand), result)
        ir.Expr.expr_cast as c:
            collect_pfor_ir_names_expr(unsafe: read(c.expression), result)
        ir.Expr.expr_address_of as ao:
            collect_pfor_ir_names_expr(unsafe: read(ao.expression), result)
        ir.Expr.expr_conditional as cond:
            collect_pfor_ir_names_expr(unsafe: read(cond.condition), result)
            collect_pfor_ir_names_expr(unsafe: read(cond.then_expression), result)
            collect_pfor_ir_names_expr(unsafe: read(cond.else_expression), result)
        ir.Expr.expr_aggregate_literal as al:
            var al_i: ptr_uint = 0
            while al_i < al.fields.len:
                collect_pfor_ir_names_expr(unsafe: read(unsafe: read(al.fields.data + al_i).value), result)
                al_i += 1
        ir.Expr.expr_array_literal as al:
            var ali: ptr_uint = 0
            while ali < al.elements.len:
                collect_pfor_ir_names_expr(unsafe: read(al.elements.data + ali), result)
                ali += 1
        ir.Expr.expr_reinterpret as r:
            collect_pfor_ir_names_expr(unsafe: read(r.expression), result)
        _:
            pass


function collect_pfor_ir_names_span(stmts: span[ir.Stmt], result: ref[PforNames]) -> void:
    var si: ptr_uint = 0
    while si < stmts.len:
        collect_pfor_ir_names_stmt(unsafe: read(stmts.data + si), result)
        si += 1


function collect_pfor_ir_names_stmt(s: ir.Stmt, result: ref[PforNames]) -> void:
    match s:
        ir.Stmt.stmt_local as loc:
            collect_pfor_ir_names_expr(unsafe: read(loc.value), result)
        ir.Stmt.stmt_assignment as asg:
            collect_pfor_ir_names_expr(unsafe: read(asg.target), result)
            collect_pfor_ir_names_expr(unsafe: read(asg.value), result)
        ir.Stmt.stmt_expression as ex:
            collect_pfor_ir_names_expr(unsafe: read(ex.expression), result)
        ir.Stmt.stmt_return as ret:
            let value = ret.value
            if value != null:
                collect_pfor_ir_names_expr(unsafe: read(unsafe: ptr[ir.Expr]<-value), result)
        ir.Stmt.stmt_if as iff:
            collect_pfor_ir_names_expr(unsafe: read(iff.condition), result)
            collect_pfor_ir_names_span(iff.then_body, result)
            match iff.else_body:
                Option.some as eb:
                    collect_pfor_ir_names_span(eb.value, result)
                Option.none:
                    pass
        ir.Stmt.stmt_while as w:
            collect_pfor_ir_names_expr(unsafe: read(w.condition), result)
            collect_pfor_ir_names_span(w.body, result)
        ir.Stmt.stmt_for as f:
            collect_pfor_ir_names_stmt(unsafe: read(f.init), result)
            collect_pfor_ir_names_expr(unsafe: read(f.condition), result)
            unsafe:
                match read(f.post):
                    ir.Stmt.stmt_assignment:
                        collect_pfor_ir_names_stmt(unsafe: read(f.post), result)
                    ir.Stmt.stmt_expression:
                        collect_pfor_ir_names_stmt(unsafe: read(f.post), result)
                    _:
                        pass
            collect_pfor_ir_names_span(f.body, result)
        ir.Stmt.stmt_block as blk:
            collect_pfor_ir_names_span(blk.body, result)
        ir.Stmt.stmt_switch as sw:
            collect_pfor_ir_names_expr(unsafe: read(sw.expression), result)
            var ci: ptr_uint = 0
            while ci < sw.cases.len:
                let c = unsafe: read(sw.cases.data + ci)
                collect_pfor_ir_names_span(c.body, result)
                ci += 1
        _:
            pass


## The host's `collect_pfor_local_decls` (`loops.rb:1089`): linkage names of
## every local declaration in the body, which are never captures.
function collect_pfor_local_decls(stmt: ir.Stmt, decls: ref[map_mod.Map[str, bool]]) -> void:
    match stmt:
        ir.Stmt.stmt_local as loc:
            decls.set(loc.linkage_name, true)
        ir.Stmt.stmt_for as f:
            unsafe:
                match read(f.init):
                    ir.Stmt.stmt_local as init:
                        decls.set(init.linkage_name, true)
                    _:
                        pass
            collect_pfor_local_decls_span(f.body, decls)
        ir.Stmt.stmt_block as blk:
            collect_pfor_local_decls_span(blk.body, decls)
        ir.Stmt.stmt_if as iff:
            collect_pfor_local_decls_span(iff.then_body, decls)
            match iff.else_body:
                Option.some as eb:
                    collect_pfor_local_decls_span(eb.value, decls)
                Option.none:
                    pass
        ir.Stmt.stmt_while as w:
            collect_pfor_local_decls_span(w.body, decls)
        ir.Stmt.stmt_switch as sw:
            var ci: ptr_uint = 0
            while ci < sw.cases.len:
                let c = unsafe: read(sw.cases.data + ci)
                collect_pfor_local_decls_span(c.body, decls)
                ci += 1
        _:
            pass


function collect_pfor_local_decls_span(stmts: span[ir.Stmt], decls: ref[map_mod.Map[str, bool]]) -> void:
    var si: ptr_uint = 0
    while si < stmts.len:
        collect_pfor_local_decls(unsafe: read(stmts.data + si), decls)
        si += 1


## The base name of an assignment target, for the parallel-block write set
## (the host's `pfor_assignment_base_name`, `loops.rb:901`).
function pfor_assignment_base_name(expr: ir.Expr) -> str:
    match expr:
        ir.Expr.expr_name as nm:
            return nm.name
        ir.Expr.expr_member as m:
            return pfor_assignment_base_name(unsafe: read(m.receiver))
        ir.Expr.expr_index as ix:
            return pfor_assignment_base_name(unsafe: read(ix.receiver))
        ir.Expr.expr_checked_index as ix:
            return pfor_assignment_base_name(unsafe: read(ix.receiver))
        ir.Expr.expr_checked_span_index as ix:
            return pfor_assignment_base_name(unsafe: read(ix.receiver))
        ir.Expr.expr_nullable_index as ix:
            return pfor_assignment_base_name(unsafe: read(ix.receiver))
        ir.Expr.expr_nullable_span_index as ix:
            return pfor_assignment_base_name(unsafe: read(ix.receiver))
        ir.Expr.expr_address_of as ao:
            return pfor_assignment_base_name(unsafe: read(ao.expression))
        _:
            return ""


function collect_pfor_written_names(stmts: span[ir.Stmt], capture_names: ref[map_mod.Map[str, bool]], written: ref[map_mod.Map[str, bool]]) -> void:
    var si: ptr_uint = 0
    while si < stmts.len:
        collect_pfor_written_stmt(unsafe: read(stmts.data + si), capture_names, written)
        si += 1


function collect_pfor_written_stmt(stmt: ir.Stmt, capture_names: ref[map_mod.Map[str, bool]], written: ref[map_mod.Map[str, bool]]) -> void:
    match stmt:
        ir.Stmt.stmt_assignment as asg:
            let base = pfor_assignment_base_name(unsafe: read(asg.target))
            if base.len > 0 and capture_names.contains(base):
                written.set(base, true)
        ir.Stmt.stmt_if as iff:
            collect_pfor_written_names(iff.then_body, capture_names, written)
            match iff.else_body:
                Option.some as eb:
                    collect_pfor_written_names(eb.value, capture_names, written)
                Option.none:
                    pass
        ir.Stmt.stmt_while as w:
            collect_pfor_written_names(w.body, capture_names, written)
        ir.Stmt.stmt_for as f:
            collect_pfor_written_names(f.body, capture_names, written)
        ir.Stmt.stmt_block as blk:
            collect_pfor_written_names(blk.body, capture_names, written)
        ir.Stmt.stmt_switch as sw:
            var ci: ptr_uint = 0
            while ci < sw.cases.len:
                let c = unsafe: read(sw.cases.data + ci)
                collect_pfor_written_names(c.body, capture_names, written)
                ci += 1
        _:
            pass


## Rewrite the array captures of a parallel body to their pointer fields (the
## host's `rewrite_pfor_array_captures`, `loops.rb:916`).  An array value is
## not safe to copy into a capture struct, so the struct holds `ptr[E]` and a
## checked index through the array becomes a plain pointer index.
function rewrite_pfor_array_captures(stmts: span[ir.Stmt], array_names: ref[map_mod.Map[str, bool]]) -> span[ir.Stmt]:
    var rewritten = vec.Vec[ir.Stmt].create()
    var si: ptr_uint = 0
    while si < stmts.len:
        rewritten.push(rewrite_pfor_stmt(unsafe: read(stmts.data + si), array_names))
        si += 1
    return rewritten.as_span()


function rewrite_pfor_stmt(stmt: ir.Stmt, array_names: ref[map_mod.Map[str, bool]]) -> ir.Stmt:
    match stmt:
        ir.Stmt.stmt_assignment as asg:
            return ir.Stmt.stmt_assignment(
                target = alloc_expr(rewrite_pfor_expr(unsafe: read(asg.target), array_names)),
                operator = asg.operator,
                value = alloc_expr(rewrite_pfor_expr(unsafe: read(asg.value), array_names)),
            )
        ir.Stmt.stmt_local as loc:
            return ir.Stmt.stmt_local(
                name = loc.name, linkage_name = loc.linkage_name, ty = loc.ty,
                value = alloc_expr(rewrite_pfor_expr(unsafe: read(loc.value), array_names)),
                line = loc.line, source_path = loc.source_path,
            )
        ir.Stmt.stmt_expression as ex:
            return ir.Stmt.stmt_expression(
                expression = alloc_expr(rewrite_pfor_expr(unsafe: read(ex.expression), array_names)),
                line = ex.line, source_path = ex.source_path,
            )
        ir.Stmt.stmt_if as iff:
            var else_body = Option[span[ir.Stmt]].none
            match iff.else_body:
                Option.some as eb:
                    else_body = Option[span[ir.Stmt]].some(value = rewrite_pfor_array_captures(eb.value, array_names))
                Option.none:
                    pass
            return ir.Stmt.stmt_if(
                condition = alloc_expr(rewrite_pfor_expr(unsafe: read(iff.condition), array_names)),
                then_body = rewrite_pfor_array_captures(iff.then_body, array_names),
                else_body = else_body,
            )
        ir.Stmt.stmt_for as f:
            return ir.Stmt.stmt_for(
                init = alloc_stmt(rewrite_pfor_stmt(unsafe: read(f.init), array_names)),
                condition = alloc_expr(rewrite_pfor_expr(unsafe: read(f.condition), array_names)),
                post = alloc_stmt(rewrite_pfor_stmt(unsafe: read(f.post), array_names)),
                body = rewrite_pfor_array_captures(f.body, array_names),
            )
        ir.Stmt.stmt_while as w:
            return ir.Stmt.stmt_while(
                condition = alloc_expr(rewrite_pfor_expr(unsafe: read(w.condition), array_names)),
                body = rewrite_pfor_array_captures(w.body, array_names),
            )
        ir.Stmt.stmt_block as blk:
            return ir.Stmt.stmt_block(body = rewrite_pfor_array_captures(blk.body, array_names))
        ir.Stmt.stmt_switch as sw:
            var cases = vec.Vec[ir.SwitchCase].create()
            var ci: ptr_uint = 0
            while ci < sw.cases.len:
                let c = unsafe: read(sw.cases.data + ci)
                cases.push(ir.SwitchCase(is_default = c.is_default, value = c.value, body = rewrite_pfor_array_captures(c.body, array_names)))
                ci += 1
            return ir.Stmt.stmt_switch(
                expression = alloc_expr(rewrite_pfor_expr(unsafe: read(sw.expression), array_names)),
                cases = cases.as_span(), exhaustive = sw.exhaustive,
            )
        ir.Stmt.stmt_return as ret:
            let value = ret.value
            if value == null:
                return stmt
            return ir.Stmt.stmt_return(
                value = alloc_expr(rewrite_pfor_expr(unsafe: read(unsafe: ptr[ir.Expr]<-value), array_names)),
                line = ret.line, source_path = ret.source_path,
            )
        _:
            return stmt


function rewrite_pfor_expr(expr: ir.Expr, array_names: ref[map_mod.Map[str, bool]]) -> ir.Expr:
    match expr:
        ir.Expr.expr_checked_index as ci:
            match unsafe: read(ci.receiver):
                ir.Expr.expr_address_of as ao:
                    match unsafe: read(ao.expression):
                        ir.Expr.expr_name as nm:
                            if array_names.contains(nm.name):
                                var ptr_ty = nm.ty
                                if is_array_type(nm.ty):
                                    ptr_ty = pfor_ptr_type(pfor_element_type(nm.ty))
                                return ir.Expr.expr_index(
                                    receiver = alloc_expr(ir.Expr.expr_name(name = nm.name, ty = ptr_ty, pointer = Option[bool].some(value = false))),
                                    index = alloc_expr(rewrite_pfor_expr(unsafe: read(ci.index), array_names)),
                                    ty = ci.ty,
                                )
                        _:
                            pass
                ir.Expr.expr_name as nm:
                    if array_names.contains(nm.name):
                        var ptr_ty = ci.receiver_type
                        if is_array_type(ci.receiver_type):
                            ptr_ty = pfor_ptr_type(pfor_element_type(ci.receiver_type))
                        return ir.Expr.expr_index(
                            receiver = alloc_expr(ir.Expr.expr_name(name = nm.name, ty = ptr_ty, pointer = Option[bool].some(value = false))),
                            index = alloc_expr(rewrite_pfor_expr(unsafe: read(ci.index), array_names)),
                            ty = ci.ty,
                        )
                _:
                    pass
            return expr
        ir.Expr.expr_binary as b:
            return ir.Expr.expr_binary(
                operator = b.operator,
                left = alloc_expr(rewrite_pfor_expr(unsafe: read(b.left), array_names)),
                right = alloc_expr(rewrite_pfor_expr(unsafe: read(b.right), array_names)),
                ty = b.ty,
            )
        ir.Expr.expr_unary as u:
            return ir.Expr.expr_unary(
                operator = u.operator,
                operand = alloc_expr(rewrite_pfor_expr(unsafe: read(u.operand), array_names)),
                ty = u.ty,
            )
        ir.Expr.expr_cast as c:
            return ir.Expr.expr_cast(
                target_type = c.target_type,
                expression = alloc_expr(rewrite_pfor_expr(unsafe: read(c.expression), array_names)),
                ty = c.ty,
            )
        ir.Expr.expr_call as call:
            var args = vec.Vec[ir.Expr].create()
            var ai: ptr_uint = 0
            while ai < call.arguments.len:
                args.push(rewrite_pfor_expr(unsafe: read(call.arguments.data + ai), array_names))
                ai += 1
            return ir.Expr.expr_call(callee = call.callee, arguments = args.as_span(), ty = call.ty)
        ir.Expr.expr_call_indirect as call:
            var args = vec.Vec[ir.Expr].create()
            var cai: ptr_uint = 0
            while cai < call.arguments.len:
                args.push(rewrite_pfor_expr(unsafe: read(call.arguments.data + cai), array_names))
                cai += 1
            return ir.Expr.expr_call_indirect(
                callee = alloc_expr(rewrite_pfor_expr(unsafe: read(call.callee), array_names)),
                arguments = args.as_span(), ty = call.ty,
            )
        ir.Expr.expr_address_of as ao:
            return ir.Expr.expr_address_of(
                expression = alloc_expr(rewrite_pfor_expr(unsafe: read(ao.expression), array_names)),
                ty = ao.ty,
            )
        ir.Expr.expr_conditional as cond:
            return ir.Expr.expr_conditional(
                condition = alloc_expr(rewrite_pfor_expr(unsafe: read(cond.condition), array_names)),
                then_expression = alloc_expr(rewrite_pfor_expr(unsafe: read(cond.then_expression), array_names)),
                else_expression = alloc_expr(rewrite_pfor_expr(unsafe: read(cond.else_expression), array_names)),
                ty = cond.ty,
            )
        ir.Expr.expr_member as m:
            return ir.Expr.expr_member(
                receiver = alloc_expr(rewrite_pfor_expr(unsafe: read(m.receiver), array_names)),
                member = m.member, ty = m.ty,
            )
        ir.Expr.expr_index as ix:
            return ir.Expr.expr_index(
                receiver = alloc_expr(rewrite_pfor_expr(unsafe: read(ix.receiver), array_names)),
                index = alloc_expr(rewrite_pfor_expr(unsafe: read(ix.index), array_names)),
                ty = ix.ty,
            )
        ir.Expr.expr_aggregate_literal as al:
            var fields = vec.Vec[ir.AggregateField].create()
            var fi: ptr_uint = 0
            while fi < al.fields.len:
                let f = unsafe: read(al.fields.data + fi)
                fields.push(ir.AggregateField(name = f.name, value = alloc_expr(rewrite_pfor_expr(unsafe: read(f.value), array_names))))
                fi += 1
            return ir.Expr.expr_aggregate_literal(ty = al.ty, fields = fields.as_span())
        _:
            return expr


function validate_pfor_no_ref_captures(captures: span[ir.Expr]) -> void:
    var ci: ptr_uint = 0
    while ci < captures.len:
        match unsafe: read(captures.data + ci):
            ir.Expr.expr_name as nm:
                if types.is_ref_type(nm.ty):
                    fatal(j3("cannot capture '", nm.name, "' of type ref across thread boundary — ref values are not safe to share across threads"))
            _:
                pass
        ci += 1


## Lower `parallel for i in 0..N: body` (the host's `lower_threaded_for_stmt`,
## `loops.rb:445`): a worker receives `(data, start, end)`, unpacks the capture
## struct, and runs the induction loop.
function lower_parallel_for(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], bindings: span[ast.ForBinding], iterables: span[ast.Expr], body: ptr[ast.Stmt]?) -> void:
    if bindings.len == 0 or iterables.len == 0:
        return
    var start_ptr: ptr[ast.Expr]
    var end_ptr: ptr[ast.Expr]
    unsafe:
        match read(iterables.data + 0):
            ast.Expr.expr_range as rng:
                start_ptr = rng.start_expr
                end_ptr = rng.end_expr
            _:
                fatal(c"lowering parallel for: only range iteration is supported")
    let bd = body else:
        return
    var index_name: str
    unsafe:
        index_name = read(bindings.data + 0).name
    let index_c = utils.c_local_name(index_name)
    # The host's `infer_range_loop_type`: an integer-literal bound takes the
    # other bound's type.
    var loop_type = expr_type(ctx, start_ptr)
    var stop_ty = expr_type(ctx, end_ptr)
    if not types.type_equals(loop_type, stop_ty):
        if ast_is_integer_literal(start_ptr) and types.is_integer_type(stop_ty):
            loop_type = stop_ty
        else if ast_is_integer_literal(end_ptr) and types.is_integer_type(loop_type):
            stop_ty = loop_type
    if types.is_error(loop_type):
        loop_type = types.primitive("int")
    let long_ty = types.primitive("long")

    # Both bounds are prepared before the stop value is lowered
    # (`prepare_expression_for_inline_lowering` on start, then stop).
    let start_saved = begin_stmt_setup(ctx, ctx.hoist_mode)
    let _start_value = lower_expr(ctx, start_ptr)
    let start_collected = collect_stmt_setup(ctx, start_saved)
    let stop_saved = begin_stmt_setup(ctx, ctx.hoist_mode)
    let lowered_stop = int_literal_to_context_type(end_ptr, loop_type, lower_expr(ctx, end_ptr))
    let stop_collected = collect_stmt_setup(ctx, stop_saved)

    let saved_locals_len = ctx.locals.len()
    ctx.locals.push(LocalBinding(name = index_name, c_name = index_c, ty = loop_type, pointer = Option[bool].some(value = false)))
    let body_span = lower_block(ctx, bd)
    while ctx.locals.len() > saved_locals_len:
        let _popped = ctx.locals.pop()
    var body_ir = vec.Vec[ir.Stmt].create()
    append_span_stmts(ref_of(body_ir), body_span)

    # Captures: every name in the body minus the body's own locals and the
    # induction variable.
    var all_names = PforNames(names = vec.Vec[ir.Expr].create(), seen = map_mod.Map[str, bool].create())
    collect_pfor_ir_names_span(body_ir.as_span(), ref_of(all_names))
    var local_decls = map_mod.Map[str, bool].create()
    collect_pfor_local_decls_span(body_ir.as_span(), ref_of(local_decls))
    local_decls.set(index_c, true)
    var captures = vec.Vec[ir.Expr].create()
    var ni: ptr_uint = 0
    while ni < all_names.names.len():
        let np = all_names.names.get(ni) else:
            break
        let c = unsafe: read(np)
        if not local_decls.contains(pfor_capture_name(c)):
            captures.push(c)
        ni += 1
    validate_pfor_no_ref_captures(captures.as_span())

    parallel_cnt += 1
    let uid = parallel_uid(ctx, "pfor")
    let cap_name = j2("mt_pfor_cap_", uid)
    let worker_name = j2("mt_pfor_work_", uid)

    var array_capture_names = map_mod.Map[str, bool].create()
    var cap_fields = vec.Vec[ir.Field].create()
    var ci: ptr_uint = 0
    while ci < captures.len():
        let cp = captures.get(ci) else:
            break
        match unsafe: read(cp):
            ir.Expr.expr_name as nm:
                if is_array_type(nm.ty):
                    array_capture_names.set(nm.name, true)
                    cap_fields.push(ir.Field(name = nm.name, ty = pfor_ptr_type(pfor_element_type(nm.ty))))
                else:
                    cap_fields.push(ir.Field(name = nm.name, ty = nm.ty))
            _:
                pass
        ci += 1
    ctx.pending_synthetic_structs.push(ir.StructDecl(name = cap_name, linkage_name = cap_name, fields = cap_fields.as_span(), packed = false, alignment = 0, source_module = Option[str].none))

    let cap_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = cap_name)
    let cap_ptr_ty = pfor_ptr_type(cap_ty)
    let void_ptr = void_ptr_ty()
    var worker_body = vec.Vec[ir.Stmt].create()
    worker_body.push(ir.Stmt.stmt_local(
        name = "mt_cap", linkage_name = "mt_cap", ty = cap_ptr_ty,
        value = alloc_expr(ir.Expr.expr_cast(
            target_type = cap_ptr_ty,
            expression = alloc_expr(ir.Expr.expr_name(name = "mt_pfor_data", ty = void_ptr, pointer = Option[bool].some(value = false))),
            ty = cap_ptr_ty,
        )),
        line = 0, source_path = "",
    ))
    let cap_ref = alloc_expr(ir.Expr.expr_name(name = "mt_cap", ty = cap_ptr_ty, pointer = Option[bool].some(value = true)))
    ci = 0
    while ci < captures.len():
        let cp = captures.get(ci) else:
            break
        match unsafe: read(cp):
            ir.Expr.expr_name as nm:
                var alias_ty = nm.ty
                if is_array_type(nm.ty):
                    alias_ty = pfor_ptr_type(pfor_element_type(nm.ty))
                worker_body.push(ir.Stmt.stmt_local(
                    name = nm.name, linkage_name = nm.name, ty = alias_ty,
                    value = alloc_expr(ir.Expr.expr_member(receiver = cap_ref, member = nm.name, ty = alias_ty)),
                    line = 0, source_path = "",
                ))
            _:
                pass
        ci += 1
    var rewritten_body = body_ir.as_span()
    if array_capture_names.len() > 0:
        rewritten_body = rewrite_pfor_array_captures(body_ir.as_span(), ref_of(array_capture_names))
    let index_ref = alloc_expr(ir.Expr.expr_name(name = index_c, ty = loop_type, pointer = Option[bool].some(value = false)))
    let start_ref = alloc_expr(ir.Expr.expr_name(name = "mt_pfor_start", ty = long_ty, pointer = Option[bool].some(value = false)))
    let end_ref = alloc_expr(ir.Expr.expr_name(name = "mt_pfor_end", ty = long_ty, pointer = Option[bool].some(value = false)))
    let condition = alloc_expr(ir.Expr.expr_binary(operator = "<", left = index_ref, right = end_ref, ty = ctx.bool_ty))
    let post = alloc_stmt(ir.Stmt.stmt_assignment(
        target = alloc_expr(ir.Expr.expr_name(name = index_c, ty = loop_type, pointer = Option[bool].some(value = false))),
        operator = "+=",
        value = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = loop_type)),
    ))
    let init = alloc_stmt(ir.Stmt.stmt_local(name = index_c, linkage_name = index_c, ty = loop_type, value = start_ref, line = 0, source_path = ""))
    worker_body.push(ir.Stmt.stmt_for(init = init, condition = condition, post = post, body = rewritten_body))

    var worker_params = vec.Vec[ir.Param].create()
    worker_params.push(ir.Param(name = "mt_pfor_data", linkage_name = "mt_pfor_data", ty = void_ptr, pointer = Option[bool].some(value = false)))
    worker_params.push(ir.Param(name = "mt_pfor_start", linkage_name = "mt_pfor_start", ty = long_ty, pointer = Option[bool].some(value = false)))
    worker_params.push(ir.Param(name = "mt_pfor_end", linkage_name = "mt_pfor_end", ty = long_ty, pointer = Option[bool].some(value = false)))
    let worker = ir.Function(
        name = worker_name, linkage_name = worker_name,
        params = worker_params.as_span(), return_type = ctx.void_ty,
        body = worker_body.as_span(), entry_point = false, public_export = false, method_receiver_param = false,
    )
    ctx.pending_synthetic_functions.push(worker)

    var call_site = vec.Vec[ir.Stmt].create()
    append_span_stmts(ref_of(call_site), start_collected.stmts.as_span())
    append_span_stmts(ref_of(call_site), stop_collected.stmts.as_span())
    var cap_fields_out = vec.Vec[ir.AggregateField].create()
    ci = 0
    while ci < captures.len():
        let cp = captures.get(ci) else:
            break
        match unsafe: read(cp):
            ir.Expr.expr_name as nm:
                if array_capture_names.contains(nm.name):
                    cap_fields_out.push(ir.AggregateField(
                        name = nm.name,
                        value = alloc_expr(ir.Expr.expr_name(name = nm.name, ty = pfor_ptr_type(pfor_element_type(nm.ty)), pointer = Option[bool].some(value = false))),
                    ))
                else:
                    cap_fields_out.push(ir.AggregateField(name = nm.name, value = unsafe: cp))
            _:
                pass
        ci += 1
    let cap_init = alloc_expr(ir.Expr.expr_aggregate_literal(ty = cap_ty, fields = cap_fields_out.as_span()))
    call_site.push(ir.Stmt.stmt_local(name = "mt_pfor_cap", linkage_name = "mt_pfor_cap", ty = cap_ty, value = cap_init, line = 0, source_path = ""))
    let fn_ty = types.Type.ty_function(params = span[types.Type](), return_type = types.alloc_type(ctx.void_ty), variadic = false, is_proc = false, param_names = span[str](), name = "")
    var call_args = vec.Vec[ir.Expr].create()
    unsafe: call_args.push(read(alloc_expr(ir.Expr.expr_name(name = worker_name, ty = fn_ty, pointer = Option[bool].some(value = false)))))
    unsafe: call_args.push(read(alloc_expr(ir.Expr.expr_address_of(
        expression = alloc_expr(ir.Expr.expr_name(name = "mt_pfor_cap", ty = cap_ty, pointer = Option[bool].some(value = false))),
        ty = void_ptr,
    ))))
    unsafe: call_args.push(read(lowered_stop))
    call_site.push(ir.Stmt.stmt_expression(
        expression = alloc_expr(ir.Expr.expr_call(callee = "mt_parallel_for", arguments = call_args.as_span(), ty = ctx.void_ty)),
        line = 0, source_path = "",
    ))
    output.push(ir.Stmt.stmt_block(body = call_site.as_span()))


struct SpawnBlockInfo:
    worker_name: str
    cap_local_name: str
    cap_ty: types.Type
    cap_init: ptr[ir.Expr]
    capture_names: vec.Vec[str]
    written_names: vec.Vec[str]
    written_scalars: vec.Vec[ir.Expr]
    captureless: bool


## Lower `parallel: stmt1; stmt2; ...` (the host's
## `lower_parallel_block_stmt`, `loops.rb:603`): one worker and one capture
## struct per body, dispatched through an `mt_spawn_item` array.
function lower_parallel_block(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], bodies: span[ast.Stmt]) -> void:
    if bodies.len < 2:
        return
    let void_ty = ctx.void_ty
    let void_ptr = void_ptr_ty()
    parallel_cnt += 1
    let uid_base = parallel_uid(ctx, "spawn")

    var infos = vec.Vec[SpawnBlockInfo].create()
    var bi: ptr_uint = 0
    while bi < bodies.len:
        let body_ir = lower_block(ctx, unsafe: ptr[ast.Stmt]<-(bodies.data + bi))
        var all_names = PforNames(names = vec.Vec[ir.Expr].create(), seen = map_mod.Map[str, bool].create())
        collect_pfor_ir_names_span(body_ir, ref_of(all_names))
        var local_decls = map_mod.Map[str, bool].create()
        collect_pfor_local_decls_span(body_ir, ref_of(local_decls))
        var captures = vec.Vec[ir.Expr].create()
        var ni: ptr_uint = 0
        while ni < all_names.names.len():
            let np = all_names.names.get(ni) else:
                break
            let c = unsafe: read(np)
            if not local_decls.contains(pfor_capture_name(c)):
                captures.push(c)
            ni += 1
        validate_pfor_no_ref_captures(captures.as_span())
        var capture_names_map = map_mod.Map[str, bool].create()
        var capture_names = vec.Vec[str].create()
        var ci: ptr_uint = 0
        while ci < captures.len():
            let cp = captures.get(ci) else:
                break
            let nm = pfor_capture_name(unsafe: read(cp))
            capture_names.push(nm)
            capture_names_map.set(nm, true)
            ci += 1
        var written_map = map_mod.Map[str, bool].create()
        collect_pfor_written_names(body_ir, ref_of(capture_names_map), ref_of(written_map))
        var written_names = vec.Vec[str].create()
        var written_scalars = vec.Vec[ir.Expr].create()
        ci = 0
        while ci < captures.len():
            let cp = captures.get(ci) else:
                break
            let c = unsafe: read(cp)
            let nm = pfor_capture_name(c)
            if written_map.contains(nm):
                written_names.push(nm)
                match c:
                    ir.Expr.expr_name as cn:
                        if not is_array_type(cn.ty):
                            written_scalars.push(c)
                    _:
                        pass
            ci += 1
        let captureless = captures.len() == 0
        let cap_name = j3("mt_spawn_cap_", uid_base, j2("_", pw1_str(bi)))
        let worker_name = j3("mt_spawn_work_", uid_base, j2("_", pw1_str(bi)))
        var cap_ty = void_ptr
        var cap_init = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = void_ptr))
        var worker_body = vec.Vec[ir.Stmt].create()
        if captureless:
            append_span_stmts(ref_of(worker_body), body_ir)
        else:
            var array_capture_names = map_mod.Map[str, bool].create()
            var cap_fields = vec.Vec[ir.Field].create()
            ci = 0
            while ci < captures.len():
                let cp = captures.get(ci) else:
                    break
                match unsafe: read(cp):
                    ir.Expr.expr_name as nm:
                        if is_array_type(nm.ty):
                            array_capture_names.set(nm.name, true)
                            cap_fields.push(ir.Field(name = nm.name, ty = pfor_ptr_type(pfor_element_type(nm.ty))))
                        else:
                            cap_fields.push(ir.Field(name = nm.name, ty = nm.ty))
                    _:
                        pass
                ci += 1
            ctx.pending_synthetic_structs.push(ir.StructDecl(name = cap_name, linkage_name = cap_name, fields = cap_fields.as_span(), packed = false, alignment = 0, source_module = Option[str].none))
            cap_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = cap_name)
            let cap_ptr_ty = pfor_ptr_type(cap_ty)
            worker_body.push(ir.Stmt.stmt_local(
                name = "mt_cap", linkage_name = "mt_cap", ty = cap_ptr_ty,
                value = alloc_expr(ir.Expr.expr_cast(
                    target_type = cap_ptr_ty,
                    expression = alloc_expr(ir.Expr.expr_name(name = "mt_pfor_data", ty = void_ptr, pointer = Option[bool].some(value = false))),
                    ty = cap_ptr_ty,
                )),
                line = 0, source_path = "",
            ))
            let cap_ref = alloc_expr(ir.Expr.expr_name(name = "mt_cap", ty = cap_ptr_ty, pointer = Option[bool].some(value = true)))
            ci = 0
            while ci < captures.len():
                let cp = captures.get(ci) else:
                    break
                match unsafe: read(cp):
                    ir.Expr.expr_name as nm:
                        var alias_ty = nm.ty
                        if is_array_type(nm.ty):
                            alias_ty = pfor_ptr_type(pfor_element_type(nm.ty))
                        worker_body.push(ir.Stmt.stmt_local(
                            name = nm.name, linkage_name = nm.name, ty = alias_ty,
                            value = alloc_expr(ir.Expr.expr_member(receiver = cap_ref, member = nm.name, ty = alias_ty)),
                            line = 0, source_path = "",
                        ))
                    _:
                        pass
                ci += 1
            if array_capture_names.len() > 0:
                append_span_stmts(ref_of(worker_body), rewrite_pfor_array_captures(body_ir, ref_of(array_capture_names)))
            else:
                append_span_stmts(ref_of(worker_body), body_ir)
            # Write-back assignments for written scalar captures.
            var wsi: ptr_uint = 0
            while wsi < written_scalars.len():
                let wp = written_scalars.get(wsi) else:
                    break
                match unsafe: read(wp):
                    ir.Expr.expr_name as nm:
                        worker_body.push(ir.Stmt.stmt_assignment(
                            target = alloc_expr(ir.Expr.expr_member(receiver = cap_ref, member = nm.name, ty = nm.ty)),
                            operator = "=",
                            value = alloc_expr(ir.Expr.expr_name(name = nm.name, ty = nm.ty, pointer = Option[bool].some(value = false))),
                        ))
                    _:
                        pass
                wsi += 1
            var cap_fields_out = vec.Vec[ir.AggregateField].create()
            ci = 0
            while ci < captures.len():
                let cp = captures.get(ci) else:
                    break
                match unsafe: read(cp):
                    ir.Expr.expr_name as nm:
                        if array_capture_names.contains(nm.name):
                            cap_fields_out.push(ir.AggregateField(
                                name = nm.name,
                                value = alloc_expr(ir.Expr.expr_name(name = nm.name, ty = pfor_ptr_type(pfor_element_type(nm.ty)), pointer = Option[bool].some(value = false))),
                            ))
                        else:
                            cap_fields_out.push(ir.AggregateField(name = nm.name, value = unsafe: cp))
                    _:
                        pass
                ci += 1
            cap_init = alloc_expr(ir.Expr.expr_aggregate_literal(ty = cap_ty, fields = cap_fields_out.as_span()))
        var worker_params = vec.Vec[ir.Param].create()
        worker_params.push(ir.Param(name = "mt_pfor_data", linkage_name = "mt_pfor_data", ty = void_ptr, pointer = Option[bool].some(value = false)))
        let worker = ir.Function(
            name = worker_name, linkage_name = worker_name,
            params = worker_params.as_span(), return_type = void_ty,
            body = worker_body.as_span(), entry_point = false, public_export = false, method_receiver_param = false,
        )
        ctx.pending_synthetic_functions.push(worker)
        infos.push(SpawnBlockInfo(
            worker_name = worker_name,
            cap_local_name = j2("mt_spawn_cap_", pw1_str(bi)),
            cap_ty = cap_ty,
            cap_init = cap_init,
            capture_names = capture_names,
            written_names = written_names,
            written_scalars = written_scalars,
            captureless = captureless,
        ))
        bi += 1

    # Write-conflict validation: a name written by one body and captured by
    # another is a data race.
    var idx: ptr_uint = 0
    while idx < infos.len():
        let ip = infos.get(idx) else:
            break
        let info = unsafe: read(ip)
        var wi: ptr_uint = 0
        while wi < info.written_names.len():
            let wp = info.written_names.get(wi) else:
                break
            let name = unsafe: read(wp)
            var oi: ptr_uint = 0
            while oi < infos.len():
                if oi != idx:
                    let op = infos.get(oi) else:
                        break
                    let other = unsafe: read(op)
                    var ci2: ptr_uint = 0
                    while ci2 < other.capture_names.len():
                        let cp = other.capture_names.get(ci2) else:
                            break
                        if unsafe: read(cp) == name:
                            var msg = string.String.create()
                            msg.append("write conflict in parallel block: '")
                            msg.append(name)
                            msg.append("' is written in spawn block ")
                            fmt.append_ptr_uint(ref_of(msg), idx + 1)
                            msg.append(" and accessed in spawn block ")
                            fmt.append_ptr_uint(ref_of(msg), oi + 1)
                            fatal(msg.as_str())
                        ci2 += 1
                oi += 1
            wi += 1
        idx += 1

    let fn_ty = types.Type.ty_function(params = span[types.Type](), return_type = types.alloc_type(void_ty), variadic = false, is_proc = false, param_names = span[str](), name = "")
    let spawn_item_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = "mt_spawn_item")
    var call_site = vec.Vec[ir.Stmt].create()
    idx = 0
    while idx < infos.len():
        let ip = infos.get(idx) else:
            break
        let info = unsafe: read(ip)
        if not info.captureless:
            call_site.push(ir.Stmt.stmt_local(name = info.cap_local_name, linkage_name = info.cap_local_name, ty = info.cap_ty, value = info.cap_init, line = 0, source_path = ""))
        idx += 1
    let tasks_arr_ty = types.Type.ty_generic(name = "array", args = sp_type2(spawn_item_ty, types.literal_int(long<-bodies.len)))
    var elements = vec.Vec[ir.Expr].create()
    idx = 0
    while idx < infos.len():
        let ip = infos.get(idx) else:
            break
        let info = unsafe: read(ip)
        var data_expr = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = void_ptr))
        if not info.captureless:
            data_expr = alloc_expr(ir.Expr.expr_address_of(
                expression = alloc_expr(ir.Expr.expr_name(name = info.cap_local_name, ty = info.cap_ty, pointer = Option[bool].some(value = false))),
                ty = void_ptr,
            ))
        var fields = vec.Vec[ir.AggregateField].create()
        fields.push(ir.AggregateField(name = "work", value = alloc_expr(ir.Expr.expr_name(name = info.worker_name, ty = fn_ty, pointer = Option[bool].some(value = false)))))
        fields.push(ir.AggregateField(name = "data", value = data_expr))
        unsafe: elements.push(read(alloc_expr(ir.Expr.expr_aggregate_literal(ty = spawn_item_ty, fields = fields.as_span()))))
        idx += 1
    call_site.push(ir.Stmt.stmt_local(
        name = "mt_spawn_tasks", linkage_name = "mt_spawn_tasks", ty = tasks_arr_ty,
        value = alloc_expr(ir.Expr.expr_array_literal(ty = tasks_arr_ty, elements = elements.as_span())),
        line = 0, source_path = "",
    ))
    var spawn_args = vec.Vec[ir.Expr].create()
    unsafe: spawn_args.push(read(alloc_expr(ir.Expr.expr_name(name = "mt_spawn_tasks", ty = tasks_arr_ty, pointer = Option[bool].some(value = false)))))
    unsafe: spawn_args.push(read(alloc_expr(ir.Expr.expr_integer_literal(value = long<-bodies.len, ty = types.primitive("int")))))
    call_site.push(ir.Stmt.stmt_expression(
        expression = alloc_expr(ir.Expr.expr_call(callee = "mt_spawn_all", arguments = spawn_args.as_span(), ty = void_ty)),
        line = 0, source_path = "",
    ))
    # Written scalar captures flow back after the join.
    idx = 0
    while idx < infos.len():
        let ip = infos.get(idx) else:
            break
        let info = unsafe: read(ip)
        var wi: ptr_uint = 0
        while wi < info.written_scalars.len():
            let wp = info.written_scalars.get(wi) else:
                break
            match unsafe: read(wp):
                ir.Expr.expr_name as nm:
                    call_site.push(ir.Stmt.stmt_assignment(
                        target = alloc_expr(ir.Expr.expr_name(name = nm.name, ty = nm.ty, pointer = Option[bool].some(value = false))),
                        operator = "=",
                        value = alloc_expr(ir.Expr.expr_member(
                            receiver = alloc_expr(ir.Expr.expr_name(name = info.cap_local_name, ty = info.cap_ty, pointer = Option[bool].some(value = false))),
                            member = nm.name, ty = nm.ty,
                        )),
                    ))
                _:
                    pass
            wi += 1
        idx += 1
    output.push(ir.Stmt.stmt_block(body = call_site.as_span()))


function void_ptr_ty() -> types.Type:
    return types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))


function pw1_str(value: ptr_uint) -> str:
    var buf = string.String.create()
    fmt.append_ptr_uint(ref_of(buf), value)
    return buf.as_str()


## Lower `gather h1, h2, ...`.  Each handle is joined via mt_detach_join; the
## host wraps the joins in one block.
function lower_gather_stmt(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], handles: span[ast.Expr]) -> void:
    let void_ty = ctx.void_ty
    var joins = vec.Vec[ir.Stmt].create()
    var i: ptr_uint = 0
    while i < handles.len:
        let h = unsafe: lower_expr(ctx, handles.data + i)
        var join_args = vec.Vec[ir.Expr].create()
        unsafe:
            join_args.push(read(h))
        joins.push(ir.Stmt.stmt_expression(
            expression = alloc_expr(ir.Expr.expr_call(callee = "mt_detach_join", arguments = join_args.as_span(), ty = void_ty)),
            line = 0, source_path = "",
        ))
        i += 1
    output.push(ir.Stmt.stmt_block(body = joins.as_span()))


## Lower `detach <call>` (the host's `lower_detach_expr`, `loops.rb:810`).
## The call runs in a worker function; the expression yields an opaque Handle.
function lower_detach_expr(ctx: ref[LowerCtx], expression: ptr[ast.Expr], ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    # The call runs in a worker, so its setup must not hoist into the enclosing
    # statement's window.
    let hoist_saved = suspend_stmt_setup(ctx)
    let void_ty = ctx.void_ty
    let void_ptr = void_ptr_ty()
    parallel_cnt += 1
    let uid = parallel_uid(ctx, "detach")
    let worker_name = j2("mt_detach_work_", uid)
    let lowered_call = lower_expr(ctx, expression)
    var wb = vec.Vec[ir.Stmt].create()
    wb.push(ir.Stmt.stmt_expression(expression = lowered_call, line = 0, source_path = ctx.analysis.source_path))
    var all_names = PforNames(names = vec.Vec[ir.Expr].create(), seen = map_mod.Map[str, bool].create())
    collect_pfor_ir_names_span(wb.as_span(), ref_of(all_names))
    var local_decls = map_mod.Map[str, bool].create()
    collect_pfor_local_decls_span(wb.as_span(), ref_of(local_decls))
    var captures = vec.Vec[ir.Expr].create()
    var ni: ptr_uint = 0
    while ni < all_names.names.len():
        let np = all_names.names.get(ni) else:
            break
        let c = unsafe: read(np)
        if not local_decls.contains(pfor_capture_name(c)):
            captures.push(c)
        ni += 1
    validate_pfor_no_ref_captures(captures.as_span())
    if captures.len() > 0:
        fatal(c"detach with captured variables is not yet supported; use a global function call or module-level variables")
    var worker_params = vec.Vec[ir.Param].create()
    worker_params.push(ir.Param(name = "mt_pfor_data", linkage_name = "mt_pfor_data", ty = void_ptr, pointer = Option[bool].some(value = false)))
    let worker = ir.Function(
        name = worker_name, linkage_name = worker_name,
        params = worker_params.as_span(), return_type = void_ty,
        body = wb.as_span(), entry_point = false, public_export = false, method_receiver_param = false,
    )
    ctx.pending_synthetic_functions.push(worker)
    resume_stmt_setup(ctx, hoist_saved)
    let fn_ty = types.Type.ty_function(params = span[types.Type](), return_type = types.alloc_type(void_ty), variadic = false, is_proc = false, param_names = span[str](), name = "")
    var da = vec.Vec[ir.Expr].create()
    unsafe: da.push(read(alloc_expr(ir.Expr.expr_name(name = worker_name, ty = fn_ty, pointer = Option[bool].some(value = false)))))
    unsafe: da.push(read(alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = void_ptr))))
    return alloc_expr(ir.Expr.expr_call(callee = "mt_detach_run", arguments = da.as_span(), ty = void_ptr))


# =============================================================================
function fresh_c_temp_name(ctx: ref[LowerCtx], prefix: str) -> str:
    ctx.temp_counter += 1
    var buf = string.String.create()
    buf.append("__mt_")
    buf.append(prefix)
    buf.append("_")
    fmt.append_ptr_uint(ref_of(buf), ctx.temp_counter)
    return buf.as_str()


## The host's array-call materialization (`prepare_call_expression_for_inline_
## lowering`): a call whose value type is an array hoists into a
## `__mt_array_call_<N>` local in the statement's setup, and the expression
## reads the temp.  The three statement roots whose own type is an array
## (return/assignment/local) exempt their root call — the host passes
## `materialize_array_calls: !array_type?(<the statement's type>)` there.
function maybe_materialize_array_call(ctx: ref[LowerCtx], ep: ptr[ast.Expr], value: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let ty = ir_expr_type(value)
    if not is_array_type(ty):
        return value
    # Only a real function/method call materializes — the host's
    # `callee_type.return_type` test.  An intrinsic or constructor that lowers
    # to another node with an array type (`read(collection)` -> `IR::Unary`,
    # `array[T, N](…)` -> `IR::ArrayLiteral`, `zero[…]`/`default[…]`) keeps its
    # inline form.
    match unsafe: read(value):
        ir.Expr.expr_call:
            pass
        ir.Expr.expr_call_indirect:
            pass
        _:
            return value
    if ctx.hoist_mode == HoistMode.hm_off:
        return value
    if ctx.array_call_exempt == ep:
        return value
    let name = fresh_c_temp_name(ctx, "array_call")
    ctx.hoist_stmts.push(ir.Stmt.stmt_local(name = name, linkage_name = name, ty = ty, value = value, line = 0, source_path = ""))
    return alloc_expr(ir.Expr.expr_name(name = name, ty = ty, pointer = Option[bool].some(value = false)))


# =============================================================================
#  Expression lowering
# =============================================================================

## The host's prepared `and`/`or` shape
## (`prepare_binary_expression_for_inline_lowering`): when either operand's
## lowering produces setup statements, hoist a `__mt_and_N`/`__mt_or_N` result
## local, store the left value, and guard the right's setup + assignment with
## `if result` (and) or `if not result` (or).  With no setup on either side the
## plain binary is kept.
function lower_short_circuit_binary(
    ctx: ref[LowerCtx],
    operator: str,
    left_ep: ptr[ast.Expr],
    right_ep: ptr[ast.Expr],
    ep: ptr[ast.Expr],
) -> ptr[ir.Expr]:
    # The host's async normalizer rewrites every `and`/`or` in an async body —
    # setup or not — into a `__mt_async_tmp_N` var spilled to the frame:
    # `tmp = init; <left setup>; if left: <right setup>; tmp = right; else: tmp = init`.
    # The sync lowering keeps the prepared shape only when an operand produces
    # setup (below).
    if ctx.inside_async:
        let bool_ty = ctx.bool_ty
        # The host normalizer's declaration position: the and/or result temp is
        # declared before its operand setups, but its name is allocated after
        # them.  `async_hoist_awaits` recorded the field slot before recursing
        # into the operands; an unrecorded node starts at the current count.
        var field_index = async_local_field_count(ctx)
        let recorded_index = ctx.async_and_or_field_indices.get(unsafe: reinterpret[ptr_uint](ep))
        if recorded_index != null:
            field_index = unsafe: read(ptr[ptr_uint]<-recorded_index)
        let left_stored_ptr = ctx.async_and_or_left_setup.get(unsafe: reinterpret[ptr_uint](ep))
        let right_stored_ptr = ctx.async_and_or_right_setup.get(unsafe: reinterpret[ptr_uint](ep))
        # Lower both operands into child windows: their setup follows the temp
        # declaration, and their cleanups follow the enclosing statement (the
        # host's prepared binary shape).
        let left_saved = begin_stmt_setup(ctx, ctx.hoist_mode)
        if left_stored_ptr != null:
            var left_stored = unsafe: read(ptr[vec.Vec[ir.Stmt]]<-left_stored_ptr)
            append_span_stmts(ref_of(ctx.hoist_stmts), left_stored.as_span())
        let left = lower_expr(ctx, left_ep)
        let left_collected = collect_stmt_setup(ctx, left_saved)
        let right_saved = begin_stmt_setup(ctx, ctx.hoist_mode)
        if right_stored_ptr != null:
            var right_stored = unsafe: read(ptr[vec.Vec[ir.Stmt]]<-right_stored_ptr)
            append_span_stmts(ref_of(ctx.hoist_stmts), right_stored.as_span())
        # The right operand sees the left operand's refinement (the host's
        # `binary_right_env`, `resolve.rb:967`).
        var right_refs = lowering_flow_refinements(ctx, left_ep, operator == "and")
        let right_flow_saved = push_flow_refinements(ctx, ref_of(right_refs))
        let right = lower_expr(ctx, right_ep)
        restore_flow_refinements(ctx, right_flow_saved)
        let right_collected = collect_stmt_setup(ctx, right_saved)
        append_cleanup_stmts(ref_of(ctx.hoist_cleanups), left_collected.cleanups)
        append_cleanup_stmts(ref_of(ctx.hoist_cleanups), right_collected.cleanups)
        ctx.async_tmp_counter += 1
        let tmp = j2("__mt_async_tmp_", pw1_str(ctx.async_tmp_counter))
        let field_name = j2("local_", tmp)
        let frame_cname = j2("__mt_frame->", field_name)
        let field_count_before = async_local_field_count(ctx)
        async_register_unused_field(ctx, field_name, bool_ty)
        if async_local_field_count(ctx) > field_count_before:
            async_move_last_local_field_to(ctx, field_index)
        let short_circuit_value = operator != "and"
        # A CPS body spills the normalizer's LocalDecl to a frame field; the
        # no-await async path lowers it as a plain C local (the host's
        # `lower_async_cf_statements` vs `lower_async_non_await_statements`).
        # Both keep the frame field registered.
        var value_name = frame_cname
        if ctx.async_cps_active:
            let init_target = alloc_expr(ir.Expr.expr_member(receiver = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false))), member = field_name, ty = bool_ty))
            ctx.hoist_stmts.push(ir.Stmt.stmt_assignment(target = init_target, operator = "=", value = alloc_expr(ir.Expr.expr_boolean_literal(value = short_circuit_value, ty = bool_ty))))
        else:
            value_name = tmp
            ctx.hoist_stmts.push(ir.Stmt.stmt_local(name = tmp, linkage_name = tmp, ty = bool_ty, value = alloc_expr(ir.Expr.expr_boolean_literal(value = short_circuit_value, ty = bool_ty)), line = 0, source_path = ""))
        var left_stmts = left_collected.stmts
        append_span_stmts(ref_of(ctx.hoist_stmts), left_stmts.as_span())
        # `and`: left true -> value = right, left false -> value = false.
        # `or`:  left true -> value = true,  left false -> value = right.
        # The host swaps the two branch bodies for `or`
        # (`normalize_async_expression`'s BinaryOp arm).
        var right_stmts = vec.Vec[ir.Stmt].create()
        var ri: ptr_uint = 0
        while ri < right_collected.stmts.len:
            let stmt = right_collected.stmts.get(ri) else:
                break
            right_stmts.push(unsafe: read(stmt))
            ri += 1
        let right_target = alloc_expr(ir.Expr.expr_name(name = value_name, ty = bool_ty, pointer = Option[bool].some(value = false)))
        let short_target = alloc_expr(ir.Expr.expr_name(name = value_name, ty = bool_ty, pointer = Option[bool].some(value = false)))
        let right_assign = ir.Stmt.stmt_assignment(target = right_target, operator = "=", value = right)
        let short_assign = ir.Stmt.stmt_assignment(target = short_target, operator = "=", value = alloc_expr(ir.Expr.expr_boolean_literal(value = short_circuit_value, ty = bool_ty)))
        var then_body = vec.Vec[ir.Stmt].create()
        var else_body = vec.Vec[ir.Stmt].create()
        if operator == "and":
            append_span_stmts(ref_of(then_body), right_stmts.as_span())
            then_body.push(right_assign)
            else_body.push(short_assign)
        else:
            then_body.push(short_assign)
            append_span_stmts(ref_of(else_body), right_stmts.as_span())
            else_body.push(right_assign)
        ctx.hoist_stmts.push(ir.Stmt.stmt_if(condition = left, then_body = then_body.as_span(), else_body = Option[span[ir.Stmt]].some(value = else_body.as_span())))
        return alloc_expr(ir.Expr.expr_name(name = value_name, ty = bool_ty, pointer = Option[bool].some(value = false)))
    let setup_base = ctx.hoist_stmts.len
    let left = lower_expr(ctx, left_ep)
    let left_has_setup = ctx.hoist_stmts.len > setup_base
    let right_saved = begin_stmt_setup(ctx, ctx.hoist_mode)
    var right_refs = lowering_flow_refinements(ctx, left_ep, operator == "and")
    let right_flow_saved = push_flow_refinements(ctx, ref_of(right_refs))
    let right = lower_expr(ctx, right_ep)
    restore_flow_refinements(ctx, right_flow_saved)
    let right_collected = collect_stmt_setup(ctx, right_saved)
    let right_has_setup = right_collected.stmts.len > 0
    append_cleanup_stmts(ref_of(ctx.hoist_cleanups), right_collected.cleanups)
    if not left_has_setup and not right_has_setup:
        return alloc_expr(ir.Expr.expr_binary(operator = operator, left = left, right = right, ty = ctx.bool_ty))
    let result_c = fresh_c_temp_name(ctx, operator)
    let result_ty = ctx.bool_ty
    let result_ref = alloc_expr(ir.Expr.expr_name(name = result_c, ty = result_ty, pointer = Option[bool].some(value = false)))
    ctx.hoist_stmts.push(ir.Stmt.stmt_local(
        name = result_c,
        linkage_name = result_c,
        ty = result_ty,
        value = left,
        line = 0,
        source_path = "",
    ))
    let cond = if operator == "and":
        result_ref
    else:
        alloc_expr(ir.Expr.expr_unary(operator = "not", operand = result_ref, ty = result_ty))
    var then_body = vec.Vec[ir.Stmt].create()
    var ri: ptr_uint = 0
    while ri < right_collected.stmts.len:
        let stmt = right_collected.stmts.get(ri) else:
            break
        then_body.push(unsafe: read(stmt))
        ri += 1
    then_body.push(ir.Stmt.stmt_assignment(target = result_ref, operator = "=", value = right))
    ctx.hoist_stmts.push(ir.Stmt.stmt_if(condition = cond, then_body = then_body.as_span(), else_body = Option[span[ir.Stmt]].none))
    return alloc_expr(ir.Expr.expr_name(name = result_c, ty = result_ty, pointer = Option[bool].some(value = false)))


function lower_expr(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    unsafe:
        match read(ep):
            ast.Expr.expr_integer_literal as lit:
                return alloc_expr(ir.Expr.expr_integer_literal(value = long<-lit.value, ty = expr_type(ctx, ep)))
            ast.Expr.expr_float_literal as lit:
                return alloc_expr(ir.Expr.expr_float_literal(value = lit.value, ty = expr_type(ctx, ep)))
            ast.Expr.expr_char_literal as lit:
                return alloc_expr(ir.Expr.expr_integer_literal(value = long<-lit.value, ty = types.primitive("ubyte")))
            ast.Expr.expr_bool_literal as b:
                return alloc_expr(ir.Expr.expr_boolean_literal(value = b.value, ty = ctx.bool_ty))
            ast.Expr.expr_if as ie:
                let cond = lower_expr(ctx, ie.condition)
                let hoist_saved = suspend_stmt_setup(ctx)
                # Each branch sees the condition's truthy/falsy refinements (the
                # host's `then_env`/`else_env`, `expressions.rb:1101`).
                var then_refs = lowering_flow_refinements(ctx, ie.condition, true)
                let then_flow_saved = push_flow_refinements(ctx, ref_of(then_refs))
                var then_e = lower_expr(ctx, ie.then_expr)
                restore_flow_refinements(ctx, then_flow_saved)
                var else_refs = lowering_flow_refinements(ctx, ie.condition, false)
                let else_flow_saved = push_flow_refinements(ctx, ref_of(else_refs))
                var else_e = lower_expr(ctx, ie.else_expr)
                restore_flow_refinements(ctx, else_flow_saved)
                resume_stmt_setup(ctx, hoist_saved)
                # The conditional's type is the host's branch-common inference
                # (`conditional_common_type`), and each branch is lowered
                # contextually to it (`lower_contextual_expression`), so
                # `if flag: 0 else: <ptr_uint call>` emits `ptr_uint` literals.
                var ty = expr_type(ctx, ep)
                if types.is_error(ty) or types.type_to_string(ty) == "void":
                    ty = ir_expr_type(then_e)
                then_e = literal_value_to_context_type(ctx, ie.then_expr, ty, then_e)
                else_e = literal_value_to_context_type(ctx, ie.else_expr, ty, else_e)
                return alloc_expr(ir.Expr.expr_conditional(condition = cond, then_expression = then_e, else_expression = else_e, ty = ty))
            ast.Expr.expr_unsafe as u:
                return lower_expr(ctx, u.expression)
            ast.Expr.expr_string_literal as lit:
                let ty = if lit.is_cstring: types.primitive("cstr") else: types.Type.ty_str
                return alloc_expr(ir.Expr.expr_string_literal(value = lit.value, ty = ty, cstring = lit.is_cstring))
            ast.Expr.expr_identifier as id:
                # An inline foreign-mapping parameter bound to the argument's
                # value (the host's `replacements`) wins over the locals.
                let replacement = ctx.mapping_replacements.get(id.name)
                if replacement != null:
                    return unsafe: read(replacement)
                match lookup_local(ctx, id.name):
                    Option.some as lb:
                        return lower_binding_read(ctx, lb.value)
                    Option.none:
                        if ctx.function_returns.contains(id.name) or ctx.analysis.functions.contains(id.name):
                            let fn_c_name = naming.qualified_c_name(ctx.module_name, id.name)
                            var fn_ty = expr_type(ctx, ep)
                            match fn_ty:
                                types.Type.ty_function as fnt:
                                    # Only wrap in proc struct when the expected type
                                    # is a proc (is_proc == true).  For plain fn
                                    # fields, pass the function pointer directly.
                                    if fnt.is_proc:
                                        return lower_fn_to_proc(ctx, fn_c_name, fn_ty, "")
                                    # The analyzer records a bare function reference
                                    # with an empty type name (the contextual
                                    # field/signature form); the host's binding type
                                    # carries the function's own name (`fn <name>`).
                                    if fnt.name.len == 0:
                                        fn_ty = types.Type.ty_function(name = id.name, params = fnt.params, return_type = fnt.return_type, variadic = fnt.variadic, is_proc = false, param_names = fnt.param_names)
                                _:
                                    pass
                            return alloc_expr(ir.Expr.expr_name(name = fn_c_name, ty = fn_ty, pointer = Option[bool].some(value = false)))
                        if ctx.analysis.events.contains(id.name):
                            # The event's global is emitted under its
                            # module-qualified linkage name, and its read type is
                            # the event itself (`Types::Event`) — the host's
                            # binding carries `Types::Event`, not a plain named
                            # type.
                            var ev_info = ensure_event_runtime(ctx, "", id.name)
                            var ev_payload: ptr[types.Type]? = null
                            if ev_info.has_payload:
                                ev_payload = types.alloc_type(ev_info.payload_type)
                            let ev_ty = types.Type.ty_event(
                                name = id.name,
                                capacity = ev_info.capacity,
                                payload_type = ev_payload,
                                linkage_name = ev_info.event_c_name,
                            )
                            return alloc_expr(ir.Expr.expr_name(name = naming.qualified_c_name(ctx.module_name, id.name), ty = ev_ty, pointer = Option[bool].some(value = false)))
                        match lookup_qualified_constant(ctx, id.name):
                            Option.some as qc:
                                # A module-level value's read carries its *declared*
                                # storage type (the host's binding type), not the
                                # contextually-inferred type: stripping the
                                # `Nullable` here would let a guarded global read
                                # masquerade as non-null in the IR (the
                                # `opaque_backing_names` global).
                                var value_ty = expr_type(ctx, ep)
                                let declared_ty_ptr = ctx.analysis.value_types.get(id.name)
                                if declared_ty_ptr != null:
                                    value_ty = unsafe: read(declared_ty_ptr)
                                return alloc_expr(ir.Expr.expr_name(name = qc.value, ty = value_ty, pointer = Option[bool].some(value = false)))
                            Option.none:
                                pass
                        return alloc_expr(ir.Expr.expr_name(name = id.name, ty = expr_type(ctx, ep), pointer = Option[bool].some(value = false)))
            ast.Expr.expr_binary_op as bin:
                if (bin.operator == "and" or bin.operator == "or") and ctx.hoist_mode != HoistMode.hm_off:
                    return lower_short_circuit_binary(ctx, bin.operator, bin.left, bin.right, ep)
                var left = lower_expr(ctx, bin.left)
                var right: ptr[ir.Expr]
                if bin.operator == "and" or bin.operator == "or":
                    let hoist_saved = suspend_stmt_setup(ctx)
                    var right_refs = lowering_flow_refinements(ctx, bin.left, bin.operator == "and")
                    let right_flow_saved = push_flow_refinements(ctx, ref_of(right_refs))
                    right = lower_expr(ctx, bin.right)
                    restore_flow_refinements(ctx, right_flow_saved)
                    resume_stmt_setup(ctx, hoist_saved)
                else:
                    right = lower_expr(ctx, bin.right)
                # A bare `null` compared against a nullable value takes the other
                # operand's type — the host propagates the left operand's type as
                # the right operand's expected type — so `source == null` types
                # the literal `Nullable(ptr[ubyte])` rather than `void`.
                if bin.operator == "==" or bin.operator == "!=":
                    right = null_literal_to_context_type(bin.right, ir_expr_type(left), right)
                    left = null_literal_to_context_type(bin.left, ir_expr_type(right), left)
                # Struct equality on a raw-binding struct (`s_drag_body !=
                # b3.b3_nullBodyId`): the host keeps the `IR::Binary` and its C
                # backend synthesizes the `mt_struct_eq_<T>` helper from the
                # type's fields.  Raw modules lower no declarations, so register
                # the type's layout for the backend's helper synthesis.
                if bin.operator == "==" or bin.operator == "!=":
                    let eq_ty = ir_expr_type(left)
                    if is_equality_struct_type(ctx, eq_ty) and types.type_equals(eq_ty, ir_expr_type(right)) and register_external_struct_layout(ctx, eq_ty):
                        return alloc_expr(ir.Expr.expr_binary(operator = bin.operator, left = left, right = right, ty = ctx.bool_ty))
                # `str + str` concatenates into a thread-local scratch buffer.
                if bin.operator == "+" and is_str_typed(ir_expr_type(left)) and is_str_typed(ir_expr_type(right)):
                    var concat_args = vec.Vec[ir.Expr].create()
                    unsafe:
                        concat_args.push(read(left))
                        concat_args.push(read(right))
                    return alloc_expr(ir.Expr.expr_call(callee = "mt_str_concat", arguments = concat_args.as_span(), ty = types.Type.ty_str))
                var result_ty = expr_type(ctx, ep)
                # A comparison is always `bool` (the host's `infer_expression_type`
                # BinaryOp arm); the analyzer can miss it inside a constant
                # initializer (`not (glfwInit() != 0)`).
                if bin.operator == "==" or bin.operator == "!=" or bin.operator == "<" or bin.operator == "<=" or bin.operator == ">" or bin.operator == ">=":
                    result_ty = ctx.bool_ty
                # A simd arithmetic expression falls back to its left operand's
                # type (the host's BinaryOp inference chain has no Simd promotion
                # rule: `3.0 * a` is `float`, `a * 3.0` keeps the simd type); the
                # analyzer records the Simd operand's type instead.
                if types.is_simd_type(result_ty):
                    result_ty = ir_expr_type(left)
                # A recorded vec/mat/quat result whose operands lower as scalars
                # (field arithmetic such as `this.x - other.x`) is scalar in the
                # host's lowering inference: no vector rule matches the operands,
                # so `common_numeric_type` (else the left type) wins.
                if is_vec_math_name(nominal_type_name(result_ty)) and not (
                    is_vec_math_name(nominal_type_name(ir_expr_type(left))) or is_vec_math_name(nominal_type_name(ir_expr_type(right)))
                ):
                    match common_numeric_type(ir_expr_type(left), ir_expr_type(right)):
                        Option.some as common_ty:
                            result_ty = common_ty.value
                        Option.none:
                            result_ty = ir_expr_type(left)
                # Bitwise operators on one nominal type (`Flags.a | Flags.b`):
                # const initializers can miss the analyzer's type map, so the
                # host re-infers from the operands; equal operands give that type.
                if types.is_error(result_ty) and (bin.operator == "|" or bin.operator == "&" or bin.operator == "^"):
                    let blt = ir_expr_type(left)
                    let brt = ir_expr_type(right)
                    if not types.is_error(blt) and types.type_equals(blt, brt):
                        result_ty = blt
                # Vector/matrix/quaternion binary arithmetic: lower to
                # component-wise aggregate literal BEFORE type promotion, so
                # scalar operands are not cast to the vector result type.
                # Only apply when at least one operand is an actual vector type
                # (the analyzer may mis-type float sub-expressions as vec3
                # inside methods on vec types).
                let lt = ir_expr_type(left)
                let rt = ir_expr_type(right)
                let rn = nominal_type_name(result_ty)
                if is_vec_math_name(rn) and (
                    is_vec_math_name(nominal_type_name(lt)) or is_vec_math_name(nominal_type_name(rt))
                ) and (
                    bin.operator == "+" or bin.operator == "-" or bin.operator == "*" or bin.operator == "/"
                ):
                    return lower_vec_binary_op(ctx, bin.operator, left, right, result_ty, rn)
                # Pointer arithmetic (`p + i` / `p - i`) yields the pointer
                # operand's concrete type; the analyzer's generically-recorded
                # type may have dropped its arguments inside a monomorphized body.
                # A nullable operand contributes its *unwrapped* pointer: the
                # host's flow-refined operand type makes `blocks + i` on a
                # guard-bound `ptr[T]?` a `ptr[T]` (its `pointer_arithmetic_result`
                # returns the refined left type), and the C arithmetic runs on the
                # pointer either way — carrying the `Nullable` here overrode the
                # analyzer's refined result.
                if bin.operator == "+" or bin.operator == "-":
                    let left_ty = ir_expr_type(left)
                    if types.is_raw_pointer(left_ty) and not types.is_raw_pointer(ir_expr_type(right)):
                        result_ty = if types.is_nullable_type(left_ty): types.unwrap_nullable(left_ty) else: left_ty
                # Integer arithmetic where the analyzer's recorded type is not an
                # integer (e.g. `text.len - n`, where `.len` is typed `ptr_uint`
                # by lowering but the analyzer recorded a wrong type): trust the
                # lowered operand types when both are the same integer type.
                if is_arithmetic_operator(bin.operator) and not is_integer_scrutinee(result_ty):
                    let lt = ir_expr_type(left)
                    let rt = ir_expr_type(right)
                    if is_integer_scrutinee(lt) and types.type_to_string(lt) == types.type_to_string(rt):
                        result_ty = lt
                    # `<wider-int-expr> + <int literal>` (e.g. `ptr_uint + 2`): the
                    # analyzer recorded a non-integer result, and one operand is a
                    # plain `int` literal.  Adopt the other operand's wider integer
                    # type so the result matches the dominant operand.
                    else if is_integer_scrutinee(lt) and types.type_to_string(rt) == "int":
                        result_ty = lt
                    else if is_integer_scrutinee(rt) and types.type_to_string(lt) == "int":
                        result_ty = rt
                # Re-type an integer literal against the other operand's integer
                # type (e.g. `b == 0` where `b: ubyte`, `p + 1` where `p: ptr_uint`),
                # mirroring the host's `harmonize_binary_integer_literal_types`.
                # The literal is recognized *syntactically* — not by its inferred
                # type — because the inference itself follows the peer
                # (`std/noise.mt`'s `state * 6364136223846793005` types the
                # constant `ulong`, and a value > 2^31 is `long` on its own).
                let harm_lt = ir_expr_type(left)
                let harm_rt = ir_expr_type(right)
                # Pointer arithmetic: the host lowers the integer offset with the
                # pointer as its expected type, which falls back to the literal's
                # default `int` — an explicit `0z` suffix is ignored
                # (`paths + 0z` carries an `int` literal).
                if bin.operator == "+" or bin.operator == "-":
                    if (types.is_pointer_type(harm_lt) or types.is_ref_type(harm_lt)) and ast_is_integer_literal(bin.right):
                        right = int_literal_to_context_type(bin.right, types.primitive("int"), right)
                    else if (types.is_pointer_type(harm_rt) or types.is_ref_type(harm_rt)) and ast_is_integer_literal(bin.left):
                        left = int_literal_to_context_type(bin.left, types.primitive("int"), left)
                if types.is_integer_type(harm_rt):
                    let hl = int_literal_to_context_type(bin.left, harm_rt, left)
                    if hl != left:
                        left = hl
                    # The host lowers each binary operand with the peer's type
                    # as its expected type (`lower_expression(... expected_type:)`),
                    # so an `if` expression operand takes the peer's type on both
                    # branches (`(if c: 1 else: 0) != ptr_uint_value`).
                    left = conditional_value_to_context_type(ctx, bin.left, harm_rt, left)
                if types.is_integer_type(harm_lt):
                    let hr = int_literal_to_context_type(bin.right, harm_lt, right)
                    if hr != right:
                        right = hr
                    right = conditional_value_to_context_type(ctx, bin.right, harm_lt, right)
                # The same expected-type propagation for a float peer: an `if`
                # expression operand takes the peer's type on both branches
                # (`(if c: W else: H) / sqrtf(x)` casts each branch to float).
                if types.is_float_type(harm_rt):
                    left = conditional_value_to_context_type(ctx, bin.left, harm_rt, left)
                if types.is_float_type(harm_lt):
                    right = conditional_value_to_context_type(ctx, bin.right, harm_lt, right)
                # The recorded result type carries the host's propagated expected
                # type: a bare float literal in an arithmetic binary takes it,
                # so `next_double`'s `val / 4294967296.0` promotes both operands
                # to `double` (the analyzer's hint propagation records the
                # contextual type).  An explicit `f`/`d` suffix keeps its own
                # type.
                if is_pure_arithmetic_operator(bin.operator) and types.is_float_type(result_ty):
                    if is_bare_float_literal(bin.left) and not types.type_equals(ir_expr_type(left), result_ty):
                        left = float_literal_to_context_type(bin.left, result_ty, left)
                    if is_bare_float_literal(bin.right) and not types.type_equals(ir_expr_type(right), result_ty):
                        right = float_literal_to_context_type(bin.right, result_ty, right)
                # Re-type a *bare* float literal operand against a float peer
                # (`payload.value == 2.718…` with a `double` peer stays a double
                # literal — the host's contextual literal inference).  An explicit
                # `f`/`d` suffix keeps its own type and is cast by the promotion
                # below instead; without this the literal keeps its default
                # `float` type and the cast truncates it.
                let flt = ir_expr_type(left)
                let frt = ir_expr_type(right)
                if types.is_float_type(frt) and types.is_float_type(flt):
                    if is_bare_float_literal(bin.left):
                        left = float_literal_to_context_type(bin.left, frt, left)
                    if is_bare_float_literal(bin.right):
                        right = float_literal_to_context_type(bin.right, flt, right)
                # Balance mixed-width integer and int/float operands: cast the
                # narrower operand up to the common type, matching Ruby's
                # usual-arithmetic-conversion casts (redundant casts are elided
                # by the C backend).  For arithmetic operators the common type is
                # also the result type, which the analyzer may have under-widened.
                # Enum/flags operands unwrap to their integer backing first, so
                # enum comparisons cast to the backing type like Ruby.
                let bal_lt = enum_backing_or_self(ctx, ir_expr_type(left))
                let bal_rt = enum_backing_or_self(ctx, ir_expr_type(right))
                match promoted_binary_operand_type(bin.operator, bal_lt, bal_rt):
                    Option.some as op_ty:
                        left = cast_to_type(left, op_ty.value)
                        right = cast_to_type(right, op_ty.value)
                        if is_pure_arithmetic_operator(bin.operator):
                            result_ty = op_ty.value
                    Option.none:
                        pass
                return alloc_expr(ir.Expr.expr_binary(operator = bin.operator, left = left, right = right, ty = result_ty))
            ast.Expr.expr_unary_op as un:
                let operand = lower_expr(ctx, un.operand)
                let op_ty = ir_expr_type(operand)
                if un.operator == "-":
                    let vname = nominal_type_name(op_ty)
                    if is_vec_math_name(vname):
                        return lower_vec_unary_neg(ctx, operand, vname)
                # The host types a unary with its *operand's* lowered type
                # (`infer_expression_type`'s UnaryOp arm; `not` is bool), not the
                # analyzer's recorded expression type.
                let un_ty = if un.operator == "not": ctx.bool_ty else: op_ty
                return alloc_expr(ir.Expr.expr_unary(operator = un.operator, operand = operand, ty = un_ty))
            ast.Expr.expr_prefix_cast as pc:
                let target_ty = qualify_type(ctx, resolve_type_ref(ctx, pc.target_type))
                let lowered_expr = lower_expr(ctx, pc.expression)
                return alloc_expr(ir.Expr.expr_cast(target_type = target_ty, expression = lowered_expr, ty = target_ty))
            ast.Expr.expr_call as call:
                return maybe_materialize_array_call(ctx, ep, lower_call(ctx, call.callee, call.args, ep))
            ast.Expr.expr_member_access as ma:
                return lower_member_access(ctx, ma.receiver, ma.member_name, ep)
            ast.Expr.expr_index_access as ix:
                return lower_index_access(ctx, ix.receiver, ix.index, ep)
            ast.Expr.expr_expression_list as lst:
                return lower_tuple_literal_with_names(ctx, lst.elements)
            ast.Expr.expr_proc as pr:
                return lower_proc_expression(ctx, pr.method_params, pr.return_type, pr.body, ep)
            ast.Expr.expr_await as aw:
                let inner = lower_expr(ctx, aw.expression)
                return unwrap_task_value(inner)
            ast.Expr.expr_format_string as fs:
                # All-static format strings collapse to a plain literal.  A
                # dynamic one builds through the host's make/release protocol:
                # inside a statement's hoisting window the whole build hoists
                # into the statement stream and the result is released after the
                # statement (the host's `prepare_expression_with_cleanups`);
                # a lazily-evaluated region keeps the inline statement-expression
                # form, which cannot carry the post-statement release.
                if format_string_all_static(fs.parts):
                    return format_string_static_literal(fs.parts)
                if ctx.hoist_mode == HoistMode.hm_off:
                    var fmt_setup = vec.Vec[ir.Stmt].create()
                    let fmt_result = build_format_string_dynamic(ctx, fs.parts, ref_of(fmt_setup))
                    return alloc_expr(ir.Expr.expr_stmt_expr(setup = fmt_setup.as_span(), result = fmt_result, ty = types.Type.ty_str))
                let fmt_result = build_format_string_dynamic(ctx, fs.parts, ref_of(ctx.hoist_stmts))
                # The result temp owns its buffer and outlives the statement
                # (the host's `register_prepared_temp!(…, cstr_backed: true)`),
                # so a `str as cstr` boundary may pass its `data` directly.
                unsafe:
                    match read(fmt_result):
                        ir.Expr.expr_name as nm:
                            ctx.cstr_backed_names.set(nm.name, true)
                        _:
                            pass
                # Register the release here in every window; a return whose type
                # owns the buffer drops it (`filter_return_format_cleanups`), and
                # an assignment/local-target arm drops it through
                # `drop_format_release_cleanups`.
                ctx.hoist_cleanups.push(format_str_release_stmt(fmt_result))
                return fmt_result
            ast.Expr.expr_detach as dt:
                return lower_detach_expr(ctx, dt.expression, ep)
            ast.Expr.expr_specialization as spec:
                match read(spec.callee):
                    ast.Expr.expr_identifier as id:
                        if id.name == "zero" and spec.arguments.len == 1:
                            let z_ty = resolve_type_ref(ctx, read(spec.arguments.data + 0).value)
                            return alloc_expr(ir.Expr.expr_zero_init(ty = z_ty))
                        if id.name == "default" and spec.arguments.len == 1:
                            let t_ty = qualify_type(ctx, resolve_type_ref(ctx, read(spec.arguments.data + 0).value))
                            match resolve_method_info(ctx, t_ty, "default"):
                                Option.some as smi:
                                    if smi.value.method_kind == ast.MethodKind.mk_static:
                                        var empty_args = span[ast.Argument]()
                                        return lower_static_call_args(ctx, smi.value, empty_args)
                                Option.none:
                                    pass
                        # A generic function reference used as a value:
                        # `always_allow_transition[State, Event, Context]` passed
                        # as an `fn(...)` argument.  Monomorphize it explicitly and
                        # refer to the specialized C function.
                        match find_generic_function(ctx, id.name):
                            Option.some as vgm:
                                match vgm.value.decl:
                                    ast.Decl.decl_function as vfun:
                                        if vfun.type_params.len > 0 and vfun.type_params.len == spec.arguments.len:
                                            let vspec_key = specialization_key(ctx, vgm.value.module_name, id.name, spec.arguments)
                                            if not ctx.specialization_cache.contains(vspec_key) and not ctx.spec_in_progress.contains(vspec_key):
                                                # A function *reference* instantiates the
                                                # binding but the host analyzer does not
                                                # validate the referenced body (that is
                                                # the `infer_call` path's job), so its
                                                # nested calls are lowering-created.
                                                ctx.next_spec_body_validated = Option[bool].some(value = false)
                                                lower_and_cache_specialization(ctx, vgm.value, spec.arguments, vspec_key, ctx.pre_instantiated_context)
                                                ctx.next_spec_body_validated = Option[bool].none
                                            else:
                                                # A reference is not a call; an actual
                                                # call site elsewhere records the edge.
                                                pass
                                            var fn_ty = expr_type(ctx, ep)
                                            let vcached = ctx.specialization_cache.get(vspec_key)
                                            if vcached != null:
                                                let sf = unsafe: read(vcached)
                                                var ptypes = vec.Vec[types.Type].create()
                                                var pnames = vec.Vec[str].create()
                                                var vpi: ptr_uint = 0
                                                while vpi < sf.params.len:
                                                    unsafe:
                                                        ptypes.push(read(sf.params.data + vpi).ty)
                                                        pnames.push(read(sf.params.data + vpi).name)
                                                    vpi += 1
                                                fn_ty = types.Type.ty_function(name = id.name, params = ptypes.as_span(),
                                                    return_type = types.alloc_type(sf.return_type),
                                                    variadic = false,
                                                    is_proc = false,
                                                    param_names = pnames.as_span(),
                                                )
                                            return alloc_expr(ir.Expr.expr_name(name = vspec_key, ty = fn_ty, pointer = Option[bool].some(value = false)))
                                    _:
                                        pass
                            Option.none:
                                pass
                    _:
                        pass
                return alloc_expr(ir.Expr.expr_name(name = "spec", ty = types.Type.ty_error, pointer = Option[bool].some(value = false)))
            ast.Expr.expr_match as me:
                return lower_expression_match(ctx, me.scrutinee, me.arms, ep)
            ast.Expr.expr_range as rng:
                let start = lower_expr(ctx, rng.start_expr)
                return start
            ast.Expr.expr_null_literal as nl:
                let nl_target = nl.target_type
                if nl_target != null:
                    let target = resolve_type_ref(ctx, nl_target)
                    return alloc_expr(ir.Expr.expr_null_literal(ty = types.Type.ty_null(target = types.alloc_type(target))))
                return alloc_expr(ir.Expr.expr_null_literal(ty = ctx.void_ty))
            ast.Expr.expr_named as nm:
                return lower_expr(ctx, nm.value)
            ast.Expr.expr_sizeof as sz:
                return alloc_expr(ir.Expr.expr_sizeof(target_type = qualify_type(ctx, resolve_type_ref(ctx, sz.target_type)), ty = types.primitive("ptr_uint")))
            ast.Expr.expr_alignof as al:
                return alloc_expr(ir.Expr.expr_alignof(target_type = qualify_type(ctx, resolve_type_ref(ctx, al.target_type)), ty = types.primitive("ptr_uint")))
            ast.Expr.expr_offsetof as off:
                var field_name = off.field
                match ctx.inline_for_element:
                    Option.some as ce:
                        match ce.value:
                            ComptimeElement.ce_struct_field as sf:
                                field_name = sf.name
                            _:
                                pass
                    Option.none:
                        pass
                return alloc_expr(ir.Expr.expr_offsetof(
                    target_type = qualify_type(ctx, resolve_type_ref(ctx, off.target_type)),
                    field = field_name,
                    ty = types.primitive("ptr_uint"),
                ))
            ast.Expr.expr_error:
                return alloc_expr(ir.Expr.expr_null_literal(ty = ctx.void_ty))
            _:
                fatal(c"lowering: unsupported expression")


## Synthetic proc symbols: the host's `@synthetic_proc_counter`
## (`fresh_proc_symbol`, utils.rb:555) is per *compile* and shared by proc
## expressions (`block.rb:99`) and function-to-proc wrappers (`resolve.rb:62`),
## whose symbols are `<module_prefix>__proc_<N>__invoke/release/retain`.
var proc_counter: ptr_uint = 0


## Lower a proc expression `proc(x: int) -> int: x + 1` to a proc struct literal
## with invoke/release/retain function pointers and a capture env pointer.  No-
## capture procs use null env; capturing procs use a heap-allocated env struct
## with ref-counting.
function lower_proc_expression(ctx: ref[LowerCtx], method_params: span[ast.Param], return_type: ptr[ast.TypeRef]?, body_ptr: ptr[ast.Stmt], ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    let proc_ty = expr_type(ctx, ep)
    var ret_ty = ctx.void_ty
    if return_type != null:
        ret_ty = resolve_type_ref(ctx, return_type)
    return lower_proc_expression_typed(ctx, method_params, ret_ty, body_ptr, proc_ty)


## Materialize a prepared proc literal into its own `__mt_proc_expr_<N>` local in
## the enclosing statement's hoisting window — the host's
## `materialize_prepared_expression` (`setup` before the statement, the value a
## temp Name).  Without a window (a lazy region, where the host has no prepared
## position either) the literal stays inline.
function materialize_proc_literal(ctx: ref[LowerCtx], literal: ptr[ir.Expr], proc_ty: types.Type) -> ptr[ir.Expr]:
    if ctx.hoist_mode == HoistMode.hm_off:
        return literal
    let name = fresh_c_temp_name(ctx, "proc_expr")
    ctx.hoist_stmts.push(ir.Stmt.stmt_local(name = name, linkage_name = name, ty = proc_ty, value = literal, line = 0, source_path = ""))
    return alloc_expr(ir.Expr.expr_name(name = name, ty = proc_ty, pointer = Option[bool].some(value = false)))


## Lower a proc expression whose signature is already resolved: `ret_ty` is the
## invoke's C return type (the declared return type, or the proc type's own return
## type for synthesized procs) and `proc_ty` the proc's function type.
function lower_proc_expression_typed(ctx: ref[LowerCtx], method_params: span[ast.Param], ret_ty: types.Type, body_ptr: ptr[ast.Stmt], proc_ty: types.Type) -> ptr[ir.Expr]:
    return lower_proc_expression_typed_named(ctx, method_params, ret_ty, body_ptr, proc_ty, "")


## Like `lower_proc_expression_typed`, but `name_hint` seeds the env temp name
## (`__mt_<hint>_env_<N>`) and the returned literal is not materialized into a
## `__mt_proc_expr_N` local (the caller stores it in its own named local).  The
## host's `lower_proc_expression_for_local(..., local_name:)`.
function lower_proc_expression_typed_named(ctx: ref[LowerCtx], method_params: span[ast.Param], ret_ty: types.Type, body_ptr: ptr[ast.Stmt], proc_ty: types.Type, name_hint: str) -> ptr[ir.Expr]:
    # A proc body runs later, so its window is its own: suspend the enclosing
    # statement's hoisting while the synthetic invoke/release/retain functions
    # (and their bodies) are built.  The literal's own setup hoists into the
    # enclosing statement stream (the host's prepared-expression rule), so the
    # window is restored before emitting it.
    let hoist_saved = suspend_stmt_setup(ctx)
    proc_counter += 1
    let proc_id = proc_counter
    var id_buf = string.String.create()
    id_buf.append(naming.module_c_prefix(ctx.module_name))
    id_buf.append("__proc_")
    fmt.append_ptr_uint(ref_of(id_buf), proc_id)
    let proc_prefix = id_buf.as_str()

    # Captures are the body's referenced enclosing locals (the host's
    # first-reference-order walk), not every visible local.
    let captures = collect_proc_captures(ctx, method_params, body_ptr)
    let has_captures = captures.len > 0

    # The host's prepared-literal naming (`lower_proc_expression_for_local` plus
    # `materialize_prepared_expression`): the literal's base temp is requested
    # first (it seeds the env temp even when unused), then the env temp derived
    # from it, then the literal's own local.
    let local_name = if name_hint.len > 0: name_hint else: fresh_c_temp_name(ctx, "proc_expr")
    var env_decl_name = ""
    if has_captures:
        env_decl_name = fresh_c_temp_name(ctx, j2(local_name, "_env"))

    # Proc struct type: { env, invoke, release, retain }, named from the
    # signature (`naming.proc_type_c_name`, the host's `proc_type_name`) so that
    # proc-typed fields, params, and expressions all unify to one C struct.
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
    let shared_name = naming.proc_type_c_name(proc_ty)
    let struct_name = shared_name
    # Register the shared struct declaration (no-op if already emitted).
    let _proc_struct_ty = proc_ensure_struct_decl(ctx, struct_name, proc_ty)

    var struct_fields = vec.Vec[ir.Field].create()
    struct_fields.push(ir.Field(name = "env", ty = void_ptr))
    struct_fields.push(ir.Field(name = "invoke", ty = proc_invoke_field_type(proc_ty)))
    let lifecycle_ty = proc_lifecycle_fn_type()
    struct_fields.push(ir.Field(name = "release", ty = lifecycle_ty))
    struct_fields.push(ir.Field(name = "retain", ty = lifecycle_ty))
    ctx.pending_proc_structs.push(ir.StructDecl(name = struct_name, linkage_name = struct_name, fields = struct_fields.as_span(), packed = false, alignment = 0, source_module = Option[str].none))

    var invoke_c = string.String.create()
    invoke_c.append(proc_prefix)
    invoke_c.append("__invoke")
    var release_c = string.String.create()
    release_c.append(proc_prefix)
    release_c.append("__release")
    var retain_c = string.String.create()
    retain_c.append(proc_prefix)
    retain_c.append("__retain")

    let invoke_str = invoke_c.as_str()
    let release_str = release_c.as_str()
    let retain_str = retain_c.as_str()

    var env_value: ptr[ir.Expr]
    if has_captures:
        # Build capture-env struct: { __mt_ref_count, cap1, cap2, ... }.
        var env_struct_name = string.String.create()
        env_struct_name.append(proc_prefix)
        env_struct_name.append("__env")
        let env_type_name = env_struct_name.as_str()
        let uint_ty = types.primitive("ptr_uint")
        var env_fields = vec.Vec[ir.Field].create()
        env_fields.push(ir.Field(name = "__mt_ref_count", ty = uint_ty))
        var ci: ptr_uint = 0
        while ci < captures.len:
            let cap = unsafe: read(captures.data + ci)
            env_fields.push(ir.Field(name = cap.name, ty = cap.ty))
            ci += 1
        ctx.pending_synthetic_structs.push(ir.StructDecl(name = env_type_name, linkage_name = env_type_name, fields = env_fields.as_span(), packed = false, alignment = 0, source_module = Option[str].none))

        # Build capturing invoke: unpacks env→locals, then body.
        ctx.pending_synthetic_functions.push(build_capturing_invoke(ctx, method_params, ret_ty, body_ptr, invoke_str, env_type_name, captures))

        # Build release: decrement ref_count, free if zero.
        ctx.pending_synthetic_functions.push(build_capturing_release(ctx, release_str, env_type_name, captures))

        # Build retain: increment ref_count.
        ctx.pending_synthetic_functions.push(build_capturing_retain(retain_str, env_type_name))

        let env_named_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = env_type_name)
        let env_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(env_named_ty))
        # The window is the enclosing statement's again: the env setup hoists
        # before the statement (the host's inline shape), or falls back to the
        # separate setup function where no prepared position exists.
        resume_stmt_setup(ctx, hoist_saved)
        if ctx.hoist_mode != HoistMode.hm_off:
            let alloc_call = alloc_expr(ir.Expr.expr_call(callee = "mt_async_alloc", arguments = pack_single(alloc_expr(ir.Expr.expr_sizeof(target_type = env_named_ty, ty = uint_ty))), ty = void_ptr))
            ctx.hoist_stmts.push(ir.Stmt.stmt_local(name = env_decl_name, linkage_name = env_decl_name, ty = env_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = env_ptr_ty, expression = alloc_call, ty = env_ptr_ty)), line = 0, source_path = ""))
            let env_ref = alloc_expr(ir.Expr.expr_name(name = env_decl_name, ty = env_ptr_ty, pointer = Option[bool].some(value = false)))
            ctx.hoist_stmts.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_member(receiver = env_ref, member = "__mt_ref_count", ty = uint_ty)), operator = "=", value = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = uint_ty))))
            var si: ptr_uint = 0
            while si < captures.len:
                let cap = unsafe: read(captures.data + si)
                ctx.hoist_stmts.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_member(receiver = env_ref, member = cap.name, ty = cap.ty)), operator = "=", value = cap.read_expr))
                si += 1
            # A proc-storing capture is retained by the env, which outlives the
            # enclosing scope's releases (the host's `block.rb:146-151`).
            var cri: ptr_uint = 0
            while cri < captures.len:
                let cap = unsafe: read(captures.data + cri)
                if contains_proc_storage_type(ctx, cap.ty):
                    let member = alloc_expr(ir.Expr.expr_member(receiver = env_ref, member = cap.name, ty = cap.ty))
                    proc_contained_retain_stmts(ctx, member, cap.ty, ref_of(ctx.hoist_stmts))
                cri += 1
            env_value = alloc_expr(ir.Expr.expr_cast(target_type = void_ptr, expression = alloc_expr(ir.Expr.expr_name(name = env_decl_name, ty = env_ptr_ty, pointer = Option[bool].some(value = false))), ty = void_ptr))
        else:
            # Lazy region: no statement stream to hoist into.  Keep the separate
            # setup function (a recorded residue; the host has no such position).
            var setup_c = string.String.create()
            setup_c.append(proc_prefix)
            setup_c.append("__setup_env")
            ctx.pending_synthetic_functions.push(build_env_setup_fn(ctx, setup_c.as_str(), env_type_name, captures))
            var setup_args = vec.Vec[ir.Expr].create()
            var sai: ptr_uint = 0
            while sai < captures.len:
                let cap = unsafe: read(captures.data + sai)
                unsafe:
                    setup_args.push(read(cap.read_expr))
                sai += 1
            let setup_call = alloc_expr(ir.Expr.expr_call(callee = setup_c.as_str(), arguments = setup_args.as_span(), ty = env_ptr_ty))
            env_value = alloc_expr(ir.Expr.expr_cast(target_type = void_ptr, expression = setup_call, ty = void_ptr))
    else:
        # No-capture path.  The host's synthetic-function order is invoke,
        # release, retain (`block.rb:155-157`).
        ctx.pending_synthetic_functions.push(build_proc_invoke_fn(ctx, method_params, ret_ty, body_ptr, invoke_str))
        ctx.pending_synthetic_functions.push(build_proc_noop_fn(release_str))
        ctx.pending_synthetic_functions.push(build_proc_noop_fn(retain_str))
        resume_stmt_setup(ctx, hoist_saved)
        env_value = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr))

    var fields = vec.Vec[ir.AggregateField].create()
    fields.push(ir.AggregateField(name = "env", value = env_value))
    fields.push(ir.AggregateField(name = "invoke", value = alloc_expr(ir.Expr.expr_name(name = invoke_str, ty = proc_invoke_field_type(proc_ty), pointer = Option[bool].some(value = false)))))
    fields.push(ir.AggregateField(name = "release", value = alloc_expr(ir.Expr.expr_name(name = release_str, ty = lifecycle_ty, pointer = Option[bool].some(value = false)))))
    fields.push(ir.AggregateField(name = "retain", value = alloc_expr(ir.Expr.expr_name(name = retain_str, ty = lifecycle_ty, pointer = Option[bool].some(value = false)))))
    let literal = alloc_expr(ir.Expr.expr_aggregate_literal(ty = proc_ty, fields = fields.as_span()))
    if name_hint.len > 0:
        return literal
    return materialize_proc_literal(ctx, literal, proc_ty)


## Pack a single expression into a span.
function pack_single(expr: ptr[ir.Expr]) -> span[ir.Expr]:
    var buf = vec.Vec[ir.Expr].create()
    unsafe:
        buf.push(read(expr))
    return buf.as_span()


## Collect the proc body's free variables that resolve to enclosing locals — the
## host's `proc_capture_entries` walk (`proc.rb:137-250`): first-reference order,
## names bound inside the proc (its params, locals, `for` names, match bindings)
## shadow and are not captured, a name with no enclosing local (a module
## var/const/function) is not captured, and a nested proc's body is skipped
## (`AST::ProcExpr`).
function collect_proc_captures(ctx: ref[LowerCtx], method_params: span[ast.Param], body: ptr[ast.Stmt]?) -> span[ProcCapture]:
    var captures = vec.Vec[ProcCapture].create()
    var seen = map_mod.Map[str, bool].create()
    var scopes = vec.Vec[map_mod.Map[str, bool]].create()
    var param_scope = map_mod.Map[str, bool].create()
    var pi: ptr_uint = 0
    while pi < method_params.len:
        unsafe:
            param_scope.set(read(method_params.data + pi).name, true)
        pi += 1
    scopes.push(param_scope)
    proc_capture_visit_stmt(ctx, body, ref_of(scopes), ref_of(seen), ref_of(captures))
    return captures.as_span()


## True when `name` is bound in one of the proc's own scopes (innermost first).
function proc_capture_name_bound(scopes: ref[vec.Vec[map_mod.Map[str, bool]]], name: str) -> bool:
    var i = scopes.len()
    while i > 0:
        i -= 1
        let sc = scopes.get(i) else:
            continue
        if unsafe: read(sc).contains(name):
            return true
    return false


## Add `name` to the innermost proc scope (a no-op for the empty name of a
## destructuring declaration).
function proc_capture_scope_add(scopes: ref[vec.Vec[map_mod.Map[str, bool]]], name: str) -> void:
    if name == "":
        return
    let sc = scopes.get(scopes.len() - 1) else:
        return
    unsafe: read(sc).set(name, true)


## Visit a statement body in a fresh scope (the host's `local_scopes + [{}]` for
## if/loop/unsafe/defer bodies and match arms).
function proc_capture_visit_scope(ctx: ref[LowerCtx], body: ptr[ast.Stmt]?, scopes: ref[vec.Vec[map_mod.Map[str, bool]]], seen: ref[map_mod.Map[str, bool]], captures: ref[vec.Vec[ProcCapture]]) -> void:
    if body == null:
        return
    scopes.push(map_mod.Map[str, bool].create())
    proc_capture_visit_stmt(ctx, body, scopes, seen, captures)
    let _dropped = scopes.pop()


## Visit a statement list in place (same scope).
function proc_capture_visit_stmts(ctx: ref[LowerCtx], stmts: span[ast.Stmt], scopes: ref[vec.Vec[map_mod.Map[str, bool]]], seen: ref[map_mod.Map[str, bool]], captures: ref[vec.Vec[ProcCapture]]) -> void:
    var i: ptr_uint = 0
    while i < stmts.len:
        unsafe:
            proc_capture_visit_stmt(ctx, stmts.data + i, scopes, seen, captures)
        i += 1


## Walk `ep` for free identifiers; the first reference to an enclosing local
## records its capture with the enclosing binding's read expression (so a
## frame-bound async local still resolves).
function proc_capture_visit_expr(ctx: ref[LowerCtx], ep: ptr[ast.Expr]?, scopes: ref[vec.Vec[map_mod.Map[str, bool]]], seen: ref[map_mod.Map[str, bool]], captures: ref[vec.Vec[ProcCapture]]) -> void:
    let xp = ep else:
        return
    unsafe:
        match read(xp):
            ast.Expr.expr_identifier as id:
                if id.name == "this" or proc_capture_name_bound(scopes, id.name) or seen.contains(id.name):
                    return
                match find_local(ctx, id.name):
                    Option.some as lb:
                        seen.set(id.name, true)
                        captures.push(ProcCapture(name = id.name, c_name = lb.value.c_name, ty = lb.value.ty, read_expr = lower_binding_read(ctx, lb.value)))
                    Option.none:
                        pass
            ast.Expr.expr_member_access as ma:
                proc_capture_visit_expr(ctx, ma.receiver, scopes, seen, captures)
            ast.Expr.expr_call as c:
                proc_capture_visit_expr(ctx, c.callee, scopes, seen, captures)
                var i: ptr_uint = 0
                while i < c.args.len:
                    proc_capture_visit_expr(ctx, read(c.args.data + i).arg_value, scopes, seen, captures)
                    i += 1
            ast.Expr.expr_index_access as ix:
                proc_capture_visit_expr(ctx, ix.receiver, scopes, seen, captures)
                proc_capture_visit_expr(ctx, ix.index, scopes, seen, captures)
            ast.Expr.expr_specialization as s:
                proc_capture_visit_expr(ctx, s.callee, scopes, seen, captures)
            ast.Expr.expr_binary_op as b:
                proc_capture_visit_expr(ctx, b.left, scopes, seen, captures)
                proc_capture_visit_expr(ctx, b.right, scopes, seen, captures)
            ast.Expr.expr_unary_op as u:
                proc_capture_visit_expr(ctx, u.operand, scopes, seen, captures)
            ast.Expr.expr_if as c:
                proc_capture_visit_expr(ctx, c.condition, scopes, seen, captures)
                proc_capture_visit_expr(ctx, c.then_expr, scopes, seen, captures)
                proc_capture_visit_expr(ctx, c.else_expr, scopes, seen, captures)
            ast.Expr.expr_match as m:
                proc_capture_visit_expr(ctx, m.scrutinee, scopes, seen, captures)
                var ai: ptr_uint = 0
                while ai < m.arms.len:
                    let arm = read(m.arms.data + ai)
                    proc_capture_visit_expr(ctx, arm.pattern, scopes, seen, captures)
                    scopes.push(map_mod.Map[str, bool].create())
                    match arm.binding_name:
                        Option.some as bn:
                            proc_capture_scope_add(scopes, bn.value)
                        Option.none:
                            pass
                    proc_capture_visit_expr(ctx, arm.value, scopes, seen, captures)
                    let _dropped = scopes.pop()
                    ai += 1
            ast.Expr.expr_format_string as f:
                var pi: ptr_uint = 0
                while pi < f.parts.len:
                    match read(f.parts.data + pi):
                        ast.FormatStringPart.fmt_expr as part:
                            proc_capture_visit_expr(ctx, part.expression, scopes, seen, captures)
                        ast.FormatStringPart.fmt_text:
                            pass
                    pi += 1
            ast.Expr.expr_range as r:
                proc_capture_visit_expr(ctx, r.start_expr, scopes, seen, captures)
                proc_capture_visit_expr(ctx, r.end_expr, scopes, seen, captures)
            ast.Expr.expr_prefix_cast as pc:
                proc_capture_visit_expr(ctx, pc.expression, scopes, seen, captures)
            ast.Expr.expr_unsafe as u:
                proc_capture_visit_expr(ctx, u.expression, scopes, seen, captures)
            ast.Expr.expr_await as aw:
                proc_capture_visit_expr(ctx, aw.expression, scopes, seen, captures)
            ast.Expr.expr_detach as d:
                proc_capture_visit_expr(ctx, d.expression, scopes, seen, captures)
            ast.Expr.expr_expression_list as el:
                var ei: ptr_uint = 0
                while ei < el.elements.len:
                    proc_capture_visit_expr(ctx, el.elements.data + ei, scopes, seen, captures)
                    ei += 1
            ast.Expr.expr_named as n:
                proc_capture_visit_expr(ctx, n.value, scopes, seen, captures)
            _:
                pass


## The host's per-statement capture walk (`collect_proc_captures_from_statement`,
## proc.rb:150-192): declarations bind after their initializer, branch/loop/arm
## bodies get their own scope, and a nested `when` mirrors the if/match shape.
function proc_capture_visit_stmt(ctx: ref[LowerCtx], sp: ptr[ast.Stmt]?, scopes: ref[vec.Vec[map_mod.Map[str, bool]]], seen: ref[map_mod.Map[str, bool]], captures: ref[vec.Vec[ProcCapture]]) -> void:
    let xp = sp else:
        return
    unsafe:
        match read(xp):
            ast.Stmt.stmt_block as blk:
                proc_capture_visit_stmts(ctx, blk.statements, scopes, seen, captures)
            ast.Stmt.stmt_local as loc:
                proc_capture_visit_expr(ctx, loc.value, scopes, seen, captures)
                match loc.destructure_bindings:
                    Option.some as names:
                        var di: ptr_uint = 0
                        while di < names.value.len:
                            proc_capture_scope_add(scopes, read(names.value.data + di))
                            di += 1
                    Option.none:
                        pass
                proc_capture_scope_add(scopes, loc.name)
            ast.Stmt.stmt_assignment as a:
                proc_capture_visit_expr(ctx, a.target, scopes, seen, captures)
                proc_capture_visit_expr(ctx, a.value, scopes, seen, captures)
            ast.Stmt.stmt_if as iff:
                var bi: ptr_uint = 0
                while bi < iff.branches.len:
                    let br = read(iff.branches.data + bi)
                    proc_capture_visit_expr(ctx, br.condition, scopes, seen, captures)
                    proc_capture_visit_scope(ctx, br.body, scopes, seen, captures)
                    bi += 1
                proc_capture_visit_scope(ctx, iff.else_body, scopes, seen, captures)
            ast.Stmt.stmt_while as w:
                proc_capture_visit_expr(ctx, w.condition, scopes, seen, captures)
                proc_capture_visit_scope(ctx, w.body, scopes, seen, captures)
            ast.Stmt.stmt_for as f:
                var ii: ptr_uint = 0
                while ii < f.iterables.len:
                    proc_capture_visit_expr(ctx, f.iterables.data + ii, scopes, seen, captures)
                    ii += 1
                scopes.push(map_mod.Map[str, bool].create())
                var bi: ptr_uint = 0
                while bi < f.bindings.len:
                    proc_capture_scope_add(scopes, read(f.bindings.data + bi).name)
                    bi += 1
                proc_capture_visit_stmt(ctx, f.body, scopes, seen, captures)
                let _dropped = scopes.pop()
            ast.Stmt.stmt_match as m:
                proc_capture_visit_expr(ctx, m.scrutinee, scopes, seen, captures)
                var ai: ptr_uint = 0
                while ai < m.arms.len:
                    let arm = read(m.arms.data + ai)
                    proc_capture_visit_expr(ctx, arm.pattern, scopes, seen, captures)
                    scopes.push(map_mod.Map[str, bool].create())
                    match arm.binding_name:
                        Option.some as bn:
                            proc_capture_scope_add(scopes, bn.value)
                        Option.none:
                            pass
                    proc_capture_visit_stmt(ctx, arm.body, scopes, seen, captures)
                    let _dropped = scopes.pop()
                    ai += 1
            ast.Stmt.stmt_ret as r:
                proc_capture_visit_expr(ctx, r.value, scopes, seen, captures)
            ast.Stmt.stmt_expression as e:
                proc_capture_visit_expr(ctx, e.expression, scopes, seen, captures)
            ast.Stmt.stmt_defer as d:
                scopes.push(map_mod.Map[str, bool].create())
                proc_capture_visit_expr(ctx, d.expression, scopes, seen, captures)
                proc_capture_visit_stmt(ctx, d.body, scopes, seen, captures)
                let _dropped = scopes.pop()
            ast.Stmt.stmt_unsafe as u:
                proc_capture_visit_scope(ctx, u.body, scopes, seen, captures)
            ast.Stmt.stmt_static_assert as sa:
                proc_capture_visit_expr(ctx, sa.condition, scopes, seen, captures)
                proc_capture_visit_expr(ctx, sa.message, scopes, seen, captures)
            ast.Stmt.stmt_when as w:
                proc_capture_visit_expr(ctx, w.discriminant, scopes, seen, captures)
                var wi: ptr_uint = 0
                while wi < w.branches.len:
                    let br = read(w.branches.data + wi)
                    proc_capture_visit_expr(ctx, br.pattern, scopes, seen, captures)
                    scopes.push(map_mod.Map[str, bool].create())
                    match br.binding_name:
                        Option.some as bn:
                            proc_capture_scope_add(scopes, bn.value)
                        Option.none:
                            pass
                    proc_capture_visit_stmts(ctx, br.body, scopes, seen, captures)
                    let _dropped = scopes.pop()
                    wi += 1
                proc_capture_visit_scope(ctx, w.else_body, scopes, seen, captures)
            ast.Stmt.stmt_gather as g:
                var gi: ptr_uint = 0
                while gi < g.handles.len:
                    proc_capture_visit_expr(ctx, g.handles.data + gi, scopes, seen, captures)
                    gi += 1
            ast.Stmt.stmt_parallel_block as pb:
                var pbi: ptr_uint = 0
                while pbi < pb.bodies.len:
                    proc_capture_visit_scope(ctx, pb.bodies.data + pbi, scopes, seen, captures)
                    pbi += 1
            ast.Stmt.stmt_error_block as eb:
                proc_capture_visit_stmt(ctx, eb.body, scopes, seen, captures)
            ast.Stmt.stmt_emit:
                pass
            ast.Stmt.stmt_break:
                pass
            ast.Stmt.stmt_continue:
                pass
            ast.Stmt.stmt_pass:
                pass
            ast.Stmt.stmt_error:
                pass
            _:
                pass


## Build a setup function that allocates + populates the capture-env struct.
## Takes captured values as parameters and returns a pointer to the initialized env.
function build_env_setup_fn(ctx: ref[LowerCtx], c_name: str, env_type_name: str, captures: span[ProcCapture]) -> ir.Function:
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
    let env_ty_named = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = env_type_name)
    let env_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(env_ty_named))
    let uint_ty = types.primitive("ptr_uint")

    var params = vec.Vec[ir.Param].create()
    # Each capture becomes a parameter of the setup function.  The parameter needs
    # a C identifier of its own: `cap.c_name` is the *caller's* reference to the
    # captured value, which inside an async function is a frame member
    # (`__mt_frame->local_offset`) — unusable in a declaration, and meaningless in
    # this separate function, whose body must read its own parameter.
    var param_names = vec.Vec[str].create()
    var ci: ptr_uint = 0
    while ci < captures.len:
        let cap = unsafe: read(captures.data + ci)
        let pname = fresh_c_temp_name(ctx, "cap")
        param_names.push(pname)
        params.push(ir.Param(name = cap.name, linkage_name = pname, ty = cap.ty, pointer = Option[bool].some(value = false)))
        ci += 1

    var body = vec.Vec[ir.Stmt].create()

    # env = (env_type*) mt_async_alloc(sizeof(env_type)) — the host's refcounted
    # allocator (`block.rb:122-126`).
    let sizeof_call = alloc_expr(ir.Expr.expr_call(callee = "mt_async_alloc", arguments = pack_single(alloc_expr(ir.Expr.expr_sizeof(target_type = env_ty_named, ty = uint_ty))), ty = void_ptr))
    let cast_env = alloc_expr(ir.Expr.expr_cast(target_type = env_ptr_ty, expression = sizeof_call, ty = env_ptr_ty))
    body.push(ir.Stmt.stmt_local(name = "env", linkage_name = "env", ty = env_ptr_ty, value = cast_env, line = 0, source_path = ""))

    # env->__mt_ref_count = 1
    let env_ref = alloc_expr(ir.Expr.expr_name(name = "env", ty = env_ptr_ty, pointer = Option[bool].some(value = false)))
    let ref_field = alloc_expr(ir.Expr.expr_member(receiver = env_ref, member = "__mt_ref_count", ty = uint_ty))
    let one = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = uint_ty))
    body.push(ir.Stmt.stmt_assignment(target = ref_field, operator = "=", value = one))

    # Populate capture fields from parameters.
    var ci2: ptr_uint = 0
    while ci2 < captures.len:
        let cap = unsafe: read(captures.data + ci2)
        let field = alloc_expr(ir.Expr.expr_member(receiver = env_ref, member = cap.name, ty = cap.ty))
        let pname_ptr = param_names.get(ci2) else:
            break
        let cap_val = alloc_expr(ir.Expr.expr_name(name = unsafe: read(pname_ptr), ty = cap.ty, pointer = Option[bool].some(value = false)))
        if is_array_type(cap.ty):
            let addr_of_field = alloc_expr(ir.Expr.expr_address_of(expression = field, ty = types.Type.ty_generic(name = "ptr", args = sp_type(cap.ty))))
            # An array argument already decays to a pointer in C; taking its
            # address here would copy pointer bytes into the env array.
            let size_val = alloc_expr(ir.Expr.expr_sizeof(target_type = cap.ty, ty = uint_ty))
            var memcpy_args = vec.Vec[ir.Expr].create()
            unsafe:
                memcpy_args.push(read(addr_of_field))
                memcpy_args.push(read(cap_val))
                memcpy_args.push(read(size_val))
            body.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call(callee = "memcpy", arguments = memcpy_args.as_span(), ty = ctx.void_ty)), line = 0, source_path = ""))
        else:
            body.push(ir.Stmt.stmt_assignment(target = field, operator = "=", value = cap_val))
        ci2 += 1

    # A proc-storing capture is retained by the env (the host's literal setup
    # retains its proc-valued captures, `block.rb:146-151`).
    var cri2: ptr_uint = 0
    while cri2 < captures.len:
        let cap = unsafe: read(captures.data + cri2)
        if contains_proc_storage_type(ctx, cap.ty):
            let field = alloc_expr(ir.Expr.expr_member(receiver = env_ref, member = cap.name, ty = cap.ty))
            proc_contained_retain_stmts(ctx, field, cap.ty, ref_of(body))
        cri2 += 1

    # return env
    body.push(ir.Stmt.stmt_return(value = env_ref, line = 0, source_path = ""))

    return ir.Function(name = c_name, linkage_name = c_name, params = params.as_span(), return_type = env_ptr_ty, body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build an invoke function for a capturing proc: unpacks env struct fields into
## locals, then runs the body.
function build_capturing_invoke(ctx: ref[LowerCtx], method_params: span[ast.Param], ret_ty: types.Type, body: ptr[ast.Stmt], invoke_c_name: str, env_type_name: str, captures: span[ProcCapture]) -> ir.Function:
    let saved_locals = ctx.locals
    let saved_counter = ctx.temp_counter
    let saved_cps_ci = ctx.async_cps_active
    let saved_cps_ci_completion = ctx.async_completion_active
    let saved_ci_inside_async = ctx.inside_async
    # A proc is a synchronous closure: a literal inside an async function must not
    # inherit the caller's CPS state, or its body emits `__mt_frame->result` stores
    # that don't exist here.  Nor may it inherit `inside_async`, which wraps every
    # returned value in a Task literal.
    ctx.async_cps_active = false
    ctx.async_completion_active = false
    ctx.inside_async = false
    ctx.locals = vec.Vec[LocalBinding].create()
    ctx.temp_counter = 0
    ctx.fmt_dest_name = ""
    ctx.fmt_counter.clear()
    ctx.fmt_counter_visible = false
    ctx.cstr_backed_names.clear()

    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
    let env_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = env_type_name)))

    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "env", linkage_name = "__mt_proc_env", ty = void_ptr, pointer = Option[bool].some(value = false)))

    var pi: ptr_uint = 0
    while pi < method_params.len:
        var p: ast.Param
        unsafe:
            p = read(method_params.data + pi)
        let p_ty = resolve_field_type_ref(ctx, p.param_type)
        let pc = utils.c_local_name(p.name)
        params.push(ir.Param(name = p.name, linkage_name = pc, ty = p_ty, pointer = Option[bool].some(value = false)))
        ctx.locals.push(LocalBinding(name = p.name, c_name = pc, ty = p_ty, pointer = Option[bool].some(value = false)))
        pi += 1

    # Build body: first cast env to typed pointer, then unpack captures.
    var body_stmts = vec.Vec[ir.Stmt].create()
    let env_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_proc_env", ty = void_ptr, pointer = Option[bool].some(value = false)))
    let cast_env = alloc_expr(ir.Expr.expr_cast(target_type = env_ptr_ty, expression = env_expr, ty = env_ptr_ty))
    # The host names the cast local `__mt_proc_env_ptr` (`proc.rb:19`).
    let env_local_name = "__mt_proc_env_ptr"
    body_stmts.push(ir.Stmt.stmt_local(name = env_local_name, linkage_name = env_local_name, ty = env_ptr_ty, value = cast_env, line = 0, source_path = ""))

    # Unpack each capture from env.  The unpacked read is `__mt_capture_<name>`
    # (the host's `proc.rb:27`), leaving the source name for the body's AST.
    var ci: ptr_uint = 0
    while ci < captures.len:
        let cap = unsafe: read(captures.data + ci)
        let env_ref = alloc_expr(ir.Expr.expr_name(name = env_local_name, ty = env_ptr_ty, pointer = Option[bool].some(value = false)))
        let member = alloc_expr(ir.Expr.expr_member(receiver = env_ref, member = cap.name, ty = cap.ty))
        let bc = j2("__mt_capture_", cap.name)
        body_stmts.push(ir.Stmt.stmt_local(name = cap.name, linkage_name = bc, ty = cap.ty, value = member, line = 0, source_path = ""))
        ctx.locals.push(LocalBinding(name = cap.name, c_name = bc, ty = cap.ty, pointer = Option[bool].some(value = false)))
        ci += 1

    # Append the original body.
    let orig_body = lower_function_body(ctx, body)
    var bi: ptr_uint = 0
    while bi < orig_body.len:
        unsafe:
            body_stmts.push(read(orig_body.data + bi))
        bi += 1

    ctx.locals = saved_locals
    ctx.temp_counter = saved_counter
    ctx.async_cps_active = saved_cps_ci
    ctx.async_completion_active = saved_cps_ci_completion
    ctx.inside_async = saved_ci_inside_async
    return ir.Function(
        name = invoke_c_name,
        linkage_name = invoke_c_name,
        params = params.as_span(),
        return_type = ret_ty,
        body = body_stmts.as_span(),
        entry_point = false, public_export = false,
        method_receiver_param = false,
    )


## Build a release function for capturing procs with ref-counting.
function build_capturing_release(ctx: ref[LowerCtx], c_name: str, env_type_name: str, captures: span[ProcCapture]) -> ir.Function:
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    let env_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = env_type_name)))
    let uint_ty = types.primitive("ptr_uint")
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "env", linkage_name = "__mt_proc_env", ty = void_ptr, pointer = Option[bool].some(value = false)))
    var body = vec.Vec[ir.Stmt].create()

    let env_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_proc_env", ty = void_ptr, pointer = Option[bool].some(value = false)))
    let cast_env = alloc_expr(ir.Expr.expr_cast(target_type = env_ptr_ty, expression = env_expr, ty = env_ptr_ty))
    body.push(ir.Stmt.stmt_local(name = "__mt_proc_env_ptr", linkage_name = "__mt_proc_env_ptr", ty = env_ptr_ty, value = cast_env, line = 0, source_path = ""))
    let env_ref = alloc_expr(ir.Expr.expr_name(name = "__mt_proc_env_ptr", ty = env_ptr_ty, pointer = Option[bool].some(value = false)))
    let ref_field = alloc_expr(ir.Expr.expr_member(receiver = env_ref, member = "__mt_ref_count", ty = uint_ty))
    let one = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = uint_ty))
    body.push(ir.Stmt.stmt_assignment(target = ref_field, operator = "-=", value = one))
    let zero = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = uint_ty))
    let cond = alloc_expr(ir.Expr.expr_binary(operator = "==", left = ref_field, right = zero, ty = types.primitive("bool")))
    var then_body = vec.Vec[ir.Stmt].create()
    # Captured proc values own a reference; release them before the env is
    # freed (the host's `build_proc_release_function` capture walk).
    var ci: ptr_uint = 0
    while ci < captures.len:
        var cap: ProcCapture
        unsafe:
            cap = read(captures.data + ci)
        if contains_proc_storage_type(ctx, cap.ty):
            let release_env = alloc_expr(ir.Expr.expr_name(name = "__mt_proc_env_ptr", ty = env_ptr_ty, pointer = Option[bool].some(value = false)))
            let capture_ref = alloc_expr(ir.Expr.expr_member(receiver = release_env, member = cap.name, ty = cap.ty))
            proc_contained_release_stmts(ctx, capture_ref, cap.ty, ref_of(then_body))
        ci += 1
    let free_call = alloc_expr(ir.Expr.expr_call(callee = "mt_async_free", arguments = pack_single(alloc_expr(ir.Expr.expr_name(name = "__mt_proc_env", ty = void_ptr, pointer = Option[bool].some(value = false)))), ty = types.primitive("void")))
    then_body.push(ir.Stmt.stmt_expression(expression = free_call, line = 0, source_path = ""))
    body.push(ir.Stmt.stmt_if(condition = cond, then_body = then_body.as_span(), else_body = Option[span[ir.Stmt]].none))
    body.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    return ir.Function(name = c_name, linkage_name = c_name, params = params.as_span(), return_type = types.primitive("void"), body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build a retain function for capturing procs (increments ref_count).
function build_capturing_retain(c_name: str, env_type_name: str) -> ir.Function:
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    let env_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = env_type_name)))
    let uint_ty = types.primitive("ptr_uint")
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "env", linkage_name = "__mt_proc_env", ty = void_ptr, pointer = Option[bool].some(value = false)))
    var body = vec.Vec[ir.Stmt].create()
    let env_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_proc_env", ty = void_ptr, pointer = Option[bool].some(value = false)))
    let cast_env = alloc_expr(ir.Expr.expr_cast(target_type = env_ptr_ty, expression = env_expr, ty = env_ptr_ty))
    body.push(ir.Stmt.stmt_local(name = "__mt_proc_env_ptr", linkage_name = "__mt_proc_env_ptr", ty = env_ptr_ty, value = cast_env, line = 0, source_path = ""))
    let env_ref = alloc_expr(ir.Expr.expr_name(name = "__mt_proc_env_ptr", ty = env_ptr_ty, pointer = Option[bool].some(value = false)))
    let ref_field = alloc_expr(ir.Expr.expr_member(receiver = env_ref, member = "__mt_ref_count", ty = uint_ty))
    let one = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = uint_ty))
    body.push(ir.Stmt.stmt_assignment(target = ref_field, operator = "+=", value = one))
    body.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    return ir.Function(name = c_name, linkage_name = c_name, params = params.as_span(), return_type = types.primitive("void"), body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build a non-capturing proc invoke function: unpacks env (unused), lowers the
## body.  Returns the body expression directly (or void return for no-return).
function build_proc_invoke_fn(ctx: ref[LowerCtx], method_params: span[ast.Param], ret_ty: types.Type, body: ptr[ast.Stmt], invoke_c_name: str) -> ir.Function:
    let saved_locals = ctx.locals
    let saved_counter = ctx.temp_counter
    let saved_cps_pi = ctx.async_cps_active
    let saved_cps_pi_completion = ctx.async_completion_active
    let saved_pi_inside_async = ctx.inside_async
    # See `build_capturing_invoke`: the proc body is synchronous and must not
    # inherit the enclosing async function's CPS return state — nor its
    # `inside_async`, which would wrap the returned value in a Task literal.
    ctx.async_cps_active = false
    ctx.async_completion_active = false
    ctx.inside_async = false
    ctx.locals = vec.Vec[LocalBinding].create()
    ctx.temp_counter = 0
    ctx.fmt_dest_name = ""
    ctx.fmt_counter.clear()
    ctx.fmt_counter_visible = false
    ctx.cstr_backed_names.clear()

    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "env", linkage_name = "__mt_proc_env", ty = void_ptr, pointer = Option[bool].some(value = false)))

    var pi: ptr_uint = 0
    while pi < method_params.len:
        var p: ast.Param
        unsafe:
            p = read(method_params.data + pi)
        let p_ty = resolve_field_type_ref(ctx, p.param_type)
        let pc = utils.c_local_name(p.name)
        params.push(ir.Param(name = p.name, linkage_name = pc, ty = p_ty, pointer = Option[bool].some(value = false)))
        ctx.locals.push(LocalBinding(name = p.name, c_name = pc, ty = p_ty, pointer = Option[bool].some(value = false)))
        pi += 1

    let body_stmts = lower_function_body(ctx, body)

    ctx.locals = saved_locals
    ctx.temp_counter = saved_counter
    ctx.async_cps_active = saved_cps_pi
    ctx.async_completion_active = saved_cps_pi_completion
    ctx.inside_async = saved_pi_inside_async
    return ir.Function(
        name = invoke_c_name,
        linkage_name = invoke_c_name,
        params = params.as_span(),
        return_type = ret_ty,
        body = body_stmts,
        entry_point = false, public_export = false,
        method_receiver_param = false,
    )


## Build a no-op release/retain function for non-capturing procs.
function build_proc_noop_fn(c_name: str) -> ir.Function:
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "env", linkage_name = "__mt_proc_env", ty = void_ptr, pointer = Option[bool].some(value = false)))
    var body = vec.Vec[ir.Stmt].create()
    body.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    return ir.Function(name = c_name, linkage_name = c_name, params = params.as_span(), return_type = types.primitive("void"), body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## The proc struct's `invoke` field type — the host's
## `proc_invoke_function_type` (`utils.rb:531-537`): a plain function type with
## the leading `env: ptr[void]` parameter followed by the proc's own (named)
## parameters.
function proc_invoke_field_type(proc_ty: types.Type) -> types.Type:
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    match proc_ty:
        types.Type.ty_function as fn_ty:
            var all_params = vec.Vec[types.Type].create()
            var all_names = vec.Vec[str].create()
            all_params.push(void_ptr)
            all_names.push("env")
            var i: ptr_uint = 0
            while i < fn_ty.params.len:
                unsafe:
                    all_params.push(read(fn_ty.params.data + i))
                var pname = ""
                if i < fn_ty.param_names.len:
                    unsafe:
                        pname = read(fn_ty.param_names.data + i)
                all_names.push(pname)
                i += 1
            return types.Type.ty_function(name = "", params = all_params.as_span(), return_type = fn_ty.return_type, variadic = false, is_proc = false, param_names = all_names.as_span())
        _:
            return types.Type.ty_error


## The proc's release/retain field type: `fn(env: ptr[void]) -> void`.
function proc_lifecycle_fn_type() -> types.Type:
    var params = vec.Vec[types.Type].create()
    params.push(types.Type.ty_generic(name = "ptr", args = sp_type(types.Type.ty_primitive(name = "void"))))
    return types.Type.ty_function(name = "", params = params.as_span(), return_type = types.alloc_type(types.primitive("void")), variadic = false, is_proc = false, param_names = sp_str("env"))


## True when a type stores a proc value by value — the self's
## `contains_proc_storage_type?` (host `utils.rb:486-500`): a proc, a nullable of
## one, or a struct with a proc-storing field (recursively).  Generic instances
## resolve their declared fields without substitution: a field typed by a type
## parameter never counts (a recorded residue).
function contains_proc_storage_type(ctx: ref[LowerCtx], t: types.Type) -> bool:
    return contains_proc_storage_type_depth(ctx, t, 0)


function contains_proc_storage_type_depth(ctx: ref[LowerCtx], t: types.Type, depth: int) -> bool:
    if depth > 12:
        return false
    match t:
        types.Type.ty_function as fnt:
            return fnt.is_proc
        types.Type.ty_nullable as nl:
            return contains_proc_storage_type_depth(ctx, unsafe: read(nl.base), depth + 1)
        types.Type.ty_imported:
            match struct_fields_of(ctx, t):
                Option.some as fields:
                    var i: ptr_uint = 0
                    while i < fields.value.len:
                        unsafe:
                            if contains_proc_storage_type_depth(ctx, read(fields.value.data + i).ty, depth + 1):
                                return true
                        i += 1
                Option.none:
                    pass
            return false
        types.Type.ty_named:
            match struct_fields_of(ctx, t):
                Option.some as fields:
                    var i: ptr_uint = 0
                    while i < fields.value.len:
                        unsafe:
                            if contains_proc_storage_type_depth(ctx, read(fields.value.data + i).ty, depth + 1):
                                return true
                        i += 1
                Option.none:
                    pass
            return false
        _:
            return false


## `recv.release(recv.env)` as an expression statement (the host's
## `lower_proc_release_expression`, `proc.rb:260-266`).
function proc_release_stmt(recv: ptr[ir.Expr]) -> ir.Stmt:
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    let callee = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "release", ty = proc_lifecycle_fn_type()))
    let env = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "env", ty = void_ptr))
    return ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(callee = callee, arguments = single_expr_span(env), ty = types.primitive("void"))), line = 0, source_path = "")


## `recv.retain(recv.env)` as an expression statement (the host's
## `lower_proc_retain_expression`, `proc.rb:268-274`).
function proc_retain_stmt(recv: ptr[ir.Expr]) -> ir.Stmt:
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    let callee = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "retain", ty = proc_lifecycle_fn_type()))
    let env = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "env", ty = void_ptr))
    return ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(callee = callee, arguments = single_expr_span(env), ty = types.primitive("void"))), line = 0, source_path = "")


## The host's `lower_proc_contained_release_statements` (`proc.rb:276-278`): an
## unguarded release per stored proc; struct fields recurse; a nullable stores
## nothing.
function proc_contained_release_stmts(ctx: ref[LowerCtx], recv: ptr[ir.Expr], t: types.Type, stmts: ref[vec.Vec[ir.Stmt]]) -> void:
    match t:
        types.Type.ty_function as fnt:
            if fnt.is_proc:
                stmts.push(proc_release_stmt(recv))
        types.Type.ty_imported:
            proc_struct_field_release_stmts(ctx, recv, t, stmts, false)
        types.Type.ty_named:
            proc_struct_field_release_stmts(ctx, recv, t, stmts, false)
        _:
            pass


## The host's `lower_proc_nullable_release_statements` (`proc.rb:280-284`): a
## release guarded by the proc's `invoke` field, for values that may be
## zero-initialized (locals, async frame fields).
function proc_nullable_release_stmts(ctx: ref[LowerCtx], recv: ptr[ir.Expr], t: types.Type, stmts: ref[vec.Vec[ir.Stmt]]) -> void:
    match t:
        types.Type.ty_function as fnt:
            if fnt.is_proc:
                let invoke_ty = proc_invoke_field_type(t)
                let cond = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "invoke", ty = invoke_ty))
                var body = vec.Vec[ir.Stmt].create()
                body.push(proc_release_stmt(recv))
                stmts.push(ir.Stmt.stmt_if(condition = cond, then_body = body.as_span(), else_body = Option[span[ir.Stmt]].none))
        types.Type.ty_imported:
            proc_struct_field_release_stmts(ctx, recv, t, stmts, true)
        types.Type.ty_named:
            proc_struct_field_release_stmts(ctx, recv, t, stmts, true)
        _:
            pass


## The fields a proc retain/release walk visits.  A generic instance uses its
## concrete declaration's substituted fields (`generic_struct_decls`); every
## other struct wraps the analyzer's declared fields.
function proc_struct_fields(ctx: ref[LowerCtx], t: types.Type) -> Option[span[ir.Field]]:
    match t:
        types.Type.ty_imported as im:
            if im.args.len > 0:
                let lookup_name = naming.qualified_c_name(im.module_name, generic_struct_c_name(im.name, im.args))
                let p = ctx.generic_struct_decls.get(lookup_name)
                if p != null:
                    return Option[span[ir.Field]].some(value = unsafe: read(p).fields)
        types.Type.ty_named as n:
            let p = ctx.generic_struct_decls.get(n.name)
            if p != null:
                return Option[span[ir.Field]].some(value = unsafe: read(p).fields)
        types.Type.ty_generic as g:
            if g.args.len > 0:
                let concrete = try_monomorphize_generic(ctx, g.name, g.args)
                match concrete:
                    types.Type.ty_named:
                        return proc_struct_fields(ctx, concrete)
                    types.Type.ty_imported:
                        return proc_struct_fields(ctx, concrete)
                    _:
                        return Option[span[ir.Field]].none
        _:
            pass
    match struct_fields_of(ctx, t):
        Option.some as fields:
            var result_fields = vec.Vec[ir.Field].create()
            var i: ptr_uint = 0
            while i < fields.value.len:
                let f = unsafe: read(fields.value.data + i)
                result_fields.push(ir.Field(name = f.name, ty = f.ty))
                i += 1
            return Option[span[ir.Field]].some(value = result_fields.as_span())
        Option.none:
            return Option[span[ir.Field]].none


## Walk a struct type's proc-storing fields, emitting a release per field
## (`guarded` applies the nullable/zero-init guard).
function proc_struct_field_release_stmts(ctx: ref[LowerCtx], recv: ptr[ir.Expr], t: types.Type, stmts: ref[vec.Vec[ir.Stmt]], guarded: bool) -> void:
    match proc_struct_fields(ctx, t):
        Option.some as fields:
            var i: ptr_uint = 0
            while i < fields.value.len:
                let f = unsafe: read(fields.value.data + i)
                if contains_proc_storage_type(ctx, f.ty):
                    let member = alloc_expr(ir.Expr.expr_member(receiver = recv, member = f.name, ty = f.ty))
                    if guarded:
                        proc_nullable_release_stmts(ctx, member, f.ty, stmts)
                    else:
                        proc_contained_release_stmts(ctx, member, f.ty, stmts)
                i += 1
        Option.none:
            pass


## The host's `lower_proc_contained_retain_statements` (`proc.rb:291-293`): an
## unguarded retain per stored proc; struct fields recurse.
function proc_contained_retain_stmts(ctx: ref[LowerCtx], recv: ptr[ir.Expr], t: types.Type, stmts: ref[vec.Vec[ir.Stmt]]) -> void:
    match t:
        types.Type.ty_function as fnt:
            if fnt.is_proc:
                stmts.push(proc_retain_stmt(recv))
        types.Type.ty_imported:
            proc_struct_field_retain_stmts(ctx, recv, t, stmts, Option[ptr[ast.Expr]].none)
        types.Type.ty_named:
            proc_struct_field_retain_stmts(ctx, recv, t, stmts, Option[ptr[ast.Expr]].none)
        _:
            pass


## The host's `lower_proc_selective_retain_statements` (`proc.rb:329-362`): a
## value that is not a fresh proc literal is retained for the new owner.  Struct
## fields take their own AST source when the RHS is a struct literal.
function proc_selective_retain_stmts(ctx: ref[LowerCtx], recv: ptr[ir.Expr], value_ast: ptr[ast.Expr], t: types.Type, stmts: ref[vec.Vec[ir.Stmt]]) -> void:
    match t:
        types.Type.ty_function as fnt:
            if fnt.is_proc:
                if not proc_expr_contains_proc_expr(value_ast):
                    stmts.push(proc_retain_stmt(recv))
        types.Type.ty_imported:
            proc_struct_field_retain_stmts(ctx, recv, t, stmts, Option[ptr[ast.Expr]].some(value = value_ast))
        types.Type.ty_named:
            proc_struct_field_retain_stmts(ctx, recv, t, stmts, Option[ptr[ast.Expr]].some(value = value_ast))
        _:
            pass


## Walk a struct type's proc-storing fields for a retain; `value_ast` is the
## assignment's RHS (a struct literal's named argument is the field's own
## source, per the host's `ast_field_source` rule).
function proc_struct_field_retain_stmts(ctx: ref[LowerCtx], recv: ptr[ir.Expr], t: types.Type, stmts: ref[vec.Vec[ir.Stmt]], value_ast: Option[ptr[ast.Expr]]) -> void:
    match proc_struct_fields(ctx, t):
        Option.some as fields:
            var i: ptr_uint = 0
            while i < fields.value.len:
                let f = unsafe: read(fields.value.data + i)
                if contains_proc_storage_type(ctx, f.ty):
                    let member = alloc_expr(ir.Expr.expr_member(receiver = recv, member = f.name, ty = f.ty))
                    var field_ast = value_ast
                    match value_ast:
                        Option.some as va:
                            unsafe:
                                match read(va.value):
                                    ast.Expr.expr_call as c:
                                        var ai: ptr_uint = 0
                                        while ai < c.args.len:
                                            var arg: ast.Argument
                                            arg = read(c.args.data + ai)
                                            match arg.arg_name:
                                                Option.some as an:
                                                    if an.value == f.name:
                                                        field_ast = Option[ptr[ast.Expr]].some(value = arg.arg_value)
                                                Option.none:
                                                    pass
                                            ai += 1
                                    _:
                                        pass
                        Option.none:
                            pass
                    match field_ast:
                        Option.some as fa:
                            proc_selective_retain_stmts(ctx, member, fa.value, f.ty, stmts)
                        Option.none:
                            proc_contained_retain_stmts(ctx, member, f.ty, stmts)
                i += 1
        Option.none:
            pass


## The host's `expression_contains_proc_expr?` (`proc.rb:364-393`): true when the
## expression contains a proc literal, i.e. its value is a fresh closure whose
## ownership transfers rather than being retained.
function proc_expr_contains_proc_expr(ep: ptr[ast.Expr]) -> bool:
    let e = ep
    unsafe:
        match read(e):
            ast.Expr.expr_proc:
                return true
            ast.Expr.expr_member_access as m:
                return proc_expr_contains_proc_expr(m.receiver)
            ast.Expr.expr_index_access as ix:
                return proc_expr_contains_proc_expr(ix.receiver) or proc_expr_contains_proc_expr(ix.index)
            ast.Expr.expr_unary_op as u:
                return proc_expr_contains_proc_expr(u.operand)
            ast.Expr.expr_binary_op as b:
                return proc_expr_contains_proc_expr(b.left) or proc_expr_contains_proc_expr(b.right)
            ast.Expr.expr_if as f:
                return proc_expr_contains_proc_expr(f.condition) or proc_expr_contains_proc_expr(f.then_expr) or proc_expr_contains_proc_expr(f.else_expr)
            ast.Expr.expr_unsafe as s:
                return proc_expr_contains_proc_expr(s.expression)
            ast.Expr.expr_await as aw:
                return proc_expr_contains_proc_expr(aw.expression)
            ast.Expr.expr_call as c:
                if proc_expr_contains_proc_expr(c.callee):
                    return true
                var i: ptr_uint = 0
                while i < c.args.len:
                    unsafe:
                        if proc_expr_contains_proc_expr(read(c.args.data + i).arg_value):
                            return true
                    i += 1
                return false
            ast.Expr.expr_specialization as sp:
                return proc_expr_contains_proc_expr(sp.callee)
            _:
                return false
## fields `_0`, `_1`, ... and a `ty_tuple` type.  (Named tuples arrive later.)
function lower_tuple_literal_with_names(ctx: ref[LowerCtx], elements: span[ast.Expr]) -> ptr[ir.Expr]:
    var fields = vec.Vec[ir.AggregateField].create()
    var elem_types = vec.Vec[types.Type].create()
    var fnames = vec.Vec[str].create()
    var all_named = true
    # A tuple literal's elements are lowered directly (the host's
    # `lower_expression`, not a prepared context), so repeatedly-evaluated
    # inline forms — a proc literal in particular — stay inline rather than
    # materializing into a statement temp.
    let tuple_saved = suspend_stmt_setup(ctx)
    var i: ptr_uint = 0
    while i < elements.len:
        var ep = unsafe: elements.data + i
        var name: str = ""
        unsafe:
            match read(ep):
                ast.Expr.expr_named as nm:
                    name = nm.name
                    ep = nm.value
                _:
                    all_named = false
                    pass
        let lowered = unsafe: lower_expr(ctx, ep)
        let fname = if name != "": name else: tuple_field_name(i)
        if name == "":
            name = tuple_field_name(i)
        fields.push(ir.AggregateField(name = name, value = lowered))
        elem_types.push(ir_expr_type(lowered))
        fnames.push(name)
        i += 1
    resume_stmt_setup(ctx, tuple_saved)
    var tuple_field_names = Option[span[str]].none
    if all_named:
        tuple_field_names = Option[span[str]].some(value = fnames.as_span())
    let tuple_ty = types.Type.ty_tuple(elements = elem_types.as_span(), field_names = tuple_field_names)
    ensure_tuple_struct_ir(ctx, tuple_ty)
    return alloc_expr(ir.Expr.expr_aggregate_literal(
        ty = tuple_ty,
        fields = fields.as_span(),
    ))


## Register the value struct for a tuple type, mirroring the host's
## `ensure_tuple_struct`: one `IR::StructDecl` per tuple type (deduped by
## linkage name), fields named `_0..` or the tuple's own field names, appended
## to `Program.structs` after the module declarations.
function ensure_tuple_struct_ir(ctx: ref[LowerCtx], ty: types.Type) -> void:
    match ty:
        types.Type.ty_tuple as tup:
            let linkage = naming.tuple_type_c_name(ty)
            if ctx.pending_tuple_linkages.contains(linkage):
                return
            ctx.pending_tuple_linkages.set(linkage, true)
            var fields = vec.Vec[ir.Field].create()
            var i: ptr_uint = 0
            while i < tup.elements.len:
                var fname = tuple_field_name(i)
                match tup.field_names:
                    Option.some as names:
                        if i < names.value.len:
                            unsafe:
                                fname = read(names.value.data + i)
                    Option.none:
                        pass
                unsafe:
                    fields.push(ir.Field(name = fname, ty = read(tup.elements.data + i)))
                i += 1
            ctx.pending_synthetic_structs.push(ir.StructDecl(
                name = naming.type_to_s_qualified(ty),
                linkage_name = linkage,
                fields = fields.as_span(),
                packed = false,
                alignment = 0,
                source_module = Option[str].none,
            ))
        _:
            pass


## Ensure an `mt_tuple_*` decl for every tuple type reachable from a
## const/global storage type, mirroring the host's
## `ensure_registered_storage_type_types`: tuple elements, nullable bases,
## generic and instance arguments, and named struct fields.
function ensure_storage_type_tuples(ctx: ref[LowerCtx], ty: types.Type, seen: ref[map_mod.Map[str, bool]]) -> void:
    let key = naming.type_c_key(ty)
    if seen.contains(key):
        return
    seen.set(key, true)
    match ty:
        types.Type.ty_tuple as tup:
            ensure_tuple_struct_ir(ctx, ty)
            var i: ptr_uint = 0
            while i < tup.elements.len:
                ensure_storage_type_tuples(ctx, unsafe: read(tup.elements.data + i), seen)
                i += 1
        types.Type.ty_nullable as nl:
            ensure_storage_type_tuples(ctx, unsafe: read(nl.base), seen)
        types.Type.ty_generic as g:
            var i: ptr_uint = 0
            while i < g.args.len:
                ensure_storage_type_tuples(ctx, unsafe: read(g.args.data + i), seen)
                i += 1
        types.Type.ty_imported as im:
            var i: ptr_uint = 0
            while i < im.args.len:
                ensure_storage_type_tuples(ctx, unsafe: read(im.args.data + i), seen)
                i += 1
            if im.args.len == 0:
                ensure_struct_field_tuples(ctx, ty, seen)
        types.Type.ty_named:
            ensure_struct_field_tuples(ctx, ty, seen)
        _:
            pass


function ensure_struct_field_tuples(ctx: ref[LowerCtx], ty: types.Type, seen: ref[map_mod.Map[str, bool]]) -> void:
    match struct_fields_of(ctx, ty):
        Option.some as fields:
            var i: ptr_uint = 0
            while i < fields.value.len:
                ensure_storage_type_tuples(ctx, unsafe: read(fields.value.data + i).ty, seen)
                i += 1
        Option.none:
            pass


function tuple_field_name(index: ptr_uint) -> str:
    var buf = string.String.create()
    buf.append("_")
    fmt.append_ptr_uint(ref_of(buf), index)
    return buf.as_str()


function tuple_element_type(t: types.Type, index: ptr_uint) -> types.Type:
    match t:
        types.Type.ty_tuple as tup:
            if index < tup.elements.len:
                unsafe:
                    return read(tup.elements.data + index)
            return types.Type.ty_error
        _:
            return types.Type.ty_error


## Lower an `assert`/`expect`/`expect_eq`/`expect_ne` expression statement to
## `if (!condition) fatal(message)`.  The message is evaluated only on the
## failing path; its default form carries the analysis path and the statement's
## line (the host's `default_assert_message`), and the synthesized fatal call is
## the host's statement-position shape (nil line, the analysis path).
function lower_assert_stmt(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], kind: str, args: span[ast.Argument], stmt_line: ptr_uint) -> void:
    # The intrinsic desugars to an `if` whose condition is a prepared position:
    # a statement-lowered call or a dynamic format temp in the condition hoists
    # before the `IfStmt`, and its cleanups run in both branches (the host's
    # `prepare_expression_with_cleanups` + `condition_cleanup_statements`).
    let cond_base = output.len()
    let cond_saved = begin_stmt_setup(ctx, HoistMode.hm_return)
    var cond: ptr[ir.Expr]
    var msg_index: ptr_uint = 1
    if kind == "expect_eq" or kind == "expect_ne":
        msg_index = 2
        let left_ast = unsafe: read(args.data + 0).arg_value
        let right_ast = unsafe: read(args.data + 1).arg_value
        var left = lower_expr(ctx, left_ast)
        var right = lower_expr(ctx, right_ast)
        # Each operand takes the other's type as its expected type, as a normal
        # binary does (`found != 1` with a `ptr_uint` peer keeps a `ptr_uint`
        # literal).
        left = literal_value_to_context_type(ctx, left_ast, ir_expr_type(right), left)
        right = literal_value_to_context_type(ctx, right_ast, ir_expr_type(left), right)
        let op = if kind == "expect_eq": "!=" else: "=="
        cond = alloc_expr(ir.Expr.expr_binary(operator = op, left = left, right = right, ty = ctx.bool_ty))
    else:
        let inner = lower_expr(ctx, unsafe: read(args.data + 0).arg_value)
        cond = alloc_expr(ir.Expr.expr_unary(operator = "not", operand = inner, ty = ctx.bool_ty))
    let cond_collected = collect_stmt_setup(ctx, cond_saved)
    emit_hoist_setup(output, cond_base, cond_collected)
    var fatal_callee = "mt_fatal_str"
    var msg: ptr[ir.Expr]
    if args.len > msg_index:
        let msg_ast = unsafe: read(args.data + msg_index).arg_value
        if fatal_arg_is_cstr(ctx, msg_ast):
            fatal_callee = "mt_fatal"
        msg = lower_expr(ctx, msg_ast)
    else:
        msg = alloc_expr(ir.Expr.expr_string_literal(value = assert_default_message(kind, ctx.analysis.source_path, stmt_line), ty = types.Type.ty_str, cstring = false))
    var fatal_args = vec.Vec[ir.Expr].create()
    unsafe:
        fatal_args.push(read(msg))
    let fatal_call = alloc_expr(ir.Expr.expr_call(callee = fatal_callee, arguments = fatal_args.as_span(), ty = ctx.void_ty))
    var then_body = vec.Vec[ir.Stmt].create()
    then_body.push(ir.Stmt.stmt_expression(expression = fatal_call, line = 0, source_path = ctx.analysis.source_path))
    # The host emits a present empty else branch for assert-like calls, then the
    # condition's cleanups after the `IfStmt` (both paths continue past it).
    output.push(ir.Stmt.stmt_if(condition = cond, then_body = then_body.as_span(), else_body = Option[span[ir.Stmt]].some(value = span[ir.Stmt]())))
    append_hoist_cleanups(output, cond_collected)


## The host's `default_assert_message`: the fixed text plus ` at <path>:<line>`.
function assert_default_message(kind: str, path: str, line: ptr_uint) -> str:
    var buf = string.String.create()
    if kind == "assert":
        buf.append("assertion failed")
    else if kind == "expect":
        buf.append("expectation failed")
    else if kind == "expect_eq":
        buf.append("expect_eq failed: values are not equal")
    else:
        buf.append("expect_ne failed: values are equal")
    buf.append(" at ")
    buf.append(path)
    buf.append(":")
    fmt.append_ptr_uint(ref_of(buf), line)
    return buf.as_str()


## Lower `receiver[index]`: array receivers use a bounds-checked index, span
## receivers a bounds-checked span index, and raw pointers a plain index.
function lower_index_access(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], index: ptr[ast.Expr], ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    unsafe:
        match read(index):
            ast.Expr.expr_range as rng:
                return lower_range_index_read(ctx, receiver, rng.start_expr, rng.end_expr, ep)
            _:
                pass
    var receiver_type = index_receiver_type(ctx, receiver)
    let recv = lower_expr(ctx, receiver)
    let index_expr = lower_expr(ctx, index)
    # The analyzer's recorded type for a member-access chain can carry
    # unresolved generic parameters (e.g. `Signal[Payload].slots` inside a
    # monomorphized body); the lowered receiver's type is concrete, so prefer
    # it for array/span receivers.
    let recv_ty_pre = ir_expr_type(recv)
    if is_array_type(recv_ty_pre) or is_span_type(recv_ty_pre):
        receiver_type = recv_ty_pre
    if is_str_typed(receiver_type) or is_str_typed(ir_expr_type(recv)):
        # str byte read → mt_str_index(text, index) with a bounds check.  The
        # host passes the lowered index through unchanged (the helper's
        # `uintptr_t` parameter converts it in C).
        var str_args = vec.Vec[ir.Expr].create()
        unsafe:
            str_args.push(read(recv))
            str_args.push(read(index_expr))
        return alloc_expr(ir.Expr.expr_call(callee = "mt_str_index", arguments = str_args.as_span(), ty = types.primitive("ubyte")))
    var elem_ty = qualify_type(ctx, expr_type(ctx, ep))
    # Prefer the element type of the lowered receiver: the analyzer's recorded
    # element type may carry unresolved generic parameters (see above).
    if is_array_type(recv_ty_pre) or is_span_type(recv_ty_pre):
        let concrete_elem = qualify_type(ctx, generic_first_arg(recv_ty_pre))
        if not types.is_error(concrete_elem):
            elem_ty = concrete_elem
    if types.is_error(elem_ty):
        # The analyzer may not have recorded the type for member-access
        # chains on external structs (e.g. model.skeleton.bindPose[i]).
        # Fall back to the lowered receiver's type, which carries the
        # correct resolved type from lower_member_access.
        var recv_ty = ir_expr_type(recv)
        if not types.is_error(recv_ty):
            elem_ty = qualify_type(ctx, generic_first_arg(recv_ty))
        if types.is_error(elem_ty):
            elem_ty = qualify_type(ctx, generic_first_arg(receiver_type))
    # An array receiver always takes the bounds-checked index, including an
    # array-of-arrays element (`POINTS_OF_INEST[0]` over
    # `array[array[float, 2], 6]`): the host emits
    # `mt_checked_index_array_array_float_2_6(POINTS_OF_INEST, 0)` and
    # dereferences it (session 44, item 6a).
    if is_array_type(receiver_type):
        return alloc_expr(ir.Expr.expr_checked_index(receiver = recv, index = index_expr, receiver_type = receiver_type, ty = elem_ty))
    if is_span_type(receiver_type):
        return alloc_expr(ir.Expr.expr_checked_span_index(receiver = recv, index = index_expr, receiver_type = receiver_type, ty = elem_ty))
    return alloc_expr(ir.Expr.expr_index(receiver = recv, index = index_expr, ty = elem_ty))


## Lower `receiver[start..stop]`: a `str` slice (`mt_str_slice`), or a span
## view over an array/span receiver (`mt_span_slice_<T>`).
function lower_range_index_read(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], start_expr: ptr[ast.Expr], end_expr: ptr[ast.Expr], ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    let recv_ty = index_receiver_type(ctx, receiver)
    let recv = lower_expr(ctx, receiver)
    # A slice bound is lowered with `ptr_uint` as its expected type (the host's
    # `lower_range_index_bound`, `expressions.rb:1506`), so a bare literal is a
    # `ptr_uint` literal rather than an `int` plus a cast.
    let ptr_uint_ty = types.primitive("ptr_uint")
    let start = coerce_index_bound_to_ptr_uint(ctx, literal_value_to_context_type(ctx, start_expr, ptr_uint_ty, lower_expr(ctx, start_expr)))
    let stop = coerce_index_bound_to_ptr_uint(ctx, literal_value_to_context_type(ctx, end_expr, ptr_uint_ty, lower_expr(ctx, end_expr)))
    if is_str_typed(recv_ty) or is_str_typed(ir_expr_type(recv)):
        var args = vec.Vec[ir.Expr].create()
        unsafe:
            args.push(read(recv))
            args.push(read(start))
            args.push(read(stop))
        return alloc_expr(ir.Expr.expr_call(callee = "mt_str_slice", arguments = args.as_span(), ty = types.Type.ty_str))
    var elem_ty = qualify_type(ctx, generic_first_arg(recv_ty))
    if types.is_error(elem_ty):
        elem_ty = qualify_type(ctx, generic_first_arg(ir_expr_type(recv)))
    if types.is_error(elem_ty):
        elem_ty = qualify_type(ctx, expr_type(ctx, ep))
    let span_ty = types.Type.ty_generic(name = "span", args = sp_type(elem_ty))
    var span_arg = recv
    if is_array_type(recv_ty):
        span_arg = lower_array_as_span(ctx, receiver, recv_ty)
    var args = vec.Vec[ir.Expr].create()
    unsafe:
        args.push(read(span_arg))
        args.push(read(start))
        args.push(read(stop))
    let callee = j2("mt_span_slice_", naming.type_c_key(elem_ty))
    return alloc_expr(ir.Expr.expr_call(callee = callee, arguments = args.as_span(), ty = span_ty))


## Cast a range bound to `ptr_uint` so the slice helpers take a uniform type.
function coerce_index_bound_to_ptr_uint(ctx: ref[LowerCtx], bound: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let ptr_uint_ty = types.primitive("ptr_uint")
    if types.type_to_string(ir_expr_type(bound)) == "ptr_uint":
        return bound
    return alloc_expr(ir.Expr.expr_cast(target_type = ptr_uint_ty, expression = bound, ty = ptr_uint_ty))


## Lower `arr[start..end] = (e1, e2, ...)` into individual checked-index
## assignments.  The range start must be a uint-typed integer literal, and the
## RHS expression list length must match the range width.
function lower_range_index_assignment(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], receiver: ptr[ast.Expr], start_expr: ptr[ast.Expr], elements: span[ast.Expr]) -> void:
    let receiver_type = index_receiver_type(ctx, receiver)
    let recv = lower_expr(ctx, receiver)
    var start_val: long = 0
    unsafe:
        match read(start_expr):
            ast.Expr.expr_integer_literal as il:
                start_val = il.value
            _:
                fatal(c"lower_range_index_assignment: start must be integer literal")
    var elem_ty = qualify_type(ctx, generic_first_arg(receiver_type))
    if types.is_error(elem_ty):
        fatal(c"lower_range_index_assignment: cannot determine element type")
    var i: ptr_uint = 0
    while i < elements.len:
        let index_expr = alloc_expr(ir.Expr.expr_integer_literal(value = start_val + long<-(i), ty = types.primitive("ptr_uint")))
        # A range-index assignment is element-wise and lowers to plain indexes
        # (the host's `lower_range_index_assignment`), never checked ones.
        let target_expr = alloc_expr(ir.Expr.expr_index(receiver = recv, index = index_expr, ty = elem_ty))
        let value_expr = lower_expr(ctx, unsafe: elements.data + i)
        output.push(ir.Stmt.stmt_assignment(target = target_expr, operator = "=", value = value_expr))
        i += 1


## The type of an index receiver: for a local/parameter identifier take its
## recorded binding type (which carries the correct array length); otherwise fall
## back to the analyzer's inferred type.
function index_receiver_type(ctx: ref[LowerCtx], receiver: ptr[ast.Expr]) -> types.Type:
    unsafe:
        match read(receiver):
            ast.Expr.expr_identifier as id:
                match lookup_local(ctx, id.name):
                    Option.some as lb:
                        return lb.value.ty
                    Option.none:
                        pass
                let mvt = module_var_type(ctx, id.name)
                if not types.is_error(mvt):
                    return mvt
            _:
                pass
    return expr_type(ctx, receiver)


function is_array_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_generic as g:
            return g.name == "array" and g.args.len == 2
        _:
            return false


function is_span_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_generic as g:
            return g.name == "span" and g.args.len == 1
        _:
            return false


function is_soa_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_generic as g:
            return g.name == "SoA" and g.args.len >= 2
        _:
            return false


## The synthetic member type of `soa_ty.member`: an `array[<field>, N]` over the
## element struct's field (the host's `Types::SoA#fields`).
function soa_member_array_type(ctx: ref[LowerCtx], soa_ty: types.Type, field_name: str) -> Option[types.Type]:
    match soa_ty:
        types.Type.ty_generic as g:
            if g.name == "SoA" and g.args.len >= 2:
                let elem_ty = unsafe: read(g.args.data + 0)
                let count_ty = unsafe: read(g.args.data + 1)
                match count_ty:
                    types.Type.ty_literal_int as lit:
                        match comptime_lookup_struct_fields(ctx, nominal_type_name(elem_ty)):
                            Option.some as fields:
                                var fi: ptr_uint = 0
                                while fi < fields.value.len:
                                    let entry = unsafe: read(fields.value.data + fi)
                                    if entry.name == field_name:
                                        var args = vec.Vec[types.Type].create()
                                        args.push(qualify_type(ctx, entry.ty))
                                        args.push(types.literal_int(lit.value))
                                        return Option[types.Type].some(value = types.Type.ty_generic(name = "array", args = args.as_span()))
                                    fi += 1
                            Option.none:
                                pass
                    _:
                        pass
        _:
            pass
    return Option[types.Type].none


## The C field type for member `field_name` on the element type of an SoA.
## The SoA struct has one array per element field, so the array element type
## is the field type from the element struct.
function soa_field_type(ctx: ref[LowerCtx], soa_ty: types.Type, field_name: str) -> types.Type:
    match soa_ty:
        types.Type.ty_generic as g:
            if g.args.len >= 1:
                let elem_ty = unsafe: read(g.args.data + 0)
                # The element may be module-qualified (`ty_imported`) or a bare
                # named struct; search the current module and the program.
                match comptime_lookup_struct_fields(ctx, nominal_type_name(elem_ty)):
                    Option.some as fields:
                        var fi: ptr_uint = 0
                        while fi < fields.value.len:
                            let entry = unsafe: read(fields.value.data + fi)
                            if entry.name == field_name:
                                return qualify_type(ctx, entry.ty)
                            fi += 1
                    Option.none:
                        pass
        _:
            pass
    return ctx.void_ty


function generic_first_arg(t: types.Type) -> types.Type:
    match t:
        types.Type.ty_generic as g:
            if g.args.len > 0:
                unsafe:
                    return read(g.args.data + 0)
            return types.Type.ty_error
        _:
            return types.Type.ty_error


## The result type carried by a lowered IR expression (used to recover a local's
## type when the analyzer left it unresolved, e.g. `span[T](...)` construction).
function ir_expr_type(ep: ptr[ir.Expr]) -> types.Type:
    unsafe:
        match read(ep):
            ir.Expr.expr_name as x:
                return x.ty
            ir.Expr.expr_member as x:
                return x.ty
            ir.Expr.expr_index as x:
                return x.ty
            ir.Expr.expr_checked_index as x:
                return x.ty
            ir.Expr.expr_checked_span_index as x:
                return x.ty
            ir.Expr.expr_call as x:
                return x.ty
            ir.Expr.expr_call_indirect as x:
                return x.ty
            ir.Expr.expr_unary as x:
                return x.ty
            ir.Expr.expr_binary as x:
                return x.ty
            ir.Expr.expr_conditional as x:
                return x.ty
            ir.Expr.expr_cast as x:
                return x.ty
            ir.Expr.expr_integer_literal as x:
                return x.ty
            ir.Expr.expr_unsigned_integer_literal as x:
                return x.ty
            ir.Expr.expr_float_literal as x:
                return x.ty
            ir.Expr.expr_null_literal as x:
                return x.ty
            ir.Expr.expr_sizeof as x:
                return x.ty
            ir.Expr.expr_alignof as x:
                return x.ty
            ir.Expr.expr_offsetof as x:
                return x.ty
            ir.Expr.expr_reinterpret as x:
                return x.ty
            ir.Expr.expr_nullable_index as x:
                return x.ty
            ir.Expr.expr_nullable_span_index as x:
                return x.ty
            ir.Expr.expr_boolean_literal as x:
                return x.ty
            ir.Expr.expr_string_literal as x:
                return x.ty
            ir.Expr.expr_address_of as x:
                return x.ty
            ir.Expr.expr_aggregate_literal as x:
                return x.ty
            ir.Expr.expr_variant_literal as x:
                return x.ty
            ir.Expr.expr_array_literal as x:
                return x.ty
            ir.Expr.expr_zero_init as x:
                return x.ty
            ir.Expr.expr_stmt_expr as x:
                return x.ty
            ir.Expr.expr_simd_lane_with as x:
                return x.ty
            ir.Expr.expr_assignment as x:
                return ir_expr_type(x.value)
            _:
                return types.Type.ty_error


## True when the IR expression is a null literal (ALL lowercase `NULL` or
## `null` in the source).  Address-of on a null literal produces `&(NULL)`
## which is not valid C — skip address-of for these expressions.
function is_null_ir_expr(ep: ptr[ir.Expr]) -> bool:
    unsafe:
        match read(ep):
            ir.Expr.expr_null_literal:
                return true
            _:
                return false


function lower_call(ctx: ref[LowerCtx], callee: ptr[ast.Expr], args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    unsafe:
        match read(callee):
            ast.Expr.expr_identifier as id:
                if id.name == "fatal":
                    # `fatal(cstr)` → mt_fatal(const char*); `fatal(str)` →
                    # mt_fatal_str(mt_str), mirroring Ruby's fatal dispatch.
                    var fatal_callee = "mt_fatal"
                    if args.len > 0:
                        if not fatal_arg_is_cstr(ctx, unsafe: read(args.data + 0).arg_value):
                            fatal_callee = "mt_fatal_str"
                    return lower_plain_call(ctx, fatal_callee, args, call_ep, null)
                if id.name == "ptr_of" or id.name == "ref_of" or id.name == "const_ptr_of":
                    if args.len == 1:
                        let inner = lower_expr(ctx, read(args.data + 0).arg_value)
                        let inner_ty = ir_expr_type(inner)
                        # The analyzer may record the referent type unqualified
                        # (e.g. `ref[Counter]` with `Counter` module-less);
                        # qualify it so the element matches the host.
                        var result_ty = qualify_type(ctx, expr_type(ctx, call_ep))
                        # When expr_type returns void or error (e.g. the analyzer
                        # did not record a type for the builtin), compute the
                        # correct result type from the argument's type.  Also
                        # recompute when the recorded type is a pointer to a void
                        # element (`ptr[void]`) but the argument has a concrete
                        # type — the analyzer sometimes records the untyped
                        # `ptr[void]` for a builtin whose operand is a member
                        # access it did not resolve, which would otherwise mask the
                        # real referent type.
                        let outer_kind = if id.name == "ptr_of": "ptr" else: if id.name == "ref_of": "ref" else: "const_ptr"
                        let recorded_elem = types.pointer_element(result_ty)
                        let recorded_elem_bad = types.is_void(recorded_elem) or types.is_error(recorded_elem)
                        let inner_is_concrete = not (types.is_error(inner_ty) or types.is_void(inner_ty))
                        if types.is_error(result_ty) or types.is_void(result_ty) or (recorded_elem_bad and inner_is_concrete):
                            result_ty = types.Type.ty_generic(name = outer_kind, args = sp_type(inner_ty))
                        # The host's `:ptr_of` on a ref-typed argument wraps the
                        # reference value in a cast to the result pointer type
                        # (`calls.rb`'s `IR::Cast` branch); it does not retype the
                        # Name.  `const_ptr_of`/`ref_of` go through the address
                        # path instead.
                        if id.name == "ptr_of" and types.is_ref_type(inner_ty):
                            return alloc_expr(ir.Expr.expr_cast(target_type = result_ty, expression = inner, ty = result_ty))
                        # When the argument is already a pointer/ref value (e.g. a
                        # `ref[T]` parameter, which is a pointer in C), taking its
                        # address again would produce `T**`.  Use the pointer value
                        # directly; if it is a `*p` deref, use the underlying `p`.
                        # Mirrors Ruby's ref_of/ptr_of/const_ptr_of handling.
                        match read(inner):
                            ir.Expr.expr_name as nm:
                                if nm.pointer.unwrap_or(false) or types.is_ref_type(nm.ty) or types.is_own_type(nm.ty):
                                    # The operand is already a pointer *value* whose
                                    # MT type is a reference (`ref[T]`), or the
                                    # binding itself is pointer-lowered, so the
                                    # builtin returns it directly.  A mere
                                    # raw-pointer MT type (`var p: ptr[int]`) is a
                                    # stored pointer value: `ptr_of(p)` must take
                                    # its address (`&p`), like the host's
                                    # `lower_addr_expression`.  Rebuild the result
                                    # type from the lowered pointer's element type:
                                    # a monomorphized `this` is a concrete
                                    # collapsed struct, whereas the analyzer
                                    # recorded the bare generic-body type
                                    # (`ref[StateMachine]`), which would break
                                    # type-parameter inference at call sites.
                                    var direct_ty = result_ty
                                    if types.is_raw_pointer(nm.ty) or types.is_ref_type(nm.ty) or types.is_own_type(nm.ty):
                                        let elem = types.pointer_element(nm.ty)
                                        var kind = "ref"
                                        if id.name == "ptr_of":
                                            kind = "ptr"
                                        if id.name == "const_ptr_of":
                                            kind = "const_ptr"
                                        direct_ty = types.Type.ty_generic(name = kind, args = sp_type(elem))
                                    # The host's `lower_addr_expression` wraps a
                                    # pointer-lowered Name in `cast_expression(name,
                                    # target_type)`: the Name keeps its own type and a
                                    # differing target becomes an `IR::Cast`
                                    # (`ref_of(this)` on an editable receiver).
                                    if types.type_equals(nm.ty, direct_ty):
                                        return inner
                                    return alloc_expr(ir.Expr.expr_cast(target_type = direct_ty, expression = inner, ty = direct_ty))
                                # ref[T] is already a pointer in C, so ptr_of/const_ptr_of
                                # on a ref variable returns the variable directly as a raw
                                # pointer to the referent; ref_of returns it as-is.
                                if types.is_ref_type(nm.ty):
                                    let ref_elem = types.pointer_element(nm.ty)
                                    let elem_sp = sp_type(ref_elem)
                                    var adjusted_ty = result_ty
                                    if id.name == "ptr_of":
                                        adjusted_ty = types.Type.ty_generic(name = "ptr", args = elem_sp)
                                    if id.name == "const_ptr_of":
                                        adjusted_ty = types.Type.ty_generic(name = "const_ptr", args = elem_sp)
                                    if id.name == "ref_of":
                                        pass
                                    return alloc_expr(ir.Expr.expr_name(name = nm.name, ty = adjusted_ty, pointer = Option[bool].some(value = true)))
                            ir.Expr.expr_unary as un:
                                if un.operator == "*":
                                    # The host casts the deref's operand to the
                                    # target when the types differ and returns it
                                    # unchanged otherwise.
                                    if types.type_equals(ir_expr_type(un.operand), result_ty):
                                        return un.operand
                                    return alloc_expr(ir.Expr.expr_cast(target_type = result_ty, expression = un.operand, ty = result_ty))
                            _:
                                pass
                        return alloc_expr(ir.Expr.expr_address_of(expression = inner, ty = result_ty))
                # `read(p)` as an rvalue → pointer dereference `*p`.  The result
                # type is the pointer's element type (more reliable than the
                # analyzer's generically-recorded type inside monomorphized
                # bodies); fall back to the recorded call type otherwise.
                if id.name == "read":
                    if args.len == 1:
                        let inner = lower_expr(ctx, read(args.data + 0).arg_value)
                        var base = ir_expr_type(inner)
                        if types.is_nullable_type(base):
                            base = types.unwrap_nullable(base)
                        var elem_ty = expr_type(ctx, call_ep)
                        if types.is_raw_pointer(base) or types.is_ref_type(base) or types.is_own_type(base):
                            elem_ty = types.pointer_element(base)
                        return alloc_expr(ir.Expr.expr_unary(operator = "*", operand = inner, ty = qualify_type(ctx, elem_ty)))
                # `get(coll, index)` → recoverable array/span indexing returning
                # `ptr[T]?` — null on out-of-bounds instead of aborting.
                # Maps to IR checked_index / checked_span_index, mirroring Ruby.
                if id.name == "get":
                    if args.len >= 2:
                        let recv_val = unsafe: read(args.data + 0).arg_value
                        let idx_val = unsafe: read(args.data + 1).arg_value
                        let recv_ty = index_receiver_type(ctx, recv_val)
                        let recv_ir = lower_expr(ctx, recv_val)
                        let idx_ir = lower_expr(ctx, idx_val)
                        var elem_ty = generic_first_arg(recv_ty)
                        if types.is_error(elem_ty):
                            elem_ty = expr_type(ctx, call_ep)
                        if types.is_nullable_type(elem_ty):
                            elem_ty = types.unwrap_nullable(elem_ty)
                        if is_array_type(recv_ty):
                            let ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(qualify_type(ctx, elem_ty)))
                            let nullable_ptr = types.Type.ty_nullable(base = types.alloc_type(ptr_ty))
                            return alloc_expr(ir.Expr.expr_nullable_index(receiver = recv_ir, index = idx_ir, receiver_type = recv_ty, ty = nullable_ptr))
                        if is_span_type(recv_ty):
                            let ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(qualify_type(ctx, elem_ty)))
                            let nullable_ptr = types.Type.ty_nullable(base = types.alloc_type(ptr_ty))
                            return alloc_expr(ir.Expr.expr_nullable_span_index(receiver = recv_ir, index = idx_ir, receiver_type = recv_ty, ty = nullable_ptr))
                # Native `str(data = ..., len = ...)` construction -> mt_str
                # aggregate literal (not a call to a `str` function).
                if id.name == "str":
                    var str_fields = vec.Vec[ir.AggregateField].create()
                    var sfi: ptr_uint = 0
                    while sfi < args.len:
                        var sarg: ast.Argument
                        unsafe:
                            sarg = read(args.data + sfi)
                        let fname = sarg.arg_name else:
                            fatal(c"lowering: str construction requires named fields")
                        str_fields.push(ir.AggregateField(name = fname, value = lower_expr(ctx, sarg.arg_value)))
                        sfi += 1
                    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = types.Type.ty_str, fields = str_fields.as_span()))
                if ctx.analysis.structs.contains(id.name):
                    return lower_aggregate_literal(ctx, id.name, args)
                if struct_exists_in_imports(ctx, id.name):
                    return lower_aggregate_literal(ctx, id.name, args)
                # Native type constructors: vec3(x=..., y=..., z=...),
                # mat4(col0=..., ...), quat(x=..., ...).  These are not in
                # structs but are builtin aggregate types.
                if is_builtin_type_name(id.name):
                    return lower_aggregate_literal(ctx, id.name, args)
                let foreign_ptr = ctx.foreign_map.get(id.name)
                if foreign_ptr != null:
                    return lower_foreign_call(ctx, read(foreign_ptr), args, call_ep)
                let extern_ptr = ctx.extern_map.get(id.name)
                if extern_ptr != null:
                    return lower_plain_call(ctx, read(extern_ptr), args, call_ep, null)
                # Proc-typed local: `p(args)` → `p.invoke(p.env, args)`.
                match lookup_local(ctx, id.name):
                    Option.some as lb:
                        if is_proc_type(lb.value.ty):
                            return lower_proc_call(ctx, lb.value, args, call_ep)
                        if is_fn_type(lb.value.ty):
                            # The host's callee is an `IR::Name` carrying the
                            # function type (a call through the local's value,
                            # not a bare C-name call); the call's type falls back
                            # to the callee's own signature when the analyzer
                            # recorded none (the `lower_proc_call` rule).
                            var ret_ty = expr_type(ctx, call_ep)
                            match lb.value.ty:
                                types.Type.ty_function as ft:
                                    if is_void_type(ret_ty):
                                        ret_ty = unsafe: read(ft.return_type)
                                _:
                                    pass
                            let ret_type_ptr = types.alloc_type(ret_ty)
                            # A guard-projected binding is read as a member chain,
                            # so it cannot be spelled as a bare callee name.
                            match lb.value.projection:
                                BindingProjection.plain:
                                    let callee_expr = alloc_expr(ir.Expr.expr_name(name = lb.value.c_name, ty = lb.value.ty, pointer = Option[bool].some(value = false)))
                                    return lower_call_with_callee_expr(ctx, callee_expr, args, call_ep, ret_type_ptr, empty_fn_sig())
                                _:
                                    return lower_call_with_callee_expr(ctx, lower_binding_read(ctx, lb.value), args, call_ep, ret_type_ptr, empty_fn_sig())
                    Option.none:
                        pass
                match find_generic_function(ctx, id.name):
                    Option.some as gm:
                        match try_inferred_generic_call(ctx, Option[str].none, id.name, args, call_ep):
                            Option.some as gen_call:
                                return gen_call.value
                            Option.none:
                                pass
                    Option.none:
                        pass
                # Module-level proc variable: call through proc struct.
                # expr_type on the callee may not have the correct type if the
                # analyzer only records the call expression type, so also check
                # the identifier against the source file's variable declarations.
                var callee_ty = expr_type(ctx, callee)
                if not is_proc_type(callee_ty):
                    callee_ty = module_var_type(ctx, id.name)
                if is_proc_type(callee_ty):
                    let c_name = naming.qualified_c_name(ctx.module_name, id.name)
                    let lb = LocalBinding(name = id.name, c_name = c_name, ty = callee_ty, pointer = Option[bool].some(value = false))
                    return lower_proc_call(ctx, lb, args, call_ep)
                # Compile-time builtins: evaluate to constant literals rather than
                # emitting runtime function calls.  has_attribute returns a bool;
                # field_of / callable_of / attribute_of return opaque handles
                # (zero-init at the IR level since they are consumed only by
                # other compile-time builtins).
                if id.name == "has_attribute":
                    return alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = ctx.bool_ty))
                if id.name == "field_of" or id.name == "callable_of" or id.name == "attribute_of":
                    return alloc_expr(ir.Expr.expr_zero_init(ty = types.Type.ty_error))
                # A `const function` call in an ordinary expression is a normal
                # runtime call (the host emits `examples_comptime_square`); the
                # compile-time evaluation belongs to const initializers, which
                # route through `try_const_typed_value_ir` above.
                # A module-level variable of plain *function* type
                # (`var f: fn() -> void = noop_scene_draw`) is called through its
                # value: the host's callee is an `IR::Name` carrying the function
                # type, not a bare C name (`examples/box3d/*`'s `s_scene_draw()`).
                # `module_var_type` only answers for module-level variables, so a
                # function declaration still takes the direct-call path below.
                match module_var_type(ctx, id.name):
                    types.Type.ty_function as fn_var_ty:
                        let c_name = naming.qualified_c_name(ctx.module_name, id.name)
                        let callee_expr = alloc_expr(ir.Expr.expr_name(name = c_name, ty = module_var_type(ctx, id.name), pointer = Option[bool].some(value = false)))
                        return lower_call_with_callee_expr(ctx, callee_expr, args, call_ep, unsafe: fn_var_ty.return_type, empty_fn_sig())
                    _:
                        pass
                var ret_ty = function_return_type(ctx, id.name)
                var ret_type_ptr = types.alloc_type(ret_ty)
                var plain_args = args
                match find_func_in_source(ctx.analysis.source_file, id.name):
                    Option.some as fd:
                        match fd.value:
                            ast.Decl.decl_function as fun:
                                plain_args = expand_default_args(fun.method_params, args)
                            _:
                                pass
                    Option.none:
                        pass
                var callee_c = naming.qualified_c_name(ctx.module_name, id.name)
                if ctx.is_root_module and id.name == "main":
                    match lookup_fn_sig(ctx, id.name):
                        Option.some as main_sig:
                            if main_sig.value.is_async:
                                callee_c = naming.qualified_c_name(ctx.module_name, "__async_main")
                        Option.none:
                            pass
                return lower_plain_call_sig(ctx, callee_c, plain_args, call_ep, ret_type_ptr, lookup_fn_sig(ctx, id.name))
            ast.Expr.expr_specialization as spec:
                # When the specialisation callee is a member access
                # (e.g. `r.unpack[CompactHeader]()`), try method resolution
                # before generic-function monomorphization so that
                # extending-block methods with their own type params are found.
                unsafe:
                    match read(spec.callee):
                        ast.Expr.expr_member_access as spma:
                            let sp_recv_ty = ir_expr_type(lower_expr(ctx, spma.receiver))
                            var sp_info_opt = generic_receiver_info(ctx, sp_recv_ty)
                            if sp_info_opt.is_none():
                                sp_info_opt = ptr_specialization_receiver_info(ctx, sp_recv_ty)
                            match sp_info_opt:
                                Option.some as sp_info:
                                    match find_generic_method_in_module(ctx, sp_info.value.owner_name, spma.member_name, sp_info.value.owner_module):
                                        Option.some as sp_gm:
                                            if sp_gm.value.method.type_params.len > 0:
                                                var sp_ext_args = vec.Vec[types.Type].create()
                                                var sp_ai: ptr_uint = 0
                                                while sp_ai < sp_info.value.concrete_args.len:
                                                    unsafe:
                                                        sp_ext_args.push(read(sp_info.value.concrete_args.data + sp_ai))
                                                    sp_ai += 1
                                                var sp_tpi: ptr_uint = 0
                                                while sp_tpi < sp_gm.value.method.type_params.len:
                                                    if sp_tpi < spec.arguments.len:
                                                        sp_ext_args.push(qualify_type(ctx, resolve_type_ref(ctx, unsafe: read(spec.arguments.data + sp_tpi).value)))
                                                    else:
                                                        fatal(c"lowering: not enough specialization args for generic method")
                                                    sp_tpi += 1
                                                let sp_ext_info = GenericReceiver(owner_name = sp_info.value.owner_name, concrete_args = sp_ext_args.as_span(), owner_module = sp_info.value.owner_module)
                                                return lower_monomorphized_method(ctx, sp_ext_info, sp_gm.value, spma.member_name, spma.receiver, args)
                                        Option.none:
                                            pass
                                Option.none:
                                    pass
                        _:
                            pass
                return lower_specialization_call(ctx, spec.callee, spec.arguments, args, call_ep)
            ast.Expr.expr_member_access as ma:
                match read(ma.receiver):
                    ast.Expr.expr_identifier as recv_id:
                        # A non-generic variant arm constructor, e.g. `Token.number(value = 41)`.
                        if ctx.variants.contains(recv_id.name):
                            return lower_variant_literal(ctx, recv_id.name, ma.member_name, args)
                        # Static hook / method call on a primitive or `str` type
                        # name, e.g. `str.order(a, b)` → `str_order_static(a, b)`.
                        if is_primitive_or_str_name(recv_id.name):
                            match resolve_primitive_method_info(ctx, recv_id.name, ma.member_name):
                                Option.some as prim_mi:
                                    return lower_static_call_args(ctx, prim_mi.value, args)
                                Option.none:
                                    pass
                        # Static method call on a struct type name, e.g.
                        # `String.create()`.  The receiver is a bare type name (not
                        # a value), so resolve the static method and lower only the
                        # arguments.  Mirrors the Ruby resolver's `resolve_type_expression`
                        # + `static:<method>` associated-function path.
                        if struct_exists_in_imports(ctx, recv_id.name):
                            let static_recv_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = recv_id.name)
                            match resolve_method_info(ctx, static_recv_ty, ma.member_name):
                                Option.some as smi:
                                    if smi.value.method_kind == ast.MethodKind.mk_static:
                                        return lower_static_call_args(ctx, smi.value, args)
                                Option.none:
                                    pass
                        let mod_ptr = ctx.analysis.imports.get(recv_id.name)
                        if mod_ptr != null:
                            let target_module = read(mod_ptr)
                            # Check if member_name is a struct in the imported module
                            # (struct constructor, e.g. ir.Field(name, ty)).
                            match find_imported_analysis(ctx, target_module):
                                Option.some as imported:
                                    if imported.value.structs.contains(ma.member_name):
                                        return lower_aggregate_literal_in_module(ctx, ma.member_name, args, target_module)
                                    # member_name may be a type alias pointing to a
                                    # struct in an external module (e.g.
                                    # `type Rectangle = c.Rectangle`).  Follow the
                                    # alias chain to the originating struct module
                                    # and construct an aggregate literal there.
                                    if imported.value.type_alias_types.contains(ma.member_name):
                                        let alias_target = imported.value.type_alias_types.get(ma.member_name)
                                        if alias_target != null:
                                            var at = unsafe: read(alias_target)
                                            # Unwrap nullable so `rl.Color?` resolves
                                            # to the underlying struct type.
                                            var base = at
                                            if types.is_nullable_type(base):
                                                base = types.unwrap_nullable(base)
                                            match base:
                                                types.Type.ty_imported as aim:
                                                    return lower_aggregate_literal_in_module(ctx, aim.name, args, aim.module_name)
                                                types.Type.ty_named as nm:
                                                    return lower_aggregate_literal_in_module(ctx, nm.name, args, nm.module_name)
                                                _:
                                                    pass
                                    # Check if ma.member_name is a variant arm in any
                                    # imported variant (e.g. types.Type.ty_named(linkage_name = Option[str].none, name)).
                                    match find_imported_variant_arm(imported.value, ma.member_name):
                                        Option.some as var_name:
                                            let var_ty = types.Type.ty_imported(module_name = target_module, name = var_name.value, args = span[types.Type]())
                                            return alloc_expr(ir.Expr.expr_variant_literal(
                                                ty = var_ty,
                                                arm_name = ma.member_name,
                                                fields = collect_variant_literal_fields(ctx, args, var_ty, ma.member_name),
                                            ))
                                        Option.none:
                                            pass
                                Option.none:
                                    pass
                            # Cross-module foreign function call (`libc.getenv_wrapper(...)`):
                            # a foreign function lowers to a direct call on its
                            # mapped C function (e.g. `getenv`), not a Milk Tea
                            # module-qualified symbol.  Resolve it against the
                            # target module's declarations before the plain path.
                            match imported_foreign_call(ctx, target_module, ma.member_name):
                                Option.some as ff_info:
                                    return lower_foreign_call(ctx, ff_info.value, args, call_ep)
                                Option.none:
                                    pass
                            # Cross-module external function call (`libc.malloc(...)`):
                            # an external function uses its bare C name (or `= target`
                            # mapping), not a module-qualified symbol.  Resolve it
                            # against the target module before the plain path so its
                            # linkage name and return type are correct.
                            match imported_extern_call(ctx, target_module, ma.member_name):
                                Option.some as ext_info:
                                    return lower_extern_call(ctx, ext_info.value, args, call_ep)
                                Option.none:
                                    pass
                            # Cross-module generic function call with inferred type
                            # args (`heap.release(x)` → `heap.release[T]`): infer T
                            # from the argument types and monomorphize.
                            match try_inferred_generic_call(ctx, Option[str].some(value = target_module), ma.member_name, args, call_ep):
                                Option.some as gen_call:
                                    return gen_call.value
                                Option.none:
                                    pass
                            let c_name = naming.qualified_c_name(target_module, ma.member_name)
                            var ret_ty = cross_module_return_type(ctx, c_name, call_ep)
                            var ret_type_ptr = types.alloc_type(ret_ty)
                            var cross_sig = lookup_imported_fn_sig(ctx, target_module, ma.member_name)
                            var cross_args = args
                            match find_imported_analysis(ctx, target_module):
                                Option.some as imported:
                                    match find_func_in_source(imported.value.source_file, ma.member_name):
                                        Option.some as fd:
                                            match fd.value:
                                                ast.Decl.decl_function as fun:
                                                    cross_args = expand_default_args(fun.method_params, args)
                                                _:
                                                    pass
                                        Option.none:
                                            pass
                                Option.none:
                                    pass
                            return lower_plain_call_sig(ctx, c_name, cross_args, call_ep, ret_type_ptr, cross_sig)
                    ast.Expr.expr_specialization as spec:
                        # A generic variant arm constructor, e.g. `Option[int].some(value = 42)`.
                        # A GENERIC variant is deliberately absent from `ctx.variants`
                        # (that registry drives non-generic match resolution), so
                        # fall back to the declarations, local then imported.
                        if spec.arguments.len > 0:
                            match read(spec.callee):
                                ast.Expr.expr_identifier as spec_id:
                                    if ctx.variants.contains(spec_id.name):
                                        return lower_generic_variant_literal(ctx, spec_id.name, spec.arguments, ma.member_name, args)
                                    match variant_declaring_module(ctx, spec_id.name):
                                        Option.some:
                                            return lower_generic_variant_literal(ctx, spec_id.name, spec.arguments, ma.member_name, args)
                                        Option.none:
                                            pass
                                ast.Expr.expr_member_access as spec_ma:
                                    # Module-qualified: `types.Outcome[int, E].ok(value = 7)`.
                                    match read(spec_ma.receiver):
                                        ast.Expr.expr_identifier as spec_mod_id:
                                            let spec_mod_ptr = ctx.analysis.imports.get(spec_mod_id.name)
                                            if spec_mod_ptr != null:
                                                match find_imported_analysis(ctx, unsafe: read(spec_mod_ptr)):
                                                    Option.some as spec_imported:
                                                        if variant_in_source(spec_imported.value, spec_ma.member_name):
                                                            return lower_generic_variant_literal(ctx, spec_ma.member_name, spec.arguments, ma.member_name, args)
                                                    Option.none:
                                                        pass
                                        _:
                                            pass
                                _:
                                    pass
                    ast.Expr.expr_member_access as inner_ma:
                        # Imported variant arm constructor: `alias.Variant.arm(args)`,
                        # e.g. `types.Type.ty_named(linkage_name = Option[str].none, name)`.
                        match read(inner_ma.receiver):
                            ast.Expr.expr_identifier as inner_id:
                                let mod_ptr = ctx.analysis.imports.get(inner_id.name)
                                if mod_ptr != null:
                                    let target_module = read(mod_ptr)
                                    match find_imported_analysis(ctx, target_module):
                                        Option.some as imported:
                                            match find_imported_variant_arm(imported.value, ma.member_name):
                                                Option.some as var_name:
                                                    let var_ty = types.Type.ty_imported(module_name = target_module, name = var_name.value, args = span[types.Type]())
                                                    return alloc_expr(ir.Expr.expr_variant_literal(
                                                        ty = var_ty,
                                                        arm_name = ma.member_name,
                                                        fields = collect_variant_literal_fields(ctx, args, var_ty, ma.member_name),
                                                    ))
                                                Option.none:
                                                    pass
                                            # If ma.member_name is a static method of a struct
                                            # in the imported module (e.g.
                                            # `sess.Config.default(payload_size)`), resolve
                                            # it against the imported module so struct name
                                            # collisions across modules (e.g. Config in both
                                            # session and channel) pick the correct module.
                                            let inner_recv_ty = types.Type.ty_imported(module_name = target_module, name = inner_ma.member_name, args = span[types.Type]())
                                            match resolve_method_info_imported(ctx, inner_recv_ty, method_name = ma.member_name, import_module = target_module):
                                                Option.some as smi:
                                                    if smi.value.method_kind == ast.MethodKind.mk_static:
                                                        return lower_static_call_args(ctx, smi.value, args)
                                                Option.none:
                                                    pass
                                        Option.none:
                                            pass
                            _:
                                pass
                    _:
                        pass
                # Method call: receiver.method(args).  Resolve the method from the
                # receiver's type and lower to a direct C function call.
                let recv_ty = method_receiver_type(ctx, ma.receiver)
                # Builtin `array[T, N].as_span()` → span aggregate literal
                # `{ data = &arr[0], len = N }`.  Intercept before method
                # resolution so it does not fall to the `<module>_mt_as_span`
                # fallback (mirrors Ruby's :array_as_span lowering).
                if is_array_type(recv_ty) and ma.member_name == "as_span" and args.len == 0:
                    return lower_array_as_span(ctx, ma.receiver, recv_ty)
                # Builtin `simd[E, N].with(lane, value)` — copy the vector with
                # one lane replaced (GCC statement expression).
                if types.is_simd_type(recv_ty) and ma.member_name == "with":
                    return lower_simd_with_call(ctx, ma.receiver, recv_ty, args)
                # Builtin `.with(x = val, ...)` — aggregate copy with specified
                # fields replaced, mirroring Ruby's :struct_with lowering.
                if ma.member_name == "with":
                    return lower_with_call(ctx, ma.receiver, recv_ty, args)
                # Event builtin methods: must be checked before resolve_method_info
                # because they ARE registered in method_sigs for sema validation.
                if is_event_type(ctx, recv_ty):
                    let recv_ir = lower_expr(ctx, ma.receiver)
                    return lower_event_method(ctx, recv_ir, recv_ty, ma.member_name, args, call_ep)
                match try_generic_method_call(ctx, recv_ty, ma.member_name, ma.receiver, args, call_ep):
                    Option.some as gen_call:
                        return gen_call.value
                    Option.none:
                        pass
                match resolve_method_info(ctx, recv_ty, ma.member_name):
                    Option.some as mi:
                        return lower_method_resolved(ctx, mi.value, ma.receiver, args, call_ep)
                    Option.none:
                        pass
                # atomic[T] builtin methods: lower to __atomic_* compiler builtins.
                if is_atomic_type(recv_ty):
                    let recv_ir = lower_expr(ctx, ma.receiver)
                    return lower_atomic_method(ctx, recv_ir, recv_ty, ma.member_name, args, call_ep)
                # str_buffer[N] builtin methods: lower to C helper calls.
                if is_str_buffer_type(recv_ty):
                    let recv_ir = lower_expr(ctx, ma.receiver)
                    return lower_str_buffer_method(ctx, recv_ir, recv_ty, ma.member_name, args, call_ep)
                # dyn[I] dispatch: extract data + vtable, call through function pointer.
                # The type may be ty_named("dyn") or ty_dyn(iface) — try both.
                let ts = types.type_to_string(recv_ty)
                if ts == "dyn" or is_dyn_type(recv_ty):
                    let recv_ir = lower_expr(ctx, ma.receiver)
                    return lower_dyn_method_call(ctx, recv_ir, ma.member_name, args, call_ep)
                # Fallback: treat as a direct C call with the member as callee.
                # But first, check if the member is an fn/proc struct field — if so,
                # lower as a direct field access call instead of a method call.
                var is_fn_proc_field = false
                var found_ft: types.Type = ctx.void_ty
                # A variant arm binding's payload fields are registered in
                # `arm_payload_fields` (keyed by the payload struct's C name), not
                # in a struct table, so `s.cb()` on an arm binding needs them from
                # there.
                match recv_ty:
                    types.Type.ty_variant_arm_payload:
                        match arm_payload_field_type(ctx, recv_ty, ma.member_name):
                            Option.some as arm_ft:
                                found_ft = arm_ft.value
                            Option.none:
                                pass
                    _:
                        pass
                match concrete_field_type(ctx, recv_ty, ma.member_name):
                    Option.some as ft:
                        found_ft = ft.value
                    Option.none:
                        # Not in generic_struct_decls; try analysis.structs for
                        # non-generic (local and imported) structs.  Strip
                        # pointer/ref wrappers first so the base struct name is
                        # recovered (ptr[SleepState] → SleepState).
                        var base = recv_ty
                        if types.is_raw_pointer(base) or types.is_ref_type(base) or types.is_own_type(base):
                            base = types.pointer_element(base)
                        if types.is_nullable_type(base):
                            base = types.unwrap_nullable(base)
                        let struct_name = named_type_name(base)
                        if struct_name.is_some():
                            let sn = struct_name.unwrap()
                            var raw_fields = ctx.analysis.structs.get(sn)
                            if raw_fields == null:
                                var ai: ptr_uint = 0
                                while ai < ctx.program_analyses.len and raw_fields == null:
                                    var a: analyzer.Analysis
                                    unsafe:
                                        a = read(ctx.program_analyses.data + ai)
                                    raw_fields = a.structs.get(sn)
                                    ai += 1
                            if raw_fields != null:
                                let entries = unsafe: read(raw_fields)
                                var ei: ptr_uint = 0
                                while ei < entries.len:
                                    let entry = unsafe: read(entries.data + ei)
                                    if entry.name == ma.member_name:
                                        found_ft = entry.ty
                                        break
                                    ei += 1
                # Task[T] builtin struct fields (frame, ready, set_waiter,
                # release, take_result, cancel) are function pointers / void
                # pointers that must be accessed via struct field + indirect
                # call, not treated as methods.  `take_result` returns the
                # task's result type T; other vtable fields return void.
                #
                # In the monomorphized context, the Task may already be a
                # concrete struct like `ty_named("mt_task_int")` — detect it
                # by the `mt_task_` prefix or `ty_generic("Task", ...)`.
                var is_task = false
                var task_ret_ty = ctx.void_ty
                match recv_ty:
                    types.Type.ty_generic as tg:
                        if tg.name == "Task" and tg.args.len >= 1:
                            is_task = true
                            unsafe:
                                task_ret_ty = read(tg.args.data + 0)
                    types.Type.ty_named as tn:
                        if tn.name.starts_with("mt_task_"):
                            is_task = true
                            let gi_ptr = generic_instance_get(ctx, tn.name)
                            if gi_ptr != null:
                                let gi = unsafe: read(gi_ptr)
                                if gi.concrete_args.len >= 1:
                                    unsafe:
                                        task_ret_ty = read(gi.concrete_args.data + 0)
                    types.Type.ty_imported as im:
                        if im.name.starts_with("mt_task_"):
                            is_task = true
                            let gi_ptr = generic_instance_get(ctx, im.name)
                            if gi_ptr != null:
                                let gi = unsafe: read(gi_ptr)
                                if gi.concrete_args.len >= 1:
                                    unsafe:
                                        task_ret_ty = read(gi.concrete_args.data + 0)
                    _:
                        pass
                if is_task and ma.member_name == "frame":
                    found_ft = ctx.ptr_void_ty
                else if is_task and is_task_fn_field(ma.member_name):
                    # The host's `Types::Task#fields` (`types.rb:590-632`):
                    # `ready` returns bool, `take_result` returns T, every other
                    # vtable field returns void; `set_waiter` takes
                    # `(frame, waiter_frame, waiter)`.
                    var ret = ctx.void_ty
                    if ma.member_name == "ready":
                        ret = ctx.bool_ty
                    else if ma.member_name == "take_result":
                        ret = task_ret_ty
                    if ma.member_name == "set_waiter":
                        let waiter_ty = types.Type.ty_function(name = "", params = single_ty_span(ctx.ptr_void_ty),
                            return_type = types.alloc_type(ctx.void_ty),
                            variadic = false,
                            is_proc = false,
                            param_names = sp_str("frame"),
                        )
                        var params = vec.Vec[types.Type].create()
                        params.push(ctx.ptr_void_ty)
                        params.push(ctx.ptr_void_ty)
                        params.push(waiter_ty)
                        var pnames = vec.Vec[str].create()
                        pnames.push("frame")
                        pnames.push("waiter_frame")
                        pnames.push("waiter")
                        found_ft = types.Type.ty_function(name = "", params = params.as_span(),
                            return_type = types.alloc_type(ctx.void_ty),
                            variadic = false,
                            is_proc = false,
                            param_names = pnames.as_span(),
                        )
                    else:
                        found_ft = types.Type.ty_function(name = "", params = single_ty_span(ctx.ptr_void_ty),
                            return_type = types.alloc_type(ret),
                            variadic = false,
                            is_proc = false,
                            param_names = sp_str("frame"),
                        )
                # A proc-typed field may be typed either as a `ty_function` with
                # `is_proc` or as the shared proc struct it resolves to, so test
                # the type rather than the variant: both must call through the
                # closure's `invoke`/`env` rather than a same-named method.
                if is_proc_type(found_ft):
                    let recv_ir = lower_expr(ctx, ma.receiver)
                    let field_expr = alloc_expr(ir.Expr.expr_member(receiver = recv_ir, member = ma.member_name, ty = found_ft))
                    return lower_proc_field_call(ctx, field_expr, args, call_ep)
                match found_ft:
                    types.Type.ty_function:
                        let recv_ir = lower_expr(ctx, ma.receiver)
                        let field_expr = alloc_expr(ir.Expr.expr_member(receiver = recv_ir, member = ma.member_name, ty = found_ft))
                        return lower_fn_field_call(ctx, field_expr, args, call_ep)
                    _:
                        pass
                var recv_type_name = named_type_name(recv_ty)
                if recv_type_name.is_none():
                    recv_type_name = try_spec_type_name(ma.receiver)
                let recv_name = recv_type_name else:
                    let fn_c_name = naming.qualified_member_c_name(ctx.module_name, "mt", ma.member_name)
                    var ir_args = vec.Vec[ir.Expr].create()
                    let recv_ir = lower_expr(ctx, ma.receiver)
                    unsafe:
                        ir_args.push(read(recv_ir))
                    var si: ptr_uint = 0
                    while si < args.len:
                        var arg: ast.Argument
                        unsafe:
                            arg = read(args.data + si)
                        let lowered = lower_expr(ctx, arg.arg_value)
                        unsafe:
                            ir_args.push(read(lowered))
                        si += 1
                    return alloc_expr(ir.Expr.expr_call(callee = fn_c_name, arguments = ir_args.as_span(), ty = expr_type(ctx, call_ep)))
                # Method found — try method resolution with the recovered type name.
                var resolved_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = recv_name)
                match resolve_method_info(ctx, resolved_ty, ma.member_name):
                    Option.some as mi:
                        return lower_method_resolved(ctx, mi.value, ma.receiver, args, call_ep)
                    Option.none:
                        let fn_c_name = naming.qualified_member_c_name(ctx.module_name, recv_name, ma.member_name)
                        let recv_ir = lower_expr(ctx, ma.receiver)
                        var ir_args = vec.Vec[ir.Expr].create()
                        unsafe:
                            ir_args.push(read(recv_ir))
                        var si: ptr_uint = 0
                        while si < args.len:
                            var arg: ast.Argument
                            unsafe:
                                arg = read(args.data + si)
                            let lowered = lower_expr(ctx, arg.arg_value)
                            unsafe:
                                ir_args.push(read(lowered))
                            si += 1
                        return alloc_expr(ir.Expr.expr_call(callee = fn_c_name, arguments = ir_args.as_span(), ty = expr_type(ctx, call_ep)))
            ast.Expr.expr_index_access as ix:
                # Calling a proc held in an array or span element: `ops[i](args)`.
                # The element type comes from the receiver when the analyzer did
                # not record one for the index expression.
                var elem_ty = expr_type(ctx, callee)
                if not is_proc_type(elem_ty):
                    elem_ty = generic_first_arg(index_receiver_type(ctx, ix.receiver))
                if is_proc_type(elem_ty):
                    let elem_recv = lower_expr(ctx, callee)
                    return lower_proc_field_call(ctx, elem_recv, args, call_ep)
                return alloc_expr(ir.Expr.expr_zero_init(ty = ctx.void_ty))
            _:
                # Call through a callable *value* expression (e.g. a chain call
                # `f(a)(b)`): the host lowers the callee once and shares the node
                # in the `invoke` callee and the `env` argument.
                let callee_expr = lower_expr(ctx, callee)
                let callee_ty = ir_expr_type(callee_expr)
                if is_proc_type(callee_ty):
                    let void_ptr = ctx.ptr_void_ty
                    let env_member = alloc_expr(ir.Expr.expr_member(receiver = callee_expr, member = "env", ty = void_ptr))
                    var invoke_args = vec.Vec[ir.Expr].create()
                    unsafe:
                        invoke_args.push(read(env_member))
                    var ai: ptr_uint = 0
                    while ai < args.len:
                        let arg = unsafe: read(args.data + ai)
                        var lowered = lower_expr(ctx, arg.arg_value)
                        lowered = literal_value_to_context_type(ctx, arg.arg_value, proc_param_type_at(callee_ty, ai), lowered)
                        unsafe:
                            invoke_args.push(read(lowered))
                        ai += 1
                    var call_ty = expr_type(ctx, call_ep)
                    if is_void_type(call_ty) or types.is_error(call_ty) or is_proc_type(call_ty):
                        call_ty = proc_return_type(callee_ty)
                    let invoke_field = alloc_expr(ir.Expr.expr_member(receiver = callee_expr, member = "invoke", ty = proc_invoke_field_type(callee_ty)))
                    return alloc_expr(ir.Expr.expr_call_indirect(callee = invoke_field, arguments = invoke_args.as_span(), ty = call_ty))
                if is_fn_type(callee_ty):
                    return lower_call_with_callee_expr(ctx, callee_expr, args, call_ep, types.alloc_type(expr_type(ctx, call_ep)), empty_fn_sig())
                return alloc_expr(ir.Expr.expr_zero_init(ty = ctx.void_ty))


## The result type of a cross-module call, resolved from the shared program-wide
## return map (keyed by C linkage name), falling back to the analyzer's recorded
## type for the call expression.
function cross_module_return_type(ctx: ref[LowerCtx], c_name: str, call_ep: ptr[ast.Expr]) -> types.Type:
    var ret_ty = types.Type.ty_error
    let fp = ctx.function_returns.get(c_name)
    if fp != null:
        unsafe:
            ret_ty = read(fp)
        if not types.is_error(ret_ty):
            return ret_ty
    unsafe:
        var pr = read(ctx.program_returns)
        let rp = pr.get(c_name)
        if rp != null:
            ret_ty = read(rp)
    if not types.is_error(ret_ty):
        # The analyzer's imported binding for an async function carries
        # `Task[declared]` as its return type (`function_binding.rb:183`), so the
        # call node is Task-wrapped — including for prelude `Result`/`Option`
        # returns.
        if is_cross_module_function_async(ctx, c_name):
            ret_ty = make_task_type(ret_ty)
        return ret_ty
    let sc = ctx.specialization_cache.get(c_name)
    if sc != null:
        unsafe:
            ret_ty = read(sc).return_type
        if not types.is_error(ret_ty):
            return ret_ty
    return expr_type(ctx, call_ep)


function is_cross_module_function_async(ctx: ref[LowerCtx], c_name: str) -> bool:
    var ai: ptr_uint = 0
    while ai < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + ai)
        var di: ptr_uint = 0
        while di < a.source_file.declarations.len:
            var d: ast.Decl
            unsafe:
                d = read(a.source_file.declarations.data + di)
            match d:
                ast.Decl.decl_function as fun:
                    if naming.qualified_c_name(a.module_name, fun.name) == c_name:
                        return fun.is_async
                _:
                    pass
            di += 1
        ai += 1
    return false


## Lower a specialized call `Name[TypeArgs](args)`, including the built-in
## `span[T](data = ..., len = ...)` constructor, `adapt[I](value)`, and generic
## aggregate literals.  Generic function-call monomorphization is handled in
## `lower_monomorphized_call`.
function lower_specialization_call(ctx: ref[LowerCtx], spec_callee: ptr[ast.Expr], type_args: span[ast.TypeArgument], call_args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    unsafe:
        match read(spec_callee):
            ast.Expr.expr_identifier as id:
                if id.name == "span" and type_args.len == 1:
                    var elem_args = vec.Vec[types.Type].create()
                    elem_args.push(resolve_type_ref(ctx, read(type_args.data + 0).value))
                    let span_ty = types.Type.ty_generic(name = "span", args = elem_args.as_span())
                    var fields = vec.Vec[ir.AggregateField].create()
                    var i: ptr_uint = 0
                    while i < call_args.len:
                        let arg = read(call_args.data + i)
                        let field_name = arg.arg_name else:
                            fatal(c"lowering: span construction requires named fields")
                        var field_value = lower_expr(ctx, arg.arg_value)
                        # `.len` is a ptr_uint field, so an integer literal is
                        # re-typed to ptr_uint (matching the host).
                        if field_name == "len":
                            field_value = int_literal_to_context_type(arg.arg_value, types.primitive("ptr_uint"), field_value)
                        fields.push(ir.AggregateField(name = field_name, value = field_value))
                        i += 1
                    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = span_ty, fields = fields.as_span()))
                if id.name == "adapt" and type_args.len == 1:
                    return lower_adapt_call(ctx, read(type_args.data + 0).value, call_args)
                if id.name == "array" and type_args.len == 2:
                    let element_ty = resolve_type_ref(ctx, read(type_args.data + 0).value)
                    var array_args = vec.Vec[types.Type].create()
                    array_args.push(element_ty)
                    array_args.push(resolve_array_length_type(ctx, read(type_args.data + 1).value))
                    let array_ty = types.Type.ty_generic(name = "array", args = array_args.as_span())
                    var elements = vec.Vec[ir.Expr].create()
                    var elem_fold_env = map_mod.Map[str, ptr[ir.Expr]].create()
                    var ai: ptr_uint = 0
                    while ai < call_args.len:
                        let arg = read(call_args.data + ai)
                        # Elements take the element type contextually, as the
                        # host's `lower_contextual_expression` gives it to them:
                        # `array[ubyte, 4](0, 0, 0, 0)` keeps ubyte elements.
                        var element_value = lower_expr(ctx, arg.arg_value)
                        element_value = int_literal_to_context_type(arg.arg_value, element_ty, element_value)
                        element_value = float_literal_to_context_type(arg.arg_value, element_ty, element_value)
                        element_value = null_literal_to_context_type(arg.arg_value, element_ty, element_value)
                        # The host folds a *scalar-shaped* compile-time constant
                        # element (`int<-Kind.A` → 0, `-1` → -1, `1 + 2` → 3,
                        # an imported constant → its aggregate); an aggregate
                        # element (a struct literal and its fields) is lowered
                        # normally, and a bare literal keeps the contextual
                        # retyping above (`array[ubyte, 4](0, …)`).
                        var element_foldable = false
                        unsafe:
                            match read(element_value):
                                ir.Expr.expr_name:
                                    element_foldable = true
                                ir.Expr.expr_cast:
                                    element_foldable = true
                                ir.Expr.expr_unary:
                                    element_foldable = true
                                ir.Expr.expr_binary:
                                    element_foldable = true
                                _:
                                    pass
                        if element_foldable:
                            match try_const_value_ir(ctx, arg.arg_value, ref_of(elem_fold_env)):
                                Option.some as folded:
                                    element_value = folded.value
                                Option.none:
                                    pass
                        # A `char` element casts its integer literal (`array[char,
                        # 512](0, …)` — the host's `contextual_numeric_cast` char
                        # arm), applied after the fold so it is not folded away.
                        if prim_name(element_ty) == "char" and is_integer_like_value_type(ctx, ir_expr_type(element_value)):
                            element_value = cast_to_type(element_value, element_ty)
                        elements.push(read(element_value))
                        ai += 1
                    return alloc_expr(ir.Expr.expr_array_literal(ty = array_ty, elements = elements.as_span()))
                if id.name == "simd" and type_args.len == 2:
                    let simd_element_ty = resolve_type_ref(ctx, read(type_args.data + 0).value)
                    var simd_args = vec.Vec[types.Type].create()
                    simd_args.push(simd_element_ty)
                    simd_args.push(resolve_array_length_type(ctx, read(type_args.data + 1).value))
                    let simd_ty = types.Type.ty_generic(name = "simd", args = simd_args.as_span())
                    var simd_elements = vec.Vec[ir.Expr].create()
                    var sei: ptr_uint = 0
                    while sei < call_args.len:
                        let arg = read(call_args.data + sei)
                        var element_value = lower_expr(ctx, arg.arg_value)
                        element_value = int_literal_to_context_type(arg.arg_value, simd_element_ty, element_value)
                        element_value = float_literal_to_context_type(arg.arg_value, simd_element_ty, element_value)
                        simd_elements.push(read(element_value))
                        sei += 1
                    return alloc_expr(ir.Expr.expr_array_literal(ty = simd_ty, elements = simd_elements.as_span()))
                if id.name == "str_buffer" and type_args.len == 1:
                    let n_ty = resolve_type_ref(ctx, read(type_args.data + 0).value)
                    let sb_ty = types.Type.ty_generic(name = "str_buffer", args = sp_type(n_ty))
                    ensure_str_buffer_struct(ctx, sb_ty)
                    return alloc_expr(ir.Expr.expr_zero_init(ty = sb_ty))
                # Builtin generic callables: order[T], equal[T], hash[T] — lower
                # to direct C calls with a fixed suffix derived from the type.
                if id.name == "order" or id.name == "equal" or id.name == "hash":
                    var hook_ty = ctx.void_ty
                    if type_args.len >= 1:
                        hook_ty = qualify_type(ctx, resolve_type_ref(ctx, read(type_args.data + 0).value))
                    let ptr_target = types.Type.ty_generic(name = "const_ptr", args = sp_type(hook_ty))
                    var ir_args = vec.Vec[ir.Expr].create()
                    var si: ptr_uint = 0
                    while si < call_args.len:
                        var arg: ast.Argument
                        unsafe:
                            arg = read(call_args.data + si)
                        let lowered = lower_expr(ctx, arg.arg_value)
                        let arg_ty = ir_expr_type(lowered)
                        # The hooks take `const_ptr[T]` (the host's
                        # `lower_hash_operation_argument`): a pointer/ref value
                        # is cast to that target, a `*p` operand is cast, and an
                        # addressable value is borrowed.
                        var hook_arg = lowered
                        if types.is_raw_pointer(arg_ty) or types.is_ref_type(arg_ty):
                            if not types.type_equals(arg_ty, ptr_target):
                                hook_arg = alloc_expr(ir.Expr.expr_cast(target_type = ptr_target, expression = lowered, ty = ptr_target))
                        else:
                            var addressed = true
                            unsafe:
                                match read(lowered):
                                    ir.Expr.expr_unary as un:
                                        if un.operator == "*":
                                            addressed = false
                                            let op_ty = ir_expr_type(un.operand)
                                            if types.type_equals(op_ty, ptr_target):
                                                hook_arg = un.operand
                                            else:
                                                hook_arg = alloc_expr(ir.Expr.expr_cast(target_type = ptr_target, expression = un.operand, ty = ptr_target))
                                    _:
                                        pass
                            if addressed:
                                hook_arg = alloc_expr(ir.Expr.expr_address_of(expression = lowered, ty = ptr_target))
                        unsafe:
                            ir_args.push(read(hook_arg))
                        si += 1
                    var ret_ty = types.primitive("int")
                    if id.name == "equal":
                        ret_ty = ctx.bool_ty
                    else if id.name == "hash":
                        ret_ty = types.primitive("uint")
                    # Resolve the canonical hook (`T.hash` / `T.equal` / `T.order`)
                    # for the type argument to its concrete C function name.
                    if type_args.len >= 1:
                        let t_ty = qualify_type(ctx, resolve_type_ref(ctx, read(type_args.data + 0).value))
                        match resolve_canonical_hook(ctx, t_ty, id.name):
                            Option.some as hook_name:
                                return alloc_expr(ir.Expr.expr_call(callee = hook_name.value, arguments = ir_args.as_span(), ty = ret_ty))
                            Option.none:
                                pass
                    let fn_name = j2("mt_", j2(id.name, "_func"))
                    return alloc_expr(ir.Expr.expr_call(callee = fn_name, arguments = ir_args.as_span(), ty = ret_ty))
                # Builtin `reinterpret[T](value)` → `IR::ReinterpretExpr` (the
                # host always emits the bit reinterpret; the C backend copies
                # the bits instead of a numeric cast, so `reinterpret[uint](f)`
                # yields the IEEE bits rather than `(uint)f`).
                if id.name == "reinterpret" and type_args.len == 1:
                    let target_ty = qualify_type(ctx, resolve_type_ref(ctx, read(type_args.data + 0).value))
                    let arg = unsafe: read(call_args.data + 0)
                    let lowered = lower_expr(ctx, arg.arg_value)
                    var source_ty = ir_expr_type(lowered)
                    # The host infers the argument through its lowering env, so
                    # a guarded local carries its narrowed type (`p` after
                    # `if p == null: return` is `ptr[void]`, not `ptr[void]?`)
                    # and an unrefined one its storage type.
                    match unsafe: read(arg.arg_value):
                        ast.Expr.expr_identifier as aid:
                            match visible_local_type(ctx, aid.name):
                                Option.some as visible:
                                    source_ty = visible.value
                                Option.none:
                                    pass
                        _:
                            pass
                    return alloc_expr(ir.Expr.expr_reinterpret(target_type = target_ty, source_type = source_ty, expression = lowered, ty = target_ty))
                # Builtin `zero[T]` → zero-initialized value of type T.
                if id.name == "zero" and type_args.len == 1:
                    let z_ty = qualify_type(ctx, resolve_type_ref(ctx, read(type_args.data + 0).value))
                    return alloc_expr(ir.Expr.expr_zero_init(ty = z_ty))
                # Builtin `default[T]` → call T.default(), the zero-argument
                # static method on the type.  The method must exist at check time
                # (the analyzer already verified it).
                if id.name == "default" and type_args.len == 1 and call_args.len == 0:
                    let t_ty = qualify_type(ctx, resolve_type_ref(ctx, read(type_args.data + 0).value))
                    match resolve_method_info(ctx, t_ty, "default"):
                        Option.some as smi:
                            if smi.value.method_kind == ast.MethodKind.mk_static:
                                var nil_receiver = alloc_expr(ir.Expr.expr_null_literal(ty = t_ty))
                                return lower_static_call_args(ctx, smi.value, call_args)
                        Option.none:
                            pass
                if (
                    id.name == "attribute_arg" or id.name == "attribute_of"
                    or id.name == "field_of" or id.name == "callable_of"
                    or id.name == "fields_of" or id.name == "members_of"
                    or id.name == "attributes_of" or id.name == "has_attribute"
                    or id.name == "adapt"
                ) and type_args.len >= 1:
                    # `attribute_arg[T](attribute_of(field_of(Type, field), attr),
                    # name)` folds to the attribute's argument literal.
                    if id.name == "attribute_arg":
                        var attr_env = map_mod.Map[str, ptr[ir.Expr]].create()
                        match try_const_attribute_arg_ir(ctx, type_args, call_args, ref_of(attr_env)):
                            Option.some as attr_val:
                                return attr_val.value
                            Option.none:
                                pass
                    let z_ty = qualify_type(ctx, resolve_type_ref(ctx, read(type_args.data + 0).value))
                    return alloc_expr(ir.Expr.expr_zero_init(ty = z_ty))
                # Generic struct constructor, e.g. `Pair[int, int](first = 42, ...)`.
                # Check current module's structs first, then imported modules'
                # (structs referenced in monomorphized generic bodies may be
                # defined in a separate module).
                if all_call_args_named(call_args):
                    if ctx.analysis.structs.contains(id.name):
                        return lower_generic_aggregate_literal(ctx, id.name, type_args, call_args)
                    if struct_exists_in_imports(ctx, id.name):
                        return lower_generic_aggregate_literal(ctx, id.name, type_args, call_args)
            ast.Expr.expr_member_access as ma:
                match read(ma.receiver):
                    ast.Expr.expr_identifier as recv_id:
                        if ctx.analysis.imports.contains(recv_id.name) and all_call_args_named(call_args):
                            return lower_generic_aggregate_literal(ctx, ma.member_name, type_args, call_args)
                    _:
                        pass
                # Member-access specialization: e.g., `vec.Vec[string.String].create()`.
                # Route through method resolution with the concrete type from type args.
                var recv_ty = expr_type_for_spec(ctx, spec_callee, type_args)
                match try_generic_method_call(ctx, recv_ty, ma.member_name, ma.receiver, call_args, call_ep):
                    Option.some as gen_call:
                        return gen_call.value
                    Option.none:
                        pass
                match resolve_method_info(ctx, recv_ty, ma.member_name):
                    Option.some as mi:
                        return lower_method_resolved(ctx, mi.value, ma.receiver, call_args, call_ep)
                    Option.none:
                        pass
            _:
                pass
    # Generic function call, e.g. `first[int](p)`.  Lower a monomorphized copy of
    # the generic function body with concrete type arguments and emit a call to it.
    return lower_monomorphized_call(ctx, spec_callee, type_args, call_args, call_ep)


function resolve_method_return_from_import(ctx: ref[LowerCtx], module_name: str, sig: analyzer.FnSig, receiver_ty: types.Type) -> types.Type:
    var ret = sig.return_type
    if not sig.has_return_type:
        ret = ctx.void_ty
    match ret:
        types.Type.ty_named as rn:
            match receiver_ty:
                types.Type.ty_imported as rim:
                    if rim.args.len > 0:
                        ret = types.Type.ty_imported(module_name = module_name, name = rn.name, args = rim.args)
                    else:
                        ret = types.Type.ty_imported(module_name = module_name, name = rn.name, args = span[types.Type]())
                _:
                    ret = types.Type.ty_imported(module_name = module_name, name = rn.name, args = span[types.Type]())
        _:
            pass
    return qualify_type(ctx, ret)


function is_read_call(ep: ptr[ast.Expr]) -> Option[ptr[ast.Expr]]:
    unsafe:
        match read(ep):
            ast.Expr.expr_call as call:
                match read(call.callee):
                    ast.Expr.expr_identifier as id:
                        if id.name == "read" and call.args.len == 1:
                            return Option[ptr[ast.Expr]].some(value = read(call.args.data + 0).arg_value)
                    _:
                        pass
            _:
                pass
    return Option[ptr[ast.Expr]].none


function all_call_args_named(args: span[ast.Argument]) -> bool:
    if args.len == 0:
        return false
    var i: ptr_uint = 0
    while i < args.len:
        let arg = unsafe: read(args.data + i)
        if arg.arg_name.is_none():
            return false
        i += 1
    return true


## Build the concrete type for a specialized member access, e.g.
## `expr_member_access(receiver = "vec", member = "Vec")` with type args
## `[string.String]` produces `ty_generic("Vec", [ty_imported("String")])`.
function expr_type_for_spec(ctx: ref[LowerCtx], spec_callee: ptr[ast.Expr], type_args: span[ast.TypeArgument]) -> types.Type:
    unsafe:
        match read(spec_callee):
            ast.Expr.expr_member_access as ma:
                var concrete = vec.Vec[types.Type].create()
                var i: ptr_uint = 0
                while i < type_args.len:
                    concrete.push(resolve_type_ref(ctx, read(type_args.data + i).value))
                    i += 1
                return types.Type.ty_generic(name = ma.member_name, args = concrete.as_span())
            _:
                return types.Type.ty_error


## Lower a generic struct constructor `Name[TypeArgs](field = value, ...)` to an IR
## aggregate literal with the concrete type arguments resolved.
## The resolved field type of a generic struct instance (e.g. the `index` field
## of `Indexed[int]` is `ptr_uint`).  `concrete_args` are the instance's type
## arguments; returns none when the struct or field is unknown.
function generic_struct_field_type(ctx: ref[LowerCtx], struct_name: str, concrete_args: span[types.Type], field_name: str, owner_module: str) -> Option[types.Type]:
    let unqualified = generic_struct_c_name(struct_name, concrete_args)
    let decl_ptr = ctx.generic_struct_decls.get(unqualified)
    if decl_ptr != null:
        unsafe:
            let decl = read(decl_ptr)
            var fi: ptr_uint = 0
            while fi < decl.fields.len:
                let f = read(decl.fields.data + fi)
                if f.name == field_name:
                    return Option[types.Type].some(value = f.ty)
                fi += 1
    # A concrete generic struct instance is registered under the name of the
    # module that *defines* the struct (`std_net_sync_SyncValue_uint`), not the
    # caller's module.
    let decl_module = if owner_module.len > 0: owner_module else: ctx.module_name
    let q_ptr = ctx.generic_struct_decls.get(naming.qualified_c_name(decl_module, unqualified))
    if q_ptr != null:
        unsafe:
            let decl = read(q_ptr)
            var fi: ptr_uint = 0
            while fi < decl.fields.len:
                let f = read(decl.fields.data + fi)
                if f.name == field_name:
                    return Option[types.Type].some(value = f.ty)
                fi += 1
    return Option[types.Type].none


function lower_generic_aggregate_literal(ctx: ref[LowerCtx], struct_name: str, type_args: span[ast.TypeArgument], call_args: span[ast.Argument]) -> ptr[ir.Expr]:
    var concrete_args = vec.Vec[types.Type].create()
    var i: ptr_uint = 0
    while i < type_args.len:
        unsafe:
            concrete_args.push(resolve_type_ref(ctx, read(type_args.data + i).value))
        i += 1
    let ty = types.Type.ty_generic(name = struct_name, args = concrete_args.as_span())
    # Qualify the constructed type so its C name is module-prefixed
    # (`std_vec_Vec_int`), matching the type produced by `qualify_type` for the
    # same instance elsewhere; this also emits the concrete struct declaration.
    let result_ty = qualify_type(ctx, types.Type.ty_generic(name = struct_name, args = concrete_args.as_span()))
    # Ensure the concrete struct declaration exists before looking up field
    # types (the constructor may be the first use of the instance).
    var qualified_args = concrete_args.as_span()
    var owner_module = ""
    match result_ty:
        types.Type.ty_imported as rim:
            owner_module = rim.module_name
            if rim.args.len > 0:
                qualified_args = rim.args
        _:
            pass
    var fields = vec.Vec[ir.AggregateField].create()
    i = 0
    while i < call_args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(call_args.data + i)
        let field_name = arg.arg_name else:
            fatal(c"lowering: generic struct construction requires named fields")
        var field_value = lower_expr(ctx, arg.arg_value)
        # Re-type an integer literal whose value fits the field type (matching
        # the host's contextual numeric literal inference).
        match generic_struct_field_type(ctx, struct_name, qualified_args, field_name, owner_module):
            Option.some as field_ty:
                field_value = int_literal_to_context_type(arg.arg_value, field_ty.value, field_value)
                field_value = null_literal_to_context_type(arg.arg_value, field_ty.value, field_value)
            Option.none:
                pass
        fields.push(ir.AggregateField(name = field_name, value = field_value))
        i += 1
    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = result_ty, fields = fields.as_span()))


## Ensure a concrete struct declaration exists for a generic struct specialized
## with concrete type arguments.  If not yet registered, build one by resolving
## the original struct's fields with type substitution.
function ensure_generic_struct_decl(ctx: ref[LowerCtx], struct_name: str, type_args: span[ast.TypeArgument], concrete_args: span[types.Type]) -> void:
    ensure_generic_struct_decl_named(ctx, struct_name, type_args, concrete_args, generic_struct_c_name(struct_name, concrete_args))


## Like `ensure_generic_struct_decl` but uses `decl_name` as the struct
## declaration name (for module-qualified naming of imported generic types).
function ensure_generic_struct_decl_named(ctx: ref[LowerCtx], struct_name: str, type_args: span[ast.TypeArgument], concrete_args: span[types.Type], decl_name: str) -> void:
    if ctx.generic_struct_decls.contains(decl_name):
        return
    # Guard against recursive monomorphization: when Node's `next` field
    # triggers another monomorphization of Node[str, bool], skip.
    if ctx.spec_in_progress.contains(decl_name):
        return
    ctx.spec_in_progress.set(decl_name, true)
    # Search the current module's AST first, then imported modules.  Track the
    # module the struct was found in so the registered instance carries an
    # authoritative owner module for C-name mangling.
    var found_module: str = ctx.module_name
    var fields_opt = extract_generic_struct_fields(ctx, ctx.analysis, struct_name, concrete_args)
    if fields_opt.is_none():
        # Try each imported module.
        var import_values = ctx.analysis.imports.values()
        var found_once = false
        while not found_once:
            let target_ptr = import_values.next() else:
                break
            let target_module = unsafe: read(target_ptr)
            match find_imported_analysis(ctx, target_module):
                Option.some as imported:
                    fields_opt = extract_generic_struct_fields(ctx, imported.value, struct_name, concrete_args)
                    if fields_opt.is_some():
                        found_once = true
                        found_module = target_module
                Option.none:
                    pass
    if fields_opt.is_none():
        # Last resort: search every program analysis.  See the matching
        # fallback in `try_monomorphize_generic`.
        var pai: ptr_uint = 0
        while pai < ctx.program_analyses.len:
            if fields_opt.is_some():
                break
            var pa: analyzer.Analysis
            unsafe:
                pa = read(ctx.program_analyses.data + pai)
            match extract_generic_struct_fields(ctx, pa, struct_name, concrete_args):
                Option.some as pf:
                    fields_opt = Option[span[ir.Field]].some(value = pf.value)
                    found_module = pa.module_name
                Option.none:
                    pass
            pai += 1
    match fields_opt:
        Option.some as f:
            ctx.generic_struct_decls.set(decl_name, ir.StructDecl(
                name = decl_name,
                linkage_name = decl_name,
                fields = f.value,
                packed = false,
                alignment = 0,
                source_module = Option[str].none,
            ))
            generic_instance_set(ctx, decl_name, GenericReceiver(owner_name = struct_name, concrete_args = concrete_args, owner_module = found_module))
        Option.none:
            pass


## Extract and type-substitute the fields of a generic struct from a given
## module's AST.  Returns None if the struct declaration is not found.
function extract_generic_struct_fields(ctx: ref[LowerCtx], module_analysis: analyzer.Analysis, struct_name: str, concrete_args: span[types.Type]) -> Option[span[ir.Field]]:
    var found = false
    var ir_fields = vec.Vec[ir.Field].create()
    var di: ptr_uint = 0
    while di < module_analysis.source_file.declarations.len and not found:
        var d: ast.Decl
        unsafe:
            d = read(module_analysis.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_struct as s:
                if s.name == struct_name:
                    found = true
                    var sub = map_mod.Map[str, types.Type].create()
                    var spi: ptr_uint = 0
                    while spi < s.type_params.len and spi < concrete_args.len:
                        unsafe:
                            sub.set(read(s.type_params.data + spi).name, read(concrete_args.data + spi))
                        spi += 1
                    var fi: ptr_uint = 0
                    var saved_type_subst = ctx.type_substitution
                    var saved_analysis = ctx.analysis
                    var saved_module = ctx.module_name
                    ctx.type_substitution = sub
                    # Field types resolve in the struct's OWN module: an
                    # imported generic struct's field (`values: Vec[T]`) must
                    # monomorphize against the modules that module imports.
                    ctx.analysis = module_analysis
                    ctx.module_name = module_analysis.module_name
                    while fi < s.struct_fields.len:
                        var f: ast.Field
                        unsafe:
                            f = read(s.struct_fields.data + fi)
                        let raw_ty = resolve_field_type_ref(ctx, f.field_type)
                        let field_ty = substitute_type_params(ctx, raw_ty, ref_of(sub))
                        ir_fields.push(ir.Field(name = f.name, ty = qualify_type(ctx, field_ty)))
                        fi += 1
                    ctx.type_substitution = saved_type_subst
                    ctx.analysis = saved_analysis
                    ctx.module_name = saved_module
            _:
                pass
        di += 1
    if not found:
        return Option[span[ir.Field]].none
    return Option[span[ir.Field]].some(value = ir_fields.as_span())


## Ensure a concrete declaration exists for a user-defined generic variant
## instance (`Outcome[int, EngineError]` from `engine.types`).  Mirrors
## `extract_generic_struct_fields`: the arms' field types resolve in the
## DECLARING module with the type parameters substituted, and the instance is
## pushed onto `pending_generic_variants` — the collection that reaches
## `Program.monomorphized_variants`.  Without it a generic variant instance is
## referenced by its mangled C name but never declared.
## Returns true when `variant_name` is a generic variant declared in
## `module_analysis`; `decl_name` is the instance's C name.
function ensure_generic_variant_decl(ctx: ref[LowerCtx], module_analysis: analyzer.Analysis, variant_name: str, concrete_args: span[types.Type], decl_name: str) -> bool:
    var vi: ptr_uint = 0
    while vi < ctx.pending_generic_variants.len():
        let vp = ctx.pending_generic_variants.get(vi) else:
            break
        unsafe:
            if read(vp).linkage_name == decl_name:
                return true
        vi += 1
    var found = false
    var di: ptr_uint = 0
    while di < module_analysis.source_file.declarations.len and not found:
        var d: ast.Decl
        unsafe:
            d = read(module_analysis.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_variant as vr:
                if vr.name == variant_name and vr.type_params.len > 0:
                    found = true
                    var sub = map_mod.Map[str, types.Type].create()
                    var spi: ptr_uint = 0
                    while spi < vr.type_params.len and spi < concrete_args.len:
                        unsafe:
                            sub.set(read(vr.type_params.data + spi).name, read(concrete_args.data + spi))
                        spi += 1
                    var saved_type_subst = ctx.type_substitution
                    var saved_analysis = ctx.analysis
                    var saved_module = ctx.module_name
                    ctx.type_substitution = sub
                    ctx.analysis = module_analysis
                    ctx.module_name = module_analysis.module_name
                    var arms = vec.Vec[ir.VariantArm].create()
                    var ai: ptr_uint = 0
                    while ai < vr.variant_arms.len:
                        var arm: ast.VariantArm
                        unsafe:
                            arm = read(vr.variant_arms.data + ai)
                        var fields = vec.Vec[ir.Field].create()
                        var fi: ptr_uint = 0
                        while fi < arm.arm_fields.len:
                            var f: ast.Field
                            unsafe:
                                f = read(arm.arm_fields.data + fi)
                            let raw_ty = resolve_field_type_ref(ctx, f.field_type)
                            let field_ty = substitute_type_params(ctx, raw_ty, ref_of(sub))
                            fields.push(ir.Field(name = f.name, ty = qualify_type(ctx, field_ty)))
                            fi += 1
                        arms.push(ir.VariantArm(name = arm.name, linkage_name = variant_arm_c_name(decl_name, arm.name), fields = fields.as_span()))
                        # Register the instance's arm payload fields under its C
                        # name so member access on a match binding of this
                        # instance resolves its field types.
                        if fields.len() > 0:
                            var field_names = vec.Vec[str].create()
                            var field_types = vec.Vec[types.Type].create()
                            var rfi: ptr_uint = 0
                            while rfi < fields.len():
                                let rf_ptr = fields.get(rfi) else:
                                    break
                                unsafe:
                                    let rf = read(rf_ptr)
                                    field_names.push(rf.name)
                                    field_types.push(rf.ty)
                                rfi += 1
                            ctx.arm_payload_fields.set(variant_arm_c_name(decl_name, arm.name), VariantArmInfo(name = arm.name, field_names = field_names.as_span(), field_types = field_types.as_span()))
                        ai += 1
                    ctx.type_substitution = saved_type_subst
                    ctx.analysis = saved_analysis
                    ctx.module_name = saved_module
                    ctx.pending_generic_variants.push(ir.VariantDecl(name = decl_name, linkage_name = decl_name, arms = arms.as_span(), source_module = Option[str].none))
            _:
                pass
        di += 1
    return found


function is_pointer_or_ref_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_generic as g:
            return g.name == "ptr" or g.name == "const_ptr" or g.name == "own" or g.name == "ref"
        types.Type.ty_nullable as nl:
            return is_pointer_or_ref_type(unsafe: read(nl.base))
        _:
            return false


## True when an IR expression denotes a pointer value.  Besides pointer-like
## types, a `pointer`-flagged name can hold a base-typed pointer (e.g. `this` in
## an editable method, or a pointer-lowered receiver) — the C `*` is implied.
function ir_expr_is_pointer(e: ptr[ir.Expr]) -> bool:
    if is_pointer_or_ref_type(ir_expr_type(e)):
        return true
    unsafe:
        match read(e):
            ir.Expr.expr_name as n:
                return n.pointer.unwrap_or(false)
            _:
                return false


## The value type produced by dereferencing an IR pointer expression: the
## element type for pointer-like types, or the expression's own (base) type for
## a `pointer`-flagged name.
function ir_expr_deref_type(e: ptr[ir.Expr]) -> types.Type:
    let t = ir_expr_type(e)
    if is_pointer_or_ref_type(t):
        return types.pointer_element(t)
    return t


## The type-constructor name ("ref", "ptr", "const_ptr") for a builtin
## address-of function, or an empty string when `func_name` is not one.
function builtin_addr_type_name(func_name: str) -> str:
    if func_name == "ref_of":
        return "ref"
    if func_name == "ptr_of":
        return "ptr"
    if func_name == "const_ptr_of":
        return "const_ptr"
    return ""


function is_raw_type_param_name(name: str) -> bool:
    return name == "T" or name == "U" or name == "K" or name == "V" or name == "E"


function sp_one(t: types.Type) -> span[types.Type]:
    var buf = vec.Vec[types.Type].create()
    buf.push(t)
    return buf.as_span()

function has_type_var_arg(args: span[types.Type]) -> bool:
    var i: ptr_uint = 0
    while i < args.len:
        var t: types.Type
        unsafe:
            t = read(args.data + i)
        if type_is_type_var(t):
            return true
        i += 1
    return false

function type_is_type_var(t: types.Type) -> bool:
    match t:
        types.Type.ty_var:
            return true
        types.Type.ty_named as n:
            if n.name == "T" or n.name == "K" or n.name == "V" or n.name == "U" or n.name == "E":
                return true
            return false
        types.Type.ty_imported as im:
            if im.name == "T" or im.name == "K" or im.name == "V" or im.name == "U" or im.name == "E":
                return true
            if im.args.len > 0:
                if has_type_var_arg(im.args):
                    return true
            return false
        types.Type.ty_generic as g:
            return has_type_var_arg(g.args)
        types.Type.ty_nullable as nl:
            return unsafe: type_is_type_var(read(nl.base))
        _:
            return false


## The C type name for a concrete generic struct: `Pair` + `int` + `int` →
## `Pair_int_int`.  Mirrors `generic_c_type`.
function generic_struct_c_name(name: str, args: span[types.Type]) -> str:
    var buf = string.String.create()
    buf.append(name)
    var i: ptr_uint = 0
    while i < args.len:
        buf.append("_")
        unsafe:
            buf.append(naming.type_c_key(read(args.data + i)))
        i += 1
    return buf.as_str()


## Lower a call to a generic function with concrete type arguments.  The generic
## function body is found in the module's declarations, type-substituted, and
## lowered.  The monomorphized copy is cached so subsequent calls to the same
## specialization reuse the already-lowered function.
function lower_monomorphized_call(ctx: ref[LowerCtx], callee: ptr[ast.Expr], type_args: span[ast.TypeArgument], call_args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    var callee_name: str
    # A module-qualified callee (`backend.wait[T](...)`) must resolve against the
    # aliased module, not a same-named generic in the caller's module.
    var restricted_module: Option[str] = Option[str].none
    unsafe:
        match read(callee):
            ast.Expr.expr_identifier as id:
                callee_name = id.name
            ast.Expr.expr_member_access as ma:
                callee_name = ma.member_name
                match read(ma.receiver):
                    ast.Expr.expr_identifier as rid:
                        let mod_ptr = ctx.analysis.imports.get(rid.name)
                        if mod_ptr != null:
                            restricted_module = Option[str].some(value = read(mod_ptr))
                    _:
                        pass
            _:
                fatal(c"lowering: unsupported generic callee")

    var gm_opt: Option[GenericFunctionMatch]
    match restricted_module:
        Option.some as rm:
            gm_opt = find_generic_function_in_module(ctx, rm.value, callee_name)
        Option.none:
            gm_opt = find_generic_function(ctx, callee_name)
    let gm = gm_opt else:
        if callee_name == "Task":
            return lower_task_constructor(ctx, type_args, call_args, call_ep)
        if ctx.loaded_modules.len <= 1:
            fatal(j2("lowering: monomorphization failed for ", callee_name))
        fatal(j2("lowering: could not find generic function decl for ", callee_name))

    # Name the specialization by its OWNER module so the same instance reached
    # from multiple caller modules dedups to one definition (see
    # dedup_append_functions).
    let spec_key = specialization_key(ctx, gm.module_name, callee_name, type_args)
    if not ctx.specialization_cache.contains(spec_key) and not ctx.spec_in_progress.contains(spec_key):
        lower_and_cache_specialization(ctx, gm, type_args, spec_key, ctx.pre_instantiated_context)
    else:
        note_validated_spec_reach(ctx, spec_key)
    let ret_ty = cross_module_return_type(ctx, spec_key, call_ep)
    var ret_type_ptr = types.alloc_type(ret_ty)
    return lower_plain_call_spec(ctx, spec_key, call_args, call_ep, ret_type_ptr, ctx.specialization_cache.get(spec_key))


## A generic function's AST declaration plus the module that defines it.
struct GenericFunctionMatch:
    module_name: str
    decl: ast.Decl


## Find a generic function declaration by name.  The current module is searched
## first (so same-module generics resolve to their own module), then all other
## analyses, then raw loaded modules as a fallback for functions whose analysis
## copy is incomplete.
function find_generic_function(ctx: ref[LowerCtx], callee_name: str) -> Option[GenericFunctionMatch]:
    match find_func_in_source(ctx.analysis.source_file, callee_name):
        Option.some as d:
            return Option[GenericFunctionMatch].some(value = GenericFunctionMatch(module_name = ctx.module_name, decl = d.value))
        Option.none:
            pass
    var ai: ptr_uint = 0
    while ai < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + ai)
        if not a.module_name == ctx.module_name:
            match find_func_in_source(a.source_file, callee_name):
                Option.some as d:
                    return Option[GenericFunctionMatch].some(value = GenericFunctionMatch(module_name = a.module_name, decl = d.value))
                Option.none:
                    pass
        ai += 1
    var mi: ptr_uint = 0
    while mi < ctx.loaded_modules.len:
        var lm: loader.LoadedModule
        unsafe:
            lm = read(ctx.loaded_modules.data + mi)
        match find_func_in_source(lm.source_file, callee_name):
            Option.some as d:
                return Option[GenericFunctionMatch].some(value = GenericFunctionMatch(module_name = lm.module_name.as_str(), decl = d.value))
            Option.none:
                pass
        mi += 1
    return Option[GenericFunctionMatch].none


## Find a generic function declaration in a specific module.  Module-qualified
## calls (`session.release(...)`) must only match declarations owned by that
## module; a same-named generic in another module must never satisfy the lookup.
function find_generic_function_in_module(ctx: ref[LowerCtx], module_name: str, callee_name: str) -> Option[GenericFunctionMatch]:
    var ai: ptr_uint = 0
    while ai < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + ai)
        if a.module_name == module_name:
            match find_func_in_source(a.source_file, callee_name):
                Option.some as d:
                    return Option[GenericFunctionMatch].some(value = GenericFunctionMatch(module_name = a.module_name, decl = d.value))
                Option.none:
                    pass
        ai += 1
    var mi: ptr_uint = 0
    while mi < ctx.loaded_modules.len:
        var lm: loader.LoadedModule
        unsafe:
            lm = read(ctx.loaded_modules.data + mi)
        if lm.module_name.as_str() == module_name:
            match find_func_in_source(lm.source_file, callee_name):
                Option.some as d:
                    return Option[GenericFunctionMatch].some(value = GenericFunctionMatch(module_name = lm.module_name.as_str(), decl = d.value))
                Option.none:
                    pass
        mi += 1
    return Option[GenericFunctionMatch].none


## Try to lower a call to a generic function whose type arguments are INFERRED
## from the argument types (no explicit `[T]`), e.g. `heap.release(this.data)`
## where `release[T](memory: ptr[T]?)` binds `T` from the argument.  Returns none
## when the target is not a generic function or inference fails.  Mirrors Ruby's
## per-instantiation monomorphization of inferred generic calls.  When
## `module_name` is some, only that module's declarations are considered.
function try_inferred_generic_call(ctx: ref[LowerCtx], module_name: Option[str], callee_name: str, args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> Option[ptr[ir.Expr]]:
    var found: Option[GenericFunctionMatch] = Option[GenericFunctionMatch].none
    match module_name:
        Option.some as restricted:
            found = find_generic_function_in_module(ctx, restricted.value, callee_name)
        Option.none:
            found = find_generic_function(ctx, callee_name)
    let gm = found else:
        return Option[ptr[ir.Expr]].none
    match gm.decl:
        ast.Decl.decl_function as fun:
            if fun.type_params.len == 0:
                return Option[ptr[ir.Expr]].none
            # Infer each type parameter from the arguments, then build the
            # substitution map and specialization key.
            var sub = map_mod.Map[str, types.Type].create()
            var key = string.String.create()
            key.append(naming.module_c_prefix(gm.module_name))
            key.append("_")
            key.append(callee_name)
            # The host's `module_function_c_name`: one double underscore before
            # the type-argument list, single underscores between its elements
            # (`find_state_hooks__World_Context`, not `__World__Context`).
            if fun.type_params.len > 0:
                key.append("__")
            var tpi: ptr_uint = 0
            while tpi < fun.type_params.len:
                var tp: ast.TypeParam
                unsafe:
                    tp = read(fun.type_params.data + tpi)
                let inferred = infer_type_param_from_args(ctx, tp.name, fun.method_params, args) else:
                    return Option[ptr[ir.Expr]].none
                sub.set(tp.name, inferred)
                if tpi > 0:
                    key.append("_")
                key.append(spec_type_key(ctx, inferred))
                tpi += 1
            let spec_key = key.as_str()
            if not ctx.specialization_cache.contains(spec_key) and not ctx.spec_in_progress.contains(spec_key):
                lower_and_cache_specialization_with_sub(ctx, gm, ref_of(sub), spec_key, ctx.pre_instantiated_context)
            else:
                note_validated_spec_reach(ctx, spec_key)
            let ret_ty = cross_module_return_type(ctx, spec_key, call_ep)
            # Pass a synthesized sig for async wait/run so coerce_fn_arg_to_proc
            # can wrap task expressions in procs (task-root-proc bridge).
            var sig = Option[analyzer.FnSig].none
            if gm.module_name.starts_with("std.async") and (callee_name == "wait" or callee_name == "run"):
                var syn_params = vec.Vec[analyzer.ParamEntry].create()
                var spi: ptr_uint = 0
                while spi < fun.method_params.len:
                    var fm: ast.Param = unsafe: read(fun.method_params.data + spi)
                    var p_ty = types.Type.ty_error
                    if fm.param_type.is_proc or fm.param_type.is_fn:
                        p_ty = substitute_type_params(ctx, resolve_function_type_ref(ctx, ptr_of(fm.param_type)), ref_of(sub))
                    else:
                        p_ty = substitute_type_params(ctx, resolve_type_ref(ctx, ptr_of(fm.param_type)), ref_of(sub))
                    syn_params.push(analyzer.ParamEntry(name = fm.name, ty = p_ty))
                    spi += 1
                sig = Option[analyzer.FnSig].some(value = analyzer.FnSig(name = callee_name, params = syn_params.as_span(), return_type = ctx.void_ty, has_return_type = false, method_kind = ast.MethodKind.mk_plain, is_async = false))
            var lowered_call: ptr[ir.Expr]
            match sig:
                Option.some:
                    lowered_call = lower_plain_call_sig(ctx, spec_key, args, call_ep, types.alloc_type(ret_ty), sig)
                Option.none:
                    lowered_call = lower_plain_call_spec(ctx, spec_key, args, call_ep, types.alloc_type(ret_ty), ctx.specialization_cache.get(spec_key))
            return Option[ptr[ir.Expr]].some(value = lowered_call)
        _:
            return Option[ptr[ir.Expr]].none


## Infer the concrete type bound to type parameter `param_name` by matching each
## declared parameter type against the corresponding argument's lowered type.
## Handles the shapes that appear in the self-host's inferred generic calls: a
## bare `T`, and `T` under `ptr`/`const_ptr`/`ref`/`span`/nullable, by peeling the
## same constructor off the argument type.
## Re-expand a collapsed generic instance type (`ty_named("std_vec_Vec_int")`)
## back into its generic form (`Vec[int]`) so structural type-parameter
## inference can match it against a declared `Vec[T]` parameter.  Recurses
## through pointer/span/nullable wrappers and nested type arguments.
function expand_generic_arg_type(ctx: ref[LowerCtx], t: types.Type) -> types.Type:
    match t:
        types.Type.ty_named as n:
            if n.module_name.len == 0:
                match generic_receiver_info(ctx, t):
                    Option.some as info:
                        # Preserve the owning module: without it a same-named
                        # struct from another module (map.Node vs linked_map.Node)
                        # could be picked during monomorphization.
                        if info.value.owner_module.len > 0:
                            return types.Type.ty_imported(module_name = info.value.owner_module, name = info.value.owner_name, args = info.value.concrete_args)
                        return types.Type.ty_generic(name = info.value.owner_name, args = info.value.concrete_args)
                    Option.none:
                        pass
            return t
        types.Type.ty_nullable as nl:
            return types.Type.ty_nullable(base = types.alloc_type(expand_generic_arg_type(ctx, unsafe: read(nl.base))))
        types.Type.ty_generic as g:
            var args = vec.Vec[types.Type].create()
            var i: ptr_uint = 0
            while i < g.args.len:
                unsafe:
                    args.push(expand_generic_arg_type(ctx, read(g.args.data + i)))
                i += 1
            return types.Type.ty_generic(name = g.name, args = args.as_span())
        types.Type.ty_imported as im:
            var args = vec.Vec[types.Type].create()
            var i: ptr_uint = 0
            while i < im.args.len:
                unsafe:
                    args.push(expand_generic_arg_type(ctx, read(im.args.data + i)))
                i += 1
            return types.Type.ty_imported(module_name = im.module_name, name = im.name, args = args.as_span())
        _:
            return t


function infer_type_param_from_args(ctx: ref[LowerCtx], param_name: str, params: span[ast.Param], args: span[ast.Argument]) -> Option[types.Type]:
    var i: ptr_uint = 0
    while i < params.len and i < args.len:
        var p: ast.Param
        unsafe:
            p = read(params.data + i)
        # For a proc/fn parameter, prefer the argument's AST-reconstructed
        # `ty_function` type (which carries the real return type) over the lowered
        # proc-struct `ty_named` — the latter's mangled C name cannot be reliably
        # parsed back for multi-component return types (e.g. an imported struct).
        var arg_ty: types.Type
        if p.param_type.is_proc or p.param_type.is_fn:
            arg_ty = fallback_type_raw(ctx, unsafe: read(args.data + i).arg_value)
            if not is_proc_type(arg_ty) and not is_fn_type(arg_ty):
                arg_ty = speculative_expr_type(ctx, unsafe: read(args.data + i).arg_value)
        else:
            arg_ty = speculative_expr_type(ctx, unsafe: read(args.data + i).arg_value)
        # The analyzer records argument types from the *generic* body, so
        # substitute the active specialization's bindings before matching, then
        # re-expand collapsed generic instances.
        arg_ty = substitute_type_params(ctx, arg_ty, ref_of(ctx.type_substitution))
        arg_ty = expand_generic_arg_type(ctx, arg_ty)
        match unify_type_param(param_name, p.param_type, arg_ty):
            Option.some as found:
                return Option[types.Type].some(value = found.value)
            Option.none:
                pass
        i += 1
    return Option[types.Type].none


## Infer a generic foreign wrapper's call-site type substitution from the
## arguments — the host's `binding.type_substitutions` at a foreign call.  A
## `T as const_ptr[void]` boundary then resolves to the argument's specialized
## type instead of leaving the type parameter unbound.
function foreign_call_substitution(ctx: ref[LowerCtx], info: ForeignInfo, args: span[ast.Argument]) -> map_mod.Map[str, types.Type]:
    var sub = map_mod.Map[str, types.Type].create()
    var tpi: ptr_uint = 0
    while tpi < info.type_params.len:
        var tp: ast.TypeParam
        unsafe:
            tp = read(info.type_params.data + tpi)
        if not tp.is_lifetime:
            match infer_foreign_type_param_from_args(ctx, tp.name, info.params, args):
                Option.some as inferred:
                    sub.set(tp.name, inferred.value)
                Option.none:
                    pass
        tpi += 1
    return sub


function infer_foreign_type_param_from_args(ctx: ref[LowerCtx], param_name: str, params: span[ast.ForeignParam], args: span[ast.Argument]) -> Option[types.Type]:
    var i: ptr_uint = 0
    while i < params.len and i < args.len:
        var p: ast.ForeignParam
        var a: ast.Argument
        unsafe:
            p = read(params.data + i)
            a = read(args.data + i)
        var arg_ty = expr_type(ctx, a.arg_value)
        if types.is_error(arg_ty) or types.is_void(arg_ty):
            arg_ty = fallback_type_raw(ctx, a.arg_value)
        arg_ty = substitute_type_params(ctx, arg_ty, ref_of(ctx.type_substitution))
        arg_ty = expand_generic_arg_type(ctx, arg_ty)
        if not types.is_error(arg_ty) and not types.is_void(arg_ty):
            var ptre = p.param_type
            match unify_type_param(param_name, ptre, arg_ty):
                Option.some as found:
                    return Option[types.Type].some(value = found.value)
                Option.none:
                    pass
        i += 1
    return Option[types.Type].none


## Structurally match a declared parameter type-ref against a concrete argument
## type, binding `param_name` when it is found.  Peels matching pointer/span/
## nullable constructors off both sides.
function unify_type_param(param_name: str, param_ref: ast.TypeRef, arg_ty: types.Type) -> Option[types.Type]:
    let simple_name = type_ref_simple_name(param_ref)
    # Bare `T`.
    if simple_name == param_name and param_ref.arguments.len == 0:
        return Option[types.Type].some(value = arg_ty)
    # `ptr[T]` / `const_ptr[T]` / `span[T]` / `ref[T]`: peel one pointer-like
    # layer off the argument type and recurse into the element type-ref.
    if param_ref.arguments.len >= 1 and pointer_like_ctor_name(simple_name):
        let inner_arg = pointer_or_span_element(arg_ty)
        var inner_ref: ast.TypeRef
        unsafe:
            inner_ref = read(param_ref.arguments.data + (param_ref.arguments.len - 1))
        return unify_type_param(param_name, inner_ref, inner_arg)
    # Nested generic instance: `Task[T]` matched against `Task[int]` → T = int;
    # `Option[T]` matched against `Option[int]` → T = int; etc.
    # The param_ref has nested arguments (e.g. `T` inside `Task[T]`) and the
    # argument type is a generic instance with the same name and arg count.
    # Recursively unify each type argument pair.
    if param_ref.arguments.len >= 1:
        match arg_ty:
            types.Type.ty_generic as g:
                if g.name == simple_name and g.args.len == param_ref.arguments.len:
                    var mi: ptr_uint = 0
                    while mi < g.args.len and mi < param_ref.arguments.len:
                        var inner_ref: ast.TypeRef
                        unsafe:
                            inner_ref = read(param_ref.arguments.data + mi)
                        match unify_type_param(param_name, inner_ref, unsafe: read(g.args.data + mi)):
                            Option.some as found:
                                return Option[types.Type].some(value = found.value)
                            Option.none:
                                pass
                        mi += 1
            types.Type.ty_imported as im:
                if im.name == simple_name and im.args.len == param_ref.arguments.len:
                    var mi2: ptr_uint = 0
                    while mi2 < im.args.len and mi2 < param_ref.arguments.len:
                        var inner_ref2: ast.TypeRef
                        unsafe:
                            inner_ref2 = read(param_ref.arguments.data + mi2)
                        match unify_type_param(param_name, inner_ref2, unsafe: read(im.args.data + mi2)):
                            Option.some as found:
                                return Option[types.Type].some(value = found.value)
                            Option.none:
                                pass
                        mi2 += 1
            _:
                pass
    # `proc(...) -> T`: peel the proc layer (fn_params/fn_return fields, not
    # `name`/`arguments` since the parser stores callable types specially) and
    # recurse into the return type position.
    if param_ref.is_proc or param_ref.is_fn:
        let prec = param_ref.fn_return
        if prec != null:
            if is_proc_type(arg_ty) or is_fn_type(arg_ty):
                let inner_ret = proc_return_type(arg_ty)
                return unify_type_param(param_name, unsafe: read(prec), inner_ret)
            # Task-root-proc bridge: arg is a plain Task[X] value matching
            # proc()->Task[T].  Peel wrapper to match type var against arg.
            let ret_ref = unsafe: read(prec)
            if ret_ref.arguments.len >= 1:
                let ret_name = type_ref_simple_name(ret_ref)
                match arg_ty:
                    types.Type.ty_generic as g:
                        if g.name == ret_name and g.args.len == ret_ref.arguments.len:
                            var mi: ptr_uint = 0
                            while mi < g.args.len and mi < ret_ref.arguments.len:
                                var inner_ref = unsafe: read(ret_ref.arguments.data + mi)
                                match unify_type_param(param_name, inner_ref, unsafe: read(g.args.data + mi)):
                                    Option.some as found:
                                        return Option[types.Type].some(value = found.value)
                                    Option.none:
                                        pass
                                mi += 1
                            return Option[types.Type].none
                    _:
                        pass
            return unify_type_param(param_name, ret_ref, arg_ty)
        return Option[types.Type].none
    return Option[types.Type].none


## The single (unqualified) name of a type-ref, or "" for a multi-part name.
function type_ref_simple_name(t: ast.TypeRef) -> str:
    # The final name part: `T` -> "T", `vec.Vec` -> "Vec" (structural
    # unification matches the constructor by its simple name).
    if t.name.parts.len == 0:
        return ""
    return unsafe: read(t.name.parts.data + t.name.parts.len - 1)


## True for the pointer-like type constructors whose single element carries the
## generic parameter.
function pointer_like_ctor_name(name: str) -> bool:
    return name == "ptr" or name == "const_ptr" or name == "own" or name == "ref" or name == "span"


## Peel one pointer/span/nullable layer off a concrete type, yielding the element
## type (or the type unchanged when it has no such layer).
function pointer_or_span_element(t: types.Type) -> types.Type:
    match t:
        types.Type.ty_nullable as nl:
            return pointer_or_span_element(unsafe: read(nl.base))
        types.Type.ty_generic as g:
            if g.args.len >= 1 and pointer_like_ctor_name(g.name):
                return unsafe: read(g.args.data + (g.args.len - 1))
        _:
            pass
    return t


## The parameter type at `index` of a proc/fn type (`ty_error` when out of range).
function proc_param_type_at(t: types.Type, index: ptr_uint) -> types.Type:
    match t:
        types.Type.ty_function as fnt:
            if index < fnt.params.len:
                return unsafe: read(fnt.params.data + index)
        _:
            pass
    return types.Type.ty_error


## Extract the return type from a function/proc type.  For `ty_function`, return
## the return type.  For `ty_named` proc struct types (mt_proc_*), recover the
## return type from the proc struct name by reversing
## `proc_type_name_from_signature` ("mt_proc_int" → int).
function proc_return_type(t: types.Type) -> types.Type:
    match t:
        types.Type.ty_function as fnt:
            return unsafe: read(fnt.return_type)
        types.Type.ty_named as n:
            if n.name.starts_with("mt_proc_"):
                let raw = n.name.slice(8, n.name.len - 8)
                # Extract the return type (first underscore-separated component).
                # For mt_proc_int → "int", mt_proc_str_int → "str".
                match raw.find_substring("_"):
                    Option.some as us_pos:
                        let ret_name = raw.slice(0, us_pos.value)
                        return recognize_type_name(ret_name)
                    Option.none:
                        return recognize_type_name(raw)
            return types.primitive("void")
        _:
            return types.primitive("void")


## Map a single-word C type name (int, void, str, etc.) to a Type.
function recognize_type_name(name: str) -> types.Type:
    if name == "int" or name == "long" or name == "short" or name == "byte":
        return types.primitive(name)
    if name == "uint" or name == "ulong" or name == "ushort" or name == "ubyte":
        return types.primitive(name)
    if name == "float" or name == "double":
        return types.primitive(name)
    if name == "bool":
        return types.primitive("bool")
    if name == "void":
        return types.primitive("void")
    if name == "char":
        return types.primitive("char")
    if name == "ptr_uint":
        return types.primitive("ptr_uint")
    if name == "ptr_int":
        return types.primitive("ptr_int")
    if name == "str":
        return types.Type.ty_str
    if name == "mt_str":
        return types.Type.ty_str
    if name == "const_ptr_void":
        return types.Type.ty_generic(name = "const_ptr", args = sp_type(types.primitive("void")))
    if name == "mt_span_ubyte":
        return types.Type.ty_generic(name = "span", args = sp_type(types.primitive("ubyte")))
    if name == "mt_span_int":
        return types.Type.ty_generic(name = "span", args = sp_type(types.primitive("int")))
    return types.primitive("void")


## Lower an uncached generic function specialization: build the type substitution
## map, then lower the body in the OWNER module's context (so its imports,
## foreign functions, variants, and recorded expression types resolve against the
## defining module rather than the caller) and cache it under `spec_key`.
function lower_and_cache_specialization(ctx: ref[LowerCtx], gm: GenericFunctionMatch, type_args: span[ast.TypeArgument], spec_key: str, pre_instantiated: bool) -> void:
    match gm.decl:
        ast.Decl.decl_function as fun:
            # Build type substitution from the function's type params, resolving
            # AND qualifying the type arguments in the CALLER's context: the
            # concrete type must become a fully-qualified name here (where it is
            # known) so the owner module — which may not import the argument's
            # defining module — renders it correctly rather than dropping the
            # module prefix.
            var sub = map_mod.Map[str, types.Type].create()
            var tpi: ptr_uint = 0
            while tpi < fun.type_params.len:
                var tp: ast.TypeParam
                unsafe:
                    tp = read(fun.type_params.data + tpi)
                if tpi < type_args.len:
                    let concrete = qualify_type(ctx, resolve_type_ref(ctx, unsafe: read(type_args.data + tpi).value))
                    sub.set(tp.name, concrete)
                tpi += 1
            lower_and_cache_specialization_with_sub(ctx, gm, ref_of(sub), spec_key, pre_instantiated)
        _:
            fatal(j2("lowering: monomorphization failed, expected function decl for ", gm.module_name))


## Lower an uncached generic function specialization from a pre-built type
## substitution map (`sub`: type-param name -> concrete, caller-qualified type).
## The body is lowered in the OWNER module's context and cached under `spec_key`.
## Shared by explicit-type-arg specialization and inferred-type-arg calls.
function lower_and_cache_specialization_with_sub(ctx: ref[LowerCtx], gm: GenericFunctionMatch, sub: ref[map_mod.Map[str, types.Type]], spec_key: str, pre_instantiated: bool) -> void:
    let creator = ctx.current_function_linkage
    let setup_module = if creator.len == 0: ctx.module_name else: ""
    # Consume the one-shot creation-path override (see `ensure_monomorphized_method`).
    let creation_override = ctx.next_spec_body_validated
    ctx.next_spec_body_validated = Option[bool].none
    var creation_normal_call = true
    var body_validated = pre_instantiated
    match creation_override:
        Option.some as v:
            creation_normal_call = false
            body_validated = v.value
        Option.none:
            pass
    ctx.spec_in_progress.set(spec_key, true)
    match gm.decl:
        ast.Decl.decl_function as fun:
            # Save the caller context.
            var saved_module = ctx.module_name
            var saved_analysis = ctx.analysis
            var saved_foreign = ctx.foreign_map
            var saved_variants = ctx.variants
            var saved_locals = ctx.locals
            var saved_counter = ctx.temp_counter
            var saved_returns = ctx.function_returns
            var saved_type_subst = ctx.type_substitution
            var saved_inside_async = ctx.inside_async
            var saved_cps_active = ctx.async_cps_active
            var saved_cps_completion = ctx.async_completion_active
            # A specialization lowered *while an expression is being lowered*
            # (a lazy monomorphization) must not disturb the caller's format
            # state: its body's result naming would otherwise leak back and a
            # later `f"..."` in the caller loses its `__fmt_<dest>` name (and
            # numbering).  The maps are shared by reference, so the body gets
            # fresh ones and the caller's are restored afterwards.
            var saved_fmt_dest = ctx.fmt_dest_name
            var saved_fmt_counter = ctx.fmt_counter
            var saved_fmt_visible = ctx.fmt_counter_visible
            var saved_cstr_backed = ctx.cstr_backed_names
            # Specializations are lowered in their own right; a caller's CPS
            # state must not leak into their IR bodies (or the body will emit a
            # frame completion against a frame that doesn't exist).
            ctx.async_cps_active = false
            ctx.async_completion_active = false

            # Switch to the owner module's context when its analysis is available.
            match find_imported_analysis(ctx, gm.module_name):
                Option.some as owner_a:
                    ctx.module_name = gm.module_name
                    ctx.analysis = owner_a.value
                    ctx.foreign_map = map_mod.Map[str, ForeignInfo].create()
                    ctx.variants = map_mod.Map[str, VariantInfo].create()
                    ctx.type_substitution = map_mod.Map[str, types.Type].create()
                    collect_foreign_functions(ctx, owner_a.value.source_file.declarations)
                    collect_variants(ctx, owner_a.value.source_file.declarations)
                    install_prelude_variants(ctx)
                Option.none:
                    pass

            ctx.locals = vec.Vec[LocalBinding].create()
            ctx.temp_counter = 0
            ctx.fmt_dest_name = ""
            ctx.fmt_counter = map_mod.Map[str, ptr_uint].create()
            ctx.fmt_counter_visible = false
            ctx.cstr_backed_names = map_mod.Map[str, bool].create()
            ctx.function_returns = map_mod.Map[str, types.Type].create()
            ctx.type_substitution = map_mod.Map[str, types.Type].create()
            ctx.inside_async = false

            var spec_fun = lower_specialized_function(ctx, fun.name, spec_key, fun.method_params, fun.return_type, fun.body, sub, body_validated)
            # Host parity: the instance's `name` is the declaration name; only
            # the linkage name carries the specialization suffix.
            spec_fun.linkage_name = spec_key

            ctx.specialization_cache.set(spec_key, spec_fun)
            saved_returns.set(spec_key, spec_fun.return_type)
            # Record owner/declaration/arguments so the driver can place this
            # instance in its owner module's function list (host ordering).
            # The host's sort key is `type_arguments.map(&:to_s).join(",")` — the
            # RENDERED arguments, where a generic's closing bracket sorts after a
            # longer element name (`span[TypeParamConstraint]` before
            # `span[TypeParam]`), so it is not the C key.
            var fn_args_key = string.String.create()
            var fai: ptr_uint = 0
            while fai < fun.type_params.len:
                if fai > 0:
                    fn_args_key.append(",")
                var ftp: ast.TypeParam
                unsafe:
                    ftp = read(fun.type_params.data + fai)
                let fcv = sub.get(ftp.name)
                if fcv != null:
                    fn_args_key.append(spec_arg_type_to_s(unsafe: read(fcv)))
                fai += 1
            # The first creator wins: the host instantiates a binding once, so
            # the earliest module to reach the call site owns its creation wave.
            # Pre-instantiation is sticky, though: if *any* analyzed source path
            # reaches this instance, the host's analyzer created it before
            # lowering and it belongs to the setup pass.
            let existing_ptr = unsafe: read(ctx.spec_infos).get(spec_key)
            if existing_ptr == null:
                unsafe:
                    read(ctx.spec_infos).set(spec_key, SpecInfo(
                        owner_module = gm.module_name,
                        body_validated = body_validated,
                        creation_normal_call = creation_normal_call,
                        reachers = if creation_normal_call: make_spec_reachers(creator) else: vec.Vec[str].create(),
                        decl_key = j2("fn:", fun.name),
                        args_key = fn_args_key.as_str(),
                        creator = creator,
                        pre_instantiated = pre_instantiated,
                        setup_module = setup_module,
                    ))
            else:
                var existing = unsafe: read(existing_ptr)
                if pre_instantiated and not existing.pre_instantiated:
                    existing.pre_instantiated = true
                    unsafe: read(ctx.spec_infos).set(spec_key, existing)
                if body_validated and not existing.body_validated:
                    existing.body_validated = true
                    unsafe: read(ctx.spec_infos).set(spec_key, existing)

            # Restore the caller context.
            ctx.module_name = saved_module
            ctx.analysis = saved_analysis
            ctx.foreign_map = saved_foreign
            ctx.variants = saved_variants
            ctx.locals = saved_locals
            ctx.temp_counter = saved_counter
            ctx.function_returns = saved_returns
            ctx.type_substitution = saved_type_subst
            ctx.inside_async = saved_inside_async
            ctx.async_cps_active = saved_cps_active
            ctx.async_completion_active = saved_cps_completion
            ctx.fmt_dest_name = saved_fmt_dest
            ctx.fmt_counter = saved_fmt_counter
            ctx.fmt_counter_visible = saved_fmt_visible
            ctx.cstr_backed_names = saved_cstr_backed
        _:
            fatal(j2("lowering: monomorphization failed, expected function decl for ", gm.module_name))


## Lower a payload variant arm constructor `Variant.arm(field = value, ...)` to an
## IR variant literal.  No-payload arms are handled in `lower_member_access`.
function lower_variant_literal(ctx: ref[LowerCtx], variant_name: str, arm_name: str, args: span[ast.Argument]) -> ptr[ir.Expr]:
    let ty = types.Type.ty_imported(module_name = ctx.module_name, name = variant_name, args = span[types.Type]())
    return alloc_expr(ir.Expr.expr_variant_literal(
        ty = ty,
        arm_name = arm_name,
        fields = collect_variant_literal_fields(ctx, args, ty, arm_name),
    ))


## Lower a generic variant arm constructor `Option[int].some(value = 42)`.  The
## type arguments resolve to concrete types; the call arguments map to field
## values.  The resulting type is `ty_generic("Option", [ty_int])`.
function lower_generic_variant_literal(ctx: ref[LowerCtx], variant_name: str, type_args: span[ast.TypeArgument], arm_name: str, call_args: span[ast.Argument]) -> ptr[ir.Expr]:
    var concrete_args = vec.Vec[types.Type].create()
    var i: ptr_uint = 0
    while i < type_args.len:
        # Qualify each type argument the same way the signature return type is
        # qualified, so a locally-defined struct arg (e.g. `RemovedEntry` in
        # std.map) is monomorphized to its module-qualified C name
        # (`std_map_RemovedEntry_str_bool`) rather than a bare `RemovedEntry_str_bool`
        # that would mismatch the declared `Option[RemovedEntry[K, V]]` return type.
        unsafe:
            concrete_args.push(qualify_type(ctx, resolve_type_ref(ctx, read(type_args.data + i).value)))
        i += 1
    let ty = generic_variant_instance_type(ctx, variant_name, concrete_args.as_span())
    return alloc_expr(ir.Expr.expr_variant_literal(
        ty = ty,
        arm_name = arm_name,
        fields = collect_variant_literal_fields(ctx, call_args, ty, arm_name),
    ))


function find_imported_variant_arm(module_analysis: analyzer.Analysis, arm_name: str) -> Option[str]:
    var di: ptr_uint = 0
    while di < module_analysis.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(module_analysis.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_variant as vr:
                var ai: ptr_uint = 0
                while ai < vr.variant_arms.len:
                    var arm: ast.VariantArm
                    unsafe:
                        arm = read(vr.variant_arms.data + ai)
                    if arm.name == arm_name:
                        return Option[str].some(value = vr.name)
                    ai += 1
            _:
                pass
        di += 1
    return Option[str].none


function collect_variant_literal_fields(ctx: ref[LowerCtx], args: span[ast.Argument], variant_ty: types.Type, arm_name: str) -> span[ir.AggregateField]:
    var fields = vec.Vec[ir.AggregateField].create()
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        let field_name = arg.arg_name else:
            fatal(c"lowering: variant arm construction requires named fields")
        var value = lower_expr(ctx, arg.arg_value)
        # Auto-address recursive variant fields.
        let field_ty = variant_field_type_from_arm(ctx, variant_ty, arm_name, field_name)
        match field_ty:
            Option.some as fty:
                let fty_val = fty.value
                # A bare literal takes the field's type (`Option[ptr_uint].some(
                # value = 0)` emits a `ptr_uint` literal; the host lowers the
                # field value with the field's type as the expected type).
                value = literal_value_to_context_type(ctx, arg.arg_value, fty_val, value)
                # Wrap non-nullable values into value-type nullable fields
                # (e.g. `NullableFields.with_values(port = raw)` where
                # `port: int?`).
                if types.is_nullable_type(fty_val) and not is_nullable_pointer_like(fty_val):
                    let value_ty = ir_expr_type(value)
                    if not types.is_nullable_type(value_ty):
                        value = nullable_some_literal(fty_val, value)
                # Auto-address recursive variant fields.
                let variant_c = variant_c_type_name(variant_ty)
                var arm_payload_c = string.String.create()
                arm_payload_c.append(variant_c)
                arm_payload_c.append("_")
                arm_payload_c.append(arm_name)
                let payload_c = arm_payload_c.as_str()
                if is_recursive_variant_field_c(payload_c, fty_val):
                    # The host types the auto-address with the value's own type
                    # (`calls.rb:202`), not `ptr[field]`.
                    value = alloc_expr(ir.Expr.expr_address_of(expression = value, ty = ir_expr_type(value)))
            Option.none:
                pass
        fields.push(ir.AggregateField(name = field_name, value = value))
        i += 1
    return fields.as_span()


## Build a specialization key from the callee name + concrete type args.  For a
## same-module function `first[int]`, the key is `<module_prefix>_first_int`.  The
## key doubles as the monomorphized C linkage name.

## Compute a type-key string for specialization naming.  Builtin generic types
## (ptr/own/span/…) use their bare `type_c_key`.  User-defined generic structs
## include the defining module's C prefix so that Node[int, bool] in std.map and
## Node[int, bool] in std.linked_map produce distinct keys.
function spec_type_key(ctx: ref[LowerCtx], ty: types.Type) -> str:
    match ty:
        types.Type.ty_generic as g:
            if is_builtin_pointer_generic(g.name):
                var buf = string.String.create()
                buf.append(g.name)
                var i: ptr_uint = 0
                while i < g.args.len:
                    buf.append("_")
                    buf.append(spec_type_key(ctx, unsafe: read(g.args.data + i)))
                    i += 1
                return buf.as_str()
            if g.name == "Option" or g.name == "Result":
                return naming.type_c_key(ty)
            return naming.qualified_c_name(ctx.module_name, generic_struct_c_name(g.name, g.args))
        types.Type.ty_tuple:
            return naming.type_c_key(ty)
        types.Type.ty_nullable as nl:
            return spec_type_key(ctx, unsafe: read(nl.base))
        _:
            return naming.type_c_key(ty)

function specialization_key(ctx: ref[LowerCtx], module_name: str, callee_name: str, type_args: span[ast.TypeArgument]) -> str:
    var buf = string.String.create()
    buf.append(naming.module_c_prefix(module_name))
    buf.append("_")
    buf.append(callee_name)
    # Host `module_function_c_name`: a generic instance's type arguments follow
    # a double underscore so they cannot collide with a regular function whose
    # name ends in the same text (`expect_equal[str]` vs `expect_equal_str`).
    if type_args.len > 0:
        buf.append("__")
    var i: ptr_uint = 0
    while i < type_args.len:
        if i > 0:
            buf.append("_")
        let ty = resolve_type_ref(ctx, unsafe: read(type_args.data + i).value)
        buf.append(spec_type_key(ctx, ty))
        i += 1
    return buf.as_str()


## Lower a struct constructor `Name(field = value, ...)` to an IR aggregate
## literal, preserving the constructor's field order.
function lower_aggregate_literal(ctx: ref[LowerCtx], struct_name: str, args: span[ast.Argument]) -> ptr[ir.Expr]:
    return lower_aggregate_literal_impl(ctx, struct_name, args, Option[str].none)



function lower_aggregate_literal_in_module(ctx: ref[LowerCtx], struct_name: str, args: span[ast.Argument], target_module: str) -> ptr[ir.Expr]:
    return lower_aggregate_literal_impl(ctx, struct_name, args, Option[str].some(value = target_module))



function lower_aggregate_literal_impl(ctx: ref[LowerCtx], struct_name: str, args: span[ast.Argument], target_module: Option[str]) -> ptr[ir.Expr]:
    var source_module = ctx.module_name
    if is_builtin_type_name(struct_name):
        source_module = ""
    else if target_module.is_some():
        source_module = target_module.unwrap()
    else if not ctx.analysis.structs.contains(struct_name):
        var import_values = ctx.analysis.imports.values()
        var found_module = false
        while not found_module:
            let target_ptr = import_values.next() else:
                break
            let target_module = unsafe: read(target_ptr)
            match find_imported_analysis(ctx, target_module):
                Option.some as imported:
                    if imported.value.structs.contains(struct_name):
                        source_module = target_module
                        found_module = true
                Option.none:
                    pass
    var fields = vec.Vec[ir.AggregateField].create()
    # An alias-qualified construction (`rl.Color(r = 200)` with
    # `type Color = c.Color` in std.raylib) declares its fields in the alias's
    # *target* module, so the per-field type lookup must follow the alias chain —
    # otherwise integer literals are never re-typed against the field type and
    # the IR keeps the analyzer's default `int`.
    var field_struct_name = struct_name
    var field_source_module = source_module
    if source_module.len > 0:
        match resolve_single_imported_type(ctx, source_module, struct_name):
            Option.some as aliased:
                match aliased.value:
                    types.Type.ty_imported as aim:
                        field_struct_name = aim.name
                        field_source_module = aim.module_name
                    types.Type.ty_named as anm:
                        field_struct_name = anm.name
                        if anm.module_name.len > 0:
                            field_source_module = anm.module_name
                    _:
                        pass
            Option.none:
                pass
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        let field_name = arg.arg_name else:
            fatal(c"lowering: struct construction requires named fields")
        var value = lower_expr(ctx, arg.arg_value)
        # Re-type an integer literal whose value fits the field type, mirroring
        # the host: an integer literal passed to a `ptr_uint`/`ubyte` field is
        # lowered with the field's type rather than the analyzer's default `int`.
        match find_struct_field_type(ctx, field_struct_name, field_source_module, field_name):
            Option.some as field_ty:
                let fty = field_ty.value
                value = literal_value_to_context_type(ctx, arg.arg_value, fty, value)
                # Wrap non-nullable values into value-type nullable fields.
                if types.is_nullable_type(fty) and not is_nullable_pointer_like(fty):
                    let value_ty = ir_expr_type(value)
                    if not types.is_nullable_type(value_ty):
                        unsafe:
                            match read(value):
                                ir.Expr.expr_null_literal:
                                    value = alloc_expr(ir.Expr.expr_zero_init(ty = fty))
                                _:
                                    value = nullable_some_literal(fty, value)
            Option.none:
                pass
        fields.push(ir.AggregateField(name = field_name, value = value))
        i += 1
    if source_module.len == 0:
        var agg_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = struct_name)
        if is_builtin_type_name(struct_name) or struct_name == "str":
            agg_ty = types.Type.ty_primitive(name = struct_name)
        return alloc_expr(ir.Expr.expr_aggregate_literal(ty = agg_ty, fields = fields.as_span()))
    return alloc_expr(ir.Expr.expr_aggregate_literal(
        ty = types.Type.ty_imported(module_name = source_module, name = struct_name, args = span[types.Type]()),
        fields = fields.as_span(),
    ))


## Find the type of a field in a struct by name.
function find_struct_field_type(ctx: ref[LowerCtx], struct_name: str, source_module: str, field_name: str) -> Option[types.Type]:
    let fields_ptr = ctx.analysis.structs.get(struct_name)
    if fields_ptr != null:
        let entries = unsafe: read(fields_ptr)
        var fi: ptr_uint = 0
        while fi < entries.len:
            unsafe:
                if read(entries.data + fi).name == field_name:
                    return Option[types.Type].some(value = read(entries.data + fi).ty)
            fi += 1
    match find_imported_analysis(ctx, source_module):
        Option.some as ia:
            let imported_fields = ia.value.structs.get(struct_name)
            if imported_fields != null:
                let ientries = unsafe: read(imported_fields)
                var ifi: ptr_uint = 0
                while ifi < ientries.len:
                    unsafe:
                        if read(ientries.data + ifi).name == field_name:
                            return Option[types.Type].some(value = read(ientries.data + ifi).ty)
                    ifi += 1
        Option.none:
            pass
    return Option[types.Type].none


# =============================================================================
#  dyn[I] interface lowering (mirrors Ruby's lowerer_dyn)
# =============================================================================

## Lower `adapt[I](value)`: construct a dyn[I] fat pointer `{ data: void*, vtable: void* }`.
## The concrete type is extracted from the argument (unwrapping ref[T] to T).  A vtable
## struct type, wrapper functions, and a vtable global constant are generated on first use.
function lower_adapt_call(ctx: ref[LowerCtx], iface_type_ref: ptr[ast.TypeRef], args: span[ast.Argument]) -> ptr[ir.Expr]:
    if args.len != 1:
        fatal(c"dyn lowering: adapt requires exactly one argument")
    var arg = unsafe: read(args.data + 0)
    let arg_value = lower_expr(ctx, arg.arg_value)
    let arg_type = expr_type(ctx, arg.arg_value)
    let concrete_type = if types.is_ref_type(arg_type): types.pointer_element(arg_type) else: arg_type
    let iface_type_ref_val = unsafe: read(iface_type_ref)
    let iface_use_name = unsafe: analyzer.qname_to_str(iface_type_ref_val.name)
    # The use-site name may be a dotted import alias (`ifaces.Identifiable`),
    # which is not a C identifier and is not what the host names the symbols
    # after: the interface lookup wants it as written (it resolves aliases),
    # while every symbol built from it (`mt_dyn_*`, `mt_vtable_*`) uses the
    # declared name alone, so both spellings produce one symbol.
    let iface_name = naming.dyn_iface_declared_name(iface_use_name)
    # Resolve type arguments from the dyn[...] type (e.g. dyn[Mapper[int]] → [int]).
    var type_args = vec.Vec[types.Type].create()
    var tgi: ptr_uint = 0
    while tgi < iface_type_ref_val.arguments.len:
        type_args.push(resolve_type_ref(ctx, unsafe: ptr[ast.TypeRef]<-iface_type_ref_val.arguments.data + tgi))
        tgi += 1
    match find_interface_analysis(ctx, iface_use_name):
        Option.some as ia:
            let methods = ia.value.methods
            let concrete_name = canonical_type_name(ctx.module_name, concrete_type)
            let vtable_name = ensure_dyn_vtable(ctx, concrete_name, concrete_type, iface_name, methods, type_args.as_span(), ia.value.type_params)
            var void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
            # The vtable constant has the `DynVtable` type; its address is a
            # `ptr[DynVtable]`, then cast to `void*` for the fat-pointer field.
            let vtable_ty = types.Type.ty_dyn_vtable(interface_name = iface_name, linkage_name = j2("mt_vtable_", iface_name))
            let vtable_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(vtable_ty))
            return alloc_expr(ir.Expr.expr_aggregate_literal(
                ty = types.Type.ty_dyn(iface = iface_name, args = type_args.as_span()),
                fields = sp_fields2(
                    ir.AggregateField(name = "data", value = alloc_expr(ir.Expr.expr_cast(target_type = void_ptr, expression = arg_value, ty = void_ptr))),
                    ir.AggregateField(name = "vtable", value = alloc_expr(ir.Expr.expr_cast(
                        target_type = void_ptr,
                        expression = alloc_expr(ir.Expr.expr_address_of(
                            expression = alloc_expr(ir.Expr.expr_name(name = vtable_name, ty = vtable_ty, pointer = Option[bool].some(value = false))),
                            ty = vtable_ptr_ty,
                        )),
                        ty = void_ptr,
                    ))),
                ),
            ))
        Option.none:
            fatal(c"dyn lowering: interface not found")


## Interface analysis: the methods declared by the interface.
struct InterfaceAnalysis:
    methods: span[ast.InterfaceMethod]
    type_params: span[ast.TypeParam]


## Find an interface's definition across all loaded modules.  Searches the current
## module first, then imported modules.
function find_interface_analysis(ctx: ref[LowerCtx], iface_name: str) -> Option[InterfaceAnalysis]:
    # Short qualified name: `mod.Interface`.
    if iface_name.find_byte(46).is_some():  # '.'
        var parts_buf = string.String.create()
        var idx: ptr_uint = 0
        while idx < iface_name.len:
            let b = iface_name.byte_at(idx)
            if b == 46:
                let mod_name = parts_buf.as_str()
                let rest = iface_name.slice(idx + 1, iface_name.len - idx - 1)
                if not rest.is_valid_utf8():
                    break
                # `mod_name` is what the use site wrote, which may be an import
                # alias (`ifaces.Identifiable` for `engine.interfaces`): look the
                # analysis up under the real module name.
                var target_module = mod_name
                let alias_ptr = ctx.analysis.imports.get(mod_name)
                if alias_ptr != null:
                    target_module = unsafe: read(alias_ptr)
                match find_imported_analysis(ctx, target_module):
                    Option.some as imported:
                        let m_ptr = imported.value.interfaces.get(rest)
                        if m_ptr != null:
                            return Option[InterfaceAnalysis].some(value = InterfaceAnalysis(methods = unsafe: read(m_ptr), type_params = interface_type_params(imported.value.source_file, rest)))
                    Option.none:
                        pass
                return Option[InterfaceAnalysis].none
            parts_buf.push_byte(b)
            idx += 1
        return Option[InterfaceAnalysis].none
    # Bare name: search current module then all imported modules.
    let m_ptr = ctx.analysis.interfaces.get(iface_name)
    if m_ptr != null:
        return Option[InterfaceAnalysis].some(value = InterfaceAnalysis(methods = unsafe: read(m_ptr), type_params = interface_type_params(ctx.analysis.source_file, iface_name)))
    var import_values = ctx.analysis.imports.values()
    while true:
        let target_ptr = import_values.next() else:
            break
        let target_module = unsafe: read(target_ptr)
        match find_imported_analysis(ctx, target_module):
            Option.some as imported:
                let i_ptr = imported.value.interfaces.get(iface_name)
                if i_ptr != null:
                    # Is the interface public in that module?
                    if not module_has_private_interface(imported.value.source_file, iface_name):
                        return Option[InterfaceAnalysis].some(value = InterfaceAnalysis(methods = unsafe: read(i_ptr), type_params = interface_type_params(imported.value.source_file, iface_name)))
            Option.none:
                pass
    return Option[InterfaceAnalysis].none


function module_has_private_interface(file: ast.SourceFile, iface_name: str) -> bool:
    var di: ptr_uint = 0
    while di < file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(file.declarations.data + di)
        match d:
            ast.Decl.decl_interface as iface:
                if iface.name == iface_name and not iface.visibility:
                    return true
            _:
                pass
        di += 1
    return false


## Extract type parameters from an interface declaration in the source file AST.
function interface_type_params(file: ast.SourceFile, iface_name: str) -> span[ast.TypeParam]:
    var di: ptr_uint = 0
    while di < file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(file.declarations.data + di)
        match d:
            ast.Decl.decl_interface as iface:
                if iface.name == iface_name:
                    return iface.type_params
            _:
                pass
        di += 1
    return span[ast.TypeParam]()


## Ensure a vtable for the given concrete type and interface exists.  Generates the
## vtable struct type declaration once per interface, and the wrapper functions +
## global vtable constant once per (type, interface) pair.  Returns the vtable global name.
function ensure_dyn_vtable(ctx: ref[LowerCtx], concrete_name: str, concrete_type: types.Type, iface_name: str, methods: span[ast.InterfaceMethod], type_args: span[types.Type], type_params: span[ast.TypeParam]) -> str:
    let vtable_c_name = j5("mt_vtable_", concrete_name, "_", iface_name, "")
    if ctx.dyn_generated_vtables.contains(vtable_c_name):
        return vtable_c_name

    # Ensure the vtable struct type exists (once per interface), with type subsitution.
    let vtable_type_c_name = j3("mt_vtable_", iface_name, "")
    ensure_dyn_vtable_struct(ctx, iface_name, methods, type_args, type_params)

    # Generate wrapper functions and vtable constant.
    var wrappers = gen_dyn_vtable_wrappers(ctx, concrete_name, concrete_type, iface_name, methods, type_args, type_params)
    gen_dyn_vtable_constant(ctx, iface_name, vtable_type_c_name, vtable_c_name, ref_of(wrappers), methods, type_args, type_params)

    # Ensure the dyn struct type exists (once per interface).
    ensure_dyn_struct_type(ctx, iface_name)

    ctx.dyn_generated_vtables.set(vtable_c_name, true)
    return vtable_c_name


## Substitute interface type parameters in a type used by a vtable method signature.
## When type_params is [T] and type_args is [int], `ty_var("T")` → `int`.
function substitute_interface_type_params(t: types.Type, type_args: span[types.Type], type_params: span[ast.TypeParam]) -> types.Type:
    match t:
        types.Type.ty_var as v:
            return substitute_type_arg_by_name(t, v.name, type_args, type_params)
        types.Type.ty_named as n:
            return substitute_type_arg_by_name(t, n.name, type_args, type_params)
        _:
            return t


## If `name` matches a type param, return the corresponding type arg.
## Otherwise return the original type.
function substitute_type_arg_by_name(t: types.Type, name: str, type_args: span[types.Type], type_params: span[ast.TypeParam]) -> types.Type:
    var pi: ptr_uint = 0
    while pi < type_params.len:
        var tp: ast.TypeParam
        unsafe:
            tp = read(type_params.data + pi)
        if tp.name == name and pi < type_args.len:
            unsafe:
                return read(type_args.data + pi)
        pi += 1
    return t


## Ensure the dyn struct type `mt_dyn_{iface}` exists.
function ensure_dyn_struct_type(ctx: ref[LowerCtx], iface_name: str) -> void:
    let name = j3("mt_dyn_", iface_name, "")
    var iter = ctx.pending_dyn_structs.iter()
    while true:
        let s_ptr = iter.next() else:
            break
        if unsafe: read(s_ptr).linkage_name == name:
            return
    var void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
    var fields = vec.Vec[ir.Field].create()
    fields.push(ir.Field(name = "data", ty = void_ptr))
    fields.push(ir.Field(name = "vtable", ty = void_ptr))
    ctx.pending_dyn_structs.push(ir.StructDecl(name = name, linkage_name = name, fields = fields.as_span(), packed = false, alignment = 0, source_module = Option[str].none))


## Ensure the vtable struct type `mt_vtable_{iface}` exists.  Fields are function
## pointer types so the C backend can render calls through them directly.
function ensure_dyn_vtable_struct(ctx: ref[LowerCtx], iface_name: str, methods: span[ast.InterfaceMethod], type_args: span[types.Type], type_params: span[ast.TypeParam]) -> void:
    let vtable_type_c_name = j3("mt_vtable_", iface_name, "")
    var iter = ctx.pending_dyn_vtable_structs.iter()
    while true:
        let s_ptr = iter.next() else:
            break
        if unsafe: read(s_ptr).linkage_name == vtable_type_c_name:
            return
    var void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
    var fields = vec.Vec[ir.Field].create()
    var mi: ptr_uint = 0
    while mi < methods.len:
        var m: ast.InterfaceMethod
        unsafe:
            m = read(methods.data + mi)
        var fn_params = vec.Vec[types.Type].create()
        var fn_param_names = vec.Vec[str].create()
        fn_params.push(void_ptr)
        fn_param_names.push("data")
        var pi: ptr_uint = 0
        while pi < m.method_params.len:
            var p: ast.Param
            unsafe:
                p = read(m.method_params.data + pi)
            var param_ty = resolve_field_type_ref(ctx, p.param_type)
            param_ty = substitute_interface_type_params(param_ty, type_args, type_params)
            fn_params.push(param_ty)
            fn_param_names.push(p.name)
            pi += 1
        var ret = if m.return_type != null: resolve_field_type_ref(ctx, unsafe: read(ptr[ast.TypeRef]<-m.return_type)) else: ctx.void_ty
        ret = substitute_interface_type_params(ret, type_args, type_params)
        let fn_ty = types.Type.ty_function(name = "", params = fn_params.as_span(), return_type = types.alloc_type(ret), variadic = false, is_proc = false, param_names = fn_param_names.as_span())
        fields.push(ir.Field(name = m.name, ty = fn_ty))
        mi += 1
    let vtable_decl = ir.StructDecl(name = j2("vtable_", iface_name), linkage_name = vtable_type_c_name, fields = fields.as_span(), packed = false, alignment = 0, source_module = Option[str].none)
    ctx.pending_dyn_vtable_structs.push(vtable_decl)
    ctx.pending_synthetic_structs.push(vtable_decl)


## Generate wrapper functions for each interface method, calling through to the
## concrete type's method implementation.  Returns a map from method name to wrapper C name.
function gen_dyn_vtable_wrappers(ctx: ref[LowerCtx], concrete_name: str, concrete_type: types.Type, iface_name: str, methods: span[ast.InterfaceMethod], type_args: span[types.Type], type_params: span[ast.TypeParam]) -> map_mod.Map[str, str]:
    var wrappers = map_mod.Map[str, str].create()
    var void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
    let concrete_type_name = named_type_name(concrete_type) else:
        fatal(c"dyn lowering: concrete type must be nominal")
    # Use a module-qualified type so c_type renders the correct C struct name.
    # The concrete type's OWN module is authoritative: the `adapt` site is often
    # in a different module than the type being adapted.
    var concrete_module = ctx.module_name
    match concrete_type:
        types.Type.ty_imported as cim:
            if cim.module_name.len > 0:
                concrete_module = cim.module_name
        types.Type.ty_named as cnm:
            if cnm.module_name.len > 0:
                concrete_module = cnm.module_name
        _:
            pass
    var c_ty = types.Type.ty_imported(module_name = concrete_module, name = concrete_type_name, args = span[types.Type]())
    var mi: ptr_uint = 0
    while mi < methods.len:
        var m: ast.InterfaceMethod
        unsafe:
            m = read(methods.data + mi)
        let wrapper_c_name = j3("__dyn_", concrete_name, j2("_", m.name))
        var wrapper_params = vec.Vec[ir.Param].create()
        wrapper_params.push(ir.Param(name = "data", linkage_name = "data", ty = void_ptr, pointer = Option[bool].some(value = false)))
        var pi: ptr_uint = 0
        while pi < m.method_params.len:
            var p: ast.Param
            unsafe:
                p = read(m.method_params.data + pi)
            let p_ty = substitute_interface_type_params(resolve_field_type_ref(ctx, p.param_type), type_args, type_params)
            wrapper_params.push(ir.Param(name = p.name, linkage_name = utils.c_local_name(p.name), ty = p_ty, pointer = Option[bool].some(value = false)))
            pi += 1
        let ret_ty = if m.return_type != null: substitute_interface_type_params(resolve_field_type_ref(ctx, unsafe: read(ptr[ast.TypeRef]<-m.return_type)), type_args, type_params) else: ctx.void_ty
        # Find the method info for the concrete type's method (search all modules).
        var method_info_opt: Option[DynMethodLookup]
        match concrete_type:
            types.Type.ty_named as n:
                method_info_opt = find_dyn_method(ctx, n.name, m.name, concrete_type)
            types.Type.ty_imported as im:
                method_info_opt = find_dyn_method(ctx, im.name, m.name, concrete_type)
            _:
                pass
        match method_info_opt:
            Option.some as dm:
                var real_c_name = string.String.create()
                real_c_name.append(naming.module_c_prefix(dm.value.module_name))
                real_c_name.append("_")
                real_c_name.append(dm.value.type_name)
                real_c_name.append("_")
                real_c_name.append(m.name)
                let call_name = real_c_name.as_str()
                # Build body: cast data, call real method, return.
                var body_stmts = vec.Vec[ir.Stmt].create()
                var call_args = vec.Vec[ir.Expr].create()
                if dm.value.method_kind != ast.MethodKind.mk_static:
                    # The concrete method's own convention decides: editable and
                    # array-storing receivers are borrowed (`pointer_lowered_-
                    # method_receiver?`), everything else is passed by value.
                    let pointer_recv = receiver_by_pointer(ctx, c_ty, dm.value.method_kind, false)
                    let inner_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(c_ty))
                    if pointer_recv:
                        unsafe:
                            call_args.push(read(alloc_expr(ir.Expr.expr_cast(target_type = inner_ptr_ty, expression = alloc_expr(ir.Expr.expr_name(name = "data", ty = void_ptr, pointer = Option[bool].some(value = false))), ty = inner_ptr_ty))))
                    else:
                        unsafe:
                            call_args.push(read(alloc_expr(ir.Expr.expr_unary(operator = "*", operand = alloc_expr(ir.Expr.expr_cast(target_type = inner_ptr_ty, expression = alloc_expr(ir.Expr.expr_name(name = "data", ty = void_ptr, pointer = Option[bool].some(value = false))), ty = inner_ptr_ty)), ty = c_ty))))
                pi = 0
                while pi < m.method_params.len:
                    var p: ast.Param
                    unsafe:
                        p = read(m.method_params.data + pi)
                    unsafe:
                        call_args.push(read(alloc_expr(ir.Expr.expr_name(name = utils.c_local_name(p.name), ty = substitute_interface_type_params(resolve_field_type_ref(ctx, p.param_type), type_args, type_params), pointer = Option[bool].some(value = false)))))
                    pi += 1
                let call_ret_ty = if types.is_void(ret_ty): ctx.void_ty else: ret_ty
                body_stmts.push(ir.Stmt.stmt_return(
                    value = alloc_expr(ir.Expr.expr_call(callee = call_name, arguments = call_args.as_span(), ty = call_ret_ty)),
                    line = 0,
                    source_path = "",
                ))
                ctx.pending_synthetic_functions.push(ir.Function(
                    name = wrapper_c_name,
                    linkage_name = wrapper_c_name,
                    params = wrapper_params.as_span(),
                    return_type = ret_ty,
                    body = body_stmts.as_span(),
                    entry_point = false, public_export = false,
                    method_receiver_param = false,
                ))
                wrappers.set(m.name, wrapper_c_name)
            Option.none:
                fatal(c"dyn lowering: could not find method implementation")
        mi += 1
    return wrappers


struct DynMethodLookup:
    module_name: str
    type_name: str
    method_kind: ast.MethodKind


function find_dyn_method(ctx: ref[LowerCtx], type_name: str, method_name: str, concrete_type: types.Type) -> Option[DynMethodLookup]:
    let key = analyzer.method_key(type_name, method_name)
    if ctx.analysis.method_sigs.contains(key):
        let sig_ptr = ctx.analysis.method_sigs.get(key) else:
            return Option[DynMethodLookup].none
        return Option[DynMethodLookup].some(value = DynMethodLookup(module_name = ctx.module_name, type_name = type_name, method_kind = unsafe: read(sig_ptr).method_kind))
    var import_values = ctx.analysis.imports.values()
    while true:
        let target_ptr = import_values.next() else:
            break
        let target_module = unsafe: read(target_ptr)
        match find_imported_analysis(ctx, target_module):
            Option.some as imported:
                if imported.value.method_keys.contains(key):
                    let sig_ptr = imported.value.method_sigs.get(key) else:
                        return Option[DynMethodLookup].none
                    return Option[DynMethodLookup].some(value = DynMethodLookup(module_name = target_module, type_name = type_name, method_kind = unsafe: read(sig_ptr).method_kind))
            Option.none:
                pass
    return Option[DynMethodLookup].none


## Generate a vtable global constant of type `mt_vtable_{iface}`, holding pointers
## to the wrapper functions.
function gen_dyn_vtable_constant(ctx: ref[LowerCtx], iface_name: str, vtable_type_name: str, vtable_c_name: str, wrappers: ref[map_mod.Map[str, str]], methods: span[ast.InterfaceMethod], type_args: span[types.Type], type_params: span[ast.TypeParam]) -> void:
    # The vtable constant's type is the `DynVtable` type (`mt_vtable_<Iface>` in
    # C), matching the host.
    let const_ty = types.Type.ty_dyn_vtable(interface_name = iface_name, linkage_name = vtable_type_name)
    var fields = vec.Vec[ir.AggregateField].create()
    var mi: ptr_uint = 0
    while mi < methods.len:
        var m: ast.InterfaceMethod
        unsafe:
            m = read(methods.data + mi)
        let wrapper_ptr = unsafe: read(wrappers).get(m.name) else:
            fatal(c"dyn lowering: missing wrapper for method")
        let wrapper_c_name = unsafe: read(wrapper_ptr)
        # Use the function type for the field so the constant matches the struct
        # decl — with the interface's type parameters substituted, as the struct
        # and the wrapper functions already are (a `DoublerMap[int]` vtable's
        # `map` slot takes `int`, not the interface's `T`).
        var fn_params = vec.Vec[types.Type].create()
        var fn_names = vec.Vec[str].create()
        fn_params.push(types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty)))
        fn_names.push("data")
        var pi: ptr_uint = 0
        while pi < m.method_params.len:
            var p: ast.Param
            unsafe:
                p = read(m.method_params.data + pi)
            fn_params.push(substitute_interface_type_params(resolve_field_type_ref(ctx, p.param_type), type_args, type_params))
            fn_names.push(p.name)
            pi += 1
        var ret = if m.return_type != null: resolve_field_type_ref(ctx, unsafe: read(ptr[ast.TypeRef]<-m.return_type)) else: ctx.void_ty
        ret = substitute_interface_type_params(ret, type_args, type_params)
        let fn_ty = types.Type.ty_function(name = "", params = fn_params.as_span(), return_type = types.alloc_type(ret), variadic = false, is_proc = false, param_names = fn_names.as_span())
        fields.push(ir.AggregateField(name = m.name, value = alloc_expr(ir.Expr.expr_name(name = wrapper_c_name, ty = fn_ty, pointer = Option[bool].some(value = false)))))
        mi += 1
    ctx.pending_dyn_constants.push(ir.Constant(
        name = vtable_c_name,
        linkage_name = vtable_c_name,
        ty = const_ty,
        value = alloc_expr(ir.Expr.expr_aggregate_literal(ty = const_ty, fields = fields.as_span())),
        line = 0,
        path = "",
    ))


## Lower a dyn method call `receiver.method(args)` where receiver has ty_dyn.
## Extracts data and vtable members, casts vtable to its struct type, and calls
## through the method function pointer.
function lower_dyn_method_call(ctx: ref[LowerCtx], recv: ptr[ir.Expr], method_name: str, args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    var void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
    let data = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "data", ty = void_ptr))
    let vtable_raw = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "vtable", ty = void_ptr))
    # Cast vtable void* to the vtable struct pointer type (mt_vtable_{iface}*).
    # The iface name is embedded in the ty_dyn type: use ty_named to match c_type.
    let recv_ty = ir_expr_type(recv)
    let vtable_c_type = dyn_vtable_c_type(recv_ty)
    let vtable_ty = types.Type.ty_dyn_vtable(interface_name = dyn_vtable_iface_name(recv_ty), linkage_name = vtable_c_type)
    var vtable_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(vtable_ty))
    let vtable_cast = alloc_expr(ir.Expr.expr_cast(target_type = vtable_ptr_ty, expression = vtable_raw, ty = vtable_ptr_ty))
    let method_fn = alloc_expr(ir.Expr.expr_member(receiver = vtable_cast, member = method_name, ty = dyn_vtable_method_fn_type(ctx, dyn_vtable_iface_name(recv_ty), method_name)))
    var call_args = vec.Vec[ir.Expr].create()
    unsafe:
        call_args.push(read(data))
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        let lowered = lower_expr(ctx, arg.arg_value)
        unsafe:
            call_args.push(read(lowered))
        i += 1
    return alloc_expr(ir.Expr.expr_call_indirect(callee = method_fn, arguments = call_args.as_span(), ty = iface_method_return_type(ctx, recv_ty, method_name)))


## The return type of an interface method by looking it up in the interface's
## analysis.  Replaces the analyzer's `expr_type` which can infer `void` for
## dyn dispatch where the call expression wasn't type-tracked.
function iface_method_return_type(ctx: ref[LowerCtx], recv_ty: types.Type, method_name: str) -> types.Type:
    match recv_ty:
        types.Type.ty_dyn as d:
            match find_interface_analysis(ctx, d.iface):
                Option.some as ia:
                    var mi: ptr_uint = 0
                    while mi < ia.value.methods.len:
                        var m: ast.InterfaceMethod
                        unsafe:
                            m = read(ia.value.methods.data + mi)
                        if m.name == method_name:
                            let ret = m.return_type else:
                                return ctx.void_ty
                            let resolved = resolve_field_type_ref(ctx, unsafe: read(ptr[ast.TypeRef]<-ret))
                            return substitute_interface_type_params(resolved, d.args, ia.value.type_params)
                        mi += 1
                Option.none:
                    pass
        _:
            pass
    return ctx.void_ty


## The C type name for a dyn[I] vtable struct: "mt_vtable_" + iface_name.
function dyn_vtable_c_type(t: types.Type) -> str:
    # `dyn_vtable_iface_name` reads the interface name from the type itself;
    # `type_to_string` renders the full `dyn[Shape]` spelling, which is not a
    # valid symbol.
    return j3("mt_vtable_", dyn_vtable_iface_name(t), "")


## The interface name of a `dyn[I]` receiver, for the `DynVtable` type.
function dyn_vtable_iface_name(t: types.Type) -> str:
    match t:
        types.Type.ty_dyn as d:
            return d.iface
        _:
            return "unknown"


## The `Types::Function` type of an interface method's vtable slot.  The
## generated `mt_vtable_<Iface>` struct is consulted first (it carries the
## *substituted* forms an `adapt` instantiation produced), but a call site can
## be lowered before — or in a different module than — the site that creates
## that struct, so the interface declaration itself is the fallback, exactly
## what the host's `dyn_vtable_struct_type` always builds the slot from
## (`data: ptr[void]` followed by the method's own parameters).
function dyn_vtable_method_fn_type(ctx: ref[LowerCtx], iface_name: str, method_name: str) -> types.Type:
    let vtable_type_c_name = j3("mt_vtable_", iface_name, "")
    var iter = ctx.pending_dyn_vtable_structs.iter()
    while true:
        let s_ptr = iter.next() else:
            break
        let decl = unsafe: read(s_ptr)
        if decl.linkage_name == vtable_type_c_name:
            var fi: ptr_uint = 0
            while fi < decl.fields.len:
                let f = unsafe: read(decl.fields.data + fi)
                if f.name == method_name:
                    return f.ty
                fi += 1
    match find_interface_analysis(ctx, iface_name):
        Option.some as ia:
            var mi: ptr_uint = 0
            while mi < ia.value.methods.len:
                var m: ast.InterfaceMethod
                unsafe:
                    m = read(ia.value.methods.data + mi)
                if m.name == method_name:
                    var void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
                    var fn_params = vec.Vec[types.Type].create()
                    var fn_param_names = vec.Vec[str].create()
                    fn_params.push(void_ptr)
                    fn_param_names.push("data")
                    var pi: ptr_uint = 0
                    while pi < m.method_params.len:
                        var p: ast.Param
                        unsafe:
                            p = read(m.method_params.data + pi)
                        fn_params.push(resolve_field_type_ref(ctx, p.param_type))
                        fn_param_names.push(p.name)
                        pi += 1
                    var ret = if m.return_type != null: resolve_field_type_ref(ctx, unsafe: read(ptr[ast.TypeRef]<-m.return_type)) else: ctx.void_ty
                    return types.Type.ty_function(name = "", params = fn_params.as_span(), return_type = types.alloc_type(ret), variadic = false, is_proc = false, param_names = fn_param_names.as_span())
                mi += 1
        Option.none:
            pass
    return types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))


## Resolved method call info: the C function name and the method kind (needed to
## decide whether to pass the receiver by pointer or by value).  `params` holds
## the declared parameter entries so argument lowering can coerce pointer
## arguments (e.g. `this` inside an editable method) to by-value parameters.
struct MethodInfo:
    c_name: str
    method_kind: ast.MethodKind
    return_type: types.Type
    params: span[analyzer.ParamEntry]
    ## The callee's `async` flag: async methods keep the value receiver
    ## convention (the host's `pointer_lowered_sync_method_receiver?`).
    is_async: bool


## True when `name` names a primitive type or `str` — the receiver types whose
## methods use a bare `<type>_<method>` C name with no module prefix.  Mirrors
## Ruby's `c_type_name`, which returns the bare name for primitives (a struct
## receiver instead yields `<module>_<Type>`).
function is_primitive_or_str_name(name: str) -> bool:
    return is_builtin_type_name(name) or name == "str"


## The C linkage name for a method on a primitive or `str` receiver, mirroring
## Ruby's `function_binding_c_name`: a bare `<type>_<method>` prefix (no module
## qualifier) plus a `_static` suffix for static methods, so a static hook
## (e.g. `str == left, right`) cannot collide with a same-named instance
## method (`str == right`).
function primitive_method_c_name(type_name: str, method_name: str, is_static: bool) -> str:
    var buf = string.String.create()
    buf.append(type_name)
    buf.append("_")
    buf.append(method_name)
    if is_static:
        buf.append("_static")
    return buf.as_str()


## The C linkage name for a method: the bare primitive scheme for primitive /
## `str` receivers, and the module-qualified `<module>_<type>_<method>` scheme
## for nominal (struct / variant) receivers.  The `_static` suffix only applies
## to the primitive scheme, where static hooks and instance methods can collide.
function method_link_name(module_name: str, type_name: str, method_name: str, is_static: bool) -> str:
    if is_primitive_or_str_name(type_name):
        return primitive_method_c_name(type_name, method_name, is_static)
    var name = naming.qualified_member_c_name(module_name, type_name, method_name)
    if is_static:
        return j2(name, "_static")
    return name


## The C linkage name for a resolved method call.  Prelude variants (Option,
## Result) use a bare name with no module prefix (e.g. `Option_unwrap`),
## matching the global naming scheme used when declaring Option/Result
## instances.  Primitive/str receivers use `method_link_name` for consistency
## with `lower_extending_block`.  Nominal receivers keep the module-qualified
## scheme.
function method_c_name(module_name: str, type_name: str, method_name: str, method_kind: ast.MethodKind) -> str:
    if is_prelude_variant_name(type_name):
        match prelude_variant_base(type_name):
            Option.some as p:
                var buf = string.String.create()
                buf.append(p.value)
                buf.append("_")
                buf.append(method_name)
                return buf.as_str()
            Option.none:
                pass
    return method_link_name(module_name, type_name, method_name, method_kind == ast.MethodKind.mk_static)


## The C name of a method receiver's own type, mirroring the host's `c_type_name`:
## a type living in a raw (`std.c.*`) module is named bare (`Color`), any other
## nominal type keeps its module-qualified name.  Returns none for receivers the
## host names by a different scheme (primitives, `str`, generic instances, types
## with no module attribution); callers then fall back on the declaring-module
## scheme.
function receiver_c_type_name(t: types.Type) -> Option[str]:
    match t:
        types.Type.ty_imported as im:
            if im.args.len > 0 or im.module_name.len == 0:
                return Option[str].none
            if im.module_name.starts_with("std.c."):
                return Option[str].some(value = im.name)
            return Option[str].some(value = naming.qualified_c_name(im.module_name, im.name))
        types.Type.ty_named as n:
            match n.linkage_name:
                Option.some as linked:
                    return Option[str].some(value = linked.value)
                Option.none:
                    pass
            if n.module_name.len == 0:
                return Option[str].none
            if n.module_name.starts_with("std.c."):
                return Option[str].some(value = n.name)
            return Option[str].some(value = naming.qualified_c_name(n.module_name, n.name))
        _:
            return Option[str].none


## The C linkage name for a method whose receiver type is known.  The host derives
## it from the receiver's *own* resolved type (`c_type_name`), not from the module
## that declares the `extending` block, so a method on a raw (`std.c.*`) struct is
## bare (`Color_is_equal`) even when the block lives in a wrapper module
## (`std.raylib`, `examples.box3d.common`).  Falls back to `method_c_name`'s
## declaring-module scheme when the receiver yields no C type name.
function method_c_name_for_receiver(receiver_ty: types.Type, declaring_module: str, type_name: str, method_name: str, method_kind: ast.MethodKind) -> str:
    match receiver_c_type_name(receiver_ty):
        Option.some as ct:
            var buf = string.String.create()
            buf.append(ct.value)
            buf.append("_")
            buf.append(method_name)
            if method_kind == ast.MethodKind.mk_static:
                buf.append("_static")
            return buf.as_str()
        Option.none:
            return method_c_name(declaring_module, type_name, method_name, method_kind)


## Some(type name) when `t` is a primitive or `str` receiver type, whose methods
## use the bare naming scheme; none for nominal or other receiver types.
function primitive_receiver_name(t: types.Type) -> Option[str]:
    match t:
        types.Type.ty_primitive as p:
            return Option[str].some(value = p.name)
        types.Type.ty_str:
            return Option[str].some(value = "str")
        _:
            return Option[str].none


## Extract a type name from a specialization receiver when the analyzer's
## expr_type returned void.  For `expr_specialization(callee = member_access("string", "String"), ...)`,
## returns `Option.some("String")`.
function try_spec_type_name(receiver: ptr[ast.Expr]) -> Option[str]:
    unsafe:
        match read(receiver):
            ast.Expr.expr_specialization as spec:
                match read(spec.callee):
                    ast.Expr.expr_member_access as ma:
                        return Option[str].some(value = ma.member_name)
                    ast.Expr.expr_identifier as id:
                        return Option[str].some(value = id.name)
                    _:
                        return Option[str].none
            _:
                return Option[str].none


## Resolve a method call `receiver.method(args)` to its C function name and kind,
## looking up the receiver's type in the analyzer's `method_sigs` map.  Returns
## `Option.none` when the receiver type has no such method.
## Resolve a canonical hook builtin (`hash` / `equal` / `order`) for a concrete
## type argument to the C name of the type's static hook function.  Searches the
## current module then all analyses for the module that declares `T.hook`, so
## primitive hooks (std.hash / std.str) and user struct hooks both resolve.
function resolve_canonical_hook(ctx: ref[LowerCtx], t_ty: types.Type, hook: str) -> Option[str]:
    let type_name = hook_type_name(t_ty) else:
        return Option[str].none
    let key = analyzer.method_key(type_name, hook)
    if ctx.analysis.method_sigs.contains(key):
        return Option[str].some(value = method_c_name_for_receiver(t_ty, ctx.module_name, type_name, hook, ast.MethodKind.mk_static))
    var ai: ptr_uint = 0
    while ai < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + ai)
        if a.method_sigs.contains(key):
            return Option[str].some(value = method_c_name_for_receiver(t_ty, a.module_name, type_name, hook, ast.MethodKind.mk_static))
        ai += 1
    return Option[str].none


## The base type name used to key a canonical hook lookup (`int`, `str`, or a
## nominal type's name).
function hook_type_name(t: types.Type) -> Option[str]:
    match t:
        types.Type.ty_primitive as p:
            return Option[str].some(value = p.name)
        types.Type.ty_str:
            return Option[str].some(value = "str")
        types.Type.ty_named as n:
            return Option[str].some(value = n.name)
        types.Type.ty_imported as im:
            return Option[str].some(value = im.name)
        _:
            return Option[str].none


## Resolve a method call on a primitive or `str` receiver.  Primitive methods
## live in one `extending` block (e.g. `extending str:` in std.str), so search
## the current module then every analysis for the one that declares it, and
## build the bare `<type>_<method>` C name (with `_static` for static hooks so
## `str == left, right` does not collide with the instance `str.equal`).
function resolve_primitive_method_info(ctx: ref[LowerCtx], type_name: str, method_name: str) -> Option[MethodInfo]:
    let key = analyzer.method_key(type_name, method_name)
    if ctx.analysis.method_sigs.contains(key):
        let sig_ptr = ctx.analysis.method_sigs.get(key) else:
            return Option[MethodInfo].none
        let sig = unsafe: read(sig_ptr)
        var ret = sig.return_type
        if not sig.has_return_type:
            ret = ctx.void_ty
        return Option[MethodInfo].some(value = MethodInfo(
            c_name = primitive_method_c_name(type_name, method_name, sig.method_kind == ast.MethodKind.mk_static),
            method_kind = sig.method_kind,
            return_type = qualify_type(ctx, ret),
            params = sig.params,
            is_async = sig.is_async,
        ))
    var ai: ptr_uint = 0
    while ai < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + ai)
        if a.module_name == ctx.module_name:
            ai += 1
            continue
        if a.method_sigs.contains(key):
            let sig_ptr = a.method_sigs.get(key) else:
                ai += 1
                continue
            let sig = unsafe: read(sig_ptr)
            var ret = sig.return_type
            if not sig.has_return_type:
                ret = ctx.void_ty
            return Option[MethodInfo].some(value = MethodInfo(
                c_name = primitive_method_c_name(type_name, method_name, sig.method_kind == ast.MethodKind.mk_static),
                method_kind = sig.method_kind,
                return_type = qualify_type(ctx, ret),
                params = sig.params,
                is_async = sig.is_async,
            ))
        ai += 1
    return Option[MethodInfo].none


function resolve_method_info(ctx: ref[LowerCtx], receiver_ty: types.Type, method_name: str) -> Option[MethodInfo]:
    # Auto-deref pointer / ref receivers so a method call on `this` inside an
    # editable method (where `this` is `ptr[T]`) resolves against `T`, not the
    # builtin "ptr" name (which would mis-name the call `<module>_ptr_<method>`).
    var effective_ty = receiver_ty
    if types.is_raw_pointer(effective_ty) or types.is_ref_type(effective_ty):
        effective_ty = types.pointer_element(effective_ty)
    # Primitive / `str` receivers: methods live in a single `extending` block
    # (e.g. `extending str:` in std.str) and use the bare `<type>_<method>` C
    # naming scheme, so resolve them before the nominal path.
    match primitive_receiver_name(effective_ty):
        Option.some as pn:
            return resolve_primitive_method_info(ctx, pn.value, method_name)
        Option.none:
            pass
    let type_name = named_type_name(effective_ty) else:
        let gen_var = generic_variant_name(effective_ty)
        match gen_var:
            Option.some as gv:
                let key = analyzer.method_key(gv.value, method_name)
                if ctx.analysis.method_sigs.contains(key):
                    let sig_ptr = ctx.analysis.method_sigs.get(key) else:
                        return Option[MethodInfo].none
                    let sig = unsafe: read(sig_ptr)
                    var ret = sig.return_type
                    if not sig.has_return_type:
                        ret = ctx.void_ty
                    return Option[MethodInfo].some(value = MethodInfo(c_name = naming.qualified_member_c_name(ctx.module_name, gv.value, method_name), method_kind = sig.method_kind, return_type = ret, params = sig.params, is_async = sig.is_async))
            Option.none:
                pass
        return Option[MethodInfo].none
    # Prelude variant methods (Option.is_some, Result.unwrap) are registered
    # under the base variant name, not the concrete qualified C name
    # (e.g. key "Option_is_some", not "std_map_Option_std_map_RemovedEntry_ptr_uint_bool_is_some").
    var lookup_name = type_name
    match prelude_variant_base(type_name):
        Option.some as base:
            lookup_name = base.value
        Option.none:
            pass
    let key = analyzer.method_key(lookup_name, method_name)
    if ctx.analysis.method_sigs.contains(key):
        let sig_ptr = ctx.analysis.method_sigs.get(key) else:
            return Option[MethodInfo].none
        let sig = unsafe: read(sig_ptr)
        var ret = sig.return_type
        if not sig.has_return_type:
            ret = ctx.void_ty
        return Option[MethodInfo].some(value = MethodInfo(c_name = method_c_name_for_receiver(effective_ty, ctx.module_name, type_name, method_name, sig.method_kind), method_kind = sig.method_kind, return_type = qualify_type(ctx, ret), params = sig.params, is_async = sig.is_async))
    # Search imported modules' method_sigs when the method is not found locally.
    # When the receiver type carries a specific originating module (ty_imported),
    # restrict the search to that module first so that structs with the same name
    # in different modules (e.g. Config in both std.net.session and
    # std.net.channel) resolve methods from the correct module.
    # A raw (`std.c.*`) receiver's methods are declared by wrapper modules
    # (`std.raylib`, `examples.box2d.common`) — a raw module has no `extending`
    # blocks of its own — so restricting the search to it would never match and
    # the call would fall through to a module-less re-resolution.
    var preferred_module = ""
    match effective_ty:
        types.Type.ty_imported as im:
            if not im.module_name.starts_with("std.c."):
                preferred_module = im.module_name
        _:
            pass
    var ai: ptr_uint = 0
    while ai < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + ai)
        if a.module_name == ctx.module_name:
            ai += 1
            continue
        if preferred_module.len > 0 and a.module_name != preferred_module:
            ai += 1
            continue
        if a.method_sigs.contains(key):
            let sig_ptr = a.method_sigs.get(key) else:
                ai += 1
                continue
            let sig = unsafe: read(sig_ptr)
            let mod_prefix = naming.module_c_prefix(a.module_name)
            var ret = sig.return_type
            if not sig.has_return_type:
                ret = ctx.void_ty
            # If the method returns a locally-named struct (ty_named), which is
            # defined in the imported module, convert it to ty_imported so the C
            # backend produces the module-qualified C name.
            match ret:
                types.Type.ty_named as rn:
                    if a.structs.contains(rn.name):
                        ret = types.Type.ty_imported(module_name = a.module_name, name = rn.name, args = span[types.Type]())
                _:
                    pass
            return Option[MethodInfo].some(value = MethodInfo(
                c_name = method_c_name_for_receiver(effective_ty, a.module_name, type_name, method_name, sig.method_kind),
                method_kind = sig.method_kind,
                return_type = resolve_method_return_from_import(ctx, a.module_name, sig, effective_ty),
                params = sig.params,
                is_async = sig.is_async,
            ))
        ai += 1
    return Option[MethodInfo].none


## Like resolve_method_info, but searches ONLY the named imported module
## (for module-qualified receiver types like `sess.Config.default(...)`).
function resolve_method_info_imported(ctx: ref[LowerCtx], receiver_ty: types.Type, method_name: str, import_module: str) -> Option[MethodInfo]:
    var effective_ty = receiver_ty
    if types.is_raw_pointer(effective_ty) or types.is_ref_type(effective_ty):
        effective_ty = types.pointer_element(effective_ty)
    let type_name = named_type_name(effective_ty) else:
        return Option[MethodInfo].none
    var lookup_name = type_name
    match prelude_variant_base(type_name):
        Option.some as base:
            lookup_name = base.value
        Option.none:
            pass
    let key = analyzer.method_key(lookup_name, method_name)
    var ai: ptr_uint = 0
    while ai < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + ai)
        if a.module_name == import_module:
            if a.method_sigs.contains(key):
                let sig_ptr = a.method_sigs.get(key) else:
                    return Option[MethodInfo].none
                let sig = unsafe: read(sig_ptr)
                var ret = sig.return_type
                if not sig.has_return_type:
                    ret = ctx.void_ty
                match ret:
                    types.Type.ty_named as rn:
                        if a.structs.contains(rn.name):
                            ret = types.Type.ty_imported(module_name = a.module_name, name = rn.name, args = span[types.Type]())
                    _:
                        pass
                return Option[MethodInfo].some(value = MethodInfo(
                    c_name = method_c_name_for_receiver(effective_ty, a.module_name, type_name, method_name, sig.method_kind),
                    method_kind = sig.method_kind,
                    return_type = resolve_method_return_from_import(ctx, a.module_name, sig, effective_ty),
                    params = sig.params,
                    is_async = sig.is_async,
                ))
            return Option[MethodInfo].none
        ai += 1
    return Option[MethodInfo].none


## Lower a static method / hook call `Type.method(args)` where the receiver is a
## bare type name and there is no receiver value to pass: lower only the
## arguments and emit a direct call to the static C function.
function lower_static_call_args(ctx: ref[LowerCtx], mi: MethodInfo, args: span[ast.Argument]) -> ptr[ir.Expr]:
    var ir_args = vec.Vec[ir.Expr].create()
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        var lowered = lower_expr(ctx, arg.arg_value)
        # The host contextualizes every call argument, so a bare literal takes
        # the declared parameter's type (`Color.from_rgba(10, 20, 30, 200)`).
        lowered = coerce_literal_to_param_type(ctx, mi.params, i, arg.arg_value, lowered)
        # A pointer argument (e.g. `this` inside an editable method) passed to
        # a by-value parameter is dereferenced, mirroring Ruby's `*this`
        # projection and the monomorphized-path `coerce_arg_to_param`.
        if i < mi.params.len:
            var declared: types.Type
            unsafe:
                declared = read(mi.params.data + i).ty
            lowered = coerce_arg_to_ref_bridge(declared, lowered)
            if ir_expr_is_pointer(lowered) and not is_pointer_or_ref_type(declared):
                lowered = alloc_expr(ir.Expr.expr_unary(operator = "*", operand = lowered, ty = ir_expr_deref_type(lowered)))
        unsafe:
            ir_args.push(read(lowered))
        i += 1
    return alloc_expr(ir.Expr.expr_call(callee = mi.c_name, arguments = ir_args.as_span(), ty = mi.return_type))


function lower_method_resolved(ctx: ref[LowerCtx], mi: MethodInfo, receiver: ptr[ast.Expr], args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    let recv = lower_expr(ctx, receiver)
    var ir_args = vec.Vec[ir.Expr].create()
    match build_receiver_arg(ctx, recv, mi.method_kind, mi.is_async):
        Option.some as recv_arg:
            unsafe:
                ir_args.push(read(recv_arg.value))
        Option.none:
            pass
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        var lowered = lower_expr(ctx, arg.arg_value)
        lowered = coerce_literal_to_param_type(ctx, mi.params, i, arg.arg_value, lowered)
        if i < mi.params.len:
            var declared: types.Type
            unsafe:
                declared = read(mi.params.data + i).ty
            lowered = coerce_arg_to_ref_bridge(declared, lowered)
        # Coerce a bare function-identifier argument to proc when the lowered
        # IR is a name expression with a fn-pointer type: wrap it in a proc
        # struct so method calls with proc parameters receive the expected type.
        unsafe:
            match read(lowered):
                ir.Expr.expr_name as nm:
                    if is_fn_type(nm.ty):
                        match read(arg.arg_value):
                            ast.Expr.expr_identifier as fn_id:
                                if ctx.function_returns.contains(fn_id.name) or ctx.analysis.functions.contains(fn_id.name):
                                    lowered = lower_fn_to_proc(ctx, nm.name, nm.ty, "")
                            _:
                                pass
                _:
                    pass
        unsafe:
            ir_args.push(read(lowered))
        i += 1
    return alloc_expr(ir.Expr.expr_call(callee = mi.c_name, arguments = ir_args.as_span(), ty = mi.return_type))


## True when a method's receiver parameter is passed as a pointer, mirroring the
## host's `pointer_lowered_method_receiver?`: an editable method always borrows
## its receiver (async included); a plain *sync* method borrows it when the
## receiver type contains array storage (`type_contains_array_storage?` — a
## struct holding an `array[T, N]` directly or through nested structs/nullables).
function receiver_by_pointer(ctx: ref[LowerCtx], receiver_ty: types.Type, method_kind: ast.MethodKind, is_async: bool) -> bool:
    # The host's `pointer_lowered_method_receiver?`: an editable receiver always
    # borrows (async included); the array-storage rule only applies to sync
    # methods (`resolve.rb:1048-1052`).
    if method_kind == ast.MethodKind.mk_editable:
        return true
    if is_async:
        return false
    return type_contains_array_storage(ctx, receiver_ty)


## The host's `ContainsArrayStorageVisitor`: nullable bases and struct fields are
## walked; only an `array` instance sets the flag.  Generic types other than
## `array` are not descended into (a `ptr[array[T, N]]` does not count), and the
## struct field lookup uses the *declared* fields (which is the same answer for
## the instantiated forms this rule sees).
function type_contains_array_storage(ctx: ref[LowerCtx], ty: types.Type) -> bool:
    return type_contains_array_storage_at(ctx, ty, 0)


function type_contains_array_storage_at(ctx: ref[LowerCtx], ty: types.Type, depth: ptr_uint) -> bool:
    if depth > 8:
        return false
    match ty:
        types.Type.ty_nullable as nl:
            return type_contains_array_storage_at(ctx, unsafe: read(nl.base), depth + 1)
        types.Type.ty_generic as g:
            return g.name == "array"
        types.Type.ty_named:
            pass
        types.Type.ty_imported:
            pass
        _:
            return false
    let fields = struct_fields_of(ctx, ty) else:
        return false
    var fi: ptr_uint = 0
    while fi < fields.len:
        if type_contains_array_storage_at(ctx, unsafe: read(fields.data + fi).ty, depth + 1):
            return true
        fi += 1
    return false


## Build the receiver argument for a method call, applying auto-ref / auto-deref
## so the passed value matches the C receiver parameter:
##   - static:   no receiver argument (returns none)
##   - pointer receiver (an editable method, or a sync method whose receiver
##               type contains array storage): pass a pointer receiver through,
##               else take its address (`&value`)
##   - value receiver: dereference a pointer receiver (`*p`), else pass the
##               value through
## This mirrors the Ruby lowerer's implicit receiver borrow/deref and, in
## particular, makes `this.method()` calls inside editable methods (where `this`
## is already a pointer) pass `this` directly instead of `&this`.
function build_receiver_arg(ctx: ref[LowerCtx], recv: ptr[ir.Expr], method_kind: ast.MethodKind, is_async: bool) -> Option[ptr[ir.Expr]]:
    if method_kind == ast.MethodKind.mk_static:
        return Option[ptr[ir.Expr]].none
    let recv_ty = ir_expr_type(recv)
    let recv_is_pointer = is_pointer_or_ref_type(recv_ty)
    # A pointer-lowered receiver can also be a `pointer`-flagged name whose
    # static type is the base struct (e.g. `this` in an editable method), or a
    # dereference result.  Mirror the host's expression-level checks.
    var recv_is_ptr_expr = false
    var recv_deref: Option[ptr[ir.Expr]] = Option[ptr[ir.Expr]].none
    unsafe:
        match read(recv):
            ir.Expr.expr_name as n:
                recv_is_ptr_expr = n.pointer.unwrap_or(false)
            ir.Expr.expr_unary as u:
                if u.operator == "*":
                    recv_deref = Option[ptr[ir.Expr]].some(value = u.operand)
            _:
                pass
    # The host decides pointer lowering from the method's *declared* receiver
    # type (the struct), not from a ref/pointer expression that reaches it
    # (`screen: ref[Game]` calling a `Game` method: Game has array storage, so
    # the receiver is borrowed and the ref value passes straight through).
    var decision_ty = recv_ty
    if is_pointer_or_ref_type(recv_ty):
        decision_ty = types.pointer_element(recv_ty)
    if receiver_by_pointer(ctx, decision_ty, method_kind, is_async):
        if recv_is_pointer or recv_is_ptr_expr:
            return Option[ptr[ir.Expr]].some(value = recv)
        match recv_deref:
            Option.some as operand:
                return Option[ptr[ir.Expr]].some(value = operand.value)
            Option.none:
                pass
        # The host types the auto-borrow as the receiver's base type (the `*`
        # is implied by the address-of), not `ptr[T]`.
        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_address_of(
            expression = recv,
            ty = recv_ty,
        )))
    # Plain value receiver.
    if types.is_ref_type(recv_ty):
        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_unary(
            operator = "*",
            operand = recv,
            ty = types.pointer_element(recv_ty),
        )))
    if recv_is_ptr_expr:
        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_unary(
            operator = "*",
            operand = recv,
            ty = recv_ty,
        )))
    if is_pointer_or_ref_type(recv_ty):
        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_unary(
            operator = "*",
            operand = recv,
            ty = types.pointer_element(recv_ty),
        )))
    return Option[ptr[ir.Expr]].some(value = recv)


# =============================================================================
#  Generic method monomorphization
#
#  Generic *functions* are monomorphized by `lower_monomorphized_call`.  Methods
#  on generic types (e.g. `Vec[int].create()`, `v.push(7)` where `v: Vec[int]`)
#  are monomorphized here: a method call on a concrete instance of a user-defined
#  generic struct clones the method body with the struct's type parameters bound
#  to the receiver's concrete type arguments and emits a specialized C function.
#
#  Mirrors the Ruby lowerer, where `specialize_function_binding` derives the
#  substitution from the receiver type (`infer_receiver_type_substitutions`) and
#  `instantiate_function_binding` produces a specialized instance.  The self-host
#  uses inline caller-side monomorphization (like its generic-function path) and
#  lowers the body in the *owner* module's context so the method's recorded
#  expression types and imports resolve correctly.
# =============================================================================

## The initial reach-edge list for a new specialization (its first creator).
function make_spec_reachers(creator: str) -> vec.Vec[str]:
    var reachers = vec.Vec[str].create()
    if creator.len > 0:
        reachers.push(creator)
    return reachers


## A concrete generic receiver: the struct name and its resolved type arguments
## (e.g. `Vec` + `[int]`).  Type-parameter arguments are resolved through the
## active substitution so nested method calls inside monomorphized bodies work.
## Metadata recorded for each monomorphized function/method so the driver can
## attribute it to its owner module and order it like the host
## (`lower_functions`: declaration order, instances sorted by type arguments).
struct SpecInfo:
    owner_module: str
    ## True when the analyzer checked this specialization's body, so the host's
    ## *analyzer* also instantiated the concrete calls inside it.  The binding's
    ## own pre-instantiation is separate: the iterator protocol instantiates
    ## `iter`/`next` without validating their bodies.
    body_validated: bool
    ## True when this specialization was first created from a normal call site
    ## (as opposed to the iterator protocol's `iter`/`next`/`current` lookup).
    ## A normal call from a validated body means the analyzer validated this
    ## specialization's body too.
    creation_normal_call: bool
    ## Every function/method linkage from whose body a *normal* call reached this
    ## specialization (the first creator and any later cache hits).  Validation
    ## propagates along these edges at placement time, independent of lowering
    ## order: the analyzer validated every callee body of an analyzed body.
    reachers: vec.Vec[str]
    ## "fn:<name>" or "method:<Type>.<name>".
    decl_key: str
    ## Type arguments joined with "_" (host `type_arguments.map(&:to_s).join`).
    args_key: str
    ## Linkage name of the function whose body lowering instantiated this
    ## specialization.  The host creates the instance at the call site while
    ## lowering that function, so the fixpoint emits the instance at its owner
    ## declaration's next visit.  Empty when it was created outside a function
    ## body (module constants/globals, synthetic setup).
    creator: str
    ## True when the host's *analyzer* already instantiated this binding (a call
    ## site in analyzed source, recursively through instantiated generic bodies).
    ## Those instances exist before lowering starts, so the setup pass emits them
    ## at their declaration visit.  Instances the analyzer never saw (synthesized
    ## calls such as the async main's `wait`) are created during lowering and are
    ## gated on their creator's visit instead.
    pre_instantiated: bool
    ## When `creator` is empty and the instance was not pre-instantiated, the
    ## module whose setup lowering created it (module constants/globals, the
    ## async main entrypoint, synthetic setup).  The host's setup pass makes
    ## such an instance available at that module's visit, so later modules in
    ## the same pass may emit it while earlier ones wait a pass.
    setup_module: str


struct GenericReceiver:
    owner_name: str
    concrete_args: span[types.Type]
    ## The module that defines the receiver struct, sourced from the receiver
    ## type itself.  Authoritative for C-name mangling so same-named structs in
    ## different modules (e.g. `map.Entries` vs `fs.Entries`) do not collide.
    ## Empty when the module is not recoverable; callers then fall back to a
    ## by-name scan of the program analyses.
    owner_module: str


## A located generic method: the module that defines the extending block, the
## struct's type-parameter names, and the method's AST declaration.
struct GenericMethodMatch:
    owner_module: str
    struct_param_names: span[str]
    method: ast.Method


## The first component of a qualified name (`vec.Vec` -> "vec"; `Vec` -> "Vec").
function qname_first(qn: ast.QualifiedName) -> str:
    if qn.parts.len == 0:
        return ""
    return unsafe: read(qn.parts.data + 0)


## The last component of a qualified name (`bin.Reader` -> "Reader"; `Reader` -> "Reader").
function qname_last(qn: ast.QualifiedName) -> str:
    if qn.parts.len == 0:
        return ""
    return unsafe: read(qn.parts.data + qn.parts.len - 1)


## The type-parameter names declared by an extending block's receiver type
## arguments (`extending Vec[T]:` -> ["T"]).
function type_param_names_of(args: span[ast.TypeRef]) -> span[str]:
    var names = vec.Vec[str].create()
    var i: ptr_uint = 0
    while i < args.len:
        unsafe:
            names.push(qname_first(read(args.data + i).name))
        i += 1
    return names.as_span()


## A named method within an extending block's method list.
function find_method_in_block(methods: span[ast.Method], name: str) -> Option[ast.Method]:
    var i: ptr_uint = 0
    while i < methods.len:
        var m: ast.Method
        unsafe:
            m = read(methods.data + i)
        if m.name == name:
            return Option[ast.Method].some(value = m)
        i += 1
    return Option[ast.Method].none


## True when a type is an unresolved type parameter (`ty_var`, or a bare named
## type using a raw parameter letter) — i.e. not a concrete type argument.
function type_is_unresolved_param(t: types.Type) -> bool:
    if type_is_type_var(t):
        return true
    match t:
        types.Type.ty_named as n:
            return is_raw_type_param_name(n.name)
        types.Type.ty_imported as im:
            return is_raw_type_param_name(im.name)
        _:
            return false


## Extract a concrete generic-struct receiver from a receiver type.  Returns
## none for non-generic, builtin (`span`/`array`/`ptr`/...), and prelude-variant
## (`Option`/`Result`) receivers, which are handled by other lowering paths.
## Type-parameter arguments are resolved through the active substitution; if any
## remain abstract the receiver is not a concrete instance and none is returned.
function generic_receiver_info(ctx: ref[LowerCtx], recv_ty: types.Type) -> Option[GenericReceiver]:
    # Auto-deref: when the receiver is a pointer or ref, unwrap to the pointee
    # type because method calls auto-dereference the receiver.
    var effective = recv_ty
    if types.is_raw_pointer(effective) or types.is_ref_type(effective):
        effective = types.pointer_element(effective)
    var owner_name: str
    var raw_args: span[types.Type]
    var owner_module: str = ""
    match effective:
        types.Type.ty_imported as im:
            owner_name = im.name
            raw_args = im.args
            owner_module = im.module_name
        types.Type.ty_generic as g:
            if is_builtin_pointer_generic(g.name):
                return Option[GenericReceiver].none
            owner_name = g.name
            raw_args = g.args
        types.Type.ty_named as n:
            # A registered generic instance carries its true owner: a user
            # variant whose type arguments mention Option/Result (e.g.
            # `Foo[Option[int]]`) would otherwise be misread as the prelude
            # variant by the fallback below.
            let instance_ptr = generic_instance_get(ctx, n.name)
            if instance_ptr != null:
                let inst = unsafe: read(instance_ptr)
                owner_name = inst.owner_name
                raw_args = inst.concrete_args
                owner_module = inst.owner_module
            else:
                # Collapsed prelude-variant instance (`Option_str`): recover owner +
                # args from the pending generic-variant registry so prelude methods
                # monomorphize instead of falling to the module-qualified fallback.
                if not is_prelude_variant_name(n.name):
                    return Option[GenericReceiver].none
                match prelude_instance_args(ctx, n.name):
                    Option.some as rec:
                        return Option[GenericReceiver].some(value = rec.value)
                    Option.none:
                        return Option[GenericReceiver].none
        _:
            return Option[GenericReceiver].none
    if owner_module.len == 0 and is_prelude_variant_name(owner_name):
        # A prelude receiver (`Option[T]`) belongs to its prelude module.
        owner_module = if owner_name == "Option": "std.option" else: "std.result"
    var resolved = vec.Vec[types.Type].create()
    var i: ptr_uint = 0
    while i < raw_args.len:
        let arg = unsafe: read(raw_args.data + i)
        let concrete = substitute_type_params(ctx, arg, ref_of(ctx.type_substitution))
        if type_is_unresolved_param(concrete):
            return Option[GenericReceiver].none
        # Qualify in the caller's context so a concrete element type from a
        # module the container (owner) does not import still renders with its
        # correct prefix when the method body is lowered in owner context.
        resolved.push(qualify_type(ctx, concrete))
        i += 1
    return Option[GenericReceiver].some(value = GenericReceiver(owner_name = owner_name, concrete_args = resolved.as_span(), owner_module = owner_module))


## Receiver info for the specialization-member path (`p.cast[ubyte]()`) when the
## receiver is a raw `ptr[T]` / `const_ptr[T]`.  The general method-call path
## auto-dereferences raw pointers and so excludes them, but their extending-block
## methods with their own type parameters must still monomorphize.
function ptr_specialization_receiver_info(ctx: ref[LowerCtx], recv_ty: types.Type) -> Option[GenericReceiver]:
    var effective = recv_ty
    if types.is_nullable_type(effective):
        effective = types.unwrap_nullable(effective)
    match effective:
        types.Type.ty_generic as g:
            if g.name != "ptr" and g.name != "const_ptr":
                return Option[GenericReceiver].none
            var resolved = vec.Vec[types.Type].create()
            var i: ptr_uint = 0
            while i < g.args.len:
                let concrete = substitute_type_params(ctx, unsafe: read(g.args.data + i), ref_of(ctx.type_substitution))
                if type_is_unresolved_param(concrete):
                    return Option[GenericReceiver].none
                resolved.push(qualify_type(ctx, concrete))
                i += 1
            return Option[GenericReceiver].some(value = GenericReceiver(owner_name = "ptr", concrete_args = resolved.as_span(), owner_module = ""))
        _:
            return Option[GenericReceiver].none


## Recover a prelude variant's owner name and concrete type arguments from its
## collapsed C name (`Option_str` → owner "Option", args [str]) by looking up the
## already-emitted concrete variant declaration in `pending_generic_variants`.
## The declaration's arm field types carry the concrete args (Option.some.value,
## Result.success.value + Result.failure.error), so they can be recovered without
## re-parsing the mangled name.
function prelude_instance_args(ctx: ref[LowerCtx], c_name: str) -> Option[GenericReceiver]:
    let base = prelude_variant_base(c_name) else:
        return Option[GenericReceiver].none
    var si: ptr_uint = 0
    while si < ctx.pending_generic_variants.len():
        let vp = ctx.pending_generic_variants.get(si) else:
            break
        var decl: ir.VariantDecl
        unsafe:
            decl = read(vp)
        if decl.linkage_name == c_name:
            var args = vec.Vec[types.Type].create()
            # Option: [some.value]; Result: [success.value, failure.error].
            var ai: ptr_uint = 0
            while ai < decl.arms.len:
                var arm: ir.VariantArm
                unsafe:
                    arm = read(decl.arms.data + ai)
                if arm.fields.len > 0:
                    unsafe:
                        args.push(read(arm.fields.data + 0).ty)
                ai += 1
            if args.len() > 0:
                # Prelude instances belong to their prelude module, so the driver
                # can place them in that module's function list.
                let owner_mod = if base == "Option": "std.option" else: "std.result"
                return Option[GenericReceiver].some(value = GenericReceiver(owner_name = base, concrete_args = args.as_span(), owner_module = owner_mod))
        si += 1
    return Option[GenericReceiver].none


## Locate a generic method by owner-struct name and method name: search every
## module for a generic extending block (`extending Owner[...]:`) on a struct
## named `owner_name` that declares `method_name`.  Extending blocks for a struct
## may appear in any module that imports it, not just the defining module (e.g.
## `std.serialize` declares `extending bin.Reader: function unpack[T]()` even
## though `Reader` is defined in `std.binary`).
function find_generic_method(ctx: ref[LowerCtx], owner_name: str, method_name: str) -> Option[GenericMethodMatch]:
    var ai: ptr_uint = 0
    while ai < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + ai)
        match find_generic_method_in_analysis(a, owner_name, method_name):
            Option.some as gm:
                return Option[GenericMethodMatch].some(value = gm.value)
            Option.none:
                pass
        ai += 1
    return Option[GenericMethodMatch].none


## Search one module's `extending` blocks for a method.
function find_generic_method_in_analysis(a: analyzer.Analysis, owner_name: str, method_name: str) -> Option[GenericMethodMatch]:
    var di: ptr_uint = 0
    while di < a.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(a.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_extending_block as ex:
                let type_ref = unsafe: read(ex.type_name)
                if qname_last(type_ref.name) == owner_name:
                    match find_method_in_block(ex.methods, method_name):
                        Option.some as m:
                            return Option[GenericMethodMatch].some(value = GenericMethodMatch(
                                owner_module = a.module_name,
                                struct_param_names = type_param_names_of(type_ref.arguments),
                                method = m.value,
                            ))
                        Option.none:
                            pass
            _:
                pass
        di += 1
    return Option[GenericMethodMatch].none


## Resolve a generic method preferring the receiver struct's defining module.
## Two structs with the same name in different modules (linked_map.Entry vs
## counter.Entry) each have their own `extending` block; a name-only scan would
## pick whichever module is loaded first.  Falls back to the program-wide scan
## when the defining module does not declare the method (an extending block may
## live in another module, e.g. std.serialize extends std.binary Writer).
function find_generic_method_in_module(ctx: ref[LowerCtx], owner_name: str, method_name: str, module_name: str) -> Option[GenericMethodMatch]:
    if module_name.len > 0:
        var ai: ptr_uint = 0
        while ai < ctx.program_analyses.len:
            var a: analyzer.Analysis
            unsafe:
                a = read(ctx.program_analyses.data + ai)
            if a.module_name == module_name:
                match find_generic_method_in_analysis(a, owner_name, method_name):
                    Option.some as gm:
                        return Option[GenericMethodMatch].some(value = gm.value)
                    Option.none:
                        pass
                break
            ai += 1
    return find_generic_method(ctx, owner_name, method_name)


## Extract a concrete generic-struct receiver from a specialization receiver
## expression (`Vec[int]` in `Vec[int].create()`), reading the real type
## arguments from the AST.  This is needed because `expr_type` records a
## placeholder (`ty_error`) argument for specialization expressions.
function spec_receiver_info(ctx: ref[LowerCtx], receiver: ptr[ast.Expr]) -> Option[GenericReceiver]:
    unsafe:
        match read(receiver):
            ast.Expr.expr_specialization as spec:
                let owner_name = spec_callee_name(spec.callee) else:
                    return Option[GenericReceiver].none
                if is_builtin_pointer_generic(owner_name) or is_prelude_variant_name(owner_name):
                    return Option[GenericReceiver].none
                if spec.arguments.len == 0:
                    return Option[GenericReceiver].none
                var resolved = vec.Vec[types.Type].create()
                var i: ptr_uint = 0
                while i < spec.arguments.len:
                    let raw = resolve_type_ref(ctx, read(spec.arguments.data + i).value)
                    let concrete = substitute_type_params(ctx, raw, ref_of(ctx.type_substitution))
                    if types.is_error(concrete) or type_is_unresolved_param(concrete):
                        return Option[GenericReceiver].none
                    resolved.push(qualify_type(ctx, concrete))
                    i += 1
                return Option[GenericReceiver].some(value = GenericReceiver(owner_name = owner_name, concrete_args = resolved.as_span(), owner_module = ""))
            _:
                return Option[GenericReceiver].none


## The struct name a specialization callee refers to (`vec.Vec` -> "Vec";
## `Vec` -> "Vec").
function spec_callee_name(callee: ptr[ast.Expr]) -> Option[str]:
    unsafe:
        match read(callee):
            ast.Expr.expr_member_access as ma:
                return Option[str].some(value = ma.member_name)
            ast.Expr.expr_identifier as id:
                return Option[str].some(value = id.name)
            _:
                return Option[str].none


## Attempt to lower a method call as a generic-method monomorphization.  Returns
## none when the receiver is not a concrete instance of a user generic struct, or
## when the method declares its own type parameters (deferred — those need
## call-site type-argument inference and fall through to ordinary resolution).
function try_generic_method_call(ctx: ref[LowerCtx], recv_ty: types.Type, method_name: str, receiver: ptr[ast.Expr], args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> Option[ptr[ir.Expr]]:
    var info_opt = spec_receiver_info(ctx, receiver)
    if info_opt.is_none():
        # Raw pointer receivers (`ptr[T].load()`, `p.store(v)`) auto-dereference
        # in the general path, but their extending-block methods still need to
        # monomorphize against the pointer type.  Tried before the generic
        # receiver path so `ptr[simd].load()` is not mis-attributed to an
        # `extending simd` block.
        info_opt = ptr_specialization_receiver_info(ctx, recv_ty)
    if info_opt.is_none():
        info_opt = generic_receiver_info(ctx, recv_ty)
    if info_opt.is_none():
        # The collapsed IR type is a concrete `ty_named` whose generic-instance
        # entry was registered in the defining module's context, not this one
        # (e.g. a local bound from a cross-module call `da.check()` returning
        # `Vec[Diag]`).  The analyzer's recorded receiver type still carries the
        # generic form with type args, so recover owner + args from it.
        info_opt = generic_receiver_info(ctx, expr_type(ctx, receiver))
    if info_opt.is_none():
        # Fallback for identifier receivers (`this`, locals): the analyzer's
        # recorded type can lack recoverable type arguments, but the binding's
        # lowered IR type carries the concrete (collapsed) struct name, which the
        # generic-struct instance map can map back to its type arguments.
        # Restricted to identifiers because lowering them has no side effects.
        var is_identifier = false
        unsafe:
            match read(receiver):
                ast.Expr.expr_identifier:
                    is_identifier = true
                _:
                    pass
        if is_identifier:
            info_opt = generic_receiver_info(ctx, ir_expr_type(lower_expr(ctx, receiver)))
    var info = info_opt else:
        return Option[ptr[ir.Expr]].none
    var gm_opt = find_generic_method_in_module(ctx, info.owner_name, method_name, info.owner_module)
    if gm_opt.is_none() and (types.is_raw_pointer(recv_ty) or types.is_ref_type(recv_ty)):
        # A raw-pointer receiver also dispatches to methods on its pointee
        # (auto-deref): retry against the dereferenced generic receiver.
        match generic_receiver_info(ctx, recv_ty):
            Option.some as alt:
                match find_generic_method_in_module(ctx, alt.value.owner_name, method_name, alt.value.owner_module):
                    Option.some as alt_gm:
                        info = alt.value
                        gm_opt = Option[GenericMethodMatch].some(value = alt_gm.value)
                    Option.none:
                        pass
            Option.none:
                pass
    let gm = gm_opt else:
        return Option[ptr[ir.Expr]].none
    # Async methods are lowered eagerly through the CPS path (lower_async_fn) and
    # resolved via resolve_method_info (which returns their Task[T] type + CPS
    # constructor).  Monomorphizing them here would produce a plain, non-CPS
    # function returning the unwrapped type, so defer to resolve_method_info.
    if gm.method.is_async:
        return Option[ptr[ir.Expr]].none
    if gm.method.type_params.len > 0:
        # Method has its own type parameters (e.g. `map_error[F]`).
        # Infer each from the argument types and extend the concrete args.
        var extended_args = vec.Vec[types.Type].create()
        var ai: ptr_uint = 0
        while ai < info.concrete_args.len:
            unsafe:
                extended_args.push(read(info.concrete_args.data + ai))
            ai += 1
        var tpi: ptr_uint = 0
        var all_inferred = true
        while tpi < gm.method.type_params.len:
            var tp: ast.TypeParam
            unsafe:
                tp = read(gm.method.type_params.data + tpi)
            let inferred = infer_type_param_from_args(ctx, tp.name, gm.method.method_params, args) else:
                all_inferred = false
                break
            extended_args.push(inferred)
            tpi += 1
        if not all_inferred:
            return Option[ptr[ir.Expr]].none
        let extended_info = GenericReceiver(owner_name = info.owner_name, concrete_args = extended_args.as_span(), owner_module = info.owner_module)
        return Option[ptr[ir.Expr]].some(value = lower_monomorphized_method(ctx, extended_info, gm, method_name, receiver, args))
    return Option[ptr[ir.Expr]].some(value = lower_monomorphized_method(ctx, info, gm, method_name, receiver, args))


## True for the builtin generic constructors a method receiver can instantiate
## (`ptr[T]`, `span[T]`, `array[T, N]`, ...).
function is_builtin_generic_receiver_name(name: str) -> bool:
    return (
        name == "ptr" or name == "const_ptr" or name == "own" or name == "ref"
        or name == "span" or name == "array" or name == "str_buffer"
        or name == "atomic" or name == "Task" or name == "SoA" or name == "simd"
    )


## The C linkage name for a monomorphized method instance.  Struct receivers use
## the module-qualified concrete-struct prefix (`std_vec_Vec_int_push`); prelude
## variant receivers (Option/Result) use the global concrete-variant prefix with
## no module qualifier (`Option_str_unwrap`), matching how prelude variant
## instances are named globally elsewhere.
## When the method declares its own type params (e.g. `unpack[T]()` on a non-generic
## struct), those args are appended after the method name so the struct prefix
## stays stable: `std_binary_Reader_unpack_CompactHeader`.
function monomorphized_method_c_name(owner_module: str, info: GenericReceiver, gm: GenericMethodMatch, method_name: str) -> str:
    var buf = string.String.create()
    # Host `function_binding_c_name`: the receiver prefix is the *unspecialized*
    # type name (`std_vec_Vec`), the method name follows (with `_static` for
    # static methods), and every type argument — struct-level and method-level —
    # follows a double underscore (`std_vec_Vec_push__int`).
    if is_prelude_variant_name(info.owner_name):
        if info.owner_name == "Option":
            buf.append("std_option_Option")
        else:
            buf.append("std_result_Result")
    else if is_builtin_generic_receiver_name(info.owner_name) and gm.struct_param_names.len > 0:
        # The host's receiver type at the declaration is the builtin instance
        # over its type parameters, renamed `__receiver_argN`
        # (`module_binding.rb:33`), so `extending ptr[T]` methods link as
        # `ptr_receiver_arg0_<method>__<concrete args>`.
        buf.append(info.owner_name)
        var rpi: ptr_uint = 0
        while rpi < gm.struct_param_names.len:
            buf.append("_receiver_arg")
            buf.append(pw1_str(rpi))
            rpi += 1
    else if info.owner_module.starts_with("std.c."):
        # A raw-module receiver's C type is its bare name (`Image_draw_pixel`),
        # not a module-qualified symbol.
        buf.append(info.owner_name)
    else:
        buf.append(naming.qualified_c_name(owner_module, info.owner_name))
    buf.append("_")
    buf.append(method_name)
    if gm.method.method_kind == ast.MethodKind.mk_static:
        buf.append("_static")
    if info.concrete_args.len > 0:
        buf.append("__")
        var ai: ptr_uint = 0
        while ai < info.concrete_args.len:
            if ai > 0:
                buf.append("_")
            unsafe:
                buf.append(naming.type_c_key(read(info.concrete_args.data + ai)))
            ai += 1
    return buf.as_str()


## Lower a monomorphized method call: ensure the specialized method body exists,
## then emit a direct C call to it with the receiver argument.  The specialized
## C name groups by the concrete struct (`std_vec_Vec_int_push`), matching the
## monomorphized struct type produced by `qualify_type`.
function lower_monomorphized_method(ctx: ref[LowerCtx], info: GenericReceiver, gm: GenericMethodMatch, method_name: str, receiver: ptr[ast.Expr], args: span[ast.Argument]) -> ptr[ir.Expr]:

    # For the struct prefix in the C name, use the struct's defining module
    # (which may differ from the extending-block module, e.g. `Writer` is
    # defined in `std_binary` but extended by `std_serialize`).  The receiver
    # type's own module (`info.owner_module`) is authoritative when known;
    # otherwise fall back to a by-name scan of the program analyses, which is
    # ambiguous when several modules declare a struct with the same simple name.
    var struct_module = info.owner_module
    if struct_module.len == 0:
        struct_module = gm.owner_module
        var sai: ptr_uint = 0
        while sai < ctx.program_analyses.len:
            var sa: analyzer.Analysis
            unsafe:
                sa = read(ctx.program_analyses.data + sai)
            if struct_in_source(sa, info.owner_name) or sa.structs.contains(info.owner_name):
                struct_module = sa.module_name
                break
            sai += 1
    let method_c = monomorphized_method_c_name(struct_module, info, gm, method_name)

    if not ctx.specialization_cache.contains(method_c) and not ctx.spec_in_progress.contains(method_c):
        ensure_monomorphized_method(ctx, method_c, info, gm, ctx.pre_instantiated_context)
    else:
        note_validated_spec_reach(ctx, method_c)

    var ret_ty = ctx.void_ty
    let cached = ctx.specialization_cache.get(method_c)
    if cached != null:
        ret_ty = unsafe: read(cached).return_type
    else:
        # A recursive self-call reaches here while the specialization is still
        # being lowered, so only the pre-registered return type is available.
        let fr = ctx.function_returns.get(method_c)
        if fr != null:
            ret_ty = unsafe: read(fr)

    let recv = lower_expr(ctx, receiver)
    var ir_args = vec.Vec[ir.Expr].create()
    var param_offset: ptr_uint = 0
    if is_builtin_pointer_generic(info.owner_name) and gm.method.method_kind != ast.MethodKind.mk_static:
        # The declared receiver is itself the builtin generic (`extending
        # ptr[T]`): pass it through (address-of for editable) rather than
        # auto-dereferencing as a value receiver.
        var ptr_recv = recv
        if gm.method.method_kind == ast.MethodKind.mk_editable and not ir_expr_is_pointer(recv):
            ptr_recv = alloc_expr(ir.Expr.expr_address_of(
                expression = recv,
                ty = types.Type.ty_generic(name = "ptr", args = sp_type(ir_expr_type(recv))),
            ))
        unsafe:
            ir_args.push(read(ptr_recv))
        param_offset = 1
    else:
        match build_receiver_arg(ctx, recv, gm.method.method_kind, gm.method.is_async):
            Option.some as recv_arg:
                unsafe:
                    ir_args.push(read(recv_arg.value))
                param_offset = 1
            Option.none:
                pass
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        var lowered = lower_expr(ctx, arg.arg_value)
        lowered = coerce_arg_to_param(cached, param_offset + i, lowered)
        lowered = coerce_monomorphized_arg_to_proc(ctx, cached, param_offset + i, lowered, arg.arg_value)
        lowered = coerce_literal_to_mono_param(ctx, cached, param_offset + i, arg.arg_value, lowered)
        unsafe:
            ir_args.push(read(lowered))
        i += 1
    return alloc_expr(ir.Expr.expr_call(callee = method_c, arguments = ir_args.as_span(), ty = ret_ty))


## Re-type a bare literal argument against the specialized function's parameter
## type — the monomorphized path's `coerce_literal_to_param_type` (the params
## live on the IR function, not an `FnSig`), so `a.m(2, 3)` against
## `ptr_uint` parameters emits `ptr_uint` literals.
function coerce_literal_to_mono_param(ctx: ref[LowerCtx], cached: ptr[ir.Function]?, param_index: ptr_uint, arg_ast: ptr[ast.Expr], arg: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let fn_ptr = cached else:
        return arg
    let spec_fn = unsafe: read(fn_ptr)
    if param_index >= spec_fn.params.len:
        return arg
    var param: ir.Param
    unsafe:
        param = read(spec_fn.params.data + param_index)
    return literal_value_to_context_type(ctx, arg_ast, param.ty, arg)


## Coerce a lowered call argument to the specialized function's parameter type:
## when the parameter is a by-value type but the argument is a pointer (e.g. `this`
## inside an editable method passed to a by-value `current` param), dereference
## the argument.  Leaves the argument unchanged when types already agree or the
## parameter info is unavailable.
function coerce_arg_to_param(cached: ptr[ir.Function]?, param_index: ptr_uint, arg: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let fn_ptr = cached else:
        return arg
    let spec_fn = unsafe: read(fn_ptr)
    if param_index >= spec_fn.params.len:
        return arg
    var param: ir.Param
    unsafe:
        param = read(spec_fn.params.data + param_index)
    let arg_ty = ir_expr_type(arg)
    # `array[T, N]` argument passed to a `span[T]` parameter: coerce to a span
    # aggregate `{ data = &arr[0], len = N }` (mirrors the array→span boundary
    # coercion the analyzer permits).
    if is_span_type(param.ty) and is_array_type(arg_ty):
        return array_value_to_span(arg, arg_ty, param.ty)
    if types.is_ref_type(param.ty):
        # The implicit ref-argument bridge (the host's
        # `implicit_ref_argument_bridge?` + `ref_of` lowering).
        return coerce_arg_to_ref_bridge(param.ty, arg)
    if ir_expr_is_pointer(arg) and not is_pointer_or_ref_type(param.ty):
        # `*arg`: dereference the pointer argument to match the value parameter.
        return alloc_expr(ir.Expr.expr_unary(operator = "*", operand = arg, ty = param.ty))
    if is_pointer_or_ref_type(param.ty) and not ir_expr_is_pointer(arg) and ir_is_addressable(arg):
        # Implicit ref bridge: a by-value argument passed to a `ref[T]`
        # parameter (editable-method struct parameters) is addressable storage,
        # so pass its address (`&arg`).
        return alloc_expr(ir.Expr.expr_address_of(expression = arg, ty = param.ty))
    return arg


## Build a `span[T]` aggregate `{ data = &arr[0], len = N }` from an addressable
## `array[T, N]` value expression.
function array_value_to_span(arr: ptr[ir.Expr], arr_ty: types.Type, span_ty: types.Type) -> ptr[ir.Expr]:
    let elem_ty = generic_first_arg(arr_ty)
    let len = array_length_of(arr_ty)
    let ptr_elem_ty = types.Type.ty_generic(name = "ptr", args = sp_type(elem_ty))
    let zero_idx = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = types.primitive("ptr_uint")))
    let elem0 = alloc_expr(ir.Expr.expr_index(receiver = arr, index = zero_idx, ty = elem_ty))
    let data_ptr = alloc_expr(ir.Expr.expr_address_of(expression = elem0, ty = ptr_elem_ty))
    var fields = vec.Vec[ir.AggregateField].create()
    fields.push(ir.AggregateField(name = "data", value = data_ptr))
    fields.push(ir.AggregateField(name = "len", value = alloc_expr(ir.Expr.expr_integer_literal(value = len, ty = types.primitive("ptr_uint")))))
    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = span_ty, fields = fields.as_span()))


## Coerce a bare function argument to a proc struct when the monomorphized
## parameter expects a proc type.  Mirrors coerce_fn_arg_to_proc but uses the
## lowered function's parameter types.
function coerce_monomorphized_arg_to_proc(ctx: ref[LowerCtx], cached: ptr[ir.Function]?, param_index: ptr_uint, lowered: ptr[ir.Expr], arg_ast: ptr[ast.Expr]) -> ptr[ir.Expr]:
    let fn_ptr = cached else:
        return lowered
    let spec_fn = unsafe: read(fn_ptr)
    if param_index >= spec_fn.params.len:
        return lowered
    var param: ir.Param
    unsafe:
        param = read(spec_fn.params.data + param_index)
    if not is_proc_type(param.ty):
        return lowered
    unsafe:
        match read(lowered):
            ir.Expr.expr_name as nm:
                if is_fn_type(nm.ty):
                    match read(arg_ast):
                        ast.Expr.expr_identifier as fn_id:
                            if ctx.function_returns.contains(fn_id.name) or ctx.analysis.functions.contains(fn_id.name):
                                # The wrapper's value type is the *parameter's*
                                # proc type (the bare name's own type is a plain
                                # `fn`, whose C form is a function pointer).
                                return lower_fn_to_proc(ctx, nm.name, param.ty, "")
                        _:
                            pass
            _:
                pass
    return lowered


## A normal call from an analyzed context means the host's analyzer validated
## the reached specialization's body (and instantiated everything inside it),
## even when lowering had already created the instance from another path (the
## `for`-iterator lookup).  Record that sticky fact for the placement pass.
function note_validated_spec_reach(ctx: ref[LowerCtx], spec_key: str) -> void:
    if ctx.next_spec_body_validated.is_some():
        return
    let info_ptr = unsafe: read(ctx.spec_infos).get(spec_key)
    if info_ptr == null:
        return
    var info = unsafe: read(info_ptr)
    let parent = ctx.current_function_linkage
    if parent.len > 0:
        info.reachers.push(parent)
    if ctx.pre_instantiated_context and not info.body_validated:
        info.body_validated = true
    unsafe: read(ctx.spec_infos).set(spec_key, info)


## Lower and cache a monomorphized method body once, in the owner module's
## context.  The context switch (module name, analysis, foreign map, variants)
## makes the body's recorded expression types and import-qualified references
## resolve against the defining module rather than the caller.
function ensure_monomorphized_method(ctx: ref[LowerCtx], method_c: str, info: GenericReceiver, gm: GenericMethodMatch, pre_instantiated: bool) -> void:
    let creator = ctx.current_function_linkage
    let setup_module = if creator.len == 0: ctx.module_name else: ""
    # Consume the one-shot creation-path override.  The iterator protocol's
    # `iter`/`next`/`current` bindings are analyzer-created but their bodies are
    # not validated (`iterator_loop_type` only looks the methods up), so their
    # nested instances are lowering-created.
    let creation_override = ctx.next_spec_body_validated
    ctx.next_spec_body_validated = Option[bool].none
    var creation_normal_call = true
    var body_validated = pre_instantiated
    match creation_override:
        Option.some as v:
            creation_normal_call = false
            body_validated = v.value
        Option.none:
            pass
    ctx.spec_in_progress.set(method_c, true)
    let owner_a = find_imported_analysis(ctx, gm.owner_module) else:
        return

    var sub = map_mod.Map[str, types.Type].create()
    var pi: ptr_uint = 0
    while pi < gm.struct_param_names.len and pi < info.concrete_args.len:
        unsafe:
            sub.set(read(gm.struct_param_names.data + pi), read(info.concrete_args.data + pi))
        pi += 1
    # Map method-level type params (e.g. `F` in `map_error[F]`) to the remaining
    # concrete args after the struct-level args.
    var mi: ptr_uint = 0
    while mi < gm.method.type_params.len and pi < info.concrete_args.len:
        unsafe:
            sub.set(read(gm.method.type_params.data + mi).name, read(info.concrete_args.data + pi))
        mi += 1
        pi += 1

    var saved_module = ctx.module_name
    var saved_analysis = ctx.analysis
    var saved_foreign = ctx.foreign_map
    var saved_variants = ctx.variants
    var saved_locals = ctx.locals
    var saved_counter = ctx.temp_counter
    var saved_returns = ctx.function_returns
    var saved_sub = ctx.type_substitution
    var saved_inside_async = ctx.inside_async
    var saved_cps_active = ctx.async_cps_active
    var saved_cps_completion = ctx.async_completion_active
    # A lazy specialization nested in the caller's expression lowering must not
    # disturb the caller's format state (its `__fmt_<dest>` naming and repeat
    # counters, and the cstr-backed local set); the maps are shared by
    # reference, so the body gets fresh ones and the caller's are restored.
    var saved_fmt_dest = ctx.fmt_dest_name
    var saved_fmt_counter = ctx.fmt_counter
    var saved_fmt_visible = ctx.fmt_counter_visible
    var saved_cstr_backed = ctx.cstr_backed_names

    ctx.module_name = gm.owner_module
    ctx.analysis = owner_a
    ctx.foreign_map = map_mod.Map[str, ForeignInfo].create()
    ctx.variants = map_mod.Map[str, VariantInfo].create()
    ctx.locals = vec.Vec[LocalBinding].create()
    ctx.temp_counter = 0
    ctx.fmt_dest_name = ""
    ctx.fmt_counter = map_mod.Map[str, ptr_uint].create()
    ctx.fmt_counter_visible = false
    ctx.cstr_backed_names = map_mod.Map[str, bool].create()
    ctx.function_returns = map_mod.Map[str, types.Type].create()
    ctx.type_substitution = sub
    ctx.inside_async = false
    # A generic method may first be specialized while an async function body is
    # being CPS-lowered (its call triggers monomorphization).  The method body is
    # an ordinary (non-CPS) function, so the caller's CPS state must not leak into
    # it — otherwise the body emits `__mt_frame->...` references and frame
    # completions that don't exist in the method.
    ctx.async_cps_active = false
    ctx.async_completion_active = false
    collect_foreign_functions(ctx, owner_a.source_file.declarations)
    collect_variants(ctx, owner_a.source_file.declarations)
    install_prelude_variants(ctx)

    let spec_fun = lower_specialized_method(ctx, method_c, info, gm, ref_of(sub), body_validated)
    ctx.specialization_cache.set(method_c, spec_fun)
    saved_returns.set(method_c, spec_fun.return_type)
    # Record owner/declaration/arguments for host-style ordering.  The sort key
    # is the host's rendered `type_arguments.map(&:to_s).join(",")`.
    var m_args_key = string.String.create()
    var mai: ptr_uint = 0
    while mai < info.concrete_args.len:
        if mai > 0:
            m_args_key.append(",")
        unsafe:
            m_args_key.append(spec_arg_type_to_s(read(info.concrete_args.data + mai)))
        mai += 1
    var m_decl_key = string.String.create()
    m_decl_key.append("method:")
    m_decl_key.append(info.owner_name)
    m_decl_key.append(".")
    m_decl_key.append(gm.method.name)
    # The first creator wins: the host instantiates a binding once, so the
    # earliest module to reach the call site owns its creation wave.
    # Pre-instantiation is sticky, though: if *any* analyzed source path
    # reaches this instance, the host's analyzer created it before lowering
    # and it belongs to the setup pass.
    let existing_ptr = unsafe: read(ctx.spec_infos).get(method_c)
    if existing_ptr == null:
        unsafe:
            read(ctx.spec_infos).set(method_c, SpecInfo(
                # The host groups a method's instances under its declaration in
                # the module that *declares* the extending block, so the ordering
                # key must carry that module — `info.owner_module` is the receiver
                # type's module, which a cross-module call site may have registered
                # as its own (`Vec.create[String]` written in std.string).
                owner_module = gm.owner_module,
                body_validated = body_validated,
                creation_normal_call = creation_normal_call,
                reachers = if creation_normal_call: make_spec_reachers(creator) else: vec.Vec[str].create(),
                decl_key = m_decl_key.as_str(),
                args_key = m_args_key.as_str(),
                creator = creator,
                pre_instantiated = pre_instantiated,
                setup_module = setup_module,
            ))
    else:
        var existing = unsafe: read(existing_ptr)
        if pre_instantiated and not existing.pre_instantiated:
            existing.pre_instantiated = true
            unsafe: read(ctx.spec_infos).set(method_c, existing)
        if body_validated and not existing.body_validated:
            existing.body_validated = true
            unsafe: read(ctx.spec_infos).set(method_c, existing)

    ctx.module_name = saved_module
    ctx.analysis = saved_analysis
    ctx.foreign_map = saved_foreign
    ctx.variants = saved_variants
    ctx.locals = saved_locals
    ctx.temp_counter = saved_counter
    ctx.function_returns = saved_returns
    ctx.type_substitution = saved_sub
    ctx.inside_async = saved_inside_async
    ctx.async_cps_active = saved_cps_active
    ctx.async_completion_active = saved_cps_completion
    ctx.fmt_dest_name = saved_fmt_dest
    ctx.fmt_counter = saved_fmt_counter
    ctx.fmt_counter_visible = saved_fmt_visible
    ctx.cstr_backed_names = saved_cstr_backed


## Find the module that defines a struct named `name` by searching loaded analyses.
## Returns the struct's defining module name, or the default module name if not found.
function struct_defining_module_for_type(ctx: ref[LowerCtx], name: str) -> str:
    var sai: ptr_uint = 0
    while sai < ctx.program_analyses.len:
        var sa: analyzer.Analysis
        unsafe:
            sa = read(ctx.program_analyses.data + sai)
        if struct_in_source(sa, name) or sa.structs.contains(name):
            return sa.module_name
        sai += 1
    return ctx.module_name


## Lower a single generic method to an IR function with the struct's type
## parameters substituted.  Mirrors `lower_method`, but resolves the receiver and
## parameter/return types through `substitute_type_params` with `sub`.
function lower_specialized_method(ctx: ref[LowerCtx], method_c: str, info: GenericReceiver, gm: GenericMethodMatch, sub: ref[map_mod.Map[str, types.Type]], body_validated: bool) -> ir.Function:
    let m = gm.method
    ctx.locals.clear()
    ctx.temp_counter = 0
    ctx.fmt_dest_name = ""
    ctx.fmt_counter.clear()
    ctx.fmt_counter_visible = false
    ctx.cstr_backed_names.clear()
    var saved_current_fn = ctx.current_function_linkage
    ctx.current_function_linkage = method_c
    # Nested instances are analyzer-created only when the body was validated
    # (see `lower_specialized_function`).
    var saved_pre_instantiated = ctx.pre_instantiated_context
    ctx.pre_instantiated_context = body_validated

    # Build the receiver struct type using only the struct-level type args
    # (the first N concrete args where N = struct_param_names.len).  Method-level
    # type params extend concrete_args but are NOT part of the receiver.
    var struct_args = vec.Vec[types.Type].create()
    var si: ptr_uint = 0
    while si < gm.struct_param_names.len and si < info.concrete_args.len:
        unsafe:
            struct_args.push(read(info.concrete_args.data + si))
        si += 1

    # Builtin generics (ptr/span/array/...) are never module-qualified types:
    # keep the receiver as a plain generic instance so `ptr[int]` renders as
    # `int32_t*` rather than a nonexistent `std_mem_ptr_ptr_int` struct.
    var recv_struct_ty: types.Type
    if is_builtin_pointer_generic(info.owner_name):
        recv_struct_ty = types.Type.ty_generic(name = info.owner_name, args = struct_args.as_span())
    else:
        recv_struct_ty = qualify_type(ctx, types.Type.ty_imported(
            module_name = if info.owner_module.len > 0: info.owner_module else: struct_defining_module_for_type(ctx, info.owner_name),
            name = info.owner_name,
            args = struct_args.as_span(),
        ))

    var ir_params = vec.Vec[ir.Param].create()
    var param_setup = vec.Vec[ir.Stmt].create()
    if m.method_kind != ast.MethodKind.mk_static:
        let recv_is_ptr = receiver_by_pointer(ctx, recv_struct_ty, m.method_kind, m.is_async)
        ir_params.push(ir.Param(name = "this", linkage_name = utils.c_local_name("this"), ty = recv_struct_ty, pointer = Option[bool].some(value = recv_is_ptr)))
        ctx.locals.push(LocalBinding(name = "this", c_name = utils.c_local_name("this"), ty = recv_struct_ty, pointer = Option[bool].some(value = recv_is_ptr)))

    var pi: ptr_uint = 0
    while pi < m.method_params.len:
        var p: ast.Param
        unsafe:
            p = read(m.method_params.data + pi)
        let p_ty = qualify_type(ctx, substitute_type_params(ctx, resolve_field_type_ref(ctx, p.param_type), sub))
        let c_pname = utils.c_local_name(p.name)
        let is_ptr = false
        let link_name = array_param_input_name(p_ty, c_pname, ref_of(param_setup))
        ir_params.push(ir.Param(name = p.name, linkage_name = link_name, ty = p_ty, pointer = Option[bool].some(value = is_ptr)))
        ctx.locals.push(LocalBinding(name = p.name, c_name = c_pname, ty = p_ty, pointer = Option[bool].some(value = is_ptr)))
        pi += 1

    var ret_ty = ctx.void_ty
    let return_ref = m.return_type
    if return_ref != null:
        let resolved_ret = resolve_field_type_ref(ctx, unsafe: read(return_ref))
        ret_ty = qualify_type(ctx, substitute_type_params(ctx, resolved_ret, sub))

    # Register the method's return type before lowering its body so a
    # recursive self-call resolves its type from here rather than the
    # analyzer's unsubstituted generic-body record.
    ctx.function_returns.set(method_c, ret_ty)
    var saved_sub = ctx.type_substitution
    ctx.type_substitution = read(sub)
    var saved_fn_ret = ctx.current_fn_return_type
    ctx.current_fn_return_type = ret_ty
    let body_ir = prepend_param_setup(ref_of(param_setup), lower_function_body(ctx, m.body))
    ctx.current_fn_return_type = saved_fn_ret
    ctx.type_substitution = saved_sub
    ctx.current_function_linkage = saved_current_fn
    ctx.pre_instantiated_context = saved_pre_instantiated

    return ir.Function(
        # Host parity: the instance's `name` is the method name; the linkage
        # name carries the receiver and type-argument suffix.
        name = m.name,
        linkage_name = method_c,
        params = ir_params.as_span(),
        return_type = ret_ty,
        body = body_ir,
        entry_point = false, public_export = false,
        method_receiver_param = m.method_kind != ast.MethodKind.mk_static,
    )


## Wrap a function reference in a proc struct with a synthetic invoke function
## that calls the original function, plus no-op release/retain.
function lower_fn_to_proc(ctx: ref[LowerCtx], fn_c_name: str, fn_ty: types.Type, source_path: str) -> ptr[ir.Expr]:
    proc_counter += 1
    var prefix = string.String.create()
    prefix.append(naming.module_c_prefix(ctx.module_name))
    prefix.append("__proc_")
    fmt.append_ptr_uint(ref_of(prefix), proc_counter)

    var invoke_c = string.String.create()
    invoke_c.append(prefix.as_str())
    invoke_c.append("__invoke")
    var release_c = string.String.create()
    release_c.append(prefix.as_str())
    release_c.append("__release")
    var retain_c = string.String.create()
    retain_c.append(prefix.as_str())
    retain_c.append("__retain")

    let invoke_str = invoke_c.as_str()
    let release_str = release_c.as_str()
    let retain_str = retain_c.as_str()

    match fn_ty:
        types.Type.ty_function as fnt:
            let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
            var inv_params = vec.Vec[ir.Param].create()
            inv_params.push(ir.Param(name = "env", linkage_name = "__mt_proc_env", ty = void_ptr, pointer = Option[bool].some(value = false)))
            var call_args = vec.Vec[ir.Expr].create()
            var pi: ptr_uint = 0
            while pi < fnt.params.len:
                var p_ty: types.Type
                unsafe:
                    p_ty = read(fnt.params.data + pi)
                # The host's wrapper invoke takes the proc type's own parameter
                # names (the proc annotation's names), not synthetic ones.
                var pname = jstr_i("arg_", pi)
                if pi < fnt.param_names.len:
                    let annotated = unsafe: read(fnt.param_names.data + pi)
                    if annotated.len > 0:
                        pname = annotated
                inv_params.push(ir.Param(name = pname, linkage_name = pname, ty = p_ty, pointer = Option[bool].some(value = false)))
                let arg_expr = alloc_expr(ir.Expr.expr_name(name = pname, ty = p_ty, pointer = Option[bool].some(value = false)))
                unsafe:
                    call_args.push(read(arg_expr))
                pi += 1
            var ret_ty = ctx.void_ty
            unsafe:
                ret_ty = read(fnt.return_type)
            var inv_body = vec.Vec[ir.Stmt].create()
            if is_void_type(ret_ty):
                let call = alloc_expr(ir.Expr.expr_call(callee = fn_c_name, arguments = call_args.as_span(), ty = ret_ty))
                inv_body.push(ir.Stmt.stmt_expression(expression = call, line = 0, source_path = source_path))
                inv_body.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = source_path))
            else:
                let call = alloc_expr(ir.Expr.expr_call(callee = fn_c_name, arguments = call_args.as_span(), ty = ret_ty))
                inv_body.push(ir.Stmt.stmt_return(value = call, line = 0, source_path = source_path))

            ctx.pending_synthetic_functions.push(ir.Function(name = invoke_str, linkage_name = invoke_str, params = inv_params.as_span(), return_type = ret_ty, body = inv_body.as_span(), entry_point = false, public_export = false, method_receiver_param = false))
            ctx.pending_synthetic_functions.push(build_proc_noop_fn(release_str))
            ctx.pending_synthetic_functions.push(build_proc_noop_fn(retain_str))

            # Ensure the proc struct type exists for this signature.
            let proc_name = naming.proc_type_c_name(fn_ty)
            let proc_ty = proc_ensure_struct_decl(ctx, proc_name, fn_ty)

            let lifecycle_ty = proc_lifecycle_fn_type()
            var fields = vec.Vec[ir.AggregateField].create()
            fields.push(ir.AggregateField(name = "env", value = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr))))
            fields.push(ir.AggregateField(name = "invoke", value = alloc_expr(ir.Expr.expr_name(name = invoke_str, ty = proc_invoke_field_type(fn_ty), pointer = Option[bool].some(value = false)))))
            fields.push(ir.AggregateField(name = "release", value = alloc_expr(ir.Expr.expr_name(name = release_str, ty = lifecycle_ty, pointer = Option[bool].some(value = false)))))
            fields.push(ir.AggregateField(name = "retain", value = alloc_expr(ir.Expr.expr_name(name = retain_str, ty = lifecycle_ty, pointer = Option[bool].some(value = false)))))
            return alloc_expr(ir.Expr.expr_aggregate_literal(ty = proc_ty, fields = fields.as_span()))
        _:
            fatal(c"lowering: fn_to_proc requires function type")


## String concatenation helpers.
function j2(a: str, b: str) -> str:
    return utils.j2(a, b)


function j3(a: str, b: str, c: str) -> str:
    return utils.j3(a, b, c)


function j4(a: str, b: str, c: str, d: str) -> str:
    return utils.j4(a, b, c, d)


function j5(a: str, b: str, c: str, d: str, e: str) -> str:
    return utils.j5(a, b, c, d, e)


function j6(a: str, b: str, c: str, d: str, e: str, f: str) -> str:
    return utils.j6(a, b, c, d, e, f)


## Build a "arg_N" string from an integer index.
function jstr_i(prefix: str, n: ptr_uint) -> str:
    var buf = string.String.create()
    buf.append(prefix)
    fmt.append_ptr_uint(ref_of(buf), n)
    return buf.as_str()

## True when a type is void.
function is_void_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_primitive as p:
            return p.name == "void"
        _:
            return false


## True when a type is a str_buffer[N] type.
function is_str_buffer_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_generic as g:
            return g.name == "str_buffer"
        _:
            return false


## True when a type is an atomic[T] type.
function is_atomic_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_generic as g:
            return g.name == "atomic"
        _:
            return false


## The element type T of an atomic[T] type, or ty_error for a malformed one.
function atomic_element_type(t: types.Type) -> types.Type:
    match t:
        types.Type.ty_generic as g:
            if g.args.len >= 1:
                return unsafe: read(g.args.data + 0)
            return types.Type.ty_error
        _:
            return types.Type.ty_error


## Lower an atomic[T] method call to a GCC/Clang __atomic_* builtin with the
## sequential-consistency memory order (5).  `load` reads through the address,
## `store` writes, and `add`/`sub`/`exchange` are read-modify-write.  Mirrors
## Ruby's lower_atomic_method_call.
function lower_atomic_method(ctx: ref[LowerCtx], recv: ptr[ir.Expr], recv_ty: types.Type, method_name: str, args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    let elem_ty = atomic_element_type(recv_ty)
    let void_ty = ctx.void_ty
    let int_ty = types.primitive("int")
    let ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(elem_ty))
    let addr = alloc_expr(ir.Expr.expr_address_of(expression = recv, ty = ptr_ty))
    let seq_cst = alloc_expr(ir.Expr.expr_integer_literal(value = 5l, ty = int_ty))
    if method_name == "load":
        return alloc_expr(ir.Expr.expr_call(callee = "__atomic_load_n", arguments = sp_expr2(addr, seq_cst), ty = elem_ty))
    let arg_ir = lower_expr(ctx, unsafe: read(args.data + 0).arg_value)
    if method_name == "store":
        return alloc_expr(ir.Expr.expr_call(callee = "__atomic_store_n", arguments = sp_expr3(addr, arg_ir, seq_cst), ty = void_ty))
    if method_name == "add":
        return alloc_expr(ir.Expr.expr_call(callee = "__atomic_fetch_add", arguments = sp_expr3(addr, arg_ir, seq_cst), ty = elem_ty))
    if method_name == "sub":
        return alloc_expr(ir.Expr.expr_call(callee = "__atomic_fetch_sub", arguments = sp_expr3(addr, arg_ir, seq_cst), ty = elem_ty))
    if method_name == "exchange":
        return alloc_expr(ir.Expr.expr_call(callee = "__atomic_exchange_n", arguments = sp_expr3(addr, arg_ir, seq_cst), ty = elem_ty))
    fatal(c"atomic lowering: unknown method")


# =============================================================================
#  Event runtime — delegates to C runtime helpers for slot management.
# =============================================================================

## True when `t` is the type of a declared event.
function is_event_type(ctx: ref[LowerCtx], t: types.Type) -> bool:
    match t:
        types.Type.ty_event:
            # A struct event field's member read is typed as the event itself.
            return true
        types.Type.ty_named as n:
            if ctx.analysis.events.contains(n.name):
                return true
            if n.name.starts_with("mt_event_"):
                let stripped = strip_event_cap_suffix(n.name)
                if ctx.analysis.events.contains(stripped):
                    return true
                return is_any_event_suffix(ctx, n.name)
            return is_any_event_suffix(ctx, n.name)
        types.Type.ty_imported as im:
            if ctx.analysis.events.contains(im.name):
                return true
            return is_any_event_suffix(ctx, im.name)
        _:
            return false


## Extract the event name from an event type (ty_named).
function event_name_from_type(t: types.Type) -> str:
    match t:
        types.Type.ty_event as e:
            return e.name
        types.Type.ty_named as n:
            if n.name.starts_with("mt_event_"):
                return event_name_from_c_linkage(n.name)
            return n.name
        types.Type.ty_imported as im:
            if im.name.starts_with("mt_event_"):
                return event_name_from_c_linkage(im.name)
            return im.name
        types.Type.ty_generic as g:
            return g.name
        _:
            fatal(c"event type is not ty_named")


## Remove the trailing _<digits> capacity suffix from an event struct C name.
function strip_event_cap_suffix(name: str) -> str:
    var pos = name.len
    while pos > 0:
        pos -= 1
        let b = name.byte_at(pos)
        if b >= ubyte<-('0') and b <= ubyte<-('9'):
            continue
        if b == ubyte<-('_') and pos + 1 < name.len:
            return name.slice(0, pos)
        break
    return name


function is_any_event_suffix(ctx: ref[LowerCtx], name: str) -> bool:
    let base = strip_event_cap_suffix(name)
    var iter = ctx.analysis.events.entries()
    while true:
        if not iter.next():
            break
        unsafe:
            let info = read(iter.current().value)
            # A struct event's linkage carries its sanitized owner segment
            # (`Window_closed`, `Container_Inner_updated`), so match that stem
            # rather than the registry key's dotted form.
            var stem = info.name
            if info.owner_type_name.len > 0:
                stem = j3(info.owner_type_name, "_", info.name)
            if base.ends_with(stem):
                return true
    return false


## The event declared by `owner` (a sanitized owner path) under `name`, the
## host's struct-scoped `Types::Struct#event` lookup.  A struct's own map is the
## only one consulted — a module-level event of the same name must not claim a
## plain field.
function event_info_for_owner(ctx: ref[LowerCtx], owner: str, name: str) -> Option[analyzer.EventInfo]:
    let key = analyzer.event_registry_key(owner, name)
    let keyed = ctx.analysis.events.get(key)
    if keyed != null:
        return Option[analyzer.EventInfo].some(value = unsafe: read(keyed))
    return Option[analyzer.EventInfo].none


## The sanitized owner path of an expression's receiver type — the host's
## `event_member_from_owner_type` unwrap ladder: `Window` for a top-level
## struct, `Container_Inner` for a nested one (its type links as
## `<module>_Container_Inner`), and the unwrapped element for `ptr`/`const_ptr`/
## `ref`/`own`/nullable wrappers.
function event_owner_for_receiver(ctx: ref[LowerCtx], t: types.Type) -> str:
    var base = t
    while true:
        match base:
            types.Type.ty_nullable as nl:
                base = unsafe: read(nl.base)
            types.Type.ty_generic as g:
                if (g.name == "ptr" or g.name == "const_ptr" or g.name == "ref" or g.name == "own") and g.args.len == 1:
                    base = unsafe: read(g.args.data + 0)
                else:
                    return ""
            _:
                break
    match base:
        types.Type.ty_named as n:
            match n.linkage_name:
                Option.some as lk:
                    let prefix = j2(naming.sanitize_event_part(ctx.module_name), "_")
                    let linkage = lk.value
                    if linkage.len > prefix.len and linkage.starts_with(prefix):
                        return linkage.slice(prefix.len, linkage.len - prefix.len)
                    return n.name
                Option.none:
                    return n.name
        types.Type.ty_imported as im:
            return im.name
        _:
            return ""


## The event a member access names on a receiver of type `recv_ty`, if any.
function event_info_for_receiver(ctx: ref[LowerCtx], recv_ty: types.Type, member: str) -> Option[analyzer.EventInfo]:
    return event_info_for_owner(ctx, event_owner_for_receiver(ctx, recv_ty), member)


## The runtime of an event-typed receiver (`window.closed.emit()`): a
## `ty_event` carries the runtime linkage the member access already resolved, so
## look the runtime up by it; a bare module-level event name resolves directly.
function event_runtime_for_type(ctx: ref[LowerCtx], t: types.Type) -> EventRuntimeInfo:
    match t:
        types.Type.ty_event as e:
            var iter = ctx.event_runtimes.entries()
            while true:
                if not iter.next():
                    break
                unsafe:
                    let info = read(iter.current().value)
                    if info.event_c_name == e.linkage_name:
                        return info
        _:
            pass
    let ev_name = event_name_from_type(t)
    return ensure_event_runtime(ctx, "", ev_name)


function event_name_from_c_linkage(name: str) -> str:
    var rest = name.slice(8, name.len - 8)
    let base = strip_event_cap_suffix(rest)
    return base


## Create the EventError enum (backing: int) — the host's
## `ensure_event_error_enum` pushes the builtin enum into
## `@artifacts.synthetic_enums` once.  Returns the named type.
function ensure_event_error_enum(ctx: ref[LowerCtx]) -> types.Type:
    if not ctx.event_error_emitted:
        let int_ty = types.primitive("int")
        var members = vec.Vec[ir.EnumMember].create()
        members.push(ir.EnumMember(
            name = "full",
            linkage_name = "EventError_full",
            value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = int_ty)),
        ))
        ctx.pending_synthetic_enums.push(ir.EnumDecl(
            name = "EventError",
            linkage_name = "EventError",
            backing_type = int_ty,
            members = members.as_span(),
            is_flags = false,
        ))
        ctx.event_error_emitted = true
    return types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = "EventError")


## Ensure event runtime structs are declared (slot type, event type, subscript type).
## Called lazily on first event method call.
function ensure_event_runtime(ctx: ref[LowerCtx], owner: str, event_name: str) -> EventRuntimeInfo:
    let runtime_key = analyzer.event_registry_key(owner, event_name)
    let existing_ptr = ctx.event_runtimes.get(runtime_key)
    if existing_ptr != null:
        return unsafe: read(existing_ptr)
    var ev_ptr = ctx.analysis.events.get(runtime_key)
    if ev_ptr == null and owner.len > 0:
        ev_ptr = ctx.analysis.events.get(event_name)
    let found_ev = ev_ptr else:
        fatal(c"ensure_event_runtime: event not found")
    var ev = unsafe: read(found_ev)
    let ptr_uint_ty = types.primitive("ptr_uint")
    let bool_ty = ctx.bool_ty
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
    var has_payload = false
    var payload_ty = ctx.void_ty
    if ev.payload_type != null:
        has_payload = true
        let pt = ev.payload_type else:
            fatal(c"ensure_event_runtime: payload type is null")
        payload_ty = resolve_type_ref(ctx, pt)
    var payload_name: Option[str] = Option[str].none
    if has_payload:
        payload_name = Option[str].some(value = naming.type_to_s_qualified(payload_ty))
    let linkage = naming.event_linkage_name(ctx.module_name, ev.owner_type_name, event_name, payload_name, long<-(ev.capacity))
    let slot_cn = j2(linkage, "__slot")
    let snapshot_cn = j2(linkage, "__snapshot")
    let event_cn = linkage
    # Subscription struct: { slot, generation } — the shared handle.  The host's
    # `ensure_subscription_runtime` runs before the first per-event struct, and
    # its IR name is the builtin type's `Subscription` (linkage
    # `mt_subscription`).
    if not ctx.subscription_emitted:
        ctx.pending_synthetic_structs.push(ir.StructDecl(
            name = "Subscription", linkage_name = "mt_subscription",
            fields = sp_field2(
                ir.Field(name = "slot", ty = ptr_uint_ty),
                ir.Field(name = "generation", ty = ptr_uint_ty),
            ),
            packed = false, alignment = 0, source_module = Option[str].none,
        ))
        ctx.subscription_emitted = true
    # Slot struct: { active, once, generation, state, listener, wait_frame }
    ctx.pending_synthetic_structs.push(ir.StructDecl(
        name = slot_cn, linkage_name = slot_cn,
        fields = sp_field6(
            ir.Field(name = "active", ty = bool_ty),
            ir.Field(name = "once", ty = bool_ty),
            ir.Field(name = "generation", ty = ptr_uint_ty),
            ir.Field(name = "state", ty = void_ptr_ty),
            ir.Field(name = "listener", ty = void_ptr_ty),
            ir.Field(name = "wait_frame", ty = void_ptr_ty),
        ),
        packed = false, alignment = 0, source_module = Option[str].none,
    ))
    # Snapshot struct: { slot, generation, once, wait_slot, stateful, state, listener }
    ctx.pending_synthetic_structs.push(ir.StructDecl(
        name = snapshot_cn, linkage_name = snapshot_cn,
        fields = sp_field7(
            ir.Field(name = "slot", ty = ptr_uint_ty),
            ir.Field(name = "generation", ty = ptr_uint_ty),
            ir.Field(name = "once", ty = bool_ty),
            ir.Field(name = "wait_slot", ty = bool_ty),
            ir.Field(name = "stateful", ty = bool_ty),
            ir.Field(name = "state", ty = void_ptr_ty),
            ir.Field(name = "listener", ty = void_ptr_ty),
        ),
        packed = false, alignment = 0, source_module = Option[str].none,
    ))
    let event_error_ty = ensure_event_error_enum(ctx)
    var wait_result_args = vec.Vec[types.Type].create()
    if has_payload:
        wait_result_args.push(payload_ty)
    else:
        wait_result_args.push(ctx.void_ty)
    wait_result_args.push(event_error_ty)
    let wait_result_ty = ensure_generic_variant(ctx, "Result", wait_result_args.as_span())
    let wake_fn_ty = types.Type.ty_function(name = "", params = single_ty_span(void_ptr_ty), return_type = types.alloc_type(ctx.void_ty), variadic = false, is_proc = false, param_names = sp_str("frame"))
    let wait_frame_cn = j2(linkage, "__wait_frame")
    ctx.pending_synthetic_structs.push(ir.StructDecl(
        name = wait_frame_cn, linkage_name = wait_frame_cn,
        fields = sp_field6(
            ir.Field(name = "ready", ty = bool_ty),
            ir.Field(name = "waiter_frame", ty = void_ptr_ty),
            ir.Field(name = "waiter", ty = wake_fn_ty),
            ir.Field(name = "event", ty = void_ptr_ty),
            ir.Field(name = "subscription", ty = types.Type.ty_named(linkage_name = Option[str].some(value = "mt_subscription"), module_name = "", name = "Subscription")),
            ir.Field(name = "result", ty = wait_result_ty),
        ),
        packed = false, alignment = 0, source_module = Option[str].none,
    ))
    # Event struct: { slots: array[Slot, capacity] }.  Its IR name is the bare
    # event name (the host's `Types::Event#name`) while the linkage carries the
    # module/owner/name/payload/capacity identity.
    let capacity_val: long = long<-(ev.capacity)
    let slot_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = slot_cn)
    let slot_arr_ty = types.Type.ty_generic(name = "array", args = sp_type2(slot_ty, types.literal_int(capacity_val)))
    ctx.pending_synthetic_structs.push(ir.StructDecl(
        name = event_name, linkage_name = event_cn,
        fields = sp_field1(ir.Field(name = "slots", ty = slot_arr_ty)),
        packed = false, alignment = 0, source_module = Option[str].none,
    ))
    var info = EventRuntimeInfo(
        name = event_name, linkage_name = linkage, capacity = ptr_uint<-(ev.capacity),
        has_payload = has_payload, payload_type = payload_ty,
        owner = ev.owner_type_name,
        slot_c_name = slot_cn, event_c_name = event_cn,
        subscribe_c_name = j2(linkage, "__subscribe"),
        subscribe_once_c_name = j2(linkage, "__subscribe_once"),
        subscribe_stateful_c_name = j2(linkage, "__subscribe_stateful"),
        subscribe_once_stateful_c_name = j2(linkage, "__subscribe_once_stateful"),
        unsubscribe_c_name = j2(linkage, "__unsubscribe"),
        emit_c_name = j2(linkage, "__emit"),
        wait_c_name = j2(linkage, "__wait"),
        wait_frame_c_name = wait_frame_cn,
        wait_ready_c_name = j2(linkage, "__wait__ready"),
        wait_set_waiter_c_name = j2(linkage, "__wait__set_waiter"),
        wait_release_c_name = j2(linkage, "__wait__release"),
        wait_take_result_c_name = j2(linkage, "__wait__take_result"),
        wait_result_ty = wait_result_ty,
    )
    ctx.event_runtimes.set(runtime_key, info)
    ctx.pending_synthetic_functions.push(build_event_subscribe_fn(ctx, ref_of(info), slot_cn, event_cn, false))
    ctx.pending_synthetic_functions.push(build_event_subscribe_fn(ctx, ref_of(info), slot_cn, event_cn, true))
    ctx.pending_synthetic_functions.push(build_event_subscribe_stateful_fn(ctx, ref_of(info), slot_cn, event_cn, false))
    ctx.pending_synthetic_functions.push(build_event_subscribe_stateful_fn(ctx, ref_of(info), slot_cn, event_cn, true))
    ctx.pending_synthetic_functions.push(build_event_unsubscribe_fn(ref_of(info), slot_cn, event_cn))
    ctx.pending_synthetic_functions.push(build_event_emit_fn(ref_of(info), slot_cn, event_cn))
    ctx.pending_synthetic_functions.push(build_event_wait_ready_fn(ref_of(info), slot_cn, event_cn))
    ctx.pending_synthetic_functions.push(build_event_wait_set_waiter_fn(ref_of(info), slot_cn, event_cn))
    ctx.pending_synthetic_functions.push(build_event_wait_release_fn(ref_of(info), slot_cn, event_cn))
    ctx.pending_synthetic_functions.push(build_event_wait_take_result_fn(ctx, ref_of(info), slot_cn, event_cn))
    ctx.pending_synthetic_functions.push(build_event_wait_fn(ctx, ref_of(info), slot_cn, event_cn))
    return info


## Generates calls to per-event typed functions (mt_event_NAME__emit etc.).
function lower_event_method(ctx: ref[LowerCtx], recv: ptr[ir.Expr], recv_ty: types.Type, method_name: str, args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    var info = event_runtime_for_type(ctx, recv_ty)
    let void_ty = ctx.void_ty
    let bool_ty = ctx.bool_ty
    # The receiver pointer's element type is the event itself (`ptr[Types::Event]`
    # in the host's `lower_event_storage_pointer`), which the C backend renders
    # through the event's linkage name.
    var recv_event_ty = recv_ty
    match recv_event_ty:
        types.Type.ty_event:
            pass
        _:
            var ev_payload: ptr[types.Type]? = null
            if info.has_payload:
                ev_payload = types.alloc_type(info.payload_type)
            recv_event_ty = types.Type.ty_event(
                name = info.name,
                capacity = info.capacity,
                payload_type = ev_payload,
                linkage_name = info.event_c_name,
            )
    let event_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(recv_event_ty))
    let recv_addr = alloc_expr(ir.Expr.expr_address_of(expression = recv, ty = event_ptr_ty))
    if method_name == "emit":
        var call_args = vec.Vec[ir.Expr].create()
        unsafe:
            call_args.push(read(recv_addr))
        if info.has_payload:
            let payload_val = lower_expr(ctx, unsafe: read(args.data + 0).arg_value)
            unsafe:
                call_args.push(read(payload_val))
        return alloc_expr(ir.Expr.expr_call(callee = info.emit_c_name, arguments = call_args.as_span(), ty = void_ty))
    if method_name == "subscribe" or method_name == "subscribe_once":
        let is_stateful = args.len >= 2
        var callee: str
        if is_stateful:
            callee = if method_name == "subscribe": info.subscribe_stateful_c_name else: info.subscribe_once_stateful_c_name
        else:
            callee = if method_name == "subscribe": info.subscribe_c_name else: info.subscribe_once_c_name
        var call_args = vec.Vec[ir.Expr].create()
        unsafe:
            call_args.push(read(recv_addr))
        if is_stateful:
            let state_val = lower_expr(ctx, unsafe: read(args.data + 0).arg_value)
            unsafe:
                call_args.push(read(state_val))
            let listener_val = lower_expr(ctx, unsafe: read(args.data + 1).arg_value)
            unsafe:
                call_args.push(read(listener_val))
        else:
            # The plain listener is the typed `fn <event>__listener(...) -> void`;
            # the host's contextual lowering passes the function value directly
            # (only the stateful form, whose slot stores a `void*`, casts).
            let listener_val = lower_expr(ctx, unsafe: read(args.data + 0).arg_value)
            unsafe:
                call_args.push(read(listener_val))
        let sub_plain_ty = types.Type.ty_named(linkage_name = Option[str].some(value = "mt_subscription"), module_name = "", name = "Subscription")
        let event_error_ty = ensure_event_error_enum(ctx)
        var result_args = vec.Vec[types.Type].create()
        result_args.push(sub_plain_ty)
        result_args.push(event_error_ty)
        let sub_ty = ensure_generic_variant(ctx, "Result", result_args.as_span())
        return alloc_expr(ir.Expr.expr_call(callee = callee, arguments = call_args.as_span(), ty = sub_ty))
    if method_name == "unsubscribe":
        var call_args = vec.Vec[ir.Expr].create()
        unsafe:
            call_args.push(read(recv_addr))
        let sub_val = lower_expr(ctx, unsafe: read(args.data + 0).arg_value)
        unsafe:
            call_args.push(read(sub_val))
        return alloc_expr(ir.Expr.expr_call(callee = info.unsubscribe_c_name, arguments = call_args.as_span(), ty = bool_ty))
    if method_name == "wait":
        var call_args = vec.Vec[ir.Expr].create()
        unsafe:
            call_args.push(read(recv_addr))
        let event_error_ty = ensure_event_error_enum(ctx)
        var wait_result_args = vec.Vec[types.Type].create()
        if info.has_payload:
            wait_result_args.push(info.payload_type)
        else:
            wait_result_args.push(ctx.void_ty)
        wait_result_args.push(event_error_ty)
        let wait_result_ty = ensure_generic_variant(ctx, "Result", wait_result_args.as_span())
        let task_ty = make_task_type(wait_result_ty)
        return alloc_expr(ir.Expr.expr_call(callee = info.wait_c_name, arguments = call_args.as_span(), ty = task_ty))
    fatal(c"lowering: unknown event method")


## The host's `event_slot_pointer_expression`: `&event->slots[index]`.
function event_slot_pointer_expression(info: ref[EventRuntimeInfo], event_expr: ptr[ir.Expr], slot_index_expr: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let slot_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.slot_c_name)
    let slots_ty = types.Type.ty_generic(name = "array", args = sp_type2(slot_ty, types.literal_int(long<-(info.capacity))))
    let slots_member = alloc_expr(ir.Expr.expr_member(receiver = event_expr, member = "slots", ty = slots_ty))
    let slot_index = alloc_expr(ir.Expr.expr_index(receiver = slots_member, index = slot_index_expr, ty = slot_ty))
    return alloc_expr(ir.Expr.expr_address_of(expression = slot_index, ty = types.Type.ty_generic(name = "ptr", args = sp_type(slot_ty))))


## The host's `event_slot_local_decl`: `__mt_slot = &event->slots[index]`.
function event_slot_local_decl(info: ref[EventRuntimeInfo], event_expr: ptr[ir.Expr], slot_index_expr: ptr[ir.Expr], local_name: str) -> ir.Stmt:
    let slot_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.slot_c_name)
    return ir.Stmt.stmt_local(
        name = local_name,
        linkage_name = local_name,
        ty = types.Type.ty_generic(name = "ptr", args = sp_type(slot_ty)),
        value = event_slot_pointer_expression(info, event_expr, slot_index_expr),
        line = 0,
        source_path = "",
    )


function event_slot_field_expression(slot_pointer_expr: ptr[ir.Expr], field_name: str, field_ty: types.Type) -> ptr[ir.Expr]:
    return alloc_expr(ir.Expr.expr_member(receiver = slot_pointer_expr, member = field_name, ty = field_ty))


function event_slot_active_expression(slot_pointer_expr: ptr[ir.Expr]) -> ptr[ir.Expr]:
    return event_slot_field_expression(slot_pointer_expr, "active", types.primitive("bool"))


function event_slot_wait_frame_expression(slot_pointer_expr: ptr[ir.Expr]) -> ptr[ir.Expr]:
    return event_slot_field_expression(slot_pointer_expr, "wait_frame", types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void"))))


function active_event_slot_continue_guard(slot_pointer_expr: ptr[ir.Expr]) -> ir.Stmt:
    return ir.Stmt.stmt_if(
        condition = event_slot_active_expression(slot_pointer_expr),
        then_body = span_from_one(ir.Stmt.stmt_continue),
        else_body = Option[span[ir.Stmt]].none,
    )


function inactive_event_slot_continue_guard(slot_pointer_expr: ptr[ir.Expr]) -> ir.Stmt:
    let not_active = alloc_expr(ir.Expr.expr_unary(operator = "not", operand = event_slot_active_expression(slot_pointer_expr), ty = types.primitive("bool")))
    return ir.Stmt.stmt_if(
        condition = not_active,
        then_body = span_from_one(ir.Stmt.stmt_continue),
        else_body = Option[span[ir.Stmt]].none,
    )


function event_next_generation_expression(slot_pointer_expr: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let generation = event_slot_field_expression(slot_pointer_expr, "generation", types.primitive("ptr_uint"))
    return alloc_expr(ir.Expr.expr_binary(operator = "+", left = generation, right = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = types.primitive("ptr_uint"))), ty = types.primitive("ptr_uint")))


function event_slot_assign(target: ptr[ir.Expr], value: ptr[ir.Expr]) -> ir.Stmt:
    return ir.Stmt.stmt_assignment(target = target, operator = "=", value = value)


## The host's `event_slot_activate_statements`: the shared slot-activation
## prefix.  `listener_expr` is nil for `wait` (which never stores a listener).
function event_slot_activate_statements(info: ref[EventRuntimeInfo], slot_pointer_expr: ptr[ir.Expr], generation_expr: ptr[ir.Expr], once: bool, wait_frame_expr: ptr[ir.Expr], listener_expr: ptr[ir.Expr]?) -> span[ir.Stmt]:
    let bool_ty = types.primitive("bool")
    let ptr_uint_ty = types.primitive("ptr_uint")
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    var statements = vec.Vec[ir.Stmt].create()
    statements.push(event_slot_assign(event_slot_active_expression(slot_pointer_expr), alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = bool_ty))))
    statements.push(event_slot_assign(event_slot_field_expression(slot_pointer_expr, "once", bool_ty), alloc_expr(ir.Expr.expr_boolean_literal(value = once, ty = bool_ty))))
    statements.push(event_slot_assign(event_slot_field_expression(slot_pointer_expr, "generation", ptr_uint_ty), generation_expr))
    statements.push(event_slot_assign(event_slot_field_expression(slot_pointer_expr, "state", void_ptr_ty), alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty))))
    if listener_expr != null:
        let le = unsafe: ptr[ir.Expr]<-listener_expr
        statements.push(event_slot_assign(event_slot_field_expression(slot_pointer_expr, "listener", event_listener_type(info)), le))
    statements.push(event_slot_assign(event_slot_wait_frame_expression(slot_pointer_expr), wait_frame_expr))
    return statements.as_span()


## The host's `event_slot_activate_stateful_statements`: same prefix, but the
## slot's `state` field receives the caller's state pointer.
function event_slot_activate_stateful_statements(info: ref[EventRuntimeInfo], slot_pointer_expr: ptr[ir.Expr], generation_expr: ptr[ir.Expr], once: bool, state_expr: ptr[ir.Expr], wait_frame_expr: ptr[ir.Expr], listener_expr: ptr[ir.Expr]) -> span[ir.Stmt]:
    let bool_ty = types.primitive("bool")
    let ptr_uint_ty = types.primitive("ptr_uint")
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    var statements = vec.Vec[ir.Stmt].create()
    statements.push(event_slot_assign(event_slot_active_expression(slot_pointer_expr), alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = bool_ty))))
    statements.push(event_slot_assign(event_slot_field_expression(slot_pointer_expr, "once", bool_ty), alloc_expr(ir.Expr.expr_boolean_literal(value = once, ty = bool_ty))))
    statements.push(event_slot_assign(event_slot_field_expression(slot_pointer_expr, "generation", ptr_uint_ty), generation_expr))
    statements.push(event_slot_assign(event_slot_field_expression(slot_pointer_expr, "state", void_ptr_ty), state_expr))
    statements.push(event_slot_assign(event_slot_field_expression(slot_pointer_expr, "listener", event_listener_type(info)), listener_expr))
    statements.push(event_slot_assign(event_slot_wait_frame_expression(slot_pointer_expr), wait_frame_expr))
    return statements.as_span()


## The host's `event_slot_clear_statements`.
function event_slot_clear_statements(slot_pointer_expr: ptr[ir.Expr]) -> span[ir.Stmt]:
    let bool_ty = types.primitive("bool")
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    var statements = vec.Vec[ir.Stmt].create()
    statements.push(event_slot_assign(event_slot_active_expression(slot_pointer_expr), alloc_expr(ir.Expr.expr_boolean_literal(value = false, ty = bool_ty))))
    statements.push(event_slot_assign(event_slot_field_expression(slot_pointer_expr, "once", bool_ty), alloc_expr(ir.Expr.expr_boolean_literal(value = false, ty = bool_ty))))
    statements.push(event_slot_assign(event_slot_wait_frame_expression(slot_pointer_expr), alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty))))
    return statements.as_span()


## The host's `snapshot_field_expression`: `snapshots[index].field`.
function event_snapshot_field_expression(info: ref[EventRuntimeInfo], snapshots_expr: ptr[ir.Expr], index_expr: ptr[ir.Expr], field_name: str, field_ty: types.Type) -> ptr[ir.Expr]:
    let snapshot_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = j2(info.linkage_name, "__snapshot"))
    let snapshot_index = alloc_expr(ir.Expr.expr_index(receiver = snapshots_expr, index = index_expr, ty = snapshot_ty))
    return alloc_expr(ir.Expr.expr_member(receiver = snapshot_index, member = field_name, ty = field_ty))


function event_subscription_field_expression(subscription_expr: ptr[ir.Expr], field_name: str, field_ty: types.Type) -> ptr[ir.Expr]:
    return alloc_expr(ir.Expr.expr_member(receiver = subscription_expr, member = field_name, ty = field_ty))


function event_wait_frame_field_expression(frame_expr: ptr[ir.Expr], field_name: str, field_ty: types.Type) -> ptr[ir.Expr]:
    return alloc_expr(ir.Expr.expr_member(receiver = frame_expr, member = field_name, ty = field_ty))


function event_subscription_literal(slot_expr: ptr[ir.Expr], generation_expr: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let sub_ty = types.Type.ty_named(linkage_name = Option[str].some(value = "mt_subscription"), module_name = "", name = "Subscription")
    var fields = vec.Vec[ir.AggregateField].create()
    fields.push(ir.AggregateField(name = "slot", value = slot_expr))
    fields.push(ir.AggregateField(name = "generation", value = generation_expr))
    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = sub_ty, fields = fields.as_span()))


function event_subscription_success_literal(result_type: types.Type, slot_expr: ptr[ir.Expr], generation_expr: ptr[ir.Expr]) -> ptr[ir.Expr]:
    var fields = vec.Vec[ir.AggregateField].create()
    fields.push(ir.AggregateField(name = "value", value = event_subscription_literal(slot_expr, generation_expr)))
    return alloc_expr(ir.Expr.expr_variant_literal(ty = result_type, arm_name = "success", fields = fields.as_span()))


## The host's `void_value_expression`: `(void) 0`.
function void_value_expression() -> ptr[ir.Expr]:
    return alloc_expr(ir.Expr.expr_cast(
        target_type = types.primitive("void"),
        expression = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = types.primitive("int"))),
        ty = types.primitive("void"),
    ))


function event_wait_success_literal(result_type: types.Type, payload_expr: ptr[ir.Expr]?) -> ptr[ir.Expr]:
    var value = void_value_expression()
    if payload_expr != null:
        value = unsafe: ptr[ir.Expr]<-payload_expr
    var fields = vec.Vec[ir.AggregateField].create()
    fields.push(ir.AggregateField(name = "value", value = value))
    return alloc_expr(ir.Expr.expr_variant_literal(ty = result_type, arm_name = "success", fields = fields.as_span()))


function event_failure_literal(event_error_ty: types.Type, result_type: types.Type) -> ptr[ir.Expr]:
    let error_name = alloc_expr(ir.Expr.expr_name(name = "EventError_full", ty = event_error_ty, pointer = Option[bool].some(value = false)))
    var fields = vec.Vec[ir.AggregateField].create()
    fields.push(ir.AggregateField(name = "error", value = error_name))
    return alloc_expr(ir.Expr.expr_variant_literal(ty = result_type, arm_name = "failure", fields = fields.as_span()))


function event_unsubscribe_call(info: ref[EventRuntimeInfo], event_expr: ptr[ir.Expr], subscription_expr: ptr[ir.Expr]) -> ptr[ir.Expr]:
    return alloc_expr(ir.Expr.expr_call(
        callee = info.unsubscribe_c_name,
        arguments = sp_expr2(event_expr, subscription_expr),
        ty = types.primitive("void"),
    ))


function event_listener_call_expression(info: ref[EventRuntimeInfo], snapshots_expr: ptr[ir.Expr], dispatch_index_expr: ptr[ir.Expr], payload_expr: ptr[ir.Expr]?) -> ptr[ir.Expr]:
    let listener_ty = event_listener_type(info)
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    let listener = alloc_expr(ir.Expr.expr_cast(
        target_type = listener_ty,
        expression = event_snapshot_field_expression(info, snapshots_expr, dispatch_index_expr, "listener", void_ptr_ty),
        ty = listener_ty,
    ))
    var arguments = vec.Vec[ir.Expr].create()
    if payload_expr != null:
        unsafe:
            arguments.push(read(unsafe: ptr[ir.Expr]<-payload_expr))
    return alloc_expr(ir.Expr.expr_call_indirect(callee = listener, arguments = arguments.as_span(), ty = types.primitive("void")))


function event_stateful_listener_call_expression(info: ref[EventRuntimeInfo], snapshots_expr: ptr[ir.Expr], dispatch_index_expr: ptr[ir.Expr], payload_expr: ptr[ir.Expr]?) -> ptr[ir.Expr]:
    let listener_ty = event_stateful_listener_type(info)
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    let listener = alloc_expr(ir.Expr.expr_cast(
        target_type = listener_ty,
        expression = event_snapshot_field_expression(info, snapshots_expr, dispatch_index_expr, "listener", void_ptr_ty),
        ty = listener_ty,
    ))
    var arguments = vec.Vec[ir.Expr].create()
    unsafe:
        arguments.push(read(event_snapshot_field_expression(info, snapshots_expr, dispatch_index_expr, "state", void_ptr_ty)))
    if payload_expr != null:
        unsafe:
            arguments.push(read(unsafe: ptr[ir.Expr]<-payload_expr))
    return alloc_expr(ir.Expr.expr_call_indirect(callee = listener, arguments = arguments.as_span(), ty = types.primitive("void")))


function event_task_wake_fn_type() -> types.Type:
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    return types.Type.ty_function(name = "", params = single_ty_span(void_ptr_ty), return_type = types.alloc_type(types.primitive("void")), variadic = false, is_proc = false, param_names = sp_str("frame"))


## The host's `Types::Task#field` type for the given field name.
function event_task_field_type(info: ref[EventRuntimeInfo], field_name: str) -> types.Type:
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    if field_name == "frame":
        return void_ptr_ty
    if field_name == "ready":
        return types.Type.ty_function(name = "", params = single_ty_span(void_ptr_ty), return_type = types.alloc_type(types.primitive("bool")), variadic = false, is_proc = false, param_names = sp_str("frame"))
    if field_name == "set_waiter":
        var params = vec.Vec[types.Type].create()
        var names = vec.Vec[str].create()
        params.push(void_ptr_ty)
        names.push("frame")
        params.push(void_ptr_ty)
        names.push("waiter_frame")
        params.push(event_task_wake_fn_type())
        names.push("waiter")
        return types.Type.ty_function(name = "", params = params.as_span(), return_type = types.alloc_type(types.primitive("void")), variadic = false, is_proc = false, param_names = names.as_span())
    if field_name == "release" or field_name == "cancel":
        return types.Type.ty_function(name = "", params = single_ty_span(void_ptr_ty), return_type = types.alloc_type(types.primitive("void")), variadic = false, is_proc = false, param_names = sp_str("frame"))
    if field_name == "take_result":
        return types.Type.ty_function(name = "", params = single_ty_span(void_ptr_ty), return_type = types.alloc_type(info.wait_result_ty), variadic = false, is_proc = false, param_names = sp_str("frame"))
    fatal(c"event_task_field_type: unknown Task field")


function event_task_literal_from_raw_frame(info: ref[EventRuntimeInfo], raw_frame_expr: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let task_ty = make_task_type(info.wait_result_ty)
    var fields = vec.Vec[ir.AggregateField].create()
    fields.push(ir.AggregateField(name = "frame", value = raw_frame_expr))
    fields.push(ir.AggregateField(name = "ready", value = alloc_expr(ir.Expr.expr_name(name = info.wait_ready_c_name, ty = event_task_field_type(info, "ready"), pointer = Option[bool].some(value = false)))))
    fields.push(ir.AggregateField(name = "set_waiter", value = alloc_expr(ir.Expr.expr_name(name = info.wait_set_waiter_c_name, ty = event_task_field_type(info, "set_waiter"), pointer = Option[bool].some(value = false)))))
    fields.push(ir.AggregateField(name = "release", value = alloc_expr(ir.Expr.expr_name(name = info.wait_release_c_name, ty = event_task_field_type(info, "release"), pointer = Option[bool].some(value = false)))))
    fields.push(ir.AggregateField(name = "take_result", value = alloc_expr(ir.Expr.expr_name(name = info.wait_take_result_c_name, ty = event_task_field_type(info, "take_result"), pointer = Option[bool].some(value = false)))))
    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = task_ty, fields = fields.as_span()))


function event_task_literal(info: ref[EventRuntimeInfo], frame_expr: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    let raw_frame_expr = alloc_expr(ir.Expr.expr_cast(target_type = void_ptr_ty, expression = frame_expr, ty = void_ptr_ty))
    return event_task_literal_from_raw_frame(info, raw_frame_expr)


function event_immediate_failure_task_literal(info: ref[EventRuntimeInfo]) -> ptr[ir.Expr]:
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    return event_task_literal_from_raw_frame(info, alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty)))


## Build a per-event subscribe (or subscribe_once) synthetic function.
function build_event_subscribe_fn(ctx: ref[LowerCtx], info: ref[EventRuntimeInfo], slot_cn: str, event_cn: str, once: bool) -> ir.Function:
    let void_ty = ctx.void_ty
    let bool_ty = ctx.bool_ty
    let ptr_uint_ty = types.primitive("ptr_uint")
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(void_ty))
    let sub_plain_ty = types.Type.ty_named(linkage_name = Option[str].some(value = "mt_subscription"), module_name = "", name = "Subscription")
    let event_error_ty = ensure_event_error_enum(ctx)
    var result_args = vec.Vec[types.Type].create()
    result_args.push(sub_plain_ty)
    result_args.push(event_error_ty)
    let sub_result_ty = ensure_generic_variant(ctx, "Result", result_args.as_span())
    let slot_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.slot_c_name)
    let slot_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(slot_ty))
    let event_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(event_value_type(info)))
    let listener_ty = event_listener_type(info)
    let callee = if once: info.subscribe_once_c_name else: info.subscribe_c_name
    let event_expr = alloc_expr(ir.Expr.expr_name(name = "event", ty = event_ptr_ty, pointer = Option[bool].some(value = false)))
    let listener_expr = alloc_expr(ir.Expr.expr_name(name = "listener", ty = listener_ty, pointer = Option[bool].some(value = false)))
    let slot_index_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_slot_index", ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let generation_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_generation", ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let slot_pointer_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_slot", ty = slot_ptr_ty, pointer = Option[bool].some(value = false)))
    let cap_lit = alloc_expr(ir.Expr.expr_integer_literal(value = long<-(info.capacity), ty = ptr_uint_ty))
    let cond = alloc_expr(ir.Expr.expr_binary(operator = "<", left = slot_index_expr, right = cap_lit, ty = bool_ty))
    let post = alloc_stmt(ir.Stmt.stmt_assignment(target = slot_index_expr, operator = "+=", value = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = ptr_uint_ty))))
    let init = alloc_stmt(ir.Stmt.stmt_local(name = "__mt_slot_index", linkage_name = "__mt_slot_index", ty = ptr_uint_ty, value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty)), line = 0, source_path = ""))
    var loop_body = vec.Vec[ir.Stmt].create()
    loop_body.push(event_slot_local_decl(info, event_expr, slot_index_expr, "__mt_slot"))
    loop_body.push(active_event_slot_continue_guard(slot_pointer_expr))
    loop_body.push(ir.Stmt.stmt_local(name = "__mt_generation", linkage_name = "__mt_generation", ty = ptr_uint_ty, value = event_next_generation_expression(slot_pointer_expr), line = 0, source_path = ""))
    let listener_cast = alloc_expr(ir.Expr.expr_cast(target_type = void_ptr_ty, expression = listener_expr, ty = void_ptr_ty))
    let activate = event_slot_activate_statements(info, slot_pointer_expr, generation_expr, once, alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty)), listener_cast)
    var ai: ptr_uint = 0
    while ai < activate.len:
        unsafe:
            loop_body.push(read(activate.data + ai))
        ai += 1
    loop_body.push(ir.Stmt.stmt_return(value = event_subscription_success_literal(sub_result_ty, slot_index_expr, generation_expr), line = 0, source_path = ""))
    var body = vec.Vec[ir.Stmt].create()
    body.push(ir.Stmt.stmt_for(init = init, condition = cond, post = post, body = loop_body.as_span()))
    body.push(ir.Stmt.stmt_return(value = event_failure_literal(event_error_ty, sub_result_ty), line = 0, source_path = ""))
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "event", linkage_name = "event", ty = event_ptr_ty, pointer = Option[bool].some(value = false)))
    params.push(ir.Param(name = "listener", linkage_name = "listener", ty = listener_ty, pointer = Option[bool].some(value = false)))
    return ir.Function(name = j2(callee, "_fn"), linkage_name = callee, params = params.as_span(), return_type = sub_result_ty, body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build a per-event stateful subscribe (or subscribe_once) synthetic function.
## Same as build_event_subscribe_fn but also accepts a `state: ptr[void]`
## parameter and writes it into the slot's `state` field.
function build_event_subscribe_stateful_fn(ctx: ref[LowerCtx], info: ref[EventRuntimeInfo], slot_cn: str, event_cn: str, once: bool) -> ir.Function:
    let void_ty = ctx.void_ty
    let bool_ty = ctx.bool_ty
    let ptr_uint_ty = types.primitive("ptr_uint")
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(void_ty))
    let sub_plain_ty = types.Type.ty_named(linkage_name = Option[str].some(value = "mt_subscription"), module_name = "", name = "Subscription")
    let event_error_ty = ensure_event_error_enum(ctx)
    var result_args = vec.Vec[types.Type].create()
    result_args.push(sub_plain_ty)
    result_args.push(event_error_ty)
    let sub_result_ty = ensure_generic_variant(ctx, "Result", result_args.as_span())
    let slot_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.slot_c_name)
    let slot_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(slot_ty))
    let event_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(event_value_type(info)))
    var callee: str
    if once:
        callee = info.subscribe_once_stateful_c_name
    else:
        callee = info.subscribe_stateful_c_name
    let event_expr = alloc_expr(ir.Expr.expr_name(name = "event", ty = event_ptr_ty, pointer = Option[bool].some(value = false)))
    let state_expr = alloc_expr(ir.Expr.expr_name(name = "state", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    let listener_expr = alloc_expr(ir.Expr.expr_name(name = "listener", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    let slot_index_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_slot_index", ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let generation_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_generation", ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let slot_pointer_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_slot", ty = slot_ptr_ty, pointer = Option[bool].some(value = false)))
    let cap_lit = alloc_expr(ir.Expr.expr_integer_literal(value = long<-(info.capacity), ty = ptr_uint_ty))
    let cond = alloc_expr(ir.Expr.expr_binary(operator = "<", left = slot_index_expr, right = cap_lit, ty = bool_ty))
    let post = alloc_stmt(ir.Stmt.stmt_assignment(target = slot_index_expr, operator = "+=", value = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = ptr_uint_ty))))
    let init = alloc_stmt(ir.Stmt.stmt_local(name = "__mt_slot_index", linkage_name = "__mt_slot_index", ty = ptr_uint_ty, value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty)), line = 0, source_path = ""))
    var loop_body = vec.Vec[ir.Stmt].create()
    loop_body.push(event_slot_local_decl(info, event_expr, slot_index_expr, "__mt_slot"))
    loop_body.push(active_event_slot_continue_guard(slot_pointer_expr))
    loop_body.push(ir.Stmt.stmt_local(name = "__mt_generation", linkage_name = "__mt_generation", ty = ptr_uint_ty, value = event_next_generation_expression(slot_pointer_expr), line = 0, source_path = ""))
    let activate = event_slot_activate_stateful_statements(info, slot_pointer_expr, generation_expr, once, state_expr, alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty)), listener_expr)
    var ai: ptr_uint = 0
    while ai < activate.len:
        unsafe:
            loop_body.push(read(activate.data + ai))
        ai += 1
    loop_body.push(ir.Stmt.stmt_return(value = event_subscription_success_literal(sub_result_ty, slot_index_expr, generation_expr), line = 0, source_path = ""))
    var body = vec.Vec[ir.Stmt].create()
    body.push(ir.Stmt.stmt_for(init = init, condition = cond, post = post, body = loop_body.as_span()))
    body.push(ir.Stmt.stmt_return(value = event_failure_literal(event_error_ty, sub_result_ty), line = 0, source_path = ""))
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "event", linkage_name = "event", ty = event_ptr_ty, pointer = Option[bool].some(value = false)))
    params.push(ir.Param(name = "state", linkage_name = "state", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    params.push(ir.Param(name = "listener", linkage_name = "listener", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    return ir.Function(name = j2(callee, "_fn"), linkage_name = callee, params = params.as_span(), return_type = sub_result_ty, body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build a per-event unsubscribe synthetic function.
function build_event_unsubscribe_fn(info: ref[EventRuntimeInfo], slot_cn: str, event_cn: str) -> ir.Function:
    let bool_ty = types.primitive("bool")
    let ptr_uint_ty = types.primitive("ptr_uint")
    let slot_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.slot_c_name)
    let slot_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(slot_ty))
    let event_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(event_value_type(info)))
    let sub_ty = types.Type.ty_named(linkage_name = Option[str].some(value = "mt_subscription"), module_name = "", name = "Subscription")
    let event_expr = alloc_expr(ir.Expr.expr_name(name = "event", ty = event_ptr_ty, pointer = Option[bool].some(value = false)))
    let subscription_expr = alloc_expr(ir.Expr.expr_name(name = "subscription", ty = sub_ty, pointer = Option[bool].some(value = false)))
    let slot_index_expr = event_subscription_field_expression(subscription_expr, "slot", ptr_uint_ty)
    let slot_pointer_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_slot", ty = slot_ptr_ty, pointer = Option[bool].some(value = false)))
    let false_value = alloc_expr(ir.Expr.expr_boolean_literal(value = false, ty = bool_ty))
    let true_value = alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = bool_ty))
    let cap_lit = alloc_expr(ir.Expr.expr_integer_literal(value = long<-(info.capacity), ty = ptr_uint_ty))
    var body = vec.Vec[ir.Stmt].create()
    body.push(ir.Stmt.stmt_if(
        condition = alloc_expr(ir.Expr.expr_binary(operator = ">=", left = slot_index_expr, right = cap_lit, ty = bool_ty)),
        then_body = span_from_one(ir.Stmt.stmt_return(value = false_value, line = 0, source_path = "")),
        else_body = Option[span[ir.Stmt]].none,
    ))
    body.push(event_slot_local_decl(info, event_expr, slot_index_expr, "__mt_slot"))
    body.push(ir.Stmt.stmt_if(
        condition = alloc_expr(ir.Expr.expr_unary(operator = "not", operand = event_slot_active_expression(slot_pointer_expr), ty = bool_ty)),
        then_body = span_from_one(ir.Stmt.stmt_return(value = false_value, line = 0, source_path = "")),
        else_body = Option[span[ir.Stmt]].none,
    ))
    body.push(ir.Stmt.stmt_if(
        condition = alloc_expr(ir.Expr.expr_binary(
            operator = "!=",
            left = event_slot_field_expression(slot_pointer_expr, "generation", ptr_uint_ty),
            right = event_subscription_field_expression(subscription_expr, "generation", ptr_uint_ty),
            ty = bool_ty,
        )),
        then_body = span_from_one(ir.Stmt.stmt_return(value = false_value, line = 0, source_path = "")),
        else_body = Option[span[ir.Stmt]].none,
    ))
    let clear = event_slot_clear_statements(slot_pointer_expr)
    var ci: ptr_uint = 0
    while ci < clear.len:
        unsafe:
            body.push(read(clear.data + ci))
        ci += 1
    body.push(ir.Stmt.stmt_return(value = true_value, line = 0, source_path = ""))
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "event", linkage_name = "event", ty = event_ptr_ty, pointer = Option[bool].some(value = false)))
    params.push(ir.Param(name = "subscription", linkage_name = "subscription", ty = sub_ty, pointer = Option[bool].some(value = false)))
    return ir.Function(name = j2(info.unsubscribe_c_name, "_fn"), linkage_name = info.unsubscribe_c_name, params = params.as_span(), return_type = bool_ty, body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build a per-event emit synthetic function.
function build_event_emit_fn(info: ref[EventRuntimeInfo], slot_cn: str, event_cn: str) -> ir.Function:
    let void_ty = types.primitive("void")
    let bool_ty = types.primitive("bool")
    let ptr_uint_ty = types.primitive("ptr_uint")
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(void_ty))
    let slot_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.slot_c_name)
    let slot_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(slot_ty))
    let snapshot_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = j2(info.linkage_name, "__snapshot"))
    let snapshots_ty = types.Type.ty_generic(name = "array", args = sp_type2(snapshot_ty, types.literal_int(long<-(info.capacity))))
    let wait_frame_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.wait_frame_c_name)
    let wait_frame_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(wait_frame_ty))
    let event_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(event_value_type(info)))
    let event_expr = alloc_expr(ir.Expr.expr_name(name = "event", ty = event_ptr_ty, pointer = Option[bool].some(value = false)))
    let snapshots_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_snapshots", ty = snapshots_ty, pointer = Option[bool].some(value = false)))
    let snapshot_count_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_snapshot_count", ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let slot_index_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_slot_index", ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let dispatch_index_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_dispatch_index", ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let slot_pointer_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_slot", ty = slot_ptr_ty, pointer = Option[bool].some(value = false)))
    let frame_pointer_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_wait_frame", ty = wait_frame_ptr_ty, pointer = Option[bool].some(value = false)))
    var payload_expr: ptr[ir.Expr]? = null
    if info.has_payload:
        payload_expr = alloc_expr(ir.Expr.expr_name(name = "payload", ty = info.payload_type, pointer = Option[bool].some(value = false)))

    let cap_lit = alloc_expr(ir.Expr.expr_integer_literal(value = long<-(info.capacity), ty = ptr_uint_ty))
    var collect_body = vec.Vec[ir.Stmt].create()
    collect_body.push(event_slot_local_decl(info, event_expr, slot_index_expr, "__mt_slot"))
    collect_body.push(inactive_event_slot_continue_guard(slot_pointer_expr))
    collect_body.push(event_slot_assign(event_snapshot_field_expression(info, snapshots_expr, snapshot_count_expr, "slot", ptr_uint_ty), slot_index_expr))
    collect_body.push(event_slot_assign(event_snapshot_field_expression(info, snapshots_expr, snapshot_count_expr, "generation", ptr_uint_ty), event_slot_field_expression(slot_pointer_expr, "generation", ptr_uint_ty)))
    collect_body.push(event_slot_assign(event_snapshot_field_expression(info, snapshots_expr, snapshot_count_expr, "once", bool_ty), event_slot_field_expression(slot_pointer_expr, "once", bool_ty)))
    collect_body.push(event_slot_assign(
        event_snapshot_field_expression(info, snapshots_expr, snapshot_count_expr, "wait_slot", bool_ty),
        alloc_expr(ir.Expr.expr_binary(
            operator = "!=",
            left = event_slot_wait_frame_expression(slot_pointer_expr),
            right = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty)),
            ty = bool_ty,
        )),
    ))
    collect_body.push(event_slot_assign(
        event_snapshot_field_expression(info, snapshots_expr, snapshot_count_expr, "stateful", bool_ty),
        alloc_expr(ir.Expr.expr_binary(
            operator = "!=",
            left = event_slot_field_expression(slot_pointer_expr, "state", void_ptr_ty),
            right = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty)),
            ty = bool_ty,
        )),
    ))
    collect_body.push(event_slot_assign(event_snapshot_field_expression(info, snapshots_expr, snapshot_count_expr, "state", void_ptr_ty), event_slot_field_expression(slot_pointer_expr, "state", void_ptr_ty)))
    collect_body.push(event_slot_assign(event_snapshot_field_expression(info, snapshots_expr, snapshot_count_expr, "listener", void_ptr_ty), event_slot_field_expression(slot_pointer_expr, "listener", void_ptr_ty)))
    collect_body.push(ir.Stmt.stmt_assignment(target = snapshot_count_expr, operator = "+=", value = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = ptr_uint_ty))))

    let snapshot_subscription_expr = event_subscription_literal(
        event_snapshot_field_expression(info, snapshots_expr, dispatch_index_expr, "slot", ptr_uint_ty),
        event_snapshot_field_expression(info, snapshots_expr, dispatch_index_expr, "generation", ptr_uint_ty),
    )
    let wait_slot_condition = alloc_expr(ir.Expr.expr_binary(
        operator = "and",
        left = event_slot_active_expression(slot_pointer_expr),
        right = alloc_expr(ir.Expr.expr_binary(
            operator = "and",
            left = alloc_expr(ir.Expr.expr_binary(
                operator = "==",
                left = event_slot_field_expression(slot_pointer_expr, "generation", ptr_uint_ty),
                right = event_snapshot_field_expression(info, snapshots_expr, dispatch_index_expr, "generation", ptr_uint_ty),
                ty = bool_ty,
            )),
            right = alloc_expr(ir.Expr.expr_binary(
                operator = "!=",
                left = event_slot_wait_frame_expression(slot_pointer_expr),
                right = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty)),
                ty = bool_ty,
            )),
            ty = bool_ty,
        )),
        ty = bool_ty,
    ))
    let waiter_frame_expr = event_wait_frame_field_expression(frame_pointer_expr, "waiter_frame", void_ptr_ty)
    var wait_then_body = vec.Vec[ir.Stmt].create()
    wait_then_body.push(ir.Stmt.stmt_local(
        name = "__mt_wait_frame",
        linkage_name = "__mt_wait_frame",
        ty = wait_frame_ptr_ty,
        value = alloc_expr(ir.Expr.expr_cast(target_type = wait_frame_ptr_ty, expression = event_slot_wait_frame_expression(slot_pointer_expr), ty = wait_frame_ptr_ty)),
        line = 0,
        source_path = "",
    ))
    wait_then_body.push(ir.Stmt.stmt_expression(expression = event_unsubscribe_call(info, event_expr, snapshot_subscription_expr), line = 0, source_path = ""))
    wait_then_body.push(event_slot_assign(event_wait_frame_field_expression(frame_pointer_expr, "result", info.wait_result_ty), event_wait_success_literal(info.wait_result_ty, payload_expr)))
    wait_then_body.push(event_slot_assign(event_wait_frame_field_expression(frame_pointer_expr, "ready", bool_ty), alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = bool_ty))))
    var wake_body = vec.Vec[ir.Stmt].create()
    wake_body.push(ir.Stmt.stmt_local(name = "__mt_waiter_frame", linkage_name = "__mt_waiter_frame", ty = void_ptr_ty, value = waiter_frame_expr, line = 0, source_path = ""))
    wake_body.push(event_slot_assign(waiter_frame_expr, alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty))))
    wake_body.push(ir.Stmt.stmt_expression(
        expression = alloc_expr(ir.Expr.expr_call_indirect(
            callee = event_wait_frame_field_expression(frame_pointer_expr, "waiter", event_task_wake_fn_type()),
            arguments = single_expr_span(alloc_expr(ir.Expr.expr_name(name = "__mt_waiter_frame", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))),
            ty = void_ty,
        )),
        line = 0,
        source_path = "",
    ))
    wait_then_body.push(ir.Stmt.stmt_if(
        condition = alloc_expr(ir.Expr.expr_binary(
            operator = "!=",
            left = waiter_frame_expr,
            right = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty)),
            ty = bool_ty,
        )),
        then_body = wake_body.as_span(),
        else_body = Option[span[ir.Stmt]].none,
    ))
    var dispatch_body = vec.Vec[ir.Stmt].create()
    var already_handled_body = vec.Vec[ir.Stmt].create()
    already_handled_body.push(ir.Stmt.stmt_if(
        condition = event_snapshot_field_expression(info, snapshots_expr, dispatch_index_expr, "once", bool_ty),
        then_body = span_from_one(ir.Stmt.stmt_expression(expression = event_unsubscribe_call(info, event_expr, snapshot_subscription_expr), line = 0, source_path = "")),
        else_body = Option[span[ir.Stmt]].none,
    ))
    already_handled_body.push(ir.Stmt.stmt_if(
        condition = event_snapshot_field_expression(info, snapshots_expr, dispatch_index_expr, "stateful", bool_ty),
        then_body = span_from_one(ir.Stmt.stmt_expression(expression = event_stateful_listener_call_expression(info, snapshots_expr, dispatch_index_expr, payload_expr), line = 0, source_path = "")),
        else_body = Option[span[ir.Stmt]].some(value = span_from_one(ir.Stmt.stmt_expression(expression = event_listener_call_expression(info, snapshots_expr, dispatch_index_expr, payload_expr), line = 0, source_path = ""))),
    ))
    var wait_slot_body = vec.Vec[ir.Stmt].create()
    wait_slot_body.push(event_slot_local_decl(
        info,
        event_expr,
        event_snapshot_field_expression(info, snapshots_expr, dispatch_index_expr, "slot", ptr_uint_ty),
        "__mt_slot",
    ))
    wait_slot_body.push(ir.Stmt.stmt_if(condition = wait_slot_condition, then_body = wait_then_body.as_span(), else_body = Option[span[ir.Stmt]].none))
    dispatch_body.push(ir.Stmt.stmt_if(
        condition = event_snapshot_field_expression(info, snapshots_expr, dispatch_index_expr, "wait_slot", bool_ty),
        then_body = wait_slot_body.as_span(),
        else_body = Option[span[ir.Stmt]].some(value = already_handled_body.as_span()),
    ))
    var body = vec.Vec[ir.Stmt].create()
    body.push(ir.Stmt.stmt_local(name = "__mt_snapshots", linkage_name = "__mt_snapshots", ty = snapshots_ty, value = alloc_expr(ir.Expr.expr_zero_init(ty = snapshots_ty)), line = 0, source_path = ""))
    body.push(ir.Stmt.stmt_local(name = "__mt_snapshot_count", linkage_name = "__mt_snapshot_count", ty = ptr_uint_ty, value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty)), line = 0, source_path = ""))
    body.push(ir.Stmt.stmt_for(
        init = alloc_stmt(ir.Stmt.stmt_local(name = "__mt_slot_index", linkage_name = "__mt_slot_index", ty = ptr_uint_ty, value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty)), line = 0, source_path = "")),
        condition = alloc_expr(ir.Expr.expr_binary(operator = "<", left = slot_index_expr, right = cap_lit, ty = bool_ty)),
        post = alloc_stmt(ir.Stmt.stmt_assignment(target = slot_index_expr, operator = "+=", value = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = ptr_uint_ty)))),
        body = collect_body.as_span(),
    ))
    body.push(ir.Stmt.stmt_for(
        init = alloc_stmt(ir.Stmt.stmt_local(name = "__mt_dispatch_index", linkage_name = "__mt_dispatch_index", ty = ptr_uint_ty, value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty)), line = 0, source_path = "")),
        condition = alloc_expr(ir.Expr.expr_binary(operator = "<", left = dispatch_index_expr, right = snapshot_count_expr, ty = bool_ty)),
        post = alloc_stmt(ir.Stmt.stmt_assignment(target = dispatch_index_expr, operator = "+=", value = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = ptr_uint_ty)))),
        body = dispatch_body.as_span(),
    ))
    body.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "event", linkage_name = "event", ty = event_ptr_ty, pointer = Option[bool].some(value = false)))
    if info.has_payload:
        params.push(ir.Param(name = "payload", linkage_name = "payload", ty = info.payload_type, pointer = Option[bool].some(value = false)))
    return ir.Function(name = j2(info.emit_c_name, "_fn"), linkage_name = info.emit_c_name, params = params.as_span(), return_type = void_ty, body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build a per-event wait ready vtable function.
## Checks if the wait frame is ready.
function build_event_wait_ready_fn(info: ref[EventRuntimeInfo], slot_cn: str, event_cn: str) -> ir.Function:
    let void_ty = types.primitive("void")
    let bool_ty = types.primitive("bool")
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(void_ty))
    let wf_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.wait_frame_c_name)))
    let raw_expr = alloc_expr(ir.Expr.expr_name(name = "frame", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    let frame_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_wait_frame", ty = wf_ptr_ty, pointer = Option[bool].some(value = false)))
    var body = vec.Vec[ir.Stmt].create()
    body.push(ir.Stmt.stmt_if(
        condition = alloc_expr(ir.Expr.expr_binary(operator = "==", left = raw_expr, right = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty)), ty = bool_ty)),
        then_body = span_from_one(ir.Stmt.stmt_return(value = alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = bool_ty)), line = 0, source_path = "")),
        else_body = Option[span[ir.Stmt]].none,
    ))
    body.push(ir.Stmt.stmt_local(name = "__mt_wait_frame", linkage_name = "__mt_wait_frame", ty = wf_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = wf_ptr_ty, expression = raw_expr, ty = wf_ptr_ty)), line = 0, source_path = ""))
    body.push(ir.Stmt.stmt_return(value = event_wait_frame_field_expression(frame_expr, "ready", bool_ty), line = 0, source_path = ""))
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "frame", linkage_name = "frame", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    return ir.Function(name = j2(info.wait_ready_c_name, "_fn"), linkage_name = info.wait_ready_c_name, params = params.as_span(), return_type = bool_ty, body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build a per-event wait set_waiter vtable function.
## Stores the waiter in the wait frame, or calls it immediately if already ready.
function build_event_wait_set_waiter_fn(info: ref[EventRuntimeInfo], slot_cn: str, event_cn: str) -> ir.Function:
    let void_ty = types.primitive("void")
    let bool_ty = types.primitive("bool")
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(void_ty))
    let wf_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.wait_frame_c_name)))
    let wake_ty = event_task_wake_fn_type()
    let raw_expr = alloc_expr(ir.Expr.expr_name(name = "frame", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    let frame_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_wait_frame", ty = wf_ptr_ty, pointer = Option[bool].some(value = false)))
    let waiter_frame_expr = alloc_expr(ir.Expr.expr_name(name = "waiter_frame", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    let waiter_expr = alloc_expr(ir.Expr.expr_name(name = "waiter", ty = wake_ty, pointer = Option[bool].some(value = false)))
    let call_waiter = ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(callee = waiter_expr, arguments = single_expr_span(waiter_frame_expr), ty = void_ty)), line = 0, source_path = "")
    var body = vec.Vec[ir.Stmt].create()
    var null_then = vec.Vec[ir.Stmt].create()
    null_then.push(call_waiter)
    null_then.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    body.push(ir.Stmt.stmt_if(
        condition = alloc_expr(ir.Expr.expr_binary(operator = "==", left = raw_expr, right = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty)), ty = bool_ty)),
        then_body = null_then.as_span(),
        else_body = Option[span[ir.Stmt]].none,
    ))
    body.push(ir.Stmt.stmt_local(name = "__mt_wait_frame", linkage_name = "__mt_wait_frame", ty = wf_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = wf_ptr_ty, expression = raw_expr, ty = wf_ptr_ty)), line = 0, source_path = ""))
    var ready_then = vec.Vec[ir.Stmt].create()
    ready_then.push(call_waiter)
    ready_then.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    body.push(ir.Stmt.stmt_if(
        condition = event_wait_frame_field_expression(frame_expr, "ready", bool_ty),
        then_body = ready_then.as_span(),
        else_body = Option[span[ir.Stmt]].none,
    ))
    body.push(event_slot_assign(event_wait_frame_field_expression(frame_expr, "waiter_frame", void_ptr_ty), waiter_frame_expr))
    body.push(event_slot_assign(event_wait_frame_field_expression(frame_expr, "waiter", wake_ty), waiter_expr))
    body.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "frame", linkage_name = "frame", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    params.push(ir.Param(name = "waiter_frame", linkage_name = "waiter_frame", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    params.push(ir.Param(name = "waiter", linkage_name = "waiter", ty = wake_ty, pointer = Option[bool].some(value = false)))
    return ir.Function(name = j2(info.wait_set_waiter_c_name, "_fn"), linkage_name = info.wait_set_waiter_c_name, params = params.as_span(), return_type = void_ty, body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build a per-event wait release vtable function.
## Frees the wait frame if not already ready.
function build_event_wait_release_fn(info: ref[EventRuntimeInfo], slot_cn: str, event_cn: str) -> ir.Function:
    let void_ty = types.primitive("void")
    let bool_ty = types.primitive("bool")
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(void_ty))
    let wf_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.wait_frame_c_name)))
    let event_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(event_value_type(info)))
    let sub_ty = types.Type.ty_named(linkage_name = Option[str].some(value = "mt_subscription"), module_name = "", name = "Subscription")
    let raw_expr = alloc_expr(ir.Expr.expr_name(name = "frame", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    let frame_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_wait_frame", ty = wf_ptr_ty, pointer = Option[bool].some(value = false)))
    var body = vec.Vec[ir.Stmt].create()
    body.push(ir.Stmt.stmt_if(
        condition = alloc_expr(ir.Expr.expr_binary(operator = "==", left = raw_expr, right = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty)), ty = bool_ty)),
        then_body = span_from_one(ir.Stmt.stmt_return(value = null, line = 0, source_path = "")),
        else_body = Option[span[ir.Stmt]].none,
    ))
    body.push(ir.Stmt.stmt_local(name = "__mt_wait_frame", linkage_name = "__mt_wait_frame", ty = wf_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = wf_ptr_ty, expression = raw_expr, ty = wf_ptr_ty)), line = 0, source_path = ""))
    let event_cast = alloc_expr(ir.Expr.expr_cast(
        target_type = event_ptr_ty,
        expression = event_wait_frame_field_expression(frame_expr, "event", void_ptr_ty),
        ty = event_ptr_ty,
    ))
    body.push(ir.Stmt.stmt_if(
        condition = alloc_expr(ir.Expr.expr_unary(operator = "not", operand = event_wait_frame_field_expression(frame_expr, "ready", bool_ty), ty = bool_ty)),
        then_body = span_from_one(ir.Stmt.stmt_expression(
            expression = event_unsubscribe_call(info, event_cast, event_wait_frame_field_expression(frame_expr, "subscription", sub_ty)),
            line = 0,
            source_path = "",
        )),
        else_body = Option[span[ir.Stmt]].none,
    ))
    body.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call(callee = "mt_async_free", arguments = single_expr_span(raw_expr), ty = void_ty)), line = 0, source_path = ""))
    body.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "frame", linkage_name = "frame", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    return ir.Function(name = j2(info.wait_release_c_name, "_fn"), linkage_name = info.wait_release_c_name, params = params.as_span(), return_type = void_ty, body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build a per-event wait take_result vtable function.
function build_event_wait_take_result_fn(ctx: ref[LowerCtx], info: ref[EventRuntimeInfo], slot_cn: str, event_cn: str) -> ir.Function:
    let void_ty = types.primitive("void")
    let bool_ty = types.primitive("bool")
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(void_ty))
    let wf_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.wait_frame_c_name)))
    let event_error_ty = ensure_event_error_enum(ctx)
    let raw_expr = alloc_expr(ir.Expr.expr_name(name = "frame", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    let frame_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_wait_frame", ty = wf_ptr_ty, pointer = Option[bool].some(value = false)))
    var body = vec.Vec[ir.Stmt].create()
    body.push(ir.Stmt.stmt_if(
        condition = alloc_expr(ir.Expr.expr_binary(operator = "==", left = raw_expr, right = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr_ty)), ty = bool_ty)),
        then_body = span_from_one(ir.Stmt.stmt_return(value = event_failure_literal(event_error_ty, info.wait_result_ty), line = 0, source_path = "")),
        else_body = Option[span[ir.Stmt]].none,
    ))
    body.push(ir.Stmt.stmt_local(name = "__mt_wait_frame", linkage_name = "__mt_wait_frame", ty = wf_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = wf_ptr_ty, expression = raw_expr, ty = wf_ptr_ty)), line = 0, source_path = ""))
    body.push(ir.Stmt.stmt_return(value = event_wait_frame_field_expression(frame_expr, "result", info.wait_result_ty), line = 0, source_path = ""))
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "frame", linkage_name = "frame", ty = void_ptr_ty, pointer = Option[bool].some(value = false)))
    return ir.Function(name = j2(info.wait_take_result_c_name, "_fn"), linkage_name = info.wait_take_result_c_name, params = params.as_span(), return_type = info.wait_result_ty, body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build the per-event wait function.
## Loops through inactive slots, activates one as subscribe_once with a wait_frame,
## and returns a Task[Result[void_or_payload, EventError]].
function build_event_wait_fn(ctx: ref[LowerCtx], info: ref[EventRuntimeInfo], slot_cn: str, event_cn: str) -> ir.Function:
    let void_ty = ctx.void_ty
    let bool_ty = ctx.bool_ty
    let ptr_uint_ty = types.primitive("ptr_uint")
    let void_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(void_ty))
    let wait_frame_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.wait_frame_c_name)
    let wf_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(wait_frame_ty))
    let slot_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = info.slot_c_name)
    let slot_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(slot_ty))
    let event_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(event_value_type(info)))
    let sub_ty = types.Type.ty_named(linkage_name = Option[str].some(value = "mt_subscription"), module_name = "", name = "Subscription")
    let task_ty = make_task_type(info.wait_result_ty)
    let event_expr = alloc_expr(ir.Expr.expr_name(name = "event", ty = event_ptr_ty, pointer = Option[bool].some(value = false)))
    let frame_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_wait_frame", ty = wf_ptr_ty, pointer = Option[bool].some(value = false)))
    let raw_frame_expr = alloc_expr(ir.Expr.expr_cast(target_type = void_ptr_ty, expression = frame_expr, ty = void_ptr_ty))
    let slot_index_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_slot_index", ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let generation_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_generation", ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let slot_pointer_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_slot", ty = slot_ptr_ty, pointer = Option[bool].some(value = false)))
    let cap_lit = alloc_expr(ir.Expr.expr_integer_literal(value = long<-(info.capacity), ty = ptr_uint_ty))
    let cond = alloc_expr(ir.Expr.expr_binary(operator = "<", left = slot_index_expr, right = cap_lit, ty = bool_ty))
    let post = alloc_stmt(ir.Stmt.stmt_assignment(target = slot_index_expr, operator = "+=", value = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = ptr_uint_ty))))
    let init = alloc_stmt(ir.Stmt.stmt_local(name = "__mt_slot_index", linkage_name = "__mt_slot_index", ty = ptr_uint_ty, value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty)), line = 0, source_path = ""))
    var loop_body = vec.Vec[ir.Stmt].create()
    loop_body.push(event_slot_local_decl(info, event_expr, slot_index_expr, "__mt_slot"))
    loop_body.push(active_event_slot_continue_guard(slot_pointer_expr))
    loop_body.push(ir.Stmt.stmt_local(name = "__mt_generation", linkage_name = "__mt_generation", ty = ptr_uint_ty, value = event_next_generation_expression(slot_pointer_expr), line = 0, source_path = ""))
    let wf_size_expr = alloc_expr(ir.Expr.expr_sizeof(target_type = wait_frame_ty, ty = ptr_uint_ty))
    let alloc_call = alloc_expr(ir.Expr.expr_call(callee = "mt_async_alloc", arguments = single_expr_span(wf_size_expr), ty = void_ptr_ty))
    loop_body.push(ir.Stmt.stmt_local(name = "__mt_wait_frame", linkage_name = "__mt_wait_frame", ty = wf_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = wf_ptr_ty, expression = alloc_call, ty = wf_ptr_ty)), line = 0, source_path = ""))
    let frame_deref = alloc_expr(ir.Expr.expr_unary(operator = "*", operand = frame_expr, ty = wait_frame_ty))
    loop_body.push(event_slot_assign(frame_deref, alloc_expr(ir.Expr.expr_zero_init(ty = wait_frame_ty))))
    let event_cast = alloc_expr(ir.Expr.expr_cast(target_type = void_ptr_ty, expression = event_expr, ty = void_ptr_ty))
    loop_body.push(event_slot_assign(event_wait_frame_field_expression(frame_expr, "event", void_ptr_ty), event_cast))
    let activate = event_slot_activate_statements(info, slot_pointer_expr, generation_expr, true, raw_frame_expr, null)
    var ai: ptr_uint = 0
    while ai < activate.len:
        unsafe:
            loop_body.push(read(activate.data + ai))
        ai += 1
    loop_body.push(event_slot_assign(event_wait_frame_field_expression(frame_expr, "subscription", sub_ty), event_subscription_literal(slot_index_expr, generation_expr)))
    loop_body.push(ir.Stmt.stmt_return(value = event_task_literal(info, frame_expr), line = 0, source_path = ""))
    var body = vec.Vec[ir.Stmt].create()
    body.push(ir.Stmt.stmt_for(init = init, condition = cond, post = post, body = loop_body.as_span()))
    body.push(ir.Stmt.stmt_return(value = event_immediate_failure_task_literal(info), line = 0, source_path = ""))
    var params = vec.Vec[ir.Param].create()
    params.push(ir.Param(name = "event", linkage_name = "event", ty = event_ptr_ty, pointer = Option[bool].some(value = false)))
    return ir.Function(name = j2(info.wait_c_name, "_fn"), linkage_name = info.wait_c_name, params = params.as_span(), return_type = task_ty, body = body.as_span(), entry_point = false, public_export = false, method_receiver_param = false)


## Build a span from a single IR statement.
function span_from_one(stmt: ir.Stmt) -> span[ir.Stmt]:
    var buf = vec.Vec[ir.Stmt].create()
    buf.push(stmt)
    return buf.as_span()


## Build a field list span helper with 1 field.
function sp_field1(f1: ir.Field) -> span[ir.Field]:
    var buf = vec.Vec[ir.Field].create()
    buf.push(f1)
    return buf.as_span()


## Build a field list span helper with 2 fields.
function sp_field2(f1: ir.Field, f2: ir.Field) -> span[ir.Field]:
    var buf = vec.Vec[ir.Field].create()
    buf.push(f1)
    buf.push(f2)
    return buf.as_span()


## Build a field list span helper with 4 fields.
function sp_field4(f1: ir.Field, f2: ir.Field, f3: ir.Field, f4: ir.Field) -> span[ir.Field]:
    var buf = vec.Vec[ir.Field].create()
    buf.push(f1)
    buf.push(f2)
    buf.push(f3)
    buf.push(f4)
    return buf.as_span()


## Build a field list span helper with 6 fields.
function sp_field6(f1: ir.Field, f2: ir.Field, f3: ir.Field, f4: ir.Field, f5: ir.Field, f6: ir.Field) -> span[ir.Field]:
    var buf = vec.Vec[ir.Field].create()
    buf.push(f1)
    buf.push(f2)
    buf.push(f3)
    buf.push(f4)
    buf.push(f5)
    buf.push(f6)
    return buf.as_span()


## Build a field list span helper with 7 fields.
function sp_field7(f1: ir.Field, f2: ir.Field, f3: ir.Field, f4: ir.Field, f5: ir.Field, f6: ir.Field, f7: ir.Field) -> span[ir.Field]:
    var buf = vec.Vec[ir.Field].create()
    buf.push(f1)
    buf.push(f2)
    buf.push(f3)
    buf.push(f4)
    buf.push(f5)
    buf.push(f6)
    buf.push(f7)
    return buf.as_span()


## Lower a str_buffer[N] method call to a C helper call or inline operation.
function lower_str_buffer_method(ctx: ref[LowerCtx], recv: ptr[ir.Expr], recv_ty: types.Type, method_name: str, args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    let char_ty = types.primitive("char")
    let ptr_uint_ty = types.primitive("ptr_uint")
    let void_ty = ctx.void_ty
    let str_ty = types.Type.ty_str
    let bool_ty = ctx.bool_ty
    let cap = str_buffer_capacity_of(recv_ty)
    let data_member = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "data", ty = str_buffer_data_member_type(cap)))
    let data_elem = alloc_expr(ir.Expr.expr_index(receiver = data_member, index = alloc_expr(ir.Expr.expr_integer_literal(value = 0z, ty = ptr_uint_ty)), ty = char_ty))
    let data_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(char_ty))
    let data_addr = alloc_expr(ir.Expr.expr_address_of(expression = data_elem, ty = data_ptr))
    let len_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(ptr_uint_ty))
    let len_addr = alloc_expr(ir.Expr.expr_address_of(
        expression = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "len", ty = ptr_uint_ty)),
        ty = len_ptr_ty,
    ))
    let dirty_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(bool_ty))
    let dirty_addr = alloc_expr(ir.Expr.expr_address_of(
        expression = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "dirty", ty = bool_ty)),
        ty = dirty_ptr_ty,
    ))
    let cap_val = alloc_expr(ir.Expr.expr_integer_literal(value = cap, ty = ptr_uint_ty))
    if method_name == "clear":
        return alloc_expr(ir.Expr.expr_call(callee = "mt_str_buffer_clear", arguments = sp_expr4(data_addr, cap_val, len_addr, dirty_addr), ty = void_ty))
    if method_name == "len":
        return alloc_expr(ir.Expr.expr_call(callee = "mt_str_buffer_len", arguments = sp_expr4(data_addr, cap_val, len_addr, dirty_addr), ty = ptr_uint_ty))
    if method_name == "capacity":
        return alloc_expr(ir.Expr.expr_integer_literal(value = cap, ty = ptr_uint_ty))
    if method_name == "assign" or method_name == "append":
        let helper = if method_name == "assign": "mt_str_buffer_assign" else: "mt_str_buffer_append"
        var helper_args = vec.Vec[ir.Expr].create()
        let lowered = lower_expr(ctx, unsafe: read(args.data + 0).arg_value)
        unsafe:
            helper_args.push(read(lowered))
            helper_args.push(read(data_addr))
            helper_args.push(read(cap_val))
            helper_args.push(read(len_addr))
            helper_args.push(read(dirty_addr))
        return alloc_expr(ir.Expr.expr_call(callee = helper, arguments = helper_args.as_span(), ty = void_ty))
    if method_name == "as_str":
        # The host builds a `str` view over the inline storage: `{data = &data[0],
        # len = mt_str_buffer_len(data, cap, &len, &dirty)}`.
        var len_args = vec.Vec[ir.Expr].create()
        unsafe:
            len_args.push(read(data_addr))
            len_args.push(read(cap_val))
            len_args.push(read(len_addr))
            len_args.push(read(dirty_addr))
        let len_expr = alloc_expr(ir.Expr.expr_call(callee = "mt_str_buffer_len", arguments = len_args.as_span(), ty = ptr_uint_ty))
        var view_fields = vec.Vec[ir.AggregateField].create()
        view_fields.push(ir.AggregateField(name = "data", value = data_addr))
        view_fields.push(ir.AggregateField(name = "len", value = len_expr))
        return alloc_expr(ir.Expr.expr_aggregate_literal(ty = str_ty, fields = view_fields.as_span()))
    if method_name == "assign_format" or method_name == "append_format":
        let helper = if method_name == "assign_format": "mt_str_buffer_assign" else: "mt_str_buffer_append"
        var helper_args = vec.Vec[ir.Expr].create()
        let lowered = lower_expr(ctx, unsafe: read(args.data + 0).arg_value)
        unsafe:
            helper_args.push(read(lowered))
            helper_args.push(read(data_addr))
            helper_args.push(read(cap_val))
            helper_args.push(read(len_addr))
            helper_args.push(read(dirty_addr))
        return alloc_expr(ir.Expr.expr_call(callee = helper, arguments = helper_args.as_span(), ty = void_ty))
    if method_name == "as_cstr":
        # Validate the buffer (via `mt_str_buffer_len`) and hand back its
        # inline storage as a C string.
        var cstr_args = vec.Vec[ir.Expr].create()
        unsafe:
            cstr_args.push(read(data_addr))
            cstr_args.push(read(cap_val))
            cstr_args.push(read(len_addr))
            cstr_args.push(read(dirty_addr))
        return alloc_expr(ir.Expr.expr_call(callee = "mt_str_buffer_as_cstr", arguments = cstr_args.as_span(), ty = types.primitive("cstr")))
    fatal(c"str_buffer lowering: unknown method")


function sp_expr2(e1: ptr[ir.Expr], e2: ptr[ir.Expr]) -> span[ir.Expr]:
    var buf = vec.Vec[ir.Expr].create()
    unsafe:
        buf.push(read(e1))
        buf.push(read(e2))
    return buf.as_span()


function lower_expression_match(ctx: ref[LowerCtx], scrutinee: ptr[ast.Expr], arms: span[ast.MatchExprArm], ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    # A statement-prepared position (an if/while condition, a call argument, a
    # binary operand, an initializer) hoists the host's inline match lowering
    # (`prepare_match_expression_for_inline_lowering`): a zero-initialized
    # `__mt_match_expr_<N>` result local plus the strategy's switch/if chain in
    # the enclosing statement's setup, with the expression replaced by a read of
    # the result.
    if ctx.hoist_mode != HoistMode.hm_off:
        var result_ty = expr_type(ctx, ep)
        if types.is_error(result_ty) or types.type_to_string(result_ty) == "void":
            result_ty = ctx.bool_ty
        let temp = fresh_c_temp_name(ctx, "match_expr")
        let zero_init = alloc_expr(ir.Expr.expr_zero_init(ty = result_ty))
        ctx.hoist_stmts.push(ir.Stmt.stmt_local(name = temp, linkage_name = temp, ty = result_ty, value = zero_init, line = 0, source_path = ""))
        let result_ref = alloc_expr(ir.Expr.expr_name(name = temp, ty = result_ty, pointer = Option[bool].some(value = false)))
        lower_match_expr_to_ref(ctx, ref_of(ctx.hoist_stmts), scrutinee, arms, result_ref)
        return result_ref
    # `expr is Variant.Arm` desugars (in the parser) to a two-arm match
    # expression: [Variant.Arm -> true, _ -> false].  In a lazy region (no
    # statement window) it has a pure boolean-expression equivalent — a
    # discriminant test `scrut.kind == Kind_arm` — so lower it inline without a
    # temp/switch.
    match is_variant_membership_arms(arms):
        Option.some as arm_name:
            let scrut_ty = method_receiver_type(ctx, scrutinee)
            let outer_c = variant_base_c_name(scrut_ty, ctx.module_name)
            let scrut_expr = lower_expr(ctx, scrutinee)
            let int_ty = types.primitive("int")
            let kind_expr = alloc_expr(ir.Expr.expr_member(receiver = scrut_expr, member = "kind", ty = int_ty))
            let kind_const = alloc_expr(ir.Expr.expr_name(name = variant_kind_const_name(outer_c, arm_name.value), ty = int_ty, pointer = Option[bool].some(value = false)))
            return alloc_expr(ir.Expr.expr_binary(operator = "==", left = kind_expr, right = kind_const, ty = ctx.bool_ty))
        Option.none:
            pass
    # A genuine multi-arm match expression in a non-return position is not
    # supported inline (needs statement hoisting); `return match` is handled at
    # the statement boundary in `lower_stmt`.  Fall back to a placeholder.
    let result_ty2 = expr_type(ctx, ep)
    return alloc_expr(ir.Expr.expr_name(name = "match_expr", ty = result_ty2, pointer = Option[bool].some(value = false)))


## Detect the `is`-operator desugaring shape: exactly two arms, where the first
## has a variant-arm pattern with value `true` and the second is a wildcard
## (`pattern == null`) with value `false`.  Returns the arm name to test against.
function is_variant_membership_arms(arms: span[ast.MatchExprArm]) -> Option[str]:
    if arms.len != 2:
        return Option[str].none
    var first: ast.MatchExprArm
    var second: ast.MatchExprArm
    unsafe:
        first = read(arms.data + 0)
        second = read(arms.data + 1)
    if first.pattern == null or second.pattern != null:
        return Option[str].none
    if not expr_is_bool_literal(first.value, true) or not expr_is_bool_literal(second.value, false):
        return Option[str].none
    let pat = first.pattern else:
        return Option[str].none
    return variant_match_arm_name_from_pattern(pat)


## True when `ep` is a boolean literal with the given value.
function expr_is_bool_literal(ep: ptr[ast.Expr], want: bool) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_bool_literal as b:
                return b.value == want
            _:
                return false


function sp_expr3(e1: ptr[ir.Expr], e2: ptr[ir.Expr], e3: ptr[ir.Expr]) -> span[ir.Expr]:
    var buf = vec.Vec[ir.Expr].create()
    unsafe:
        buf.push(read(e1))
        buf.push(read(e2))
        buf.push(read(e3))
    return buf.as_span()


function sp_expr4(e1: ptr[ir.Expr], e2: ptr[ir.Expr], e3: ptr[ir.Expr], e4: ptr[ir.Expr]) -> span[ir.Expr]:
    var buf = vec.Vec[ir.Expr].create()
    unsafe:
        buf.push(read(e1))
        buf.push(read(e2))
        buf.push(read(e3))
        buf.push(read(e4))
    return buf.as_span()


function is_dyn_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_dyn:
            return true
        _:
            return false


## Fill in omitted default arguments for a call whose callee declaration is
## known.  Positional omissions append trailing defaults; named arguments are
## placed by parameter name and the remaining slots are filled with defaults.
## A required parameter with no argument and no default terminates the fill
## (the analyzer reports the arity error before lowering).
function expand_default_args(params: span[ast.Param], args: span[ast.Argument]) -> span[ast.Argument]:
    var has_defaults = false
    var pi: ptr_uint = 0
    while pi < params.len:
        if unsafe: read(params.data + pi).default_value != null:
            has_defaults = true
        pi += 1
    if not has_defaults:
        return args

    var any_named = false
    var ai: ptr_uint = 0
    while ai < args.len:
        match unsafe: read(args.data + ai).arg_name:
            Option.some:
                any_named = true
            Option.none:
                pass
        ai += 1

    if not any_named:
        if args.len >= params.len:
            return args
        var expanded = vec.Vec[ast.Argument].create()
        var ei: ptr_uint = 0
        while ei < args.len:
            unsafe:
                expanded.push(read(args.data + ei))
            ei += 1
        while expanded.len() < params.len:
            unsafe:
                let p = read(params.data + expanded.len())
                let dv = p.default_value
                if dv == null:
                    break
                expanded.push(ast.Argument(arg_name = Option[str].none, arg_value = dv))
        return expanded.as_span()

    var slots = vec.Vec[ast.Argument].create()
    var filled = vec.Vec[bool].create()
    var si: ptr_uint = 0
    while si < params.len:
        slots.push(zero[ast.Argument])
        filled.push(false)
        si += 1

    var next_positional: ptr_uint = 0
    var ai2: ptr_uint = 0
    while ai2 < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + ai2)
        match arg.arg_name:
            Option.some as nm:
                var fi: ptr_uint = 0
                while fi < params.len:
                    if unsafe: read(params.data + fi).name == nm.value:
                        place_default_arg_slot(ref_of(slots), ref_of(filled), fi, arg)
                        break
                    fi += 1
            Option.none:
                while next_positional < params.len:
                    if not default_arg_slot_filled(ref_of(filled), next_positional):
                        place_default_arg_slot(ref_of(slots), ref_of(filled), next_positional, arg)
                        next_positional += 1
                        break
                    next_positional += 1
        ai2 += 1

    var result = vec.Vec[ast.Argument].create()
    var oi: ptr_uint = 0
    while oi < params.len:
        if default_arg_slot_filled(ref_of(filled), oi):
            unsafe:
                let dest = slots.get(oi)
                if dest != null:
                    result.push(read(dest))
        else:
            unsafe:
                let p = read(params.data + oi)
                let dv = p.default_value
                if dv == null:
                    break
                result.push(ast.Argument(arg_name = Option[str].none, arg_value = dv))
        oi += 1
    return result.as_span()


function default_arg_slot_filled(filled: ref[vec.Vec[bool]], index: ptr_uint) -> bool:
    let dest = filled.get(index)
    if dest == null:
        return false
    unsafe:
        return read(dest)


function place_default_arg_slot(slots: ref[vec.Vec[ast.Argument]], filled: ref[vec.Vec[bool]], index: ptr_uint, arg: ast.Argument) -> void:
    let dest = slots.get(index)
    if dest != null:
        unsafe:
            read(dest) = arg
    let fdest = filled.get(index)
    if fdest != null:
        unsafe:
            read(fdest) = true


function lower_plain_call(ctx: ref[LowerCtx], c_name: str, args: span[ast.Argument], call_ep: ptr[ast.Expr], override_ty: ptr[types.Type]?) -> ptr[ir.Expr]:
    return lower_plain_call_sig(ctx, c_name, args, call_ep, override_ty, Option[analyzer.FnSig].none)


## Like `lower_plain_call` but with the callee's signature available, so a value
## argument passed to a `ref[T]` parameter is implicitly borrowed (`&arg`) —
## mirroring the call-site borrow rule the analyzer accepts.  The signature is
## optional; when absent, arguments are lowered verbatim.
function lower_plain_call_sig(ctx: ref[LowerCtx], c_name: str, args: span[ast.Argument], call_ep: ptr[ast.Expr], override_ty: ptr[types.Type]?, sig: Option[analyzer.FnSig]) -> ptr[ir.Expr]:
    return lower_call_with_callee(ctx, c_name, Option[ptr[ir.Expr]].none, args, call_ep, override_ty, sig)


## Lower a call to a monomorphized function with the specialized function
## available, so a bare literal argument takes its parameter's type — the host's
## `lower_contextual_expression` on every call argument.  Mirrors the
## monomorphized-method path's `coerce_literal_to_mono_param`.
function lower_plain_call_spec(ctx: ref[LowerCtx], c_name: str, args: span[ast.Argument], call_ep: ptr[ast.Expr], override_ty: ptr[types.Type]?, spec_fn: ptr[ir.Function]?) -> ptr[ir.Expr]:
    var ir_args = vec.Vec[ir.Expr].create()
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        var lowered = lower_expr(ctx, arg.arg_value)
        lowered = coerce_literal_to_mono_param(ctx, spec_fn, i, arg.arg_value, lowered)
        # The specialized function's parameter carries the concrete type, so a
        # `ref[T]` parameter borrows a plain value argument (or passes an
        # existing ref through) exactly like a direct call's implicit bridge.
        if spec_fn != null:
            let sf = unsafe: read(spec_fn)
            if i < sf.params.len:
                let pty = unsafe: read(sf.params.data + i).ty
                lowered = coerce_arg_to_ref_bridge(pty, lowered)
        unsafe:
            ir_args.push(read(lowered))
        i += 1
    var ret_ty: types.Type
    let ov = override_ty
    if ov != null:
        unsafe:
            ret_ty = read(ov)
    else:
        ret_ty = expr_type(ctx, call_ep)
    return alloc_expr(ir.Expr.expr_call(callee = c_name, arguments = ir_args.as_span(), ty = ret_ty))


## Lower a call whose callee is an expression rather than a bare C name: a
## guard-projected binding that holds a proc or a function pointer, whose callee
## is a member chain.
function lower_call_with_callee_expr(ctx: ref[LowerCtx], callee: ptr[ir.Expr], args: span[ast.Argument], call_ep: ptr[ast.Expr], override_ty: ptr[types.Type]?, sig: Option[analyzer.FnSig]) -> ptr[ir.Expr]:
    return lower_call_with_callee(ctx, "", Option[ptr[ir.Expr]].some(value = callee), args, call_ep, override_ty, sig)


function lower_call_with_callee(ctx: ref[LowerCtx], c_name: str, callee_expr: Option[ptr[ir.Expr]], args: span[ast.Argument], call_ep: ptr[ast.Expr], override_ty: ptr[types.Type]?, sig: Option[analyzer.FnSig]) -> ptr[ir.Expr]:

    var ir_args = vec.Vec[ir.Expr].create()
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        var lowered: ptr[ir.Expr]
        match task_root_proc_bridge_proc_type(ctx, sig, i, arg.arg_value):
            Option.some as bridge_proc:
                lowered = lower_task_expression_as_root_proc(ctx, arg.arg_value, bridge_proc.value)
            Option.none:
                # A float/double parameter threads its expected type into an
                # arithmetic binary argument (the host's
                # `lower_contextual_expression` with the parameter as the
                # expected type): `math.cos((i + 1) / 51.45)` takes a double
                # literal and casts the int sub-expression.
                var contextual = false
                match sig:
                    Option.some as s:
                        if i < s.value.params.len:
                            let pty = unsafe: read(s.value.params.data + i).ty
                            if types.is_float_type(pty) and is_contextual_binary_expr(arg.arg_value):
                                lowered = lower_contextual_binary(ctx, arg.arg_value, pty)
                                contextual = true
                    Option.none:
                        pass
                if not contextual:
                    lowered = lower_expr(ctx, arg.arg_value)
                lowered = coerce_arg_to_ref_param(sig, i, lowered)
                lowered = coerce_arg_to_span_param(sig, i, lowered)
                lowered = coerce_fn_arg_to_proc(ctx, sig, i, lowered, arg.arg_value)
                match sig:
                    Option.some as s:
                        lowered = coerce_literal_to_param_type(ctx, s.value.params, i, arg.arg_value, lowered)
                    Option.none:
                        pass
        unsafe:
            ir_args.push(read(lowered))
        i += 1
    var ret_ty: types.Type
    let ov = override_ty
    if ov != null:
        unsafe:
            ret_ty = read(ov)
    else:
        ret_ty = expr_type(ctx, call_ep)
    match callee_expr:
        Option.some as c:
            return alloc_expr(ir.Expr.expr_call_indirect(callee = c.value, arguments = ir_args.as_span(), ty = ret_ty))
        Option.none:
            pass
    return alloc_expr(ir.Expr.expr_call(callee = c_name, arguments = ir_args.as_span(), ty = ret_ty))


## Re-type a bare `null` literal against `context_ty` when the literal's own type
## is not already nullable (the analyzer records `void` for a bare `null`).
## Mirrors the host's `infer_null_literal_type` taking the expected type; a typed
## `null[T]` keeps its `Types::Null :target_type T` (the host returns it before
## consulting the expected type).
function null_literal_to_context_type(arg_ast: ptr[ast.Expr], context_ty: types.Type, value: ptr[ir.Expr]) -> ptr[ir.Expr]:
    var is_bare_null = false
    unsafe:
        match read(arg_ast):
            ast.Expr.expr_null_literal as nl:
                is_bare_null = nl.target_type == null
            _:
                pass
    if not is_bare_null:
        return value
    if types.is_nullable_type(ir_expr_type(value)):
        return value
    # The host's `IR::NullLiteral.new(type:)` takes the *expected* type verbatim
    # (`expressions.rb:1377`), even when it is a bare pointer: an assignment to a
    # guard-narrowed `ptr[T]?` target carries the visible `ptr[T]` on the literal.
    # Only a missing context (`void`/error) keeps the lowered literal.
    if types.is_void(context_ty) or types.is_error(context_ty):
        return value
    return alloc_expr(ir.Expr.expr_null_literal(ty = context_ty))


## Re-type a bare literal value against its context type — the host's
## `lower_contextual_expression` with the expected type (`lower_contextual_
## expression` is used for assignment values and for every call argument).
## Shared by the assignment arms and the call-argument coercion, so `i = 1` /
## `read(header - 1) = 0` / `create_aligned(x, 1)` emit `ptr_uint` literals for
## a `ptr_uint` context.  The compile-time numeric compatibility cast is applied
## here too (a folded constant that fits the context), with int→float and the
## external-numeric arm left to the declared-type sites.
function literal_value_to_context_type(ctx: ref[LowerCtx], value_ast: ptr[ast.Expr], context_ty: types.Type, value: ptr[ir.Expr]) -> ptr[ir.Expr]:
    var result = value
    unsafe:
        match read(value_ast):
            ast.Expr.expr_integer_literal:
                result = int_literal_to_context_type(value_ast, context_ty, result)
            ast.Expr.expr_float_literal:
                result = float_literal_to_context_type(value_ast, context_ty, result)
            ast.Expr.expr_unary_op:
                # A signed literal (`-1.0`, `-128`) is a literal expression; the
                # context type propagates through the unary to its operand.
                result = int_literal_to_context_type(value_ast, context_ty, result)
                result = float_literal_to_context_type(value_ast, context_ty, result)
            ast.Expr.expr_string_literal:
                result = string_literal_to_context_type(value_ast, context_ty, result)
            ast.Expr.expr_null_literal:
                result = null_literal_to_context_type(value_ast, context_ty, result)
            ast.Expr.expr_if:
                result = conditional_value_to_context_type(ctx, value_ast, context_ty, result)
            _:
                pass
    return contextual_numeric_cast(ctx, value_ast, result, context_ty, false, false)


## A conditional in a context position takes the host's
## `lower_contextual_expression` expected type on both branches, so
## `int_cell(if b: 1 else: 0)` emits `long` literals for a `long` parameter.
## Only numeric contexts recurse; other conditionals keep their inferred type.
function conditional_value_to_context_type(ctx: ref[LowerCtx], value_ast: ptr[ast.Expr], context_ty: types.Type, value: ptr[ir.Expr]) -> ptr[ir.Expr]:
    if not types.is_integer_type(context_ty) and not types.is_float_type(context_ty):
        return value
    unsafe:
        match read(value_ast):
            ast.Expr.expr_if as ie:
                match read(value):
                    ir.Expr.expr_conditional as cond:
                        let then_ir = literal_value_to_context_type(ctx, ie.then_expr, context_ty, cond.then_expression)
                        let else_ir = literal_value_to_context_type(ctx, ie.else_expr, context_ty, cond.else_expression)
                        return alloc_expr(ir.Expr.expr_conditional(condition = cond.condition, then_expression = then_ir, else_expression = else_ir, ty = context_ty))
                    _:
                        pass
            _:
                pass
    return value


## The declared-type sites' contextual conversion: the literal retyping above,
## then the host's int→float arm (only where the host passes
## `contextual_int_to_float`, i.e. a declared float local/assignment/return) and
## the external-numeric arm (an assignment through a raw-module field).
function contextual_value_to_type(
    ctx: ref[LowerCtx],
    value_ast: ptr[ast.Expr],
    context_ty: types.Type,
    value: ptr[ir.Expr],
    allow_int_to_float: bool,
    external_numeric: bool,
) -> ptr[ir.Expr]:
    let typed = literal_value_to_context_type(ctx, value_ast, context_ty, value)
    return contextual_numeric_cast(ctx, value_ast, typed, context_ty, allow_int_to_float, external_numeric)


## The host's `contextual_numeric_compatibility?` + `cast_expression` step:
##  - a compile-time constant whose numeric value fits the context type,
##  - an integer-like value in a `char` context,
##  - an integer value in a float/double context when the host's
##    `contextual_int_to_float` flag is set,
##  - a lossless external numeric pair when the assignment target is a
##    raw-module field (`external_numeric`).
## An enum/flags *actual* type is excluded from the constant arm (the host's
## `return false if actual_type.is_a?(Types::EnumBase)`).
function contextual_numeric_cast(
    ctx: ref[LowerCtx],
    value_ast: ptr[ast.Expr],
    value: ptr[ir.Expr],
    context_ty: types.Type,
    allow_int_to_float: bool,
    external_numeric: bool,
) -> ptr[ir.Expr]:
    let actual_ty = ir_expr_type(value)
    if types.type_equals(actual_ty, context_ty):
        return value
    var context_name = ""
    match context_ty:
        types.Type.ty_primitive as p:
            context_name = p.name
        _:
            return value
    if context_name == "char":
        if is_integer_like_value_type(ctx, actual_ty):
            return cast_to_type(value, context_ty)
        return value
    if not types.is_numeric_name(context_name):
        return value
    if (context_name == "float" or context_name == "double") and allow_int_to_float:
        if is_integer_like_value_type(ctx, actual_ty):
            return cast_to_type(value, context_ty)
    if not is_enum_value_type(ctx, actual_ty):
        unsafe:
            match read(value_ast):
                ast.Expr.expr_float_literal:
                    # The literal pass already typed it; a float literal is not
                    # an exact integer constant for this arm.
                    pass
                _:
                    match try_evaluate_const_expr(ctx, value_ast):
                        Option.some as cv:
                            match cv.value:
                                ConstValue.cv_int as iv:
                                    if numeric_int_fits_context(iv.value, context_ty):
                                        return cast_to_type(value, context_ty)
                                _:
                                    pass
                        Option.none:
                            pass
    if external_numeric and external_numeric_compatible(actual_ty, context_ty):
        return cast_to_type(value, context_ty)
    return value


## True for an integer primitive or an enum/flags value (whose backing is an
## integer) — the host's `integer_like_char_source_type?`.
function is_integer_like_value_type(ctx: ref[LowerCtx], t: types.Type) -> bool:
    if types.is_integer_type(t):
        return true
    let backing = enum_backing_or_self(ctx, t)
    return types.is_integer_type(backing)


## True when the value type is an enum/flags nominal (the host's `EnumBase`).
function is_enum_value_type(ctx: ref[LowerCtx], t: types.Type) -> bool:
    let backing = enum_backing_or_self(ctx, t)
    return not types.type_equals(backing, t)


## A compile-time integer constant fits a numeric context — the host's
## `numeric_constant_fits_type?` for an integer value: the integer range for an
## integer context, `|value| <= 2^24` for float and `<= 2^53` for double.
function numeric_int_fits_context(value: long, context_ty: types.Type) -> bool:
    if types.is_integer_type(context_ty):
        return int_value_fits_type(value, context_ty)
    let magnitude = if value < 0: -value else: value
    match context_ty:
        types.Type.ty_primitive as p:
            if p.name == "float":
                return magnitude <= 16777216l
            if p.name == "double":
                return magnitude <= 9007199254740992l
        _:
            pass
    return false


## The host's `lossless_external_integer_compatibility?` / float-width arm of
## `external_numeric_compatibility?`.
function external_numeric_compatible(actual_ty: types.Type, expected_ty: types.Type) -> bool:
    match actual_ty:
        types.Type.ty_primitive as a:
            match expected_ty:
                types.Type.ty_primitive as e:
                    if types.is_integer_type(actual_ty) and types.is_integer_type(expected_ty):
                        let a_signed = types.is_signed_integer_name(a.name)
                        let e_signed = types.is_signed_integer_name(e.name)
                        let a_width = types.integer_width(a.name)
                        let e_width = types.integer_width(e.name)
                        if a_signed == e_signed:
                            return e_width >= a_width
                        if a_signed:
                            return false
                        return e_signed and e_width > a_width
                    if types.is_float_type(actual_ty) and types.is_float_type(expected_ty):
                        return float_width_name(e.name) >= float_width_name(a.name)
                _:
                    pass
        _:
            pass
    return false


function float_width_name(name: str) -> int:
    if name == "double":
        return 64
    return 32


## True when an assignment target is a member of a raw-module (`std.c.*`) type —
## the host's `external_numeric_assignment_target?`.
function external_numeric_assignment_target(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_member_access as ma:
                return is_external_module_type(expr_type(ctx, ma.receiver))
            _:
                return false


function is_external_module_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_imported as im:
            return im.module_name.starts_with("std.c.")
        types.Type.ty_named as n:
            return n.module_name.starts_with("std.c.")
        _:
            return false


## True when the initializer/value is a foreign wrapper call: the host's local
## and assignment foreign-call branches emit the call's value directly, so the
## return-site/local-site `contextual_int_to_float` arm does not run for them
## (`float size = GetScreenHeight()` keeps the int call).
function is_foreign_call_initializer(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_call as call:
                return foreign_wrapper_call_return_type(ctx, call.callee).is_some()
            _:
                return false


## Re-type a call argument's bare literal against the parameter's type — the
## host lowers every call argument with the parameter as the expected type
## (`prepare_expression_with_cleanups`), so `create_aligned(x, 1)` with a
## `ptr_uint` parameter emits a `ptr_uint` literal, not an `int` one.  A
## variadic argument beyond the fixed parameters has no expected type.
function coerce_literal_to_param_type(ctx: ref[LowerCtx], params: span[analyzer.ParamEntry], index: ptr_uint, arg_ast: ptr[ast.Expr], value: ptr[ir.Expr]) -> ptr[ir.Expr]:
    if index < params.len:
        unsafe:
            return literal_value_to_context_type(ctx, arg_ast, read(params.data + index).ty, value)
    return value


## True when `ep` (looking through `unsafe:`) is an arithmetic binary the host's
## `propagating_expected_type` threads a numeric expected type into.
function is_contextual_binary_expr(ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_binary_op as b:
                return is_pure_arithmetic_operator(b.operator)
            ast.Expr.expr_unsafe as u:
                return is_contextual_binary_expr(u.expression)
            _:
                return false


## A binary operand's expected type only steers literal inference and a
## conditional's branch typing (the host's `lower_expression(... expected_type:)`
## calls inside its BinaryOp arm) — it does not apply the
## `lower_contextual_expression` numeric-compatibility cast.
function operand_value_to_context_type(ctx: ref[LowerCtx], value_ast: ptr[ast.Expr], context_ty: types.Type, value: ptr[ir.Expr]) -> ptr[ir.Expr]:
    var result = value
    unsafe:
        match read(value_ast):
            ast.Expr.expr_integer_literal:
                result = int_literal_to_context_type(value_ast, context_ty, result)
            ast.Expr.expr_float_literal:
                result = float_literal_to_context_type(value_ast, context_ty, result)
            ast.Expr.expr_unary_op:
                result = int_literal_to_context_type(value_ast, context_ty, result)
                result = float_literal_to_context_type(value_ast, context_ty, result)
            ast.Expr.expr_if:
                result = conditional_value_to_context_type(ctx, value_ast, context_ty, result)
            _:
                pass
    return result


## Lower one operand of a contextual binary with the host's expected type: a
## nested arithmetic binary recurses, any other expression takes the literal /
## conditional retyping above.
function lower_contextual_operand(ctx: ref[LowerCtx], ep: ptr[ast.Expr], expected: Option[types.Type]) -> ptr[ir.Expr]:
    let exp = expected else:
        return lower_expr(ctx, ep)
    if is_contextual_binary_expr(ep):
        return lower_contextual_binary(ctx, ep, exp)
    let value = lower_expr(ctx, ep)
    return operand_value_to_context_type(ctx, ep, exp, value)


## The host's `lower_expression(expression, expected_type:)` BinaryOp arm for an
## arithmetic binary in a numeric context: both operands see the expected type
## (a bare float literal becomes the context width, an int expression stays
## int), the promoted operand type casts each side, and the result carries the
## common numeric type.  Used for call arguments, where the host passes the
## parameter's type as the argument's expected type.
function lower_contextual_binary(ctx: ref[LowerCtx], ep: ptr[ast.Expr], expected: types.Type) -> ptr[ir.Expr]:
    unsafe:
        match read(ep):
            ast.Expr.expr_unsafe as u:
                return lower_contextual_binary(ctx, u.expression, expected)
            ast.Expr.expr_binary_op as bin:
                var propagated = Option[types.Type].none
                if types.is_numeric(expected):
                    propagated = Option[types.Type].some(value = expected)
                var left = lower_contextual_operand(ctx, bin.left, propagated)
                var right = lower_contextual_operand(ctx, bin.right, propagated)
                var left_ty = ir_expr_type(left)
                var right_ty = ir_expr_type(right)
                # The host's `harmonize_binary_float_literal_types`: a bare float
                # literal takes a float peer's width.
                if is_bare_float_literal(bin.left) and types.is_float_type(right_ty):
                    left = float_literal_to_context_type(bin.left, right_ty, left)
                    left_ty = ir_expr_type(left)
                if is_bare_float_literal(bin.right) and types.is_float_type(left_ty):
                    right = float_literal_to_context_type(bin.right, left_ty, right)
                    right_ty = ir_expr_type(right)
                match promoted_binary_operand_type(bin.operator, left_ty, right_ty):
                    Option.some as op_ty:
                        left = cast_to_type(left, op_ty.value)
                        right = cast_to_type(right, op_ty.value)
                        return alloc_expr(ir.Expr.expr_binary(operator = bin.operator, left = left, right = right, ty = op_ty.value))
                    Option.none:
                        return alloc_expr(ir.Expr.expr_binary(operator = bin.operator, left = left, right = right, ty = left_ty))
            _:
                return lower_expr(ctx, ep)


## Re-type an integer literal whose value fits `context_ty` (a numeric primitive)
## to that type, preserving the literal value.  A non-literal, a too-wide value,
## or a non-numeric context returns `value` unchanged.  Mirrors the host's
## contextual numeric literal inference.
function int_literal_to_context_type(arg_ast: ptr[ast.Expr], context_ty: types.Type, value: ptr[ir.Expr]) -> ptr[ir.Expr]:
    if not types.is_integer_type(context_ty):
        return value
    # A signed literal (`-128`, `+3`) is a literal expression: the host
    # propagates the expected type through the unary to its literal operand, so
    # both the operand and the unary node carry the context type
    # (`value >= -128` against a `long` peer keeps a long literal, no cast).
    unsafe:
        match read(arg_ast):
            ast.Expr.expr_unary_op as un:
                if un.operator == "-" or un.operator == "+":
                    match read(un.operand):
                        ast.Expr.expr_integer_literal as lit:
                            # A negative value has no unsigned representation.
                            if un.operator == "-" and lit.value != 0 and types.is_unsigned_integer_type(context_ty):
                                return value
                            match read(value):
                                ir.Expr.expr_unary as uv:
                                    let inner = int_literal_to_context_type(un.operand, context_ty, uv.operand)
                                    if inner != uv.operand:
                                        return alloc_expr(ir.Expr.expr_unary(operator = un.operator, operand = inner, ty = context_ty))
                                    return value
                                _:
                                    return value
                        _:
                            return value
            _:
                pass
    var literal_value: long
    var literal_lexeme: str = ""
    unsafe:
        match read(arg_ast):
            ast.Expr.expr_integer_literal as lit:
                literal_value = long<-lit.value
                literal_lexeme = lit.lexeme
            _:
                return value
    # The lowering's literal typing ignores an explicit integer suffix when an
    # expected type exists: the host's `infer_expression_type` checks
    # `expected_type` before consulting the sema cache, so `1u` in a `ulong`
    # position is a `ulong` literal and `0z` in a `long` field a `long` one.
    # (The *analyzer* keeps the suffix type — `infer_integer_literal` — which is
    # why a suffixed literal still participates as its own type in sema.)
    if not int_value_fits_type(literal_value, context_ty):
        return value
    return alloc_expr(integer_literal_expr(literal_lexeme, literal_value, context_ty))


## A float literal with no explicit `f`/`d` suffix: its type is contextual (a
## `float` peer keeps it a float, otherwise the default `float` stands); an
## explicit suffix keeps its own type, mirroring the host's
## `infer_expression_type` FloatLiteral arm.
function is_bare_float_literal(ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_float_literal as lit:
                return not (lit.lexeme.ends_with("f") or lit.lexeme.ends_with("d"))
            # A signed literal (`-1.0`) is a literal expression: the context
            # type propagates through the unary to its float operand.
            ast.Expr.expr_unary_op as un:
                if un.operator == "-" or un.operator == "+":
                    return is_bare_float_literal(un.operand)
                return false
            _:
                return false


## Re-type a float literal against a `float`/`double` context, mirroring the
## host's contextual numeric literal inference: `0.2` in a `double` position is
## a double literal (the emitted C carries no `f` suffix), in a `float` position
## it stays a float literal.
function float_literal_to_context_type(arg_ast: ptr[ast.Expr], context_ty: types.Type, value: ptr[ir.Expr]) -> ptr[ir.Expr]:
    var is_float_ctx = false
    match context_ty:
        types.Type.ty_primitive as p:
            if p.name == "float" or p.name == "double":
                is_float_ctx = true
        _:
            pass
    if not is_float_ctx:
        return value
    unsafe:
        match read(arg_ast):
            ast.Expr.expr_float_literal as lit:
                return alloc_expr(ir.Expr.expr_float_literal(value = lit.value, ty = context_ty))
            ast.Expr.expr_unary_op as un:
                if un.operator == "-" or un.operator == "+":
                    if is_bare_float_literal(un.operand):
                        match read(value):
                            ir.Expr.expr_unary as uv:
                                let inner = float_literal_to_context_type(un.operand, context_ty, uv.operand)
                                if inner != uv.operand:
                                    return alloc_expr(ir.Expr.expr_unary(operator = un.operator, operand = inner, ty = context_ty))
                                return value
                            _:
                                return value
                return value
            _:
                return value


## Re-type a bare string literal in a `cstr` position as a cstring literal,
## mirroring the host's `lower_compile_time_literal`: `var Title: cstr = "Hello"`
## emits the bare C string rather than the `mt_str` aggregate (which the C
## compiler rejects for a `const char*` slot).
function string_literal_to_context_type(arg_ast: ptr[ast.Expr], context_ty: types.Type, value: ptr[ir.Expr]) -> ptr[ir.Expr]:
    var is_cstr_context = false
    match context_ty:
        types.Type.ty_primitive as p:
            if p.name == "cstr":
                is_cstr_context = true
        _:
            pass
    if not is_cstr_context:
        return value
    unsafe:
        match read(arg_ast):
            ast.Expr.expr_string_literal as lit:
                if lit.is_cstring:
                    return value
                return alloc_expr(ir.Expr.expr_string_literal(value = lit.value, ty = context_ty, cstring = true))
            _:
                return value


## The IR node for an integer literal read from the AST, mirroring the host's
## parse: Ruby's lexer stores an unbounded Integer, so a magnitude that does not
## fit a signed `long` (`18446744073709551615`, `0xFFFFFFFFFFFFFFFF`) stays
## positive and renders in the unsigned domain.  A signed `long` can only hold
## the same bit pattern, so those literals get their own node
## (`expr_unsigned_integer_literal`).  Everything else — including a folded
## arithmetic result such as `~0`, which the host folds to `-1` for the same
## `ptr_uint` type — stays a signed `expr_integer_literal`: the distinction is
## provenance, not type or value.
function integer_literal_expr(lexeme: str, value: long, ty: types.Type) -> ir.Expr:
    if value < 0 and not lexeme.starts_with("-"):
        return ir.Expr.expr_unsigned_integer_literal(value = lparse.parse_int_literal_unsigned(lexeme), ty = ty)
    return ir.Expr.expr_integer_literal(value = value, ty = ty)


## True when the (non-negative) literal value fits the integer primitive `t`.
function int_value_fits_type(v: long, t: types.Type) -> bool:
    match t:
        types.Type.ty_primitive as p:
            match p.name:
                "byte":
                    return v <= 127
                "ubyte":
                    return v <= 255
                "short":
                    return v <= 32767
                "ushort":
                    return v <= 65535
                "int":
                    return v <= 2147483647
                "uint":
                    return v <= 4294967295
                _:
                    return true
        _:
            return true


## Coerce an `array[T, N]` argument passed to a `span[T]` parameter into a span
## aggregate `{ data = &arr[0], len = N }`, mirroring the analyzer's permitted
## array-to-span boundary conversion.
function coerce_arg_to_span_param(sig: Option[analyzer.FnSig], index: ptr_uint, arg: ptr[ir.Expr]) -> ptr[ir.Expr]:
    match sig:
        Option.some as s:
            if index >= s.value.params.len:
                return arg
            var param: analyzer.ParamEntry
            unsafe:
                param = read(s.value.params.data + index)
            if not is_span_type(param.ty):
                return arg
            let arg_ty = ir_expr_type(arg)
            if is_array_type(arg_ty):
                return array_value_to_span(arg, arg_ty, param.ty)
            return arg
        Option.none:
            return arg


## Apply the implicit ref-argument bridge to the callee signature's parameter
## `index` (the host's `implicit_ref_argument_bridge?` + `ref_of` lowering).
function coerce_arg_to_ref_param(sig: Option[analyzer.FnSig], index: ptr_uint, arg: ptr[ir.Expr]) -> ptr[ir.Expr]:
    match sig:
        Option.some as s:
            if index >= s.value.params.len:
                return arg
            var param: analyzer.ParamEntry
            unsafe:
                param = read(s.value.params.data + index)
            return coerce_arg_to_ref_bridge(param.ty, arg)
        Option.none:
            return arg


## The host's `implicit_ref_argument_bridge?` with the `ref_of` lowering: for a
## `ref[T]` parameter and an argument whose value type is `T`, a pointer-lowered
## value (a `this` receiver or a pointer Name) is cast to `ref[T]` and a
## `*p` operand casts its pointer; a plain addressable value is borrowed
## (`&value`).  Any other argument shape is left unchanged.
function coerce_arg_to_ref_bridge(param_ty: types.Type, arg: ptr[ir.Expr]) -> ptr[ir.Expr]:
    if not types.is_ref_type(param_ty):
        return arg
    let base_ty = types.pointer_element(param_ty)
    if not types.type_equals(ir_expr_type(arg), base_ty):
        return arg
    unsafe:
        match read(arg):
            ir.Expr.expr_name as nm:
                if nm.pointer.unwrap_or(false):
                    return alloc_expr(ir.Expr.expr_cast(target_type = param_ty, expression = arg, ty = param_ty))
            ir.Expr.expr_unary as un:
                if un.operator == "*":
                    if types.type_equals(ir_expr_type(un.operand), param_ty):
                        return un.operand
                    return alloc_expr(ir.Expr.expr_cast(target_type = param_ty, expression = un.operand, ty = param_ty))
            _:
                pass
    if ir_is_addressable(arg):
        return alloc_expr(ir.Expr.expr_address_of(expression = arg, ty = param_ty))
    return arg


## Coerce a bare function name argument to a proc struct when the
## corresponding parameter expects a proc type.  Mirrors the implicit
## fn→proc wrapping the analyzer accepts at call sites.
function coerce_fn_arg_to_proc(ctx: ref[LowerCtx], sig: Option[analyzer.FnSig], index: ptr_uint, lowered: ptr[ir.Expr], arg_ast: ptr[ast.Expr]) -> ptr[ir.Expr]:
    match sig:
        Option.some as s:
            if index >= s.value.params.len:
                return lowered
            var param_ty: types.Type
            unsafe:
                let param = read(s.value.params.data + index)
                param_ty = param.ty
            if not is_proc_type(param_ty):
                return lowered
            # Check if the argument is a bare function identifier.
            unsafe:
                match read(arg_ast):
                    ast.Expr.expr_identifier as id:
                        if ctx.function_returns.contains(id.name) or ctx.analysis.functions.contains(id.name):
                            let fn_c_name = naming.qualified_c_name(ctx.module_name, id.name)
                            return lower_fn_to_proc(ctx, fn_c_name, param_ty, "")
                    _:
                        pass
            return lowered
        Option.none:
            return lowered


## True when `t` is a `Task[X]`.
function is_task_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_generic as g:
            return g.name == "Task" and g.args.len == 1
        _:
            return false


## The `Task[X]` type of a task-root proc parameter (`proc() -> Task[X]`), or none
## when `param_ty` is not one.
function task_root_proc_task_type(param_ty: types.Type) -> Option[types.Type]:
    match param_ty:
        types.Type.ty_function as fnt:
            if fnt.is_proc and fnt.params.len == 0:
                let ret = unsafe: read(fnt.return_type)
                if is_task_type(ret):
                    return Option[types.Type].some(value = ret)
            return Option[types.Type].none
        _:
            return Option[types.Type].none


## The task-root-proc bridge: a `Task[X]` argument passed to a `proc() -> Task[X]`
## parameter is wrapped in a zero-parameter thunk the async runtime invokes, so the
## task is created when `wait`/`run` drives it rather than at the call site.
## Returns the parameter's proc type when the bridge applies.  Mirrors the host's
## `direct_task_to_proc_argument_compatible?` + `wrap_task_expression_in_root_proc`.
function task_root_proc_bridge_proc_type(ctx: ref[LowerCtx], sig: Option[analyzer.FnSig], index: ptr_uint, arg_ast: ptr[ast.Expr]) -> Option[types.Type]:
    match sig:
        Option.some as s:
            if index >= s.value.params.len:
                return Option[types.Type].none
            var param_ty: types.Type
            unsafe:
                param_ty = read(s.value.params.data + index).ty
            let task_ty = task_root_proc_task_type(param_ty) else:
                return Option[types.Type].none
            if types.type_equals(expr_type(ctx, arg_ast), task_ty):
                return Option[types.Type].some(value = param_ty)
            return Option[types.Type].none
        Option.none:
            return Option[types.Type].none


## Wrap a `Task[X]` expression in the zero-parameter root proc `proc() -> Task[X]`
## that the async runtime drives.
function lower_task_expression_as_root_proc(ctx: ref[LowerCtx], expr_ast: ptr[ast.Expr], proc_ty: types.Type) -> ptr[ir.Expr]:
    let ret_stmt = alloc_ast_stmt(ast.Stmt.stmt_ret(value = expr_ast, line = 0, column = 0, length = 0))
    var stmts = vec.Vec[ast.Stmt].create()
    unsafe:
        stmts.push(read(ret_stmt))
    let body = alloc_ast_stmt(ast.Stmt.stmt_block(statements = stmts.as_span()))
    var ret_ty = ctx.void_ty
    match proc_ty:
        types.Type.ty_function as fnt:
            ret_ty = unsafe: read(fnt.return_type)
        _:
            pass
    return lower_proc_expression_typed(ctx, span[ast.Param](), ret_ty, body, proc_ty)


## The host's `foreign_call_requires_statement_lowering?` rule that needs the
## value materialized in an expression position: a parameter the mapping
## references more than once (its name plus its `as` boundary's public alias)
## whose argument expression is not duplicable, so the value must be evaluated
## into a temporary before the mapping substitutes it.
function foreign_call_needs_materialized_value(ctx: ref[LowerCtx], info: ForeignInfo, args: span[ast.Argument]) -> bool:
    let mapping = info.mapping else:
        return false
    var i: ptr_uint = 0
    while i < info.params.len and i < args.len:
        var param: ast.ForeignParam
        var arg: ast.Argument
        unsafe:
            param = read(info.params.data + i)
            arg = read(args.data + i)
        var total = mapping_reference_count(mapping, param.name)
        if param.boundary_type.is_some():
            total += mapping_reference_count(mapping, j2(param.name, "_public"))
        if total > 1 and not duplicable_foreign_ast(arg.arg_value):
            return true
        i += 1
    return false


## The host's `materialize_prepared_expression` with prefix `foreign_expr`: a
## statement-lowered foreign call in an expression position stores its result in
## a `__mt_foreign_expr_N` local before the enclosing statement.  A value that
## already is a temp's Name (the `foreign_result` shape) passes through.
function materialize_foreign_expr(ctx: ref[LowerCtx], result: ptr[ir.Expr], ret_ty: types.Type) -> ptr[ir.Expr]:
    match unsafe: read(result):
        ir.Expr.expr_name:
            return result
        _:
            pass
    if types.is_void(ret_ty):
        return result
    let rt = fresh_c_temp_name(ctx, "foreign_expr")
    let decl = ir.Stmt.stmt_local(name = rt, linkage_name = rt, ty = ret_ty, value = result, line = 0, source_path = "")
    let ref_expr = alloc_expr(ir.Expr.expr_name(name = rt, ty = ret_ty, pointer = Option[bool].some(value = false)))
    if ctx.hoist_mode != HoistMode.hm_off:
        ctx.hoist_stmts.push(decl)
        return ref_expr
    var stmts = vec.Vec[ir.Stmt].create()
    stmts.push(decl)
    return alloc_expr(ir.Expr.expr_stmt_expr(setup = stmts.as_span(), result = ref_expr, ty = ret_ty))


## Lower a foreign function call to a direct call on its mapped C function,
## applying `as cstr` boundary projections to arguments.  Phase 2d supports
## string-literal arguments at an `as cstr` boundary (emitted as a C string
## literal); str-variable projection (runtime str->cstr) and in/out/inout/
## consuming modes arrive later.
function lower_foreign_call(ctx: ref[LowerCtx], info: ForeignInfo, args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    # The host lowers a generic wrapper under its call-site specialization
    # (`binding.type_substitutions`), so `T as const_ptr[void]` boundary
    # projections see the concrete type.
    var saved_sub = ctx.type_substitution
    if info.type_params.len > 0:
        ctx.type_substitution = foreign_call_substitution(ctx, info, args)
    defer: ctx.type_substitution = saved_sub
    var result: ptr[ir.Expr]
    if info.simple:
        result = lower_foreign_call_direct(ctx, info, args, call_ep)
    else:
        result = lower_inline_foreign_mapping(ctx, info, args, call_ep)
    # A statement-lowered foreign call used in an expression position
    # materializes its result before the enclosing statement (the host's
    # `prepare_statement_lowered_foreign_call`); the statement roots
    # (initializer, assignment value, return value, discarded expression) keep
    # the call inline.
    if ctx.hoist_mode != HoistMode.hm_off and ctx.hoist_root_ep != call_ep and foreign_call_needs_materialized_value(ctx, info, args):
        result = materialize_foreign_expr(ctx, result, info.return_ty)
    return result


function lower_foreign_call_direct(ctx: ref[LowerCtx], info: ForeignInfo, args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    var ir_args = vec.Vec[ir.Expr].create()
    var setup = vec.Vec[ir.Stmt].create()
    # Names of hoisted `str as cstr` temporaries (malloc'd by
    # mt_foreign_str_to_cstr_temp) that must be freed after the call so a foreign
    # call in a loop (e.g. DrawText(dynamic_str, ...) each frame) does not leak.
    var cstr_temps = vec.Vec[str].create()
    var lowered_args = vec.Vec[ptr[ir.Expr]].create()
    let saved_locals_len = ctx.locals.len()
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        var lowered: ptr[ir.Expr]
        if i < info.params.len:
            var param: ast.ForeignParam
            unsafe:
                param = read(info.params.data + i)
            # The host's `prepare_foreign_in_argument`: an `in` operand that is
            # not addressable storage gets a `foreign_in` temp before the
            # boundary projection wraps its address.
            let prepared = prepare_foreign_in_argument_mt(ctx, info, param, arg, ref_of(setup))
            lowered = materialize_foreign_address_arg(ctx, lower_foreign_arg(ctx, info, param, prepared.arg_value), ref_of(setup))
        else:
            # A variadic slot has no declared type; the host still converts a
            # `str` value at the raw C boundary (`TextFormat("%s", value)`).
            lowered = lower_expr(ctx, arg.arg_value)
            if is_str_typed(ir_expr_type(lowered)):
                lowered = lower_cstr_argument(ctx, arg.arg_value, lowered)
        lowered_args.push(lowered)
        i += 1
    # The host allocates this call's own argument temps only after every
    # argument value has been lowered (`bind_foreign_mapping_arguments` phase
    # 3), so a nested foreign call in a later argument numbers before an earlier
    # argument's cstr temp.
    var ai: ptr_uint = 0
    while ai < lowered_args.len:
        let lp = lowered_args.get(ai) else:
            break
        var lowered = unsafe: read(lp)
        if is_foreign_cstr_temp_call(lowered):
            let cstr_ty = types.primitive("cstr")
            let tc = fresh_c_temp_name(ctx, "foreign_arg")
            setup.push(ir.Stmt.stmt_local(name = tc, linkage_name = tc, ty = cstr_ty, value = lowered, line = 0, source_path = ""))
            cstr_temps.push(tc)
            lowered = alloc_expr(ir.Expr.expr_name(name = tc, ty = cstr_ty, pointer = Option[bool].some(value = false)))
        unsafe:
            ir_args.push(read(lowered))
        ai += 1
    let ret_ty = info.return_ty
    # The host's `bind_foreign_mapping_arguments` binds its argument temps in a
    # duplicated env; the simple path's `foreign_in` temps must not leak either.
    while ctx.locals.len() > saved_locals_len:
        if ctx.locals.pop().is_none():
            break
    # The host types the emitted C call with the *raw declaration's* return
    # type — the owner analysis's view — not the wrapper's: `= c.getenv` with
    # a `ptr[char]` declaration and a `cstr?` wrapper types the call
    # `ptr[char]` (the 3f rule, on the simple path).
    var call_ty = ret_ty
    let mapping = info.mapping
    if mapping != null:
        match simple_mapping_callee(mapping):
            Option.some as callee:
                match mapping_call_return_type(ctx, info.owner_module, callee.value.receiver, callee.value.name):
                    Option.some as raw_ret:
                        call_ty = raw_ret.value
                    Option.none:
                        pass
            Option.none:
                pass
    let call = alloc_expr(ir.Expr.expr_call(callee = info.c_name, arguments = ir_args.as_span(), ty = call_ty))
    return wrap_foreign_cstr_frees(ctx, ref_of(setup), call, ret_ty, ref_of(cstr_temps), call_ep)


## The host's consuming-argument rule (`consuming_foreign_release_assignments`):
## after a statement-position foreign call, each bare nullable local passed to a
## `consuming` parameter is nulled and refined to null for later statements.
function append_foreign_consuming_releases(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], ep: ptr[ast.Expr]) -> void:
    var info_opt = Option[ForeignInfo].none
    var call_args = span[ast.Argument]()
    unsafe:
        match read(ep):
            ast.Expr.expr_call as call:
                call_args = call.args
                match read(call.callee):
                    ast.Expr.expr_identifier as id:
                        let fp = ctx.foreign_map.get(id.name)
                        if fp != null:
                            info_opt = Option[ForeignInfo].some(value = read(fp))
                    ast.Expr.expr_member_access as ma:
                        match read(ma.receiver):
                            ast.Expr.expr_identifier as rid:
                                let mod_ptr = ctx.analysis.imports.get(rid.name)
                                if mod_ptr != null:
                                    info_opt = imported_foreign_call(ctx, read(mod_ptr), ma.member_name)
                            _:
                                pass
                    _:
                        pass
            _:
                pass
    let info = info_opt else:
        return
    var refinements = map_mod.Map[str, types.Type].create()
    var i: ptr_uint = 0
    while i < info.params.len and i < call_args.len:
        var param: ast.ForeignParam
        var arg: ast.Argument
        unsafe:
            param = read(info.params.data + i)
            arg = read(call_args.data + i)
        if param.param_mode == ast.ForeignParamMode.fmode_consuming:
            unsafe:
                match read(arg.arg_value):
                    ast.Expr.expr_identifier as aid:
                        match lookup_local(ctx, aid.name):
                            Option.some as lb:
                                let b = lb.value
                                # The binding's *storage* type: a guard-bound
                                # pointer binding stores the full nullable in its
                                # c_name (projection-carried); option/result
                                # storages cannot satisfy a consuming pointer.
                                var storage_ty = types.primitive("void")
                                match b.projection:
                                    BindingProjection.plain:
                                        storage_ty = b.ty
                                    BindingProjection.nullable_storage as st:
                                        storage_ty = st.storage_ty
                                    _:
                                        pass
                                if types.is_nullable_type(storage_ty):
                                    let base = types.unwrap_nullable(storage_ty)
                                    let param_ty = foreign_param_context_type(ctx, info, param)
                                    if types.type_equals(base, param_ty):
                                        let target = alloc_expr(ir.Expr.expr_name(name = b.c_name, ty = storage_ty, pointer = b.pointer))
                                        output.push(ir.Stmt.stmt_assignment(
                                            target = target,
                                            operator = "=",
                                            value = alloc_expr(ir.Expr.expr_null_literal(ty = storage_ty)),
                                        ))
                                        refinements.set(aid.name, types.Type.ty_null(target = null))
                            Option.none:
                                pass
                    _:
                        pass
        i += 1
    if refinements.len() > 0:
        let _post = push_flow_refinements(ctx, ref_of(refinements))


## True when a lowered IR expression is a call to the malloc-backed
## `mt_foreign_str_to_cstr_temp` helper (a dynamic `str as cstr` foreign
## argument), so the caller can hoist and free it after the call.
function is_foreign_cstr_temp_call(ep: ptr[ir.Expr]) -> bool:
    unsafe:
        match read(ep):
            ir.Expr.expr_call as c:
                return c.callee == "mt_foreign_str_to_cstr_temp"
            _:
                return false


## The stored name of the cstr temporary at `index`.
function cstr_temp_name(names: ref[vec.Vec[str]], index: ptr_uint) -> str:
    let p = names.get(index) else:
        fatal(c"lowering: missing foreign cstr temp name")
    return unsafe: read(p)


## Wrap a foreign call `result` — whose argument temporaries are already declared
## in `setup` — so each hoisted `str as cstr` temp named in `cstr_temps` is freed
## after the call.  With no temps to free it returns the plain call, or a
## statement-expression when `setup` already holds address-argument temps.  For a
## non-void return the call is bound to a temp yielded as the result; for a void
## return the trailing free call is the (void) result.
##
## Inside a hoisting window the host's per-statement shapes are emitted instead:
## `hm_return` materializes the result into a `__mt_foreign_result_N` temp with
## the frees after it (the value must survive the cleanups), while `hm_value` and
## `hm_discard` return the call itself and collect the frees as cleanups the
## statement emits after itself (the host's `lower_foreign_call_components` and
## `discard_result` shapes); `hm_discard` additionally emits a root call as the
## statement itself, without the statement's line/path.
function wrap_foreign_cstr_frees(ctx: ref[LowerCtx], setup: ref[vec.Vec[ir.Stmt]], result: ptr[ir.Expr], ret_ty: types.Type, cstr_temps: ref[vec.Vec[str]], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    if ctx.hoist_mode != HoistMode.hm_off:
        var hs: ptr_uint = 0
        while hs < setup.len:
            let s = setup.get(hs) else:
                fatal(c"lowering: missing foreign setup statement")
            ctx.hoist_stmts.push(unsafe: read(s))
            hs += 1
        # A statement-position (discarded) foreign call is emitted by the
        # lowering itself, without the statement's line/path — the host's
        # `lower_foreign_call_statement(discard_result: true)` shape — whatever
        # its arguments needed; the frees follow it as cleanups.
        if ctx.hoist_mode == HoistMode.hm_discard and ctx.hoist_root_ep == call_ep:
            var hd: ptr_uint = 0
            while hd < cstr_temps.len():
                ctx.hoist_cleanups.push(free_cstr_temp_stmt(cstr_temp_name(cstr_temps, hd)))
                hd += 1
            ctx.hoist_stmts.push(ir.Stmt.stmt_expression(expression = result, line = 0, source_path = ""))
            ctx.hoist_stmt_emitted = true
            return result
        if cstr_temps.len() == 0:
            return result
        # A nested value-position foreign call with temporaries materializes its
        # result before the frees (the host's `prepare_statement_lowered_foreign_call`:
        # `foreign_result` + frees, then the Name).  A statement-root call does
        # not: the assignment/local/return destination stores it directly (the
        # host's `lower_foreign_call_components` path).  A nested call inside a
        # discarded statement (`DrawText(TextFormat(…), …)`) materializes too.
        let nested_value_call = ctx.hoist_mode != HoistMode.hm_off and call_ep != ctx.hoist_root_ep
        if (ctx.hoist_mode == HoistMode.hm_return or nested_value_call) and not types.is_void(ret_ty):
            let rt = fresh_c_temp_name(ctx, "foreign_result")
            ctx.hoist_stmts.push(ir.Stmt.stmt_local(name = rt, linkage_name = rt, ty = ret_ty, value = result, line = 0, source_path = ""))
            var hi: ptr_uint = 0
            while hi < cstr_temps.len():
                ctx.hoist_stmts.push(free_cstr_temp_stmt(cstr_temp_name(cstr_temps, hi)))
                hi += 1
            return alloc_expr(ir.Expr.expr_name(name = rt, ty = ret_ty, pointer = Option[bool].some(value = false)))
        var hj: ptr_uint = 0
        while hj < cstr_temps.len():
            ctx.hoist_cleanups.push(free_cstr_temp_stmt(cstr_temp_name(cstr_temps, hj)))
            hj += 1
        return result

    if cstr_temps.len() == 0:
        if setup.len() == 0:
            return result
        return alloc_expr(ir.Expr.expr_stmt_expr(setup = setup.as_span(), result = result, ty = ret_ty))

    if types.is_void(ret_ty):
        setup.push(ir.Stmt.stmt_expression(expression = result, line = 0, source_path = ""))
        var fi: ptr_uint = 0
        while fi + 1 < cstr_temps.len():
            setup.push(free_cstr_temp_stmt(cstr_temp_name(cstr_temps, fi)))
            fi += 1
        let last_result = free_cstr_temp_call(cstr_temp_name(cstr_temps, cstr_temps.len() - 1))
        return alloc_expr(ir.Expr.expr_stmt_expr(setup = setup.as_span(), result = last_result, ty = ret_ty))

    let rt = fresh_c_temp_name(ctx, "foreign_result")
    setup.push(ir.Stmt.stmt_local(name = rt, linkage_name = rt, ty = ret_ty, value = result, line = 0, source_path = ""))
    var fj: ptr_uint = 0
    while fj < cstr_temps.len():
        setup.push(free_cstr_temp_stmt(cstr_temp_name(cstr_temps, fj)))
        fj += 1
    let ret_result = alloc_expr(ir.Expr.expr_name(name = rt, ty = ret_ty, pointer = Option[bool].some(value = false)))
    return alloc_expr(ir.Expr.expr_stmt_expr(setup = setup.as_span(), result = ret_result, ty = ret_ty))


## `mt_free_foreign_cstr_temp(<name>)` as an IR call expression (void).
function free_cstr_temp_call(name: str) -> ptr[ir.Expr]:
    let cstr_ty = types.primitive("cstr")
    let name_ref = alloc_expr(ir.Expr.expr_name(name = name, ty = cstr_ty, pointer = Option[bool].some(value = false)))
    var free_args = vec.Vec[ir.Expr].create()
    unsafe:
        free_args.push(read(name_ref))
    return alloc_expr(ir.Expr.expr_call(callee = "mt_free_foreign_cstr_temp", arguments = free_args.as_span(), ty = types.primitive("void")))


## The same free call wrapped as an expression statement.
function free_cstr_temp_stmt(name: str) -> ir.Stmt:
    return ir.Stmt.stmt_expression(expression = free_cstr_temp_call(name), line = 0, source_path = "")


## When a foreign `in`/`out`/`inout` argument lowered to `&<non-lvalue>` (e.g.
## `set_shader_value(..., 0, ...)` producing `&(0)`), C rejects the address of a
## non-lvalue.  Materialize the operand into a temporary local and take that
## temp's address instead, appending the temp declaration to `setup` (the call
## is then wrapped in a statement-expression).  Mirrors Ruby's
## prepare_foreign_in_argument temp binding.
function materialize_foreign_address_arg(ctx: ref[LowerCtx], lowered: ptr[ir.Expr], setup: ref[vec.Vec[ir.Stmt]]) -> ptr[ir.Expr]:
    unsafe:
        match read(lowered):
            ir.Expr.expr_address_of as addr:
                if ir_is_addressable(addr.expression):
                    return lowered
                let op_ty = ir_expr_type(addr.expression)
                let tc = fresh_c_temp_name(ctx, "foreign_in")
                setup.push(ir.Stmt.stmt_local(name = tc, linkage_name = tc, ty = op_ty, value = addr.expression, line = 0, source_path = ""))
                let name_ref = alloc_expr(ir.Expr.expr_name(name = tc, ty = op_ty, pointer = Option[bool].some(value = false)))
                return alloc_expr(ir.Expr.expr_address_of(expression = name_ref, ty = addr.ty))
            _:
                return lowered


## True when an IR expression denotes a C lvalue whose address can be taken
## directly (a name, field/element access, or pointer dereference).  Literals,
## casts, calls, and arithmetic are not addressable and must be materialized
## into a temporary first.
function ir_is_addressable(ep: ptr[ir.Expr]) -> bool:
    unsafe:
        match read(ep):
            ir.Expr.expr_name:
                return true
            ir.Expr.expr_member as m:
                return ir_is_addressable(m.receiver)
            ir.Expr.expr_index:
                return true
            ir.Expr.expr_checked_index:
                return true
            ir.Expr.expr_checked_span_index:
                return true
            ir.Expr.expr_nullable_index:
                return true
            ir.Expr.expr_nullable_span_index:
                return true
            ir.Expr.expr_unary as u:
                if u.operator == "*":
                    return true
                return false
            _:
                return false


## True when a foreign parameter is a `str_buffer[N] as ptr[char]` boundary,
## the shape raygui text widgets use for a writable char buffer.
function is_str_buffer_char_ptr_boundary(param: ast.ForeignParam) -> bool:
    if param.boundary_type.is_none():
        return false
    if param.param_type.name.parts.len != 1:
        return false
    return unsafe: read(param.param_type.name.parts.data + 0) == "str_buffer"


## The capacity N of a concrete `str_buffer[N]` type (the `ty_literal_int` type
## argument), or 0 when it cannot be recovered.
function str_buffer_capacity_of(ty: types.Type) -> long:
    match ty:
        types.Type.ty_generic as g:
            if g.name == "str_buffer" and g.args.len >= 1:
                match unsafe: read(g.args.data + 0):
                    types.Type.ty_literal_int as lit:
                        return lit.value
                    _:
                        return 0
        _:
            pass
    return 0


## Lower a foreign call whose `= target` mapping is an inline expression such as
## `c.GuiSetStyle(int<-control, property, value)` or
## `c.SaveFileData(file_name, data.data, int<-data.len)`.  The host's
## `bind_foreign_mapping_arguments` runs three passes and their order is
## load-bearing for the emitted IR: the `as` boundary's public alias first
## (`<name>_public`, reusing the argument's Name when it already is one), then
## every referenced parameter's value (an `in` operand that is not addressable
## storage materializes into a `foreign_in` temp), then the `foreign_arg`
## temporaries decided by the reference-count/inlineability rule.  The mapping
## expression is re-lowered with those bindings in scope; the whole thing renders
## as a GCC/Clang statement-expression `({ tmp = ...; MappedCall(...); })`.
function lower_inline_foreign_mapping(ctx: ref[LowerCtx], info: ForeignInfo, args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    let mapping = info.mapping else:
        fatal(c"lowering: inline foreign mapping missing expression")

    var setup = vec.Vec[ir.Stmt].create()
    var cstr_temps = vec.Vec[str].create()
    let saved_locals_len = ctx.locals.len()
    # The mapping's substitutions never leak into an argument's lowering (the
    # host lowers the values in the caller's env); start from an empty map.
    let saved_replacements = ctx.mapping_replacements
    ctx.mapping_replacements = map_mod.Map[str, ptr[ir.Expr]].create()

    # Pass 1: the `as` boundary's public alias.  A value that already is a Name
    # (the buffer/local itself) is bound to that name; anything else gets the
    # host's `foreign_arg_public` temp before any parameter value is evaluated.
    var i: ptr_uint = 0
    while i < info.params.len and i < args.len:
        var param: ast.ForeignParam
        var arg: ast.Argument
        unsafe:
            param = read(info.params.data + i)
            arg = read(args.data + i)
        if param.boundary_type.is_some():
            let pub_alias = j2(param.name, "_public")
            if mapping_references_name(mapping, pub_alias):
                let declared_ty = foreign_param_context_type(ctx, info, param)
                let public_ir = literal_value_to_context_type(ctx, arg.arg_value, declared_ty, lower_expr(ctx, arg.arg_value))
                let public_lowered = unsafe: read(public_ir)
                match public_lowered:
                    ir.Expr.expr_name as nm:
                        ctx.locals.push(LocalBinding(name = pub_alias, c_name = nm.name, ty = declared_ty, pointer = Option[bool].some(value = false)))
                    _:
                        let tcp = fresh_c_temp_name(ctx, "foreign_arg_public")
                        setup.push(ir.Stmt.stmt_local(name = tcp, linkage_name = tcp, ty = declared_ty, value = public_ir, line = 0, source_path = ""))
                        ctx.locals.push(LocalBinding(name = pub_alias, c_name = tcp, ty = declared_ty, pointer = Option[bool].some(value = false)))
        i += 1

    # Pass 2: lower every referenced parameter's value in declaration order.
    var values = map_mod.Map[str, ptr[ir.Expr]].create()
    i = 0
    while i < info.params.len and i < args.len:
        var param2: ast.ForeignParam
        var arg2: ast.Argument
        unsafe:
            param2 = read(info.params.data + i)
            arg2 = read(args.data + i)
        if mapping_reference_count(mapping, param2.name) > 0:
            # A referenced public alias supplies the source value (the host's
            # `source_argument` rewrite), so `text_public.capacity()` and the
            # projection share one evaluation.
            var source_arg = arg2
            if param2.boundary_type.is_some():
                let pub_alias2 = j2(param2.name, "_public")
                if mapping_reference_count(mapping, pub_alias2) > 0:
                    let alias_id = alloc_ast_expr(ast.Expr.expr_identifier(name = pub_alias2, line = 0, column = 0))
                    source_arg = ast.Argument(arg_name = arg2.arg_name, arg_value = alias_id)
            source_arg = prepare_foreign_in_argument_mt(ctx, info, param2, source_arg, ref_of(setup))
            var value: ptr[ir.Expr]
            if is_str_buffer_char_ptr_boundary(param2):
                value = lower_str_buffer_char_ptr_argument(ctx, param2, source_arg, ref_of(setup))
            else:
                value = lower_foreign_arg(ctx, info, param2, source_arg.arg_value)
                value = materialize_foreign_address_arg(ctx, value, ref_of(setup))
                # An `array[T, N]` argument for a `span[T]` parameter (e.g.
                # `render_lines(renderer, line_points)`) coerces to the span
                # aggregate `{ data = &arr[0], len = N }` so the mapping's
                # `points.data` / `points.len` resolve, mirroring the analyzer's
                # array→span boundary rule.  The span's element type comes from
                # the argument: the declared name (`FPoint`) is an alias of the
                # binding's module and is not resolvable from the caller.
                let projected_ty = ir_expr_type(value)
                if param_type_is_span(param2.param_type) and is_array_type(projected_ty):
                    let span_ty = types.Type.ty_generic(name = "span", args = sp_type(generic_first_arg(projected_ty)))
                    value = array_value_to_span(value, projected_ty, span_ty)
            values.set(param2.name, value)
        i += 1

    # The host's `inlineable_single_direct_call_names` exception: when exactly
    # one referenced parameter needs a temporary and it is a single-reference
    # plain call, that call is embedded directly after all.
    var blocked_count: ptr_uint = 0
    var blocked_name = ""
    i = 0
    while i < info.params.len and i < args.len:
        var param3: ast.ForeignParam
        unsafe:
            param3 = read(info.params.data + i)
        let refs3 = mapping_reference_count(mapping, param3.name)
        if refs3 > 0:
            let value_ptr3 = values.get(param3.name)
            if value_ptr3 != null:
                let value3 = unsafe: read(value_ptr3)
                if refs3 > 1 or not inlineable_foreign_value(value3):
                    blocked_count += 1
                    blocked_name = param3.name
        i += 1
    var inline_direct_name = ""
    if blocked_count == 1:
        let refs_d = mapping_reference_count(mapping, blocked_name)
        let value_ptr_d = values.get(blocked_name)
        if value_ptr_d != null:
            let value_d = unsafe: read(value_ptr_d)
            if refs_d == 1 and is_plain_foreign_call_value(value_d) and not is_foreign_cstr_temp_call(value_d):
                inline_direct_name = blocked_name

    # Pass 3: temporary-bind a parameter only where the host does
    # (`foreign_argument_needs_temporary_binding?`); every other referenced
    # parameter's value is substituted into the mapping instead.
    i = 0
    while i < info.params.len and i < args.len:
        var param4: ast.ForeignParam
        unsafe:
            param4 = read(info.params.data + i)
        let refs4 = mapping_reference_count(mapping, param4.name)
        if refs4 > 0:
            let value_ptr4 = values.get(param4.name)
            if value_ptr4 != null:
                let value4 = unsafe: read(value_ptr4)
                let temp_ty = ir_expr_type(value4)
                var needs_temp = refs4 > 1 and not duplicable_foreign_value(value4)
                if not inlineable_foreign_value(value4):
                    needs_temp = true
                if param4.name == inline_direct_name:
                    needs_temp = false
                if needs_temp:
                    let tc = fresh_c_temp_name(ctx, "foreign_arg")
                    setup.push(ir.Stmt.stmt_local(name = tc, linkage_name = tc, ty = temp_ty, value = value4, line = 0, source_path = ""))
                    ctx.locals.push(LocalBinding(name = param4.name, c_name = tc, ty = temp_ty, pointer = Option[bool].some(value = false)))
                    if is_foreign_cstr_temp_call(value4):
                        cstr_temps.push(tc)
                else:
                    ctx.mapping_replacements.set(param4.name, value4)
        i += 1

    let result = walk_mapping_expr(ctx, mapping, info.return_ty, info.owner_module)
    ctx.mapping_replacements = saved_replacements

    while ctx.locals.len() > saved_locals_len:
        if ctx.locals.pop().is_none():
            break

    return wrap_foreign_cstr_frees(ctx, ref_of(setup), result, info.return_ty, ref_of(cstr_temps), call_ep)


## The host's `addressable_storage_expression?` over the AST: an identifier,
## a member/element chain rooted at one, or a `read(...)` call.  An `in`
## argument with any other shape needs a `foreign_in` temporary before its
## address can be taken.  The host strips `unsafe:` while preparing the
## argument (`prepare_expression_for_inline_lowering`'s UnsafeExpr arm), so the
## predicate looks through the wrapper.
function addressable_storage_ast(ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_identifier:
                return true
            ast.Expr.expr_unsafe as us:
                return addressable_storage_ast(us.expression)
            ast.Expr.expr_member_access as ma:
                return addressable_storage_ast(ma.receiver)
            ast.Expr.expr_index_access as ix:
                return addressable_storage_ast(ix.receiver)
            ast.Expr.expr_call as call:
                match read(call.callee):
                    ast.Expr.expr_identifier as id:
                        return id.name == "read"
                    _:
                        return false
            _:
                return false


## The operand of a call-site `in`/`out`/`inout` marker (the host's
## `foreign_argument_expression`), or the expression itself.
function foreign_argument_operand(ep: ptr[ast.Expr]) -> ptr[ast.Expr]:
    unsafe:
        match read(ep):
            ast.Expr.expr_unary_op as un:
                if un.operator == "in" or un.operator == "out" or un.operator == "inout":
                    return un.operand
                return ep
            _:
                return ep


## The host's `prepare_foreign_in_argument`: an `in` argument whose operand is
## not addressable storage is materialized into a `foreign_in` temp before the
## value is lowered, so the boundary's address-of has an lvalue to take.
function prepare_foreign_in_argument_mt(ctx: ref[LowerCtx], info: ForeignInfo, param: ast.ForeignParam, arg: ast.Argument, setup: ref[vec.Vec[ir.Stmt]]) -> ast.Argument:
    if param.param_mode != ast.ForeignParamMode.fmode_in:
        return arg
    let operand = foreign_argument_operand(arg.arg_value)
    if addressable_storage_ast(operand):
        return arg
    let declared_ty = foreign_param_context_type(ctx, info, param)
    let value = literal_value_to_context_type(ctx, operand, declared_ty, lower_expr(ctx, operand))
    let tc = fresh_c_temp_name(ctx, "foreign_in")
    setup.push(ir.Stmt.stmt_local(name = tc, linkage_name = tc, ty = declared_ty, value = value, line = 0, source_path = ""))
    ctx.locals.push(LocalBinding(name = tc, c_name = tc, ty = declared_ty, pointer = Option[bool].some(value = false)))
    let id = alloc_ast_expr(ast.Expr.expr_identifier(name = tc, line = 0, column = 0))
    return ast.Argument(arg_name = arg.arg_name, arg_value = id)


## A `str_buffer[N] as ptr[char]` argument (raygui text widgets): the C side
## writes into the buffer through a `char*`, so the mapping takes
## `mt_str_buffer_prepare_write(&buffer.data[0], N, &buffer.dirty)` — the host's
## `lower_foreign_char_pointer_buffer_argument_value` str-buffer branch.
function lower_str_buffer_char_ptr_argument(ctx: ref[LowerCtx], param: ast.ForeignParam, arg: ast.Argument, setup: ref[vec.Vec[ir.Stmt]]) -> ptr[ir.Expr]:
    let buffer = lower_expr(ctx, arg.arg_value)
    let sb_ty = ir_expr_type(buffer)
    let n_val = str_buffer_capacity_of(sb_ty)
    let char_ty = types.primitive("char")
    let char_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(char_ty))
    let bool_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.bool_ty))
    let data_member = alloc_expr(ir.Expr.expr_member(receiver = buffer, member = "data", ty = types.Type.ty_generic(name = "array", args = sp_type2(char_ty, types.literal_int(n_val + 1)))))
    let data0 = alloc_expr(ir.Expr.expr_index(receiver = data_member, index = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = types.primitive("ptr_uint"))), ty = char_ty))
    let data_ptr = alloc_expr(ir.Expr.expr_address_of(expression = data0, ty = char_ptr_ty))
    let dirty_member = alloc_expr(ir.Expr.expr_member(receiver = buffer, member = "dirty", ty = ctx.bool_ty))
    let dirty_ptr = alloc_expr(ir.Expr.expr_address_of(expression = dirty_member, ty = bool_ptr_ty))
    var pw_args = vec.Vec[ir.Expr].create()
    unsafe:
        pw_args.push(read(data_ptr))
        pw_args.push(read(alloc_expr(ir.Expr.expr_integer_literal(value = n_val, ty = types.primitive("ptr_uint")))))
        pw_args.push(read(dirty_ptr))
    return alloc_expr(ir.Expr.expr_call(callee = "mt_str_buffer_prepare_write", arguments = pw_args.as_span(), ty = char_ptr_ty))


## Re-lower a foreign mapping expression with the call's projected parameter
## temporaries in scope.  Any subtree that does not itself contain an external
## `c.CFunc(...)` call is lowered directly via lower_expr (which resolves the
## parameter temporaries as ordinary locals, along with casts, member access,
## and method calls such as `text_public.capacity()`).  Only the external call,
## cast, binary, and span/aggregate-construction nodes that wrap such a call are
## rebuilt here, because `c` (the external module alias) is not in scope in the
## caller and its members map 1:1 to their C function names.  An external call's
## type is the callee's *declared* return type (resolved in `owner_module`),
## not the mapping's own return type — the host's `owner_analysis` typed it that
## way (`c.Vector3ToFloatV(x).v` has a `Float3Array` call and an `array[float, 3]`
## member).
function walk_mapping_expr(ctx: ref[LowerCtx], ep: ptr[ast.Expr], top_ret_ty: types.Type, owner_module: str) -> ptr[ir.Expr]:
    if not mapping_contains_external_call(ctx, ep):
        return lower_expr(ctx, ep)
    unsafe:
        match read(ep):
            ast.Expr.expr_call as call:
                match read(call.callee):
                    ast.Expr.expr_member_access as ma:
                        if not member_receiver_is_local(ctx, ma.receiver):
                            var cargs = vec.Vec[ir.Expr].create()
                            let raw_info = mapping_call_foreign_info(ctx, owner_module, ma.receiver, ma.member_name)
                            var k: ptr_uint = 0
                            while k < call.args.len:
                                var a: ast.Argument
                                a = read(call.args.data + k)
                                var arg_ir = walk_mapping_expr(ctx, a.arg_value, top_ret_ty, owner_module)
                                # A literal mapping argument (the fixed `null` of
                                # `= c.SDL_RunApp(..., null)`) takes the raw C
                                # parameter's declared type, the host's
                                # `lower_contextual_expression` against the
                                # resolved declaration (item 5b's rule on the
                                # mapping path).
                                match raw_info:
                                    Option.some as ri:
                                        if k < ri.value.params.len:
                                            var raw_param: ast.ForeignParam
                                            raw_param = read(ri.value.params.data + k)
                                            arg_ir = literal_value_to_context_type(ctx, a.arg_value, foreign_param_context_type(ctx, ri.value, raw_param), arg_ir)
                                    Option.none:
                                        pass
                                cargs.push(read(arg_ir))
                                k += 1
                            var call_ty = top_ret_ty
                            match mapping_call_return_type(ctx, owner_module, ma.receiver, ma.member_name):
                                Option.some as rt:
                                    call_ty = rt.value
                                Option.none:
                                    pass
                            return alloc_expr(ir.Expr.expr_call(callee = ma.member_name, arguments = cargs.as_span(), ty = call_ty))
                        return lower_expr(ctx, ep)
                    ast.Expr.expr_specialization:
                        return walk_mapping_construction(ctx, call.args, top_ret_ty, owner_module)
                    _:
                        return lower_expr(ctx, ep)
            ast.Expr.expr_prefix_cast as pc:
                let target = qualify_type(ctx, resolve_type_ref(ctx, pc.target_type))
                let inner = walk_mapping_expr(ctx, pc.expression, top_ret_ty, owner_module)
                return alloc_expr(ir.Expr.expr_cast(target_type = target, expression = inner, ty = target))
            ast.Expr.expr_member_access as ma:
                # Field access on an external call result (`c.MatrixToFloatV(mat).v`):
                # walk the receiver so the external call is rebuilt, then take the
                # member.  The member's type is the mapping's own return type here
                # (the field IS the projected result).
                let recv = walk_mapping_expr(ctx, ma.receiver, top_ret_ty, owner_module)
                return alloc_expr(ir.Expr.expr_member(receiver = recv, member = ma.member_name, ty = top_ret_ty))
            ast.Expr.expr_binary_op as bin:
                let l = walk_mapping_expr(ctx, bin.left, top_ret_ty, owner_module)
                let r = walk_mapping_expr(ctx, bin.right, top_ret_ty, owner_module)
                # The rebuilt node keeps the analyzer's recorded type (the host
                # lowers the mapping through `lower_expression`): a comparison
                # (`= c.glfwInit() != 0`) is `bool`, not its left operand's type.
                var bty = expr_type(ctx, ep)
                if types.is_error(bty) or types.type_to_string(bty) == "void":
                    bty = ir_expr_type(l)
                return alloc_expr(ir.Expr.expr_binary(operator = bin.operator, left = l, right = r, ty = bty))
            ast.Expr.expr_unary_op as un:
                let operand = walk_mapping_expr(ctx, un.operand, top_ret_ty, owner_module)
                var uty = expr_type(ctx, ep)
                if types.is_error(uty) or types.type_to_string(uty) == "void":
                    uty = ir_expr_type(operand)
                return alloc_expr(ir.Expr.expr_unary(operator = un.operator, operand = operand, ty = uty))
            _:
                return lower_expr(ctx, ep)


## Build the aggregate literal for a type-constructor mapping such as
## `span[uint](data = c.GuiGetIcons(), len = 2048)`, walking each named field
## value so any embedded external call is expanded.  The aggregate type is the
## foreign function's declared return type.
function walk_mapping_construction(ctx: ref[LowerCtx], args: span[ast.Argument], result_ty: types.Type, owner_module: str) -> ptr[ir.Expr]:
    var fields = vec.Vec[ir.AggregateField].create()
    var i: ptr_uint = 0
    while i < args.len:
        var a: ast.Argument
        unsafe:
            a = read(args.data + i)
        let fname = a.arg_name else:
            fatal(c"lowering: inline foreign construction requires named fields")
        fields.push(ir.AggregateField(name = fname, value = walk_mapping_expr(ctx, a.arg_value, result_ty, owner_module)))
        i += 1
    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = result_ty, fields = fields.as_span()))


## True when `ep` (or a subexpression) is a call through an external-module
## alias, i.e. `alias.CFunc(...)` where `alias` is not a bound local — the shape
## a foreign mapping uses to name its underlying C function.  Method calls on a
## bound parameter temporary (`text_public.capacity()`) do not count.
function mapping_contains_external_call(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_call as call:
                match read(call.callee):
                    ast.Expr.expr_member_access as ma:
                        if not member_receiver_is_local(ctx, ma.receiver):
                            return true
                    _:
                        pass
                if mapping_contains_external_call(ctx, call.callee):
                    return true
                var k: ptr_uint = 0
                while k < call.args.len:
                    var a: ast.Argument
                    a = read(call.args.data + k)
                    if mapping_contains_external_call(ctx, a.arg_value):
                        return true
                    k += 1
                return false
            ast.Expr.expr_member_access as ma:
                return mapping_contains_external_call(ctx, ma.receiver)
            ast.Expr.expr_prefix_cast as pc:
                return mapping_contains_external_call(ctx, pc.expression)
            ast.Expr.expr_binary_op as bin:
                return mapping_contains_external_call(ctx, bin.left) or mapping_contains_external_call(ctx, bin.right)
            ast.Expr.expr_unary_op as un:
                return mapping_contains_external_call(ctx, un.operand)
            ast.Expr.expr_index_access as ix:
                return mapping_contains_external_call(ctx, ix.receiver) or mapping_contains_external_call(ctx, ix.index)
            ast.Expr.expr_named as nm:
                return mapping_contains_external_call(ctx, nm.value)
            ast.Expr.expr_specialization as spec:
                return mapping_contains_external_call(ctx, spec.callee)
            _:
                return false


## True when `ep` is an identifier bound as a local (a projected parameter
## temporary during inline foreign mapping lowering).
function member_receiver_is_local(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_identifier as id:
                if lookup_local(ctx, id.name).is_some():
                    return true
                return ctx.mapping_replacements.get(id.name) != null
            _:
                return false


## True when the mapping expression references an identifier named `name`
## (a parameter or its `_public` alias).
function mapping_references_name(ep: ptr[ast.Expr], name: str) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_identifier as id:
                return id.name == name
            ast.Expr.expr_member_access as ma:
                return mapping_references_name(ma.receiver, name)
            ast.Expr.expr_call as call:
                if mapping_references_name(call.callee, name):
                    return true
                var k: ptr_uint = 0
                while k < call.args.len:
                    var a: ast.Argument
                    a = read(call.args.data + k)
                    if mapping_references_name(a.arg_value, name):
                        return true
                    k += 1
                return false
            ast.Expr.expr_prefix_cast as pc:
                return mapping_references_name(pc.expression, name)
            ast.Expr.expr_binary_op as bin:
                return mapping_references_name(bin.left, name) or mapping_references_name(bin.right, name)
            ast.Expr.expr_unary_op as un:
                return mapping_references_name(un.operand, name)
            ast.Expr.expr_index_access as ix:
                return mapping_references_name(ix.receiver, name) or mapping_references_name(ix.index, name)
            ast.Expr.expr_named as nm:
                return mapping_references_name(nm.value, name)
            ast.Expr.expr_specialization as spec:
                return mapping_references_name(spec.callee, name)
            _:
                return false


## Count the references to `name` in a mapping expression (the host's
## `foreign_mapping_reference_counts`, single-name form).
function mapping_reference_count(ep: ptr[ast.Expr], name: str) -> ptr_uint:
    unsafe:
        match read(ep):
            ast.Expr.expr_identifier as id:
                if id.name == name:
                    return 1
                return 0
            ast.Expr.expr_member_access as ma:
                return mapping_reference_count(ma.receiver, name)
            ast.Expr.expr_call as call:
                var total = mapping_reference_count(call.callee, name)
                var k: ptr_uint = 0
                while k < call.args.len:
                    var a: ast.Argument
                    a = read(call.args.data + k)
                    total += mapping_reference_count(a.arg_value, name)
                    k += 1
                return total
            ast.Expr.expr_prefix_cast as pc:
                return mapping_reference_count(pc.expression, name)
            ast.Expr.expr_binary_op as bin:
                return mapping_reference_count(bin.left, name) + mapping_reference_count(bin.right, name)
            ast.Expr.expr_unary_op as un:
                return mapping_reference_count(un.operand, name)
            ast.Expr.expr_index_access as ix:
                return mapping_reference_count(ix.receiver, name) + mapping_reference_count(ix.index, name)
            ast.Expr.expr_named as nm:
                return mapping_reference_count(nm.value, name)
            ast.Expr.expr_specialization as spec:
                return mapping_reference_count(spec.callee, name)
            _:
                return 0


## The host's `duplicable_foreign_argument_expression?` over the AST (before
## lowering).  `unsafe:` is transparent — the host strips it while preparing
## arguments.
function duplicable_foreign_ast(ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_identifier:
                return true
            ast.Expr.expr_integer_literal:
                return true
            ast.Expr.expr_float_literal:
                return true
            ast.Expr.expr_string_literal:
                return true
            ast.Expr.expr_bool_literal:
                return true
            ast.Expr.expr_null_literal:
                return true
            ast.Expr.expr_unsafe as us:
                return duplicable_foreign_ast(us.expression)
            ast.Expr.expr_member_access as ma:
                return duplicable_foreign_ast(ma.receiver)
            ast.Expr.expr_unary_op as u:
                return duplicable_foreign_ast(u.operand)
            ast.Expr.expr_binary_op as b:
                return duplicable_foreign_ast(b.left) and duplicable_foreign_ast(b.right)
            _:
                return false


## The host's `duplicable_foreign_argument_expression?` for a lowered value: an
## expression that may be substituted into a mapping more than once without
## changing behavior (a name or literal, or a member/unary/binary over those).
function duplicable_foreign_value(ep: ptr[ir.Expr]) -> bool:
    unsafe:
        match read(ep):
            ir.Expr.expr_name:
                return true
            ir.Expr.expr_integer_literal:
                return true
            ir.Expr.expr_unsigned_integer_literal:
                return true
            ir.Expr.expr_float_literal:
                return true
            ir.Expr.expr_string_literal:
                return true
            ir.Expr.expr_boolean_literal:
                return true
            ir.Expr.expr_null_literal:
                return true
            ir.Expr.expr_member as m:
                return duplicable_foreign_value(m.receiver)
            ir.Expr.expr_unary as u:
                return duplicable_foreign_value(u.operand)
            ir.Expr.expr_binary as b:
                return duplicable_foreign_value(b.left) and duplicable_foreign_value(b.right)
            _:
                return false


## The host's `inlineable_foreign_argument_expression?` for a lowered value: an
## expression a mapping can embed directly (no hidden temporaries inside).
function inlineable_foreign_value(ep: ptr[ir.Expr]) -> bool:
    unsafe:
        match read(ep):
            ir.Expr.expr_name:
                return true
            ir.Expr.expr_integer_literal:
                return true
            ir.Expr.expr_unsigned_integer_literal:
                return true
            ir.Expr.expr_float_literal:
                return true
            ir.Expr.expr_string_literal:
                return true
            ir.Expr.expr_boolean_literal:
                return true
            ir.Expr.expr_null_literal:
                return true
            ir.Expr.expr_zero_init:
                return true
            ir.Expr.expr_sizeof:
                return true
            ir.Expr.expr_alignof:
                return true
            ir.Expr.expr_offsetof:
                return true
            ir.Expr.expr_call as call:
                if is_foreign_cstr_temp_call(ep):
                    return false
                var k: ptr_uint = 0
                while k < call.arguments.len:
                    if not inlineable_foreign_value(call.arguments.data + k):
                        return false
                    k += 1
                return true
            ir.Expr.expr_call_indirect as call:
                if not inlineable_foreign_value(call.callee):
                    return false
                var k2: ptr_uint = 0
                while k2 < call.arguments.len:
                    if not inlineable_foreign_value(call.arguments.data + k2):
                        return false
                    k2 += 1
                return true
            ir.Expr.expr_member as m:
                return inlineable_foreign_value(m.receiver)
            ir.Expr.expr_index as x:
                return inlineable_foreign_value(x.receiver) and inlineable_foreign_value(x.index)
            ir.Expr.expr_checked_index as x:
                return inlineable_foreign_value(x.receiver) and inlineable_foreign_value(x.index)
            ir.Expr.expr_checked_span_index as x:
                return inlineable_foreign_value(x.receiver) and inlineable_foreign_value(x.index)
            ir.Expr.expr_nullable_index as x:
                return inlineable_foreign_value(x.receiver) and inlineable_foreign_value(x.index)
            ir.Expr.expr_nullable_span_index as x:
                return inlineable_foreign_value(x.receiver) and inlineable_foreign_value(x.index)
            ir.Expr.expr_unary as u:
                return inlineable_foreign_value(u.operand)
            ir.Expr.expr_binary as b:
                return inlineable_foreign_value(b.left) and inlineable_foreign_value(b.right)
            ir.Expr.expr_conditional as c:
                return inlineable_foreign_value(c.condition) and inlineable_foreign_value(c.then_expression) and inlineable_foreign_value(c.else_expression)
            ir.Expr.expr_reinterpret as r:
                return inlineable_foreign_value(r.expression)
            ir.Expr.expr_cast as c:
                return inlineable_foreign_value(c.expression)
            ir.Expr.expr_address_of as a:
                return inlineable_foreign_value(a.expression)
            ir.Expr.expr_aggregate_literal as g:
                var fi: ptr_uint = 0
                while fi < g.fields.len:
                    let f = unsafe: read(g.fields.data + fi)
                    if not inlineable_foreign_value(f.value):
                        return false
                    fi += 1
                return true
            _:
                return false


## The declared return type of an external-module call inside an inline mapping
## (`c.Vector3ToFloatV(...)`, `math.vector3_to_float_v(...)`): resolve the
## receiver alias against the *owner* module's imports, then the member against
## the target module's `external function` / `foreign function` declarations —
## the host's `lower_inline_foreign_mapping_expression` typed the call through
## its `owner_analysis`.  None when the alias or the declaration is unknown (the
## caller falls back to the mapping's own return type).
function mapping_call_return_type(ctx: ref[LowerCtx], owner_module: str, receiver: ptr[ast.Expr], name: str) -> Option[types.Type]:
    unsafe:
        match read(receiver):
            ast.Expr.expr_identifier as id:
                let owner_a = find_imported_analysis(ctx, owner_module) else:
                    return Option[types.Type].none
                let mod_ptr = owner_a.imports.get(id.name)
                if mod_ptr == null:
                    return Option[types.Type].none
                let target_module = read(mod_ptr)
                match imported_foreign_call(ctx, target_module, name):
                    Option.some as fi:
                        return Option[types.Type].some(value = fi.value.return_ty)
                    Option.none:
                        pass
                match imported_extern_call(ctx, target_module, name):
                    Option.some as ei:
                        return Option[types.Type].some(value = ei.value.return_ty)
                    Option.none:
                        return Option[types.Type].none
            _:
                return Option[types.Type].none


## The raw C declaration behind a foreign mapping's external call
## (`c.SDL_RunApp`), resolved in the mapping owner's module — the parameter
## types its arguments are contextually lowered against.
function mapping_call_foreign_info(ctx: ref[LowerCtx], owner_module: str, receiver: ptr[ast.Expr], name: str) -> Option[ForeignInfo]:
    unsafe:
        match read(receiver):
            ast.Expr.expr_identifier as id:
                let owner_a = find_imported_analysis(ctx, owner_module) else:
                    return Option[ForeignInfo].none
                let mod_ptr = owner_a.imports.get(id.name)
                if mod_ptr == null:
                    return Option[ForeignInfo].none
                let target_module = read(mod_ptr)
                match imported_foreign_call(ctx, target_module, name):
                    Option.some as fi:
                        return Option[ForeignInfo].some(value = fi.value)
                    Option.none:
                        pass
                match imported_extern_call(ctx, target_module, name):
                    Option.some as ei:
                        return Option[ForeignInfo].some(value = ei.value)
                    Option.none:
                        return Option[ForeignInfo].none
            _:
                return Option[ForeignInfo].none


## True when a lowered value is a plain call (the host's single-direct-call
## inline exception inspects `IR::Call` values).
function is_plain_foreign_call_value(ep: ptr[ir.Expr]) -> bool:
    unsafe:
        match read(ep):
            ir.Expr.expr_call:
                return true
            ir.Expr.expr_call_indirect:
                return true
            _:
                return false



## The parameter's declared type, resolved in its *declaring* module and
## deepened/opaqueified: the context type the host's
## `lower_contextual_expression` gives every foreign argument (session 44,
## items 3ag/5b).
function foreign_param_context_type(ctx: ref[LowerCtx], info: ForeignInfo, param: ast.ForeignParam) -> types.Type:
    var saved_module = ctx.module_name
    var saved_analysis = ctx.analysis
    if info.owner_module.len > 0 and not info.owner_module.equal(ctx.module_name):
        match find_imported_analysis(ctx, info.owner_module):
            Option.some as owner_a:
                ctx.module_name = info.owner_module
                ctx.analysis = owner_a.value
            Option.none:
                pass
    var ctx_pt = param.param_type
    let ctx_ty = opaqueify_type(ctx, deep_alias_target(ctx, qualify_type(ctx, resolve_type_ref(ctx, ptr_of(ctx_pt)))))
    ctx.module_name = saved_module
    ctx.analysis = saved_analysis
    return ctx_ty


## The declared return type of a foreign wrapper call, resolved in its
## declaring module — the host's `infer_expression_type` for a call.  A simple
## mapping's lowered call carries the raw declaration's return type instead
## (`ptr[char]` for a `cstr?` wrapper, the 3j rule), so a local declaration
## inferred from the call needs this.  None when the callee is not a wrapper.
function foreign_wrapper_call_return_type(ctx: ref[LowerCtx], callee: ptr[ast.Expr]) -> Option[types.Type]:
    unsafe:
        match read(callee):
            ast.Expr.expr_identifier as id:
                let fp = ctx.foreign_map.get(id.name)
                if fp != null:
                    return Option[types.Type].some(value = read(fp).return_ty)
                return Option[types.Type].none
            ast.Expr.expr_member_access as ma:
                match read(ma.receiver):
                    ast.Expr.expr_identifier as id2:
                        let mod_ptr = ctx.analysis.imports.get(id2.name) else:
                            return Option[types.Type].none
                        match imported_foreign_call(ctx, read(mod_ptr), ma.member_name):
                            Option.some as fi:
                                return Option[types.Type].some(value = fi.value.return_ty)
                            Option.none:
                                return Option[types.Type].none
                    _:
                        return Option[types.Type].none
            _:
                return Option[types.Type].none


## The resolved `as` boundary type of a foreign wrapper parameter, in the
## module that declares the wrapper — the host's `parameter.boundary_type`
## (`resolve_type_ref` in the owner).
function foreign_boundary_type(ctx: ref[LowerCtx], info: ForeignInfo, param: ast.ForeignParam) -> types.Type:
    match param.boundary_type:
        Option.some as boundary:
            var saved_module = ctx.module_name
            var saved_analysis = ctx.analysis
            if info.owner_module.len > 0 and not info.owner_module.equal(ctx.module_name):
                match find_imported_analysis(ctx, info.owner_module):
                    Option.some as owner_a:
                        ctx.module_name = info.owner_module
                        ctx.analysis = owner_a.value
                    Option.none:
                        pass
            var bt_ref = boundary.value
            let bt = qualify_type(ctx, resolve_type_ref(ctx, ptr_of(bt_ref)))
            ctx.module_name = saved_module
            ctx.analysis = saved_analysis
            return bt
        Option.none:
            return types.Type.ty_error


## True when a value of type `actual` may be projected to the foreign boundary
## `expected` by an `IR::Cast` — the pointer/nullable/cstr subset of the host's
## `foreign_identity_projection_cast_compatible?`.
function foreign_projection_cast_compatible(actual: types.Type, expected: types.Type) -> bool:
    if types.type_equals(actual, expected):
        return true
    match actual:
        types.Type.ty_nullable as na:
            match expected:
                types.Type.ty_nullable as ne:
                    return foreign_projection_cast_compatible(unsafe: read(na.base), unsafe: read(ne.base))
                _:
                    # A nullable *pointer* is the same C pointer value, so it
                    # projects to a non-nullable pointer boundary as a cast
                    # (`update_texture(texture, pixels)` with a guard-bound
                    # `pixels: ptr[Color]?`).
                    let nbase = unsafe: read(na.base)
                    if (types.is_pointer_type(nbase) or types.is_ref_type(nbase)) and (types.is_pointer_type(expected) or types.is_ref_type(expected)):
                        return true
                    return false
        _:
            pass
    match expected:
        types.Type.ty_nullable as ne:
            return foreign_projection_cast_compatible(actual, unsafe: read(ne.base))
        _:
            pass
    let actual_ptr = types.is_pointer_type(actual)
    let expected_ptr = types.is_pointer_type(expected)
    if types.type_equals(actual, types.primitive("cstr")) and expected_ptr:
        return types.is_char_type(types.pointer_element(expected))
    if actual_ptr and types.type_equals(expected, types.primitive("cstr")):
        return types.is_char_type(types.pointer_element(actual))
    if actual_ptr and expected_ptr:
        # A const pointer never projects to a mutable one.
        match actual:
            types.Type.ty_generic as ag:
                if ag.name == "const_ptr":
                    match expected:
                        types.Type.ty_generic as eg:
                            if eg.name == "ptr" or eg.name == "own":
                                return false
                        _:
                            pass
            _:
                pass
        if is_void_pointer_type(actual) or is_void_pointer_type(expected):
            return true
        return foreign_projection_cast_compatible(types.pointer_element(actual), types.pointer_element(expected))
    # A `void*` and an opaque handle share the C representation.
    if is_void_pointer_type(actual):
        match expected:
            types.Type.ty_opaque:
                return true
            _:
                pass
    if is_void_pointer_type(expected):
        match actual:
            types.Type.ty_opaque:
                return true
            _:
                pass
    return false


function is_void_pointer_type(t: types.Type) -> bool:
    return types.is_pointer_type(t) and types.is_void(types.pointer_element(t))


## The host's `foreign_identity_projection_expression`: a value at a foreign
## boundary keeps its type when equal to the boundary, is `IR::Cast` when the
## types are projection-compatible, and is otherwise left unchanged (the self's
## type resolution is coarser than the host's in a few nominal corners).
function project_foreign_boundary(ctx: ref[LowerCtx], value: ptr[ir.Expr], boundary: types.Type) -> ptr[ir.Expr]:
    let value_ty = ir_expr_type(value)
    if types.type_equals(value_ty, boundary):
        return value
    if foreign_projection_cast_compatible(value_ty, boundary):
        return alloc_expr(ir.Expr.expr_cast(target_type = boundary, expression = value, ty = boundary))
    return value


## A `str` argument at a `cstr` boundary (a declared `str as cstr` parameter or
## a variadic slot): a string literal becomes a C string literal; an already
## cstr value passes through; a cstr-backed `str` (a literal-backed local, a
## dynamic format temp, or a syntactically cstr-backed `if`/`unsafe`) passes its
## `data` pointer in an `IR::Cast(cstr)`; anything else takes the malloc-backed
## `mt_foreign_str_to_cstr_temp` copy (hoisted/freed by the caller).
function lower_cstr_argument(ctx: ref[LowerCtx], arg: ptr[ast.Expr], lowered_str: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let cstr_ty = types.primitive("cstr")
    unsafe:
        match read(arg):
            ast.Expr.expr_string_literal as lit:
                return alloc_expr(ir.Expr.expr_string_literal(value = lit.value, ty = cstr_ty, cstring = true))
            _:
                pass
    let arg_ty = ir_expr_type(lowered_str)
    match arg_ty:
        types.Type.ty_primitive as p:
            if p.name == "cstr":
                return lowered_str
        _:
            pass
    if is_cstr_backed_lowered(ctx, lowered_str) or ast_expr_cstr_backed(ctx, arg):
        let data_member = alloc_expr(ir.Expr.expr_member(receiver = lowered_str, member = "data", ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("char")))))
        return alloc_expr(ir.Expr.expr_cast(target_type = cstr_ty, expression = data_member, ty = cstr_ty))
    return alloc_expr(ir.Expr.expr_call(
        callee = "mt_foreign_str_to_cstr_temp",
        arguments = single_expr_span(lowered_str),
        ty = cstr_ty,
    ))


function lower_foreign_arg(ctx: ref[LowerCtx], info: ForeignInfo, param: ast.ForeignParam, arg: ptr[ast.Expr]) -> ptr[ir.Expr]:
    match param.boundary_type:
        Option.some as boundary:
            if boundary_is_cstr(boundary.value):
                return lower_cstr_argument(ctx, arg, lower_expr(ctx, arg))
            # For `in value: T as const_ptr[void]` the host takes the
            # argument's address with `const_pointer_to(parameter.type)` and
            # then projects it to the declared boundary type — the host's
            # `lower_foreign_in_argument_value` + `lower_addr_expression`.
            if param.param_mode == ast.ForeignParamMode.fmode_in:
                let lowered_val = lower_expr(ctx, arg)
                let in_ty = foreign_param_context_type(ctx, info, param)
                if is_null_ir_expr(lowered_val):
                    return null_literal_to_context_type(arg, in_ty, lowered_val)
                let in_target = types.Type.ty_generic(name = "const_ptr", args = sp_type(in_ty))
                var address: ptr[ir.Expr]
                match addr_operand_expression(lowered_val):
                    Option.some as op:
                        let op_ty = ir_expr_type(op.value)
                        if types.type_equals(op_ty, in_target):
                            address = op.value
                        else:
                            address = alloc_expr(ir.Expr.expr_cast(target_type = in_target, expression = op.value, ty = in_target))
                    Option.none:
                        address = alloc_expr(ir.Expr.expr_address_of(expression = lowered_val, ty = in_target))
                return project_foreign_boundary(ctx, address, foreign_boundary_type(ctx, info, param))
            # A plain `as` boundary: a bare literal takes the parameter's
            # declared type, then the value projects to the declared boundary —
            # the host's `lower_foreign_argument_value` fallback +
            # `foreign_identity_projection_expression`.
            let lowered_plain = lower_expr(ctx, arg)
            let ctx_ty = foreign_param_context_type(ctx, info, param)
            var typed = literal_value_to_context_type(ctx, arg, ctx_ty, lowered_plain)
            # The host's `lower_contextual_expression` also applies the numeric
            # constant cast at a foreign boundary (`set_render_draw_color(…,
            # ALPHA_OPAQUE)` with a `ubyte` parameter casts the `int` const).
            typed = contextual_numeric_cast(ctx, arg, typed, ctx_ty, false, false)
            return project_foreign_boundary(ctx, typed, foreign_boundary_type(ctx, info, param))
        Option.none:
            # A float/double parameter threads its expected type into an
            # arithmetic binary argument (the host's `lower_contextual_expression`
            # with the parameter's type): `math.cos((i + 1) / 51.45)` takes a
            # double literal and casts the int sub-expression.
            let arg_ctx_ty = foreign_param_context_type(ctx, info, param)
            var lowered: ptr[ir.Expr]
            if types.is_float_type(arg_ctx_ty) and is_contextual_binary_expr(arg):
                lowered = lower_contextual_binary(ctx, arg, arg_ctx_ty)
            else:
                lowered = lower_expr(ctx, arg)
            # `out`/`inout` pass the address of the argument's storage slot, with
            # the host's `lower_addr_expression` exception: a lowered argument
            # that already *is* a pointer — an editable method's `this` receiver
            # (`IR::Name` with `pointer: true`) or a `*p` dereference — is cast
            # to the boundary's pointer type instead of being addressed again.
            # A pointer-typed slot (`out glyph_recs: ptr[Rectangle]`) with a
            # plain value still takes its address, so the C function receives
            # `Rectangle**`.
            let mode_needs_address = param.param_mode == ast.ForeignParamMode.fmode_out or param.param_mode == ast.ForeignParamMode.fmode_inout
            if mode_needs_address:
                if is_null_ir_expr(lowered):
                    return lowered
                let arg_ty = ir_expr_type(lowered)
                # Resolve the declared parameter type in the wrapper's OWNER
                # module (the host's `ForeignInfo.owner_module`): a wrapper in
                # `std.libuv` declares `out addr: sockaddr_in` where
                # `sockaddr_in` is that module's public alias of
                # `std.c.libuv.sockaddr_in`, a name the caller may not import.
                # `qualify_type`/`deep_alias_target` run inside that context.
                var slot_ty = foreign_param_context_type(ctx, info, param)
                # The host's `foreign_slot_boundary_value_type`: a nullable
                # pointer-like slot's boundary value is its base.
                if types.is_nullable_type(slot_ty) and is_nullable_pointer_like(slot_ty):
                    slot_ty = types.unwrap_nullable(slot_ty)
                let slot_is_pointer = types.is_raw_pointer(slot_ty) or types.is_ref_type(slot_ty) or types.is_own_type(slot_ty)
                let slot_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(qualify_type(ctx, slot_ty)))
                match addr_operand_expression(lowered):
                    Option.some as op:
                        return alloc_expr(ir.Expr.expr_cast(target_type = slot_ptr_ty, expression = op.value, ty = slot_ptr_ty))
                    Option.none:
                        pass
                if types.is_raw_pointer(arg_ty) and not slot_is_pointer:
                    return lowered
                # The host's `lower_foreign_pointer_argument_value` types the
                # address-of with `pointer_to(slot_type)` — `ptr[T]`, not a
                # `ptr[void]` placeholder.
                return alloc_expr(ir.Expr.expr_address_of(expression = lowered, ty = slot_ptr_ty))
            # A bare `in` parameter (no `as`) has the host's implicit boundary
            # `const_pointer_to(parameter.type)` (`foreign_parameter_boundary_type`):
            # hand the callee the argument's address, unless it is already a
            # pointer.
            if param.param_mode == ast.ForeignParamMode.fmode_in:
                if is_null_ir_expr(lowered):
                    # The host types the null with the parameter's declared
                    # type (`c.time(null)` carries `Nullable(ptr[ptr_int])`,
                    # not `void`).
                    return null_literal_to_context_type(arg, foreign_param_context_type(ctx, info, param), lowered)
                let in_arg_ty = ir_expr_type(lowered)
                if types.is_raw_pointer(in_arg_ty) or types.is_ref_type(in_arg_ty) or types.is_own_type(in_arg_ty):
                    return lowered
                let in_val_ty = foreign_param_context_type(ctx, info, param)
                return alloc_expr(ir.Expr.expr_address_of(expression = lowered, ty = types.Type.ty_generic(name = "const_ptr", args = sp_type(in_val_ty))))
            # A plain pointer/ref param passed a non-pointer value borrows it.
            var pt_copy = param.param_type
            let param_ty = resolve_type_ref(ctx, ptr_of(pt_copy))
            if types.is_raw_pointer(param_ty) or types.is_ref_type(param_ty):
                if not is_null_ir_expr(lowered):
                    let arg_ty = ir_expr_type(lowered)
                    if not types.is_raw_pointer(arg_ty) and not types.is_own_type(arg_ty):
                        let borrowed = alloc_expr(ir.Expr.expr_address_of(expression = lowered, ty = types.primitive("ptr[void]")))
                        return project_foreign_boundary(ctx, borrowed, foreign_boundary_type(ctx, info, param))
            # Every bare literal takes the parameter's declared type — the
            # host's `lower_contextual_expression` (int/float/string/null all
            # retype, not just `null`), resolved in the param's declaring
            # module (session 44, items 3ag/3ae/3fc).  The lowered value is
            # then projected to the declared boundary — the host's
            # `foreign_identity_projection_expression` (item 8a).
            let ctx_ty = foreign_param_context_type(ctx, info, param)
            var typed = literal_value_to_context_type(ctx, arg, ctx_ty, lowered)
            typed = contextual_numeric_cast(ctx, arg, typed, ctx_ty, false, false)
            return project_foreign_boundary(ctx, typed, foreign_boundary_type(ctx, info, param))


function boundary_is_cstr(boundary: ast.TypeRef) -> bool:
    if boundary.name.parts.len != 1:
        return false
    unsafe:
        return read(boundary.name.parts.data + 0) == "cstr"


## Follow a module-local type alias chain to its target type.  A foreign
## boundary's pointer element is the host's `parameter.type` — the *resolved*
## declared type — so `WorldDef` (a wrapper alias of `c.b2WorldDef`) must deepen
## to the raw `b2WorldDef`; `qualify_type` deliberately keeps std.c-targeting
## aliases by name for C-signature purposes, which is why this exists
## (session 43, item 3q).
function deep_alias_target(ctx: ref[LowerCtx], t: types.Type) -> types.Type:
    var current = t
    var guard: ptr_uint = 0
    while guard < 8:
        guard += 1
        var module_name = ""
        var type_name = ""
        match current:
            types.Type.ty_imported as im:
                if im.args.len > 0 or is_prelude_variant_name(im.name):
                    return current
                module_name = im.module_name
                type_name = im.name
            types.Type.ty_named as nm:
                if nm.module_name.len == 0:
                    return current
                module_name = nm.module_name
                type_name = nm.name
            _:
                return current
        match resolve_imported_alias_type(ctx.program_analyses, module_name, type_name):
            Option.some as target:
                let next = target.value
                if types.type_equals(next, current):
                    return current
                current = next
            Option.none:
                # `qualify_type` keeps a std.c-targeting alias by name but pairs
                # it with the *target* module (`ty_imported("std.c.raw.lib",
                # "MyDef")` for `type MyDef = c.Def`).  Look the alias up in the
                # module that actually declares it, and accept the result only
                # when it targets the module already on the type — any other
                # same-named alias elsewhere would be the wrong rewrite.
                match resolve_alias_targeting_module(ctx.program_analyses, module_name, type_name):
                    Option.some as target:
                        let next = target.value
                        if types.type_equals(next, current):
                            return current
                        current = next
                    Option.none:
                        return current
    return current


## The target of an alias named `type_name` declared in *some* module, accepted
## only when it is an imported type of the given `module_name` (the pairing
## `qualify_type` leaves for a std.c-targeting alias).
function resolve_alias_targeting_module(analyses: span[analyzer.Analysis], module_name: str, type_name: str) -> Option[types.Type]:
    var ai: ptr_uint = 0
    while ai < analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(analyses.data + ai)
        let alias_target = a.type_alias_types.get(type_name)
        if alias_target != null:
            unsafe:
                let at = read(alias_target)
                var base = at
                if types.is_nullable_type(base):
                    base = types.unwrap_nullable(base)
                match base:
                    types.Type.ty_imported as aim:
                        if aim.module_name == module_name:
                            return Option[types.Type].some(value = types.Type.ty_imported(module_name = aim.module_name, name = aim.name, args = aim.args))
                        return Option[types.Type].none
                    _:
                        return Option[types.Type].none
        ai += 1
    return Option[types.Type].none


## The operand an address-taking foreign boundary should cast rather than
## address again — the host's `lower_addr_expression`: an `IR::Name` with
## `pointer: true` (a C pointer variable, e.g. an editable method's `this`
## receiver) is itself the pointer, and `*p` unwraps to `p`.  None for
## everything else (which takes `IR::AddressOf`).
function addr_operand_expression(ep: ptr[ir.Expr]) -> Option[ptr[ir.Expr]]:
    unsafe:
        match read(ep):
            ir.Expr.expr_name as n:
                if n.pointer.unwrap_or(false):
                    return Option[ptr[ir.Expr]].some(value = ep)
                return Option[ptr[ir.Expr]].none
            ir.Expr.expr_unary as u:
                if u.operator == "*":
                    return Option[ptr[ir.Expr]].some(value = u.operand)
                return Option[ptr[ir.Expr]].none
            _:
                return Option[ptr[ir.Expr]].none


## True when a declared foreign parameter type is spelled `span[T]`, i.e. the
## array→span boundary coercion applies to its argument.
function param_type_is_span(type_ref: ast.TypeRef) -> bool:
    if type_ref.name.parts.len != 1:
        return false
    unsafe:
        return read(type_ref.name.parts.data + 0) == "span"


# =============================================================================
#  Foreign / external function registry
# =============================================================================

## Pre-scan declarations to map each external function to its C name and each
## foreign function to its mapped C function and boundary parameters, so calls
## can be lowered to direct C calls.
function collect_foreign_functions(ctx: ref[LowerCtx], decls: span[ast.Decl]) -> void:
    var i: ptr_uint = 0
    while i < decls.len:
        var d: ast.Decl
        unsafe:
            d = read(decls.data + i)
        match d:
            ast.Decl.decl_extern_function as ef:
                ctx.extern_map.set(ef.name, extern_c_name(ef.name, ef.mapping))
            _:
                pass
        i += 1

    i = 0
    while i < decls.len:
        var d: ast.Decl
        unsafe:
            d = read(decls.data + i)
        match d:
            ast.Decl.decl_foreign_function as ff:
                let ff_simple = foreign_mapping_is_simple(ff.mapping)
                var ff_c_name = ""
                if ff_simple:
                    ff_c_name = resolve_foreign_c_name(ctx, ff.mapping)
                ctx.foreign_map.set(ff.name, ForeignInfo(
                    c_name = ff_c_name,
                    # The declared return type resolved like any other type ref:
                    # a nominal return (`-> Vector4` through `type Vector4 =
                    # c.Vector4`) must yield the originating raw type, exactly as
                    # `imported_foreign_call` resolves a cross-module callee.
                    return_ty = qualify_type(ctx, resolve_type_ref(ctx, ff.return_type)),
                    params = ff.foreign_params,
                    mapping = ff.mapping,
                    simple = ff_simple,
                    owner_module = ctx.module_name,
                    type_params = ff.type_params,
                ))
            _:
                pass
        i += 1


## Resolve a cross-module foreign function call: find a `foreign function` decl
## named `name` in the target module and build its ForeignInfo (mapped C name +
## return type + params) resolved in the owner module's context.  Returns none
## when the target has no such foreign function.
function imported_foreign_call(ctx: ref[LowerCtx], target_module: str, name: str) -> Option[ForeignInfo]:
    let owner_a = find_imported_analysis(ctx, target_module) else:
        return Option[ForeignInfo].none
    var saved_module = ctx.module_name
    var saved_analysis = ctx.analysis
    ctx.module_name = target_module
    ctx.analysis = owner_a
    var result = Option[ForeignInfo].none
    var di: ptr_uint = 0
    while di < owner_a.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(owner_a.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_foreign_function as ff:
                if ff.name == name:
                    let ff_simple = foreign_mapping_is_simple(ff.mapping)
                    var ff_c_name = ""
                    if ff_simple:
                        ff_c_name = resolve_foreign_c_name(ctx, ff.mapping)
                    result = Option[ForeignInfo].some(value = ForeignInfo(
                        c_name = ff_c_name,
                        return_ty = qualify_type(ctx, resolve_type_ref(ctx, ff.return_type)),
                        params = ff.foreign_params,
                        mapping = ff.mapping,
                        simple = ff_simple,
                        owner_module = target_module,
                        type_params = ff.type_params,
                    ))
            _:
                pass
        di += 1
    ctx.module_name = saved_module
    ctx.analysis = saved_analysis
    return result


## Resolve a cross-module external function call: find an `external function`
## decl named `name` in the target module and return its bare C linkage name
## (or `= target` mapping) plus resolved return type.  External functions carry
## no module prefix, so a cross-module call must use this bare name instead of
## `<module>_<name>`.  Returns none when the target has no such external function.
function imported_extern_call(ctx: ref[LowerCtx], target_module: str, name: str) -> Option[ForeignInfo]:
    let owner_a = find_imported_analysis(ctx, target_module) else:
        return Option[ForeignInfo].none
    var saved_module = ctx.module_name
    var saved_analysis = ctx.analysis
    ctx.module_name = target_module
    ctx.analysis = owner_a
    var result = Option[ForeignInfo].none
    var di: ptr_uint = 0
    while di < owner_a.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(owner_a.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_extern_function as ef:
                if ef.name == name:
                    var ret = ctx.void_ty
                    if ef.return_type != null:
                        ret = qualify_type(ctx, resolve_return_type(ctx, Option[analyzer.FnSig].none, ef.return_type))
                    result = Option[ForeignInfo].some(value = ForeignInfo(
                        c_name = extern_c_name(ef.name, ef.mapping),
                        return_ty = ret,
                        params = ef.extern_params,
                        mapping = null,
                        simple = true,
                        owner_module = target_module,
                        type_params = ef.type_params,
                    ))
            _:
                pass
        di += 1
    ctx.module_name = saved_module
    ctx.analysis = saved_analysis
    return result


## The C linkage name of an external function declared in `target_module`,
## honoring a `= c"..."` rename mapping (`external function foo = c"__real"`
## resolves to `__real`).  Returns none when `name` is not an external function
## of that module, so callers can fall back to the bare member name.
function imported_extern_c_name(ctx: ref[LowerCtx], target_module: str, name: str) -> Option[str]:
    let owner_a = find_imported_analysis(ctx, target_module) else:
        return Option[str].none
    var di: ptr_uint = 0
    while di < owner_a.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(owner_a.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_extern_function as ef:
                if ef.name == name:
                    return Option[str].some(value = extern_c_name(ef.name, ef.mapping))
            _:
                pass
        di += 1
    return Option[str].none


## Lower a cross-module external function call.  External functions use their
## bare C name; `out`/`inout` parameters are passed by address (`&arg`) so the C
## function can write back through the pointer, mirroring Ruby's
## lower_foreign_pointer_argument_value.
function lower_extern_call(ctx: ref[LowerCtx], info: ForeignInfo, args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    var ir_args = vec.Vec[ir.Expr].create()
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        var lowered = lower_expr(ctx, arg.arg_value)
        if i < info.params.len:
            var param: ast.ForeignParam
            unsafe:
                param = read(info.params.data + i)
            # Every bare literal takes the parameter's declared type — the raw
            # external call path shares the foreign rule (`c.time(null)` carries
            # `Nullable(ptr[time_t])`; session 44, item 5b).
            lowered = literal_value_to_context_type(ctx, arg.arg_value, foreign_param_context_type(ctx, info, param), lowered)
            if param.param_mode == ast.ForeignParamMode.fmode_out or param.param_mode == ast.ForeignParamMode.fmode_inout:
                # The host's `lower_foreign_pointer_argument_value` (the external
                # call path shares it): the address-of's type is
                # `pointer_to(foreign_slot_boundary_value_type(parameter.type))`,
                # so a nullable pointer-like slot contributes its base
                # (`mt_mutex_create(handle)` with `handle: ptr[mt_mutex]?` gets
                # `ptr[ptr[mt_mutex]]`, not `ptr[ptr[mt_mutex]?]`).
                var slot_ty = foreign_param_context_type(ctx, info, param)
                if types.is_nullable_type(slot_ty) and is_nullable_pointer_like(slot_ty):
                    slot_ty = types.unwrap_nullable(slot_ty)
                let slot_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(qualify_type(ctx, slot_ty)))
                match addr_operand_expression(lowered):
                    Option.some as op:
                        lowered = alloc_expr(ir.Expr.expr_cast(target_type = slot_ptr_ty, expression = op.value, ty = slot_ptr_ty))
                    Option.none:
                        lowered = alloc_expr(ir.Expr.expr_address_of(expression = lowered, ty = slot_ptr_ty))
        unsafe:
            ir_args.push(read(lowered))
        i += 1
    return alloc_expr(ir.Expr.expr_call(callee = info.c_name, arguments = ir_args.as_span(), ty = expr_type(ctx, call_ep)))


## Pre-scan function declarations to record each one's resolved return type in
## ctx.function_returns, so call lowering can use the correct type even when the
## analyzer left it unresolved (tuple returns, array returns, etc.).
function collect_function_returns(ctx: ref[LowerCtx], decls: span[ast.Decl]) -> void:
    var i: ptr_uint = 0
    while i < decls.len:
        var d: ast.Decl
        unsafe:
            d = read(decls.data + i)
        match d:
            ast.Decl.decl_function as fun:
                # A generic function's return type still carries type
                # parameters; resolving it without a substitution context would
                # instantiate bogus concrete types.  Specializations record
                # their own return types.
                if fun.type_params.len == 0:
                    var ret = resolve_return_type(ctx, lookup_fn_sig(ctx, fun.name), fun.return_type)
                    if fun.is_async:
                        ret = make_task_type(ret)
                    ctx.function_returns.set(fun.name, ret)
                    ctx.function_returns.set(naming.qualified_c_name(ctx.module_name, fun.name), ret)
            _:
                pass
        i += 1


## A captured free variable from the enclosing scope, collected for proc
## capture-env struct generation.
struct ProcCapture:
    name: str
    c_name: str
    ty: types.Type
    read_expr: ptr[ir.Expr]


## True when a lowered type represents a proc struct (has invoke/release/retain
## fields), as opposed to a bare fn pointer or a regular struct.
function is_proc_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_named as n:
            return n.name.find_substring("__proc_").is_some() or n.name.starts_with("mt_proc_")
        types.Type.ty_function as fnt:
            return fnt.is_proc
        _:
            return false


## True when a type is an fn (raw C function pointer), not a proc struct.
function is_fn_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_function as fnt:
            return not fnt.is_proc
        _:
            return false


## An empty FnSig used when calling through an fn-typed local — the callee
## is a function pointer already carrying the correct signature at the C level.
function empty_fn_sig() -> Option[analyzer.FnSig]:
    return Option[analyzer.FnSig].none


## Ensure a proc struct declaration exists for the given signature.  Returns the
## proc's own value type (its closure function type) — the struct is a backend
## artifact (`Program.monomorphized_structs`), not the value's IR type.
function proc_ensure_struct_decl(ctx: ref[LowerCtx], struct_name: str, proc_ty: types.Type) -> types.Type:
    # Skip when the proc type contains unresolved type variables (happens
    # inside generic function bodies where T is not yet substituted).
    if proc_type_has_type_var(proc_ty):
        return proc_ty
    ctx.pending_proc_structs.push(proc_struct_decl(struct_name, proc_ty))
    return proc_ty


## Build the concrete proc value struct declaration for a signature: the
## `{ env, invoke, release, retain }` field shape shared by every `mt_proc_*`.
## Kept `LowerCtx`-free so the program-level type-alias pass — which has no
## context of its own — can emit the declaration for proc-typed aliases that
## are never used through `resolve_type_ref`.
function proc_struct_decl(struct_name: str, proc_ty: types.Type) -> ir.StructDecl:
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("void")))
    var struct_fields = vec.Vec[ir.Field].create()
    struct_fields.push(ir.Field(name = "env", ty = void_ptr))
    struct_fields.push(ir.Field(name = "invoke", ty = proc_invoke_field_type(proc_ty)))
    let lifecycle_ty = proc_lifecycle_fn_type()
    struct_fields.push(ir.Field(name = "release", ty = lifecycle_ty))
    struct_fields.push(ir.Field(name = "retain", ty = lifecycle_ty))
    return ir.StructDecl(name = struct_name, linkage_name = struct_name, fields = struct_fields.as_span(), packed = false, alignment = 0, source_module = Option[str].none)


## True when a function type's params or return type contain an unresolved
## type variable or raw type parameter.
function proc_type_has_type_var(proc_ty: types.Type) -> bool:
    match proc_ty:
        types.Type.ty_function as fnt:
            var i: ptr_uint = 0
            while i < fnt.params.len:
                unsafe:
                    if type_contains_type_var(read(fnt.params.data + i)):
                        return true
                i += 1
            unsafe:
                if type_contains_type_var(read(fnt.return_type)):
                    return true
            return false
        _:
            return false


## True when a type contains an unresolved type variable or raw type param.
function type_contains_type_var(t: types.Type) -> bool:
    match t:
        types.Type.ty_var:
            return true
        types.Type.ty_named as n:
            if n.name == "T" or n.name == "U" or n.name == "K" or n.name == "V" or n.name == "E":
                return true
            return false
        types.Type.ty_generic as g:
            var i: ptr_uint = 0
            while i < g.args.len:
                unsafe:
                    if type_contains_type_var(read(g.args.data + i)):
                        return true
                i += 1
            return false
        types.Type.ty_imported as im:
            var i: ptr_uint = 0
            while i < im.args.len:
                unsafe:
                    if type_contains_type_var(read(im.args.data + i)):
                        return true
                i += 1
            return false
        types.Type.ty_nullable as nl:
            return unsafe: type_contains_type_var(read(nl.base))
        _:
            return false


## Lower a proc call `p(arg1, arg2)` to `p.invoke(p.env, arg1, arg2)`.  Since the
## IR's `expr_call` uses a string callee for direct calls, we generate a direct
## call to the invoke function (which is `<struct_name>__invoke`) and pass the
## env member as the first argument.
function lower_proc_call(ctx: ref[LowerCtx], lb: LocalBinding, args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    let recv = lower_binding_read(ctx, lb)
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
    let env_member = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "env", ty = void_ptr))

    # Build arguments: env, then user args.
    var invoke_args = vec.Vec[ir.Expr].create()
    unsafe:
        invoke_args.push(read(env_member))
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        var lowered = lower_expr(ctx, arg.arg_value)
        lowered = literal_value_to_context_type(ctx, arg.arg_value, proc_param_type_at(lb.ty, i), lowered)
        unsafe:
            invoke_args.push(read(lowered))
        i += 1

    # Call through p.invoke (function pointer field).  The C backend renders
    # this as p.invoke(arg0, arg1, ...), a direct call through the member, whose
    # type is the invoke field's own signature (the host's `async_task_call`
    # shape).  The analyzer does not always record a type for a call through a
    # proc VALUE (`let _s = scaler(10.0)` came out void), so fall back to the
    # closure's own signature, which carries the real return type.
    var call_ty = expr_type(ctx, call_ep)
    if is_void_type(call_ty) or types.is_error(call_ty) or is_proc_type(call_ty):
        call_ty = proc_return_type(lb.ty)
    let invoke_field = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "invoke", ty = proc_invoke_field_type(lb.ty)))
    return alloc_expr(ir.Expr.expr_call_indirect(callee = invoke_field, arguments = invoke_args.as_span(), ty = call_ty))


## Lower a call through a proc-typed struct field: `s.field(args)` compiles to
## `s.field.invoke(s.field.env, args)`, analogously to lower_proc_call but for
## struct field receivers instead of local bindings.
function lower_proc_field_call(ctx: ref[LowerCtx], field_expr: ptr[ir.Expr], args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(ctx.void_ty))
    let field_proc_ty = ir_expr_type(field_expr)
    let env_member = alloc_expr(ir.Expr.expr_member(receiver = field_expr, member = "env", ty = void_ptr))
    var invoke_args = vec.Vec[ir.Expr].create()
    unsafe:
        invoke_args.push(read(env_member))
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        var lowered = lower_expr(ctx, arg.arg_value)
        lowered = literal_value_to_context_type(ctx, arg.arg_value, proc_param_type_at(field_proc_ty, i), lowered)
        unsafe:
            invoke_args.push(read(lowered))
        i += 1
    # As in `lower_proc_call`: a call through a proc-typed field may not have a
    # recorded type, so take the return type from the field's own signature, and
    # type the `invoke` member with its field signature.
    var call_ty = expr_type(ctx, call_ep)
    if is_void_type(call_ty) or types.is_error(call_ty) or is_proc_type(call_ty):
        call_ty = proc_return_type(field_proc_ty)
    let invoke_field = alloc_expr(ir.Expr.expr_member(receiver = field_expr, member = "invoke", ty = proc_invoke_field_type(field_proc_ty)))
    return alloc_expr(ir.Expr.expr_call_indirect(callee = invoke_field, arguments = invoke_args.as_span(), ty = call_ty))


## Lower a call through an fn-typed struct field: `s.field(args)` compiles to
## a direct call through the function pointer `s.field(args)`.
function lower_fn_field_call(ctx: ref[LowerCtx], field_expr: ptr[ir.Expr], args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    var call_args = vec.Vec[ir.Expr].create()
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        let lowered = lower_expr(ctx, arg.arg_value)
        unsafe:
            call_args.push(read(lowered))
        i += 1
    var call_ty = expr_type(ctx, call_ep)
    match ir_expr_type(field_expr):
        types.Type.ty_function as ffn:
            call_ty = unsafe: read(ffn.return_type)
        _:
            pass
    return alloc_expr(ir.Expr.expr_call_indirect(callee = field_expr, arguments = call_args.as_span(), ty = call_ty))


## The resolved return type of a module function: recorded during pre-scan
## (handles tuple/array returns the analyzer can't resolve), else the
## analyzer's best guess.
function function_return_type(ctx: ref[LowerCtx], name: str) -> types.Type:
    let ret_ptr = ctx.function_returns.get(name)
    if ret_ptr != null:
        unsafe:
            return read(ret_ptr)
    return fn_sig_return_type(lookup_fn_sig(ctx, name))


## The C name an external function maps to: its explicit `= c.name` mapping value
## when present, else the declaration name itself.
function extern_c_name(name: str, mapping: ptr[ast.Expr]?) -> str:
    let m = mapping else:
        return name
    unsafe:
        match read(m):
            ast.Expr.expr_identifier as id:
                return id.name
            ast.Expr.expr_member_access as ma:
                return ma.member_name
            ast.Expr.expr_string_literal as s:
                return s.value
            _:
                return name


## The C name a foreign function maps to: resolve its `= target` identifier
## through the external registry (so `= atoi` yields the external's C name),
## falling back to the target name.  A `= c.Name` member mapping resolves the
## receiver alias to its module and honors the external function's own
## `= c"..."` rename there (so `= c.tracy_emit_zone_begin` yields
## `___tracy_emit_zone_begin`), mirroring Ruby's external_function_c_name.
## Complex inline mapping expressions are handled by
## lower_inline_foreign_mapping instead; this resolver only needs the
## bare-name forms and returns "" for anything else.
function resolve_foreign_c_name(ctx: ref[LowerCtx], mapping: ptr[ast.Expr]) -> str:
    unsafe:
        match read(mapping):
            ast.Expr.expr_identifier as id:
                let ext = ctx.extern_map.get(id.name)
                if ext != null:
                    return read(ext)
                return id.name
            ast.Expr.expr_member_access as ma:
                match read(ma.receiver):
                    ast.Expr.expr_identifier as recv_id:
                        let mod_ptr = ctx.analysis.imports.get(recv_id.name)
                        if mod_ptr != null:
                            match imported_extern_c_name(ctx, read(mod_ptr), ma.member_name):
                                Option.some as renamed:
                                    return renamed.value
                                Option.none:
                                    pass
                    _:
                        pass
                return ma.member_name
            ast.Expr.expr_prefix_cast as pc:
                return resolve_foreign_c_name(ctx, pc.expression)
            ast.Expr.expr_call as call:
                return resolve_foreign_c_name(ctx, call.callee)
            _:
                return ""


## True when a foreign `= target` mapping is a bare name (`= atoi`,
## `= c.InitWindow`): the call then lowers 1:1 through the mapped C function.
## Call, cast, and construction mappings are inline expressions that must be
## expanded with argument substitution instead.
function foreign_mapping_is_simple(mapping: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(mapping):
            ast.Expr.expr_identifier:
                return true
            ast.Expr.expr_member_access as ma:
                # `c.Name` is a simple 1:1 mapping; `c.Call(...).field` is an
                # inline mapping (field access on a call result), so it is simple
                # only when its receiver is a bare module-alias identifier.
                match read(ma.receiver):
                    ast.Expr.expr_identifier:
                        return true
                    _:
                        return false
            _:
                return false


## The resolved type of `member` on a receiver that is an instance of a struct
## defined in ANOTHER module.  The analyzer stores field types with names bare
## relative to their defining module, so qualifying them in the accessing
## module's context mis-attributes them (ir.Program.functions -> a Function type
## prefixed with the caller's module).  Resolve the field's declared type ref in
## the owner module's context instead.  Returns none for same-module receivers
## (handled by the recorded type) and non-struct receivers.
## Member access: enum / flags member constants on a type-name receiver
## (`State.running` -> `en_State_running`), otherwise a struct field access
## (`p.x`).  Method calls are resolved through `lower_method_resolved` and
## `lower_dyn_method_call`; other member forms (atomic, str_buffer, event) are
## dispatched by their type.
function imported_field_type(ctx: ref[LowerCtx], recv_ty: types.Type, member: str) -> Option[types.Type]:
    var base = recv_ty
    if types.is_nullable_type(base):
        base = types.unwrap_nullable(base)
    if types.is_raw_pointer(base) or types.is_ref_type(base) or types.is_own_type(base):
        base = types.pointer_element(base)
    if types.is_nullable_type(base):
        base = types.unwrap_nullable(base)
    var owner_module: str
    var struct_name: str
    match base:
        types.Type.ty_imported as im:
            if im.args.len > 0:
                return Option[types.Type].none
            owner_module = im.module_name
            struct_name = im.name
        _:
            return Option[types.Type].none
    if owner_module == ctx.module_name:
        # A local struct that `qualify_type` rewrote to `ty_imported(current_module, ...)`:
        # resolve its field type in the current context directly (no owner swap).
        # This recovers field types the analyzer did not record (e.g. `.name` on a
        # `read(ptr[LocalStruct])` receiver) so chained calls like ` == ...` bind.
        let local_tref = find_struct_field_tref(ctx.analysis.source_file, struct_name, member) else:
            return Option[types.Type].none
        return Option[types.Type].some(value = qualify_type(ctx, resolve_field_type_ref(ctx, local_tref)))
    let owner_a = find_imported_analysis(ctx, owner_module) else:
        return Option[types.Type].none
    let field_tref = find_struct_field_tref(owner_a.source_file, struct_name, member) else:
        return Option[types.Type].none
    # Resolve the field type ref in the owner module's context so its bare type
    # names qualify against the owner module rather than the current one.
    var saved_module = ctx.module_name
    var saved_analysis = ctx.analysis
    ctx.module_name = owner_module
    ctx.analysis = owner_a
    let resolved = qualify_type(ctx, resolve_field_type_ref(ctx, field_tref))
    ctx.module_name = saved_module
    ctx.analysis = saved_analysis
    return Option[types.Type].some(value = resolved)


## The declared type ref of a struct's field, looked up in a module's AST.
function find_struct_field_tref(sf: ast.SourceFile, struct_name: str, member: str) -> Option[ast.TypeRef]:
    var di: ptr_uint = 0
    while di < sf.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(sf.declarations.data + di)
        match d:
            ast.Decl.decl_struct as s:
                if s.name == struct_name:
                    var fi: ptr_uint = 0
                    while fi < s.struct_fields.len:
                        var f: ast.Field
                        unsafe:
                            f = read(s.struct_fields.data + fi)
                        if f.name == member:
                            return Option[ast.TypeRef].some(value = f.field_type)
                        fi += 1
            _:
                pass
        di += 1
    return Option[ast.TypeRef].none


## The receiver type for a method call `receiver.method(...)`.  The analyzer's
## recorded type (via `expr_type`) drops the defining module from cross-module
## struct field types (e.g. `analysis.functions` records `Map[str, FnSig]` with a
## bare `FnSig`, which would then mis-qualify to the current module).  When the
## receiver is a member access or identifier (both side-effect-free to lower), the
## lowered IR type resolves fields in their owner module's context
## (`imported_field_type`), so prefer it; fall back to `expr_type` otherwise.
function method_receiver_type(ctx: ref[LowerCtx], receiver: ptr[ast.Expr]) -> types.Type:
    var side_effect_free = false
    unsafe:
        match read(receiver):
            ast.Expr.expr_member_access:
                side_effect_free = true
            ast.Expr.expr_identifier:
                side_effect_free = true
            ast.Expr.expr_call as call:
                # A chained method call receiver, e.g. `result.as_str().byte_at(i)`.
                # Typing it by lowering the inner call is safe here: the receiver is
                # lowered identically when the outer call is emitted, so no extra
                # side effect is introduced.  This lets a method call on a
                # call-result value resolve instead of falling to the `mt_` fallback.
                # Also covers the `read(ptr).method(...)` builtin projection, whose
                # callee is a bare `read` identifier rather than a member access.
                match read(call.callee):
                    ast.Expr.expr_member_access:
                        side_effect_free = true
                    ast.Expr.expr_identifier as call_id:
                        if call_id.name == "read":
                            side_effect_free = true
                    _:
                        pass
            _:
                pass
    if side_effect_free:
        # Type the receiver without leaving side effects: the setup statements,
        # cleanups, temp names and dynamic-format counters are restored, and
        # the real lowering below (in the call path) reproduces them once.
        let saved_setup = suspend_stmt_setup(ctx)
        let saved_temp = ctx.temp_counter
        let saved_fmt_dest = ctx.fmt_dest_name
        let saved_fmt_visible = ctx.fmt_counter_visible
        var saved_fmt_n: ptr_uint = 0
        let saved_n_ptr = ctx.fmt_counter.get(ctx.fmt_dest_name)
        if saved_n_ptr != null:
            saved_fmt_n = unsafe: read(saved_n_ptr)
        let lowered_ty = ir_expr_type(lower_expr(ctx, receiver))
        resume_stmt_setup(ctx, saved_setup)
        ctx.temp_counter = saved_temp
        ctx.fmt_dest_name = saved_fmt_dest
        ctx.fmt_counter_visible = saved_fmt_visible
        ctx.fmt_counter.set(ctx.fmt_dest_name, saved_fmt_n)
        if not types.is_error(lowered_ty) and not types.type_to_string(lowered_ty) == "void":
            return lowered_ty
    return expr_type(ctx, receiver)


function lower_member_access(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], member: str, ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    match inline_for_member_subst(ctx, receiver, member):
        Option.some as subst:
            return subst.value
        Option.none:
            pass
    unsafe:
        match read(receiver):
            ast.Expr.expr_identifier as id:
                # A no-payload variant arm constructor, e.g. `Token.eof`.
                if ctx.variants.contains(id.name):
                    return alloc_expr(ir.Expr.expr_variant_literal(
                        ty = types.Type.ty_imported(module_name = ctx.module_name, name = id.name, args = span[types.Type]()),
                        arm_name = member,
                        fields = span[ir.AggregateField](),
                    ))
                # Synthetic type names (e.g. `EventError.full`) — map to C
                # constant `<Type>_<member>`.
                if id.name == "EventError" and member == "full":
                    return alloc_expr(ir.Expr.expr_name(
                        name = "EventError_full",
                        ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = "EventError"),
                        pointer = Option[bool].some(value = false),
                    ))
                if ctx.analysis.static_member_types.contains(id.name):
                    var member_ty = expr_type(ctx, ep)
                    match member_ty:
                        types.Type.ty_error:
                            # Const initializers can miss the analyzer's type map;
                            # a static member's type is its declaring type.
                            member_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = ctx.module_name, name = id.name)
                        _:
                            pass
                    return alloc_expr(ir.Expr.expr_name(
                        name = naming.qualified_member_c_name(ctx.module_name, id.name, member),
                        ty = member_ty,
                        pointer = Option[bool].some(value = false),
                    ))
                # Resolve `import_alias.member` through the imported module.
                let mod_ptr = ctx.analysis.imports.get(id.name)
                if mod_ptr != null:
                    let target_module = read(mod_ptr)
                    match find_imported_analysis(ctx, target_module):
                        Option.some as imported:
                            if imported.value.type_names.contains(member):
                                let c_name = imported_member_c_name(ctx, imported.value, target_module, member)
                                var member_ty = expr_type(ctx, ep)
                                # If the member is a re-exported type alias, use
                                # the originating module's type so c_type() produces
                                # the correct C name.
                                let opt_alias = resolve_single_imported_type(ctx, target_module, member)
                                match opt_alias:
                                    Option.some as resolved:
                                        member_ty = resolved.value
                                    Option.none:
                                        pass
                                return alloc_expr(ir.Expr.expr_name(
                                    name = c_name,
                                    ty = member_ty,
                                    pointer = Option[bool].some(value = false),
                                ))
                            if imported.value.value_types.contains(member):
                                let c_name = imported_member_c_name(ctx, imported.value, target_module, member)
                                return alloc_expr(ir.Expr.expr_name(
                                    name = c_name,
                                    ty = expr_type(ctx, ep),
                                    pointer = Option[bool].some(value = false),
                                ))
                        Option.none:
                            pass
            ast.Expr.expr_specialization as spec:
                # No-payload generic variant arm, e.g. `Option[int].none`.
                if spec.arguments.len > 0:
                    var spec_variant_name: Option[str] = Option[str].none
                    match read(spec.callee):
                        ast.Expr.expr_identifier as spec_id:
                            # The declaration is authoritative: a prelude variant
                            # may never have been registered, and a user-defined
                            # generic one only from the declaring module.
                            if ctx.variants.contains(spec_id.name) or variant_declaring_module(ctx, spec_id.name).is_some():
                                spec_variant_name = Option[str].some(value = spec_id.name)
                        ast.Expr.expr_member_access as spec_ma:
                            # Module-qualified: `types.Maybe[int].none`.
                            match read(spec_ma.receiver):
                                ast.Expr.expr_identifier as spec_mod_id:
                                    let spec_mod_ptr = ctx.analysis.imports.get(spec_mod_id.name)
                                    if spec_mod_ptr != null:
                                        match find_imported_analysis(ctx, unsafe: read(spec_mod_ptr)):
                                            Option.some as spec_imported:
                                                if variant_in_source(spec_imported.value, spec_ma.member_name):
                                                    spec_variant_name = Option[str].some(value = spec_ma.member_name)
                                            Option.none:
                                                pass
                                _:
                                    pass
                        _:
                            pass
                    match spec_variant_name:
                        Option.some as svn:
                            var concrete_args = vec.Vec[types.Type].create()
                            var ai: ptr_uint = 0
                            while ai < spec.arguments.len:
                                # Qualify args to match the signature's C name
                                # (see lower_generic_variant_literal), so a local
                                # struct arg like RemovedEntry becomes module-qualified.
                                concrete_args.push(qualify_type(ctx, resolve_type_ref(ctx, read(spec.arguments.data + ai).value)))
                                ai += 1
                            let variant_ty = generic_variant_instance_type(ctx, svn.value, concrete_args.as_span())
                            return alloc_expr(ir.Expr.expr_variant_literal(
                                ty = variant_ty,
                                arm_name = member,
                                fields = span[ir.AggregateField](),
                            ))
                        Option.none:
                            pass
            ast.Expr.expr_member_access as inner_ma:
                match read(inner_ma.receiver):
                    ast.Expr.expr_identifier as inner_id:
                        let mod_ptr = ctx.analysis.imports.get(inner_id.name)
                        if mod_ptr != null:
                            let target_module = read(mod_ptr)
                            match find_imported_analysis(ctx, target_module):
                                Option.some as imported:
                                    if imported.value.static_member_types.contains(inner_ma.member_name) or imported.value.type_names.contains(inner_ma.member_name):
                                        match find_imported_variant_arm(imported.value, member):
                                            Option.some as var_name:
                                                let var_ty = types.Type.ty_imported(module_name = target_module, name = var_name.value, args = span[types.Type]())
                                                return alloc_expr(ir.Expr.expr_variant_literal(
                                                    ty = var_ty,
                                                    arm_name = member,
                                                    fields = span[ir.AggregateField](),
                                                ))
                                            Option.none:
                                                var use_bare = target_module.starts_with("std.c.")
                                                if not use_bare and imported.value.type_alias_types.contains(inner_ma.member_name):
                                                    let aliased_ptr = imported.value.type_alias_types.get(inner_ma.member_name) else:
                                                        fatal(c"lowering: enum type alias inconsistency")
                                                    let aliased = unsafe: read(aliased_ptr)
                                                    if type_is_from_std_c(aliased):
                                                        use_bare = true
                                                var member_c_name = member
                                                if not use_bare:
                                                    member_c_name = naming.qualified_member_c_name(target_module, inner_ma.member_name, member)
                                                return alloc_expr(ir.Expr.expr_name(
                                                    name = member_c_name,
                                                    ty = expr_type(ctx, ep),
                                                    pointer = Option[bool].some(value = false),
                                                ))
                                Option.none:
                                    pass
                    _:
                        pass
            _:
                pass
    # SoA index+member swap: `particles[0].x` → `particles.x[0]` (mirrors
    # Ruby's lower_soa_indexed_field_access).  Detect when the member access
    # receiver is an index into an SoA type, and lower the field access first.
    unsafe:
        match read(receiver):
            ast.Expr.expr_index_access as ix:
                let base_ty = index_receiver_type(ctx, ix.receiver)
                if is_soa_type(base_ty):
                    let soa_base = lower_expr(ctx, ix.receiver)
                    let idx = lower_expr(ctx, ix.index)
                    # The swapped member is the SoA struct's array field; the
                    # index then selects the lane (the host's
                    # `lower_soa_indexed_field_access` types the member with
                    # `soa_type.fields[field]`, i.e. `array[T, N]`).
                    var field_ty = soa_field_type(ctx, base_ty, member)
                    match soa_member_array_type(ctx, base_ty, member):
                        Option.some as at:
                            field_ty = at.value
                        Option.none:
                            pass
                    let member_expr = alloc_expr(ir.Expr.expr_member(
                        receiver = soa_base,
                        member = member,
                        ty = field_ty,
                    ))
                    return alloc_expr(ir.Expr.expr_index(
                        receiver = member_expr,
                        index = idx,
                        ty = expr_type(ctx, ep),
                    ))
            _:
                pass
    let recv = lower_expr(ctx, receiver)
    var member_ty = expr_type(ctx, ep)
    let recv_ty = ir_expr_type(recv)
    # A `ref` receiver auto-dereferences for member access (matching the host's
    # `unwrap_ref`), so `.data`/`.len` on `ref[span[T]]` must be typed against
    # the referent `span[T]`.
    var member_recv_ty = recv_ty
    if types.is_ref_type(member_recv_ty):
        member_recv_ty = types.pointer_element(member_recv_ty)
    # span synthetic fields: `.data` is ptr[element], `.len` is ptr_uint.  The
    # analyzer records these as ty_error (permissive), so type them here.
    if is_span_type(member_recv_ty) and member == "data":
        member_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.pointer_element(member_recv_ty)))
    else if is_span_type(member_recv_ty) and member == "len":
        member_ty = types.primitive("ptr_uint")
    # str synthetic fields: `.data` is ptr[char], `.len` is ptr_uint.  Like span,
    # the analyzer does not type these reliably (a `var n = text.len` would
    # otherwise be mis-typed as str).
    else if is_str_typed(member_recv_ty) and member == "data":
        member_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("char")))
    else if is_str_typed(member_recv_ty) and member == "len":
        member_ty = types.primitive("ptr_uint")
    # SoA synthetic fields: `points.x` is the per-lane array
    # `array[<element field type>, N]` (the host's `Types::SoA#field`).
    else if is_soa_type(member_recv_ty):
        match soa_member_array_type(ctx, member_recv_ty, member):
            Option.some as sat:
                member_ty = sat.value
            Option.none:
                pass
    # vec/mat/quat field types: the analyzer doesn't record these reliably
    # since these are builtin types, not declared structs.
    else if is_vec_math_name(nominal_type_name(member_recv_ty)):
        let vname = nominal_type_name(member_recv_ty)
        var field_names = vec.Vec[str].create()
        var field_types = vec.Vec[types.Type].create()
        vec_math_fields(vname, ref_of(field_names), ref_of(field_types))
        var fi: ptr_uint = 0
        var found = false
        while fi < field_names.len():
            let fn_ptr = field_names.get(fi) else:
                fatal(c"lower_member_access: missing vec field name")
            if unsafe: read(fn_ptr) == member:
                let ft_ptr = field_types.get(fi) else:
                    fatal(c"lower_member_access: missing vec field type")
                member_ty = unsafe: read(ft_ptr)
                found = true
                break
            fi += 1
        if not found:
            pass
    else:
        # Prefer the receiver's concrete (monomorphized) struct field type: the
        # analyzer records member types generically (e.g. Node[K,V] -> Node with
        # the args dropped), so inside a monomorphized method the recorded type
        # loses its arguments.  The concrete struct declaration carries the
        # resolved field type.
        match concrete_field_type(ctx, recv_ty, member):
            Option.some as ft:
                member_ty = ft.value
            Option.none:
                match arm_payload_field_type(ctx, recv_ty, member):
                    Option.some as aft:
                        member_ty = aft.value
                    Option.none:
                        match imported_field_type(ctx, recv_ty, member):
                            Option.some as ift:
                                member_ty = ift.value
                            Option.none:
                                if types.is_error(member_ty) or is_tuple_type(member_ty):
                                    if is_tuple_type(recv_ty):
                                        match recv_ty:
                                            types.Type.ty_tuple as tup:
                                                match tup.field_names:
                                                    Option.some as fnames:
                                                        var fi: ptr_uint = 0
                                                        while fi < fnames.value.len:
                                                            if unsafe: read(fnames.value.data + fi) == member:
                                                                if fi < tup.elements.len:
                                                                    member_ty = unsafe: read(tup.elements.data + fi)
                                                                break
                                                            fi += 1
                                                    Option.none:
                                                        let index = parse_tuple_member_index(member)
                                                        member_ty = tuple_element_type(recv_ty, index)
                                            _:
                                                pass
    # An event field is stored under its hidden C name (`__event_<name>`) and
    # typed as the event, as the host's `event_member_from_owner_type` routes it
    # through the receiver struct's own event map.
    var member_name = member
    var member_type = member_ty
    match event_info_for_receiver(ctx, recv_ty, member):
        Option.some as evi:
            member_name = j2("__event_", member)
            var ev_info = ensure_event_runtime(ctx, evi.value.owner_type_name, member)
            var ev_payload: ptr[types.Type]? = null
            if ev_info.has_payload:
                ev_payload = types.alloc_type(ev_info.payload_type)
            member_type = types.Type.ty_event(
                name = evi.value.name,
                capacity = ev_info.capacity,
                payload_type = ev_payload,
                linkage_name = ev_info.event_c_name,
            )
        Option.none:
            # A member already typed as an event (an imported event, a
            # module-level registration) keeps its bare-name resolution.
            if is_event_type(ctx, member_ty):
                member_name = j2("__event_", member)
                let ev_name = event_name_from_type(member_ty)
                if ctx.analysis.events.contains(ev_name):
                    var ev_info = ensure_event_runtime(ctx, "", ev_name)
                    var ev_payload: ptr[types.Type]? = null
                    if ev_info.has_payload:
                        ev_payload = types.alloc_type(ev_info.payload_type)
                    member_type = types.Type.ty_event(
                        name = ev_name,
                        capacity = ev_info.capacity,
                        payload_type = ev_payload,
                        linkage_name = ev_info.event_c_name,
                    )
    var result = alloc_expr(ir.Expr.expr_member(
        receiver = recv,
        member = member_name,
        ty = qualify_type(ctx, member_type),
    ))
    # Auto-dereference recursive variant fields (e.g. bin.left where left
    # is stored as Expr* in C to avoid infinite struct size).
    # Only applicable when recv_ty is a variant arm payload struct.
    match recv_ty:
        types.Type.ty_named as rn:
            if ctx.arm_payload_fields.contains(rn.name):
                if is_recursive_variant_field(recv_ty, member_ty):
                    return alloc_expr(ir.Expr.expr_unary(operator = "*", operand = result, ty = member_ty))
        types.Type.ty_imported as ri:
            if ctx.arm_payload_fields.contains(naming.qualified_c_name(ri.module_name, ri.name)):
                if is_recursive_variant_field(recv_ty, member_ty):
                    return alloc_expr(ir.Expr.expr_unary(operator = "*", operand = result, ty = member_ty))
        types.Type.ty_variant_arm_payload:
            if is_recursive_variant_field(recv_ty, member_ty):
                return alloc_expr(ir.Expr.expr_unary(operator = "*", operand = result, ty = member_ty))
        _:
            pass
    return result


## The resolved type of `member` on a receiver whose type is a concrete
## monomorphized generic struct.  Looks the field up in the receiver struct's
## emitted declaration (keyed by concrete C name), auto-dereferencing a pointer
## or ref receiver.  Returns none for non-generic structs (handled by the
## analyzer's recorded member type) or unknown fields.
function concrete_field_type(ctx: ref[LowerCtx], recv_ty: types.Type, member: str) -> Option[types.Type]:
    var base = recv_ty
    if types.is_nullable_type(base):
        base = types.unwrap_nullable(base)
    if types.is_raw_pointer(base) or types.is_ref_type(base) or types.is_own_type(base):
        base = types.pointer_element(base)
    var struct_name: str
    var owner_module: str = ""
    # `generic_struct_decls` is keyed by the concrete C name, so a generic
    # instance receiver (`Vec[int]`) must be looked up under its mangled name.
    var lookup_name: str = ""
    match base:
        types.Type.ty_named as n:
            struct_name = n.name
            lookup_name = n.name
        types.Type.ty_imported as im:
            struct_name = im.name
            owner_module = im.module_name
            if im.args.len > 0:
                lookup_name = naming.qualified_c_name(im.module_name, generic_struct_c_name(im.name, im.args))
            else:
                lookup_name = im.name
        types.Type.ty_generic as g:
            # A receiver still in generic form (`PipelineStep[int]`): create its
            # concrete declaration and look the field up there, so a proc field's
            # type parameters are substituted (the host's instance types).
            if g.args.len == 0:
                return Option[types.Type].none
            let concrete = try_monomorphize_generic(ctx, g.name, g.args)
            match concrete:
                types.Type.ty_named:
                    return concrete_field_type(ctx, concrete, member)
                types.Type.ty_imported:
                    return concrete_field_type(ctx, concrete, member)
                _:
                    return Option[types.Type].none
        _:
            return Option[types.Type].none
    let decl_ptr = ctx.generic_struct_decls.get(lookup_name)
    if decl_ptr != null:
        unsafe:
            let decl = read(decl_ptr)
            var i: ptr_uint = 0
            while i < decl.fields.len:
                let f = read(decl.fields.data + i)
                if f.name == member:
                    return Option[types.Type].some(value = f.ty)
                i += 1
    # Non-generic struct: search current and imported module analyses.  When
    # the receiver type names its owning module, resolve the struct in that
    # module's analysis first — the bare-name program scan below is
    # order-dependent and can hit an unrelated struct with the same name from
    # another module (e.g. std.map.Entry shadowing std.json.Entry).
    var raw_fields: ptr[span[analyzer.FieldEntry]]? = null
    if owner_module != "" and owner_module != ctx.module_name:
        match find_imported_analysis(ctx, owner_module):
            Option.some as owner_a:
                raw_fields = owner_a.value.structs.get(struct_name)
            Option.none:
                pass
    if raw_fields == null:
        raw_fields = ctx.analysis.structs.get(struct_name)
    if raw_fields == null:
        var ai: ptr_uint = 0
        while ai < ctx.program_analyses.len and raw_fields == null:
            var a: analyzer.Analysis
            unsafe:
                a = read(ctx.program_analyses.data + ai)
            raw_fields = a.structs.get(struct_name)
            ai += 1
    if raw_fields != null:
        let entries = unsafe: read(raw_fields)
        var ei: ptr_uint = 0
        while ei < entries.len:
            let entry = unsafe: read(entries.data + ei)
            if entry.name == member:
                # When the struct lives in a different module, qualify
                # the field type in that module's context so bare type
                # names resolve to the correct C module name.
                var ft = entry.ty
                match base:
                    types.Type.ty_imported as base_im:
                        if base_im.module_name != ctx.module_name:
                            match find_imported_analysis(ctx, base_im.module_name):
                                Option.some as owner_a:
                                    var saved_module = ctx.module_name
                                    var saved_analysis = ctx.analysis
                                    ctx.module_name = base_im.module_name
                                    ctx.analysis = owner_a.value
                                    ft = qualify_type(ctx, ft)
                                    ctx.module_name = saved_module
                                    ctx.analysis = saved_analysis
                                Option.none:
                                    pass
                    _:
                        pass
                return Option[types.Type].some(value = ft)
            ei += 1
    return Option[types.Type].none


## Extract the integer index from a tuple field name `_0`, `_1`, ...
function parse_tuple_member_index(member: str) -> ptr_uint:
    if member.len < 2:
        return 0
    if member.byte_at(0) != '_':
        return 0
    var result: ptr_uint = 0
    var i: ptr_uint = 1
    while i < member.len:
        let b = member.byte_at(i)
        if b < '0' or b > '9':
            break
        result = result * 10 + ptr_uint<-(b - '0')
        i += 1
    return result


function is_tuple_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_tuple:
            return true
        _:
            return false


## Lower a struct declaration to an IR StructDecl, resolving its fields from the
## analyzer's struct table (which carries resolved field types) and qualifying
## named field types with the current module for backend C-naming.
## Map raw-module opaque named types (declared `opaque X`) to `Types::Opaque`
## so the IR matches the host, recursing through generic arguments and nullable
## bases.  The analyzer resolves such names as ordinary imported types.
function opaqueify_type(ctx: ref[LowerCtx], ty: types.Type) -> types.Type:
    match ty:
        types.Type.ty_imported as im:
            if im.args.len == 0:
                if find_imported_opaque_decl(ctx, im.module_name, im.name):
                    return types.Type.ty_opaque(module_name = im.module_name, name = im.name)
                return ty
            var iargs = vec.Vec[types.Type].create()
            var ii: ptr_uint = 0
            while ii < im.args.len:
                iargs.push(opaqueify_type(ctx, unsafe: read(im.args.data + ii)))
                ii += 1
            return types.Type.ty_imported(module_name = im.module_name, name = im.name, args = iargs.as_span())
        types.Type.ty_named as n:
            let owner = if n.module_name.len > 0: n.module_name else: ctx.module_name
            if find_imported_opaque_decl(ctx, owner, n.name):
                return types.Type.ty_opaque(module_name = owner, name = n.name)
            return ty
        types.Type.ty_generic as g:
            if g.args.len == 0:
                return ty
            var gargs = vec.Vec[types.Type].create()
            var gi: ptr_uint = 0
            while gi < g.args.len:
                gargs.push(opaqueify_type(ctx, unsafe: read(g.args.data + gi)))
                gi += 1
            return types.Type.ty_generic(name = g.name, args = gargs.as_span())
        types.Type.ty_nullable as nl:
            let base = opaqueify_type(ctx, unsafe: read(nl.base))
            return types.Type.ty_nullable(base = types.alloc_type(base))
        _:
            return ty


function lower_struct_decl(ctx: ref[LowerCtx], name: str, packed: bool, alignment: int, qualified: Option[str], linkage_base: str) -> Option[ir.StructDecl]:
    var fields_ptr: ptr[span[analyzer.FieldEntry]]? = null
    # The owner segment of the struct's events: the declared path sanitized the
    # way the host's `Types::Event#linkage_name` sanitizes `owner_type_name`
    # (`Container.Inner` -> `Container_Inner`).
    var owner = naming.sanitize_event_part(name)
    match qualified:
        Option.some as qn:
            owner = naming.sanitize_event_part(qn.value)
            fields_ptr = ctx.analysis.structs.get(qn.value)
        Option.none:
            pass
    if fields_ptr == null:
        fields_ptr = ctx.analysis.structs.get(name)
    let resolved_fields = fields_ptr else:
        return Option[ir.StructDecl].none
    let entries = unsafe: read(resolved_fields)
    var ir_fields = vec.Vec[ir.Field].create()
    var i: ptr_uint = 0
    while i < entries.len:
        var entry: analyzer.FieldEntry
        unsafe:
            entry = read(entries.data + i)
        var fty = entry.ty
        var fname = entry.name
        # An event field is stored under its hidden C name
        # (`__event_<name>`) with the event type, as the host's
        # `lower_struct_decl` emits it (`Types::Event#hidden_field_name`).
        match fty:
            types.Type.ty_named as nt:
                match event_info_for_owner(ctx, owner, nt.name):
                    Option.some as evi:
                        var info = ensure_event_runtime(ctx, evi.value.owner_type_name, nt.name)
                        var ev_payload: ptr[types.Type]? = null
                        if info.has_payload:
                            ev_payload = types.alloc_type(info.payload_type)
                        fty = types.Type.ty_event(
                            name = nt.name,
                            capacity = info.capacity,
                            payload_type = ev_payload,
                            linkage_name = info.event_c_name,
                        )
                        fname = j2("__event_", nt.name)
                    Option.none:
                        pass
            _:
                pass
        # A `str_buffer[N]` used only as a struct field still needs its backing
        # struct emitted, otherwise the field has an incomplete type in C.
        match fty:
            types.Type.ty_generic as g:
                if g.name == "str_buffer":
                    ensure_str_buffer_struct(ctx, fty)
            _:
                pass
        ir_fields.push(ir.Field(name = fname, ty = qualify_type(ctx, opaqueify_type(ctx, fty))))
        i += 1
    return Option[ir.StructDecl].some(value = ir.StructDecl(
        name = name,
        linkage_name = naming.qualified_c_name(ctx.module_name, linkage_base),
        fields = ir_fields.as_span(),
        packed = packed,
        alignment = alignment,
        source_module = Option[str].some(value = ctx.module_name),
    ))

function lower_nested_struct_decls(ctx: ref[LowerCtx], nested: span[ast.Decl], parent_name: str, parent_linkage: str, structs: ref[vec.Vec[ir.StructDecl]]) -> void:
    var i: ptr_uint = 0
    while i < nested.len:
        var d: ast.Decl
        unsafe:
            d = read(nested.data + i)
        match d:
            ast.Decl.decl_struct as s:
                if s.type_params.len == 0:
                    # A nested struct's C name carries its parents
                    # (`<mod>_Rectangle_Edge`) while the IR `:name` stays plain —
                    # the host's `resolve_nested_struct_fields` qualified name,
                    # flattened for C.
                    let qname = j3(parent_name, ".", s.name)
                    let qlink = j3(parent_linkage, "_", s.name)
                    match lower_struct_decl(ctx, s.name, s.packed, s.alignment, Option[str].some(value = qname), qlink):
                        Option.some as sd:
                            structs.push(sd.value)
                        Option.none:
                            pass
                    lower_nested_struct_decls(ctx, s.nested_types, qname, qlink, structs)
            _:
                pass
        i += 1


## Lower a union declaration to an IR UnionDecl, resolving field types from the
## declaration (unions are not tracked in the analyzer's struct table).
function lower_union_decl(ctx: ref[LowerCtx], name: str, fields: span[ast.Field]) -> ir.UnionDecl:
    var ir_fields = vec.Vec[ir.Field].create()
    var i: ptr_uint = 0
    while i < fields.len:
        var f: ast.Field
        unsafe:
            f = read(fields.data + i)
        ir_fields.push(ir.Field(name = f.name, ty = resolve_field_type_ref(ctx, f.field_type)))
        i += 1
    return ir.UnionDecl(
        name = name,
        linkage_name = naming.qualified_c_name(ctx.module_name, name),
        fields = ir_fields.as_span(),
        source_module = Option[str].some(value = ctx.module_name),
    )


# =============================================================================
#  Variant declarations (mirrors lowering/declarations.rb lower_variants)
# =============================================================================

## Register the prelude types (Option[T], Result[T,E]) in the variant registry so
## arm constructors `Option.some(value = ...)` and match on Option/Result
## scrutinees can resolve arm names and payload fields.  User-declared variants
## of the same name take priority (matching the analyzer's policy).
function install_prelude_variants(ctx: ref[LowerCtx]) -> void:
    if not ctx.variants.contains("Option"):
        ctx.variants.set("Option", prelude_option_info())
    if not ctx.variants.contains("Result"):
        ctx.variants.set("Result", prelude_result_info())


function prelude_option_info() -> VariantInfo:
    var arms = vec.Vec[VariantArmInfo].create()
    arms.push(VariantArmInfo(
        name = "some",
        field_names = sp_str("value"),
        field_types = sp_str_type("_phantom"),
    ))
    arms.push(VariantArmInfo(name = "none", field_names = span[str](), field_types = span[types.Type]()))
    return VariantInfo(module_name = "", arms = arms.as_span())


function prelude_result_info() -> VariantInfo:
    var arms = vec.Vec[VariantArmInfo].create()
    arms.push(VariantArmInfo(
        name = "success",
        field_names = sp_str("value"),
        field_types = sp_str_type("_phantom"),
    ))
    arms.push(VariantArmInfo(
        name = "failure",
        field_names = sp_str("error"),
        field_types = sp_str_type("_phantom"),
    ))
    return VariantInfo(module_name = "", arms = arms.as_span())


## A single-element `span[str]` — used for prelude arm payload field names.
function sp_str(value: str) -> span[str]:
    var buf = vec.Vec[str].create()
    buf.push(value)
    return buf.as_span()


## A single-element `span[types.Type]` carrying a primitive `ty_named` — used as a
## prelude-arm field-type placeholder until the specialization pass resolves the
## concrete type from the generic call site.
function sp_str_type(name: str) -> span[types.Type]:
    var buf = vec.Vec[types.Type].create()
    buf.push(types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = name))
    return buf.as_span()


## Pre-scan variant declarations into the registry so arm constructors and match
## arms can resolve discriminant indices and payload fields.  Generic variants are
## registered too — a `match` needs their arm names — while their CONCRETE
## instances register substituted payload fields when the instance is emitted
## (`ensure_generic_variant_decl`).
function collect_variants(ctx: ref[LowerCtx], decls: span[ast.Decl]) -> void:
    var i: ptr_uint = 0
    while i < decls.len:
        var d: ast.Decl
        unsafe:
            d = read(decls.data + i)
        match d:
            ast.Decl.decl_variant as vr:
                # A user-defined generic variant is registered too: matching one of
                # its instances needs the arm names (its CONCRETE payload fields
                # are registered when the instance is emitted).  The prelude
                # `Option`/`Result` are excluded — `install_prelude_variants`
                # registers them with the `_phantom` placeholder that
                # `specialize_prelude_arm_info` specializes per match site.
                if vr.type_params.len == 0 or not is_prelude_variant_name(vr.name):
                    let info = build_variant_info(ctx, vr.variant_arms)
                    ctx.variants.set(vr.name, info)
                    ctx.variants.set(j2(j2(ctx.module_name, "."), vr.name), info)
                if vr.type_params.len == 0:
                    register_imported_variant_arm_fields(ctx, ctx.module_name, ctx.analysis, vr.name, vr.variant_arms)
            _:
                pass
        i += 1
    # Register imported variants so cross-module match can find them.
    install_imported_variants(ctx)


function build_variant_info(ctx: ref[LowerCtx], arms: span[ast.VariantArm]) -> VariantInfo:
    var arm_infos = vec.Vec[VariantArmInfo].create()
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.VariantArm
        unsafe:
            arm = read(arms.data + i)
        var names = vec.Vec[str].create()
        var tys = vec.Vec[types.Type].create()
        var fi: ptr_uint = 0
        while fi < arm.arm_fields.len:
            var f: ast.Field
            unsafe:
                f = read(arm.arm_fields.data + fi)
            names.push(f.name)
            tys.push(resolve_field_type_ref(ctx, f.field_type))
            fi += 1
        arm_infos.push(VariantArmInfo(name = arm.name, field_names = names.as_span(), field_types = tys.as_span()))
        i += 1
    return VariantInfo(module_name = ctx.module_name, arms = arm_infos.as_span())


## Register non-generic variants from imported modules in the current module's
## variant registry so cross-module variant match goes through the switch path
## (which handles `kind` field access and `as name` bindings) instead of
## falling through to the enum fallback (which uses the wrong module prefix).
function install_imported_variants(ctx: ref[LowerCtx]) -> void:
    var import_values = ctx.analysis.imports.values()
    while true:
        let target_ptr = import_values.next() else:
            break
        let target_module = unsafe: read(target_ptr)
        match find_imported_analysis(ctx, target_module):
            Option.some as imported:
                var di: ptr_uint = 0
                while di < imported.value.source_file.declarations.len:
                    var d: ast.Decl
                    unsafe:
                        d = read(imported.value.source_file.declarations.data + di)
                    match d:
                        ast.Decl.decl_variant as vr:
                            # See `collect_variants`: a user-defined generic
                            # variant is registered (minus the prelude pair).
                            let registerable = vr.type_params.len == 0 or not is_prelude_variant_name(vr.name)
                            if registerable:
                                let info = build_imported_variant_info(ctx, target_module, imported.value, vr.variant_arms)
                                if not ctx.variants.contains(vr.name):
                                    ctx.variants.set(vr.name, info)
                                # The module-qualified entry is what a match whose
                                # scrutinee names this module's type resolves to;
                                # two modules may declare the same bare name
                                # (`mtc.ir.Expr` vs `mtc.parser.ast.Expr`).
                                ctx.variants.set(j2(j2(target_module, "."), vr.name), info)
                            # Register arm payload field types keyed by the
                            # module-qualified payload struct C name, for EVERY
                            # imported variant — even when its bare name collides
                            # with an already-registered variant (e.g. both
                            # `ir.Expr` and `ast.Expr` are named "Expr").  This
                            # feeds `arm_payload_field_type` directly so member
                            # access on an arm binding (`node.operator`) types
                            # correctly regardless of the registry collision.
                            if vr.type_params.len == 0:
                                register_imported_variant_arm_fields(ctx, target_module, imported.value, vr.name, vr.variant_arms)
                        _:
                            pass
                    di += 1
            Option.none:
                pass


## Register arm payload field types for an imported variant into
## `arm_payload_fields`, keyed by the module-qualified payload struct C name
## (`<owner>_<Variant>_<arm>`).  Populated for every imported variant regardless
## of bare-name registry collisions, so member access on an arm binding resolves
## the field type structurally.  Field types are resolved in the owner context.
function register_imported_variant_arm_fields(ctx: ref[LowerCtx], owner_module: str, owner_analysis: analyzer.Analysis, variant_name: str, arms: span[ast.VariantArm]) -> void:
    let outer_c = naming.qualified_c_name(owner_module, variant_name)
    var saved_module = ctx.module_name
    var saved_analysis = ctx.analysis
    ctx.module_name = owner_module
    ctx.analysis = owner_analysis
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.VariantArm
        unsafe:
            arm = read(arms.data + i)
        if arm.arm_fields.len > 0:
            var names = vec.Vec[str].create()
            var tys = vec.Vec[types.Type].create()
            var fi: ptr_uint = 0
            while fi < arm.arm_fields.len:
                var f: ast.Field
                unsafe:
                    f = read(arm.arm_fields.data + fi)
                names.push(f.name)
                tys.push(qualify_type(ctx, resolve_field_type_ref(ctx, f.field_type)))
                fi += 1
            let payload_c = variant_arm_type_name(outer_c, arm.name)
            # Do not overwrite an entry a real match already registered.
            if not ctx.arm_payload_fields.contains(payload_c):
                ctx.arm_payload_fields.set(payload_c, VariantArmInfo(
                    name = arm.name,
                    field_names = names.as_span(),
                    field_types = tys.as_span(),
                ))
        i += 1
    ctx.module_name = saved_module
    ctx.analysis = saved_analysis


## Like `build_variant_info` but uses the imported module's name for
## `module_name` so variant arm constructors produce correctly-qualified names.
## Arm field types are resolved in the OWNER module's context so they qualify
## against the defining module (needed for member access on a match-arm binding).
function build_imported_variant_info(ctx: ref[LowerCtx], owner_module: str, owner_analysis: analyzer.Analysis, arms: span[ast.VariantArm]) -> VariantInfo:
    var saved_module = ctx.module_name
    var saved_analysis = ctx.analysis
    ctx.module_name = owner_module
    ctx.analysis = owner_analysis
    var arm_infos = vec.Vec[VariantArmInfo].create()
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.VariantArm
        unsafe:
            arm = read(arms.data + i)
        var names = vec.Vec[str].create()
        var tys = vec.Vec[types.Type].create()
        var fi: ptr_uint = 0
        while fi < arm.arm_fields.len:
            var f: ast.Field
            unsafe:
                f = read(arm.arm_fields.data + fi)
            names.push(f.name)
            tys.push(qualify_type(ctx, resolve_field_type_ref(ctx, f.field_type)))
            fi += 1
        arm_infos.push(VariantArmInfo(name = arm.name, field_names = names.as_span(), field_types = tys.as_span()))
        i += 1
    ctx.module_name = saved_module
    ctx.analysis = saved_analysis
    return VariantInfo(module_name = owner_module, arms = arm_infos.as_span())


## Lower a variant declaration to an `ir.VariantDecl`, mirroring Ruby's
## `lower_variants`: the outer C name is `<module>_<name>` and each arm's payload
## struct C name is `<outer_c>_<arm>`.
function lower_variant_decl(ctx: ref[LowerCtx], name: str, arms: span[ast.VariantArm]) -> ir.VariantDecl:
    let outer_c = naming.qualified_c_name(ctx.module_name, name)
    var ir_arms = vec.Vec[ir.VariantArm].create()
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.VariantArm
        unsafe:
            arm = read(arms.data + i)
        var fields = vec.Vec[ir.Field].create()
        var fi: ptr_uint = 0
        while fi < arm.arm_fields.len:
            var f: ast.Field
            unsafe:
                f = read(arm.arm_fields.data + fi)
            fields.push(ir.Field(name = f.name, ty = resolve_field_type_ref(ctx, f.field_type)))
            fi += 1
        ir_arms.push(ir.VariantArm(name = arm.name, linkage_name = variant_arm_c_name(outer_c, arm.name), fields = fields.as_span()))
        i += 1
    return ir.VariantDecl(name = name, linkage_name = outer_c, arms = ir_arms.as_span(), source_module = Option[str].some(value = ctx.module_name))




## The C name of a variant arm's payload struct: `<outer_c>_<arm>`.
function variant_arm_c_name(outer_c: str, arm_name: str) -> str:
    var buf = string.String.create()
    buf.append(outer_c)
    buf.append("_")
    buf.append(arm_name)
    return buf.as_str()


## The C base name for a variant type: `ty_generic("Option", [ty_int])` →
## `"Option_int"`; `ty_imported` uses `qualified_c_name`; non-generic variants
## fall back to `qualified_c_name(module_name, variant_name)`.
function variant_base_c_name(ty: types.Type, module_name: str) -> str:
    var result: str
    match ty:
        types.Type.ty_generic as g:
            var buf = string.String.create()
            if g.name == "Option":
                buf.append("std_option_")
            else if g.name == "Result":
                buf.append("std_result_")
            buf.append(g.name)
            var i: ptr_uint = 0
            while i < g.args.len:
                buf.append("_")
                unsafe:
                    buf.append(naming.type_c_key(read(g.args.data + i)))
                i += 1
            result = buf.as_str()
        types.Type.ty_imported:
            # `type_c_key` module-qualifies the name and appends the argument
            # suffix of a concrete generic instance, and it prefixes the prelude
            # variants (`std_option_Option_int`).  A bare `qualified_c_name`
            # would drop the arguments of a user-defined instance
            # (`engine_types_Outcome_int_EngineError` -> `engine_types_Outcome`).
            result = naming.type_c_key(ty)
        types.Type.ty_named as n:
            if is_prelude_variant_name(n.name):
                result = n.name
            else:
                # A named type's own module is authoritative: the caller's
                # `module_name` is only the fallback for a bare declaration
                # (`Expr` in `builder` vs an imported `ast.Expr`).
                let owner = if n.module_name.len > 0: n.module_name else: module_name
                result = naming.qualified_c_name(owner, n.name)
        _:
            result = naming.qualified_c_name(module_name, "")
    return result


## Look up a variant arm's field info by arm name.
function variant_arm_info(info: VariantInfo, arm_name: str) -> Option[VariantArmInfo]:
    var i: ptr_uint = 0
    while i < info.arms.len:
        var arm: VariantArmInfo
        unsafe:
            arm = read(info.arms.data + i)
        if arm.name == arm_name:
            return Option[VariantArmInfo].some(value = arm)
        i += 1
    return Option[VariantArmInfo].none


## Resolve a field/local type annotation to a `types.Type`: scalars via
## `resolve_scalar_type_ref`, and single-name local types (structs/unions/enums)
## to a module-qualified `ty_imported`.  Compound types (arrays/spans/generics)
## resolve later.
function resolve_field_type_ref(ctx: ref[LowerCtx], tref: ast.TypeRef) -> types.Type:
    var local_tref = tref
    let scalar = resolve_scalar_type_ref(ptr_of(local_tref))
    if not types.is_error(scalar):
        return scalar
    if tref.is_fn or tref.is_proc:
        let fun = resolve_function_type_ref(ctx, ptr_of(local_tref))
        if tref.is_proc:
            let _registered = proc_ensure_struct_decl(ctx, naming.proc_type_c_name(fun), fun)
            return fun
        if tref.nullable:
            return types.Type.ty_nullable(base = types.alloc_type(fun))
        return fun
    if tref.is_dyn:
        return types.Type.ty_dyn(iface = naming.dyn_iface_declared_name(unsafe: analyzer.qname_to_str(tref.dyn_interface)), args = dyn_type_args(ctx, tref.dyn_interface))
    if tref.is_tuple:
        var elems = vec.Vec[types.Type].create()
        var ti: ptr_uint = 0
        while ti < tref.arguments.len:
            elems.push(resolve_field_type_ref(ctx, unsafe: read(tref.arguments.data + ti)))
            ti += 1
        let tuple_ty = types.Type.ty_tuple(elements = elems.as_span(), field_names = Option[span[str]].none)
        if tref.nullable:
            return types.Type.ty_nullable(base = types.alloc_type(tuple_ty))
        return tuple_ty
    var resolved = types.Type.ty_error
    if tref.arguments.len > 0:
        resolved = resolve_generic_type_ref(ctx, tref)
    else if tref.name.parts.len >= 2:
        var alias: str
        var type_name: str
        unsafe:
            alias = read(tref.name.parts.data + 0)
            type_name = read(tref.name.parts.data + 1)
        let mod_ptr = ctx.analysis.imports.get(alias)
        if mod_ptr != null:
            let target_module = unsafe: read(mod_ptr)
            # Follow a re-exported type alias (e.g. `aio.Runtime` ->
            # `std.async.libuv_runtime.Runtime`), like `resolve_type_ref`.
            match resolve_single_imported_type(ctx, target_module, type_name):
                Option.some as alias_ty:
                    resolved = proc_alias_struct_type(ctx, alias_ty.value)
                Option.none:
                    resolved = types.Type.ty_imported(module_name = target_module, name = type_name, args = span[types.Type]())
        else:
            # A nested struct's qualified reference (`Rectangle.Edge`): its
            # registered type carries the parent-qualified linkage name.
            match local_nested_type(ctx, tref.name.parts):
                Option.some as nested:
                    resolved = nested.value
                Option.none:
                    pass
    else if tref.name.parts.len == 1:
        let name = unsafe: read(tref.name.parts.data + 0)
        if is_builtin_type_name(name):
            resolved = types.primitive(name)
        else if ctx.analysis.type_names.contains(name):
            # A same-module type alias resolves to its target (the host's
            # `resolve_type_ref`), except a `std.c.*` backing alias, which stays
            # nominal so the C typedef handles the mapping.
            let alias_ptr = ctx.analysis.type_alias_types.get(name)
            if alias_ptr != null and not type_is_from_std_c(unsafe: read(alias_ptr)):
                resolved = unsafe: read(alias_ptr)
            else:
                match local_nested_type(ctx, tref.name.parts):
                    Option.some as nested:
                        resolved = nested.value
                    Option.none:
                        resolved = types.Type.ty_imported(module_name = ctx.module_name, name = name, args = span[types.Type]())
        else:
            let concrete_ptr = ctx.type_substitution.get(name)
            if concrete_ptr != null:
                resolved = unsafe: read(concrete_ptr)
            else:
                resolved = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = name)
    if tref.nullable and not types.is_error(resolved):
        return types.Type.ty_nullable(base = types.alloc_type(resolved))
    return resolved


## Look up the resolved type of a module-level variable declared in the source
## file.  Used when `expr_type(ctx, callee)` fails for proc variables.
function module_var_type(ctx: ref[LowerCtx], name: str) -> types.Type:
    var di: ptr_uint = 0
    while di < ctx.analysis.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(ctx.analysis.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_var as v:
                if v.name == name:
                    let tref = v.var_type
                    if tref != null:
                        return resolve_type_ref(ctx, tref)
            ast.Decl.decl_const as c:
                if c.name == name:
                    return resolve_type_ref(ctx, c.const_type)
            _:
                pass
        di += 1
    return types.Type.ty_error


# =============================================================================
#  Enum / flags declarations
# =============================================================================

function lower_enum_decl(ctx: ref[LowerCtx], name: str, backing_type: ptr[ast.TypeRef]?, members: span[ast.EnumMember], is_flags: bool) -> ir.EnumDecl:
    var backing = types.primitive("int")
    let annotation = backing_type
    if annotation != null:
        let resolved = resolve_scalar_type_ref(annotation)
        if not types.is_error(resolved):
            backing = resolved

    let enum_linkage = naming.qualified_c_name(ctx.module_name, name)
    var ir_members = vec.Vec[ir.EnumMember].create()
    var next_auto: long = 0

    var i: ptr_uint = 0
    while i < members.len:
        var m: ast.EnumMember
        unsafe:
            m = read(members.data + i)
        let member_linkage = naming.qualified_member_c_name(ctx.module_name, name, m.name)
        var value_expr: ptr[ir.Expr]
        let explicit = m.value
        # The parser synthesizes a literal for an implicit member too; only a
        # source-explicit value advances the constant fold, and an implicit one
        # takes the running auto value (the host's constant-value rule).
        if explicit != null and m.value_explicit:
            let lowered = lower_expr(ctx, explicit)
            var coerced = coerce_const_value(ctx, unsafe: read(lowered), backing)
            # A pure numeric constant (`1 << 0`, `1 | 2`) takes the backing type
            # throughout (the host lowers member values with the backing as the
            # expected type); a flags/enum-member expression keeps its own type.
            coerced = retag_pure_integer_const(coerced, backing)
            value_expr = alloc_expr(coerced)
            next_auto = const_eval_int(ctx, explicit) + 1
        else:
            value_expr = alloc_expr(ir.Expr.expr_integer_literal(value = next_auto, ty = backing))
            next_auto += 1
        ir_members.push(ir.EnumMember(name = m.name, linkage_name = member_linkage, value = value_expr))
        i += 1

    return ir.EnumDecl(
        name = name,
        linkage_name = enum_linkage,
        backing_type = backing,
        members = ir_members.as_span(),
        is_flags = is_flags,
    )


## Compile-time integer evaluation for enum/flags member values and array-length
## constants (literals, other integer constants by name, plus the
## arithmetic/bitwise/shift operators).  A bare `expr_identifier` resolves
## through `ctx.analysis.const_values`, so a length like `WIDTH * HEIGHT` (each a
## module-level `const int`) folds to its product instead of 0.
function const_eval_int(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> long:
    unsafe:
        match read(ep):
            ast.Expr.expr_integer_literal as lit:
                return long<-lit.value
            ast.Expr.expr_char_literal as ch:
                return long<-ch.value
            ast.Expr.expr_identifier as id:
                let const_ptr = ctx.analysis.const_values.get(id.name)
                if const_ptr != null:
                    return const_eval_int(ctx, read(const_ptr))
                return 0
            ast.Expr.expr_unary_op as un:
                let v = const_eval_int(ctx, un.operand)
                if un.operator == "-":
                    return -v
                if un.operator == "~":
                    return ~v
                return v
            ast.Expr.expr_binary_op as bin:
                let l = const_eval_int(ctx, bin.left)
                let r = const_eval_int(ctx, bin.right)
                if bin.operator == "+":
                    return l + r
                if bin.operator == "-":
                    return l - r
                if bin.operator == "*":
                    return l * r
                if bin.operator == "/":
                    return l / r
                if bin.operator == "%":
                    return l % r
                if bin.operator == "<<":
                    return l << r
                if bin.operator == ">>":
                    return l >> r
                if bin.operator == "|":
                    return l | r
                if bin.operator == "&":
                    return l & r
                if bin.operator == "^":
                    return l ^ r
                return 0
            ast.Expr.expr_sizeof as sz:
                let target = resolve_type_ref(ctx, sz.target_type)
                match layout_size(ctx, target):
                    Option.some as v:
                        return v.value
                    Option.none:
                        return 0
            ast.Expr.expr_alignof as al:
                let target = resolve_type_ref(ctx, al.target_type)
                match layout_alignment(ctx, target):
                    Option.some as v:
                        return v.value
                    Option.none:
                        return 0
            ast.Expr.expr_offsetof as off:
                let target = resolve_type_ref(ctx, off.target_type)
                match layout_offset_of(ctx, target, off.field):
                    Option.some as v:
                        return v.value
                    Option.none:
                        return 0
            _:
                return 0


## Option-returning compile-time integer evaluation for static_assert folding:
## literals, module-level constants by name, and arithmetic/bitwise operators.
## Unlike `const_eval_int`, an unfoldable expression (a runtime name) yields
## none instead of 0, so the caller can keep it as a C-evaluable expression
## rather than mis-folding it.
function try_const_eval_int(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> Option[long]:
    unsafe:
        match read(ep):
            ast.Expr.expr_integer_literal as lit:
                return Option[long].some(value = long<-lit.value)
            ast.Expr.expr_char_literal as ch:
                return Option[long].some(value = long<-ch.value)
            ast.Expr.expr_identifier as id:
                let const_ptr = ctx.analysis.const_values.get(id.name)
                if const_ptr != null:
                    return try_const_eval_int(ctx, read(const_ptr))
                return Option[long].none
            ast.Expr.expr_unary_op as un:
                let v = try_const_eval_int(ctx, un.operand) else:
                    return Option[long].none
                if un.operator == "-":
                    return Option[long].some(value = -v)
                if un.operator == "~":
                    return Option[long].some(value = ~v)
                return Option[long].none
            ast.Expr.expr_binary_op as bin:
                let l = try_const_eval_int(ctx, bin.left) else:
                    return Option[long].none
                let r = try_const_eval_int(ctx, bin.right) else:
                    return Option[long].none
                if bin.operator == "+":
                    return Option[long].some(value = l + r)
                if bin.operator == "-":
                    return Option[long].some(value = l - r)
                if bin.operator == "*":
                    return Option[long].some(value = l * r)
                if bin.operator == "/":
                    if r == 0:
                        return Option[long].none
                    return Option[long].some(value = l / r)
                if bin.operator == "%":
                    if r == 0:
                        return Option[long].none
                    return Option[long].some(value = l % r)
                if bin.operator == "<<":
                    return Option[long].some(value = l << r)
                if bin.operator == ">>":
                    return Option[long].some(value = l >> r)
                if bin.operator == "|":
                    return Option[long].some(value = l | r)
                if bin.operator == "&":
                    return Option[long].some(value = l & r)
                if bin.operator == "^":
                    return Option[long].some(value = l ^ r)
                return Option[long].none
            ast.Expr.expr_member_access as ma:
                # `alias.MEMBER` in a constant expression: the value lives in
                # the alias's module, so evaluate it there (the host's
                # `resolve_imported_module_const_value`, whose const values are
                # precomputed in dependency order).
                match read(ma.receiver):
                    ast.Expr.expr_identifier as rid:
                        let target_ptr = ctx.analysis.imports.get(rid.name)
                        if target_ptr == null:
                            return Option[long].none
                        match find_imported_analysis(ctx, unsafe: read(target_ptr)):
                            Option.some as owner:
                                var saved_module = ctx.module_name
                                var saved_analysis = ctx.analysis
                                ctx.module_name = owner.value.module_name
                                ctx.analysis = owner.value
                                var result = Option[long].none
                                let chain = ctx.analysis.const_values.get(ma.member_name)
                                if chain != null:
                                    result = try_const_eval_int(ctx, unsafe: read(chain))
                                ctx.module_name = saved_module
                                ctx.analysis = saved_analysis
                                return result
                            Option.none:
                                return Option[long].none
                    _:
                        return Option[long].none
            ast.Expr.expr_sizeof as sz:
                let target = resolve_type_ref(ctx, sz.target_type)
                return layout_size(ctx, target)
            ast.Expr.expr_alignof as al:
                let target = resolve_type_ref(ctx, al.target_type)
                return layout_alignment(ctx, target)
            ast.Expr.expr_offsetof as off:
                let target = resolve_type_ref(ctx, off.target_type)
                return layout_offset_of(ctx, target, off.field)
            _:
                return Option[long].none


## Compile-time boolean evaluation for a static_assert condition: boolean
## literals, `not`, `and`/`or`, and integer comparisons over foldable operands.
## Yields none when any operand cannot be folded, in which case the condition
## is emitted as a C constant expression for the C compiler to evaluate.
function try_const_eval_bool(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> Option[bool]:
    unsafe:
        match read(ep):
            ast.Expr.expr_bool_literal as b:
                return Option[bool].some(value = b.value)
            ast.Expr.expr_unary_op as un:
                if un.operator == "not":
                    let inner = try_const_eval_bool(ctx, un.operand) else:
                        return Option[bool].none
                    return Option[bool].some(value = not inner)
                return Option[bool].none
            ast.Expr.expr_binary_op as bin:
                if bin.operator == "and" or bin.operator == "or":
                    let lb = try_const_eval_bool(ctx, bin.left) else:
                        return Option[bool].none
                    let rb = try_const_eval_bool(ctx, bin.right) else:
                        return Option[bool].none
                    if bin.operator == "and":
                        return Option[bool].some(value = lb and rb)
                    return Option[bool].some(value = lb or rb)
                let is_comparison = (
                    bin.operator == "==" or bin.operator == "!="
                    or bin.operator == "<" or bin.operator == "<="
                    or bin.operator == ">" or bin.operator == ">="
                )
                if not is_comparison:
                    return Option[bool].none
                let l = try_const_eval_int(ctx, bin.left) else:
                    return Option[bool].none
                let r = try_const_eval_int(ctx, bin.right) else:
                    return Option[bool].none
                if bin.operator == "==":
                    return Option[bool].some(value = l == r)
                if bin.operator == "!=":
                    return Option[bool].some(value = l != r)
                if bin.operator == "<":
                    return Option[bool].some(value = l < r)
                if bin.operator == "<=":
                    return Option[bool].some(value = l <= r)
                if bin.operator == ">":
                    return Option[bool].some(value = l > r)
                return Option[bool].some(value = l >= r)
            _:
                return Option[bool].none


## Lower a static_assert condition for C emission.  Foldable subexpressions
## (constants, literal arithmetic) become integer literals; the rest —
## `size_of` / `align_of` / `offset_of` and comparisons over them — lowers
## normally, producing a C integer constant expression that `_Static_assert`
## evaluates itself.
function lower_static_assert_expr(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    match try_const_eval_int(ctx, ep):
        Option.some as folded:
            return alloc_expr(ir.Expr.expr_integer_literal(value = folded.value, ty = types.primitive("long")))
        Option.none:
            pass
    unsafe:
        match read(ep):
            ast.Expr.expr_binary_op as bin:
                let left = lower_static_assert_expr(ctx, bin.left)
                let right = lower_static_assert_expr(ctx, bin.right)
                var op = bin.operator
                if op == "and":
                    op = "&&"
                if op == "or":
                    op = "||"
                return alloc_expr(ir.Expr.expr_binary(operator = op, left = left, right = right, ty = ctx.bool_ty))
            ast.Expr.expr_unary_op as un:
                if un.operator == "not":
                    return alloc_expr(ir.Expr.expr_unary(operator = "not", operand = lower_static_assert_expr(ctx, un.operand), ty = ctx.bool_ty))
                return lower_expr(ctx, ep)
            _:
                return lower_expr(ctx, ep)


## Lower a `static_assert(condition, "message")` declaration or statement to the
## IR form the C backend renders as `_Static_assert(cond, "message")`.  A fully
## foldable condition emits its folded `true` / `false` (matching Ruby, which
## folds and lets the C compiler report `static assertion failed`); otherwise
## the partially-folded condition is emitted for C to evaluate.
function lower_static_assert(ctx: ref[LowerCtx], condition: ptr[ast.Expr], message: ptr[ast.Expr]?) -> ir.StaticAssert:
    var cond_ir: ptr[ir.Expr]
    match try_const_eval_bool(ctx, condition):
        Option.some as folded:
            cond_ir = alloc_expr(ir.Expr.expr_boolean_literal(value = folded.value, ty = ctx.bool_ty))
        Option.none:
            cond_ir = lower_static_assert_expr(ctx, condition)

    var message_text = "static assertion failed"
    let message_expr = message
    if message_expr != null:
        unsafe:
            match read(ptr[ast.Expr]<-message_expr):
                ast.Expr.expr_string_literal as lit:
                    message_text = lit.value
                _:
                    pass
    # The host lowers the message with `expected_type: str` (a StringView
    # literal), not a cstr (`declarations.rb:217`).
    let message_ir = alloc_expr(ir.Expr.expr_string_literal(value = message_text, ty = types.Type.ty_str, cstring = false))
    return ir.StaticAssert(condition = cond_ir, message = message_ir)


# =============================================================================
#  Match (enum scrutinee) -> switch
# =============================================================================

## Lower a `match` over an enum/flags scrutinee into an IR `stmt_switch`.  Each
## `EnumType.member` arm becomes a `case`; a `_` arm becomes the `default`.  The
## switch is marked exhaustive (the host does so for every match switch; the
## backend adds `__builtin_unreachable` only when there is no default).
## Integer, string, variant, and tuple scrutinees are handled by the
## type-dispatch branches within `lower_match`.
function enum_source_module(ctx: ref[LowerCtx], ty: types.Type, default_module: str) -> str:
    match ty:
        types.Type.ty_imported as im:
            return im.module_name
        _:
            return default_module

## The C name a match-arm reference to `Enum.member` uses.  A raw (external)
## module's enum is the C header's enum, whose members are the bare enumerators
## (the module emits no scoped constants), so the member name is used as-is;
## mt-declared enums use the module-scoped constant
## (`<module>_<Enum>_<member>`), mirroring Ruby's `imported_value_c_name`
## raw-module rule.
function enum_member_reference_c_name(ctx: ref[LowerCtx], enum_module: str, enum_name: str, member: str) -> str:
    if enum_module.len > 0 and module_is_raw(ctx, enum_module):
        return member
    return naming.qualified_member_c_name(enum_module, enum_name, member)


## True when `module_name`'s analysis is a raw (external) module.
function module_is_raw(ctx: ref[LowerCtx], module_name: str) -> bool:
    if module_name == ctx.module_name:
        return is_raw_module(ctx.analysis.module_kind)
    match find_imported_analysis(ctx, module_name):
        Option.some as imported:
            return is_raw_module(imported.value.module_kind)
        Option.none:
            return false


## Lower a match arm's body when the match is a C `switch`.  The host's
## `switch_loop_flow`/`switch_loop_target` convert both a `break` and a
## `continue` to the loop-label form inside a switch (a C `break` would exit the
## switch, and the host never relies on `continue` passing through one), so both
## native flags are cleared here.
function lower_switch_arm_body(ctx: ref[LowerCtx], body: ptr[ast.Stmt]?) -> span[ir.Stmt]:
    let saved_break_native = ctx.loop_break_native
    let saved_continue_native = ctx.loop_continue_native
    ctx.loop_break_native = false
    ctx.loop_continue_native = false
    let result = lower_block(ctx, body)
    ctx.loop_continue_native = saved_continue_native
    ctx.loop_break_native = saved_break_native
    return result


function lower_match(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee: ptr[ast.Expr], arms: span[ast.MatchArm]) -> void:
    # Save/restore locals so match-arm bindings (as name) and arm-body
    # locals don't leak into subsequent code or proc captures.
    let saved_locals = ctx.locals
    ctx.locals = vec.Vec[LocalBinding].create()
    var li: ptr_uint = 0
    while li < saved_locals.len():
        let lb_ptr = saved_locals.get(li) else:
            break
        unsafe:
            ctx.locals.push(read(lb_ptr))
        li += 1
    # The host's `lower_match_stmt` prepares the scrutinee with the statement's
    # window, lowers it once, and appends its cleanups after the match
    # (`block.rb:838-845,924`).  A proc argument therefore materializes before
    # the `match_value` temp; reusing the same IR node keeps the single
    # evaluation's proc ids/temps/instantiations.
    let had_window = ctx.hoist_mode != HoistMode.hm_off
    let window_saved = begin_stmt_setup(ctx, HoistMode.hm_value)
    let scrutinee_expr = lower_expr(ctx, scrutinee)
    let window_collected = collect_stmt_setup(ctx, window_saved)
    if had_window:
        append_span_stmts(ref_of(ctx.hoist_stmts), window_collected.stmts.as_span())
        append_span_stmts(ref_of(ctx.hoist_cleanups), window_collected.cleanups.as_span())
    else:
        append_span_stmts(output, window_collected.stmts.as_span())
        defer: append_span_stmts(output, window_collected.cleanups.as_span())
    var scrutinee_ty = expr_type(ctx, scrutinee)
    let lowered_ty = ir_expr_type(scrutinee_expr)
    if not types.is_error(lowered_ty) and not types.type_to_string(lowered_ty) == "void":
        scrutinee_ty = lowered_ty
    let type_name = named_type_name(scrutinee_ty)

    if type_name.is_some() and ctx.variants.contains(variant_registry_key(ctx, type_name.unwrap(), scrutinee_ty)):
        lower_variant_match(ctx, output, scrutinee_expr, type_name.unwrap(), scrutinee_ty, arms)
        ctx.locals = saved_locals
        return

    let gen_var = generic_variant_name(scrutinee_ty)
    if gen_var.is_some() and variant_match_allowed(ctx, gen_var.unwrap()):
        lower_variant_match(ctx, output, scrutinee_expr, gen_var.unwrap(), scrutinee_ty, arms)
        ctx.locals = saved_locals
        return

    # Integer scrutinee: switch over integer / char literal case values.
    if is_integer_scrutinee(scrutinee_ty):
        lower_scalar_match(ctx, output, scrutinee_expr, arms)
        ctx.locals = saved_locals
        return

    # String scrutinee: an if / else-if chain comparing with `equal`.
    if is_str_scrutinee(scrutinee_ty):
        lower_string_match(ctx, output, scrutinee_expr, arms)
        ctx.locals = saved_locals
        return

    # Tuple-literal scrutinee: an if / else-if chain over per-element equality
    # tests (mirrors the expression-match tuple path).
    match scrutinee_ty:
        types.Type.ty_tuple:
            lower_tuple_match_stmt(ctx, output, scrutinee_expr, scrutinee_ty, arms)
            ctx.locals = saved_locals
            return
        _:
            pass

    let enum_name = type_name else:
        let ts = types.type_to_string(scrutinee_ty)
        if ts == "void" or ts == "<error>" or ts.starts_with("("):
            ctx.locals = saved_locals
            return
        fatal(j2("lowering: match requires known type, got ", ts))
    var enum_module = enum_source_module(ctx, scrutinee_ty, ctx.module_name)
    var cases = vec.Vec[ir.SwitchCase].create()
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.MatchArm
        unsafe:
            arm = read(arms.data + i)
        let lowered_body = lower_switch_arm_body(ctx, arm.body)
        # The CPS match lowering appends a native break to every case body
        # (the host's `lower_async_cf_match_stmt`), even after a return.
        var body = lowered_body
        if ctx.async_cps_active:
            var case_body = vec.Vec[ir.Stmt].create()
            append_span_stmts(ref_of(case_body), lowered_body)
            case_body.push(ir.Stmt.stmt_break)
            body = case_body.as_span()
        let pattern = arm.pattern
        if pattern == null:
            cases.push(ir.SwitchCase(is_default = true, value = null, body = body))
        else:
            let member = match_member_name(pattern) else:
                fatal(c"lowering: unsupported match pattern")
            let value = alloc_expr(ir.Expr.expr_name(
                name = enum_member_reference_c_name(ctx, enum_module, enum_name, member),
                ty = scrutinee_ty,
                pointer = Option[bool].some(value = false),
            ))
            cases.push(ir.SwitchCase(is_default = false, value = value, body = body))
        i += 1

    output.push(ir.Stmt.stmt_switch(expression = scrutinee_expr, cases = cases.as_span(), exhaustive = true))
    ctx.locals = saved_locals


## True when a match scrutinee type is an integer (byte/short/int/long and the
## unsigned/pointer widths) matched with integer or char literal patterns.
function is_integer_scrutinee(ty: types.Type) -> bool:
    match ty:
        types.Type.ty_primitive as p:
            return types.is_integer_name(p.name)
        _:
            return false


## True when a `fatal(...)` argument is a `cstr` (so it uses `mt_fatal`); `str`
## and everything else route to `mt_fatal_str`.  A `c"..."` literal is detected
## structurally (its recorded type is not always reliable); other expressions
## fall back to their resolved type.
function fatal_arg_is_cstr(ctx: ref[LowerCtx], arg: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(arg):
            ast.Expr.expr_string_literal as lit:
                return lit.is_cstring
            _:
                pass
    match expr_type(ctx, arg):
        types.Type.ty_primitive as p:
            return p.name == "cstr"
        _:
            return false


function is_str_scrutinee(ty: types.Type) -> bool:
    match ty:
        types.Type.ty_str:
            return true
        _:
            return false


## Lower an integer match to a `switch`, using each arm's integer / char literal
## pattern as the case value.  A `_` arm becomes `default` (marked exhaustive,
## matching the host; the backend only emits `__builtin_unreachable` when the
## switch has no default).
function lower_scalar_match(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee_expr: ptr[ir.Expr], arms: span[ast.MatchArm]) -> void:
    # A range pattern cannot be a `switch` case, so a match containing one is
    # lowered to an if / else-if chain (mirrors Ruby's lower_range_match_stmt).
    var has_range = false
    var hi: ptr_uint = 0
    while hi < arms.len:
        unsafe:
            let hp = read(arms.data + hi).pattern
            if hp != null:
                match read(hp):
                    ast.Expr.expr_range:
                        has_range = true
                    _:
                        pass
        hi += 1
    if has_range:
        lower_scalar_range_match(ctx, output, scrutinee_expr, arms)
        return

    let scrutinee_ty = ir_expr_type(scrutinee_expr)
    var cases = vec.Vec[ir.SwitchCase].create()
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.MatchArm
        unsafe:
            arm = read(arms.data + i)
        let lowered_body = lower_switch_arm_body(ctx, arm.body)
        # The CPS match lowering appends a native break to every case body
        # (the host's `lower_async_cf_match_stmt`, async_lowering.rb:585-591),
        # even after a terminating return.
        var body = lowered_body
        if ctx.async_cps_active:
            var case_body = vec.Vec[ir.Stmt].create()
            append_span_stmts(ref_of(case_body), lowered_body)
            case_body.push(ir.Stmt.stmt_break)
            body = case_body.as_span()
        let pattern = arm.pattern
        if pattern == null:
            cases.push(ir.SwitchCase(is_default = true, value = null, body = body))
        else:
            # A literal case value takes the scrutinee's type (the host's
            # `lower_pattern_expression`): `match b { 80: … }` on a `ubyte`
            # carries a `ubyte` literal, not `int`.
            var case_value = lower_expr(ctx, ptr[ast.Expr]<-pattern)
            case_value = literal_value_to_context_type(ctx, ptr[ast.Expr]<-pattern, scrutinee_ty, case_value)
            cases.push(ir.SwitchCase(is_default = false, value = case_value, body = body))
        i += 1
    output.push(ir.Stmt.stmt_switch(expression = scrutinee_expr, cases = cases.as_span(), exhaustive = true))


## Lower an integer match containing range patterns to an if / else-if chain.
## A range arm becomes `scrutinee >= start and scrutinee <= stop`; other arms
## compare with `==`.  A `_` arm becomes the final else block.
function lower_scalar_range_match(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee_expr: ptr[ir.Expr], arms: span[ast.MatchArm]) -> void:
    let scrutinee_ty = ir_expr_type(scrutinee_expr)
    # The host's match-to-if chains always carry an else body; the innermost
    # `if` falls back to an empty one when there is no wildcard arm.
    var else_body = Option[span[ir.Stmt]].some(value = span[ir.Stmt]())
    var wi: ptr_uint = 0
    while wi < arms.len:
        var warm: ast.MatchArm
        unsafe:
            warm = read(arms.data + wi)
        if warm.pattern == null:
            else_body = Option[span[ir.Stmt]].some(value = lower_block(ctx, warm.body))
        wi += 1

    var idx = arms.len
    while idx > 0:
        idx -= 1
        var arm: ast.MatchArm
        unsafe:
            arm = read(arms.data + idx)
        let pattern = arm.pattern
        if pattern != null:
            let body = lower_block(ctx, arm.body)
            var cond: ptr[ir.Expr]
            unsafe:
                match read(pattern):
                    ast.Expr.expr_range as rng:
                        var start = lower_expr(ctx, rng.start_expr)
                        var stop = lower_expr(ctx, rng.end_expr)
                        start = literal_value_to_context_type(ctx, rng.start_expr, scrutinee_ty, start)
                        stop = literal_value_to_context_type(ctx, rng.end_expr, scrutinee_ty, stop)
                        let ge = alloc_expr(ir.Expr.expr_binary(operator = ">=", left = scrutinee_expr, right = start, ty = ctx.bool_ty))
                        let le = alloc_expr(ir.Expr.expr_binary(operator = "<=", left = scrutinee_expr, right = stop, ty = ctx.bool_ty))
                        cond = alloc_expr(ir.Expr.expr_binary(operator = "and", left = ge, right = le, ty = ctx.bool_ty))
                    _:
                        var lit = lower_expr(ctx, pattern)
                        lit = literal_value_to_context_type(ctx, pattern, scrutinee_ty, lit)
                        cond = alloc_expr(ir.Expr.expr_binary(operator = "==", left = scrutinee_expr, right = lit, ty = ctx.bool_ty))
            var chain = vec.Vec[ir.Stmt].create()
            chain.push(ir.Stmt.stmt_if(condition = cond, then_body = body, else_body = else_body))
            else_body = Option[span[ir.Stmt]].some(value = chain.as_span())
    match else_body:
        Option.some as eb:
            var oi: ptr_uint = 0
            while oi < eb.value.len:
                unsafe:
                    output.push(read(eb.value.data + oi))
                oi += 1
        Option.none:
            pass


## Lower a string match to an if / else-if chain comparing the scrutinee with
## each arm's string-literal pattern via `equal` (rendered as `mt_str_equal`).
## The host compares the prepared scrutinee IR node directly (no `match_str`
## temp).  A `_` arm becomes the final else block.
function lower_string_match(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee_expr: ptr[ir.Expr], arms: span[ast.MatchArm]) -> void:
    # Collect literal arms and the optional default (wildcard) body.
    var default_body = span[ir.Stmt]()
    var lit_bodies = vec.Vec[span[ir.Stmt]].create()
    var lit_values = vec.Vec[ptr[ir.Expr]].create()
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.MatchArm
        unsafe:
            arm = read(arms.data + i)
        let body = lower_block(ctx, arm.body)
        let pattern = arm.pattern
        if pattern == null:
            default_body = body
        else:
            lit_values.push(lower_expr(ctx, ptr[ast.Expr]<-pattern))
            lit_bodies.push(body)
        i += 1

    # Build the chain from the last arm backwards so each else wraps the rest.
    # The host always carries an else body: the wildcard arm's block, or an
    # empty one when every arm is a literal.
    var else_body = Option[span[ir.Stmt]].some(value = default_body)
    var idx = lit_values.len()
    while idx > 0:
        idx -= 1
        let value_ptr = lit_values.get(idx) else:
            fatal(c"lowering: string match value")
        let body_ptr = lit_bodies.get(idx) else:
            fatal(c"lowering: string match body")
        let condition = alloc_expr(ir.Expr.expr_binary(
            operator = "==",
            left = scrutinee_expr,
            right = unsafe: read(value_ptr),
            ty = ctx.bool_ty,
        ))
        let then_body = unsafe: read(body_ptr)
        var if_stmts = vec.Vec[ir.Stmt].create()
        if_stmts.push(ir.Stmt.stmt_if(condition = condition, then_body = then_body, else_body = else_body))
        else_body = Option[span[ir.Stmt]].some(value = if_stmts.as_span())

    match else_body:
        Option.some as eb:
            var j: ptr_uint = 0
            while j < eb.value.len:
                unsafe:
                    output.push(read(eb.value.data + j))
                j += 1
        Option.none:
            pass


## Lower a match expression used as a local variable initializer (`let x = match
## e: p1: v1; p2: v2; _: v3`).  Hoists the match into a switch that assigns to
## the local, keeping the result in a `stmt_local` with zero-init followed by the
## switch.  Supports enum and variant scrutinees (the same subset handled by
## `lower_match`).  Integer and string scrutinees are deferred.
## The result type of a `return match ...` expression: the analyzer's recorded
## type for the match, or — when that is unknown — the lowered type of the first
## arm whose value type is known.  Used to type the hoisted result temp.
function current_return_type(ctx: ref[LowerCtx], match_expr: ptr[ast.Expr]) -> types.Type:
    var ty = qualify_type(ctx, expr_type(ctx, match_expr))
    if not types.is_error(ty) and not types.type_to_string(ty) == "void":
        return ty
    unsafe:
        match read(match_expr):
            ast.Expr.expr_match as me:
                var i: ptr_uint = 0
                while i < me.arms.len:
                    var arm: ast.MatchExprArm
                    arm = read(me.arms.data + i)
                    let vt = ir_expr_type(lower_expr(ctx, arm.value))
                    if not types.is_error(vt) and not types.type_to_string(vt) == "void":
                        return vt
                    i += 1
            _:
                pass
    return types.primitive("int")


## Infer the result type of a match expression from its first non-wildcard arm's
## value, so `let x = match e: { a: "s", _: "t" }` types x as `str` instead of `int`.
function infer_match_arm_type(ctx: ref[LowerCtx], arms: span[ast.MatchExprArm]) -> types.Type:
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.MatchExprArm
        unsafe:
            arm = read(arms.data + i)
        let vt = qualify_type(ctx, expr_type(ctx, arm.value))
        if not types.is_error(vt) and not types.type_to_string(vt) == "void":
            return vt
        i += 1
    return types.Type.ty_error


function lower_match_expression_local(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], name: str, declared_type: ptr[ast.TypeRef]?, scrutinee: ptr[ast.Expr], arms: span[ast.MatchExprArm], line: ptr_uint) -> void:
    let c_name = utils.c_local_name(name)
    var ty = types.Type.ty_error
    let dt = declared_type
    if dt != null:
        ty = resolve_type_ref(ctx, dt)
    if types.is_error(ty):
        ty = infer_match_arm_type(ctx, arms)
    if types.is_error(ty):
        ty = types.primitive("int")

    # The host's prepared-expression path: the match writes a fresh
    # `__mt_match_expr_N` temp (zero-initialized), and the declared local copies
    # it afterwards.
    let temp = fresh_c_temp_name(ctx, "match_expr")
    let zero_init = alloc_expr(ir.Expr.expr_zero_init(ty = ty))
    output.push(ir.Stmt.stmt_local(name = temp, linkage_name = temp, ty = ty, value = zero_init, line = 0, source_path = ""))

    let result_ref = alloc_expr(ir.Expr.expr_name(name = temp, ty = ty, pointer = Option[bool].some(value = false)))
    lower_match_expr_to_ref(ctx, output, scrutinee, arms, result_ref)

    let temp_ref = alloc_expr(ir.Expr.expr_name(name = temp, ty = ty, pointer = Option[bool].some(value = false)))
    output.push(ir.Stmt.stmt_local(name = name, linkage_name = c_name, ty = ty, value = temp_ref, line = line, source_path = ctx.analysis.source_path))

    ctx.locals.push(LocalBinding(name = name, c_name = c_name, ty = ty, pointer = Option[bool].some(value = false)))


## Lower a match expression so each arm assigns its value to `result_ref`, using
## the strategy that fits the scrutinee type (str if-chain / variant switch /
## enum switch / tuple if-chain).  The scrutinee is hoisted into a temp when it is
## not already a name so it is evaluated once.  Shared by `let x = match ...`
## (lower_match_expression_local) and the `return match ...` hoist.
function lower_match_expr_to_ref(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee: ptr[ast.Expr], arms: span[ast.MatchExprArm], result_ref: ptr[ir.Expr]) -> void:
    var scrutinee_ty = expr_type(ctx, scrutinee)
    var scrutinee_expr = lower_expr(ctx, scrutinee)
    # Prefer the lowered scrutinee's type (more accurate for prelude/field types).
    let lowered_sty = ir_expr_type(scrutinee_expr)
    if not types.is_error(lowered_sty) and not types.type_to_string(lowered_sty) == "void":
        scrutinee_ty = lowered_sty
    if not ir_expr_is_name(scrutinee_expr):
        # The host hoists the scrutinee into a `match_value` temp only for a
        # *variant* whose arms bind payloads and whose expression is not
        # duplicable — every arm's body reads the scrutinee again; an enum
        # scrutinee (a member access like `this.shape.kind`) switches on the
        # expression itself (`expressions.rb:1148-1154`).
        var binds_payload = false
        var arm_i: ptr_uint = 0
        while arm_i < arms.len:
            var arm_chk: ast.MatchExprArm
            unsafe:
                arm_chk = read(arms.data + arm_i)
            if arm_chk.binding_name.is_some() and arm_chk.wildcard_line == 0:
                binds_payload = true
            arm_i += 1
        let scrut_name = named_type_name(scrutinee_ty)
        var is_variant = false
        match scrut_name:
            Option.some as sn:
                if ctx.variants.contains(sn.value):
                    is_variant = true
            Option.none:
                pass
        if binds_payload and is_variant and not duplicable_foreign_value(scrutinee_expr):
            let temp = fresh_c_temp_name(ctx, "match_value")
            output.push(ir.Stmt.stmt_local(name = temp, linkage_name = temp, ty = scrutinee_ty, value = scrutinee_expr, line = 0, source_path = ""))
            scrutinee_expr = alloc_expr(ir.Expr.expr_name(name = temp, ty = scrutinee_ty, pointer = Option[bool].some(value = false)))

    let type_name = named_type_name(scrutinee_ty)
    if is_str_scrutinee(scrutinee_ty):
        lower_str_match_expr(ctx, output, scrutinee_expr, arms, result_ref)
    else if is_tuple_type(scrutinee_ty):
        lower_tuple_match_expr(ctx, output, scrutinee_expr, scrutinee_ty, arms, result_ref)
    else if type_name.is_some() and ctx.variants.contains(type_name.unwrap()):
        lower_variant_match_expr(ctx, output, scrutinee_expr, type_name.unwrap(), scrutinee_ty, arms, result_ref)
    else:
        lower_enum_match_expr(ctx, output, scrutinee_expr, type_name, arms, result_ref)


## Lower a match expression over a `str` scrutinee: emit an if / else-if chain
## comparing the scrutinee with each arm's string-literal pattern, assigning the
## arm's value to `result_ref` on match.  Mirrors `lower_string_match` for the
## expression form.
function lower_str_match_expr(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee_expr: ptr[ir.Expr], arms: span[ast.MatchExprArm], result_ref: ptr[ir.Expr]) -> void:
    var has_default = false
    var default_val: ptr[ir.Expr]? = null
    var pattern_lits = vec.Vec[ptr[ir.Expr]].create()
    var result_vals = vec.Vec[ptr[ir.Expr]].create()
    var ai: ptr_uint = 0
    while ai < arms.len:
        var arm: ast.MatchExprArm
        unsafe:
            arm = read(arms.data + ai)
        if arm.pattern == null:
            has_default = true
            default_val = lower_expr(ctx, arm.value)
        else:
            unsafe:
                pattern_lits.push(lower_expr(ctx, ptr[ast.Expr]<-arm.pattern))
            result_vals.push(lower_expr(ctx, arm.value))
        ai += 1

    # Emit a proper else-if chain: `if (p0) r=v0; else if (p1) r=v1; ... else
    # r=default;`.  Building it as independent if-thens (with only the final arm
    # carrying the default as its else) is WRONG — the last arm's `else` would
    # clobber an earlier arm's assignment.  Mirrors Ruby's string-match lowering,
    # which nests each subsequent arm inside the prior arm's else branch.
    # Construct from the tail backwards so each arm's else_body is the already-
    # built remainder of the chain.
    var chain = vec.Vec[ir.Stmt].create()
    if has_default:
        let dv = default_val else:
            fatal(c"lowering: str match expr default value")
        chain.push(ir.Stmt.stmt_assignment(target = result_ref, operator = "=", value = dv))

    var back = pattern_lits.len
    while back > 0:
        back -= 1
        let pat_ptr = pattern_lits.get(back) else:
            fatal(c"lowering: str match expr pattern")
        let val_ptr = result_vals.get(back) else:
            fatal(c"lowering: str match expr value")
        let condition = alloc_expr(ir.Expr.expr_binary(
            operator = "==",
            left = scrutinee_expr,
            right = unsafe: read(pat_ptr),
            ty = ctx.bool_ty,
        ))
        var then_body = vec.Vec[ir.Stmt].create()
        then_body.push(ir.Stmt.stmt_assignment(target = result_ref, operator = "=", value = unsafe: read(val_ptr)))
        let else_body = Option[span[ir.Stmt]].some(value = chain.as_span())
        var next_chain = vec.Vec[ir.Stmt].create()
        next_chain.push(ir.Stmt.stmt_if(condition = condition, then_body = then_body.as_span(), else_body = else_body))
        chain = next_chain

    append_span_stmts(output, chain.as_span())


## Lower a match expression over a tuple scrutinee: for each arm, compare the
## tuple element-wise (`scrut._0 == e0 && scrut._1 == e1 && ...`) and assign the
## arm value on match.  The host nests the chain into else bodies (the wildcard
## arm is the innermost else), so exactly one arm's assignment executes.
function lower_tuple_match_expr(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee_expr: ptr[ir.Expr], scrutinee_ty: types.Type, arms: span[ast.MatchExprArm], result_ref: ptr[ir.Expr]) -> void:
    # The wildcard arm (built first, as the host does) is the chain's else body.
    var else_body = vec.Vec[ir.Stmt].create()
    var ai: ptr_uint = 0
    while ai < arms.len:
        var arm: ast.MatchExprArm
        unsafe:
            arm = read(arms.data + ai)
        if arm.pattern == null:
            let value = lower_expr(ctx, arm.value)
            else_body.push(ir.Stmt.stmt_assignment(target = result_ref, operator = "=", value = value))
        ai += 1

    # Construct from the tail backwards so each arm's else body is the
    # already-built remainder of the chain (the host's non_wildcard.reverse_each).
    var idx = arms.len
    while idx > 0:
        idx -= 1
        var arm: ast.MatchExprArm
        unsafe:
            arm = read(arms.data + idx)
        let pattern = arm.pattern
        if pattern != null:
            var then_body = vec.Vec[ir.Stmt].create()
            then_body.push(ir.Stmt.stmt_assignment(target = result_ref, operator = "=", value = lower_expr(ctx, arm.value)))
            let cond = tuple_pattern_condition(ctx, scrutinee_expr, scrutinee_ty, unsafe: read(pattern))
            var chain = vec.Vec[ir.Stmt].create()
            chain.push(ir.Stmt.stmt_if(condition = cond, then_body = then_body.as_span(), else_body = Option[span[ir.Stmt]].some(value = else_body.as_span())))
            else_body = chain

    append_span_stmts(output, else_body.as_span())


## Lower a tuple-literal match statement to an if / else-if chain of
## per-element equality conditions, with the `_` arm as the final else.
function lower_tuple_match_stmt(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee_expr: ptr[ir.Expr], scrutinee_ty: types.Type, arms: span[ast.MatchArm]) -> void:
    # The host's match-to-if chains always carry an else body; the innermost
    # `if` falls back to an empty one when there is no wildcard arm.
    var else_body = Option[span[ir.Stmt]].some(value = span[ir.Stmt]())
    var wi: ptr_uint = 0
    while wi < arms.len:
        var warm: ast.MatchArm
        unsafe:
            warm = read(arms.data + wi)
        if warm.pattern == null:
            else_body = Option[span[ir.Stmt]].some(value = lower_block(ctx, warm.body))
        wi += 1
    var idx = arms.len
    while idx > 0:
        idx -= 1
        var arm: ast.MatchArm
        unsafe:
            arm = read(arms.data + idx)
        let pattern = arm.pattern
        if pattern != null:
            let cond = tuple_pattern_condition(ctx, scrutinee_expr, scrutinee_ty, unsafe: read(pattern))
            var chain = vec.Vec[ir.Stmt].create()
            chain.push(ir.Stmt.stmt_if(condition = cond, then_body = lower_block(ctx, arm.body), else_body = else_body))
            else_body = Option[span[ir.Stmt]].some(value = chain.as_span())
    match else_body:
        Option.some as eb:
            var oi: ptr_uint = 0
            while oi < eb.value.len:
                unsafe:
                    output.push(read(eb.value.data + oi))
                oi += 1
        Option.none:
            pass


## Build the boolean condition for a tuple-literal pattern: the conjunction of
## per-element equality tests `scrut._i == elem_i`.  `_` elements are skipped
## (they match anything).  Returns a literal `true` when the pattern has no
## constraining elements.
function tuple_pattern_condition(ctx: ref[LowerCtx], scrutinee_expr: ptr[ir.Expr], scrutinee_ty: types.Type, pattern: ast.Expr) -> ptr[ir.Expr]:
    var cond: ptr[ir.Expr]? = null
    match pattern:
        ast.Expr.expr_expression_list as lst:
            var i: ptr_uint = 0
            while i < lst.elements.len:
                var elem: ast.Expr
                unsafe:
                    elem = read(lst.elements.data + i)
                    if not expr_is_wildcard(elem):
                        let elem_ty = tuple_element_type(scrutinee_ty, i)
                        var member_name = tuple_field_name(i)
                        match scrutinee_ty:
                            types.Type.ty_tuple as tup:
                                match tup.field_names:
                                    Option.some as fnames:
                                        if i < fnames.value.len:
                                            member_name = unsafe: read(fnames.value.data + i)
                                    Option.none:
                                        pass
                            _:
                                pass
                        let field = alloc_expr(ir.Expr.expr_member(receiver = scrutinee_expr, member = member_name, ty = elem_ty))
                        let elem_expr = lower_expr(ctx, unsafe: ptr[ast.Expr]<-(lst.elements.data + i))
                        let cmp = alloc_expr(ir.Expr.expr_binary(operator = "==", left = field, right = elem_expr, ty = ctx.bool_ty))
                        let existing = cond
                        if existing == null:
                            cond = cmp
                        else:
                            cond = alloc_expr(ir.Expr.expr_binary(operator = "and", left = existing, right = cmp, ty = ctx.bool_ty))
                i += 1
        _:
            pass
    let final_cond = cond else:
        return alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = ctx.bool_ty))
    return final_cond


## True when an expression is the `_` wildcard identifier.
function expr_is_wildcard(e: ast.Expr) -> bool:
    match e:
        ast.Expr.expr_identifier as id:
            return id.name == "_"
        _:
            return false


## Lower a match expression over an enum scrutinee: emit a switch whose cases
## assign the result and break, plus a default case for the wildcard arm.
function lower_enum_match_expr(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee_expr: ptr[ir.Expr], type_name: Option[str], arms: span[ast.MatchExprArm], result_ref: ptr[ir.Expr]) -> void:
    var cases = vec.Vec[ir.SwitchCase].create()
    var enum_module = enum_source_module(ctx, ir_expr_type(scrutinee_expr), ctx.module_name)
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.MatchExprArm
        unsafe:
            arm = read(arms.data + i)
        let lowered_val = lower_expr(ctx, arm.value)
        var body = vec.Vec[ir.Stmt].create()
        body.push(ir.Stmt.stmt_assignment(target = result_ref, operator = "=", value = lowered_val))
        let pattern = arm.pattern
        if pattern == null:
            cases.push(ir.SwitchCase(is_default = true, value = null, body = body.as_span()))
        else:
            let member = match_member_name(pattern) else:
                # Non-enum pattern (integer literal, char literal, etc.): the
                # literal takes the scrutinee's type, as `lower_pattern_expression`
                # does on the host.
                var lowered_pat = lower_expr(ctx, pattern)
                lowered_pat = literal_value_to_context_type(ctx, pattern, ir_expr_type(scrutinee_expr), lowered_pat)
                cases.push(ir.SwitchCase(is_default = false, value = lowered_pat, body = body.as_span()))
                i += 1
                continue
            match type_name:
                Option.some as tn:
                    let value = alloc_expr(ir.Expr.expr_name(
                        name = enum_member_reference_c_name(ctx, enum_module, tn.value, member),
                        ty = ir_expr_type(scrutinee_expr),
                        pointer = Option[bool].some(value = false),
                    ))
                    cases.push(ir.SwitchCase(is_default = false, value = value, body = body.as_span()))
                Option.none:
                    fatal(c"lowering: match expression on non-enum scrutinee")
        i += 1

    output.push(ir.Stmt.stmt_switch(expression = scrutinee_expr, cases = cases.as_span(), exhaustive = true))


## Lower a match expression over a variant scrutinee: emit a switch on the variant
## kind, with each arm assigning its value to the result reference.
function lower_variant_match_expr(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee_expr: ptr[ir.Expr], variant_name: str, scrutinee_ty: types.Type, arms: span[ast.MatchExprArm], result_ref: ptr[ir.Expr]) -> void:
    let info_ptr = ctx.variants.get(variant_registry_key(ctx, variant_name, scrutinee_ty)) else:
        fatal(c"lowering: variant match expr on unknown variant")
    let info = unsafe: read(info_ptr)
    let outer_c = variant_base_c_name(scrutinee_ty, ctx.module_name)
    let int_ty = types.primitive("int")
    let kind_expr = alloc_expr(ir.Expr.expr_member(receiver = scrutinee_expr, member = "kind", ty = int_ty))

    var cases = vec.Vec[ir.SwitchCase].create()
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.MatchExprArm
        unsafe:
            arm = read(arms.data + i)
        var body = vec.Vec[ir.Stmt].create()
        let pattern = arm.pattern
        if pattern != null:
            match arm.binding_name:
                Option.some as bn:
                    let arm_name = variant_match_arm_name_from_pattern(pattern) else:
                        fatal(c"lowering: unsupported variant match expression pattern")
                    let binding_ty = variant_arm_payload_binding(variant_name, info.module_name, outer_c, arm_name)
                    register_arm_payload_fields(ctx, variant_arm_type_name(outer_c, arm_name), info, arm_name, scrutinee_ty)
                    let data_member = alloc_expr(ir.Expr.expr_member(receiver = scrutinee_expr, member = "data", ty = types.Type.ty_nil))
                    let arm_data = alloc_expr(ir.Expr.expr_member(receiver = data_member, member = arm_name, ty = binding_ty))
                    let bc = utils.c_local_name(bn.value)
                    # The host's plain match-expression lowering (expressions.rb:
                    # 1166-1173) always declares the binding as a C local — its
                    # async path has no frame spill here.
                    body.push(ir.Stmt.stmt_local(name = bn.value, linkage_name = bc, ty = binding_ty, value = arm_data, line = 0, source_path = ""))
                    ctx.locals.push(LocalBinding(name = bn.value, c_name = bc, ty = binding_ty, pointer = Option[bool].some(value = false)))
                Option.none:
                    pass
        let lowered_val = lower_expr(ctx, arm.value)
        body.push(ir.Stmt.stmt_assignment(target = result_ref, operator = "=", value = lowered_val))

        if pattern == null:
            cases.push(ir.SwitchCase(is_default = true, value = null, body = body.as_span()))
        else:
            let arm_name = variant_match_arm_name_from_pattern(pattern) else:
                fatal(c"lowering: unsupported variant match expression pattern")
            let kind_const = alloc_expr(ir.Expr.expr_name(
                name = variant_kind_const_name(outer_c, arm_name),
                ty = int_ty,
                pointer = Option[bool].some(value = false),
            ))
            cases.push(ir.SwitchCase(is_default = false, value = kind_const, body = body.as_span()))
        i += 1

    output.push(ir.Stmt.stmt_switch(expression = kind_expr, cases = cases.as_span(), exhaustive = true))


## Lower a `match` over a variant scrutinee into a `switch (scrut.kind)`.  Each
## payload arm may bind the whole payload struct via `as name`
## (`<arm_c> name = scrut.data.<arm>;`); no-payload arms carry no binding.  A
## non-name scrutinee is hoisted into a temp so it is evaluated once.
## Dispatch a variant match to the switch strategy (member / `as name` /
## no-payload / wildcard arms) or the if/goto strategy (any struct-pattern arm,
## i.e. `Variant.arm(field, ...)`), mirroring Ruby's block.rb decision.
function lower_variant_match(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee_expr: ptr[ir.Expr], variant_name: str, scrutinee_ty: types.Type, arms: span[ast.MatchArm]) -> void:
    if arms_have_call_pattern(arms):
        lower_variant_match_goto(ctx, output, scrutinee_expr, variant_name, scrutinee_ty, arms)
    else:
        lower_variant_match_switch(ctx, output, scrutinee_expr, variant_name, scrutinee_ty, arms)


## True when any arm's pattern is a call (a struct-destructure pattern such as
## `Shape.circle(r)`), which forces the if/goto lowering strategy.
function arms_have_call_pattern(arms: span[ast.MatchArm]) -> bool:
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.MatchArm
        unsafe:
            arm = read(arms.data + i)
        let pattern = arm.pattern
        if pattern != null:
            unsafe:
                match read(pattern):
                    ast.Expr.expr_call:
                        return true
                    _:
                        pass
        i += 1
    return false


function lower_variant_match_switch(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee_expr: ptr[ir.Expr], variant_name: str, scrutinee_ty: types.Type, arms: span[ast.MatchArm]) -> void:
    # If variant_name includes type args (e.g. "Option_span_Field"), strip to
    # the base name (e.g. "Option") to find the variant info.
    var info_ptr = ctx.variants.get(variant_registry_key(ctx, variant_name, scrutinee_ty))
    if info_ptr == null:
        let bn = variant_base_name(variant_name)
        if bn.is_some():
            info_ptr = ctx.variants.get(variant_registry_key(ctx, bn.unwrap(), scrutinee_ty))
    let info_ptr2 = info_ptr else:
        fatal(c"lowering: variant match on unknown variant")
    let info = unsafe: read(info_ptr2)
    let outer_c = variant_base_c_name(scrutinee_ty, ctx.module_name)
    let int_ty = types.primitive("int")

    var scrut_base = scrutinee_expr
    if not ir_expr_is_name(scrut_base):
        # The host's hoist rule (`block.rb:847-853`): a `match_value` temp only
        # when some arm binds a payload and the expression is not duplicable.
        var binds_payload = false
        var arm_i: ptr_uint = 0
        while arm_i < arms.len:
            var arm_chk: ast.MatchArm
            unsafe:
                arm_chk = read(arms.data + arm_i)
            if arm_chk.binding_name.is_some() and not (arm_chk.pattern == null):
                binds_payload = true
            arm_i += 1
        if binds_payload and not duplicable_foreign_value(scrut_base):
            let temp = fresh_c_temp_name(ctx, "match_value")
            let scrut_ty = ir_expr_type(scrut_base)
            output.push(ir.Stmt.stmt_local(name = temp, linkage_name = temp, ty = scrut_ty, value = scrut_base, line = 0, source_path = ""))
            scrut_base = alloc_expr(ir.Expr.expr_name(name = temp, ty = scrut_ty, pointer = Option[bool].some(value = false)))

    let kind_expr = alloc_expr(ir.Expr.expr_member(receiver = scrut_base, member = "kind", ty = int_ty))
    var cases = vec.Vec[ir.SwitchCase].create()
    var i: ptr_uint = 0
    while i < arms.len:
        var arm: ast.MatchArm
        var arm_key: ptr_uint = 0
        unsafe:
            arm = read(arms.data + i)
            arm_key = reinterpret[ptr_uint](arms.data + i)
        let pattern = arm.pattern
        if pattern == null:
            if ctx.async_cps_active:
                # The CPS match lowering appends a native break to every case
                # body (the host's `lower_async_cf_match_stmt`,
                # async_lowering.rb:573-590), even after a terminating return.
                var case_body = vec.Vec[ir.Stmt].create()
                append_span_stmts(ref_of(case_body), lower_switch_arm_body(ctx, arm.body))
                case_body.push(ir.Stmt.stmt_break)
                cases.push(ir.SwitchCase(is_default = true, value = null, body = case_body.as_span()))
            else:
                cases.push(ir.SwitchCase(is_default = true, value = null, body = lower_switch_arm_body(ctx, arm.body)))
        else:
            let arm_name = match_member_name(pattern) else:
                fatal(c"lowering: unsupported variant match pattern")
            var stmts = vec.Vec[ir.Stmt].create()
            var reg_field = ""
            var reg_field_ty = ctx.void_ty
            match arm.binding_name:
                Option.some as bn:
                    let binding_ty = variant_arm_payload_binding(variant_name, info.module_name, outer_c, arm_name)
                    register_arm_payload_fields(ctx, variant_arm_type_name(outer_c, arm_name), info, arm_name, scrutinee_ty)
                    let data_member = alloc_expr(ir.Expr.expr_member(receiver = scrut_base, member = "data", ty = types.Type.ty_nil))
                    let arm_data = alloc_expr(ir.Expr.expr_member(receiver = data_member, member = arm_name, ty = binding_ty))
                    let bc = utils.c_local_name(bn.value)
                    if ctx.inside_async:
                        # The host's lowering-pass counter advance
                        # (`async_variant_match_arm_binding` →
                        # `async_match_binding_field_key`, async_lowering.rb:1333).
                        # Its `local_fields` lookup never matches, so the arm
                        # binding is a plain C local and the analysis-registered
                        # field stays unused.
                        if arm_has_payload(info, arm_name):
                            async_binding_cnt += 1
                        let fname_ptr = ctx.async_match_binding_names.get(arm_key)
                        if fname_ptr != null:
                            reg_field = unsafe: read(ptr[str]<-fname_ptr)
                            reg_field_ty = binding_ty
                    stmts.push(ir.Stmt.stmt_local(name = bn.value, linkage_name = bc, ty = binding_ty, value = arm_data, line = 0, source_path = ""))
                    ctx.locals.push(LocalBinding(name = bn.value, c_name = bc, ty = binding_ty, pointer = Option[bool].some(value = false)))
                Option.none:
                    pass
            let body = lower_switch_arm_body(ctx, arm.body)
            var bi: ptr_uint = 0
            while bi < body.len:
                unsafe:
                    stmts.push(read(body.data + bi))
                bi += 1
            if reg_field != "":
                async_register_unused_field(ctx, reg_field, reg_field_ty)
            if ctx.async_cps_active:
                stmts.push(ir.Stmt.stmt_break)
            let kind_const = alloc_expr(ir.Expr.expr_name(
                name = variant_kind_const_name(outer_c, arm_name),
                ty = int_ty,
                pointer = Option[bool].some(value = false),
            ))
            cases.push(ir.SwitchCase(is_default = false, value = kind_const, body = stmts.as_span()))
        i += 1

    output.push(ir.Stmt.stmt_switch(expression = kind_expr, cases = cases.as_span(), exhaustive = true))


## Lower a variant match with struct-pattern arms into an if/goto chain: each arm
## tests `scrut.kind`, jumps to the next arm's label on mismatch, otherwise binds
## the payload into a temp, destructures its fields, and falls through to the arm
## body then `goto <end>`.  Mirrors Ruby's block.rb struct-pattern match path.
function lower_variant_match_goto(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee_expr: ptr[ir.Expr], variant_name: str, scrutinee_ty: types.Type, arms: span[ast.MatchArm]) -> void:
    let info_ptr = ctx.variants.get(variant_registry_key(ctx, variant_name, scrutinee_ty)) else:
        fatal(c"lowering: variant match on unknown variant")
    let info = unsafe: read(info_ptr)
    let outer_c = variant_base_c_name(scrutinee_ty, ctx.module_name)
    let int_ty = types.primitive("int")
    let bool_ty = ctx.bool_ty

    var scrut_base = scrutinee_expr
    if not ir_expr_is_name(scrut_base):
        let temp = fresh_c_temp_name(ctx, "match_value")
        let scrut_ty = ir_expr_type(scrut_base)
        output.push(ir.Stmt.stmt_local(name = temp, linkage_name = temp, ty = scrut_ty, value = scrut_base, line = 0, source_path = ""))
        scrut_base = alloc_expr(ir.Expr.expr_name(name = temp, ty = scrut_ty, pointer = Option[bool].some(value = false)))

    ctx.match_label_counter += 1
    let m = ctx.match_label_counter
    let end_label = match_label_name(m, "end")
    let next_label = match_label_name(m, "arm_next")

    var arm_index: ptr_uint = 0
    while arm_index < arms.len:
        var arm: ast.MatchArm
        var arm_key: ptr_uint = 0
        unsafe:
            arm = read(arms.data + arm_index)
            arm_key = reinterpret[ptr_uint](arms.data + arm_index)
        if arm_index > 0:
            output.push(ir.Stmt.stmt_label(name = match_arm_label(m, arm_index)))

        let pattern = arm.pattern
        if pattern == null:
            var blk = vec.Vec[ir.Stmt].create()
            append_span_stmts(ref_of(blk), lower_block(ctx, arm.body))
            blk.push(ir.Stmt.stmt_goto(label = end_label))
            output.push(ir.Stmt.stmt_block(body = blk.as_span()))
        else:
            let arm_name = variant_match_arm_name_from_pattern(pattern) else:
                fatal(c"lowering: unsupported variant match pattern")
            let goto_label = if arm_index < arms.len - 1: match_arm_label(m, arm_index + 1) else: next_label

            let kind_expr = alloc_expr(ir.Expr.expr_member(receiver = scrut_base, member = "kind", ty = int_ty))
            let tag_value = alloc_expr(ir.Expr.expr_name(name = variant_kind_const_name(outer_c, arm_name), ty = int_ty, pointer = Option[bool].some(value = false)))
            let tag_check = alloc_expr(ir.Expr.expr_binary(operator = "!=", left = kind_expr, right = tag_value, ty = bool_ty))
            var then_body = vec.Vec[ir.Stmt].create()
            then_body.push(ir.Stmt.stmt_goto(label = goto_label))
            # The host emits an empty (present) else branch for arm tag checks.
            output.push(ir.Stmt.stmt_if(condition = tag_check, then_body = then_body.as_span(), else_body = Option[span[ir.Stmt]].some(value = span[ir.Stmt]())))

            var blk = vec.Vec[ir.Stmt].create()
            var reg_field = ""
            let payload_ty = variant_arm_payload_binding(variant_name, info.module_name, outer_c, arm_name)
            register_arm_payload_fields(ctx, variant_arm_type_name(outer_c, arm_name), info, arm_name, scrutinee_ty)
            match variant_arm_info(info, arm_name):
                Option.some as ai:
                    if ai.value.field_names.len > 0:
                        let payload_c = fresh_c_temp_name(ctx, "match_payload")
                        let data_member = alloc_expr(ir.Expr.expr_member(receiver = scrut_base, member = "data", ty = types.Type.ty_nil))
                        let arm_data = alloc_expr(ir.Expr.expr_member(receiver = data_member, member = arm_name, ty = payload_ty))
                        if ctx.async_cps_active:
                            # Spill the match arm's payload struct to a frame
                            # field so pattern-bindings and `as` binding survive
                            # await inside the arm body.
                            let mfield = j2("local_", payload_c)
                            let mcname = j2("__mt_frame->", mfield)
                            async_register_local_field(ctx, payload_c, mfield, mcname, payload_ty)
                            blk.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_name(name = mcname, ty = payload_ty, pointer = Option[bool].some(value = false))), operator = "=", value = arm_data))
                        else:
                            blk.push(ir.Stmt.stmt_local(name = payload_c, linkage_name = payload_c, ty = payload_ty, value = arm_data, line = 0, source_path = ""))
                            ctx.locals.push(LocalBinding(name = payload_c, c_name = payload_c, ty = payload_ty, pointer = Option[bool].some(value = false)))
                        lower_variant_field_bindings(ctx, ref_of(blk), pattern, ai.value, payload_c, payload_ty, goto_label)
                        match arm.binding_name:
                            Option.some as bn:
                                let bc = utils.c_local_name(bn.value)
                                let payload_ref = alloc_expr(ir.Expr.expr_name(name = payload_c, ty = payload_ty, pointer = Option[bool].some(value = false)))
                                if ctx.inside_async:
                                    # The host's lowering-pass counter advance for
                                    # the `as` binding (the payload temp above has
                                    # no host counterpart: the host's async match
                                    # path only handles member-pattern arms).
                                    async_binding_cnt += 1
                                    let gname_ptr = ctx.async_match_binding_names.get(arm_key)
                                    if gname_ptr != null:
                                        reg_field = unsafe: read(ptr[str]<-gname_ptr)
                                blk.push(ir.Stmt.stmt_local(name = bn.value, linkage_name = bc, ty = payload_ty, value = payload_ref, line = 0, source_path = ""))
                                ctx.locals.push(LocalBinding(name = bn.value, c_name = bc, ty = payload_ty, pointer = Option[bool].some(value = false)))
                            Option.none:
                                pass
                Option.none:
                    pass
            append_span_stmts(ref_of(blk), lower_block(ctx, arm.body))
            if reg_field != "":
                async_register_unused_field(ctx, reg_field, payload_ty)
            blk.push(ir.Stmt.stmt_goto(label = end_label))
            output.push(ir.Stmt.stmt_block(body = blk.as_span()))
        arm_index += 1

    output.push(ir.Stmt.stmt_label(name = next_label))
    output.push(ir.Stmt.stmt_label(name = end_label))


## Emit `<field_type> <field> = <payload>.<field>;` bindings for each bare
## identifier in a struct pattern's argument list, skipping `_` discards.
## Guards (`field > expr`) and equality patterns (`field = expr`) are emitted
## as conditional `goto next_arm_label` checks on failure.
function lower_variant_field_bindings(ctx: ref[LowerCtx], blk: ref[vec.Vec[ir.Stmt]], pattern: ptr[ast.Expr], arm_info: VariantArmInfo, payload_c: str, payload_ty: types.Type, next_arm_label: str) -> void:
    let bool_ty = ctx.bool_ty
    unsafe:
        match read(pattern):
            ast.Expr.expr_call as cl:
                var i: ptr_uint = 0
                while i < cl.args.len:
                    var arg: ast.Argument
                    arg = read(cl.args.data + i)
                    match arg.arg_name:
                        Option.some as eq_name:
                            # Equality pattern: `field = expr` —
                            # skip arm if payload.field != expr.
                            let field_ty = variant_arm_field_type(arm_info, eq_name.value)
                            let payload_ref = alloc_expr(ir.Expr.expr_name(name = payload_c, ty = payload_ty, pointer = Option[bool].some(value = false)))
                            let left = alloc_expr(ir.Expr.expr_member(receiver = payload_ref, member = eq_name.value, ty = field_ty))
                            let right = lower_expr(ctx, arg.arg_value)
                            let cond = alloc_expr(ir.Expr.expr_binary(operator = "!=", left = left, right = right, ty = bool_ty))
                            var guard_body = vec.Vec[ir.Stmt].create()
                            guard_body.push(ir.Stmt.stmt_goto(label = next_arm_label))
                            blk.push(ir.Stmt.stmt_if(condition = cond, then_body = guard_body.as_span(), else_body = Option[span[ir.Stmt]].some(value = span[ir.Stmt]())))
                        Option.none:
                            pass
                    match read(arg.arg_value):
                        ast.Expr.expr_identifier as id:
                            if not id.name == "_":
                                let field_ty = variant_arm_field_type(arm_info, id.name)
                                let bc = utils.c_local_name(id.name)
                                let payload_ref = alloc_expr(ir.Expr.expr_name(name = payload_c, ty = payload_ty, pointer = Option[bool].some(value = false)))
                                var field_expr = alloc_expr(ir.Expr.expr_member(receiver = payload_ref, member = id.name, ty = field_ty))
                                # Auto-dereference recursive variant fields.
                                match payload_ty:
                                    types.Type.ty_named as pn:
                                        if ctx.arm_payload_fields.contains(pn.name) and is_recursive_variant_field(payload_ty, field_ty):
                                            field_expr = alloc_expr(ir.Expr.expr_unary(operator = "*", operand = field_expr, ty = field_ty))
                                    types.Type.ty_imported as pi:
                                        if ctx.arm_payload_fields.contains(naming.qualified_c_name(pi.module_name, pi.name)) and is_recursive_variant_field(payload_ty, field_ty):
                                            field_expr = alloc_expr(ir.Expr.expr_unary(operator = "*", operand = field_expr, ty = field_ty))
                                    _:
                                        pass
                                if ctx.async_cps_active:
                                    let vfield = j4("local_", payload_c, "_", id.name)
                                    let vcname = j2("__mt_frame->", vfield)
                                    async_register_local_field(ctx, id.name, vfield, vcname, field_ty)
                                    blk.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_name(name = vcname, ty = field_ty, pointer = Option[bool].some(value = false))), operator = "=", value = field_expr))
                                else:
                                    blk.push(ir.Stmt.stmt_local(name = id.name, linkage_name = bc, ty = field_ty, value = field_expr, line = 0, source_path = ""))
                                    ctx.locals.push(LocalBinding(name = id.name, c_name = bc, ty = field_ty, pointer = Option[bool].some(value = false)))
                        ast.Expr.expr_binary_op as b:
                            # Guard pattern: `field comparison_op expr` —
                            # skip arm if guard condition is false.
                            # The left side must be a bare identifier (field name);
                            # we resolve it against the payload struct.
                            var left_name: str = ""
                            unsafe:
                                match read(b.left):
                                    ast.Expr.expr_identifier as lid:
                                        left_name = lid.name
                                    _:
                                        pass
                            if left_name != "":
                                let field_ty = variant_arm_field_type(arm_info, left_name)
                                let payload_ref = alloc_expr(ir.Expr.expr_name(name = payload_c, ty = payload_ty, pointer = Option[bool].some(value = false)))
                                let left_expr = alloc_expr(ir.Expr.expr_member(receiver = payload_ref, member = left_name, ty = field_ty))
                                let right_expr = lower_expr(ctx, b.right)
                                let cond = alloc_expr(ir.Expr.expr_binary(operator = b.operator, left = left_expr, right = right_expr, ty = bool_ty))
                                var guard_fail = vec.Vec[ir.Stmt].create()
                                guard_fail.push(ir.Stmt.stmt_goto(label = next_arm_label))
                                blk.push(ir.Stmt.stmt_if(condition = cond, then_body = span[ir.Stmt](), else_body = Option[span[ir.Stmt]].some(value = guard_fail.as_span())))
                        _:
                            pass
                    i += 1
            _:
                pass


## The arm name of a variant match pattern: `Variant.arm` (member access) or
## `Variant.arm(...)` (call whose callee is that member access).
function variant_match_arm_name_from_pattern(pattern: ptr[ast.Expr]) -> Option[str]:
    unsafe:
        match read(pattern):
            ast.Expr.expr_member_access as ma:
                return Option[str].some(value = ma.member_name)
            ast.Expr.expr_call as cl:
                return match_member_name(cl.callee)
            _:
                return Option[str].none


## The type of a named field within a variant arm, or `ty_error` when absent.
function variant_arm_field_type(arm_info: VariantArmInfo, field_name: str) -> types.Type:
    var i: ptr_uint = 0
    while i < arm_info.field_names.len:
        unsafe:
            if read(arm_info.field_names.data + i) == field_name:
                return read(arm_info.field_types.data + i)
        i += 1
    return types.Type.ty_error


## `__mt_match_<m>_<suffix>` label name.
function match_label_name(m: ptr_uint, suffix: str) -> str:
    var buf = string.String.create()
    buf.append("__mt_match_")
    fmt.append_ptr_uint(ref_of(buf), m)
    buf.append("_")
    buf.append(suffix)
    return buf.as_str()


## `__mt_match_<m>_arm_<index>` label name.
function match_arm_label(m: ptr_uint, index: ptr_uint) -> str:
    var buf = string.String.create()
    buf.append("__mt_match_")
    fmt.append_ptr_uint(ref_of(buf), m)
    buf.append("_arm_")
    fmt.append_ptr_uint(ref_of(buf), index)
    return buf.as_str()


## True when a lowered statement sequence ends in a terminator (return / goto /
## break / continue), so a following `goto` would be unreachable and is omitted —
## keeping the `end` label unused so the backend can drop it, matching Ruby.
function stmts_terminate(stmts: span[ir.Stmt]) -> bool:
    if stmts.len == 0:
        return false
    unsafe:
        match read(stmts.data + stmts.len - 1):
            ir.Stmt.stmt_return:
                return true
            ir.Stmt.stmt_goto:
                return true
            ir.Stmt.stmt_break:
                return true
            ir.Stmt.stmt_continue:
                return true
            _:
                return false


## True when any statement (recursively) transfers control to `label`.  A loop
## emits its continue/break label only when its body actually targets it
## (mirrors Ruby's `contains_label_target?`).
function contains_label_target(stmts: span[ir.Stmt], label: str) -> bool:
    var i: ptr_uint = 0
    while i < stmts.len:
        var s: ir.Stmt
        unsafe:
            s = read(stmts.data + i)
        match s:
            ir.Stmt.stmt_goto as g:
                if g.label == label:
                    return true
            ir.Stmt.stmt_block as b:
                if contains_label_target(b.body, label):
                    return true
            ir.Stmt.stmt_while as w:
                if contains_label_target(w.body, label):
                    return true
            ir.Stmt.stmt_for as f:
                if contains_label_target(f.body, label):
                    return true
            ir.Stmt.stmt_if as ifs:
                if contains_label_target(ifs.then_body, label):
                    return true
                match ifs.else_body:
                    Option.some as eb:
                        if contains_label_target(eb.value, label):
                            return true
                    Option.none:
                        pass
            ir.Stmt.stmt_switch as sw:
                var ci: ptr_uint = 0
                while ci < sw.cases.len:
                    var c: ir.SwitchCase
                    unsafe:
                        c = read(sw.cases.data + ci)
                    if contains_label_target(c.body, label):
                        return true
                    ci += 1
            _:
                pass
        i += 1
    return false


## Append every statement of a lowered block span into an output vector.
function append_span_stmts(dest: ref[vec.Vec[ir.Stmt]], stmts: span[ir.Stmt]) -> void:
    var i: ptr_uint = 0
    while i < stmts.len:
        unsafe:
            dest.push(read(stmts.data + i))
        i += 1


## The `types.Type` name for a variant arm's payload struct so it renders as the
## arm C name (`Token` + `ident` -> `Token_ident`, then `<module>_Token_ident`).
function variant_arm_type_name(outer_c: str, arm_name: str) -> str:
    var buf = string.String.create()
    buf.append(outer_c)
    buf.append("_")
    buf.append(arm_name)
    return buf.as_str()


## The module that owns a prelude variant's arm-payload binding type.  A local
## variant's `VariantInfo.module_name` is authoritative; a prelude variant is
## registered module-less, so fall back to its standard module.
function variant_arm_owner_module(variant_name: str, owner_module: str) -> str:
    if owner_module.len > 0:
        return owner_module
    if variant_name == "Option":
        return "std.option"
    if variant_name == "Result":
        return "std.result"
    return ""


## The `as name` binding type of a variant match arm, tagged `VariantArmPayload`
## (base variant name + module for rendering, payload C name for codegen).
function variant_arm_payload_binding(variant_name: str, owner_module: str, outer_c: str, arm_name: str) -> types.Type:
    return types.variant_arm_payload(
        variant_name = variant_name,
        module_name = variant_arm_owner_module(variant_name, owner_module),
        c_name = variant_arm_type_name(outer_c, arm_name),
        arm_name = arm_name,
    )


## The declared name and owning module of a variant-typed storage
## (`Option[int]` -> ("Option", "std.option")), used to tag guard projections.
function variant_declared_identity(ty: types.Type, fallback_module: str) -> (str, str):
    match ty:
        types.Type.ty_generic as g:
            return (g.name, variant_arm_owner_module(g.name, ""))
        types.Type.ty_imported as im:
            if is_prelude_variant_name(im.name):
                return (im.name, variant_arm_owner_module(im.name, ""))
            return (im.name, im.module_name)
        types.Type.ty_named as n:
            if is_prelude_variant_name(n.name):
                return (n.name, variant_arm_owner_module(n.name, ""))
            return (n.name, if n.module_name.len > 0: n.module_name else: fallback_module)
        _:
            return ("", fallback_module)


## The `ctx.variants` key for a variant reference.  Two modules may declare the
## same variant name (`mtc.ir.Expr` and `mtc.parser.ast.Expr`); the scrutinee
## type's own module selects the right entry, and the bare name stays the
## fallback (prelude variants and single-module programs).
function variant_registry_key(ctx: ref[LowerCtx], variant_name: str, ty: types.Type) -> str:
    var base = variant_name
    let bn = variant_base_name(variant_name)
    if bn.is_some():
        base = bn.unwrap()
    let (_, decl_module) = variant_declared_identity(ty, ctx.module_name)
    if decl_module.len > 0:
        let qualified = j2(j2(decl_module, "."), base)
        if ctx.variants.contains(qualified):
            return qualified
    return variant_name


## Record a match-arm payload binding's field info under its payload struct C
## name, so member access on the binding (e.g. `un.operator`) resolves field
## types via `arm_payload_field_type`.  Prelude Option/Result arms carry a
## `_phantom` placeholder payload type (their VariantInfo is generic); it is
## specialized here against the scrutinee's concrete type args so `s.value` /
## `f.error` resolve to the real type instead of an undeclared `_phantom` C type.
function register_arm_payload_fields(ctx: ref[LowerCtx], payload_c_name: str, info: VariantInfo, arm_name: str, scrutinee_ty: types.Type) -> void:
    # An entry may already be registered by `install_imported_variants`, keyed by
    # the module-qualified payload C name with field types resolved in the OWNER
    # module's context.  That entry is authoritative and must not be overwritten
    # here: `info` comes from `ctx.variants[base_name]`, which for a bare name that
    # collides across modules (e.g. both `ir.Stmt` and `ast.Stmt` are "Stmt") may
    # be the WRONG module's variant.  Only (re)register when absent, or when this
    # is a prelude variant (whose `_phantom` placeholder must be specialized
    # against the concrete scrutinee type args at each match site).
    if ctx.arm_payload_fields.contains(payload_c_name) and not is_prelude_variant_name(payload_c_name):
        return
    var i: ptr_uint = 0
    while i < info.arms.len:
        var arm_info: VariantArmInfo
        unsafe:
            arm_info = read(info.arms.data + i)
        if arm_info.name == arm_name:
            ctx.arm_payload_fields.set(payload_c_name, specialize_prelude_arm_info(ctx, arm_info, arm_name, payload_c_name, scrutinee_ty))
            return
        i += 1


## Replace any `_phantom` placeholder field type in a prelude arm's info with the
## concrete payload field type.  Prelude Option/Result VariantInfo carries a
## `_phantom` placeholder because it is registered generically; the concrete arm
## field types are already computed when the concrete generic variant is emitted
## (`ensure_generic_variant`), keyed by the outer C name embedded in
## `payload_c_name` (`<outer_c>_<arm>`).  We look the field type up there first
## (works even when the scrutinee type has already collapsed to a concrete
## `ty_named` with no args), then fall back to the scrutinee's own type args, then
## to the placeholder (no worse than before).
function specialize_prelude_arm_info(ctx: ref[LowerCtx], arm_info: VariantArmInfo, arm_name: str, payload_c_name: str, scrutinee_ty: types.Type) -> VariantArmInfo:
    var changed = false
    var new_types = vec.Vec[types.Type].create()
    var i: ptr_uint = 0
    while i < arm_info.field_types.len:
        var ft: types.Type
        unsafe:
            ft = read(arm_info.field_types.data + i)
        if is_phantom_type(ft):
            match concrete_prelude_field_type(ctx, payload_c_name, arm_name, scrutinee_ty):
                Option.some as resolved:
                    new_types.push(resolved.value)
                    changed = true
                Option.none:
                    new_types.push(ft)
        else:
            new_types.push(ft)
        i += 1

    if not changed:
        return arm_info

    return VariantArmInfo(name = arm_info.name, field_names = arm_info.field_names, field_types = new_types.as_span())


## Resolve a prelude arm's concrete payload field type.  `payload_c_name` is the
## concrete payload struct C name (`Option_std_string_String_some`); its concrete
## variant decl in `pending_generic_variants` carries the real field type.  Falls
## back to the scrutinee's own type args when the decl is not (yet) recorded.
function concrete_prelude_field_type(ctx: ref[LowerCtx], payload_c_name: str, arm_name: str, scrutinee_ty: types.Type) -> Option[types.Type]:
    # Program-wide registry first: the concrete Option/Result decl may have been
    # emitted in a different module's context (e.g. `Result[String, Error]` from
    # `fs.read_text`), so its arm field type is not in this ctx's
    # `pending_generic_variants`.  The stored type is already qualified — return
    # it as-is (re-qualifying would mis-attribute its concrete C name).
    let shared_ty_ptr = unsafe: read(ctx.prelude_arm_field_types).get(payload_c_name)
    if shared_ty_ptr != null:
        return Option[types.Type].some(value = unsafe: read(shared_ty_ptr))

    match prelude_field_type_from_variants(ctx, payload_c_name, arm_name):
        Option.some as decl_ty:
            return Option[types.Type].some(value = decl_ty.value)
        Option.none:
            pass

    let args = variant_type_args(scrutinee_ty)
    let arg_index = if arm_name == "failure": 1z else: 0z
    if arg_index < args.len:
        unsafe:
            return Option[types.Type].some(value = qualify_type(ctx, read(args.data + arg_index)))
    return Option[types.Type].none


## Look up an arm's single payload field type from the concrete generic variant
## decl recorded in `pending_generic_variants`.  `payload_c_name` is the arm's
## concrete payload struct C name (`<outer_c>_<arm>`), which matches an arm's
## `linkage_name` in the outer decl.
function prelude_field_type_from_variants(ctx: ref[LowerCtx], payload_c_name: str, arm_name: str) -> Option[types.Type]:
    var vi: ptr_uint = 0
    while vi < ctx.pending_generic_variants.len():
        let vp = ctx.pending_generic_variants.get(vi) else:
            break
        unsafe:
            let vdecl = read(vp)
            var ai: ptr_uint = 0
            while ai < vdecl.arms.len:
                let arm = read(vdecl.arms.data + ai)
                if arm.name == arm_name and arm.linkage_name == payload_c_name and arm.fields.len > 0:
                    return Option[types.Type].some(value = read(arm.fields.data + 0).ty)
                ai += 1
        vi += 1
    return Option[types.Type].none


## The concrete type arguments of a variant scrutinee type (`Option[str]` →
## `[str]`), for both generic and imported forms; empty for others.
function variant_type_args(ty: types.Type) -> span[types.Type]:
    match ty:
        types.Type.ty_generic as g:
            return g.args
        types.Type.ty_imported as im:
            return im.args
        _:
            return span[types.Type]()


## True when a type is the prelude arm-payload `_phantom` placeholder `ty_named`.
function is_phantom_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_named as n:
            return n.name == "_phantom"
        _:
            return false


## True when field_ty references the same variant that recv_ty is an arm payload of.
function is_recursive_variant_field(recv_ty: types.Type, field_ty: types.Type) -> bool:
    var recv_c: str
    match recv_ty:
        types.Type.ty_named as rn:
            recv_c = rn.name
        types.Type.ty_imported as ri:
            recv_c = naming.qualified_c_name(ri.module_name, ri.name)
        # A match binding is typed as the arm payload struct directly
        # (`Result.success as p` → `ty_variant_arm_payload`), which already
        # carries the payload's C name.
        types.Type.ty_variant_arm_payload as rap:
            recv_c = rap.c_name
        _:
            return false
    var field_c: str
    match field_ty:
        types.Type.ty_named as nt:
            field_c = naming.qualified_c_name("", nt.name)
        types.Type.ty_imported as fi:
            field_c = naming.qualified_c_name(fi.module_name, fi.name)
        _:
            return false
    # The arm payload C name is "<variant_c>_<arm>" (e.g.
    # "examples_Expr_binary_op").  If the field type's C name is a prefix
    # (e.g. "examples_Expr"), the field references the enclosing variant.
    if recv_c.len > field_c.len and recv_c.starts_with(field_c):
        return true
    # Also check bare names.
    match field_ty:
        types.Type.ty_named as nt2:
            if recv_c.starts_with(nt2.name):
                return true
        types.Type.ty_imported as fi2:
            if recv_c.starts_with(fi2.name):
                return true
        _:
            pass
    return false


## Like is_recursive_variant_field but using a pre-computed arm payload C name.
function is_recursive_variant_field_c(payload_c: str, field_ty: types.Type) -> bool:
    var field_c: str
    match field_ty:
        types.Type.ty_named as nt:
            field_c = naming.qualified_c_name("", nt.name)
        types.Type.ty_imported as fi:
            field_c = naming.qualified_c_name(fi.module_name, fi.name)
        _:
            return false
    return payload_c.len > field_c.len and payload_c.starts_with(field_c)


## C-type name of a variant type.
function variant_c_type_name(ty: types.Type) -> str:
    match ty:
        types.Type.ty_imported:
            # `type_c_key` keeps a concrete generic instance's argument suffix;
            # a bare `qualified_c_name` would drop it.
            return naming.type_c_key(ty)
        types.Type.ty_generic:
            return naming.type_c_key(ty)
        _:
            return ""


## Look up the type of a field in a variant arm by name.
function variant_field_type_from_arm(ctx: ref[LowerCtx], variant_ty: types.Type, arm_name: str, field_name: str) -> Option[types.Type]:
    var variant_c: str
    match variant_ty:
        types.Type.ty_imported:
            # Same key shape as `variant_c_type_name`: a concrete generic
            # instance's arguments are part of its C name.
            variant_c = naming.type_c_key(variant_ty)
        types.Type.ty_generic:
            variant_c = naming.type_c_key(variant_ty)
        _:
            return Option[types.Type].none
    var arm_key = string.String.create()
    arm_key.append(variant_c)
    arm_key.append("_")
    arm_key.append(arm_name)
    var arm_ptr = ctx.arm_payload_fields.get(arm_key.as_str())
    if arm_ptr == null:
        # A *prelude* variant instance constructed before any match registered
        # its arm fields (`Option[ptr_uint].some(value = 0)` in std/str.mt):
        # register them on demand, the same specialization the `?`-propagation
        # path and the match path do (session 43, item 3o).
        match variant_info_for_c_name(ctx, variant_c):
            Option.some as vi:
                register_arm_payload_fields(ctx, arm_key.as_str(), vi.value, arm_name, variant_ty)
                arm_ptr = ctx.arm_payload_fields.get(arm_key.as_str())
            Option.none:
                pass
    let arm_entry = arm_ptr else:
        return Option[types.Type].none
    let arm_info = unsafe: read(arm_entry)
    var fi: ptr_uint = 0
    while fi < arm_info.field_names.len:
        unsafe:
            if read(arm_info.field_names.data + fi) == field_name:
                return Option[types.Type].some(value = read(arm_info.field_types.data + fi))
        fi += 1
    return Option[types.Type].none


## The installed `VariantInfo` a concrete variant C name specializes from: a
## prelude instance (`std_option_Option_ptr_uint`) maps back to its generic
## declaration (`Option`/`Result`); any other name has no registry entry.
function variant_info_for_c_name(ctx: ref[LowerCtx], variant_c: str) -> Option[VariantInfo]:
    if not is_prelude_variant_name(variant_c):
        return Option[VariantInfo].none
    var base_name = ""
    if variant_c.starts_with("std_result_"):
        base_name = "Result"
    else if variant_c.starts_with("std_option_"):
        base_name = "Option"
    if base_name.len == 0:
        return Option[VariantInfo].none
    let vi_ptr = ctx.variants.get(base_name) else:
        return Option[VariantInfo].none
    return Option[VariantInfo].some(value = unsafe: read(vi_ptr))


## Return the arm payload type from a struct name and source module.
function payload_ty(ctx: ref[LowerCtx], struct_name: str, source_module: str) -> types.Type:
    if source_module.len == 0:
        return types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = struct_name)
    return types.Type.ty_imported(module_name = source_module, name = struct_name, args = span[types.Type]())


## The type of 'member' on a variant arm payload binding, looked up from the
## registered arm field info.  Returns none for non-arm-payload receivers.
function arm_payload_field_type(ctx: ref[LowerCtx], recv_ty: types.Type, member: str) -> Option[types.Type]:
    var name: str
    match recv_ty:
        types.Type.ty_named as n:
            name = n.name
        types.Type.ty_variant_arm_payload as ap:
            # The registry is keyed by the payload struct's C name.
            name = ap.c_name
        _:
            return Option[types.Type].none
    let arm_ptr = ctx.arm_payload_fields.get(name)
    if arm_ptr != null:
        let arm_info = unsafe: read(arm_ptr)
        var i: ptr_uint = 0
        while i < arm_info.field_names.len:
            unsafe:
                if read(arm_info.field_names.data + i) == member:
                    return Option[types.Type].some(value = read(arm_info.field_types.data + i))
            i += 1
    # Fallback for prelude Option/Result arm payload structs (e.g.
    # `Result_Option_Msg_int_success`): a plain `match` doesn't register the arm
    # in `arm_payload_fields`, but `ensure_generic_variant` records the single
    # payload field type (which may itself be a nested generic like `Option[Msg]`)
    # in the shared `prelude_arm_field_types` registry keyed by the arm C name.
    if member == "value" or member == "error":
        let shared = unsafe: read(ctx.prelude_arm_field_types).get(name)
        if shared != null:
            return Option[types.Type].some(value = unsafe: read(shared))
    return Option[types.Type].none


## The discriminant constant name for an arm: `<outer_c>_kind_<arm>`.
function variant_kind_const_name(outer_c: str, arm_name: str) -> str:
    var buf = string.String.create()
    buf.append(outer_c)
    buf.append("_kind_")
    buf.append(arm_name)
    return buf.as_str()


## True when a lowered expression is a bare name reference (safe to reuse without
## hoisting, since re-rendering it has no side effects).
function ir_expr_is_name(ep: ptr[ir.Expr]) -> bool:
    unsafe:
        match read(ep):
            ir.Expr.expr_name:
                return true
            _:
                return false


function match_member_name(pattern: ptr[ast.Expr]) -> Option[str]:
    unsafe:
        match read(pattern):
            ast.Expr.expr_member_access as ma:
                return Option[str].some(value = ma.member_name)
            _:
                return Option[str].none


function named_type_name(t: types.Type) -> Option[str]:
    match t:
        types.Type.ty_named as n:
            return Option[str].some(value = n.name)
        types.Type.ty_imported as im:
            return Option[str].some(value = im.name)
        types.Type.ty_generic as g:
            return Option[str].some(value = g.name)
        _:
            return Option[str].none


## Extract the base variant name from a generic variant type (`Option[int]` →
## "Option"), so match on a generic scrutinee can resolve prelude arm names.
function generic_variant_name(t: types.Type) -> Option[str]:
    match t:
        types.Type.ty_generic as g:
            return Option[str].some(value = g.name)
        types.Type.ty_imported as im:
            if is_prelude_variant_name(im.name):
                return Option[str].some(value = im.name)
            return Option[str].none
        types.Type.ty_named as n:
            if is_prelude_variant_name(n.name):
                return Option[str].some(value = n.name)
            return Option[str].none
        _:
            return Option[str].none

function variant_match_allowed(ctx: ref[LowerCtx], name: str) -> bool:
    if ctx.variants.contains(name):
        return true
    match prelude_variant_base(name):
        Option.some:
            return true
        Option.none:
            return false

## Extract the base prelude variant name from a qualified concrete variant name.
## "std_map_Option_std_map_RemovedEntry_ptr_uint_bool" → Some("Option").
## "Option_str" → Some("Option").  Non-prelude names return none.
function prelude_variant_base(name: str) -> Option[str]:
    if name == "Option" or name == "Result":
        return Option[str].some(value = name)
    # The base variant is the *outermost* Option/Result segment.  In a nested
    # concrete name like `std_result_Result_std_option_Option_int` the type
    # argument key mentions Option, but the variant itself is Result.
    var best: ptr_uint = 0
    var found = false
    var base = ""
    match name.find_substring("_Option_"):
        Option.some as idx:
            best = idx.value
            found = true
            base = "Option"
        Option.none:
            pass
    match name.find_substring("_Result_"):
        Option.some as idx:
            if not found or idx.value < best:
                best = idx.value
                found = true
                base = "Result"
        Option.none:
            pass
    if found:
        return Option[str].some(value = base)
    if name.starts_with("Option_"):
        return Option[str].some(value = "Option")
    if name.starts_with("Result_"):
        return Option[str].some(value = "Result")
    return Option[str].none


## True when a type name is a prelude variant (Option/Result), either bare
## or embedded in a qualified concrete name (e.g. "std_map_Option_...").
function is_prelude_variant_name(name: str) -> bool:
    return (
        name == "Option" or name == "Result"
        or name.starts_with("Option_") or name.starts_with("Result_")
        or name.contains_substring("_Option_") or name.contains_substring("_Result_")
    )


## Extract the base variant name from a qualified name like "Option_span_Field" → "Option",
## or "std_option_Option_int" → "Option".  Uses the same detection logic as
## `is_prelude_variant_name` to handle multi-part qualified names.
function variant_base_name(name: str) -> Option[str]:
    return prelude_variant_base(name)


# =============================================================================
#  Type resolution helpers
# =============================================================================

function lookup_fn_sig(ctx: ref[LowerCtx], name: str) -> Option[analyzer.FnSig]:
    let sig_ptr = ctx.analysis.functions.get(name)
    if sig_ptr == null:
        return Option[analyzer.FnSig].none
    unsafe:
        return Option[analyzer.FnSig].some(value = read(sig_ptr))


## Look up a function's FnSig in an imported module's analysis.
function lookup_imported_fn_sig(ctx: ref[LowerCtx], module_name: str, name: str) -> Option[analyzer.FnSig]:
    match find_imported_analysis(ctx, module_name):
        Option.some as imported:
            let sig_ptr = imported.value.functions.get(name)
            if sig_ptr == null:
                return Option[analyzer.FnSig].none
            return Option[analyzer.FnSig].some(value = unsafe: read(sig_ptr))
        Option.none:
            return Option[analyzer.FnSig].none


function fn_sig_param_type(sig: Option[analyzer.FnSig], index: ptr_uint) -> types.Type:
    match sig:
        Option.some as s:
            if index < s.value.params.len:
                unsafe:
                    return read(s.value.params.data + index).ty
            return types.Type.ty_error
        Option.none:
            return types.Type.ty_error


function fn_sig_return_type(sig: Option[analyzer.FnSig]) -> types.Type:
    match sig:
        Option.some as s:
            if s.value.has_return_type:
                return s.value.return_type
            return types.primitive("void")
        Option.none:
            return types.primitive("void")


## A parameter's lowered type: resolved from the AST type ref (so tuple/array/
## span params carry full structure), falling back to the analyzer's signature.
function resolve_param_type(ctx: ref[LowerCtx], sig: Option[analyzer.FnSig], index: ptr_uint, param_type: ast.TypeRef) -> types.Type:
    var local_tref = param_type
    let resolved = resolve_type_ref(ctx, ptr_of(local_tref))
    if not types.is_error(resolved):
        return qualify_type(ctx, resolved)
    return qualify_type(ctx, fn_sig_param_type(sig, index))


## A function's lowered return type: resolved from the AST return type ref (so
## tuple/array/span returns carry full structure), falling back to the signature.
function resolve_return_type(ctx: ref[LowerCtx], sig: Option[analyzer.FnSig], return_type: ptr[ast.TypeRef]?) -> types.Type:
    let annotation = return_type else:
        return qualify_type(ctx, fn_sig_return_type(sig))
    let resolved = resolve_type_ref(ctx, annotation)
    if not types.is_error(resolved):
        return qualify_type(ctx, resolved)
    return qualify_type(ctx, fn_sig_return_type(sig))


## The resolved type of an AST expression, preferring the analyzer's recorded
## type (keyed by node pointer identity).  A recorded `ty_error` is permissive
## — the lowering recovers via `fallback_type`.  An identifier that names a
## local (or a refined module value) takes the *lowering env's* visible type:
## the host's `infer_expression_type` skips its sema-type cache for identifiers
## (`resolve.rb:706`) and reads `lookup_value`, so the analyzer's CFG refinement
## must not leak in where the host's lowering scope has none.
function expr_type(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> types.Type:
    unsafe:
        match read(ep):
            ast.Expr.expr_identifier as id:
                match visible_local_type(ctx, id.name):
                    Option.some as visible:
                        return visible.value
                    Option.none:
                        pass
            _:
                pass
    let key = unsafe: reinterpret[ptr_uint](ep)
    let tp = ctx.analysis.resolved_expr_types.get(key)
    if tp != null:
        let recorded = unsafe: read(tp)
        if not types.is_error(recorded):
            # Inside a generic specialization the analyzer's recorded type may
            # still mention type parameters (e.g. `Vec[T].data` is `ptr[T]`);
            # apply the active substitution so locals and member accesses carry
            # the concrete type.
            return substitute_type_params(ctx, recorded, ref_of(ctx.type_substitution))
    return fallback_type(ctx, ep)


## Resolve `import_alias.TypeName` to `ty_imported` when the member names a
## struct, enum, variant, or type alias in the imported module.
function import_qualified_type(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> Option[types.Type]:
    unsafe:
        match read(ep):
            ast.Expr.expr_member_access as ma:
                match read(ma.receiver):
                    ast.Expr.expr_identifier as id:
                        let mod_ptr = ctx.analysis.imports.get(id.name)
                        if mod_ptr == null:
                            return Option[types.Type].none
                        let target_module = read(mod_ptr)
                        var ai: ptr_uint = 0
                        while ai < ctx.program_analyses.len:
                            var a: analyzer.Analysis = read(ctx.program_analyses.data + ai)
                            if a.module_name == target_module:
                                if a.structs.contains(ma.member_name) or a.type_names.contains(ma.member_name):
                                    # Follow the type alias chain so re-exported types
                                    # (e.g. `type CameraMode = c.CameraMode`) resolve to
                                    # the originating std.c.* module's type.
                                    let opt_alias = resolve_single_imported_type(ctx, target_module, ma.member_name)
                                    match opt_alias:
                                        Option.some as resolved:
                                            return Option[types.Type].some(value = resolved.value)
                                        Option.none:
                                            return Option[types.Type].some(value = types.Type.ty_imported(module_name = target_module, name = ma.member_name, args = span[types.Type]()))
                            ai += 1
                    _:
                        pass
            _:
                pass
    return Option[types.Type].none


## The return type of a cross-module call `alias.func(...)`, resolved from the
## shared `program_returns` table.  Ordinary functions are keyed by their
## module-qualified C name; `std.c.*` external functions are keyed by their bare
## C name (matching `collect_program_returns`).  Returns `ty_error` when the
## receiver is not an import alias or the function is unknown.
function imported_call_return_type(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], func_name: str) -> types.Type:
    unsafe:
        match read(receiver):
            ast.Expr.expr_identifier as id:
                let mod_ptr = ctx.analysis.imports.get(id.name) else:
                    return types.Type.ty_error
                let target_module = read(mod_ptr)
                # External (std.c.*) functions are keyed by bare name; ordinary
                # functions by module-qualified name.  Try the bare name first for
                # std.c.* aliases, then the qualified name.
                if target_module.starts_with("std.c."):
                    let bare_ptr = read(ctx.program_returns).get(func_name)
                    if bare_ptr != null:
                        return read(bare_ptr)
                let linkage = naming.qualified_c_name(target_module, func_name)
                let ret_ptr = read(ctx.program_returns).get(linkage) else:
                    return types.Type.ty_error
                return read(ret_ptr)
            _:
                return types.Type.ty_error


## Like `fallback_type_raw`, but applies the active generic substitution so a
## recovered field/local type (`ptr[T]`) becomes concrete inside a
## specialization.
function fallback_type(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> types.Type:
    return substitute_type_params(ctx, fallback_type_raw(ctx, ep), ref_of(ctx.type_substitution))


function fallback_type_raw(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> types.Type:
    unsafe:
        match read(ep):
            ast.Expr.expr_integer_literal:
                return types.primitive("int")
            ast.Expr.expr_float_literal:
                return types.primitive("float")
            ast.Expr.expr_char_literal:
                return types.primitive("ubyte")
            ast.Expr.expr_bool_literal:
                return ctx.bool_ty
            ast.Expr.expr_identifier as id:
                match visible_local_type(ctx, id.name):
                    Option.some as visible:
                        return visible.value
                    Option.none:
                        pass
                let mvt = module_var_type(ctx, id.name)
                if not types.is_error(mvt):
                    return mvt
                # Function reference: its function type, named after the
                # function and carrying its variadic flag, the way the
                # host's `infer_expression_type` returns the function
                # binding's own type (`Types::Function#name`; the
                # analyzer's `argument_inference_type` refinement does
                # the same for call arguments).
                match lookup_fn_sig(ctx, id.name):
                    Option.some as s:
                        var ret = s.value.return_type
                        if not s.value.has_return_type:
                            ret = ctx.void_ty
                        var param_types = vec.Vec[types.Type].create()
                        var param_names = vec.Vec[str].create()
                        var pi: ptr_uint = 0
                        while pi < s.value.params.len:
                            unsafe:
                                param_types.push(read(s.value.params.data + pi).ty)
                                param_names.push(read(s.value.params.data + pi).name)
                            pi += 1
                        return types.Type.ty_function(name = id.name, params = param_types.as_span(), return_type = types.alloc_type(ret), variadic = s.value.is_variadic, is_proc = false, param_names = param_names.as_span())
                    Option.none:
                        pass
                return types.Type.ty_error
            ast.Expr.expr_binary_op as bin:
                if is_comparison_operator(bin.operator):
                    return ctx.bool_ty
                return fallback_type_raw(ctx, bin.left)
            ast.Expr.expr_unary_op as un:
                return fallback_type_raw(ctx, un.operand)
            ast.Expr.expr_call as call:
                match read(call.callee):
                    ast.Expr.expr_identifier as id:
                        # Builtin address-of / pointer-of: infer the correct
                        # result type from the argument's type instead of
                        # falling to void (#1194).
                        if call.args.len > 0:
                            let inner_kind = id.name
                            let inner_type_name = builtin_addr_type_name(inner_kind)
                            if inner_type_name.len > 0:
                                let inner_ty = fallback_type_raw(ctx, unsafe: read(call.args.data + 0).arg_value)
                                if not types.is_error(inner_ty) and not types.is_void(inner_ty):
                                    return types.Type.ty_generic(name = inner_type_name, args = sp_type(inner_ty))
                        let foreign_ptr = ctx.foreign_map.get(id.name)
                        if foreign_ptr != null:
                            return read(foreign_ptr).return_ty
                        return fn_sig_return_type(lookup_fn_sig(ctx, id.name))
                    ast.Expr.expr_member_access as ma:
                        # Cross-module call `alias.func(...)` (ordinary or external):
                        # the analyzer does not record a resolved type for these, so
                        # recover the callee's return type from the shared
                        # program_returns table (keyed by its C linkage name — the
                        # module-qualified name for ordinary functions, the bare
                        # name for std.c.* external functions).
                        return imported_call_return_type(ctx, ma.receiver, ma.member_name)
                    _:
                        return types.Type.ty_error
            ast.Expr.expr_member_access as ma:
                match import_qualified_type(ctx, ep):
                    Option.some as ty:
                        return ty.value
                    Option.none:
                        pass
                # A field access on a struct value (`rect.height`) resolves to
                # the field's type, not the receiver's type.  Recover the
                # receiver's type and look the field up; fall back to the
                # receiver type only when the field cannot be resolved.
                let recv_fallback = fallback_type_raw(ctx, ma.receiver)
                match concrete_field_type(ctx, recv_fallback, ma.member_name):
                    Option.some as ft:
                        return ft.value
                    Option.none:
                        pass
                match imported_field_type(ctx, recv_fallback, ma.member_name):
                    Option.some as ft:
                        return ft.value
                    Option.none:
                        pass
                return recv_fallback
            ast.Expr.expr_specialization as spec:
                match try_spec_type_name(ep):
                    Option.some as tn:
                        return types.Type.ty_generic(name = tn.value, args = sp_type(types.Type.ty_error))
                    Option.none:
                        return types.Type.ty_error
            # Proc expressions: reconstruct the ty_function(is_proc=true) from the
            # AST so proc_invoke_field_type and callers can compute the correct
            # invoke field type instead of falling to ty_error / void.
            ast.Expr.expr_proc as pr:
                var param_types = vec.Vec[types.Type].create()
                var pi: ptr_uint = 0
                var proc_param_names = vec.Vec[str].create()
                while pi < pr.method_params.len:
                    unsafe:
                        let p = read(pr.method_params.data + pi)
                        param_types.push(resolve_field_type_ref(ctx, p.param_type))
                        proc_param_names.push(p.name)
                    pi += 1
                var ret = ctx.void_ty
                let rt = pr.return_type
                if rt != null:
                    # Full resolution (not scalar-only) so a struct / imported
                    # return type resolves correctly — needed for generic-method
                    # type-param inference (e.g. `map_error[F]`'s F from the proc's
                    # return type).
                    ret = resolve_field_type_ref(ctx, unsafe: read(rt))
                return types.Type.ty_function(name = "", params = param_types.as_span(), return_type = types.alloc_type(ret), variadic = false, is_proc = true, param_names = proc_param_names.as_span())
            _:
                return types.Type.ty_error


function is_comparison_operator(op: str) -> bool:
    return (
        op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
        or op == "and" or op == "or"
    )


## True when a type is exactly `str` (`ty_str`).
function is_str_typed(t: types.Type) -> bool:
    match t:
        types.Type.ty_str:
            return true
        _:
            return false


## True for integer/bitwise arithmetic operators whose result type matches the
## (same-typed) operands.
function is_arithmetic_operator(op: str) -> bool:
    return (
        op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
        or op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>"
    )


## True for the arithmetic operators whose result type is the promoted operand
## type (excludes comparisons, which yield bool, and shifts/bitwise).
function is_pure_arithmetic_operator(op: str) -> bool:
    return op == "+" or op == "-" or op == "*" or op == "/" or op == "%"


## The common type both operands of a balanced binary operator are cast to, or
## none when no balancing applies.  Arithmetic and comparison balance to the
## common numeric type; `%` to the common integer type; shifts, bitwise, and
## logical operators do not balance.  Mirrors Ruby's promoted_binary_operand_type.
function promoted_binary_operand_type(operator: str, left: types.Type, right: types.Type) -> Option[types.Type]:
    if (
        operator == "+" or operator == "-" or operator == "*" or operator == "/"
        or operator == "<" or operator == "<=" or operator == ">" or operator == ">="
        or operator == "==" or operator == "!="
    ):
        # Vector/matrix/quaternion arithmetic: same-type operations pass through;
        # scalar * vector uses the vector type; scalar / vector is unsupported.
        let lp = nominal_type_name(left)
        let rp = nominal_type_name(right)
        if is_vec_math_name(lp) and lp == rp:
            return Option[types.Type].some(value = left)
        if is_vec_math_name(lp) and types.is_numeric(right) and operator == "*":
            return Option[types.Type].some(value = left)
        if is_vec_math_name(rp) and types.is_numeric(left) and operator == "*":
            return Option[types.Type].some(value = right)
        return common_numeric_type(left, right)
    if operator == "%":
        return common_integer_type(left, right)
    return Option[types.Type].none


function is_vec_math_name(name: str) -> bool:
    return (
        name == "vec2" or name == "vec3" or name == "vec4"
        or name == "ivec2" or name == "ivec3" or name == "ivec4"
        or name == "mat3" or name == "mat4" or name == "quat"
    )


function lower_vec_unary_neg(ctx: ref[LowerCtx], operand: ptr[ir.Expr], name: str) -> ptr[ir.Expr]:
    var field_names = vec.Vec[str].create()
    var field_types = vec.Vec[types.Type].create()
    vec_math_fields(name, ref_of(field_names), ref_of(field_types))
    var fields = vec.Vec[ir.AggregateField].create()
    let ty = ir_expr_type(operand)
    var i: ptr_uint = 0
    while i < field_names.len():
        let fname_ptr = field_names.get(i) else:
            fatal(c"lowering: vec unary neg missing field name")
        let ft_ptr = field_types.get(i) else:
            fatal(c"lowering: vec unary neg missing field type")
        let fname = unsafe: read(fname_ptr)
        let field_ty = unsafe: read(ft_ptr)
        let field_access = alloc_expr(ir.Expr.expr_member(receiver = operand, member = fname, ty = field_ty))
        var neg_val: ptr[ir.Expr]
        if is_vec_math_name(nominal_type_name(field_ty)):
            neg_val = lower_vec_unary_neg(ctx, field_access, nominal_type_name(field_ty))
        else:
            neg_val = alloc_expr(ir.Expr.expr_unary(operator = "-", operand = field_access, ty = field_ty))
        fields.push(ir.AggregateField(name = fname, value = neg_val))
        i += 1
    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = ty, fields = fields.as_span()))


## Populate `field_names` and `field_types` for a vector/math type name.
## Mirrors the field set used by `lower_vec_unary_neg` and `lower_vec_binary_op`.
function vec_math_fields(name: str, names: ref[vec.Vec[str]], ftypes: ref[vec.Vec[types.Type]]) -> void:
    if name == "vec2" or name == "ivec2":
        names.push("x")
        names.push("y")
    else if name == "vec3" or name == "ivec3":
        names.push("x")
        names.push("y")
        names.push("z")
    else if name == "vec4" or name == "ivec4" or name == "quat":
        names.push("x")
        names.push("y")
        names.push("z")
        names.push("w")
    else if name == "mat3":
        names.push("col0")
        names.push("col1")
        names.push("col2")
    else if name == "mat4":
        names.push("col0")
        names.push("col1")
        names.push("col2")
        names.push("col3")
    var fi: ptr_uint = 0
    while fi < names.len():
        var ft = types.primitive("float")
        if name.starts_with("ivec"):
            ft = types.primitive("int")
        else if name == "mat3":
            ft = types.primitive("vec3")
        else if name == "mat4":
            ft = types.primitive("vec4")
        ftypes.push(ft)
        fi += 1


## Lower a binary arithmetic operator on vector/matrix/quaternion types to a
## component-wise aggregate literal.  Mirrors Ruby's lower_vector_binary_op /
## lower_aggregate_binary_op.
function lower_vec_binary_op(ctx: ref[LowerCtx], operator: str, left: ptr[ir.Expr], right: ptr[ir.Expr], result_ty: types.Type, name: str) -> ptr[ir.Expr]:
    let left_ty = ir_expr_type(left)
    let right_ty = ir_expr_type(right)
    var field_names = vec.Vec[str].create()
    var field_types = vec.Vec[types.Type].create()
    vec_math_fields(name, ref_of(field_names), ref_of(field_types))
    var fields = vec.Vec[ir.AggregateField].create()
    # An operand is scalar if its type is NOT a known vec/mat/quat type.
    # Using nominal_type_name instead of is_numeric handles float literals that
    # the analyzer may not type correctly in this binary context.
    let left_is_scalar = not is_vec_math_name(nominal_type_name(left_ty))
    let right_is_scalar = not is_vec_math_name(nominal_type_name(right_ty))
    var i: ptr_uint = 0
    while i < field_names.len():
        let fn_ptr = field_names.get(i) else:
            fatal(c"lowering: vec binary missing field name")
        let ft_ptr = field_types.get(i) else:
            fatal(c"lowering: vec binary missing field type")
        let fname = unsafe: read(fn_ptr)
        let ftype = unsafe: read(ft_ptr)
        var left_field: ptr[ir.Expr]
        var right_field: ptr[ir.Expr]
        if left_is_scalar:
            left_field = left
        else:
            left_field = alloc_expr(ir.Expr.expr_member(receiver = left, member = fname, ty = ftype))
        if right_is_scalar:
            right_field = right
        else:
            right_field = alloc_expr(ir.Expr.expr_member(receiver = right, member = fname, ty = ftype))
        # If the field type is itself a vec/mat type (e.g. mat4 column is vec4),
        # recurse to lower the inner operation component-wise.
        var field_val: ptr[ir.Expr]
        let ftype_name = nominal_type_name(ftype)
        if is_vec_math_name(ftype_name):
            field_val = lower_vec_binary_op(ctx, operator, left_field, right_field, ftype, ftype_name)
        else:
            field_val = alloc_expr(ir.Expr.expr_binary(operator = operator, left = left_field, right = right_field, ty = ftype))
        fields.push(ir.AggregateField(name = fname, value = field_val))
        i += 1
    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = result_ty, fields = fields.as_span()))


## True for compound assignment operators (`+=`, `*=`, ...).
function is_compound_assignment_operator(op: str) -> bool:
    return (
        op == "+=" or op == "-=" or op == "*=" or op == "/=" or op == "%="
        or op == "&=" or op == "|=" or op == "^=" or op == "<<=" or op == ">>="
    )


## The binary operator underlying a compound assignment (`+=` -> `+`).
function compound_base_operator(op: str) -> str:
    if op == "+=":
        return "+"
    if op == "-=":
        return "-"
    if op == "*=":
        return "*"
    if op == "/=":
        return "/"
    if op == "%=":
        return "%"
    if op == "&=":
        return "&"
    if op == "|=":
        return "|"
    if op == "^=":
        return "^"
    if op == "<<=":
        return "<<"
    if op == ">>=":
        return ">>"
    return op


function nominal_type_name(t: types.Type) -> str:
    match t:
        types.Type.ty_primitive as p:
            return p.name
        types.Type.ty_named as n:
            return n.name
        types.Type.ty_imported as im:
            return im.name
        _:
            return ""


## True for the numeric aggregate types (simd lanes, vec/mat/quat), whose
## arithmetic result the analyzer records as the aggregate itself.
function is_numeric_aggregate_type(t: types.Type) -> bool:
    if types.is_simd_type(t):
        return true
    return is_vec_math_name(nominal_type_name(t))


## The common numeric type of two operands (mirrors Ruby's common_numeric_type):
## identical types pass through; two integers use common_integer_type; two floats
## use the wider float; a float paired with a fixed-width integer uses the float.
function common_numeric_type(left: types.Type, right: types.Type) -> Option[types.Type]:
    if types.type_equals(left, right):
        return Option[types.Type].some(value = left)
    if not (types.is_numeric(left) and types.is_numeric(right)):
        return Option[types.Type].none
    if types.is_integer_type(left) and types.is_integer_type(right):
        return common_integer_type(left, right)
    if types.is_float_type(left) and types.is_float_type(right):
        return Option[types.Type].some(value = wider_float_type(left, right))
    let float_ty = if types.is_float_type(left): left else: right
    let int_ty = if types.is_float_type(left): right else: left
    if not (types.is_integer_type(int_ty) and types.is_fixed_width_integer_name(prim_name(int_ty))):
        return Option[types.Type].none
    return Option[types.Type].some(value = float_ty)


## The common integer type of two operands (mirrors Ruby's common_integer_type):
## identical types pass through; both must be fixed-width integers.  Same
## signedness takes the wider type; mixed signedness promotes to the narrowest
## signed type that holds both ranges (`uint` vs `int` → `long`), with no answer
## once the unsigned side is 64-bit.  Shared with the semantic conditional
## common-type rule.
function common_integer_type(left: types.Type, right: types.Type) -> Option[types.Type]:
    return sem_exprs.common_integer_type(left, right)


## The wider of two float primitives (mirrors Ruby's wider_float_type).
function wider_float_type(left: types.Type, right: types.Type) -> types.Type:
    if float_width_of(left) >= float_width_of(right):
        return left
    return right


function float_width_of(t: types.Type) -> int:
    if prim_name(t) == "double":
        return 64
    return 32


## The primitive type name of `t`, or the empty string for non-primitives.
function prim_name(t: types.Type) -> str:
    match t:
        types.Type.ty_primitive as p:
            return p.name
        _:
            return ""


## Wrap `ep` in a cast to `target` unless it already has that type (mirrors
## Ruby's cast_expression).  A redundant cast is elided by the C backend.
function cast_to_type(ep: ptr[ir.Expr], target: types.Type) -> ptr[ir.Expr]:
    if types.type_equals(ir_expr_type(ep), target):
        return ep
    return alloc_expr(ir.Expr.expr_cast(target_type = target, expression = ep, ty = target))


## The backing primitive of an enum or flags type, or `t` unchanged for any
## other type.  Mirrors Ruby unwrapping Types::EnumBase to its backing_type so
## enum/flags operands balance (and cast) to their integer backing.
function enum_backing_or_self(ctx: ref[LowerCtx], t: types.Type) -> types.Type:
    match t:
        types.Type.ty_named as n:
            # The builtin event enum has no AST declaration to scan; its backing
            # is the host's `Types::Enum` int (`type_declaration.rb`'s builtin
            # registration).
            if n.name == "EventError" and n.module_name.len == 0:
                return types.primitive("int")
            let owner = if n.module_name.len > 0: n.module_name else: ctx.module_name
            match lookup_enum_backing(ctx, owner, n.name):
                Option.some as b:
                    return b.value
                Option.none:
                    return t
        types.Type.ty_imported as im:
            if im.args.len != 0:
                return t
            match lookup_enum_backing(ctx, im.module_name, im.name):
                Option.some as b:
                    return b.value
                Option.none:
                    return t
        _:
            return t


## The backing primitive type of the enum or flags named `enum_name` in
## `module_name`, or none when no such declaration exists.  Scans the owning
## module's AST declarations (the analyzer keeps no separate backing table).
function lookup_enum_backing(ctx: ref[LowerCtx], module_name: str, enum_name: str) -> Option[types.Type]:
    if module_name == ctx.module_name:
        return scan_enum_backing(ctx.analysis.source_file.declarations, enum_name)
    match find_imported_analysis(ctx, module_name):
        Option.some as a:
            return scan_enum_backing(a.value.source_file.declarations, enum_name)
        Option.none:
            return Option[types.Type].none


## Find an enum/flags declaration named `enum_name` in `decls` and return its
## resolved backing primitive type.
function scan_enum_backing(decls: span[ast.Decl], enum_name: str) -> Option[types.Type]:
    var i: ptr_uint = 0
    while i < decls.len:
        var d: ast.Decl
        unsafe:
            d = read(decls.data + i)
        match d:
            ast.Decl.decl_enum as en:
                if en.name == enum_name:
                    return Option[types.Type].some(value = enum_backing_type(en.backing_type))
            ast.Decl.decl_flags as fl:
                if fl.name == enum_name:
                    return Option[types.Type].some(value = enum_backing_type(fl.backing_type))
            _:
                pass
        i += 1
    return Option[types.Type].none


## Resolve an enum/flags backing-type annotation to a primitive type; the
## default backing is int when the annotation is absent (mirrors lower_enum_decl).
function enum_backing_type(annotation: ptr[ast.TypeRef]?) -> types.Type:
    let a = annotation else:
        return types.primitive("int")
    let resolved = resolve_scalar_type_ref(a)
    if types.is_error(resolved):
        return types.primitive("int")
    return resolved


function is_int_type(t: types.Type) -> bool:
    match t:
        types.Type.ty_primitive as p:
            return p.name == "int"
        _:
            return false


function lookup_local(ctx: ref[LowerCtx], name: str) -> Option[LocalBinding]:
    if ctx.locals.len() == 0:
        return Option[LocalBinding].none
    var i = ctx.locals.len()
    while i > 0:
        i -= 1
        let lb_ptr = ctx.locals.get(i) else:
            break
        unsafe:
            if read(lb_ptr).name == name:
                return Option[LocalBinding].some(value = read(lb_ptr))
    return Option[LocalBinding].none


## The visible (flow-refined) type of `name` in the innermost refinement scope
## that mentions it.  The host's `lookup_value(...)[:type]`; nil when no scope
## narrows the name.
function flow_scope_binding(ctx: ref[LowerCtx], name: str) -> Option[types.Type]:
    var i = ctx.flow_scopes.len()
    while i > 0:
        i -= 1
        let scope_ptr = ctx.flow_scopes.get(i) else:
            break
        unsafe:
            let found = read(scope_ptr).get(name)
            if found != null:
                return Option[types.Type].some(value = read(found))
    return Option[types.Type].none


## The type inference sees for a name — the host's `infer_expression_type`
## identifier arm: the refinement scope's narrowed type, else the local
## binding's storage type, else a module-level value's declared type.
function visible_local_type(ctx: ref[LowerCtx], name: str) -> Option[types.Type]:
    match flow_scope_binding(ctx, name):
        Option.some as narrowed:
            return Option[types.Type].some(value = narrowed.value)
        Option.none:
            pass
    match lookup_local(ctx, name):
        Option.some as lb:
            return Option[types.Type].some(value = lb.value.ty)
        Option.none:
            pass
    let declared = ctx.analysis.value_types.get(name)
    if declared != null:
        return Option[types.Type].some(value = unsafe: read(declared))
    return Option[types.Type].none


## Merge `incoming` into `existing`: a conflicting type deletes the entry (the
## host's `merge_refinements`, `utils.rb:593`).
function merge_flow_refinements(existing: ref[map_mod.Map[str, types.Type]], incoming: ref[map_mod.Map[str, types.Type]]) -> void:
    var entries = incoming.entries()
    while true:
        if not entries.next():
            break
        let entry = entries.current()
        unsafe:
            let key = read(entry.key)
            let new_val = read(entry.value)
            let cur_ptr = existing.get(key)
            if cur_ptr != null:
                if not types.type_equals(read(cur_ptr), new_val):
                    let _removed = existing.remove(key)
            else:
                existing.set(key, new_val)


## Push a refinement map as a new visible scope (skipped when empty); returns
## the stack length `restore_flow_refinements` restores.  The host's
## `env_with_refinements` makes a fresh `FlowScope` layer, so the pushed map is
## a copy rather than the caller's.
function push_flow_refinements(ctx: ref[LowerCtx], refinements: ref[map_mod.Map[str, types.Type]]) -> ptr_uint:
    let saved = ctx.flow_scopes.len()
    if refinements.len() == 0:
        return saved
    var scope = map_mod.Map[str, types.Type].create()
    merge_flow_refinements(ref_of(scope), refinements)
    ctx.flow_scopes.push(scope)
    return saved


function restore_flow_refinements(ctx: ref[LowerCtx], saved: ptr_uint) -> void:
    while ctx.flow_scopes.len() > saved:
        let _dropped = ctx.flow_scopes.pop()


## The lowering's `flow_refinements` (`utils.rb:606`): the binding types a
## condition narrows when it is true (`truthy`) or false.  Only null tests
## narrow; `not` flips, and `and`/`or` recurse with the host's short-circuit
## scopes (the right operand sees the left's refinement).
function lowering_flow_refinements(ctx: ref[LowerCtx], cond: ptr[ast.Expr], truthy: bool) -> map_mod.Map[str, types.Type]:
    var result = map_mod.Map[str, types.Type].create()
    unsafe:
        match read(cond):
            ast.Expr.expr_unary_op as u:
                if u.operator == "not":
                    return lowering_flow_refinements(ctx, u.operand, not truthy)
            ast.Expr.expr_binary_op as b:
                if b.operator == "and":
                    # Only the truthy side refines: `a and b` being false says
                    # nothing about `a`, so the host's `flow_refinements` falls
                    # through to `{}` for the falsy case (`utils.rb:612-618`).
                    if truthy:
                        var left = lowering_flow_refinements(ctx, b.left, true)
                        merge_flow_refinements(ref_of(result), ref_of(left))
                        let saved = push_flow_refinements(ctx, ref_of(left))
                        var right = lowering_flow_refinements(ctx, b.right, true)
                        restore_flow_refinements(ctx, saved)
                        merge_flow_refinements(ref_of(result), ref_of(right))
                    return result
                if b.operator == "or":
                    # Symmetric with `and`: only the falsy side refines.
                    if not truthy:
                        var left_f = lowering_flow_refinements(ctx, b.left, false)
                        merge_flow_refinements(ref_of(result), ref_of(left_f))
                        let saved = push_flow_refinements(ctx, ref_of(left_f))
                        var right = lowering_flow_refinements(ctx, b.right, false)
                        restore_flow_refinements(ctx, saved)
                        merge_flow_refinements(ref_of(result), ref_of(right))
                    return result
                if b.operator == "==" or b.operator == "!=":
                    return lowering_null_test_refinements(ctx, cond, truthy)
            _:
                pass
    return result


## Null-test refinements (`utils.rb:634`): `x == null` truthy (and `!=` falsy)
## narrows to the bare null; the other direction narrows to the nullable's base.
## A local's storage type is its binding; a module-level value's is its declared
## type (the host seeds module bindings into its env).
function lowering_null_test_refinements(ctx: ref[LowerCtx], condp: ptr[ast.Expr], truthy: bool) -> map_mod.Map[str, types.Type]:
    var result = map_mod.Map[str, types.Type].create()
    unsafe:
        match read(condp):
            ast.Expr.expr_binary_op as b:
                if b.operator != "==" and b.operator != "!=":
                    return result
                var name_value: str = ""
                var found = false
                match read(b.left):
                    ast.Expr.expr_identifier as id:
                        if read(b.right) is ast.Expr.expr_null_literal:
                            name_value = id.name
                            found = true
                    _:
                        pass
                if not found:
                    match read(b.right):
                        ast.Expr.expr_identifier as id2:
                            if read(b.left) is ast.Expr.expr_null_literal:
                                name_value = id2.name
                                found = true
                        _:
                            pass
                if not found:
                    return result
                var storage: Option[types.Type] = Option[types.Type].none
                match lookup_local(ctx, name_value):
                    Option.some as lb:
                        storage = Option[types.Type].some(value = lb.value.ty)
                    Option.none:
                        let declared = ctx.analysis.value_types.get(name_value)
                        if declared != null:
                            storage = Option[types.Type].some(value = read(declared))
                match storage:
                    Option.some as st:
                        match st.value:
                            types.Type.ty_nullable as nl:
                                let null_result = if b.operator == "==": truthy else: not truthy
                                if null_result:
                                    result.set(name_value, types.Type.ty_null(target = null))
                                else:
                                    result.set(name_value, read(nl.base))
                            _:
                                pass
                    Option.none:
                        pass
            _:
                pass
    return result


## The host's `cfg_block_always_terminates?` as the lowering applies it
## (`block.rb:707`): the host's termination builder has no break/continue
## targets, so a `break`/`continue` falls through to the block exit and does
## NOT terminate.
function ast_block_always_terminates(body: ptr[ast.Stmt]?) -> bool:
    let b = body else:
        return false
    unsafe:
        match read(ptr[ast.Stmt]<-b):
            ast.Stmt.stmt_block as blk:
                if blk.statements.len == 0:
                    return false
                return ast_stmt_terminates(blk.statements.data + (blk.statements.len - 1))
            _:
                return ast_stmt_terminates(ptr[ast.Stmt]<-b)


function ast_stmt_terminates(sp: ptr[ast.Stmt]) -> bool:
    unsafe:
        match read(sp):
            ast.Stmt.stmt_ret:
                return true
            ast.Stmt.stmt_block as blk:
                if blk.statements.len == 0:
                    return false
                return ast_stmt_terminates(blk.statements.data + (blk.statements.len - 1))
            ast.Stmt.stmt_unsafe as u:
                return ast_block_always_terminates(u.body)
            ast.Stmt.stmt_error_block as eb:
                return ast_stmt_terminates(eb.body)
            ast.Stmt.stmt_if as iff:
                if iff.else_body == null:
                    return false
                if not ast_block_always_terminates(iff.else_body):
                    return false
                var bi: ptr_uint = 0
                while bi < iff.branches.len:
                    if not ast_block_always_terminates(read(iff.branches.data + bi).body):
                        return false
                    bi += 1
                return iff.branches.len > 0
            ast.Stmt.stmt_match as m:
                if m.arms.len == 0:
                    return false
                var ai: ptr_uint = 0
                while ai < m.arms.len:
                    if not ast_block_always_terminates(read(m.arms.data + ai).body):
                        return false
                    ai += 1
                return true
            ast.Stmt.stmt_expression as e:
                return ast_expression_always_aborts(e.expression)
            _:
                return false
    return false


## The host's `fatal_expression?` (`builder.rb:256`): a `fatal(...)` call or a
## literal-false `assert`/`expect` always aborts.
function ast_expression_always_aborts(ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_call as call:
                match read(call.callee):
                    ast.Expr.expr_identifier as id:
                        if id.name == "fatal":
                            return true
                        if call.args.len == 0:
                            return false
                        match read(read(call.args.data + 0).arg_value):
                            ast.Expr.expr_bool_literal as b:
                                return (id.name == "assert" or id.name == "expect") and not b.value
                            _:
                                return false
                    _:
                        return false
            _:
                return false
    return false


function lookup_qualified_constant(ctx: ref[LowerCtx], name: str) -> Option[str]:
    if ctx.analysis.type_names.contains(name) or ctx.analysis.value_types.contains(name):
        return Option[str].some(value = naming.qualified_c_name(ctx.module_name, name))
    var import_values = ctx.analysis.imports.values()
    while true:
        let target_ptr = import_values.next() else:
            break
        let target_module = unsafe: read(target_ptr)
        match find_imported_analysis(ctx, target_module):
            Option.some as imported:
                if imported.value.type_names.contains(name) or imported.value.value_types.contains(name):
                    return Option[str].some(value = naming.qualified_c_name(target_module, name))
            Option.none:
                pass
    return Option[str].none


# =============================================================================
#  C-name mangling (mirrors lowering/utils.rb)
# =============================================================================


# =============================================================================
#  IR allocation
# =============================================================================

function alloc_expr(value: ir.Expr) -> ptr[ir.Expr]:
    var node = heap_mod.must_alloc[ir.Expr](1)
    unsafe:
        read(node) = value
    return node


function alloc_stmt(value: ir.Stmt) -> ptr[ir.Stmt]:
    var node = heap_mod.must_alloc[ir.Stmt](1)
    unsafe:
        read(node) = value
    return node


## Resolve a scalar type annotation (primitive or `str`) to a `types.Type`.
## Returns `ty_error` for compound/nullable/callable/tuple forms (which must
## be resolved by their initializer instead), signalling the caller to fall
## back.  `dyn[...]` resolves to `ty_dyn`.
function resolve_scalar_type_ref(declared: ptr[ast.TypeRef]) -> types.Type:
    unsafe:
        let t = read(declared)
        if t.is_dyn:
            return types.Type.ty_dyn(iface = naming.dyn_iface_declared_name(unsafe: analyzer.qname_to_str(t.dyn_interface)), args = span[types.Type]())
        if t.is_fn or t.is_proc or t.is_tuple or t.nullable:
            return types.Type.ty_error
        if t.arguments.len > 0:
            return types.Type.ty_error
        if t.name.parts.len != 1:
            return types.Type.ty_error
        let name = read(t.name.parts.data + 0)
        if name == "str":
            return types.Type.ty_str
        if is_builtin_type_name(name):
            return types.primitive(name)
        return types.Type.ty_error


function is_builtin_type_name(name: str) -> bool:
    return (
        name == "bool" or name == "byte" or name == "ubyte" or name == "char"
        or name == "short" or name == "ushort" or name == "int" or name == "uint"
        or name == "long" or name == "ulong" or name == "ptr_int" or name == "ptr_uint"
        or name == "float" or name == "double" or name == "void" or name == "cstr"
        or name == "vec2" or name == "vec3" or name == "vec4"
        or name == "ivec2" or name == "ivec3" or name == "ivec4"
        or name == "mat3" or name == "mat4" or name == "quat"
    )


# =============================================================================
#  Format string lowering (f"...")
# =============================================================================

## True when a format string has no interpolations (only literal text parts),
## so it can collapse to a plain string literal with no runtime building.
function format_string_all_static(parts: span[ast.FormatStringPart]) -> bool:
    var i: ptr_uint = 0
    while i < parts.len:
        match unsafe: read(parts.data + i):
            ast.FormatStringPart.fmt_expr:
                return false
            _:
                pass
        i += 1
    return true


## The combined literal text of an all-static format string.
function format_string_static_literal(parts: span[ast.FormatStringPart]) -> ptr[ir.Expr]:
    var buf = string.String.create()
    var i: ptr_uint = 0
    while i < parts.len:
        match unsafe: read(parts.data + i):
            ast.FormatStringPart.fmt_text as t:
                buf.append(t.value)
            _:
                pass
        i += 1
    return alloc_expr(ir.Expr.expr_string_literal(value = buf.as_str(), ty = types.Type.ty_str, cstring = false))


## The append/length plan for a single interpolation, selected from the value's
## type and an optional format spec.  `len_kind`: 0 = call `len_helper(x)`,
## 1 = `x.len` (str), 2 = precision (`mt_format_double_precision_len(x, N)`).
struct FormatPlan:
    append_helper: str
    len_helper: str
    arg_ty: types.Type
    len_kind: int
    precision: int


function fmt_is_signed_int_name(name: str) -> bool:
    return name == "byte" or name == "short" or name == "int" or name == "long" or name == "ptr_int"


function fmt_plan(ctx: ref[LowerCtx], val_ty: types.Type, spec_ptr: ptr[ast.FormatSpec]?) -> FormatPlan:
    let long_ty = types.primitive("long")
    let ulong_ty = types.primitive("ulong")
    let double_ty = types.primitive("double")
    # Resolve the primitive name of the value (str is its own kind).
    var is_str = false
    var prim_name: str = ""
    match val_ty:
        types.Type.ty_str:
            is_str = true
        types.Type.ty_primitive as p:
            prim_name = p.name
        _:
            prim_name = ""
    if spec_ptr != null:
        let spec = unsafe: read(spec_ptr)
        let signed = fmt_is_signed_int_name(prim_name)
        match spec.spec_kind:
            ast.FormatSpecKind.precision:
                return FormatPlan(append_helper = "mt_format_append_double_precision", len_helper = "", arg_ty = double_ty, len_kind = 2, precision = spec.value)
            ast.FormatSpecKind.hex:
                if signed:
                    return FormatPlan(append_helper = if spec.uppercase: "mt_format_append_long_hex_upper" else: "mt_format_append_long_hex", len_helper = "mt_format_long_hex_len", arg_ty = long_ty, len_kind = 0, precision = 0)
                return FormatPlan(append_helper = if spec.uppercase: "mt_format_append_ulong_hex_upper" else: "mt_format_append_ulong_hex", len_helper = "mt_format_ulong_hex_len", arg_ty = ulong_ty, len_kind = 0, precision = 0)
            ast.FormatSpecKind.octal:
                if signed:
                    return FormatPlan(append_helper = "mt_format_append_long_oct", len_helper = "mt_format_long_oct_len", arg_ty = long_ty, len_kind = 0, precision = 0)
                return FormatPlan(append_helper = "mt_format_append_ulong_oct", len_helper = "mt_format_ulong_oct_len", arg_ty = ulong_ty, len_kind = 0, precision = 0)
            ast.FormatSpecKind.binary:
                if signed:
                    return FormatPlan(append_helper = "mt_format_append_long_bin", len_helper = "mt_format_long_bin_len", arg_ty = long_ty, len_kind = 0, precision = 0)
                return FormatPlan(append_helper = "mt_format_append_ulong_bin", len_helper = "mt_format_ulong_bin_len", arg_ty = ulong_ty, len_kind = 0, precision = 0)
    if is_str:
        return FormatPlan(append_helper = "mt_format_append_str", len_helper = "", arg_ty = types.Type.ty_str, len_kind = 1, precision = 0)
    if prim_name == "cstr":
        return FormatPlan(append_helper = "mt_format_append_cstr", len_helper = "mt_format_cstr_len", arg_ty = types.primitive("cstr"), len_kind = 0, precision = 0)
    if prim_name == "bool":
        return FormatPlan(append_helper = "mt_format_append_bool", len_helper = "mt_format_bool_len", arg_ty = ctx.bool_ty, len_kind = 0, precision = 0)
    if prim_name == "float":
        return FormatPlan(append_helper = "mt_format_append_float", len_helper = "mt_format_float_len", arg_ty = types.primitive("float"), len_kind = 0, precision = 0)
    if prim_name == "double":
        return FormatPlan(append_helper = "mt_format_append_double", len_helper = "mt_format_double_len", arg_ty = double_ty, len_kind = 0, precision = 0)
    if prim_name == "ubyte" or prim_name == "ushort" or prim_name == "uint":
        return FormatPlan(append_helper = "mt_format_append_uint", len_helper = "mt_format_uint_len", arg_ty = types.primitive("uint"), len_kind = 0, precision = 0)
    if prim_name == "ptr_uint":
        return FormatPlan(append_helper = "mt_format_append_ptr_uint", len_helper = "mt_format_ptr_uint_len", arg_ty = types.primitive("ptr_uint"), len_kind = 0, precision = 0)
    if prim_name == "long" or prim_name == "ptr_int":
        return FormatPlan(append_helper = "mt_format_append_long", len_helper = "mt_format_long_len", arg_ty = long_ty, len_kind = 0, precision = 0)
    if prim_name == "ulong":
        return FormatPlan(append_helper = "mt_format_append_ulong", len_helper = "mt_format_ulong_len", arg_ty = ulong_ty, len_kind = 0, precision = 0)
    # Custom format hooks: a struct implementing `format_len() -> ptr_uint` and
    # `append_format(output: ref[std.string.String]) -> void` renders through
    # those methods (`len_kind = 3`; the helper fields hold the method C names).
    if spec_ptr == null:
        match resolve_method_info(ctx, val_ty, "format_len"):
            Option.some as lmi:
                match resolve_method_info(ctx, val_ty, "append_format"):
                    Option.some as ami:
                        if lmi.value.method_kind != ast.MethodKind.mk_editable and ami.value.method_kind != ast.MethodKind.mk_editable:
                            return FormatPlan(append_helper = ami.value.c_name, len_helper = lmi.value.c_name, arg_ty = val_ty, len_kind = 3, precision = 0)
                    Option.none:
                        pass
            Option.none:
                pass
    # byte/short/int and any integer-like fallback (e.g. an int-backed enum cast
    # to int in C) format as a signed 32-bit integer.
    return FormatPlan(append_helper = "mt_format_append_int", len_helper = "mt_format_int_len", arg_ty = types.primitive("int"), len_kind = 0, precision = 0)


## The result temp the next dynamic format string in this function gets, and
## its `_cap`/`_off` companions: the host's
## `build_dynamic_format_string_temp_setup` — `__fmt_<dest>` (with a `_2`/`_3`
## suffix for a destination's repeats, via the per-function counter) when the
## most recent local declaration in scope names one, else
## `fresh_c_temp_name(ctx, "fmt_str")` (`__mt_fmt_str_N`).
function format_string_result_base(ctx: ref[LowerCtx]) -> str:
    if ctx.fmt_dest_name.len > 0:
        # The env creates its counter slot at the first use (the host's
        # `env[:fmt_counter] ||= {}`).
        if not ctx.fmt_counter_visible:
            ctx.fmt_counter.clear()
            ctx.fmt_counter_visible = true
        var n: ptr_uint = 1
        let n_ptr = ctx.fmt_counter.get(ctx.fmt_dest_name)
        if n_ptr != null:
            n = unsafe: read(n_ptr) + 1
        ctx.fmt_counter.set(ctx.fmt_dest_name, n)
        var buf = string.String.create()
        buf.append("__fmt_")
        buf.append(ctx.fmt_dest_name)
        if n > 1:
            buf.append("_")
            fmt.append_ptr_uint(ref_of(buf), n)
        return buf.as_str()
    return fresh_c_temp_name(ctx, "fmt_str")


## The post-statement release of a dynamic format string's result (the host's
## `mt_format_str_release` cleanup; emitted with nil line/path like the other
## hoisted statements).
function format_str_release_stmt(temp: ptr[ir.Expr]) -> ir.Stmt:
    return ir.Stmt.stmt_expression(
        expression = alloc_expr(ir.Expr.expr_call(callee = "mt_format_str_release", arguments = single_expr_span(temp), ty = types.primitive("void"))),
        line = 0, source_path = "",
    )


## True when `stmt` is an `mt_format_str_release(...)` statement.
function is_format_release_stmt(stmt: ir.Stmt) -> bool:
    match stmt:
        ir.Stmt.stmt_expression as es:
            match unsafe: read(es.expression):
                ir.Expr.expr_call as c:
                    return c.callee == "mt_format_str_release"
                _:
                    pass
        _:
            pass
    return false


## Drop a window's format-string releases — the host's
## `reject_format_releases_for_assignment`: a dynamic format string stored into
## a `str`/`cstr` binding (or a struct containing one) transfers ownership of
## its buffer, so its temp must not be released after the statement.
function drop_format_release_cleanups(collected: HoistSaved) -> HoistSaved:
    var kept = vec.Vec[ir.Stmt].create()
    var i: ptr_uint = 0
    while i < collected.cleanups.len:
        let st = collected.cleanups.get(i) else:
            break
        if not is_format_release_stmt(unsafe: read(st)):
            kept.push(unsafe: read(st))
        i += 1
    var result = collected
    result.cleanups = kept
    return result


## True for a type that owns a dynamic format string's buffer when assigned to —
## the host's `cstr_trackable_type?`/`struct_contains_string_field?`: `str`,
## `cstr`, or a struct whose fields (recursively) contain one.
function format_owning_target_type(ctx: ref[LowerCtx], ty: types.Type, depth: ptr_uint) -> bool:
    if depth > 8:
        return false
    match ty:
        types.Type.ty_str:
            return true
        types.Type.ty_primitive as p:
            return p.name == "cstr"
        types.Type.ty_named:
            pass
        types.Type.ty_imported:
            pass
        _:
            return false
    let fields = struct_fields_of(ctx, ty) else:
        return false
    var fi: ptr_uint = 0
    while fi < fields.len:
        if format_owning_target_type(ctx, unsafe: read(fields.data + fi).ty, depth + 1):
            return true
        fi += 1
    return false


## True when a local's value is backed by a C-string buffer that outlives the
## enclosing statement — the host's `cstr_backed_storage_value?`: a `cstr`
## local, or a `str` local whose value is a cstr-typed expression, a string
## literal, a dynamic format string, or another cstr-backed local.
function cstr_backed_binding(ctx: ref[LowerCtx], ty: types.Type, init: ptr[ast.Expr]?, value_expr: ptr[ir.Expr]) -> bool:
    match ty:
        types.Type.ty_primitive as p:
            if p.name == "cstr":
                return true
        types.Type.ty_str:
            # The lowered value is a `cstr`-typed expression, another
            # cstr-backed local's read, or a dynamic format string's result temp
            # (registered when the format was built) — the host's
            # prepared-identifier check.
            match ir_expr_type(value_expr):
                types.Type.ty_primitive as vp:
                    if vp.name == "cstr":
                        return true
                _:
                    pass
            if is_cstr_backed_lowered(ctx, value_expr):
                return true
            let ip = init else:
                return false
            return ast_expr_cstr_backed(ctx, ip)
        _:
            return false
    return false


## The host's `cstr_backed_expression?`: a *syntactic* predicate — a string
## literal, a `cstr`-typed or cstr-backed local's read, or an `if`/`unsafe`
## whose parts are all cstr-backed (`let t = if flag: "a" else: "b"` is
## cstr-backed, so `draw_text(t, …)` passes `t.data` directly).
function ast_expr_cstr_backed(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_string_literal:
                return true
            ast.Expr.expr_identifier as id:
                match lookup_local(ctx, id.name):
                    Option.some as lb:
                        match lb.value.ty:
                            types.Type.ty_primitive as p:
                                if p.name == "cstr":
                                    return true
                            _:
                                pass
                        return ctx.cstr_backed_names.contains(lb.value.c_name)
                    Option.none:
                        # A module constant whose compile-time value is a string
                        # literal is cstr-backed (the host's
                        # `binding.const_value.is_a?(String)`).
                        match try_evaluate_const_expr(ctx, ep):
                            Option.some as cv:
                                match cv.value:
                                    ConstValue.cv_str:
                                        return true
                                    _:
                                        return false
                            Option.none:
                                return false
            ast.Expr.expr_if as iff:
                return ast_expr_cstr_backed(ctx, iff.then_expr) and ast_expr_cstr_backed(ctx, iff.else_expr)
            ast.Expr.expr_unsafe as u:
                return ast_expr_cstr_backed(ctx, u.expression)
            _:
                return false


## True when a lowered value is a cstr-backed local's read (or a format-string
## temp), so a `str as cstr` foreign boundary can pass its `data` pointer
## directly — the host's `cstr_backed_expression?` on the prepared identifier.
function is_cstr_backed_lowered(ctx: ref[LowerCtx], ep: ptr[ir.Expr]) -> bool:
    unsafe:
        match read(ep):
            ir.Expr.expr_name as n:
                return ctx.cstr_backed_names.contains(n.name)
            _:
                return false


## The host's `update_cstr_metadata_for_assignment!`: an assignment to a `str`
## local refreshes whether its storage is still cstr-backed.  `= <cstr-backed
## value>` keeps it; every other assignment and every compound assignment
## clears it (`skybox_file_name = dropped_path` turns a literal-backed local
## into a plain `str`, so a later `str as cstr` boundary must copy it).
function update_cstr_metadata_for_assignment_mt(ctx: ref[LowerCtx], target: ptr[ast.Expr], value_ast: ptr[ast.Expr], value_ir: ptr[ir.Expr], operator: str) -> void:
    unsafe:
        match read(target):
            ast.Expr.expr_identifier as id:
                match lookup_local(ctx, id.name):
                    Option.some as lb:
                        var backed = false
                        if operator == "=":
                            match lb.value.ty:
                                types.Type.ty_primitive as p:
                                    if p.name == "cstr":
                                        backed = true
                                types.Type.ty_str:
                                    backed = is_cstr_backed_lowered(ctx, value_ir) or ast_expr_cstr_backed(ctx, value_ast)
                                _:
                                    pass
                        if backed:
                            ctx.cstr_backed_names.set(lb.value.c_name, true)
                        else:
                            let _removed = ctx.cstr_backed_names.remove(lb.value.c_name)
                    Option.none:
                        pass
            _:
                pass


## Build a dynamic format string: the host's
## `build_dynamic_format_string_temp_setup` — the interpolation temps first (in
## part order, their nested setups included), then the capacity local (seeded
## with the static text length), the per-interpolation length accumulations
## (`cap = cap + len(...)`), the result local (`mt_format_str_make`) and the
## write offset, then the append statements.  Returns the result temp's
## identifier; the caller hoists `output` and owns the release.
function build_format_string_dynamic(ctx: ref[LowerCtx], parts: span[ast.FormatStringPart], output: ref[vec.Vec[ir.Stmt]]) -> ptr[ir.Expr]:
    let str_ty = types.Type.ty_str
    let ptr_uint_ty = types.primitive("ptr_uint")
    let base = format_string_result_base(ctx)
    let cap_name = j2(base, "_cap")
    let off_name = j2(base, "_off")
    let result_c = base

    # Pass 1: lower each interpolation into a typed temp.
    var static_len: ptr_uint = 0
    var temps = vec.Vec[str].create()
    var plans = vec.Vec[FormatPlan].create()
    var expected_lengths = vec.Vec[str].create()
    var pi: ptr_uint = 0
    while pi < parts.len:
        match unsafe: read(parts.data + pi):
            ast.FormatStringPart.fmt_text as t:
                static_len += t.value.len
            ast.FormatStringPart.fmt_expr as ex:
                let lowered = lower_expr(ctx, ex.expression)
                let val_ty = ir_expr_type(lowered)
                let plan = fmt_plan(ctx, val_ty, ex.format_spec)
                let temp_c = fresh_c_temp_name(ctx, "fmt_part")
                var temp_ty: types.Type = plan.arg_ty
                var temp_val: ptr[ir.Expr] = lowered
                if plan.len_kind == 1:
                    temp_ty = str_ty
                else if plan.len_kind == 3:
                    pass
                else if not types.type_equals(ir_expr_type(lowered), plan.arg_ty):
                    # The host's `cast_expression`: a cast is emitted only when
                    # the lowered value's type differs from the append
                    # argument's.
                    temp_val = alloc_expr(ir.Expr.expr_cast(target_type = plan.arg_ty, expression = lowered, ty = plan.arg_ty))
                output.push(ir.Stmt.stmt_local(name = temp_c, linkage_name = temp_c, ty = temp_ty, value = temp_val, line = 0, source_path = ""))
                temps.push(temp_c)
                plans.push(plan)
                if plan.len_kind == 3:
                    # The host's custom part computes its expected length into
                    # `__mt_fmt_part_len_N` at the temp, before the capacity
                    # accumulation.
                    let len_c = fresh_c_temp_name(ctx, "fmt_part_len")
                    let temp_ref = alloc_expr(ir.Expr.expr_name(name = temp_c, ty = temp_ty, pointer = Option[bool].some(value = false)))
                    var hook_args = vec.Vec[ir.Expr].create()
                    unsafe:
                        hook_args.push(read(temp_ref))
                    output.push(ir.Stmt.stmt_local(
                        name = len_c,
                        linkage_name = len_c,
                        ty = ptr_uint_ty,
                        value = alloc_expr(ir.Expr.expr_call(callee = plan.len_helper, arguments = hook_args.as_span(), ty = ptr_uint_ty)),
                        line = 0,
                        source_path = "",
                    ))
                    expected_lengths.push(len_c)
                else:
                    expected_lengths.push("")
            _:
                pass
        pi += 1

    # The capacity local (the static text's length), then one accumulation per
    # interpolation (the host writes `cap = cap + len(...)`).
    output.push(ir.Stmt.stmt_local(name = cap_name, linkage_name = cap_name, ty = ptr_uint_ty, value = alloc_expr(ir.Expr.expr_integer_literal(value = long<-static_len, ty = ptr_uint_ty)), line = 0, source_path = ""))
    var ai: ptr_uint = 0
    while ai < temps.len():
        let temp_c = temps.get(ai) else:
            fatal(c"format string: missing interpolation temp")
        let plan = plans.get(ai) else:
            fatal(c"format string: missing interpolation plan")
        var temp_ty: types.Type = unsafe: read(plan).arg_ty
        if unsafe: read(plan).len_kind == 1:
            temp_ty = str_ty
        let temp_ref = alloc_expr(ir.Expr.expr_name(name = unsafe: read(temp_c), ty = temp_ty, pointer = Option[bool].some(value = false)))
        var len_expr = fmt_len_expr(unsafe: read(plan), temp_ref, ptr_uint_ty)
        if unsafe: read(plan).len_kind == 3:
            let len_name_ptr = expected_lengths.get(ai) else:
                fatal(c"format string: missing custom length")
            len_expr = alloc_expr(ir.Expr.expr_name(name = unsafe: read(len_name_ptr), ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
        let cap_ref = alloc_expr(ir.Expr.expr_name(name = cap_name, ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
        output.push(ir.Stmt.stmt_assignment(
            target = alloc_expr(ir.Expr.expr_name(name = cap_name, ty = ptr_uint_ty, pointer = Option[bool].some(value = false))),
            operator = "=",
            value = alloc_expr(ir.Expr.expr_binary(operator = "+", left = cap_ref, right = len_expr, ty = ptr_uint_ty)),
        ))
        ai += 1

    # Allocate the result buffer and reset the write offset.
    var make_args = vec.Vec[ir.Expr].create()
    unsafe:
        make_args.push(read(alloc_expr(ir.Expr.expr_name(name = cap_name, ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))))
    output.push(ir.Stmt.stmt_local(name = result_c, linkage_name = result_c, ty = str_ty, value = alloc_expr(ir.Expr.expr_call(callee = "mt_format_str_make", arguments = make_args.as_span(), ty = str_ty)), line = 0, source_path = ""))
    output.push(ir.Stmt.stmt_local(name = off_name, linkage_name = off_name, ty = ptr_uint_ty, value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty)), line = 0, source_path = ""))

    # Pass 2: append each part in order.
    var expr_index: ptr_uint = 0
    pi = 0
    while pi < parts.len:
        match unsafe: read(parts.data + pi):
            ast.FormatStringPart.fmt_text as t:
                var append_args = vec.Vec[ir.Expr].create()
                unsafe:
                    append_args.push(read(alloc_expr(ir.Expr.expr_name(name = result_c, ty = str_ty, pointer = Option[bool].some(value = false)))))
                    append_args.push(read(alloc_expr(ir.Expr.expr_name(name = off_name, ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))))
                    append_args.push(read(alloc_expr(ir.Expr.expr_string_literal(value = t.value, ty = str_ty, cstring = false))))
                output.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_name(name = off_name, ty = ptr_uint_ty, pointer = Option[bool].some(value = false))), operator = "=", value = alloc_expr(ir.Expr.expr_call(callee = "mt_format_append_str", arguments = append_args.as_span(), ty = ptr_uint_ty))))
            ast.FormatStringPart.fmt_expr:
                let temp_ptr = temps.get(expr_index) else:
                    fatal(c"format string: missing interpolation temp")
                let plan_ptr = plans.get(expr_index) else:
                    fatal(c"format string: missing interpolation plan")
                let temp_c = unsafe: read(temp_ptr)
                let plan = unsafe: read(plan_ptr)
                expr_index += 1
                var temp_ty: types.Type = plan.arg_ty
                if plan.len_kind == 1:
                    temp_ty = str_ty
                if plan.len_kind == 3:
                    # Custom hook: the host's slice form — a `String` view over
                    # the result at `offset`, the hook call, the expected-length
                    # check, the offset advance and the NUL terminator.
                    let len_name_ptr = expected_lengths.get(expr_index - 1) else:
                        fatal(c"format string: missing custom length")
                    let part = FormatSinkPart(kind = 3, text = "", temp = temp_c, plan = plan, expected_length = unsafe: read(len_name_ptr))
                    let result_ref = alloc_expr(ir.Expr.expr_name(name = result_c, ty = str_ty, pointer = Option[bool].some(value = false)))
                    format_sink_buffer_part_stmts(ctx, output, part, result_ref, off_name)
                    pi += 1
                    continue
                var append_args = vec.Vec[ir.Expr].create()
                unsafe:
                    append_args.push(read(alloc_expr(ir.Expr.expr_name(name = result_c, ty = str_ty, pointer = Option[bool].some(value = false)))))
                    append_args.push(read(alloc_expr(ir.Expr.expr_name(name = off_name, ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))))
                    append_args.push(read(alloc_expr(ir.Expr.expr_name(name = temp_c, ty = temp_ty, pointer = Option[bool].some(value = false)))))
                    if plan.len_kind == 2:
                        append_args.push(read(alloc_expr(ir.Expr.expr_integer_literal(value = long<-(plan.precision), ty = types.primitive("int")))))
                output.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_name(name = off_name, ty = ptr_uint_ty, pointer = Option[bool].some(value = false))), operator = "=", value = alloc_expr(ir.Expr.expr_call(callee = plan.append_helper, arguments = append_args.as_span(), ty = ptr_uint_ty))))
        pi += 1

    return alloc_expr(ir.Expr.expr_name(name = result_c, ty = str_ty, pointer = Option[bool].some(value = false)))


## The length expression for one interpolation temp, per its plan's `len_kind`.
function fmt_len_expr(plan: FormatPlan, temp_ref: ptr[ir.Expr], ptr_uint_ty: types.Type) -> ptr[ir.Expr]:
    if plan.len_kind == 1:
        return alloc_expr(ir.Expr.expr_member(receiver = temp_ref, member = "len", ty = ptr_uint_ty))
    if plan.len_kind == 3:
        # Custom hook: `<Type>.format_len(value)` (by-value receiver).
        var hook_args = vec.Vec[ir.Expr].create()
        unsafe:
            hook_args.push(read(temp_ref))
        return alloc_expr(ir.Expr.expr_call(callee = plan.len_helper, arguments = hook_args.as_span(), ty = ptr_uint_ty))
    var args = vec.Vec[ir.Expr].create()
    unsafe:
        args.push(read(temp_ref))
    if plan.len_kind == 2:
        unsafe:
            args.push(read(alloc_expr(ir.Expr.expr_integer_literal(value = long<-(plan.precision), ty = types.primitive("int")))))
        return alloc_expr(ir.Expr.expr_call(callee = "mt_format_double_precision_len", arguments = args.as_span(), ty = ptr_uint_ty))
    return alloc_expr(ir.Expr.expr_call(callee = plan.len_helper, arguments = args.as_span(), ty = ptr_uint_ty))


# =============================================================================
#  Explicit format sinks (`String`/`str_buffer` append_format/assign_format)
#
#  The host streams a statement-form format string into its destination instead
#  of building a `str` and copying it (`lower_explicit_format_sink_expression_
#  statement`, lowering/expressions.rb:488).  Three forms are recognised:
#    - `std.fmt.append_format(ref, f"...")` / `assign_format`
#    - `String.append_format(f"...")` / `assign_format`
#    - `str_buffer[N].append_format(f"...")` / `assign_format`
#  The dynamic form emits the parts' temps, copies `str`/`cstr` arguments whose
#  buffer the sink may overwrite, then the destination-specific stream:
#  `std_string_String_append`/`std_fmt_append_*` for a String, or a single
#  `__mt_fmt_sink_offset_N` through a `str` view for a str_buffer.
# =============================================================================


## True when `t` is `std.string.String` (or a ref/pointer to it).
function is_std_string_type(t: types.Type) -> bool:
    var effective = t
    if types.is_ref_type(effective) or types.is_raw_pointer(effective):
        effective = types.pointer_element(effective)
    match effective:
        types.Type.ty_named as n:
            return n.name == "String" and n.module_name == "std.string"
        types.Type.ty_imported as im:
            return im.name == "String" and im.module_name == "std.string"
        _:
            return false


## A `String` sink method: the receiver may be a nominal `String` whose module
## name the analyzer did not qualify, so also accept the resolved method's
## `std_string_String_*` linkage (a user struct named `String` resolves to its
## own module prefix and is not treated as a sink).
function is_std_string_sink_method(ctx: ref[LowerCtx], receiver_ty: types.Type, method_name: str) -> bool:
    if is_std_string_type(receiver_ty):
        return true
    match resolve_method_info(ctx, receiver_ty, method_name):
        Option.some as mi:
            return mi.value.c_name.starts_with("std_string_String_")
        Option.none:
            return false


## The `data` member's type: the host's `str_buffer_storage_capacity` is `N + 1`.
function str_buffer_data_member_type(cap: long) -> types.Type:
    return types.Type.ty_generic(name = "array", args = sp_type2(types.primitive("char"), types.literal_int(cap + 1)))


struct FormatSinkInfo:
    is_assign: bool
    is_buffer: bool
    sink_ep: ptr[ast.Expr]
    format_parts: span[ast.FormatStringPart]
    ## `String.append_format` passes its receiver through the editable-method
    ## borrow; `std.fmt.append_format` uses the declared `ref[String]` parameter.
    method_form: bool


variant FormatSinkTarget:
    fst_string(value: ptr[ir.Expr])
    fst_buffer(
        receiver: ptr[ir.Expr],
        data_pointer: ptr[ir.Expr],
        len_pointer: ptr[ir.Expr],
        dirty_pointer: ptr[ir.Expr],
        capacity: ptr[ir.Expr],
    )


struct FormatSinkPart:
    kind: int  # 0 text, 1 expression, 2 precision, 3 custom hook
    text: str
    temp: str
    plan: FormatPlan
    expected_length: str


## Recognise a statement-form explicit format sink (host
## `explicit_format_sink_call_info`).
function explicit_format_sink_info(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> Option[FormatSinkInfo]:
    unsafe:
        match read(ep):
            ast.Expr.expr_call as call:
                match read(call.callee):
                    ast.Expr.expr_member_access as ma:
                        # `std.fmt.append_format(ref, f"...")` / `assign_format`.
                        if call.args.len == 2:
                            match read(ma.receiver):
                                ast.Expr.expr_identifier as id:
                                    let imp = ctx.analysis.imports.get(id.name)
                                    if imp != null and read(imp) == "std.fmt":
                                        if ma.member_name == "append_format" or ma.member_name == "assign_format":
                                            let fmt_arg = read(call.args.data + 1).arg_value
                                            match read(fmt_arg):
                                                ast.Expr.expr_format_string as fs:
                                                    return Option[FormatSinkInfo].some(value = FormatSinkInfo(
                                                        is_assign = ma.member_name == "assign_format",
                                                        is_buffer = false,
                                                        sink_ep = read(call.args.data + 0).arg_value,
                                                        format_parts = fs.parts,
                                                        method_form = false,
                                                    ))
                                                _:
                                                    pass
                                _:
                                    pass
                        # `String.append_format(f"...")` / `str_buffer[N].…`.
                        # Only the `*_format` methods are sinks; `.assign` and
                        # `.append` take a `str` and keep the ordinary path.
                        if call.args.len == 1 and (ma.member_name == "append_format" or ma.member_name == "assign_format"):
                            let fmt_arg = read(call.args.data + 0).arg_value
                            match read(fmt_arg):
                                ast.Expr.expr_format_string as fs:
                                    let recv_ty = method_receiver_type(ctx, ma.receiver)
                                    if is_str_buffer_type(recv_ty):
                                        return Option[FormatSinkInfo].some(value = FormatSinkInfo(
                                            is_assign = ma.member_name == "assign_format",
                                            is_buffer = true,
                                            sink_ep = ma.receiver,
                                            format_parts = fs.parts,
                                            method_form = false,
                                        ))
                                    if is_std_string_sink_method(ctx, recv_ty, ma.member_name):
                                        return Option[FormatSinkInfo].some(value = FormatSinkInfo(
                                            is_assign = ma.member_name == "assign_format",
                                            is_buffer = false,
                                            sink_ep = ma.receiver,
                                            format_parts = fs.parts,
                                            method_form = true,
                                        ))
                                _:
                                    pass
                    _:
                        pass
            _:
                pass
    return Option[FormatSinkInfo].none


## Lower the sink destination (host `explicit_format_sink_target`).
function lower_format_sink_target(ctx: ref[LowerCtx], info: FormatSinkInfo) -> FormatSinkTarget:
    let char_ty = types.primitive("char")
    let ptr_uint_ty = types.primitive("ptr_uint")
    let bool_ty = ctx.bool_ty
    let char_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(char_ty))
    let len_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(ptr_uint_ty))
    let dirty_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(bool_ty))
    if info.is_buffer:
        let recv = lower_expr(ctx, info.sink_ep)
        let recv_ty = ir_expr_type(recv)
        let cap = str_buffer_capacity_of(recv_ty)
        let data_member = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "data", ty = str_buffer_data_member_type(cap)))
        let data_elem = alloc_expr(ir.Expr.expr_index(
            receiver = data_member,
            index = alloc_expr(ir.Expr.expr_integer_literal(value = 0z, ty = ptr_uint_ty)),
            ty = char_ty,
        ))
        let data_addr = alloc_expr(ir.Expr.expr_address_of(expression = data_elem, ty = char_ptr_ty))
        let len_addr = alloc_expr(ir.Expr.expr_address_of(
            expression = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "len", ty = ptr_uint_ty)),
            ty = len_ptr_ty,
        ))
        let dirty_addr = alloc_expr(ir.Expr.expr_address_of(
            expression = alloc_expr(ir.Expr.expr_member(receiver = recv, member = "dirty", ty = bool_ty)),
            ty = dirty_ptr_ty,
        ))
        return FormatSinkTarget.fst_buffer(
            receiver = recv,
            data_pointer = data_addr,
            len_pointer = len_addr,
            dirty_pointer = dirty_addr,
            capacity = alloc_expr(ir.Expr.expr_integer_literal(value = cap, ty = ptr_uint_ty)),
        )
    let recv = lower_expr(ctx, info.sink_ep)
    var sink_value = recv
    if info.method_form:
        match build_receiver_arg(ctx, recv, ast.MethodKind.mk_editable, false):
            Option.some as arg:
                sink_value = arg.value
            Option.none:
                pass
    else:
        let fn_name = if info.is_assign: "assign_format" else: "append_format"
        sink_value = coerce_arg_to_ref_param(lookup_imported_fn_sig(ctx, "std.fmt", fn_name), 0, recv)
    return FormatSinkTarget.fst_string(value = sink_value)


## Lower every format part into a typed temp (the host's pass 1 in
## `build_dynamic_format_string_parts`).  Text parts carry their literal; an
## interpolation gets a `__mt_fmt_part_N` temp and a `FormatPlan`.  A custom
## hook also gets the host's `__mt_fmt_part_len_N` expected-length local.
function build_format_sink_parts(
    ctx: ref[LowerCtx],
    parts: span[ast.FormatStringPart],
    setup: ref[vec.Vec[ir.Stmt]],
) -> vec.Vec[FormatSinkPart]:
    var result_parts = vec.Vec[FormatSinkPart].create()
    let str_ty = types.Type.ty_str
    let ptr_uint_ty = types.primitive("ptr_uint")
    var pi: ptr_uint = 0
    while pi < parts.len:
        match unsafe: read(parts.data + pi):
            ast.FormatStringPart.fmt_text as t:
                if t.value.len > 0:
                    result_parts.push(FormatSinkPart(
                        kind = 0,
                        text = t.value,
                        temp = "",
                        plan = FormatPlan(append_helper = "", len_helper = "", arg_ty = types.Type.ty_error, len_kind = 0, precision = 0),
                        expected_length = "",
                    ))
            ast.FormatStringPart.fmt_expr as ex:
                let lowered = lower_expr(ctx, ex.expression)
                let val_ty = ir_expr_type(lowered)
                let plan = fmt_plan(ctx, val_ty, ex.format_spec)
                let temp_c = fresh_c_temp_name(ctx, "fmt_part")
                var temp_ty = plan.arg_ty
                var temp_val = lowered
                if plan.len_kind == 1:
                    temp_ty = str_ty
                else if plan.len_kind == 3:
                    pass
                else if not types.type_equals(ir_expr_type(lowered), plan.arg_ty):
                    temp_val = alloc_expr(ir.Expr.expr_cast(target_type = plan.arg_ty, expression = lowered, ty = plan.arg_ty))
                setup.push(ir.Stmt.stmt_local(name = temp_c, linkage_name = temp_c, ty = temp_ty, value = temp_val, line = 0, source_path = ""))
                var kind = 1
                if plan.len_kind == 2:
                    kind = 2
                else if plan.len_kind == 3:
                    kind = 3
                var expected_length = ""
                if plan.len_kind == 3:
                    let len_c = fresh_c_temp_name(ctx, "fmt_part_len")
                    let temp_ref = alloc_expr(ir.Expr.expr_name(name = temp_c, ty = temp_ty, pointer = Option[bool].some(value = false)))
                    var hook_args = vec.Vec[ir.Expr].create()
                    unsafe:
                        hook_args.push(read(temp_ref))
                    setup.push(ir.Stmt.stmt_local(
                        name = len_c,
                        linkage_name = len_c,
                        ty = ptr_uint_ty,
                        value = alloc_expr(ir.Expr.expr_call(callee = plan.len_helper, arguments = hook_args.as_span(), ty = ptr_uint_ty)),
                        line = 0,
                        source_path = "",
                    ))
                    expected_length = len_c
                result_parts.push(FormatSinkPart(kind = kind, text = "", temp = temp_c, plan = plan, expected_length = expected_length))
        pi += 1
    return result_parts


## Copy the parts whose buffer the sink may overwrite: a `str` argument for any
## sink, a `cstr` argument for a `str_buffer` sink (the host's
## `copy_explicit_format_sink_str_parts`).  Returns the rewritten parts.
function copy_format_sink_parts(
    ctx: ref[LowerCtx],
    parts: vec.Vec[FormatSinkPart],
    is_buffer: bool,
    setup: ref[vec.Vec[ir.Stmt]],
    cleanups: ref[vec.Vec[ir.Stmt]],
) -> vec.Vec[FormatSinkPart]:
    var copied = vec.Vec[FormatSinkPart].create()
    let str_ty = types.Type.ty_str
    let ptr_uint_ty = types.primitive("ptr_uint")
    let void_ty = types.primitive("void")
    var i: ptr_uint = 0
    while i < parts.len:
        let part_ptr = parts.get(i) else:
            break
        var part = unsafe: read(part_ptr)
        let is_str_part = part.kind == 1 and part.plan.append_helper == "mt_format_append_str"
        let is_cstr_part = part.kind == 1 and is_buffer and part.plan.append_helper == "mt_format_append_cstr"
        if is_str_part or is_cstr_part:
            let param_ty = if is_cstr_part: types.primitive("cstr") else: str_ty
            let param = alloc_expr(ir.Expr.expr_name(name = part.temp, ty = param_ty, pointer = Option[bool].some(value = false)))
            let copy_c = fresh_c_temp_name(ctx, "fmt_sink_str")
            let copy_ref = alloc_expr(ir.Expr.expr_name(name = copy_c, ty = str_ty, pointer = Option[bool].some(value = false)))
            ctx.cstr_backed_names.set(copy_c, true)
            var len_expr = alloc_expr(ir.Expr.expr_member(receiver = param, member = "len", ty = ptr_uint_ty))
            if is_cstr_part:
                var len_args = vec.Vec[ir.Expr].create()
                unsafe:
                    len_args.push(read(param))
                len_expr = alloc_expr(ir.Expr.expr_call(callee = "mt_format_cstr_len", arguments = len_args.as_span(), ty = ptr_uint_ty))
            var make_args = vec.Vec[ir.Expr].create()
            unsafe:
                make_args.push(read(len_expr))
            setup.push(ir.Stmt.stmt_local(
                name = copy_c,
                linkage_name = copy_c,
                ty = str_ty,
                value = alloc_expr(ir.Expr.expr_call(callee = "mt_format_str_make", arguments = make_args.as_span(), ty = str_ty)),
                line = 0,
                source_path = "",
            ))
            let append_callee = if is_cstr_part: "mt_format_append_cstr" else: "mt_format_append_str"
            setup.push(ir.Stmt.stmt_expression(
                expression = alloc_expr(ir.Expr.expr_call(
                    callee = append_callee,
                    arguments = sp_expr3(copy_ref, alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty)), param),
                    ty = ptr_uint_ty,
                )),
                line = 0,
                source_path = "",
            ))
            var release_args = vec.Vec[ir.Expr].create()
            unsafe:
                release_args.push(read(copy_ref))
            cleanups.push(ir.Stmt.stmt_expression(
                expression = alloc_expr(ir.Expr.expr_call(callee = "mt_format_str_release", arguments = release_args.as_span(), ty = void_ty)),
                line = 0,
                source_path = "",
            ))
            part.temp = copy_c
            part.plan = FormatPlan(append_helper = "mt_format_append_str", len_helper = part.plan.len_helper, arg_ty = str_ty, len_kind = 1, precision = 0)
        copied.push(part)
        i += 1
    return copied


## The `std.fmt` append callee for a plan: `append` uses the String method,
## `append_cstr` the cstr helper, everything else `std_fmt_<helper>`.
function format_sink_string_callee(helper: str) -> str:
    if helper == "mt_format_append_str":
        return "std_string_String_append"
    if helper == "mt_format_append_cstr":
        return "std_fmt_append_cstr"
    let prefix = "mt_format_"
    return j2("std_fmt_", helper.slice(prefix.len, helper.len - prefix.len))


## One String-sink append call (host `explicit_format_sink_append_call`).
function format_sink_string_append_call(part: FormatSinkPart, sink_value: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let void_ty = types.primitive("void")
    let int_ty = types.primitive("int")
    if part.kind == 0:
        return alloc_expr(ir.Expr.expr_call(
            callee = "std_string_String_append",
            arguments = sp_expr2(sink_value, alloc_expr(ir.Expr.expr_string_literal(value = part.text, ty = types.Type.ty_str, cstring = false))),
            ty = void_ty,
        ))
    let temp_ref = alloc_expr(ir.Expr.expr_name(name = part.temp, ty = part.plan.arg_ty, pointer = Option[bool].some(value = false)))
    if part.kind == 2:
        return alloc_expr(ir.Expr.expr_call(
            callee = "std_fmt_append_double_precision",
            arguments = sp_expr3(sink_value, temp_ref, alloc_expr(ir.Expr.expr_integer_literal(value = long<-(part.plan.precision), ty = int_ty))),
            ty = void_ty,
        ))
    if part.kind == 3:
        return alloc_expr(ir.Expr.expr_call(callee = part.plan.append_helper, arguments = sp_expr2(temp_ref, sink_value), ty = void_ty))
    return alloc_expr(ir.Expr.expr_call(callee = format_sink_string_callee(part.plan.append_helper), arguments = sp_expr2(sink_value, temp_ref), ty = void_ty))


## Append one part into a str_buffer sink through the `str` view `{data, len=cap}`,
## advancing `offset_name` (host `format_string_part_append_statements`).
function format_sink_buffer_part_stmts(
    ctx: ref[LowerCtx],
    stmts: ref[vec.Vec[ir.Stmt]],
    part: FormatSinkPart,
    view: ptr[ir.Expr],
    offset_name: str,
) -> void:
    let ptr_uint_ty = types.primitive("ptr_uint")
    let char_ty = types.primitive("char")
    let void_ty = types.primitive("void")
    let int_ty = types.primitive("int")
    let offset_ref = alloc_expr(ir.Expr.expr_name(name = offset_name, ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    if part.kind == 0:
        var args = vec.Vec[ir.Expr].create()
        unsafe:
            args.push(read(view))
            args.push(read(offset_ref))
            args.push(read(alloc_expr(ir.Expr.expr_string_literal(value = part.text, ty = types.Type.ty_str, cstring = false))))
        stmts.push(ir.Stmt.stmt_assignment(
            target = offset_ref,
            operator = "=",
            value = alloc_expr(ir.Expr.expr_call(callee = "mt_format_append_str", arguments = args.as_span(), ty = ptr_uint_ty)),
        ))
        return
    let temp_ref = alloc_expr(ir.Expr.expr_name(name = part.temp, ty = part.plan.arg_ty, pointer = Option[bool].some(value = false)))
    if part.kind == 2:
        var prec_args = vec.Vec[ir.Expr].create()
        unsafe:
            prec_args.push(read(view))
            prec_args.push(read(offset_ref))
            prec_args.push(read(temp_ref))
            prec_args.push(read(alloc_expr(ir.Expr.expr_integer_literal(value = long<-(part.plan.precision), ty = int_ty))))
        stmts.push(ir.Stmt.stmt_assignment(
            target = offset_ref,
            operator = "=",
            value = alloc_expr(ir.Expr.expr_call(callee = "mt_format_append_double_precision", arguments = prec_args.as_span(), ty = ptr_uint_ty)),
        ))
        return
    if part.kind == 3:
        # The host's custom-hook slice: build a `String` view over the buffer at
        # `view.data + offset`, call `<Type>.append_format(value, &out)`, verify
        # the hook wrote exactly the expected length, advance the offset and
        # NUL-terminate.
        let string_ty = types.Type.ty_imported(module_name = "std.string", name = "String", args = span[types.Type]())
        let ref_string_ty = types.Type.ty_generic(name = "ref", args = sp_type(string_ty))
        let ubyte_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(types.primitive("ubyte")))
        let data_field_ty = types.Type.ty_nullable(base = types.alloc_type(ubyte_ptr_ty))
        let char_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(char_ty))
        let view_data = alloc_expr(ir.Expr.expr_member(receiver = view, member = "data", ty = char_ptr_ty))
        let slice_sum = alloc_expr(ir.Expr.expr_binary(operator = "+", left = view_data, right = offset_ref, ty = char_ptr_ty))
        let slice_data = alloc_expr(ir.Expr.expr_cast(target_type = data_field_ty, expression = slice_sum, ty = data_field_ty))
        let output_name = fresh_c_temp_name(ctx, "fmt_part_output")
        let output_value = alloc_expr(ir.Expr.expr_name(name = output_name, ty = string_ty, pointer = Option[bool].some(value = false)))
        let expected_length = alloc_expr(ir.Expr.expr_name(name = part.expected_length, ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
        var fields = vec.Vec[ir.AggregateField].create()
        fields.push(ir.AggregateField(name = "data", value = slice_data))
        fields.push(ir.AggregateField(name = "len", value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty))))
        fields.push(ir.AggregateField(name = "capacity", value = expected_length))
        fields.push(ir.AggregateField(name = "owns_storage", value = alloc_expr(ir.Expr.expr_boolean_literal(value = false, ty = ctx.bool_ty))))
        stmts.push(ir.Stmt.stmt_local(
            name = output_name,
            linkage_name = output_name,
            ty = string_ty,
            value = alloc_expr(ir.Expr.expr_aggregate_literal(ty = string_ty, fields = fields.as_span())),
            line = 0,
            source_path = "",
        ))
        var hook_args = vec.Vec[ir.Expr].create()
        unsafe:
            hook_args.push(read(temp_ref))
            hook_args.push(read(alloc_expr(ir.Expr.expr_address_of(expression = output_value, ty = ref_string_ty))))
        stmts.push(ir.Stmt.stmt_expression(
            expression = alloc_expr(ir.Expr.expr_call(callee = part.plan.append_helper, arguments = hook_args.as_span(), ty = void_ty)),
            line = 0,
            source_path = "",
        ))
        let output_len = alloc_expr(ir.Expr.expr_member(receiver = output_value, member = "len", ty = ptr_uint_ty))
        var fatal_args = vec.Vec[ir.Expr].create()
        unsafe:
            fatal_args.push(read(alloc_expr(ir.Expr.expr_string_literal(value = "custom format hook length mismatch", ty = types.primitive("cstr"), cstring = true))))
        var then_body = vec.Vec[ir.Stmt].create()
        then_body.push(ir.Stmt.stmt_expression(
            expression = alloc_expr(ir.Expr.expr_call(callee = "mt_fatal", arguments = fatal_args.as_span(), ty = void_ty)),
            line = 0,
            source_path = "",
        ))
        stmts.push(ir.Stmt.stmt_if(
            condition = alloc_expr(ir.Expr.expr_binary(operator = "!=", left = output_len, right = expected_length, ty = ctx.bool_ty)),
            then_body = then_body.as_span(),
            else_body = Option[span[ir.Stmt]].none,
        ))
        let offset_next = alloc_expr(ir.Expr.expr_binary(operator = "+", left = offset_ref, right = output_len, ty = ptr_uint_ty))
        stmts.push(ir.Stmt.stmt_assignment(target = offset_ref, operator = "=", value = offset_next))
        stmts.push(ir.Stmt.stmt_assignment(
            target = alloc_expr(ir.Expr.expr_index(receiver = view_data, index = offset_ref, ty = char_ty)),
            operator = "=",
            value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = char_ty)),
        ))
        return
    var args = vec.Vec[ir.Expr].create()
    unsafe:
        args.push(read(view))
        args.push(read(offset_ref))
        args.push(read(temp_ref))
    stmts.push(ir.Stmt.stmt_assignment(
        target = offset_ref,
        operator = "=",
        value = alloc_expr(ir.Expr.expr_call(callee = part.plan.append_helper, arguments = args.as_span(), ty = ptr_uint_ty)),
    ))


## The static-format sink call (host `explicit_format_sink_runtime_call`).
function explicit_format_sink_runtime_call(
    ctx: ref[LowerCtx],
    is_assign: bool,
    target: FormatSinkTarget,
    text_value: ptr[ir.Expr],
) -> ptr[ir.Expr]:
    let void_ty = types.primitive("void")
    match target:
        FormatSinkTarget.fst_buffer as buf:
            let callee = if is_assign: "mt_str_buffer_assign" else: "mt_str_buffer_append"
            var args = vec.Vec[ir.Expr].create()
            unsafe:
                args.push(read(text_value))
                args.push(read(buf.data_pointer))
                args.push(read(buf.capacity))
                args.push(read(buf.len_pointer))
                args.push(read(buf.dirty_pointer))
            return alloc_expr(ir.Expr.expr_call(callee = callee, arguments = args.as_span(), ty = void_ty))
        FormatSinkTarget.fst_string as s:
            let callee = if is_assign: "std_string_String_assign" else: "std_string_String_append"
            return alloc_expr(ir.Expr.expr_call(callee = callee, arguments = sp_expr2(s.value, text_value), ty = void_ty))


## Emit the dynamic sink stream (host `lower_explicit_format_sink_expression_
## statement`'s non-static branch).
function emit_format_sink_dynamic(
    ctx: ref[LowerCtx],
    stmts: ref[vec.Vec[ir.Stmt]],
    info: FormatSinkInfo,
    target: FormatSinkTarget,
    parts: vec.Vec[FormatSinkPart],
    line: ptr_uint,
    path: str,
) -> void:
    let ptr_uint_ty = types.primitive("ptr_uint")
    if not info.is_buffer:
        match target:
            FormatSinkTarget.fst_string as s:
                if info.is_assign:
                    stmts.push(ir.Stmt.stmt_expression(
                        expression = alloc_expr(ir.Expr.expr_call(callee = "std_string_String_clear", arguments = single_expr_span(s.value), ty = types.primitive("void"))),
                        line = line,
                        source_path = path,
                    ))
                var i: ptr_uint = 0
                while i < parts.len:
                    let part_ptr = parts.get(i) else:
                        break
                    stmts.push(ir.Stmt.stmt_expression(
                        expression = format_sink_string_append_call(unsafe: read(part_ptr), s.value),
                        line = line,
                        source_path = path,
                    ))
                    i += 1
            _:
                pass
        return
    match target:
        FormatSinkTarget.fst_buffer as buf:
            if info.is_assign:
                var clear_args = vec.Vec[ir.Expr].create()
                unsafe:
                    clear_args.push(read(buf.data_pointer))
                    clear_args.push(read(buf.capacity))
                    clear_args.push(read(buf.len_pointer))
                    clear_args.push(read(buf.dirty_pointer))
                stmts.push(ir.Stmt.stmt_expression(
                    expression = alloc_expr(ir.Expr.expr_call(callee = "mt_str_buffer_clear", arguments = clear_args.as_span(), ty = types.primitive("void"))),
                    line = line,
                    source_path = path,
                ))
            let offset_name = fresh_c_temp_name(ctx, "fmt_sink_offset")
            var offset_init: ptr[ir.Expr] = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty))
            if not info.is_assign:
                var len_args = vec.Vec[ir.Expr].create()
                unsafe:
                    len_args.push(read(buf.data_pointer))
                    len_args.push(read(buf.capacity))
                    len_args.push(read(buf.len_pointer))
                    len_args.push(read(buf.dirty_pointer))
                offset_init = alloc_expr(ir.Expr.expr_call(callee = "mt_str_buffer_len", arguments = len_args.as_span(), ty = ptr_uint_ty))
            stmts.push(ir.Stmt.stmt_local(name = offset_name, linkage_name = offset_name, ty = ptr_uint_ty, value = offset_init, line = 0, source_path = ""))
            var view_fields = vec.Vec[ir.AggregateField].create()
            view_fields.push(ir.AggregateField(name = "data", value = buf.data_pointer))
            view_fields.push(ir.AggregateField(name = "len", value = buf.capacity))
            let view = alloc_expr(ir.Expr.expr_aggregate_literal(ty = types.Type.ty_str, fields = view_fields.as_span()))
            var i: ptr_uint = 0
            while i < parts.len:
                let part_ptr = parts.get(i) else:
                    break
                format_sink_buffer_part_stmts(ctx, stmts, unsafe: read(part_ptr), view, offset_name)
                i += 1
            stmts.push(ir.Stmt.stmt_assignment(
                target = alloc_expr(ir.Expr.expr_unary(
                    operator = "*",
                    operand = buf.len_pointer,
                    ty = ptr_uint_ty,
                )),
                operator = "=",
                value = alloc_expr(ir.Expr.expr_name(name = offset_name, ty = ptr_uint_ty, pointer = Option[bool].some(value = false))),
            ))
        _:
            pass


## Lower a statement-form explicit format sink.  Returns false when the
## expression is not a sink, so the ordinary expression-statement path runs.
function lower_explicit_format_sink_stmt(
    ctx: ref[LowerCtx],
    output: ref[vec.Vec[ir.Stmt]],
    ep: ptr[ast.Expr],
    line: ptr_uint,
) -> bool:
    let info = explicit_format_sink_info(ctx, ep) else:
        return false
    let base = output.len()
    let saved = begin_stmt_setup(ctx, HoistMode.hm_value)
    ctx.hoist_root_ep = ep
    let sink_cleanup_start = ctx.hoist_cleanups.len
    let target = lower_format_sink_target(ctx, info)
    let sink_cleanup_end = ctx.hoist_cleanups.len
    if format_string_all_static(info.format_parts):
        let text = format_string_static_literal(info.format_parts)
        ctx.hoist_stmts.push(ir.Stmt.stmt_expression(
            expression = explicit_format_sink_runtime_call(ctx, info.is_assign, target, text),
            line = line,
            source_path = ctx.analysis.source_path,
        ))
    else:
        var parts = build_format_sink_parts(ctx, info.format_parts, ref_of(ctx.hoist_stmts))
        let part_cleanup_end = ctx.hoist_cleanups.len
        var copy_cleanups = vec.Vec[ir.Stmt].create()
        let copied = copy_format_sink_parts(ctx, parts, info.is_buffer, ref_of(ctx.hoist_stmts), ref_of(copy_cleanups))
        emit_format_sink_dynamic(ctx, ref_of(ctx.hoist_stmts), info, target, copied, line, ctx.analysis.source_path)
        let collected = collect_stmt_setup(ctx, saved)
        emit_hoist_setup(output, base, collected)
        var ci: ptr_uint = 0
        while ci < copy_cleanups.len:
            let stmt = copy_cleanups.get(ci) else:
                break
            output.push(unsafe: read(stmt))
            ci += 1
        ci = sink_cleanup_start
        while ci < sink_cleanup_end:
            let stmt = collected.cleanups.get(ci) else:
                break
            output.push(unsafe: read(stmt))
            ci += 1
        ci = part_cleanup_end
        while ci < collected.cleanups.len:
            let stmt = collected.cleanups.get(ci) else:
                break
            output.push(unsafe: read(stmt))
            ci += 1
        return true
    let collected = collect_stmt_setup(ctx, saved)
    emit_hoist_setup(output, base, collected)
    var ci: ptr_uint = 0
    while ci < collected.cleanups.len:
        let stmt = collected.cleanups.get(ci) else:
            break
        output.push(unsafe: read(stmt))
        ci += 1
    return true





## Map a type to its format-length helper name.
function fmt_len_helper_name(expr: ptr[ir.Expr]) -> str:
    return "mt_format_int_len"


## Map a type to its format-append helper name.
function fmt_append_helper_name(expr: ptr[ir.Expr]) -> str:
    let t = ir_expr_type(expr)
    if types.is_integer_type(t):
        return "mt_format_append_int"
    match t:
        types.Type.ty_str:
            return "mt_format_append_str"
        _:
            return "mt_format_append_int"


# =============================================================================
#  Compile-time evaluation and lowering (when, inline if, inline match)
# =============================================================================

## A compile-time constant value: integer, boolean, string, or type.
variant ConstValue:
    cv_int(value: long)
    cv_bool(value: bool)
    cv_str(value: str)
    cv_type(ty: types.Type)


## Lower a `when` statement: evaluate the discriminant at compile time,
## find the matching branch, and only emit that branch's body.
function lower_when_stmt(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], discriminant: ptr[ast.Expr], branches: span[ast.WhenBranch], else_body: ptr[ast.Stmt]?) -> void:
    match try_evaluate_const_expr(ctx, discriminant):
        Option.some as val:
            var i: ptr_uint = 0
            while i < branches.len:
                var br: ast.WhenBranch
                unsafe:
                    br = read(branches.data + i)
                match try_evaluate_const_expr(ctx, br.pattern):
                    Option.some as pv:
                        if const_values_equal(val.value, pv.value):
                            lower_span_stmts(ctx, output, br.body)
                            return
                    Option.none:
                        pass
                i += 1
            let eb = else_body
            if eb != null:
                lower_block_stmts(ctx, output, eb)
        Option.none:
            pass


## Lower an `inline if` statement.  Evaluate the condition; if true, emit
## the then-branch; otherwise emit the else branch (if present).
function lower_inline_if_statement(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], branches: span[ast.IfBranch], else_body: ptr[ast.Stmt]?) -> void:
    if branches.len == 0:
        return
    # Each `else if` is its own branch with its own condition; evaluate them in
    # order and emit the first branch whose compile-time condition is true.
    var i: ptr_uint = 0
    while i < branches.len:
        var br: ast.IfBranch
        unsafe:
            br = read(branches.data + i)
        match try_evaluate_const_expr(ctx, br.condition):
            Option.some as val:
                match val.value:
                    ConstValue.cv_bool as bv:
                        if bv.value:
                            lower_block_stmts(ctx, output, br.body)
                            return
                        # False: fall through to the next `else if` / `else`.
                    _:
                        # Non-bool discriminant: cannot select a branch.
                        return
            Option.none:
                # Can't evaluate at compile time: emit nothing (like Ruby).
                return
        i += 1
    # No branch condition held: emit the trailing `else` body, if any.
    let el = else_body
    if el != null:
        lower_block_stmts(ctx, output, el)


## Lower an `inline match` statement.  Evaluate the scrutinee and only emit
## the matching arm's body.  If no arm matches, emit the wildcard or nothing.
function lower_inline_match_statement(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], scrutinee: ptr[ast.Expr], arms: span[ast.MatchArm]) -> void:
    match try_evaluate_const_expr(ctx, scrutinee):
        Option.some as val:
            var i: ptr_uint = 0
            while i < arms.len:
                var arm: ast.MatchArm
                unsafe:
                    arm = read(arms.data + i)
                if arm.pattern == null:
                    if arm.body != null:
                        unsafe:
                            lower_block_stmts(ctx, output, ptr[ast.Stmt]<-arm.body)
                    return
                let pattern_ptr = arm.pattern else:
                    return
                match try_evaluate_const_expr(ctx, pattern_ptr):
                    Option.some as pv:
                        if const_values_equal(val.value, pv.value):
                            if arm.body != null:
                                unsafe:
                                    lower_block_stmts(ctx, output, ptr[ast.Stmt]<-arm.body)
                            return
                    Option.none:
                        pass
                i += 1
        Option.none:
            pass


## Lower an `inline while` statement.  Evaluate the condition at compile time;
## if constantly true, unroll the loop body (capped at MAX_INLINE_WHILE_ITERS).
## Mirrors Ruby's lower_inline_while_stmt.
const MAX_INLINE_WHILE_ITERS: ptr_uint = 10000

function lower_inline_while(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], condition: ptr[ast.Expr], body_ptr: ptr[ast.Stmt]?) -> void:
    let body = body_ptr else:
        return
    var iter: ptr_uint = 0
    while iter < MAX_INLINE_WHILE_ITERS:
        match try_evaluate_const_expr(ctx, condition):
            Option.some as val:
                match val.value:
                    ConstValue.cv_bool as bv:
                        if not bv.value:
                            return
                    _:
                        return
            Option.none:
                return
        lower_block_stmts(ctx, output, body)
        iter += 1


## Lower an `inline for` statement: evaluate the iterable at compile time and
## unroll the loop body once per element, binding the loop variable to each
## element in turn.  Mirrors Ruby's lower_inline_for_stmt.
function lower_inline_for_stmt(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], bindings: span[ast.ForBinding], iterables: span[ast.Expr], body_ptr: ptr[ast.Stmt]?) -> void:
    if bindings.len != 1 or iterables.len != 1:
        return
    var binding_name: str
    unsafe:
        binding_name = read(bindings.data + 0).name

    var first_iterable: ast.Expr
    unsafe:
        first_iterable = read(iterables.data + 0)
    match comptime_iterable_elements(ctx, ptr_of(first_iterable)):
        Option.some as elements:
            var i: ptr_uint = 0
            while i < elements.value.len:
                let bp = body_ptr
                if bp != null:
                    var elem: ComptimeElement
                    unsafe:
                        elem = read(elements.value.data + i)
                    # For struct fields: check if the body is a type-guard pattern
                    # `if field.type != X: return false` and evaluate at comptime.
                    lower_inline_for_iteration(ctx, output, binding_name, elem, bp)
                i += 1
        Option.none:
            pass


## Extract the compile-time iterable for known comptime builtins (fields_of,
## members_of) as a span of struct-field or enum-member info pairs.
## Returns none for unrecognised expressions.
variant ComptimeElement:
    ce_struct_field(name: str, field_type: types.Type)
    ce_enum_member(name: str, member_value: long)
    ce_attribute


function comptime_iterable_elements(ctx: ref[LowerCtx], iterable: ptr[ast.Expr]) -> Option[span[ComptimeElement]]:
    unsafe:
        match read(iterable):
            ast.Expr.expr_call as call:
                match read(call.callee):
                    ast.Expr.expr_identifier as id:
                        if id.name == "fields_of" and call.args.len == 1:
                            return comptime_fields_of(ctx, call.args.data + 0)
                        if id.name == "members_of" and call.args.len == 1:
                            return comptime_members_of(ctx, call.args.data + 0)
                        if id.name == "attributes_of" and call.args.len >= 1:
                            return comptime_attributes_of(ctx, call.args)
                    _:
                        pass
            _:
                pass
    return Option[span[ComptimeElement]].none


function comptime_fields_of(ctx: ref[LowerCtx], args_data: ptr[ast.Argument]) -> Option[span[ComptimeElement]]:
    let type_name: str = comptime_resolve_type_arg_name(ctx, args_data)
    if type_name.len == 0:
        return Option[span[ComptimeElement]].none
    let entries = comptime_lookup_struct_fields(ctx, type_name) else:
        return Option[span[ComptimeElement]].none
    var elements = vec.Vec[ComptimeElement].create()
    var ei: ptr_uint = 0
    while ei < entries.len:
        var entry: analyzer.FieldEntry
        unsafe:
            entry = read(entries.data + ei)
        elements.push(ComptimeElement.ce_struct_field(name = entry.name, field_type = qualify_type(ctx, entry.ty)))
        ei += 1
    return Option[span[ComptimeElement]].some(value = elements.as_span())


## Look up a struct's field list by name, searching the current module first and
## then every program analysis.  Cross-module search lets a generic reflective
## helper defined in one module (e.g. `std.fmt.format_value[T]`) reflect over a
## struct type defined in another module.
function comptime_lookup_struct_fields(ctx: ref[LowerCtx], type_name: str) -> Option[span[analyzer.FieldEntry]]:
    let local = ctx.analysis.structs.get(type_name)
    if local != null:
        return Option[span[analyzer.FieldEntry]].some(value = unsafe: read(local))
    var i: ptr_uint = 0
    while i < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + i)
        let p = a.structs.get(type_name)
        if p != null:
            return Option[span[analyzer.FieldEntry]].some(value = unsafe: read(p))
        i += 1
    return Option[span[analyzer.FieldEntry]].none


function comptime_members_of(ctx: ref[LowerCtx], args_data: ptr[ast.Argument]) -> Option[span[ComptimeElement]]:
    let type_name: str = comptime_resolve_type_arg_name(ctx, args_data)
    if type_name.len == 0:
        return Option[span[ComptimeElement]].none
    let names = comptime_lookup_member_names(ctx, type_name) else:
        return Option[span[ComptimeElement]].none
    var elements = vec.Vec[ComptimeElement].create()
    var ni: ptr_uint = 0
    while ni < names.len:
        var member_name: str
        unsafe:
            member_name = read(names.data + ni)
        let mv = comptime_enum_member_value(ctx, type_name, member_name)
        elements.push(ComptimeElement.ce_enum_member(name = member_name, member_value = mv))
        ni += 1
    return Option[span[ComptimeElement]].some(value = elements.as_span())


## Look up an enum/variant's member names by type name, searching the current
## module first and then every program analysis, so `members_of(alias.Enum)`
## reflects an enum declared in another module.
function comptime_lookup_member_names(ctx: ref[LowerCtx], type_name: str) -> Option[span[str]]:
    let local = ctx.analysis.match_case_names.get(type_name)
    if local != null:
        return Option[span[str]].some(value = unsafe: read(local))
    var i: ptr_uint = 0
    while i < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + i)
        let p = a.match_case_names.get(type_name)
        if p != null:
            return Option[span[str]].some(value = unsafe: read(p))
        i += 1
    return Option[span[str]].none


## Look up the integer value of an enum member by scanning the source file of the
## analysis that declares the enum (searched program-wide).
function comptime_enum_member_value(ctx: ref[LowerCtx], type_name: str, member_name: str) -> long:
    var fi: ptr_uint = 0
    while fi <= ctx.program_analyses.len:
        var file: ast.SourceFile
        unsafe:
            if fi == 0:
                file = ctx.analysis.source_file
            else:
                file = read(ctx.program_analyses.data + (fi - 1)).source_file
        let found = enum_member_value_in_file(ctx, file, type_name, member_name)
        match found:
            Option.some as v:
                return v.value
            Option.none:
                pass
        fi += 1
    return 0


## The value of `type_name.member_name` in the module that declares the enum —
## the host's constant evaluation of an enum member (`int<-Kind.A` → 0).
function enum_member_value_in_module(ctx: ref[LowerCtx], module_name: str, type_name: str, member_name: str) -> Option[long]:
    let a = find_imported_analysis(ctx, module_name) else:
        return Option[long].none
    return enum_member_value_in_file(ctx, a.source_file, type_name, member_name)


## The value of an enum/flags member *expression* (`Kind.A`, or an imported
## `Keyb.KEY_ESCAPE`): the member's own type names the declaring module, with the
## name-based lookup as a fallback.
function enum_member_value_of_expr(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> Option[long]:
    unsafe:
        match read(ep):
            ast.Expr.expr_member_access as ma:
                let operand_ty = expr_type(ctx, ep)
                var enum_name = ""
                var enum_module = ""
                match operand_ty:
                    types.Type.ty_imported as im:
                        enum_name = im.name
                        enum_module = if im.module_name.len > 0: im.module_name else: ctx.module_name
                    types.Type.ty_named as nm:
                        enum_name = nm.name
                        enum_module = if nm.module_name.len > 0: nm.module_name else: ctx.module_name
                    _:
                        pass
                if enum_name.len > 0:
                    var found = Option[long].none
                    if enum_module.equal(ctx.module_name):
                        found = enum_member_value_in_file(ctx, ctx.analysis.source_file, enum_name, ma.member_name)
                    else:
                        found = enum_member_value_in_module(ctx, enum_module, enum_name, ma.member_name)
                    match found:
                        Option.some as mv:
                            return Option[long].some(value = mv.value)
                        Option.none:
                            pass
                let by_name = try_lookup_enum_value(ctx, ma.receiver, ma.member_name)
                if by_name >= 0:
                    return Option[long].some(value = by_name)
                return Option[long].none
            _:
                return Option[long].none


function enum_member_value_in_file(ctx: ref[LowerCtx], file: ast.SourceFile, type_name: str, member_name: str) -> Option[long]:
    var di: ptr_uint = 0
    while di < file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(file.declarations.data + di)
        match d:
            ast.Decl.decl_enum as e:
                if e.name == type_name:
                    var mi: ptr_uint = 0
                    var auto_val: long = 0
                    while mi < e.enum_members.len:
                        var m: ast.EnumMember
                        unsafe:
                            m = read(e.enum_members.data + mi)
                        let vp = m.value
                        if vp != null:
                            unsafe:
                                match try_evaluate_const_expr(ctx, vp):
                                    Option.some as cv_val:
                                        match cv_val.value:
                                            ConstValue.cv_int as iv:
                                                auto_val = iv.value
                                            _:
                                                pass
                                    Option.none:
                                        pass
                        if m.name == member_name:
                            return Option[long].some(value = auto_val)
                        auto_val += 1
                        mi += 1
                    return Option[long].none
            _:
                pass
        di += 1
    return Option[long].none


function comptime_attributes_of(ctx: ref[LowerCtx], args: span[ast.Argument]) -> Option[span[ComptimeElement]]:
    if args.len == 0:
        return Option[span[ComptimeElement]].none
    # `attributes_of(field_of(Type, field)[, name])` reflects the field's
    # attributes; `attributes_of(Type[, name])` the declaration's.
    unsafe:
        let first = read(args.data + 0)
        match read(first.arg_value):
            ast.Expr.expr_call as call:
                match read(call.callee):
                    ast.Expr.expr_identifier as cid:
                        if cid.name == "field_of" and call.args.len == 2:
                            let type_name = comptime_type_arg_name(call.args.data + 0)
                            let field_name = comptime_arg_name(call.args.data + 1)
                            return comptime_elements_for_attribute_apps(comptime_field_attr_apps(ctx, type_name, field_name), comptime_attr_filter(args))
                    _:
                        pass
            _:
                pass
    var type_name = ""
    unsafe:
        type_name = comptime_resolve_type_arg_name(ctx, args.data + 0)
    return comptime_elements_for_attribute_apps(comptime_attr_apps(ctx, type_name), comptime_attr_filter(args))


## The attribute-name filter of `attributes_of(target, name)`, or "" when the
## call has no filter argument.
function comptime_attr_filter(args: span[ast.Argument]) -> str:
    if args.len < 2:
        return ""
    unsafe:
        return comptime_arg_name(args.data + 1)


## Build one element per attribute application matching `filter` (all of them
## when the filter is empty).
function comptime_elements_for_attribute_apps(apps: span[ast.AttributeApplication], filter: str) -> Option[span[ComptimeElement]]:
    var elements = vec.Vec[ComptimeElement].create()
    var ai: ptr_uint = 0
    while ai < apps.len:
        var app: ast.AttributeApplication
        unsafe:
            app = read(apps.data + ai)
        if filter.len == 0 or attribute_application_name_is(app, filter):
            elements.push(ComptimeElement.ce_attribute)
        ai += 1
    return Option[span[ComptimeElement]].some(value = elements.as_span())


function attribute_application_name_is(app: ast.AttributeApplication, name: str) -> bool:
    if app.name.parts.len == 0:
        return false
    unsafe:
        return read(app.name.parts.data + (app.name.parts.len - 1)) == name


## The attribute applications recorded for the declaration `type_name`,
## searching the current module first and then every program analysis.
function comptime_attr_apps(ctx: ref[LowerCtx], type_name: str) -> span[ast.AttributeApplication]:
    if type_name.len == 0:
        return span[ast.AttributeApplication]()
    let local = ctx.analysis.attribute_applications.get(type_name)
    if local != null:
        return unsafe: read(local)
    var i: ptr_uint = 0
    while i < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + i)
        let p = a.attribute_applications.get(type_name)
        if p != null:
            return unsafe: read(p)
        i += 1
    return span[ast.AttributeApplication]()


## The attribute applications recorded for `Type.field`, searching the current
## module first and then every program analysis.
function comptime_field_attr_apps(ctx: ref[LowerCtx], type_name: str, field_name: str) -> span[ast.AttributeApplication]:
    if type_name.len == 0 or field_name.len == 0:
        return span[ast.AttributeApplication]()
    var key_buf = string.String.create()
    key_buf.append(type_name)
    key_buf.append(".")
    key_buf.append(field_name)
    let key = key_buf.as_str()
    let local = ctx.analysis.field_attribute_applications.get(key)
    if local != null:
        return unsafe: read(local)
    var i: ptr_uint = 0
    while i < ctx.program_analyses.len:
        var a: analyzer.Analysis
        unsafe:
            a = read(ctx.program_analyses.data + i)
        let p = a.field_attribute_applications.get(key)
        if p != null:
            return unsafe: read(p)
        i += 1
    return span[ast.AttributeApplication]()


## Lower one iteration of an inline for loop.  For struct fields, detect and
## handle `size_of(field.type)` and `field.type != X` patterns at comptime.
## For enum members and attributes, emit the body with a dummy binding.
function lower_inline_for_iteration(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], binding_name: str, elem: ComptimeElement, body_ptr: ptr[ast.Stmt]) -> void:
    match elem:
        ComptimeElement.ce_struct_field as f:
            lower_inline_for_field_iter(ctx, output, binding_name, f.name, f.field_type, body_ptr)
        _:
            var iter_stmts = vec.Vec[ir.Stmt].create()
            let binding_c = utils.c_local_name(binding_name)
            # The host binds the loop variable as a compile-time constant
            # (`const_value` + `substitute_const_value`): no local is declared;
            # member reads (`.name`, `.value`) are substituted.
            ctx.locals.push(LocalBinding(name = binding_name, c_name = binding_c, ty = types.primitive("int"), pointer = Option[bool].some(value = false)))
            ctx.inline_for_element = Option[ComptimeElement].some(value = elem)
            lower_block_stmts(ctx, ref_of(iter_stmts), body_ptr)
            ctx.inline_for_element = Option[ComptimeElement].none
            ctx.locals.pop()
            if iter_stmts.len() > 0:
                output.push(ir.Stmt.stmt_block(body = iter_stmts.as_span()))


## Lower one inline for iteration over a struct field, handling size_of(field.type).
function lower_inline_for_field_iter(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], binding_name: str, field_name: str, field_ty: types.Type, body_ptr: ptr[ast.Stmt]) -> void:
    ctx.inline_for_element = Option[ComptimeElement].some(value = ComptimeElement.ce_struct_field(name = field_name, field_type = field_ty))
    var iter_stmts = vec.Vec[ir.Stmt].create()
    let binding_c = utils.c_local_name(binding_name)
    # The host binds the field handle as a compile-time constant and declares no
    # local; `field.type` / `field.name` reads are substituted, and a body that
    # folds away entirely contributes no block.
    ctx.locals.push(LocalBinding(name = binding_name, c_name = binding_c, ty = field_ty, pointer = Option[bool].some(value = false)))
    lower_inline_for_field_body(ctx, ref_of(iter_stmts), body_ptr, field_ty)
    ctx.locals.pop()
    ctx.inline_for_element = Option[ComptimeElement].none
    if iter_stmts.len() > 0:
        output.push(ir.Stmt.stmt_block(body = iter_stmts.as_span()))


function lower_inline_for_field_body(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], body: ptr[ast.Stmt], field_ty: types.Type) -> void:
    var processed = false
    unsafe:
        match read(body):
            ast.Stmt.stmt_block as blk:
                lower_inline_for_field_stmts(ctx, output, blk.statements, field_ty)
                processed = true
            _:
                pass
    if not processed:
        if not lower_inline_field_type_guard(ctx, output, body, field_ty):
            lower_stmt(ctx, output, body)


function lower_inline_for_field_stmts(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], stmts: span[ast.Stmt], field_ty: types.Type) -> void:
    var i: ptr_uint = 0
    while i < stmts.len:
        unsafe:
            lower_inline_for_field_body(ctx, output, stmts.data + i, field_ty)
        i += 1


## Try to lower `if field.type != X: return false` at comptime.
function lower_inline_field_type_guard(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], sp: ptr[ast.Stmt], field_ty: types.Type) -> bool:
    var br: ast.IfBranch
    var body: ptr[ast.Stmt]?
    unsafe:
        match read(sp):
            ast.Stmt.stmt_if as iff:
                if iff.branches.len != 1:
                    return false
                br = read(iff.branches.data + 0)
            _:
                return false
    match extract_field_type_compare(ctx, br.condition, field_ty):
        Option.some as matches:
            if matches.value:
                lower_block_stmts(ctx, output, br.body)
            return true
        Option.none:
            return false


function extract_field_type_compare(ctx: ref[LowerCtx], cond: ptr[ast.Expr], field_ty: types.Type) -> Option[bool]:
    unsafe:
        match read(cond):
            ast.Expr.expr_binary_op as bin:
                if bin.operator == "==" or bin.operator == "!=":
                    let rhs_ty = comptime_expr_to_type(ctx, bin.right)
                    if not types.is_error(rhs_ty):
                        let equal = types.type_to_string(field_ty) == types.type_to_string(rhs_ty)
                        if bin.operator == "==":
                            return Option[bool].some(value = equal)
                        return Option[bool].some(value = not equal)
            _:
                pass
    return Option[bool].none


## Resolve a bare identifier to a compile-time type value: an in-scope generic
## type parameter (via the active substitution) or a primitive/`str` type name.
## Returns none for ordinary value identifiers.
function comptime_identifier_type(ctx: ref[LowerCtx], name: str) -> Option[types.Type]:
    let subst = ctx.type_substitution.get(name)
    if subst != null:
        return Option[types.Type].some(value = unsafe: read(subst))
    if name == "str":
        return Option[types.Type].some(value = types.Type.ty_str)
    if types.is_numeric_name(name) or types.is_integer_name(name) or name == "float" or name == "double" or name == "bool" or name == "char" or name == "void" or name == "cstr":
        return Option[types.Type].some(value = types.primitive(name))
    return Option[types.Type].none


function comptime_expr_to_type(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> types.Type:
    unsafe:
        match read(ep):
            ast.Expr.expr_identifier as id:
                if types.is_numeric_name(id.name) or types.is_integer_name(id.name) or id.name == "float" or id.name == "double":
                    return types.primitive(id.name)
            _:
                pass
    return types.Type.ty_error


function comptime_element_type(ctx: ref[LowerCtx], elem: ComptimeElement) -> types.Type:
    match elem:
        ComptimeElement.ce_struct_field:
            return types.Type.ty_error  # field_handle — opaque
        ComptimeElement.ce_enum_member:
            return types.Type.ty_error  # member_handle — opaque
        ComptimeElement.ce_attribute:
            return types.Type.ty_error  # attribute_handle — opaque


## Extract the type name from a comptime argument like `Particle`, `Labeled`, or a
## module-qualified `types.EntityKind` (the analyzer keys its type tables by the
## bare name, so the qualifier is dropped).
function comptime_type_arg_name(arg_ptr: ptr[ast.Argument]) -> str:
    unsafe:
        let arg = read(arg_ptr)
        match read(arg.arg_value):
            ast.Expr.expr_identifier as id:
                return id.name
            ast.Expr.expr_member_access as ma:
                return ma.member_name
            _:
                pass
    return ""


## Like `comptime_type_arg_name`, but resolves an in-scope generic type
## parameter (e.g. `fields_of(T)` inside `count_fields[T]()`) through the active
## substitution to the concrete struct/enum name.  Without this, `T` would be
## looked up literally and reflection over a type parameter would find nothing.
function comptime_resolve_type_arg_name(ctx: ref[LowerCtx], arg_ptr: ptr[ast.Argument]) -> str:
    let raw = comptime_type_arg_name(arg_ptr)
    if raw.len == 0:
        return raw
    let subst = ctx.type_substitution.get(raw)
    if subst != null:
        return type_simple_name(unsafe: read(subst))
    return raw


## The bare (unqualified) name of a named/imported/generic type, or "" otherwise.
function type_simple_name(t: types.Type) -> str:
    match t:
        types.Type.ty_named as n:
            return n.name
        types.Type.ty_imported as im:
            return im.name
        types.Type.ty_generic as g:
            return g.name
        _:
            return ""


## Extract a string argument value from a comptime argument.
function comptime_arg_name(arg_ptr: ptr[ast.Argument]) -> str:
    unsafe:
        let arg = read(arg_ptr)
        match read(arg.arg_value):
            ast.Expr.expr_identifier as id:
                return id.name
            ast.Expr.expr_string_literal as s:
                return s.value
            _:
                pass
    return ""


## While lowering an inline for body, detect member access on the loop variable
## (`.value` for enum members, `.type` for struct fields) and substitute the
## comptime-known value.
function inline_for_member_subst(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], member: str) -> Option[ptr[ir.Expr]]:
    match ctx.inline_for_element:
        Option.some as elem_val:
            match elem_val.value:
                ComptimeElement.ce_enum_member as m:
                    unsafe:
                        match read(receiver):
                            ast.Expr.expr_identifier as id:
                                if member == "value":
                                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = m.member_value, ty = types.primitive("int"))))
                                if member == "name":
                                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_string_literal(value = m.name, ty = types.Type.ty_str, cstring = false)))
                            _:
                                pass
                ComptimeElement.ce_struct_field as f:
                    unsafe:
                        match read(receiver):
                            ast.Expr.expr_identifier as id:
                                if member == "type":
                                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_name(name = "sizeof_hint", ty = f.field_type, pointer = Option[bool].some(value = false))))
                                if member == "name":
                                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_string_literal(value = f.name, ty = types.Type.ty_str, cstring = false)))
                            _:
                                pass
                _:
                    pass
        Option.none:
            pass
    return Option[ptr[ir.Expr]].none


## Resolve `field.type` in type position inside an inline for body: when the
## current comptime element is a struct field and the binding name matches,
## return the field's concrete type.
function inline_for_type_subst(ctx: ref[LowerCtx], binding_name: str) -> types.Type:
    match ctx.inline_for_element:
        Option.some as elem_val:
            match elem_val.value:
                ComptimeElement.ce_struct_field as f:
                    # Check if there's a local binding with this name.  We can't
                    # directly check by name since the binding could be from
                    # another scope.  Assume the binding_name matches the current
                    # inline for element.
                    return f.field_type
                _:
                    pass
        Option.none:
            pass
    return types.Type.ty_error


## Compare two compile-time values for equality.  Integer values are compared
## with each other; booleans with booleans; strings with strings; types with types.
function const_values_equal(l: ConstValue, r: ConstValue) -> bool:
    match l:
        ConstValue.cv_int as li:
            match r:
                ConstValue.cv_int as ri:
                    return li.value == ri.value
                _:
                    return false
        ConstValue.cv_bool as lb:
            match r:
                ConstValue.cv_bool as rb:
                    return lb.value == rb.value
                _:
                    return false
        ConstValue.cv_str as ls:
            match r:
                ConstValue.cv_str as rs:
                    return ls.value == rs.value
                _:
                    return false
        ConstValue.cv_type as lt:
            match r:
                ConstValue.cv_type as rt:
                    return types_are_equal(lt.ty, rt.ty)
                _:
                    return false


## Simple type equality check for primitive/named types.
function types_are_equal(a: types.Type, b: types.Type) -> bool:
    let ta = types.type_to_string(a)
    let tb = types.type_to_string(b)
    return ta == tb


## Compile-time value of an expression inside an inline-for body: literals, a
## type identifier, and the active comptime element's members (`field.name`,
## `field.type`, `member.name`, `member.value`).  The host evaluates the same
## way through the loop variable's `const_value` substitution.
function inline_for_eval_const(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> Option[ConstValue]:
    unsafe:
        match read(ep):
            ast.Expr.expr_integer_literal as lit:
                return Option[ConstValue].some(value = ConstValue.cv_int(value = long<-lit.value))
            ast.Expr.expr_char_literal as c:
                return Option[ConstValue].some(value = ConstValue.cv_int(value = long<-c.value))
            ast.Expr.expr_bool_literal as b:
                return Option[ConstValue].some(value = ConstValue.cv_bool(value = b.value))
            ast.Expr.expr_string_literal as s:
                return Option[ConstValue].some(value = ConstValue.cv_str(value = s.value))
            ast.Expr.expr_identifier as id:
                if id.name == "true":
                    return Option[ConstValue].some(value = ConstValue.cv_bool(value = true))
                if id.name == "false":
                    return Option[ConstValue].some(value = ConstValue.cv_bool(value = false))
                match comptime_identifier_type(ctx, id.name):
                    Option.some as ty:
                        return Option[ConstValue].some(value = ConstValue.cv_type(ty = ty.value))
                    Option.none:
                        pass
            ast.Expr.expr_member_access as ma:
                match read(ma.receiver):
                    ast.Expr.expr_identifier:
                        match ctx.inline_for_element:
                            Option.some as elem_val:
                                match elem_val.value:
                                    ComptimeElement.ce_enum_member as m:
                                        if ma.member_name == "name":
                                            return Option[ConstValue].some(value = ConstValue.cv_str(value = m.name))
                                        if ma.member_name == "value":
                                            return Option[ConstValue].some(value = ConstValue.cv_int(value = m.member_value))
                                    ComptimeElement.ce_struct_field as f:
                                        if ma.member_name == "name":
                                            return Option[ConstValue].some(value = ConstValue.cv_str(value = f.name))
                                        if ma.member_name == "type":
                                            return Option[ConstValue].some(value = ConstValue.cv_type(ty = f.field_type))
                                    _:
                                        pass
                            Option.none:
                                pass
                    _:
                        pass
            ast.Expr.expr_prefix_cast as pc:
                return inline_for_eval_const(ctx, pc.expression)
            _:
                pass
    return Option[ConstValue].none


## Compile-time truth value of an inline-for body condition.  The host lowers a
## bypass-sema body's `if` through `compile_time_const_value`, dropping the
## branches whose condition folds (`block.rb:606-652`).
function inline_for_eval_bool(ctx: ref[LowerCtx], cond: ptr[ast.Expr]) -> Option[bool]:
    unsafe:
        match read(cond):
            ast.Expr.expr_bool_literal as b:
                return Option[bool].some(value = b.value)
            ast.Expr.expr_unary_op as u:
                if u.operator == "not":
                    match inline_for_eval_bool(ctx, u.operand):
                        Option.some as v:
                            return Option[bool].some(value = not v.value)
                        Option.none:
                            pass
            ast.Expr.expr_binary_op as bin:
                if bin.operator == "==" or bin.operator == "!=":
                    match inline_for_eval_const(ctx, bin.left):
                        Option.some as lv:
                            match inline_for_eval_const(ctx, bin.right):
                                Option.some as rv:
                                    let eq = const_values_equal(lv.value, rv.value)
                                    if bin.operator == "==":
                                        return Option[bool].some(value = eq)
                                    return Option[bool].some(value = not eq)
                                Option.none:
                                    pass
                        Option.none:
                            pass
                if bin.operator == "and":
                    match inline_for_eval_bool(ctx, bin.left):
                        Option.some as lv:
                            if not lv.value:
                                return Option[bool].some(value = false)
                            return inline_for_eval_bool(ctx, bin.right)
                        Option.none:
                            pass
                if bin.operator == "or":
                    match inline_for_eval_bool(ctx, bin.left):
                        Option.some as lv:
                            if lv.value:
                                return Option[bool].some(value = true)
                            return inline_for_eval_bool(ctx, bin.right)
                        Option.none:
                            pass
            ast.Expr.expr_identifier:
                match inline_for_eval_const(ctx, cond):
                    Option.some as cv:
                        match cv.value:
                            ConstValue.cv_bool as b:
                                return Option[bool].some(value = b.value)
                            _:
                                pass
                    Option.none:
                        pass
            _:
                pass
    return Option[bool].none


## Fold an `if` chain inside an inline-for body: a constant-true branch lowers
## alone, constant-false branches are dropped, and a runtime condition (none of
## the above) falls back to the ordinary chain from that branch.
function lower_inline_for_if_fold(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], branches: span[ast.IfBranch], else_body: ptr[ast.Stmt]?) -> void:
    var bi: ptr_uint = 0
    while bi < branches.len:
        var br: ast.IfBranch
        unsafe:
            br = read(branches.data + bi)
        match inline_for_eval_bool(ctx, br.condition):
            Option.some as cv:
                if cv.value:
                    append_span_stmts(output, lower_block(ctx, br.body))
                    return
                bi += 1
            Option.none:
                var prior_false = map_mod.Map[str, types.Type].create()
                lower_if_chain_at(ctx, output, branches, bi, else_body, ref_of(prior_false), true)
                return
    append_span_stmts(output, lower_block(ctx, else_body))


## Compile-time value evaluation of a constant initializer to an IR constant
## expression.  Supports literals, module constants, `const function` calls, and
## struct/variant/array literals.  Returns none when the expression is not
## compile-time known, in which case the initializer is lowered normally.
function try_const_value_ir(ctx: ref[LowerCtx], ep: ptr[ast.Expr], env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    unsafe:
        match read(ep):
            ast.Expr.expr_integer_literal as lit:
                return Option[ptr[ir.Expr]].some(value = alloc_expr(integer_literal_expr(lit.lexeme, lit.value, types.primitive("int"))))
            ast.Expr.expr_float_literal as lit:
                return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_float_literal(value = lit.value, ty = types.primitive("float"))))
            ast.Expr.expr_bool_literal as b:
                return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = b.value, ty = ctx.bool_ty)))
            ast.Expr.expr_string_literal as s:
                return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_string_literal(value = s.value, ty = types.Type.ty_str, cstring = s.is_cstring)))
            ast.Expr.expr_char_literal as c:
                return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = long<-c.value, ty = types.primitive("ubyte"))))
            ast.Expr.expr_null_literal as nl:
                let tr = nl.target_type
                if tr != null:
                    let target = resolve_type_ref(ctx, tr)
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_null_literal(ty = types.Type.ty_null(target = types.alloc_type(target)))))
                return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_null_literal(ty = ctx.void_ty)))
            ast.Expr.expr_identifier as id:
                let entry = env.get(id.name)
                if entry != null:
                    return Option[ptr[ir.Expr]].some(value = unsafe: read(entry))
                let decl_val = find_const_value_ast(ctx, id.name)
                if decl_val != null:
                    match const_decl_type(ctx, id.name):
                        Option.some as dt:
                            return try_const_typed_value_ir(ctx, unsafe: ptr[ast.Expr]<-decl_val, env, dt.value)
                        Option.none:
                            pass
                    return try_const_value_ir(ctx, unsafe: ptr[ast.Expr]<-decl_val, env)
                if id.name == "true":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = ctx.bool_ty)))
                if id.name == "false":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = false, ty = ctx.bool_ty)))
                return Option[ptr[ir.Expr]].none
            ast.Expr.expr_binary_op as bin:
                match try_const_value_ir(ctx, bin.left, env):
                    Option.some as lv:
                        match try_const_value_ir(ctx, bin.right, env):
                            Option.some as rv:
                                return const_fold_binary_ir(ctx, bin.operator, lv.value, rv.value)
                            Option.none:
                                pass
                    Option.none:
                        pass
                return Option[ptr[ir.Expr]].none
            ast.Expr.expr_unary_op as un:
                match try_const_value_ir(ctx, un.operand, env):
                    Option.some as ov:
                        return const_fold_unary_ir(ctx, un.operator, ov.value)
                    Option.none:
                        pass
                return Option[ptr[ir.Expr]].none
            ast.Expr.expr_prefix_cast as pc:
                # An enum member is a compile-time integer, so its cast folds:
                # `int<-Kind.A` → 0 (`raylib/*`'s key tables are arrays of such
                # casts).  A bare enum member *reference* keeps its name — only
                # the cast fold consults the member's value.
                var operand_ir = try_const_value_ir(ctx, pc.expression, env)
                match operand_ir:
                    Option.some:
                        pass
                    Option.none:
                        match enum_member_value_of_expr(ctx, pc.expression):
                            Option.some as mv:
                                operand_ir = Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = mv.value, ty = types.primitive("int"))))
                            Option.none:
                                pass
                match operand_ir:
                    Option.some as ov:
                        let target = resolve_type_ref(ctx, pc.target_type)
                        var target_name = ""
                        var target_is_prim = false
                        match target:
                            types.Type.ty_primitive as tp:
                                target_is_prim = true
                                target_name = tp.name
                            _:
                                pass
                        if target_is_prim:
                            # Host `evaluate_prefix_cast`: numeric operands fold
                            # to the target type; anything else is not foldable.
                            var numeric = false
                            var value: long = 0
                            var fvalue: double = 0.0
                            var is_float_operand = false
                            match read(ov.value):
                                ir.Expr.expr_integer_literal as lit:
                                    numeric = true
                                    value = lit.value
                                ir.Expr.expr_float_literal as fl:
                                    numeric = true
                                    is_float_operand = true
                                    fvalue = fl.value
                                ir.Expr.expr_boolean_literal as b:
                                    numeric = true
                                    value = if b.value: 1 else: 0
                                _:
                                    pass
                            if numeric:
                                if target_name == "bool":
                                    let truth = if is_float_operand: fvalue != 0.0 else: value != 0
                                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = truth, ty = target)))
                                let width = const_integer_width(target_name)
                                if width > 0:
                                    var iv = if is_float_operand: long<-fvalue else: value
                                    iv = wrap_int_value(iv, width, types.is_signed_integer_name(target_name))
                                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = iv, ty = target)))
                                if target_name == "float" or target_name == "double":
                                    var dv = if is_float_operand: fvalue else: double<-value
                                    if target_name == "float":
                                        dv = float32_round(dv)
                                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_float_literal(value = dv, ty = target)))
                                return Option[ptr[ir.Expr]].none
                            return Option[ptr[ir.Expr]].none
                        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_cast(target_type = target, expression = ov.value, ty = target)))
                    Option.none:
                        pass
                return Option[ptr[ir.Expr]].none
            ast.Expr.expr_call as call:
                return try_const_call_ir(ctx, call.callee, call.args, env)
            ast.Expr.expr_index_access as ia:
                return try_const_index_ir(ctx, ia.receiver, ia.index, env)
            ast.Expr.expr_member_access as ma:
                return try_const_member_ir(ctx, ma.receiver, ma.member_name, env)
            ast.Expr.expr_expression_list as els:
                return try_const_tuple_ir(ctx, els.elements, env)
            ast.Expr.expr_if as iff:
                match const_env_eval_bool(ctx, env, iff.condition):
                    Option.some as cv:
                        if cv.value:
                            return try_const_value_ir(ctx, iff.then_expr, env)
                        return try_const_value_ir(ctx, iff.else_expr, env)
                    Option.none:
                        return Option[ptr[ir.Expr]].none
            ast.Expr.expr_match as m:
                match try_const_value_ir(ctx, m.scrutinee, env):
                    Option.some as sv:
                        var ai: ptr_uint = 0
                        while ai < m.arms.len:
                            var arm: ast.MatchExprArm
                            unsafe:
                                arm = read(m.arms.data + ai)
                            match const_match_pattern(ctx, env, arm.pattern, sv.value):
                                Option.some as matched:
                                    if matched.value:
                                        return try_const_value_ir(ctx, arm.value, env)
                                Option.none:
                                    return Option[ptr[ir.Expr]].none
                            ai += 1
                        return Option[ptr[ir.Expr]].none
                    Option.none:
                        return Option[ptr[ir.Expr]].none
            ast.Expr.expr_sizeof as sz:
                let target = resolve_type_ref(ctx, sz.target_type)
                match layout_size(ctx, target):
                    Option.some as v:
                        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = v.value, ty = types.primitive("ptr_uint"))))
                    Option.none:
                        return Option[ptr[ir.Expr]].none
            ast.Expr.expr_alignof as al:
                let target = resolve_type_ref(ctx, al.target_type)
                match layout_alignment(ctx, target):
                    Option.some as v:
                        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = v.value, ty = types.primitive("ptr_uint"))))
                    Option.none:
                        return Option[ptr[ir.Expr]].none
            ast.Expr.expr_offsetof as off:
                let target = resolve_type_ref(ctx, off.target_type)
                match layout_offset_of(ctx, target, off.field):
                    Option.some as v:
                        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = v.value, ty = types.primitive("ptr_uint"))))
                    Option.none:
                        return Option[ptr[ir.Expr]].none
            _:
                return Option[ptr[ir.Expr]].none
    return Option[ptr[ir.Expr]].none


## Integer width used when folding a prefix cast: the fixed-width primitives
## plus the pointer-sized integers (host `POINTER_INTEGER_WIDTH`).
function const_integer_width(name: str) -> int:
    if name == "ptr_int" or name == "ptr_uint":
        return 64
    return types.integer_width(name)


## Round a double to the nearest 32-bit float value (host `float32_round`).
function float32_round(value: double) -> double:
    let rounded = float<-value
    return double<-rounded


## Mask/sign-extend an integer to a fixed width (host `wrap_integer`).
function wrap_int_value(value: long, width: int, signed: bool) -> long:
    var mask: long = 0
    if width == 8:
        mask = 255
    else if width == 16:
        mask = 65535
    else if width == 32:
        mask = 4294967295
    else:
        return value
    var wrapped = value & mask
    if signed:
        if width == 8:
            if wrapped >= 128:
                wrapped = wrapped - 256
        else if width == 16:
            if wrapped >= 32768:
                wrapped = wrapped - 65536
        else:
            if wrapped >= 2147483648:
                wrapped = wrapped - 4294967296
    return wrapped


## True when an IR expression is a pure integer constant tree (literals under
## integer unary/binary operators), so a contextual retype cannot change names,
## calls or flag/enum members.
function ir_pure_integer_const(v: ir.Expr) -> bool:
    match v:
        ir.Expr.expr_integer_literal:
            return true
        ir.Expr.expr_unsigned_integer_literal:
            return true
        ir.Expr.expr_unary as u:
            if u.operator == "-" or u.operator == "~":
                return ir_pure_integer_const(unsafe: read(u.operand))
            return false
        ir.Expr.expr_binary as b:
            if is_pure_integer_operator(b.operator):
                return ir_pure_integer_const(unsafe: read(b.left)) and ir_pure_integer_const(unsafe: read(b.right))
            return false
        _:
            return false


function is_pure_integer_operator(operator: str) -> bool:
    if operator == "+" or operator == "-" or operator == "*" or operator == "/":
        return true
    if operator == "%" or operator == "&" or operator == "|" or operator == "^":
        return true
    return operator == "<<" or operator == ">>"


## Retype a pure integer constant tree to `target_ty` (the host's contextual
## inference of an enum member value against the backing type).
function retag_pure_integer_const(v: ir.Expr, target_ty: types.Type) -> ir.Expr:
    if not types.is_integer_type(target_ty) or not ir_pure_integer_const(v):
        return v
    match v:
        ir.Expr.expr_integer_literal as lit:
            return ir.Expr.expr_integer_literal(value = lit.value, ty = target_ty)
        ir.Expr.expr_unsigned_integer_literal as lit:
            return ir.Expr.expr_unsigned_integer_literal(value = lit.value, ty = target_ty)
        ir.Expr.expr_unary as u:
            return ir.Expr.expr_unary(operator = u.operator, operand = alloc_expr(retag_pure_integer_const(unsafe: read(u.operand), target_ty)), ty = target_ty)
        ir.Expr.expr_binary as b:
            return ir.Expr.expr_binary(operator = b.operator, left = alloc_expr(retag_pure_integer_const(unsafe: read(b.left), target_ty)), right = alloc_expr(retag_pure_integer_const(unsafe: read(b.right), target_ty)), ty = target_ty)
        _:
            return v


## Type a folded literal without masking it — the host's
## `lower_compile_time_literal` (a plain expression constant).
function retype_const_literal(v: ir.Expr, target_ty: types.Type) -> ir.Expr:
    if types.is_integer_type(target_ty):
        match v:
            ir.Expr.expr_integer_literal as lit:
                return ir.Expr.expr_integer_literal(value = lit.value, ty = target_ty)
            ir.Expr.expr_unsigned_integer_literal as lit:
                return ir.Expr.expr_unsigned_integer_literal(value = lit.value, ty = target_ty)
            _:
                pass
    if types.is_float_type(target_ty):
        match v:
            ir.Expr.expr_float_literal as lit:
                return ir.Expr.expr_float_literal(value = lit.value, ty = target_ty)
            _:
                pass
    return v


## True when a folded constant value can be represented by
## `lower_compile_time_literal` for `ty` — the host returns nil (falling back to
## the AST initializer) when an integer stands for a non-integer primitive such
## as `char`, or a value's shape does not fit.  Unknown shapes are accepted so
## the folding path is only abandoned where the host would abandon it.
function const_value_ir_representable(ctx: ref[LowerCtx], v: ir.Expr, ty: types.Type) -> bool:
    match ty:
        types.Type.ty_primitive as p:
            match v:
                ir.Expr.expr_boolean_literal:
                    return p.name == "bool"
                ir.Expr.expr_integer_literal:
                    return types.is_integer_type(ty) or types.is_float_type(ty)
                ir.Expr.expr_unsigned_integer_literal:
                    return types.is_integer_type(ty) or types.is_float_type(ty)
                ir.Expr.expr_float_literal:
                    return types.is_float_type(ty)
                ir.Expr.expr_string_literal:
                    return p.name == "cstr"
                _:
                    return false
        types.Type.ty_str:
            match v:
                ir.Expr.expr_string_literal:
                    return true
                _:
                    return false
        types.Type.ty_generic as g:
            if g.name == "array" and g.args.len == 2:
                let element_ty = unsafe: read(g.args.data + 0)
                match v:
                    ir.Expr.expr_array_literal as al:
                        var i: ptr_uint = 0
                        while i < al.elements.len:
                            if not const_value_ir_representable(ctx, unsafe: read(al.elements.data + i), element_ty):
                                return false
                            i += 1
                        return true
                    _:
                        return false
            return true
        types.Type.ty_named:
            pass
        types.Type.ty_imported:
            pass
        _:
            return true
    match v:
        ir.Expr.expr_aggregate_literal as ag:
            var i: ptr_uint = 0
            while i < ag.fields.len:
                let field = unsafe: read(ag.fields.data + i)
                match concrete_field_type(ctx, ty, field.name):
                    Option.some as ft:
                        if not const_value_ir_representable(ctx, unsafe: read(field.value), ft.value):
                            return false
                    Option.none:
                        pass
                i += 1
            return true
        _:
            return true


## The host's `rewrite_static_storage_initializer` fallback: lower the
## referenced imported constant's declaration initializer in its own module
## context (used when the folded value cannot be represented literally).
function lower_imported_const_initializer(ctx: ref[LowerCtx], ep: ptr[ast.Expr], expected_ty: types.Type) -> Option[ptr[ir.Expr]]:
    var target_module = ""
    var const_name = ""
    unsafe:
        match read(ep):
            ast.Expr.expr_member_access as ma:
                match read(ma.receiver):
                    ast.Expr.expr_identifier as id:
                        let mod_ptr = ctx.analysis.imports.get(id.name)
                        if mod_ptr == null:
                            return Option[ptr[ir.Expr]].none
                        target_module = read(mod_ptr)
                        const_name = ma.member_name
                    _:
                        return Option[ptr[ir.Expr]].none
            _:
                return Option[ptr[ir.Expr]].none
    let imported = find_imported_analysis(ctx, target_module) else:
        return Option[ptr[ir.Expr]].none
    var init_ast: ptr[ast.Expr]? = null
    var di: ptr_uint = 0
    while di < imported.source_file.declarations.len:
        unsafe:
            match read(imported.source_file.declarations.data + di):
                ast.Decl.decl_const as c:
                    if c.name == const_name:
                        init_ast = c.value
                _:
                    pass
        di += 1
    let init = init_ast else:
        return Option[ptr[ir.Expr]].none
    var saved_module = ctx.module_name
    var saved_analysis = ctx.analysis
    var saved_foreign = ctx.foreign_map
    var saved_variants = ctx.variants
    var saved_locals = ctx.locals
    var saved_counter = ctx.temp_counter
    var saved_subst = ctx.type_substitution
    var saved_inside = ctx.inside_async
    var saved_cps = ctx.async_cps_active
    var saved_completion = ctx.async_completion_active

    ctx.module_name = target_module
    ctx.analysis = imported
    ctx.foreign_map = map_mod.Map[str, ForeignInfo].create()
    ctx.variants = map_mod.Map[str, VariantInfo].create()
    ctx.locals = vec.Vec[LocalBinding].create()
    ctx.temp_counter = 0
    ctx.type_substitution = map_mod.Map[str, types.Type].create()
    ctx.inside_async = false
    ctx.async_cps_active = false
    ctx.async_completion_active = false
    collect_foreign_functions(ctx, imported.source_file.declarations)
    collect_variants(ctx, imported.source_file.declarations)
    install_prelude_variants(ctx)
    let lowered = lower_expr(ctx, init)
    let value = literal_value_to_context_type(ctx, init, expected_ty, lowered)

    ctx.module_name = saved_module
    ctx.analysis = saved_analysis
    ctx.foreign_map = saved_foreign
    ctx.variants = saved_variants
    ctx.locals = saved_locals
    ctx.temp_counter = saved_counter
    ctx.type_substitution = saved_subst
    ctx.inside_async = saved_inside
    ctx.async_cps_active = saved_cps
    ctx.async_completion_active = saved_completion
    return Option[ptr[ir.Expr]].some(value = value)


## Apply the host's declared-type coercion to a folded constant value
## (`lower_const_value_literal`): mask integers to the type's width,
## sign-extend signed types, and recurse into array elements.
function coerce_const_value(ctx: ref[LowerCtx], v: ir.Expr, target_ty: types.Type) -> ir.Expr:
    match target_ty:
        types.Type.ty_primitive as tp:
            let width = types.integer_width(tp.name)
            if width > 0 and width < 64:
                match v:
                    ir.Expr.expr_integer_literal as lit:
                        let masked = wrap_int_value(lit.value, width, types.is_signed_integer_name(tp.name))
                        return ir.Expr.expr_integer_literal(value = masked, ty = target_ty)
                    _:
                        pass
            match v:
                ir.Expr.expr_integer_literal as lit:
                    return ir.Expr.expr_integer_literal(value = lit.value, ty = target_ty)
                ir.Expr.expr_unsigned_integer_literal as lit:
                    # Keep the lexeme-derived unsigned rendering when the target is
                    # unsigned; a signed target (a program the host rejects) keeps
                    # the bit pattern so the emitted C stays a valid initializer.
                    if types.is_unsigned_integer_type(target_ty):
                        return ir.Expr.expr_unsigned_integer_literal(value = lit.value, ty = target_ty)
                    return ir.Expr.expr_integer_literal(value = long<-lit.value, ty = target_ty)
                ir.Expr.expr_float_literal as fl:
                    return ir.Expr.expr_float_literal(value = fl.value, ty = target_ty)
                _:
                    pass
        types.Type.ty_generic as tg:
            if tg.name == "array" and tg.args.len == 2:
                let element_ty = unsafe: read(tg.args.data + 0)
                match v:
                    ir.Expr.expr_array_literal as al:
                        var elements = vec.Vec[ir.Expr].create()
                        var i: ptr_uint = 0
                        while i < al.elements.len:
                            elements.push(coerce_const_value(ctx, unsafe: read(al.elements.data + i), element_ty))
                            i += 1
                        return ir.Expr.expr_array_literal(ty = target_ty, elements = elements.as_span())
                    _:
                        pass
        _:
            pass
    return v


## The host's `lower_const_value_literal` path for a constant whose value is an
## expression list or a call/specialization: when the declared type is a tuple
## the folded aggregate is emitted as an `IR::ArrayLiteral` whose element
## literals are all typed `int` — the host's fallback element type, since its
## `Types::Tuple` has no `arguments` to pick an element type from.
function const_tuple_array_literal(value: ir.Expr, ty: types.Type) -> Option[ir.Expr]:
    match ty:
        types.Type.ty_tuple:
            pass
        _:
            return Option[ir.Expr].none
    match value:
        ir.Expr.expr_aggregate_literal as ag:
            var elements = vec.Vec[ir.Expr].create()
            var i: ptr_uint = 0
            while i < ag.fields.len:
                let field = unsafe: read(ag.fields.data + i)
                match retype_int_element_literal(unsafe: read(field.value)):
                    Option.some as lit:
                        elements.push(lit.value)
                    Option.none:
                        return Option[ir.Expr].none
                i += 1
            return Option[ir.Expr].some(value = ir.Expr.expr_array_literal(ty = ty, elements = elements.as_span()))
        _:
            return Option[ir.Expr].none


## Re-type a folded element literal to `int` (the host's
## `lower_const_value_literal` fallback element type): integers are masked to
## the 32-bit width, other literal kinds keep their value under the `int` type.
function retype_int_element_literal(v: ir.Expr) -> Option[ir.Expr]:
    let int_ty = types.primitive("int")
    match v:
        ir.Expr.expr_integer_literal as lit:
            return Option[ir.Expr].some(value = ir.Expr.expr_integer_literal(value = wrap_int_value(lit.value, 32, true), ty = int_ty))
        ir.Expr.expr_unsigned_integer_literal as lit:
            return Option[ir.Expr].some(value = ir.Expr.expr_integer_literal(value = wrap_int_value(long<-lit.value, 32, true), ty = int_ty))
        ir.Expr.expr_float_literal as fl:
            return Option[ir.Expr].some(value = ir.Expr.expr_float_literal(value = fl.value, ty = int_ty))
        ir.Expr.expr_boolean_literal as b:
            return Option[ir.Expr].some(value = ir.Expr.expr_boolean_literal(value = b.value, ty = int_ty))
        ir.Expr.expr_string_literal as sl:
            return Option[ir.Expr].some(value = ir.Expr.expr_string_literal(value = sl.value, ty = int_ty, cstring = false))
        _:
            return Option[ir.Expr].none


## Compile-time layout of a type, mirroring Ruby's `Types::Layout` for the
## shapes this compiler models.  Used to fold `size_of` / `align_of` /
## `offset_of` in constant initializers exactly where the host does.
public struct LayoutInfo:
    size: long
    alignment: long


struct StructMeta:
    packed: bool
    alignment: long


function layout_align_up(value: long, alignment: long) -> long:
    if alignment <= 1:
        return value
    let remainder = value % alignment
    if remainder == 0:
        return value
    return value + alignment - remainder


## True when the host's `layout_pointer_like_nullable_base?` treats the base as
## a raw pointer for nullable layout purposes.
function layout_pointer_like(base: types.Type) -> bool:
    match base:
        types.Type.ty_function:
            return true
        types.Type.ty_opaque:
            return true
        types.Type.ty_primitive as tp:
            return tp.name == "cstr"
        types.Type.ty_generic as g:
            return g.name == "ptr" or g.name == "const_ptr" or g.name == "own" or g.name == "ref"
        _:
            return false


function layout_info(ctx: ref[LowerCtx], ty: types.Type) -> Option[LayoutInfo]:
    match ty:
        types.Type.ty_primitive as tp:
            if tp.name == "bool" or tp.name == "byte" or tp.name == "ubyte" or tp.name == "char":
                return Option[LayoutInfo].some(value = LayoutInfo(size = 1, alignment = 1))
            if tp.name == "short" or tp.name == "ushort":
                return Option[LayoutInfo].some(value = LayoutInfo(size = 2, alignment = 2))
            if tp.name == "int" or tp.name == "uint" or tp.name == "float":
                return Option[LayoutInfo].some(value = LayoutInfo(size = 4, alignment = 4))
            if tp.name == "long" or tp.name == "ulong" or tp.name == "double":
                return Option[LayoutInfo].some(value = LayoutInfo(size = 8, alignment = 8))
            if tp.name == "ptr_int" or tp.name == "ptr_uint" or tp.name == "cstr":
                return Option[LayoutInfo].some(value = LayoutInfo(size = 8, alignment = 8))
            return Option[LayoutInfo].none
        types.Type.ty_str:
            # `Types::StringView`: { ptr[char] data; ptr_uint len; }
            return Option[LayoutInfo].some(value = LayoutInfo(size = 16, alignment = 8))
        types.Type.ty_function:
            return Option[LayoutInfo].some(value = LayoutInfo(size = 8, alignment = 8))
        types.Type.ty_nullable as nl:
            let base = unsafe: read(nl.base)
            if layout_pointer_like(base):
                return Option[LayoutInfo].some(value = LayoutInfo(size = 8, alignment = 8))
            let inner = layout_info(ctx, base) else:
                return Option[LayoutInfo].none
            # struct { bool has_value; base value; }
            let value_offset = layout_align_up(1, inner.alignment)
            let overall = if inner.alignment > 1: inner.alignment else: 1
            return Option[LayoutInfo].some(value = LayoutInfo(
                size = layout_align_up(value_offset + inner.size, overall),
                alignment = overall,
            ))
        types.Type.ty_generic as g:
            if g.name == "ptr" or g.name == "const_ptr" or g.name == "own" or g.name == "ref":
                return Option[LayoutInfo].some(value = LayoutInfo(size = 8, alignment = 8))
            if g.name == "span" and g.args.len == 1:
                # `Types::Span`: { ptr[T] data; ptr_uint len; }
                return Option[LayoutInfo].some(value = LayoutInfo(size = 16, alignment = 8))
            if g.name == "array" and g.args.len == 2:
                let element = unsafe: read(g.args.data + 0)
                var count: long = 0
                match unsafe: read(g.args.data + 1):
                    types.Type.ty_literal_int as lit:
                        count = lit.value
                    _:
                        return Option[LayoutInfo].none
                let element_info = layout_info(ctx, element) else:
                    return Option[LayoutInfo].none
                return Option[LayoutInfo].some(value = LayoutInfo(
                    size = element_info.size * count,
                    alignment = element_info.alignment,
                ))
            if g.name == "str_buffer" and g.args.len == 1:
                var capacity: long = 0
                match unsafe: read(g.args.data + 0):
                    types.Type.ty_literal_int as lit:
                        capacity = lit.value + 1
                    _:
                        return Option[LayoutInfo].none
                # struct { char data[cap]; ptr_uint len; bool dirty; }
                var offset = capacity
                offset = layout_align_up(offset, 8)
                offset += 8
                offset += 1
                return Option[LayoutInfo].some(value = LayoutInfo(size = layout_align_up(offset, 8), alignment = 8))
            return Option[LayoutInfo].none
        types.Type.ty_imported as im:
            if im.args.len > 0:
                return Option[LayoutInfo].none
            match layout_struct_fields(ctx, im.module_name, im.name):
                Option.some as fields:
                    let meta = layout_struct_meta(ctx, im.module_name, im.name)
                    return layout_aggregate_info(ctx, fields.value, meta.packed, meta.alignment)
                Option.none:
                    return Option[LayoutInfo].none
        types.Type.ty_named as na:
            match layout_struct_fields(ctx, na.module_name, na.name):
                Option.some as fields:
                    let meta = layout_struct_meta(ctx, na.module_name, na.name)
                    return layout_aggregate_info(ctx, fields.value, meta.packed, meta.alignment)
                Option.none:
                    return Option[LayoutInfo].none
        _:
            return Option[LayoutInfo].none


## Field entries for a named struct: the current module first, then the
## declaring module of an imported type.
function layout_struct_fields(ctx: ref[LowerCtx], module_name: str, name: str) -> Option[span[analyzer.FieldEntry]]:
    if module_name.len == 0 or module_name == ctx.module_name:
        let local = ctx.analysis.structs.get(name)
        if local != null:
            return Option[span[analyzer.FieldEntry]].some(value = unsafe: read(local))
    match find_imported_analysis(ctx, module_name):
        Option.some as ia:
            let imported = ia.value.structs.get(name)
            if imported != null:
                return Option[span[analyzer.FieldEntry]].some(value = unsafe: read(imported))
        Option.none:
            pass
    return Option[span[analyzer.FieldEntry]].none


## `packed` / `alignment` of a named struct's declaration (defaults when the
## declaration is not found in the module's source file).
function layout_struct_meta(ctx: ref[LowerCtx], module_name: str, name: str) -> StructMeta:
    if module_name.len == 0 or module_name == ctx.module_name:
        return layout_struct_meta_of(ctx.analysis.source_file, name)
    match find_imported_analysis(ctx, module_name):
        Option.some as ia:
            return layout_struct_meta_of(ia.value.source_file, name)
        Option.none:
            return StructMeta(packed = false, alignment = 0)


function layout_struct_meta_of(sf: ast.SourceFile, name: str) -> StructMeta:
    var i: ptr_uint = 0
    while i < sf.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(sf.declarations.data + i)
        match d:
            ast.Decl.decl_struct as s:
                if s.name == name:
                    return StructMeta(packed = s.packed, alignment = s.alignment)
            _:
                pass
        i += 1
    return StructMeta(packed = false, alignment = 0)


## C struct layout for an ordered field list (host `struct_layout_from_infos`).
function layout_aggregate_info(ctx: ref[LowerCtx], fields: span[analyzer.FieldEntry], packed: bool, explicit_alignment: long) -> Option[LayoutInfo]:
    var offset: long = 0
    var natural_alignment: long = 1
    var i: ptr_uint = 0
    while i < fields.len:
        var f: analyzer.FieldEntry
        unsafe:
            f = read(fields.data + i)
        let info = layout_info(ctx, f.ty) else:
            return Option[LayoutInfo].none
        let effective = if packed: 1 else: info.alignment
        if effective > natural_alignment:
            natural_alignment = effective
        if not packed:
            offset = layout_align_up(offset, effective)
        offset += info.size
        i += 1
    let overall = if natural_alignment > explicit_alignment: natural_alignment else: explicit_alignment
    return Option[LayoutInfo].some(value = LayoutInfo(
        size = layout_align_up(offset, overall),
        alignment = overall,
    ))


function layout_size(ctx: ref[LowerCtx], ty: types.Type) -> Option[long]:
    match layout_info(ctx, ty):
        Option.some as info:
            return Option[long].some(value = info.value.size)
        Option.none:
            return Option[long].none


function layout_alignment(ctx: ref[LowerCtx], ty: types.Type) -> Option[long]:
    match layout_info(ctx, ty):
        Option.some as info:
            return Option[long].some(value = info.value.alignment)
        Option.none:
            return Option[long].none


## Byte offset of a field (host `Layout.offset_of`) for structs, spans, and
## str_buffers; unions and other shapes are not modelled.
function layout_offset_of(ctx: ref[LowerCtx], ty: types.Type, field: str) -> Option[long]:
    match ty:
        types.Type.ty_generic as g:
            if g.name == "span" and g.args.len == 1:
                if field == "data":
                    return Option[long].some(value = 0)
                if field == "len":
                    return Option[long].some(value = 8)
                return Option[long].none
            if g.name == "str_buffer" and g.args.len == 1:
                var capacity: long = 0
                match unsafe: read(g.args.data + 0):
                    types.Type.ty_literal_int as lit:
                        capacity = lit.value + 1
                    _:
                        return Option[long].none
                if field == "data":
                    return Option[long].some(value = 0)
                let len_offset = layout_align_up(capacity, 8)
                if field == "len":
                    return Option[long].some(value = len_offset)
                if field == "dirty":
                    return Option[long].some(value = len_offset + 8)
                return Option[long].none
            return Option[long].none
        types.Type.ty_imported as im:
            if im.args.len > 0:
                return Option[long].none
            match layout_struct_fields(ctx, im.module_name, im.name):
                Option.some as fields:
                    let meta = layout_struct_meta(ctx, im.module_name, im.name)
                    return layout_struct_field_offset(ctx, fields.value, meta.packed, field)
                Option.none:
                    return Option[long].none
        types.Type.ty_named as na:
            match layout_struct_fields(ctx, na.module_name, na.name):
                Option.some as fields:
                    let meta = layout_struct_meta(ctx, na.module_name, na.name)
                    return layout_struct_field_offset(ctx, fields.value, meta.packed, field)
                Option.none:
                    return Option[long].none
        _:
            return Option[long].none


function layout_struct_field_offset(ctx: ref[LowerCtx], fields: span[analyzer.FieldEntry], packed: bool, field: str) -> Option[long]:
    var offset: long = 0
    var i: ptr_uint = 0
    while i < fields.len:
        var f: analyzer.FieldEntry
        unsafe:
            f = read(fields.data + i)
        let info = layout_info(ctx, f.ty) else:
            return Option[long].none
        let effective = if packed: 1 else: info.alignment
        if not packed:
            offset = layout_align_up(offset, effective)
        if f.name == field:
            return Option[long].some(value = offset)
        offset += info.size
        i += 1
    return Option[long].none


## Constant-fold an expression whose declared type is known: an expression list
## `(a, b, c)` becomes an array literal when the target is `array[T, N]`.
function try_const_typed_value_ir(ctx: ref[LowerCtx], ep: ptr[ast.Expr], env: ref[map_mod.Map[str, ptr[ir.Expr]]], target_ty: types.Type) -> Option[ptr[ir.Expr]]:
    unsafe:
        match read(ep):
            ast.Expr.expr_null_literal as nl:
                # `null[T]` carries `Types::Null :target_type T`; a bare `null`
                # takes the constant's declared type (host expression lowering).
                let tr = nl.target_type
                if tr != null:
                    let target = resolve_type_ref(ctx, tr)
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_null_literal(ty = types.Type.ty_null(target = types.alloc_type(target)))))
                return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_null_literal(ty = target_ty)))
            _:
                pass
    match target_ty:
        types.Type.ty_primitive as tp:
            # A literal initializer takes the constant's declared type.  A
            # string literal declared as `cstr` becomes a C string literal.
            unsafe:
                match read(ep):
                    ast.Expr.expr_integer_literal as lit:
                        return Option[ptr[ir.Expr]].some(value = alloc_expr(integer_literal_expr(lit.lexeme, lit.value, target_ty)))
                    ast.Expr.expr_float_literal as lit:
                        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_float_literal(value = lit.value, ty = target_ty)))
                    ast.Expr.expr_char_literal as ch:
                        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = long<-ch.value, ty = target_ty)))
                    ast.Expr.expr_string_literal as sl:
                        let cs = sl.is_cstring or tp.name == "cstr"
                        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_string_literal(value = sl.value, ty = target_ty, cstring = cs)))
                    _:
                        pass
        types.Type.ty_generic as tg:
            if tg.name == "array" and tg.args.len == 2:
                let element_ty = unsafe: read(tg.args.data + 0)
                unsafe:
                    match read(ep):
                        ast.Expr.expr_expression_list as els:
                            var elements = vec.Vec[ir.Expr].create()
                            var i: ptr_uint = 0
                            while i < els.elements.len:
                                match try_const_typed_value_ir(ctx, els.elements.data + i, env, element_ty):
                                    Option.some as ev:
                                        elements.push(read(ev.value))
                                    Option.none:
                                        return Option[ptr[ir.Expr]].none
                                i += 1
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_array_literal(ty = target_ty, elements = elements.as_span())))
                        _:
                            pass
        _:
            pass
    return try_const_value_ir(ctx, ep, env)


## The declared type of a module-level constant, used to give expression-list
## initializers their declared array type when folding a reference to it.
function const_decl_type(ctx: ref[LowerCtx], name: str) -> Option[types.Type]:
    let decls = ctx.analysis.source_file.declarations
    var i: ptr_uint = 0
    while i < decls.len:
        unsafe:
            match read(decls.data + i):
                ast.Decl.decl_const as c:
                    if c.name == name:
                        return Option[types.Type].some(value = resolve_type_ref(ctx, c.const_type))
                _:
                    pass
        i += 1
    return Option[types.Type].none


function try_const_tuple_ir(ctx: ref[LowerCtx], elements: span[ast.Expr], env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    var values = vec.Vec[ir.Expr].create()
    var tys = vec.Vec[types.Type].create()
    var i: ptr_uint = 0
    while i < elements.len:
        match try_const_value_ir(ctx, unsafe: elements.data + i, env):
            Option.some as ev:
                values.push(unsafe: read(ev.value))
                tys.push(ir_expr_type(ev.value))
            Option.none:
                return Option[ptr[ir.Expr]].none
        i += 1
    var fields = vec.Vec[ir.AggregateField].create()
    var fi: ptr_uint = 0
    while fi < values.len():
        let vp = values.get(fi) else:
            return Option[ptr[ir.Expr]].none
        fields.push(ir.AggregateField(name = tuple_field_name(fi), value = vp))
        fi += 1
    let tup_ty = types.Type.ty_tuple(elements = tys.as_span(), field_names = Option[span[str]].none)
    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_aggregate_literal(ty = tup_ty, fields = fields.as_span())))


## Constant-fold `arr[i]`, `arr[a..b]`, `str[i]`, and `str[a..b]`.
function try_const_index_ir(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], index: ptr[ast.Expr], env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    match try_const_value_ir(ctx, receiver, env):
        Option.some as rv:
            unsafe:
                match read(index):
                    ast.Expr.expr_range as r:
                        let s_opt = const_env_eval_int(ctx, env, r.start_expr) else:
                            return Option[ptr[ir.Expr]].none
                        let e_opt = const_env_eval_int(ctx, env, r.end_expr) else:
                            return Option[ptr[ir.Expr]].none
                        match read(rv.value):
                            ir.Expr.expr_array_literal as al:
                                if s_opt < 0 or e_opt > long<-al.elements.len or s_opt > e_opt:
                                    return Option[ptr[ir.Expr]].none
                                var elements = vec.Vec[ir.Expr].create()
                                var i = s_opt
                                while i < e_opt:
                                    elements.push(read(al.elements.data + ptr_uint<-i))
                                    i += 1
                                return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_array_literal(ty = al.ty, elements = elements.as_span())))
                            ir.Expr.expr_string_literal as sl:
                                if s_opt < 0 or e_opt > long<-sl.value.len or s_opt > e_opt:
                                    return Option[ptr[ir.Expr]].none
                                let start = ptr_uint<-s_opt
                                let n = ptr_uint<-(e_opt - s_opt)
                                let sliced = str(data = sl.value.data + start, len = n)
                                return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_string_literal(value = sliced, ty = types.Type.ty_str, cstring = false)))
                            _:
                                return Option[ptr[ir.Expr]].none
                    _:
                        pass
            let idx_opt = const_env_eval_int(ctx, env, index) else:
                return Option[ptr[ir.Expr]].none
            unsafe:
                match read(rv.value):
                    ir.Expr.expr_array_literal as al:
                        if idx_opt < 0 or idx_opt >= long<-al.elements.len:
                            return Option[ptr[ir.Expr]].none
                        return Option[ptr[ir.Expr]].some(value = al.elements.data + ptr_uint<-idx_opt)
                    ir.Expr.expr_string_literal as sl:
                        if idx_opt < 0 or idx_opt >= long<-sl.value.len:
                            return Option[ptr[ir.Expr]].none
                        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = long<-sl.value.byte_at(ptr_uint<-idx_opt), ty = types.primitive("ubyte"))))
                    _:
                        return Option[ptr[ir.Expr]].none
        Option.none:
            return Option[ptr[ir.Expr]].none
    return Option[ptr[ir.Expr]].none


## Constant-fold member access: struct fields, `len` on strings/arrays, and
## parenthesized-less variant arms (`Option[int].none`).
## Resolve `alias.MEMBER` where `alias` is an import and `MEMBER` is a constant
## declared in the imported module (e.g. `c.EOF` in `std/stdio.mt`).  The
## initializer is evaluated in the imported module's own context, mirroring the
## host's cross-module constant resolution.
function imported_const_value_ir(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], member: str, env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    var alias: str
    unsafe:
        match read(receiver):
            ast.Expr.expr_identifier as rid:
                alias = rid.name
            _:
                return Option[ptr[ir.Expr]].none
    let target_ptr = ctx.analysis.imports.get(alias)
    if target_ptr == null:
        return Option[ptr[ir.Expr]].none
    let target_module = unsafe: read(target_ptr)
    let owner_a = find_imported_analysis(ctx, target_module) else:
        return Option[ptr[ir.Expr]].none
    var saved_module = ctx.module_name
    var saved_analysis = ctx.analysis
    ctx.module_name = owner_a.module_name
    ctx.analysis = owner_a
    var result = Option[ptr[ir.Expr]].none
    let decl_val = find_const_value_ast(ctx, member)
    if decl_val != null:
        var empty_env = map_mod.Map[str, ptr[ir.Expr]].create()
        match const_decl_type(ctx, member):
            Option.some as dt:
                result = try_const_typed_value_ir(ctx, unsafe: ptr[ast.Expr]<-decl_val, ref_of(empty_env), dt.value)
            Option.none:
                result = try_const_value_ir(ctx, unsafe: ptr[ast.Expr]<-decl_val, ref_of(empty_env))
    ctx.module_name = saved_module
    ctx.analysis = saved_analysis
    return result


function try_const_member_ir(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], member: str, env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    match imported_const_value_ir(ctx, receiver, member, env):
        Option.some as imported:
            return Option[ptr[ir.Expr]].some(value = imported.value)
        Option.none:
            pass
    unsafe:
        match read(receiver):
            ast.Expr.expr_specialization as spec:
                match read(spec.callee):
                    ast.Expr.expr_identifier as sid:
                        if ctx.variants.contains(sid.name):
                            return try_const_variant_literal_ir(ctx, sid.name, member, span[ast.Argument](), env)
                    _:
                        pass
            _:
                pass
    match try_const_value_ir(ctx, receiver, env):
        Option.some as rv:
            unsafe:
                match read(rv.value):
                    ir.Expr.expr_aggregate_literal as ag:
                        return const_field_value(ag.fields, member)
                    ir.Expr.expr_string_literal as sl:
                        if member == "len":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = long<-sl.value.len, ty = types.primitive("int"))))
                    ir.Expr.expr_array_literal as al:
                        if member == "len":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = long<-al.elements.len, ty = types.primitive("int"))))
                    _:
                        pass
        Option.none:
            pass
    return Option[ptr[ir.Expr]].none


function const_fold_binary_ir(ctx: ref[LowerCtx], op: str, l: ptr[ir.Expr], r: ptr[ir.Expr]) -> Option[ptr[ir.Expr]]:
    let int_ty = types.primitive("int")
    let float_ty = types.primitive("float")
    unsafe:
        match read(l):
            ir.Expr.expr_integer_literal as li:
                match read(r):
                    ir.Expr.expr_integer_literal as ri:
                        let result = apply_int_op(op, li.value, ri.value)
                        if is_comparison_operator(op):
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = result != 0, ty = ctx.bool_ty)))
                        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = result, ty = int_ty)))
                    ir.Expr.expr_float_literal as rf:
                        return const_fold_float_ir(ctx, op, double<-li.value, rf.value)
                    _:
                        return Option[ptr[ir.Expr]].none
            ir.Expr.expr_float_literal as lf:
                match read(r):
                    ir.Expr.expr_float_literal as rf:
                        return const_fold_float_ir(ctx, op, lf.value, rf.value)
                    ir.Expr.expr_integer_literal as ri:
                        return const_fold_float_ir(ctx, op, lf.value, double<-ri.value)
                    _:
                        return Option[ptr[ir.Expr]].none
            ir.Expr.expr_string_literal as ls:
                match read(r):
                    ir.Expr.expr_string_literal as rs:
                        if op == "+":
                            var buf = string.String.create()
                            buf.append(ls.value)
                            buf.append(rs.value)
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_string_literal(value = buf.as_str(), ty = types.Type.ty_str, cstring = false)))
                        if op == "==":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = ls.value == rs.value, ty = ctx.bool_ty)))
                        if op == "!=":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = ls.value != rs.value, ty = ctx.bool_ty)))
                    _:
                        return Option[ptr[ir.Expr]].none
            ir.Expr.expr_boolean_literal as lb:
                match read(r):
                    ir.Expr.expr_boolean_literal as rb:
                        if op == "and":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = lb.value and rb.value, ty = ctx.bool_ty)))
                        if op == "or":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = lb.value or rb.value, ty = ctx.bool_ty)))
                        if op == "==":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = lb.value == rb.value, ty = ctx.bool_ty)))
                        if op == "!=":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = lb.value != rb.value, ty = ctx.bool_ty)))
                    _:
                        return Option[ptr[ir.Expr]].none
            _:
                return Option[ptr[ir.Expr]].none
    return Option[ptr[ir.Expr]].none


function const_fold_float_ir(ctx: ref[LowerCtx], op: str, l: double, r: double) -> Option[ptr[ir.Expr]]:
    var result: double = 0.0
    if op == "+":
        result = l + r
    else if op == "-":
        result = l - r
    else if op == "*":
        result = l * r
    else if op == "/":
        result = l / r
    else if op == "==":
        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = l == r, ty = ctx.bool_ty)))
    else if op == "!=":
        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = l != r, ty = ctx.bool_ty)))
    else if op == "<":
        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = l < r, ty = ctx.bool_ty)))
    else if op == "<=":
        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = l <= r, ty = ctx.bool_ty)))
    else if op == ">":
        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = l > r, ty = ctx.bool_ty)))
    else if op == ">=":
        return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = l >= r, ty = ctx.bool_ty)))
    else:
        return Option[ptr[ir.Expr]].none
    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_float_literal(value = result, ty = types.primitive("float"))))


function const_fold_unary_ir(ctx: ref[LowerCtx], op: str, operand: ptr[ir.Expr]) -> Option[ptr[ir.Expr]]:
    unsafe:
        match read(operand):
            ir.Expr.expr_integer_literal as li:
                if op == "-":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = -li.value, ty = li.ty)))
                if op == "~":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_integer_literal(value = ~li.value, ty = li.ty)))
                return Option[ptr[ir.Expr]].none
            ir.Expr.expr_float_literal as lf:
                if op == "-":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_float_literal(value = -lf.value, ty = lf.ty)))
                return Option[ptr[ir.Expr]].none
            ir.Expr.expr_boolean_literal as lb:
                if op == "not":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = not lb.value, ty = ctx.bool_ty)))
                return Option[ptr[ir.Expr]].none
            _:
                return Option[ptr[ir.Expr]].none
    return Option[ptr[ir.Expr]].none


## Evaluate a call in constant position: struct literals, variant-arm literals,
## `const function` calls, and `const` methods (static and instance).
function try_const_call_ir(ctx: ref[LowerCtx], callee: ptr[ast.Expr], args: span[ast.Argument], env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    unsafe:
        match read(callee):
            ast.Expr.expr_identifier as id:
                # A struct of this module, or a local type alias re-exporting one
                # (`type Color = c.Color`), constructs an aggregate literal.
                match const_aggregate_target_type(ctx, ctx.module_name, id.name):
                    Option.some as target:
                        return try_const_struct_literal_ir(ctx, target.value, args, env)
                    Option.none:
                        pass
                return try_const_function_value(ctx, id.name, args, env)
            ast.Expr.expr_specialization as bare_spec:
                match read(bare_spec.callee):
                    ast.Expr.expr_identifier as bsid:
                        if bsid.name == "array":
                            return try_const_array_literal_ir(ctx, bare_spec.arguments, args, env)
                        if bsid.name == "attribute_arg":
                            return try_const_attribute_arg_ir(ctx, bare_spec.arguments, args, env)
                    _:
                        pass
                return Option[ptr[ir.Expr]].none
            ast.Expr.expr_member_access as ma:
                match read(ma.receiver):
                    ast.Expr.expr_identifier as rid:
                        if ctx.variants.contains(rid.name):
                            return try_const_variant_literal_ir(ctx, rid.name, ma.member_name, args, env)
                        if ctx.analysis.structs.contains(rid.name):
                            return try_const_method_value(ctx, env, rid.name, ma.member_name, Option[ptr[ir.Expr]].none, args)
                        # Qualified struct literal through an import alias
                        # (`rl.Color(r = …)`), which the bare-name branch above
                        # already handles for an unqualified `Color(r = …)`.
                        # The member may be a type alias re-exporting a struct
                        # (`type Color = c.Color`), so the target resolves through
                        # the alias chain like the runtime construction path.
                        let alias_module_ptr = ctx.analysis.imports.get(rid.name)
                        if alias_module_ptr != null:
                            match const_aggregate_target_type(ctx, read(alias_module_ptr), ma.member_name):
                                Option.some as target:
                                    return try_const_struct_literal_ir(ctx, target.value, args, env)
                                Option.none:
                                    pass
                    ast.Expr.expr_specialization as spec:
                        match read(spec.callee):
                            ast.Expr.expr_identifier as sid:
                                if ctx.variants.contains(sid.name):
                                    return try_const_variant_literal_ir(ctx, sid.name, ma.member_name, args, env)
                                if sid.name == "array":
                                    return try_const_array_literal_ir(ctx, spec.arguments, args, env)
                            _:
                                pass
                    ast.Expr.expr_member_access as inner_ma:
                        # Qualified receiver: `alias.Type.method(...)` — the
                        # extending block declaring the const method names the
                        # type through the same import alias, so the bare type
                        # name is what `try_const_method_value` matches on.
                        match read(inner_ma.receiver):
                            ast.Expr.expr_identifier as alias_id:
                                if ctx.analysis.imports.contains(alias_id.name):
                                    if ctx.variants.contains(inner_ma.member_name):
                                        return try_const_variant_literal_ir(ctx, inner_ma.member_name, ma.member_name, args, env)
                                    return try_const_method_value(ctx, env, inner_ma.member_name, ma.member_name, Option[ptr[ir.Expr]].none, args)
                            _:
                                pass
                    _:
                        pass
                # Instance method on a compile-time value (`RECT.area()`,
                # `this.area()` inside a const method body).
                match try_const_value_ir(ctx, ma.receiver, env):
                    Option.some as rv:
                        match const_receiver_struct_name(rv.value):
                            Option.some as sn:
                                return try_const_method_value(ctx, env, sn.value, ma.member_name, Option[ptr[ir.Expr]].some(value = rv.value), args)
                            Option.none:
                                pass
                    Option.none:
                        pass
                return Option[ptr[ir.Expr]].none
            _:
                return Option[ptr[ir.Expr]].none
    return Option[ptr[ir.Expr]].none


## The struct name of a compile-time receiver value (its IR type's simple name).
function const_receiver_struct_name(value: ptr[ir.Expr]) -> Option[str]:
    match ir_expr_type(value):
        types.Type.ty_named as n:
            return Option[str].some(value = n.name)
        types.Type.ty_imported as im:
            return Option[str].some(value = im.name)
        _:
            return Option[str].none
    return Option[str].none


## Evaluate a `const` method call by binding `this` (for instance methods) and
## the parameters, then interpreting the method body.
function try_const_method_value(ctx: ref[LowerCtx], caller_env: ref[map_mod.Map[str, ptr[ir.Expr]]], struct_name: str, method_name: str, receiver: Option[ptr[ir.Expr]], args: span[ast.Argument]) -> Option[ptr[ir.Expr]]:
    let decls = ctx.analysis.source_file.declarations
    var i: ptr_uint = 0
    while i < decls.len:
        unsafe:
            match read(decls.data + i):
                ast.Decl.decl_extending_block as ex:
                    let type_ref = read(ex.type_name)
                    if qname_last(type_ref.name) == struct_name:
                        var mi: ptr_uint = 0
                        while mi < ex.methods.len:
                            var m: ast.Method
                            m = read(ex.methods.data + mi)
                            if m.name == method_name and m.is_const and m.method_params.len == args.len:
                                var env = map_mod.Map[str, ptr[ir.Expr]].create()
                                match receiver:
                                    Option.some as rv:
                                        env.set("this", rv.value)
                                    Option.none:
                                        pass
                                var j: ptr_uint = 0
                                while j < args.len:
                                    match try_const_value_ir(ctx, read(args.data + j).arg_value, caller_env):
                                        Option.some as av:
                                            env.set(read(m.method_params.data + j).name, av.value)
                                        Option.none:
                                            return Option[ptr[ir.Expr]].none
                                    j += 1
                                return try_const_value_body(ctx, m.body, ref_of(env))
                            mi += 1
                _:
                    pass
        i += 1
    return Option[ptr[ir.Expr]].none


## Evaluate an `array[T, N](a, b, ...)` constructor to an array literal.
function try_const_array_literal_ir(ctx: ref[LowerCtx], type_args: span[ast.TypeArgument], args: span[ast.Argument], env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    if type_args.len != 2:
        return Option[ptr[ir.Expr]].none
    let element_ty = resolve_type_ref(ctx, unsafe: read(type_args.data + 0).value)
    var array_args = vec.Vec[types.Type].create()
    unsafe:
        array_args.push(element_ty)
        array_args.push(resolve_array_length_type(ctx, read(type_args.data + 1).value))
    let array_ty = types.Type.ty_generic(name = "array", args = array_args.as_span())
    var elements = vec.Vec[ir.Expr].create()
    var i: ptr_uint = 0
    while i < args.len:
        # An *enum member* element of an mt-declared enum folds to its value
        # typed as the enum: `const KINDS: array[TokenKind, 19] =
        # array[…]((TokenKind.dot_dot, …))` carries
        # `(IR::IntegerLiteral :value 33 :type (Types::Enum TokenKind))`.  A
        # *runtime* array literal keeps its member names, and a *raw* module's
        # enum keeps them too (the host cannot know the C values; session 44,
        # item 9a).
        let arg_ast = unsafe: read(args.data + i).arg_value
        match enum_member_value_of_expr(ctx, arg_ast):
            Option.some as mv:
                elements.push(unsafe: read(alloc_expr(ir.Expr.expr_integer_literal(value = mv.value, ty = element_ty))))
            Option.none:
                match try_const_value_ir(ctx, arg_ast, env):
                    Option.some as ev:
                        # Elements take the element type contextually too: a folded
                        # `array[ubyte, 4](0, 0, 0, 0)` keeps ubyte elements.
                        let retyped = const_value_to_field_type(ev.value, element_ty)
                        elements.push(unsafe: read(retyped))
                    Option.none:
                        return Option[ptr[ir.Expr]].none
        i += 1
    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_array_literal(ty = array_ty, elements = elements.as_span())))


## Fold `attribute_arg[T](attribute_of(field_of(Type, field), attr), name)`.  The
## attribute application is read from the field's AST and its argument named
## `name` is returned.  (The self-host reflection is limited to this pattern,
## matching the corpus usage.)
function try_const_attribute_arg_ir(ctx: ref[LowerCtx], type_args: span[ast.TypeArgument], args: span[ast.Argument], env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    if type_args.len != 1 or args.len != 2:
        return Option[ptr[ir.Expr]].none
    let type_ty = resolve_type_ref(ctx, unsafe: read(type_args.data + 0).value)
    let arg_name = comptime_arg_name(unsafe: args.data + 1)
    if arg_name.len == 0:
        return Option[ptr[ir.Expr]].none
    # Unwrap `attribute_of(field_of(Type, field), attr)` to (type, field, attr).
    let attr_call = unsafe: read(args.data + 0).arg_value
    let attr_ident = comptime_inner_arg_name(attr_call, "attribute_of", 1)
    if attr_ident.len == 0:
        return Option[ptr[ir.Expr]].none
    let field_call = comptime_inner_arg_expr(attr_call, "attribute_of", 0)
    if field_call == null:
        return Option[ptr[ir.Expr]].none
    let field_call_ptr = ptr[ast.Expr]<-field_call
    let type_name = comptime_inner_arg_name(field_call_ptr, "field_of", 0)
    let field_name = comptime_inner_arg_name(field_call_ptr, "field_of", 1)
    if type_name.len == 0 or field_name.len == 0:
        return Option[ptr[ir.Expr]].none
    return lookup_attribute_arg_literal(ctx, type_name, field_name, attr_ident, arg_name, type_ty)


## The name of argument `index` of a call expression `callee_name(...)`, or "".
## The argument's value must be an identifier or string literal.
function comptime_inner_arg_name(ep: ptr[ast.Expr], callee_name: str, index: ptr_uint) -> str:
    unsafe:
        match read(ep):
            ast.Expr.expr_call as ac:
                match read(ac.callee):
                    ast.Expr.expr_identifier as acid:
                        if acid.name == callee_name and ac.args.len > index:
                            let val = read(ac.args.data + index).arg_value
                            match read(val):
                                ast.Expr.expr_identifier as v:
                                    return v.name
                                ast.Expr.expr_string_literal as s:
                                    return s.value
                                _:
                                    pass
                    _:
                        pass
            _:
                pass
    return ""


## The expression of argument `index` of a call `callee_name(...)`, or null.
function comptime_inner_arg_expr(ep: ptr[ast.Expr], callee_name: str, index: ptr_uint) -> ptr[ast.Expr]?:
    unsafe:
        match read(ep):
            ast.Expr.expr_call as ac:
                match read(ac.callee):
                    ast.Expr.expr_identifier as acid:
                        if acid.name == callee_name and ac.args.len > index:
                            return read(ac.args.data + index).arg_value
                    _:
                        pass
            _:
                pass
    return null


## The IR literal for attribute argument `arg_name` of `@[attr(...)]` applied to
## `Type.field`, if present.
function lookup_attribute_arg_literal(ctx: ref[LowerCtx], type_name: str, field_name: str, attr_name: str, arg_name: str, ty: types.Type) -> Option[ptr[ir.Expr]]:
    var di: ptr_uint = 0
    while di < ctx.analysis.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(ctx.analysis.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_struct as s:
                if s.name == type_name:
                    var fi: ptr_uint = 0
                    while fi < s.struct_fields.len:
                        var f: ast.Field
                        unsafe:
                            f = read(s.struct_fields.data + fi)
                        if f.name == field_name:
                            let found = attribute_apps_arg_literal(ctx, f.attributes, attr_name, arg_name, ty)
                            if found.is_some():
                                return found
                        fi += 1
            _:
                pass
        di += 1
    return Option[ptr[ir.Expr]].none


## Search a field's attribute applications for `@[attr_name(...)]` and return the
## IR literal for its argument `arg_name`.
function attribute_apps_arg_literal(ctx: ref[LowerCtx], apps: span[ast.AttributeApplication], attr_name: str, arg_name: str, ty: types.Type) -> Option[ptr[ir.Expr]]:
    var ai: ptr_uint = 0
    while ai < apps.len:
        var app: ast.AttributeApplication
        unsafe:
            app = read(apps.data + ai)
        if app.name.parts.len == 1:
            let app_name = unsafe: read(app.name.parts.data + 0)
            if app_name == attr_name:
                # Explicitly named arguments take precedence.
                var argi: ptr_uint = 0
                while argi < app.arguments.len:
                    var app_arg: ast.Argument
                    unsafe:
                        app_arg = read(app.arguments.data + argi)
                    match app_arg.arg_name:
                        Option.some as an:
                            if an.value == arg_name:
                                return attribute_arg_value_to_ir(ctx, app_arg.arg_value, ty)
                        Option.none:
                            pass
                    argi += 1
                # Positional argument: match against the attribute declaration's
                # parameter list to find the parameter named `arg_name`.
                match attribute_param_index(ctx, attr_name, arg_name):
                    Option.some as idx:
                        if idx.value < app.arguments.len:
                            let app_arg = unsafe: read(app.arguments.data + idx.value)
                            return attribute_arg_value_to_ir(ctx, app_arg.arg_value, ty)
                    Option.none:
                        pass
        ai += 1
    return Option[ptr[ir.Expr]].none


## The positional index of parameter `param_name` in the attribute declaration
## `attribute[...] <attr_name>(<params>)`, or none.
function attribute_param_index(ctx: ref[LowerCtx], attr_name: str, param_name: str) -> Option[ptr_uint]:
    var di: ptr_uint = 0
    while di < ctx.analysis.source_file.declarations.len:
        var d: ast.Decl
        unsafe:
            d = read(ctx.analysis.source_file.declarations.data + di)
        match d:
            ast.Decl.decl_attribute as a:
                if a.name == attr_name:
                    var pi: ptr_uint = 0
                    while pi < a.attr_params.len:
                        var p: ast.Param
                        unsafe:
                            p = read(a.attr_params.data + pi)
                        if p.name == param_name:
                            return Option[ptr_uint].some(value = pi)
                        pi += 1
            _:
                pass
        di += 1
    return Option[ptr_uint].none


function attribute_arg_value_to_ir(ctx: ref[LowerCtx], ep: ptr[ast.Expr], ty: types.Type) -> Option[ptr[ir.Expr]]:
    let result_ty = if types.is_error(ty): types.Type.ty_str else: ty
    unsafe:
        match read(ep):
            ast.Expr.expr_string_literal as s:
                return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_string_literal(value = s.value, ty = result_ty, cstring = s.is_cstring)))
            ast.Expr.expr_integer_literal as lit:
                return Option[ptr[ir.Expr]].some(value = alloc_expr(integer_literal_expr(lit.lexeme, lit.value, result_ty)))
            ast.Expr.expr_bool_literal as b:
                return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_boolean_literal(value = b.value, ty = result_ty)))
            _:
                pass
    return Option[ptr[ir.Expr]].none


## Resolve the struct a constant aggregate constructor names, following the same
## alias routing the runtime construction path uses
## (`lower_aggregate_literal_impl`): `rl.Color(r = 1)` with
## `type Color = c.Color` in std.raylib constructs std.c.raylib's struct Color,
## so the folded literal carries that type and its field types come from it.
function const_aggregate_target_type(ctx: ref[LowerCtx], owner_module: str, name: str) -> Option[types.Type]:
    match find_imported_analysis(ctx, owner_module):
        Option.some as owner:
            if owner.value.structs.contains(name):
                if owner_module == ctx.module_name:
                    return Option[types.Type].some(value = types.Type.ty_named(linkage_name = Option[str].none, module_name = ctx.module_name, name = name))
                return Option[types.Type].some(value = types.Type.ty_imported(module_name = owner_module, name = name, args = span[types.Type]()))
            let alias_ptr = owner.value.type_alias_types.get(name)
            if alias_ptr != null:
                var base = unsafe: read(alias_ptr)
                if types.is_nullable_type(base):
                    base = types.unwrap_nullable(base)
                match const_struct_alias_target(ctx, base):
                    Option.some as target:
                        return Option[types.Type].some(value = target.value)
                    Option.none:
                        pass
        Option.none:
            pass
    return Option[types.Type].none


## The struct a type alias re-exports (`type Color = c.Color` names std.c.raylib's
## struct Color).  Only a struct target is an aggregate constructor; an alias of
## an enum/flags/opaque is not folded.
function const_struct_alias_target(ctx: ref[LowerCtx], t: types.Type) -> Option[types.Type]:
    match t:
        types.Type.ty_named as nm:
            if nm.module_name.len == 0 or nm.module_name == ctx.module_name:
                if ctx.analysis.structs.contains(nm.name):
                    return Option[types.Type].some(value = t)
                return Option[types.Type].none
            match find_imported_analysis(ctx, nm.module_name):
                Option.some as owner:
                    if owner.value.structs.contains(nm.name):
                        return Option[types.Type].some(value = t)
                Option.none:
                    pass
            return Option[types.Type].none
        types.Type.ty_imported as im:
            match find_imported_analysis(ctx, im.module_name):
                Option.some as owner:
                    if owner.value.structs.contains(im.name):
                        return Option[types.Type].some(value = t)
                Option.none:
                    pass
            return Option[types.Type].none
        _:
            return Option[types.Type].none
    return Option[types.Type].none


## Re-type a folded constant value by the type of the aggregate field it
## initializes, mirroring the host's `lower_compile_time_literal`
## (`lowering/utils.rb:361-395`): the interpreted value carries no type of its
## own, so the field decides the literal's kind — `hex_digit(c) * 16 +
## hex_digit(c)` folds to a `ubyte` literal in a `ubyte` field, and an integer
## value in a `float` field becomes a float literal.
function const_value_to_field_type(value: ptr[ir.Expr], field_ty: types.Type) -> ptr[ir.Expr]:
    var target = field_ty
    if types.is_nullable_type(target):
        target = types.unwrap_nullable(target)
    # The host recurses into an array target (`lower_compile_time_literal`'s
    # Array case): each element takes the *element* type, so a zeroed
    # `array[ubyte, 4](0, 0, 0, 0)` field keeps ubyte elements.
    match target:
        types.Type.ty_generic as ag:
            if ag.name == "array" and ag.args.len == 2:
                let element_ty = unsafe: read(ag.args.data + 0)
                unsafe:
                    match read(value):
                        ir.Expr.expr_array_literal as al:
                            var elements = vec.Vec[ir.Expr].create()
                            var ei: ptr_uint = 0
                            while ei < al.elements.len:
                                let retyped = const_value_to_field_type(alloc_expr(read(al.elements.data + ei)), element_ty)
                                elements.push(unsafe: read(retyped))
                                ei += 1
                            return alloc_expr(ir.Expr.expr_array_literal(ty = target, elements = elements.as_span()))
                        _:
                            pass
        _:
            pass
    var target_is_str = false
    var target_is_cstr = false
    match target:
        types.Type.ty_str:
            target_is_str = true
        types.Type.ty_primitive as p:
            if p.name == "str" or p.name == "cstr":
                target_is_str = true
            target_is_cstr = p.name == "cstr"
        _:
            pass
    unsafe:
        match read(value):
            ir.Expr.expr_integer_literal as lit:
                if types.is_integer_type(target):
                    return alloc_expr(ir.Expr.expr_integer_literal(value = lit.value, ty = target))
                if types.is_float_type(target):
                    return alloc_expr(ir.Expr.expr_float_literal(value = double<-lit.value, ty = target))
            ir.Expr.expr_float_literal as fl:
                if types.is_float_type(target):
                    return alloc_expr(ir.Expr.expr_float_literal(value = fl.value, ty = target))
            ir.Expr.expr_boolean_literal as b:
                if types.is_bool(target):
                    return alloc_expr(ir.Expr.expr_boolean_literal(value = b.value, ty = target))
            ir.Expr.expr_string_literal as s:
                if target_is_str:
                    return alloc_expr(ir.Expr.expr_string_literal(value = s.value, ty = target, cstring = target_is_cstr))
            _:
                pass
    return value


## Fold a struct construction into an aggregate literal of `target`'s type.  The
## target is the struct the constructor names, resolved through its alias chain
## by `const_aggregate_target_type`, so the fields come from the declaring module.
function try_const_struct_literal_ir(ctx: ref[LowerCtx], target: types.Type, args: span[ast.Argument], env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    var struct_name = ""
    var field_module = ctx.module_name
    match target:
        types.Type.ty_named as nm:
            struct_name = nm.name
            field_module = nm.module_name
        types.Type.ty_imported as im:
            struct_name = im.name
            field_module = im.module_name
        _:
            return Option[ptr[ir.Expr]].none
    var fields = vec.Vec[ir.AggregateField].create()
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        let field_name = arg.arg_name else:
            return Option[ptr[ir.Expr]].none
        match try_const_value_ir(ctx, arg.arg_value, env):
            Option.some as fv:
                # Folded constants must still carry the *field's* type: the
                # folder types an integer literal `int`, while the host renders
                # e.g. `LIGHTGRAY`'s fields as `ubyte`.
                var field_value = fv.value
                match find_struct_field_type(ctx, struct_name, field_module, field_name):
                    Option.some as field_ty:
                        field_value = int_literal_to_context_type(arg.arg_value, field_ty.value, field_value)
                        field_value = null_literal_to_context_type(arg.arg_value, field_ty.value, field_value)
                        field_value = const_value_to_field_type(field_value, field_ty.value)
                    Option.none:
                        pass
                fields.push(ir.AggregateField(name = field_name, value = field_value))
            Option.none:
                return Option[ptr[ir.Expr]].none
        i += 1
    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_aggregate_literal(ty = target, fields = fields.as_span())))


function try_const_variant_literal_ir(ctx: ref[LowerCtx], variant_name: str, arm_name: str, args: span[ast.Argument], env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    var fields = vec.Vec[ir.AggregateField].create()
    var i: ptr_uint = 0
    while i < args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(args.data + i)
        let field_name = arg.arg_name else:
            return Option[ptr[ir.Expr]].none
        match try_const_value_ir(ctx, arg.arg_value, env):
            Option.some as fv:
                fields.push(ir.AggregateField(name = field_name, value = fv.value))
            Option.none:
                return Option[ptr[ir.Expr]].none
        i += 1
    let var_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = ctx.module_name, name = variant_name)
    return Option[ptr[ir.Expr]].some(value = alloc_expr(ir.Expr.expr_variant_literal(ty = var_ty, arm_name = arm_name, fields = fields.as_span())))


## Evaluate a `const function` call by binding arguments into a fresh
## environment and interpreting the body's `let` / `return` statements.
function try_const_function_value(ctx: ref[LowerCtx], func_name: str, args: span[ast.Argument], caller_env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    let decls = ctx.analysis.source_file.declarations
    var i: ptr_uint = 0
    var func_body: ptr[ast.Stmt]? = null
    var func_params: span[ast.Param] = span[ast.Param]()
    while i < decls.len:
        unsafe:
            match read(decls.data + i):
                ast.Decl.decl_function as f:
                    if f.name == func_name and f.is_const and f.method_params.len == args.len:
                        func_body = f.body
                        func_params = f.method_params
                        break
                _:
                    pass
        i += 1
    let body_ptr = func_body else:
        return Option[ptr[ir.Expr]].none
    var env = map_mod.Map[str, ptr[ir.Expr]].create()
    var j: ptr_uint = 0
    while j < args.len:
        let arg_ep = unsafe: read(args.data + j).arg_value
        match try_const_value_ir(ctx, arg_ep, caller_env):
            Option.some as av:
                unsafe:
                    env.set(read(func_params.data + j).name, av.value)
            Option.none:
                return Option[ptr[ir.Expr]].none
        j += 1
    return try_const_value_body(ctx, body_ptr, ref_of(env))


## Control-flow outcome of executing compile-time statements.
variant ConstFlow:
    cf_value(value: ptr[ir.Expr])
    cf_break
    cf_continue
    cf_fallthrough
    cf_stuck


## Evaluate a const block body to its `return` value.  Returns none when the
## body cannot be folded or completes without returning.
function try_const_value_body(ctx: ref[LowerCtx], body: ptr[ast.Stmt]?, env: ref[map_mod.Map[str, ptr[ir.Expr]]]) -> Option[ptr[ir.Expr]]:
    match const_flow_body(ctx, env, body):
        ConstFlow.cf_value as v:
            return Option[ptr[ir.Expr]].some(value = v.value)
        ConstFlow.cf_break:
            return Option[ptr[ir.Expr]].none
        ConstFlow.cf_continue:
            return Option[ptr[ir.Expr]].none
        ConstFlow.cf_fallthrough:
            return Option[ptr[ir.Expr]].none
        ConstFlow.cf_stuck:
            return Option[ptr[ir.Expr]].none
    return Option[ptr[ir.Expr]].none


function const_flow_body(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], body: ptr[ast.Stmt]?) -> ConstFlow:
    let b = body else:
        return ConstFlow.cf_fallthrough
    return const_flow_stmt(ctx, env, b)


function const_flow_stmts(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], stmts: span[ast.Stmt]) -> ConstFlow:
    var i: ptr_uint = 0
    while i < stmts.len:
        match const_flow_stmt(ctx, env, unsafe: ptr[ast.Stmt]<-(stmts.data + i)):
            ConstFlow.cf_fallthrough:
                pass
            ConstFlow.cf_stuck:
                return ConstFlow.cf_stuck
            ConstFlow.cf_break:
                return ConstFlow.cf_break
            ConstFlow.cf_continue:
                return ConstFlow.cf_continue
            ConstFlow.cf_value as v:
                return ConstFlow.cf_value(value = v.value)
        i += 1
    return ConstFlow.cf_fallthrough


function const_flow_stmt(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], sp: ptr[ast.Stmt]) -> ConstFlow:
    unsafe:
        match read(sp):
            ast.Stmt.stmt_block as blk:
                return const_flow_stmts(ctx, env, blk.statements)
            ast.Stmt.stmt_ret as r:
                let val_ptr = r.value else:
                    return ConstFlow.cf_value(value = alloc_expr(ir.Expr.expr_zero_init(ty = ctx.void_ty)))
                match try_const_value_ir(ctx, val_ptr, env):
                    Option.some as v:
                        return ConstFlow.cf_value(value = v.value)
                    Option.none:
                        return ConstFlow.cf_stuck
            ast.Stmt.stmt_break:
                return ConstFlow.cf_break
            ast.Stmt.stmt_continue:
                return ConstFlow.cf_continue
            ast.Stmt.stmt_pass:
                return ConstFlow.cf_fallthrough
            ast.Stmt.stmt_local as loc:
                let init_ptr = loc.value else:
                    return ConstFlow.cf_fallthrough
                match try_const_value_ir(ctx, init_ptr, env):
                    Option.some as lv:
                        return const_bind_local(ctx, env, loc.name, loc.destructure_bindings, loc.else_binding, loc.else_body, lv.value)
                    Option.none:
                        return ConstFlow.cf_stuck
            ast.Stmt.stmt_assignment as asg:
                match try_const_value_ir(ctx, asg.value, env):
                    Option.some as rv:
                        match const_assign_target(ctx, env, asg.target, asg.operator, rv.value):
                            Option.some:
                                return ConstFlow.cf_fallthrough
                            Option.none:
                                return ConstFlow.cf_stuck
                    Option.none:
                        return ConstFlow.cf_stuck
            ast.Stmt.stmt_expression as ex:
                match try_const_value_ir(ctx, ex.expression, env):
                    Option.some:
                        return ConstFlow.cf_fallthrough
                    Option.none:
                        return ConstFlow.cf_stuck
            ast.Stmt.stmt_if as ifs:
                return const_flow_if(ctx, env, ifs.branches, ifs.else_body)
            ast.Stmt.stmt_while as ws:
                return const_flow_while(ctx, env, ws.condition, ws.body)
            ast.Stmt.stmt_for as fs:
                return const_flow_for(ctx, env, fs.bindings, fs.iterables, fs.body)
            ast.Stmt.stmt_match as ms:
                return const_flow_match_stmt(ctx, env, ms.scrutinee, ms.arms)
            ast.Stmt.stmt_unsafe as us:
                return const_flow_body(ctx, env, us.body)
            _:
                return ConstFlow.cf_stuck
    return ConstFlow.cf_stuck


function const_bind_local(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], name: str, destructure_bindings: Option[span[str]], else_binding: Option[str], else_body: ptr[ast.Stmt]?, value: ptr[ir.Expr]) -> ConstFlow:
    match destructure_bindings:
        Option.some as names:
            match const_bind_destructure(env, names.value, value):
                Option.some:
                    return ConstFlow.cf_fallthrough
                Option.none:
                    return ConstFlow.cf_stuck
        Option.none:
            pass
    # `let x = present else: ...` unwraps the payload; a `none`/`failure` arm
    # (or a plain nullable value) takes the else branch, binding `else as e`
    # to the failure error when present.
    if else_body != null:
        var failed = false
        var payload: ptr[ir.Expr]? = null
        unsafe:
            match read(value):
                ir.Expr.expr_variant_literal as vl:
                    if vl.arm_name == "none" or vl.arm_name == "failure":
                        failed = true
                        match else_binding:
                            Option.some as eb:
                                match const_field_value(vl.fields, "error"):
                                    Option.some as ef:
                                        env.set(eb.value, ef.value)
                                    Option.none:
                                        pass
                            Option.none:
                                pass
                    else:
                        match const_field_value(vl.fields, "value"):
                            Option.some as vf:
                                payload = vf.value
                            Option.none:
                                pass
                _:
                    payload = value
        if failed:
            return const_flow_body(ctx, env, else_body)
        let pv = payload else:
            return ConstFlow.cf_stuck
        if name != "_":
            env.set(name, pv)
        return ConstFlow.cf_fallthrough
    if name != "_":
        env.set(name, value)
    return ConstFlow.cf_fallthrough


## Bind a destructuring pattern (`let (a, b) = ...`, `let Pt(x, y) = ...`) by
## positional order of the value's fields/elements.
function const_bind_destructure(env: ref[map_mod.Map[str, ptr[ir.Expr]]], names: span[str], value: ptr[ir.Expr]) -> Option[bool]:
    unsafe:
        match read(value):
            ir.Expr.expr_aggregate_literal as ag:
                if ag.fields.len != names.len:
                    return Option[bool].none
                var i: ptr_uint = 0
                while i < names.len:
                    env.set(read(names.data + i), read(ag.fields.data + i).value)
                    i += 1
                return Option[bool].some(value = true)
            ir.Expr.expr_array_literal as al:
                if al.elements.len != names.len:
                    return Option[bool].none
                var ai: ptr_uint = 0
                while ai < names.len:
                    env.set(read(names.data + ai), al.elements.data + ai)
                    ai += 1
                return Option[bool].some(value = true)
            _:
                return Option[bool].none
    return Option[bool].none


function const_field_value(fields: span[ir.AggregateField], name: str) -> Option[ptr[ir.Expr]]:
    var i: ptr_uint = 0
    while i < fields.len:
        var f: ir.AggregateField
        unsafe:
            f = read(fields.data + i)
        if f.name == name:
            return Option[ptr[ir.Expr]].some(value = f.value)
        i += 1
    return Option[ptr[ir.Expr]].none


function const_assign_target(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], target: ptr[ast.Expr], operator: str, new_value: ptr[ir.Expr]) -> Option[bool]:
    unsafe:
        match read(target):
            ast.Expr.expr_identifier as id:
                if operator == "=":
                    env.set(id.name, new_value)
                    return Option[bool].some(value = true)
                let old_ptr = env.get(id.name) else:
                    return Option[bool].none
                match const_apply_binop(ctx, operator, read(old_ptr), new_value):
                    Option.some as folded:
                        env.set(id.name, folded.value)
                        return Option[bool].some(value = true)
                    Option.none:
                        return Option[bool].none
            ast.Expr.expr_member_access as ma:
                return const_assign_member(ctx, env, ma.receiver, ma.member_name, operator, new_value)
            ast.Expr.expr_index_access as ia:
                return const_assign_index(ctx, env, ia.receiver, ia.index, operator, new_value)
            _:
                return Option[bool].none
    return Option[bool].none


## Apply a compound assignment (`+=`) or plain `=` to a compile-time value.
function const_apply_binop(ctx: ref[LowerCtx], operator: str, old: ptr[ir.Expr], new_value: ptr[ir.Expr]) -> Option[ptr[ir.Expr]]:
    if operator == "=":
        return Option[ptr[ir.Expr]].some(value = new_value)
    if operator.len < 2:
        return Option[ptr[ir.Expr]].none
    let op = operator.slice(0, operator.len - 1)
    return const_fold_binary_ir(ctx, op, old, new_value)


function const_assign_member(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], receiver: ptr[ast.Expr], member: str, operator: str, new_value: ptr[ir.Expr]) -> Option[bool]:
    unsafe:
        match read(receiver):
            ast.Expr.expr_identifier as rid:
                let old_ptr = env.get(rid.name) else:
                    return Option[bool].none
                match read(read(old_ptr)):
                    ir.Expr.expr_aggregate_literal as ag:
                        var fields = vec.Vec[ir.AggregateField].create()
                        var i: ptr_uint = 0
                        var replaced = false
                        while i < ag.fields.len:
                            var f: ir.AggregateField
                            f = read(ag.fields.data + i)
                            if f.name == member:
                                match const_apply_binop(ctx, operator, f.value, new_value):
                                    Option.some as folded:
                                        fields.push(ir.AggregateField(name = f.name, value = folded.value))
                                        replaced = true
                                    Option.none:
                                        return Option[bool].none
                            else:
                                fields.push(f)
                            i += 1
                        if not replaced:
                            return Option[bool].none
                        env.set(rid.name, alloc_expr(ir.Expr.expr_aggregate_literal(ty = ag.ty, fields = fields.as_span())))
                        return Option[bool].some(value = true)
                    _:
                        return Option[bool].none
            _:
                return Option[bool].none
    return Option[bool].none


function const_assign_index(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], receiver: ptr[ast.Expr], index: ptr[ast.Expr], operator: str, new_value: ptr[ir.Expr]) -> Option[bool]:
    unsafe:
        match read(receiver):
            ast.Expr.expr_identifier as rid:
                let idx_opt = const_env_eval_int(ctx, env, index) else:
                    return Option[bool].none
                let old_ptr = env.get(rid.name) else:
                    return Option[bool].none
                match read(read(old_ptr)):
                    ir.Expr.expr_array_literal as al:
                        if idx_opt < 0 or idx_opt >= long<-al.elements.len:
                            return Option[bool].none
                        var elements = vec.Vec[ir.Expr].create()
                        var i: ptr_uint = 0
                        while i < al.elements.len:
                            if long<-i == idx_opt:
                                match const_apply_binop(ctx, operator, al.elements.data + i, new_value):
                                    Option.some as folded:
                                        elements.push(read(folded.value))
                                    Option.none:
                                        return Option[bool].none
                            else:
                                elements.push(read(al.elements.data + i))
                            i += 1
                        env.set(rid.name, alloc_expr(ir.Expr.expr_array_literal(ty = al.ty, elements = elements.as_span())))
                        return Option[bool].some(value = true)
                    _:
                        return Option[bool].none
            _:
                return Option[bool].none
    return Option[bool].none


function const_flow_if(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], branches: span[ast.IfBranch], else_body: ptr[ast.Stmt]?) -> ConstFlow:
    var bi: ptr_uint = 0
    while bi < branches.len:
        var br: ast.IfBranch
        unsafe:
            br = read(branches.data + bi)
        match const_env_eval_bool(ctx, env, br.condition):
            Option.some as cv:
                if cv.value:
                    return const_flow_body(ctx, env, br.body)
            Option.none:
                return ConstFlow.cf_stuck
        bi += 1
    if else_body != null:
        return const_flow_body(ctx, env, else_body)
    return ConstFlow.cf_fallthrough


function const_flow_while(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], condition: ptr[ast.Expr], body: ptr[ast.Stmt]?) -> ConstFlow:
    var iteration: ptr_uint = 0
    while iteration < 100000:
        match const_env_eval_bool(ctx, env, condition):
            Option.some as cv:
                if not cv.value:
                    return ConstFlow.cf_fallthrough
            Option.none:
                return ConstFlow.cf_stuck
        match const_flow_body(ctx, env, body):
            ConstFlow.cf_fallthrough:
                pass
            ConstFlow.cf_continue:
                pass
            ConstFlow.cf_break:
                return ConstFlow.cf_fallthrough
            ConstFlow.cf_value as v:
                return ConstFlow.cf_value(value = v.value)
            ConstFlow.cf_stuck:
                return ConstFlow.cf_stuck
        iteration += 1
    return ConstFlow.cf_stuck


function const_flow_for(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], bindings: span[ast.ForBinding], iterables: span[ast.Expr], body: ptr[ast.Stmt]?) -> ConstFlow:
    if bindings.len != 1 or iterables.len != 1:
        return ConstFlow.cf_stuck
    var binding: ast.ForBinding
    var iterable: ast.Expr
    unsafe:
        binding = read(bindings.data + 0)
        iterable = read(iterables.data + 0)
    match const_iterable_values(ctx, env, ptr_of(iterable)):
        Option.some as vals:
            var vi: ptr_uint = 0
            while vi < vals.value.len:
                unsafe:
                    env.set(binding.name, read(vals.value.data + vi))
                match const_flow_body(ctx, env, body):
                    ConstFlow.cf_fallthrough:
                        pass
                    ConstFlow.cf_continue:
                        pass
                    ConstFlow.cf_break:
                        return ConstFlow.cf_fallthrough
                    ConstFlow.cf_value as v:
                        return ConstFlow.cf_value(value = v.value)
                    ConstFlow.cf_stuck:
                        return ConstFlow.cf_stuck
                vi += 1
            return ConstFlow.cf_fallthrough
        Option.none:
            return ConstFlow.cf_stuck
    return ConstFlow.cf_stuck


## The element values of a compile-time iterable: an integer range, an array or
## string value, or a slice `arr[a..b]` / `str[a..b]`.
function const_iterable_values(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], ep: ptr[ast.Expr]) -> Option[span[ptr[ir.Expr]]]:
    unsafe:
        match read(ep):
            ast.Expr.expr_range as r:
                let s_opt = const_env_eval_int(ctx, env, r.start_expr) else:
                    return Option[span[ptr[ir.Expr]]].none
                let e_opt = const_env_eval_int(ctx, env, r.end_expr) else:
                    return Option[span[ptr[ir.Expr]]].none
                var range_vals = vec.Vec[ptr[ir.Expr]].create()
                var v = s_opt
                while v < e_opt:
                    range_vals.push(alloc_expr(ir.Expr.expr_integer_literal(value = v, ty = types.primitive("int"))))
                    v += 1
                    if range_vals.len() > 100000:
                        return Option[span[ptr[ir.Expr]]].none
                return Option[span[ptr[ir.Expr]]].some(value = range_vals.as_span())
            ast.Expr.expr_index_access:
                pass
            _:
                pass
    match try_const_value_ir(ctx, ep, env):
        Option.some as v:
            unsafe:
                match read(v.value):
                    ir.Expr.expr_array_literal as al:
                        var elems = vec.Vec[ptr[ir.Expr]].create()
                        var i: ptr_uint = 0
                        while i < al.elements.len:
                            elems.push(al.elements.data + i)
                            i += 1
                        return Option[span[ptr[ir.Expr]]].some(value = elems.as_span())
                    ir.Expr.expr_string_literal as sl:
                        var chars = vec.Vec[ptr[ir.Expr]].create()
                        var ci: ptr_uint = 0
                        while ci < sl.value.len:
                            chars.push(alloc_expr(ir.Expr.expr_integer_literal(value = long<-sl.value.byte_at(ci), ty = types.primitive("ubyte"))))
                            ci += 1
                        return Option[span[ptr[ir.Expr]]].some(value = chars.as_span())
                    _:
                        return Option[span[ptr[ir.Expr]]].none
        Option.none:
            return Option[span[ptr[ir.Expr]]].none
    return Option[span[ptr[ir.Expr]]].none


function const_flow_match_stmt(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], scrutinee: ptr[ast.Expr], arms: span[ast.MatchArm]) -> ConstFlow:
    match try_const_value_ir(ctx, scrutinee, env):
        Option.some as sv:
            var ai: ptr_uint = 0
            while ai < arms.len:
                var arm: ast.MatchArm
                unsafe:
                    arm = read(arms.data + ai)
                match const_match_pattern(ctx, env, arm.pattern, sv.value):
                    Option.some as matched:
                        if matched.value:
                            return const_flow_body(ctx, env, arm.body)
                    Option.none:
                        return ConstFlow.cf_stuck
                ai += 1
            return ConstFlow.cf_stuck
        Option.none:
            return ConstFlow.cf_stuck
    return ConstFlow.cf_stuck


## True when a match pattern matches the scrutinee value: literals compare by
## value and `_` (or a missing pattern) is the wildcard.
function const_match_pattern(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], pattern: ptr[ast.Expr]?, value: ptr[ir.Expr]) -> Option[bool]:
    let pp = pattern else:
        return Option[bool].some(value = true)
    unsafe:
        match read(pp):
            ast.Expr.expr_identifier as pid:
                if pid.name == "_":
                    return Option[bool].some(value = true)
            _:
                pass
    match try_const_value_ir(ctx, pp, env):
        Option.some as pv:
            return const_value_eq_ir(pv.value, value)
        Option.none:
            return Option[bool].none
    return Option[bool].none


function const_value_eq_ir(a: ptr[ir.Expr], b: ptr[ir.Expr]) -> Option[bool]:
    unsafe:
        match read(a):
            ir.Expr.expr_integer_literal as ai:
                match read(b):
                    ir.Expr.expr_integer_literal as bi:
                        return Option[bool].some(value = ai.value == bi.value)
                    _:
                        return Option[bool].none
            ir.Expr.expr_string_literal as as_:
                match read(b):
                    ir.Expr.expr_string_literal as bs:
                        return Option[bool].some(value = as_.value == bs.value)
                    _:
                        return Option[bool].none
            ir.Expr.expr_boolean_literal as ab:
                match read(b):
                    ir.Expr.expr_boolean_literal as bb:
                        return Option[bool].some(value = ab.value == bb.value)
                    _:
                        return Option[bool].none
            _:
                return Option[bool].none
    return Option[bool].none


function const_env_eval_int(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], ep: ptr[ast.Expr]) -> Option[long]:
    match try_const_value_ir(ctx, ep, env):
        Option.some as v:
            unsafe:
                match read(v.value):
                    ir.Expr.expr_integer_literal as il:
                        return Option[long].some(value = il.value)
                    ir.Expr.expr_boolean_literal as bl:
                        if bl.value:
                            return Option[long].some(value = 1)
                        return Option[long].some(value = 0)
                    _:
                        return Option[long].none
        Option.none:
            return Option[long].none
    return Option[long].none


function const_env_eval_bool(ctx: ref[LowerCtx], env: ref[map_mod.Map[str, ptr[ir.Expr]]], ep: ptr[ast.Expr]) -> Option[bool]:
    match try_const_value_ir(ctx, ep, env):
        Option.some as v:
            unsafe:
                match read(v.value):
                    ir.Expr.expr_boolean_literal as bl:
                        return Option[bool].some(value = bl.value)
                    ir.Expr.expr_integer_literal as il:
                        return Option[bool].some(value = il.value != 0)
                    _:
                        return Option[bool].none
        Option.none:
            return Option[bool].none
    return Option[bool].none


## Compile-time evaluation of `==` / `!=` over constant operands, used to fold
## struct/variant constant comparisons (`const EQ: bool = A == B`).  Resolves
## identifiers through module constants and compares literals, struct/variant
## literals, and array literals structurally.  Returns none when either side is
## not compile-time known, in which case the comparison is lowered normally.
function try_const_equality(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> Option[bool]:
    unsafe:
        match read(ep):
            ast.Expr.expr_binary_op as bin:
                if bin.operator == "==" or bin.operator == "!=":
                    match const_operand_eq(ctx, bin.left, bin.right):
                        Option.some as eq:
                            if bin.operator == "==":
                                return Option[bool].some(value = eq.value)
                            return Option[bool].some(value = not eq.value)
                        Option.none:
                            pass
            _:
                pass
    return Option[bool].none


## Resolve an operand expression to its constant form: identifiers naming module
## constants resolve to the constant's value expression (recursively); every
## other expression is returned as-is.
function resolve_const_operand(ctx: ref[LowerCtx], ep: ptr[ast.Expr], depth: int) -> Option[ptr[ast.Expr]]:
    if depth > 32:
        return Option[ptr[ast.Expr]].none
    unsafe:
        match read(ep):
            ast.Expr.expr_identifier as id:
                let cv = ctx.analysis.const_values.get(id.name)
                if cv != null:
                    return resolve_const_operand(ctx, unsafe: read(cv), depth + 1)
                # Constants whose value is not a foldable scalar (struct,
                # variant, array literals) are not in `const_values`; read the
                # declaration's value expression directly.
                let decl_val = find_const_value_ast(ctx, id.name)
                if decl_val != null:
                    return resolve_const_operand(ctx, unsafe: ptr[ast.Expr]<-decl_val, depth + 1)
                return Option[ptr[ast.Expr]].none
            _:
                return Option[ptr[ast.Expr]].some(value = ep)


## The value expression of a module-level constant declaration, or null when
## the name is not a constant of the module currently being lowered.
function find_const_value_ast(ctx: ref[LowerCtx], name: str) -> ptr[ast.Expr]?:
    let decls = ctx.analysis.source_file.declarations
    var i: ptr_uint = 0
    while i < decls.len:
        unsafe:
            match read(decls.data + i):
                ast.Decl.decl_const as c:
                    if c.name == name:
                        return c.value
                _:
                    pass
        i += 1
    return null


## Structural equality of two constant operand expressions.
function const_operand_eq(ctx: ref[LowerCtx], left: ptr[ast.Expr], right: ptr[ast.Expr]) -> Option[bool]:
    let lp = resolve_const_operand(ctx, left, 0) else:
        return Option[bool].none
    let rp = resolve_const_operand(ctx, right, 0) else:
        return Option[bool].none
    unsafe:
        match read(lp):
            ast.Expr.expr_integer_literal as li:
                match read(rp):
                    ast.Expr.expr_integer_literal as ri:
                        return Option[bool].some(value = li.value == ri.value)
                    _:
                        return Option[bool].none
            ast.Expr.expr_float_literal as lf:
                match read(rp):
                    ast.Expr.expr_float_literal as rf:
                        return Option[bool].some(value = lf.value == rf.value)
                    _:
                        return Option[bool].none
            ast.Expr.expr_bool_literal as lb:
                match read(rp):
                    ast.Expr.expr_bool_literal as rb:
                        return Option[bool].some(value = lb.value == rb.value)
                    _:
                        return Option[bool].none
            ast.Expr.expr_char_literal as lc:
                match read(rp):
                    ast.Expr.expr_char_literal as rc:
                        return Option[bool].some(value = lc.value == rc.value)
                    _:
                        return Option[bool].none
            ast.Expr.expr_string_literal as ls:
                match read(rp):
                    ast.Expr.expr_string_literal as rs:
                        return Option[bool].some(value = ls.value == rs.value)
                    _:
                        return Option[bool].none
            ast.Expr.expr_null_literal:
                match read(rp):
                    ast.Expr.expr_null_literal:
                        return Option[bool].some(value = true)
                    _:
                        return Option[bool].none
            ast.Expr.expr_call as lcall:
                match read(rp):
                    ast.Expr.expr_call as rcall:
                        return const_call_eq(ctx, lcall.callee, lcall.args, rcall.callee, rcall.args)
                    _:
                        return Option[bool].none
            _:
                return Option[bool].none
    return Option[bool].none


## Compare two aggregate/literal constructor calls.  Struct and variant
## literals compare named fields (order-independent); array constructors
## compare positional elements.
function const_call_eq(ctx: ref[LowerCtx], lcallee: ptr[ast.Expr], largs: span[ast.Argument], rcallee: ptr[ast.Expr], rargs: span[ast.Argument]) -> Option[bool]:
    unsafe:
        match read(lcallee):
            ast.Expr.expr_identifier as lid:
                match read(rcallee):
                    ast.Expr.expr_identifier as rid:
                        if lid.name != rid.name:
                            return Option[bool].none
                        return const_fields_eq(ctx, largs, rargs)
                    _:
                        return Option[bool].none
            ast.Expr.expr_member_access as lma:
                match read(rcallee):
                    ast.Expr.expr_member_access as rma:
                        if lma.member_name != rma.member_name:
                            return Option[bool].none
                        if not const_expr_names_equal(lma.receiver, rma.receiver):
                            return Option[bool].none
                        return const_fields_eq(ctx, largs, rargs)
                    _:
                        return Option[bool].none
            ast.Expr.expr_specialization as lspec:
                match read(rcallee):
                    ast.Expr.expr_specialization as rspec:
                        if not const_expr_names_equal(lspec.callee, rspec.callee):
                            return Option[bool].none
                        return const_positional_eq(ctx, largs, rargs)
                    _:
                        return Option[bool].none
            _:
                return Option[bool].none
    return Option[bool].none


function const_expr_names_equal(a: ptr[ast.Expr], b: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(a):
            ast.Expr.expr_identifier as aid:
                match read(b):
                    ast.Expr.expr_identifier as bid:
                        return aid.name == bid.name
                    _:
                        return false
            _:
                return false


function const_fields_eq(ctx: ref[LowerCtx], largs: span[ast.Argument], rargs: span[ast.Argument]) -> Option[bool]:
    if largs.len != rargs.len:
        return Option[bool].none
    var right_by_name = map_mod.Map[str, ptr[ast.Expr]].create()
    var ri: ptr_uint = 0
    while ri < rargs.len:
        var ra: ast.Argument
        unsafe:
            ra = read(rargs.data + ri)
        match ra.arg_name:
            Option.some as nm:
                right_by_name.set(nm.value, ra.arg_value)
            Option.none:
                return Option[bool].none
        ri += 1
    var li: ptr_uint = 0
    while li < largs.len:
        var la: ast.Argument
        unsafe:
            la = read(largs.data + li)
        let lname = la.arg_name else:
            return Option[bool].none
        let rvp = right_by_name.get(lname) else:
            return Option[bool].none
        match const_operand_eq(ctx, la.arg_value, unsafe: read(rvp)):
            Option.some as eq:
                if not eq.value:
                    return Option[bool].some(value = false)
            Option.none:
                return Option[bool].none
        li += 1
    return Option[bool].some(value = true)


function const_positional_eq(ctx: ref[LowerCtx], largs: span[ast.Argument], rargs: span[ast.Argument]) -> Option[bool]:
    if largs.len != rargs.len:
        return Option[bool].none
    var i: ptr_uint = 0
    while i < largs.len:
        var la: ast.Argument
        var ra: ast.Argument
        unsafe:
            la = read(largs.data + i)
            ra = read(rargs.data + i)
        match const_operand_eq(ctx, la.arg_value, ra.arg_value):
            Option.some as eq:
                if not eq.value:
                    return Option[bool].some(value = false)
            Option.none:
                return Option[bool].none
        i += 1
    return Option[bool].some(value = true)


## Lower a span of statements (from a when branch) into the output vec.
function lower_span_stmts(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], stmts: span[ast.Stmt]) -> void:
    var i: ptr_uint = 0
    while i < stmts.len:
        unsafe:
            lower_stmt(ctx, output, ptr[ast.Stmt]<-(stmts.data + i))
        i += 1


## Lower a block body (ptr to statement) into the output vec.
function lower_block_stmts(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], body: ptr[ast.Stmt]) -> void:
    var blk: ast.Stmt
    unsafe:
        blk = read(body)
    match blk:
        ast.Stmt.stmt_block as b:
            var i: ptr_uint = 0
            while i < b.statements.len:
                unsafe:
                    lower_stmt(ctx, output, ptr[ast.Stmt]<-(b.statements.data + i))
                i += 1
        _:
            lower_stmt(ctx, output, body)


## Try to evaluate an AST expression at compile time, returning the constant
## value when the expression can be resolved.
## Look up an enum member's integer value.  Returns >= 0 on success, -1 if not found.
function try_lookup_enum_value(ctx: ref[LowerCtx], receiver: ptr[ast.Expr], member_name: str) -> long:
    unsafe:
        match read(receiver):
            ast.Expr.expr_identifier as id:
                # Check the current module's source file for enum declarations
                # that match the receiver name and contain the member.
                var i: ptr_uint = 0
                let decls = ctx.analysis.source_file.declarations
                while i < decls.len:
                    var d: ast.Decl
                    unsafe:
                        d = read(decls.data + i)
                    match d:
                        ast.Decl.decl_enum as en:
                            if en.name == id.name:
                                return find_enum_member_value(en.enum_members, member_name)
                        ast.Decl.decl_flags as fl:
                            if fl.name == id.name:
                                return find_enum_member_value(fl.flags_members, member_name)
                        _:
                            pass
                    i += 1
                # Also check in imported module sources
                var mi: ptr_uint = 0
                while mi < ctx.program_analyses.len:
                    var a: analyzer.Analysis
                    unsafe:
                        a = read(ctx.program_analyses.data + mi)
                    if a.module_name == id.name:
                        var di: ptr_uint = 0
                        let adecls = a.source_file.declarations
                        while di < adecls.len:
                            var dd: ast.Decl
                            unsafe:
                                dd = read(adecls.data + di)
                            match dd:
                                ast.Decl.decl_enum as een:
                                    return find_enum_member_value(een.enum_members, member_name)
                                _:
                                    pass
                            di += 1
                    mi += 1
                return -1
            ast.Expr.expr_member_access as type_access:
                # A qualified enum type: `module.Enum.member` (the receiver is
                # `module.Enum`).  Resolve the imported module's enum/flags
                # declaration and its member value.
                match read(type_access.receiver):
                    ast.Expr.expr_identifier as module_id:
                        let target_ptr = ctx.analysis.imports.get(module_id.name)
                        if target_ptr != null:
                            match find_imported_analysis(ctx, unsafe: read(target_ptr)):
                                Option.some as owner:
                                    var di: ptr_uint = 0
                                    let adecls = owner.value.source_file.declarations
                                    while di < adecls.len:
                                        var dd: ast.Decl
                                        unsafe:
                                            dd = read(adecls.data + di)
                                        match dd:
                                            ast.Decl.decl_enum as een:
                                                if een.name == type_access.member_name:
                                                    return find_enum_member_value(een.enum_members, member_name)
                                            ast.Decl.decl_flags as ffl:
                                                if ffl.name == type_access.member_name:
                                                    return find_enum_member_value(ffl.flags_members, member_name)
                                            _:
                                                pass
                                        di += 1
                                Option.none:
                                    pass
                    _:
                        pass
                return -1
            _:
                return -1
    return -1


## Find an enum/flags member by name and return its value.  Returns -1 if not found.

function find_enum_member_value(members: span[ast.EnumMember], name: str) -> long:
    var i: ptr_uint = 0
    while i < members.len:
        var m: ast.EnumMember
        unsafe:
            m = read(members.data + i)
        if m.name == name:
            let val_expr = m.value else:
                return long<-(i)
            unsafe:
                match read(val_expr):
                    ast.Expr.expr_integer_literal as lit:
                        return long<-lit.value
                    _:
                        return long<-(i)
        i += 1
    return -1


function try_evaluate_const_expr(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> Option[ConstValue]:
    unsafe:
        match read(ep):
            ast.Expr.expr_integer_literal as lit:
                return Option[ConstValue].some(value = ConstValue.cv_int(value = long<-lit.value))
            ast.Expr.expr_float_literal as lit:
                return Option[ConstValue].some(value = ConstValue.cv_int(value = long<-(lit.value)))
            ast.Expr.expr_bool_literal as b:
                return Option[ConstValue].some(value = ConstValue.cv_bool(value = b.value))
            ast.Expr.expr_string_literal as s:
                return Option[ConstValue].some(value = ConstValue.cv_str(value = s.value))
            ast.Expr.expr_char_literal as ch:
                return Option[ConstValue].some(value = ConstValue.cv_int(value = long<-ch.value))
            ast.Expr.expr_identifier as id:
                let cv_entry = ctx.analysis.const_values.get(id.name)
                if cv_entry != null:
                    unsafe:
                        let cv_val = read(cv_entry)
                        return try_evaluate_const_expr(ctx, cv_val)
                if id.name == "true":
                    return Option[ConstValue].some(value = ConstValue.cv_bool(value = true))
                if id.name == "false":
                    return Option[ConstValue].some(value = ConstValue.cv_bool(value = false))
                # A bare type name or an in-scope generic type parameter evaluates
                # to a compile-time type value, enabling `inline if T == int` and
                # `field.type == float` dispatch.
                match comptime_identifier_type(ctx, id.name):
                    Option.some as tv:
                        return Option[ConstValue].some(value = ConstValue.cv_type(ty = tv.value))
                    Option.none:
                        pass
                return Option[ConstValue].none
            ast.Expr.expr_member_access as ma:
                # `field.type` inside an `inline for` over `fields_of(T)` resolves
                # to the current field's type as a compile-time type value.
                if ma.member_name == "type":
                    match ctx.inline_for_element:
                        Option.some as elem_val:
                            match elem_val.value:
                                ComptimeElement.ce_struct_field as sf:
                                    return Option[ConstValue].some(value = ConstValue.cv_type(ty = sf.field_type))
                                _:
                                    pass
                        Option.none:
                            pass
                match try_evaluate_const_expr(ctx, ma.receiver):
                    Option.some as rv:
                        return Option[ConstValue].some(value = rv.value)
                    Option.none:
                        pass
                # An imported module constant (`alias.CONST`): evaluate its
                # initializer in the declaring module's context — the host's
                # `resolve_imported_module_const_value` (`sdl.ALPHA_OPAQUE` at a
                # `ubyte` foreign boundary).
                match read(ma.receiver):
                    ast.Expr.expr_identifier as rid:
                        let target_ptr = ctx.analysis.imports.get(rid.name)
                        if target_ptr != null:
                            match find_imported_analysis(ctx, unsafe: read(target_ptr)):
                                Option.some as owner:
                                    var saved_module = ctx.module_name
                                    var saved_analysis = ctx.analysis
                                    ctx.module_name = owner.value.module_name
                                    ctx.analysis = owner.value
                                    var imported_cv = Option[ConstValue].none
                                    let chain = ctx.analysis.const_values.get(ma.member_name)
                                    if chain != null:
                                        imported_cv = try_evaluate_const_expr(ctx, unsafe: read(chain))
                                    ctx.module_name = saved_module
                                    ctx.analysis = saved_analysis
                                    match imported_cv:
                                        Option.some as cv:
                                            return Option[ConstValue].some(value = cv.value)
                                        Option.none:
                                            pass
                                Option.none:
                                    pass
                    _:
                        pass
                # If the receiver is an enum type, look up the member value
                # from the enum's backing integer.
                let enum_val = try_lookup_enum_value(ctx, ma.receiver, ma.member_name)
                if enum_val >= 0:
                    return Option[ConstValue].some(value = ConstValue.cv_int(value = enum_val))
                return Option[ConstValue].none
            ast.Expr.expr_binary_op as bin:
                return evaluate_const_binary(ctx, bin.operator, bin.left, bin.right)
            ast.Expr.expr_unary_op as un:
                return evaluate_const_unary(ctx, un.operator, un.operand)
            ast.Expr.expr_prefix_cast as pc:
                return evaluate_const_prefix_cast(ctx, pc.target_type, pc.expression)
            _:
                return Option[ConstValue].none


## The host's `CompileTime.evaluate_prefix_cast`: fold a constant through the
## cast's target primitive, wrapping integers to the target width/signedness
## (`uint<-MoverBit` → 2, `ubyte<-300` → 44).  A non-primitive target or a
## non-numeric operand stays unfolded.
function evaluate_const_prefix_cast(ctx: ref[LowerCtx], target_type: ptr[ast.TypeRef], expression: ptr[ast.Expr]) -> Option[ConstValue]:
    match try_evaluate_const_expr(ctx, expression):
        Option.some as inner:
            match inner.value:
                ConstValue.cv_int as iv:
                    let target_ty = resolve_type_ref(ctx, target_type)
                    match target_ty:
                        types.Type.ty_primitive as p:
                            if p.name == "bool":
                                return Option[ConstValue].some(value = ConstValue.cv_bool(value = iv.value != 0))
                            if types.is_integer_type(target_ty):
                                let width = types.integer_width(p.name)
                                if width <= 0:
                                    return Option[ConstValue].none
                                return Option[ConstValue].some(value = ConstValue.cv_int(value = wrap_const_integer(iv.value, width, types.is_signed_integer_name(p.name))))
                            if types.is_float_type(target_ty):
                                return Option[ConstValue].some(value = ConstValue.cv_int(value = iv.value))
                        _:
                            pass
                ConstValue.cv_bool as bv:
                    let target_ty = resolve_type_ref(ctx, target_type)
                    match target_ty:
                        types.Type.ty_primitive as p:
                            if p.name == "bool":
                                return Option[ConstValue].some(value = inner.value)
                            if types.is_integer_type(target_ty):
                                return Option[ConstValue].some(value = ConstValue.cv_int(value = if bv.value: 1 else: 0))
                        _:
                            pass
                _:
                    pass
        Option.none:
            pass
    return Option[ConstValue].none


function wrap_const_integer(value: long, width: int, signed: bool) -> long:
    if width >= 64:
        return value
    let wide_width = long<-width
    let mask = (1l << wide_width) - 1
    var wrapped = value & mask
    if signed:
        let half = 1l << (wide_width - 1)
        if wrapped >= half:
            wrapped -= 1l << wide_width
    return wrapped


function evaluate_const_unary(ctx: ref[LowerCtx], op: str, operand: ptr[ast.Expr]) -> Option[ConstValue]:
    match try_evaluate_const_expr(ctx, operand):
        Option.some as val:
            match val.value:
                ConstValue.cv_int as iv:
                    if op == "-":
                        return Option[ConstValue].some(value = ConstValue.cv_int(value = -iv.value))
                    if op == "~":
                        return Option[ConstValue].some(value = ConstValue.cv_int(value = ~iv.value))
                    return Option[ConstValue].none
                ConstValue.cv_bool as bv:
                    if op == "not":
                        return Option[ConstValue].some(value = ConstValue.cv_bool(value = not bv.value))
                    return Option[ConstValue].none
                _:
                    return Option[ConstValue].none
        Option.none:
            return Option[ConstValue].none


function evaluate_const_binary(ctx: ref[LowerCtx], op: str, left: ptr[ast.Expr], right: ptr[ast.Expr]) -> Option[ConstValue]:
    match try_evaluate_const_expr(ctx, left):
        Option.some as lv:
            match try_evaluate_const_expr(ctx, right):
                Option.some as rv:
                    return const_binary_op(op, lv.value, rv.value)
                Option.none:
                    return Option[ConstValue].none
        Option.none:
            return Option[ConstValue].none


function const_binary_op(op: str, left_val: ConstValue, right_val: ConstValue) -> Option[ConstValue]:
    match left_val:
        ConstValue.cv_int as li:
            match right_val:
                ConstValue.cv_int as ri:
                    # Comparison operators yield a bool; arithmetic/bitwise yield
                    # an int.  Without this split, `SELECTOR == 2` would evaluate
                    # to `cv_int(1)` and an `inline if` (which only accepts
                    # `cv_bool`) would drop both branches.
                    if is_const_comparison_op(op):
                        return Option[ConstValue].some(value = ConstValue.cv_bool(value = apply_int_op(op, li.value, ri.value) != 0))
                    return Option[ConstValue].some(value = ConstValue.cv_int(value = apply_int_op(op, li.value, ri.value)))
                _:
                    return Option[ConstValue].none
        ConstValue.cv_bool as lb:
            match right_val:
                ConstValue.cv_bool as rb:
                    if op == "and":
                        return Option[ConstValue].some(value = ConstValue.cv_bool(value = lb.value and rb.value))
                    if op == "or":
                        return Option[ConstValue].some(value = ConstValue.cv_bool(value = lb.value or rb.value))
                    if op == "==":
                        return Option[ConstValue].some(value = ConstValue.cv_bool(value = lb.value == rb.value))
                    if op == "!=":
                        return Option[ConstValue].some(value = ConstValue.cv_bool(value = lb.value != rb.value))
                    return Option[ConstValue].none
                _:
                    return Option[ConstValue].none
        ConstValue.cv_str as ls:
            match right_val:
                ConstValue.cv_str as rs:
                    if op == "==":
                        return Option[ConstValue].some(value = ConstValue.cv_bool(value = ls.value == rs.value))
                    if op == "!=":
                        return Option[ConstValue].some(value = ConstValue.cv_bool(value = not ls.value == rs.value))
                    return Option[ConstValue].none
                _:
                    return Option[ConstValue].none
        ConstValue.cv_type as lt:
            match right_val:
                ConstValue.cv_type as rt:
                    if op == "==":
                        return Option[ConstValue].some(value = ConstValue.cv_bool(value = types_are_equal(lt.ty, rt.ty)))
                    if op == "!=":
                        return Option[ConstValue].some(value = ConstValue.cv_bool(value = not types_are_equal(lt.ty, rt.ty)))
                    return Option[ConstValue].none
                _:
                    return Option[ConstValue].none


function is_const_comparison_op(op: str) -> bool:
    return op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="


function apply_int_op(op: str, l: long, r: long) -> long:
    if op == "+":
        return l + r
    if op == "-":
        return l - r
    if op == "*":
        return l * r
    if op == "/":
        return l / r
    if op == "%":
        return l % r
    if op == "==":
        return long<-(l == r)
    if op == "!=":
        return long<-(l != r)
    if op == "<":
        return long<-(l < r)
    if op == "<=":
        return long<-(l <= r)
    if op == ">":
        return long<-(l > r)
    if op == ">=":
        return long<-(l >= r)
    if op == "<<":
        return l << long<-(r)
    if op == ">>":
        return l >> long<-(r)
    if op == "&":
        return l & r
    if op == "|":
        return l | r
    if op == "^":
        return l ^ r
    return 0


## Attempt to evaluate a const function call at compile time, returning an IR
## literal when successful.  Walks the function's AST body with a lightweight
## interpreter that supports integer arithmetic, boolean ops, parameters, return
## statements, if/else control flow, while loops, and for loops over arrays.
## Falls back to returning `None` for unrecognised constructs so the regular
## call lowering path can take over.
function try_evaluate_const_function_call(ctx: ref[LowerCtx], func_name: str, args: span[ast.Argument], caller_vars: ref[map_mod.Map[str, long]]) -> Option[ptr[ir.Expr]]:
    let decls = ctx.analysis.source_file.declarations
    var i: ptr_uint = 0
    var func_body: ptr[ast.Stmt]? = null
    var func_params: span[ast.Param] = span[ast.Param]()
    while i < decls.len:
        unsafe:
            match read(decls.data + i):
                ast.Decl.decl_function as f:
                    if f.name == func_name and f.is_const and f.method_params.len == args.len:
                        func_body = f.body
                        func_params = f.method_params
                        break
                _:
                    pass
        i += 1
    let body_ptr = func_body else:
        return Option[ptr[ir.Expr]].none

    var param_values = map_mod.Map[str, long].create()
    var j: ptr_uint = 0
    while j < args.len:
        let arg_ep = unsafe: read(args.data + j).arg_value
        # Evaluate each argument in the caller's variable scope, so a nested
        # const-function call like `cube` -> `square(x)` resolves `x` from the
        # caller's bindings instead of defaulting to 0.
        # A non-constant argument means the call cannot be folded: fall back to
        # the ordinary call lowering (defaulting it to 0 would fold a runtime
        # call into a wrong literal).
        match evaluate_const_expr_to_long(ctx, caller_vars, arg_ep):
            Option.some as lv:
                unsafe:
                    param_values.set(read(func_params.data + j).name, lv.value)
            Option.none:
                return Option[ptr[ir.Expr]].none
        j += 1

    return try_evaluate_const_body(ctx, ref_of(param_values), body_ptr)


## Evaluate a block body returning an IR expression when the body terminates
## with a return statement that evaluates to a constant.
function try_evaluate_const_body(ctx: ref[LowerCtx], variables: ref[map_mod.Map[str, long]], body: ptr[ast.Stmt]?) -> Option[ptr[ir.Expr]]:
    let b = body else:
        return Option[ptr[ir.Expr]].none
    unsafe:
        match read(b):
            ast.Stmt.stmt_block as blk:
                var mi: ptr_uint = 0
                while mi < blk.statements.len:
                    match evaluate_const_stmt(ctx, variables, blk.statements.data + mi):
                        Option.some as result:
                            return Option[ptr[ir.Expr]].some(value = result.value)
                        Option.none:
                            pass
                    mi += 1
                return Option[ptr[ir.Expr]].none
            _:
                return evaluate_const_stmt(ctx, variables, b)


function evaluate_const_stmt(ctx: ref[LowerCtx], variables: ref[map_mod.Map[str, long]], sp: ptr[ast.Stmt]) -> Option[ptr[ir.Expr]]:
    unsafe:
        match read(sp):
            ast.Stmt.stmt_ret as r:
                let val_ptr = r.value else:
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(
                        ir.Expr.expr_zero_init(ty = ctx.void_ty)))
                return evaluate_const_expr_to_ir(ctx, variables, val_ptr)
            ast.Stmt.stmt_expression as ex:
                let _discard = evaluate_const_expr_to_ir(ctx, variables, ex.expression)
                return Option[ptr[ir.Expr]].none
            ast.Stmt.stmt_if as ifs:
                var bi: ptr_uint = 0
                while bi < ifs.branches.len:
                    let br = unsafe: read(ifs.branches.data + bi)
                    match evaluate_const_expr_to_long(ctx, variables, br.condition):
                        Option.some as cv:
                            if cv.value != 0:
                                return try_evaluate_const_body(ctx, variables, br.body)
                        Option.none:
                            pass
                    bi += 1
                return try_evaluate_const_body(ctx, variables, ifs.else_body)
            ast.Stmt.stmt_while as ws:
                var iteration: int = 0
                while iteration < 10000:
                    match evaluate_const_expr_to_long(ctx, variables, ws.condition):
                        Option.some as cv:
                            if cv.value == 0:
                                break
                        Option.none:
                            break
                    match try_evaluate_const_body(ctx, variables, ws.body):
                        Option.some as wrv:
                            return Option[ptr[ir.Expr]].some(value = wrv.value)
                        Option.none:
                            pass
                    iteration += 1
                if iteration >= 10000:
                    return Option[ptr[ir.Expr]].none
                return Option[ptr[ir.Expr]].none
            ast.Stmt.stmt_for as fs:
                # Only support single-binding, single-iterable compile-time for loops.
                if fs.bindings.len != 1 or fs.iterables.len != 1:
                    return Option[ptr[ir.Expr]].none
                let binding = unsafe: read(fs.bindings.data + 0)
                let iterable = unsafe: read(fs.iterables.data + 0)
                match evaluate_const_iterable(ctx, iterable):
                    Option.some as iter_vals_payload:
                        var vi: ptr_uint = 0
                        while vi < iter_vals_payload.value.len:
                            unsafe:
                                variables.set(binding.name, read(iter_vals_payload.value.data + vi))
                            match try_evaluate_const_body(ctx, variables, fs.body):
                                Option.some as frv:
                                    return Option[ptr[ir.Expr]].some(value = frv.value)
                                Option.none:
                                    pass
                            vi += 1
                        return Option[ptr[ir.Expr]].none
                    Option.none:
                        return Option[ptr[ir.Expr]].none
            ast.Stmt.stmt_local as loc:
                let init_ptr = loc.value
                if init_ptr != null:
                    match evaluate_const_expr_to_long(ctx, variables, init_ptr):
                        Option.some as lv:
                            variables.set(loc.name, lv.value)
                        Option.none:
                            pass
                return Option[ptr[ir.Expr]].none
            ast.Stmt.stmt_assignment as asg:
                match read(asg.target):
                    ast.Expr.expr_identifier as tid:
                        match evaluate_const_expr_to_long(ctx, variables, asg.value):
                            Option.some as lv:
                                variables.set(tid.name, lv.value)
                            Option.none:
                                pass
                    _:
                        pass
                return Option[ptr[ir.Expr]].none
            _:
                return Option[ptr[ir.Expr]].none


function evaluate_const_iterable(ctx: ref[LowerCtx], ep: ast.Expr) -> Option[span[long]]:
    unsafe:
        match ep:
            ast.Expr.expr_identifier as id:
                let cv_entry = ctx.analysis.const_values.get(id.name)
                if cv_entry != null:
                    let cv_val = unsafe: read(cv_entry)
                    return evaluate_const_iterable(ctx, unsafe: read(cv_val))
                # Array constants are not in `const_values` (it holds foldable
                # scalars only); read the declaration's value expression.
                let decl_val = find_const_value_ast(ctx, id.name)
                if decl_val != null:
                    return evaluate_const_iterable(ctx, unsafe: read(decl_val))
                return Option[span[long]].none
            ast.Expr.expr_expression_list as els:
                var vals = vec.Vec[long].create()
                var ii: ptr_uint = 0
                while ii < els.elements.len:
                    match evaluate_const_expr_to_long_standalone(ctx, els.elements.data + ii):
                        Option.some as lv:
                            vals.push(lv.value)
                        Option.none:
                            vals.push(0)
                    ii += 1
                return Option[span[long]].some(value = vals.as_span())
            _:
                return Option[span[long]].none


function evaluate_const_expr_to_long(ctx: ref[LowerCtx], variables: ref[map_mod.Map[str, long]], ep: ptr[ast.Expr]) -> Option[long]:
    match evaluate_const_expr_to_ir(ctx, variables, ep):
        Option.some as irv:
            unsafe:
                match read(irv.value):
                    ir.Expr.expr_integer_literal as il:
                        return Option[long].some(value = il.value)
                    ir.Expr.expr_boolean_literal as bl:
                        if bl.value:
                            return Option[long].some(value = 1)
                        return Option[long].some(value = 0)
                    ir.Expr.expr_cast as c:
                        match read(c.expression):
                            ir.Expr.expr_integer_literal as cil:
                                return Option[long].some(value = cil.value)
                            ir.Expr.expr_boolean_literal as cbl:
                                if cbl.value:
                                    return Option[long].some(value = 1)
                                return Option[long].some(value = 0)
                            _:
                                pass
                    _:
                        pass
        Option.none:
            pass
    return Option[long].none


## Like evaluate_const_expr_to_long but does not use local variable map;
## evaluates standalone compile-time expressions (e.g. argument values).
function evaluate_const_expr_to_long_standalone(ctx: ref[LowerCtx], ep: ptr[ast.Expr]) -> Option[long]:
    unsafe:
        match read(ep):
            ast.Expr.expr_integer_literal as lit:
                return Option[long].some(value = lit.value)
            ast.Expr.expr_bool_literal as b:
                if b.value:
                    return Option[long].some(value = 1)
                return Option[long].some(value = 0)
            ast.Expr.expr_identifier as id:
                let entry = ctx.analysis.const_values.get(id.name)
                if entry != null:
                    return evaluate_const_expr_to_long_standalone(ctx, unsafe: read(entry))
                if id.name == "true":
                    return Option[long].some(value = 1)
                if id.name == "false":
                    return Option[long].some(value = 0)
                return Option[long].none
            ast.Expr.expr_binary_op as bin:
                return evaluate_const_expr_to_long_standalone_bin(ctx, bin.operator, bin.left, bin.right)
            ast.Expr.expr_call as call:
                match read(call.callee):
                    ast.Expr.expr_identifier as cid:
                        var standalone_vars = map_mod.Map[str, long].create()
                        match try_evaluate_const_function_call(ctx, cid.name, call.args, ref_of(standalone_vars)):
                            Option.some as rv:
                                unsafe:
                                    match read(rv.value):
                                        ir.Expr.expr_integer_literal as rvl:
                                            return Option[long].some(value = rvl.value)
                                        _:
                                            pass
                            Option.none:
                                pass
                    _:
                        pass
                return Option[long].none
            _:
                return Option[long].none


function evaluate_const_expr_to_long_standalone_bin(ctx: ref[LowerCtx], op: str, left: ptr[ast.Expr], right: ptr[ast.Expr]) -> Option[long]:
    match evaluate_const_expr_to_long_standalone(ctx, left):
        Option.some as lv:
            match evaluate_const_expr_to_long_standalone(ctx, right):
                Option.some as rv:
                    return Option[long].some(value = apply_int_op(op, lv.value, rv.value))
                Option.none:
                    pass
        Option.none:
            pass
    return Option[long].none


function evaluate_const_expr_to_ir(ctx: ref[LowerCtx], variables: ref[map_mod.Map[str, long]], ep: ptr[ast.Expr]) -> Option[ptr[ir.Expr]]:
    unsafe:
        match read(ep):
            ast.Expr.expr_integer_literal as lit:
                return Option[ptr[ir.Expr]].some(value = alloc_expr(
                    integer_literal_expr(lit.lexeme, lit.value, types.primitive("int"))))
            ast.Expr.expr_float_literal as lit:
                return Option[ptr[ir.Expr]].some(value = alloc_expr(
                    ir.Expr.expr_integer_literal(value = long<-(lit.value), ty = types.primitive("int"))))
            ast.Expr.expr_bool_literal as b:
                return Option[ptr[ir.Expr]].some(value = alloc_expr(
                    ir.Expr.expr_boolean_literal(value = b.value, ty = ctx.bool_ty)))
            ast.Expr.expr_identifier as id:
                let entry = variables.get(id.name)
                if entry != null:
                    let v = unsafe: read(entry)
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(
                        ir.Expr.expr_integer_literal(value = v, ty = types.primitive("int"))))
                let cv_entry = ctx.analysis.const_values.get(id.name)
                if cv_entry != null:
                    let cv_val = unsafe: read(cv_entry)
                    return evaluate_const_expr_to_ir(ctx, variables, cv_val)
                if id.name == "true":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(
                        ir.Expr.expr_boolean_literal(value = true, ty = ctx.bool_ty)))
                if id.name == "false":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(
                        ir.Expr.expr_boolean_literal(value = false, ty = ctx.bool_ty)))
                return Option[ptr[ir.Expr]].none
            ast.Expr.expr_binary_op as bin:
                match evaluate_const_expr_to_ir(ctx, variables, bin.left):
                    Option.some as left_ir:
                        match evaluate_const_expr_to_ir(ctx, variables, bin.right):
                            Option.some as right_ir:
                                return evaluate_const_binary_ir(op = bin.operator, left = left_ir.value, right = right_ir.value)
                            Option.none:
                                pass
                    Option.none:
                        pass
                return Option[ptr[ir.Expr]].none
            ast.Expr.expr_unary_op as un:
                match evaluate_const_expr_to_ir(ctx, variables, un.operand):
                    Option.some as operand_ir:
                        return evaluate_const_unary_ir(op = un.operator, operand = operand_ir.value)
                    Option.none:
                        pass
                return Option[ptr[ir.Expr]].none
            ast.Expr.expr_call as call:
                match read(call.callee):
                    ast.Expr.expr_identifier as cid:
                        match try_evaluate_const_function_call(ctx, cid.name, call.args, variables):
                            Option.some as rv:
                                return Option[ptr[ir.Expr]].some(value = rv.value)
                            Option.none:
                                pass
                    _:
                        pass
                return Option[ptr[ir.Expr]].none
            ast.Expr.expr_member_access as ma:
                return evaluate_const_expr_to_ir(ctx, variables, ma.receiver)
            _:
                return Option[ptr[ir.Expr]].none


function evaluate_const_binary_ir(op: str, left: ptr[ir.Expr], right: ptr[ir.Expr]) -> Option[ptr[ir.Expr]]:
    let int_ty = types.primitive("int")
    let bool_ty = types.primitive("bool")
    let ptr_uint_ty = types.primitive("ptr_uint")
    let uint_ty = types.primitive("uint")
    unsafe:
        match read(left):
            ir.Expr.expr_integer_literal as li:
                match read(right):
                    ir.Expr.expr_integer_literal as ri:
                        let result = apply_int_op(op, li.value, ri.value)
                        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(
                                ir.Expr.expr_boolean_literal(value = result != 0, ty = bool_ty)))
                        return Option[ptr[ir.Expr]].some(value = alloc_expr(
                            ir.Expr.expr_integer_literal(value = result, ty = int_ty)))
                    _:
                        pass
            ir.Expr.expr_boolean_literal as lb:
                match read(right):
                    ir.Expr.expr_boolean_literal as rb:
                        if op == "and":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(
                                ir.Expr.expr_boolean_literal(value = lb.value and rb.value, ty = bool_ty)))
                        if op == "or":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(
                                ir.Expr.expr_boolean_literal(value = lb.value or rb.value, ty = bool_ty)))
                        if op == "==":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(
                                ir.Expr.expr_boolean_literal(value = lb.value == rb.value, ty = bool_ty)))
                        if op == "!=":
                            return Option[ptr[ir.Expr]].some(value = alloc_expr(
                                ir.Expr.expr_boolean_literal(value = lb.value != rb.value, ty = bool_ty)))
                    _:
                        pass
            _:
                pass
    return Option[ptr[ir.Expr]].none


function evaluate_const_unary_ir(op: str, operand: ptr[ir.Expr]) -> Option[ptr[ir.Expr]]:
    let int_ty = types.primitive("int")
    let bool_ty = types.primitive("bool")
    unsafe:
        match read(operand):
            ir.Expr.expr_integer_literal as iv:
                if op == "-":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(
                        ir.Expr.expr_integer_literal(value = -iv.value, ty = int_ty)))
                if op == "~":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(
                        ir.Expr.expr_integer_literal(value = ~iv.value, ty = int_ty)))
                if op == "+":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(
                        ir.Expr.expr_integer_literal(value = iv.value, ty = int_ty)))
            ir.Expr.expr_boolean_literal as bv:
                if op == "not":
                    return Option[ptr[ir.Expr]].some(value = alloc_expr(
                        ir.Expr.expr_boolean_literal(value = not bv.value, ty = bool_ty)))
            _:
                pass
    return Option[ptr[ir.Expr]].none


function make_task_type(inner: types.Type) -> types.Type:
    var args = vec.Vec[types.Type].create()
    args.push(inner)
    return types.Type.ty_generic(name = "Task", args = args.as_span())


function make_task_literal(inner: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let inner_ty = ir_expr_type(inner)
    let task_ty = make_task_type(inner_ty)
    var fields = vec.Vec[ir.AggregateField].create()
    let is_void = is_void_type_lowered(inner_ty)
    let void_ptr = types.primitive("ptr_uint")
    if not is_void:
        fields.push(ir.AggregateField(name = "value", value = inner))
    fields.push(ir.AggregateField(name = "frame",       value = alloc_expr(ir.Expr.expr_zero_init(ty = void_ptr))))
    fields.push(ir.AggregateField(name = "ready",       value = alloc_expr(ir.Expr.expr_zero_init(ty = void_ptr))))
    fields.push(ir.AggregateField(name = "set_waiter",  value = alloc_expr(ir.Expr.expr_zero_init(ty = void_ptr))))
    fields.push(ir.AggregateField(name = "release",     value = alloc_expr(ir.Expr.expr_zero_init(ty = void_ptr))))
    fields.push(ir.AggregateField(name = "take_result", value = alloc_expr(ir.Expr.expr_zero_init(ty = void_ptr))))
    fields.push(ir.AggregateField(name = "cancel",      value = alloc_expr(ir.Expr.expr_zero_init(ty = void_ptr))))
    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = task_ty, fields = fields.as_span()))


function is_void_type_lowered(t: types.Type) -> bool:
    match t:
        types.Type.ty_primitive as p:
            return p.name == "void"
        _:
            return false


function unwrap_task_value(task_expr: ptr[ir.Expr]) -> ptr[ir.Expr]:
    var inner_ty = types.primitive("void")
    let task_ty = ir_expr_type(task_expr)
    match task_ty:
        types.Type.ty_generic as g:
            if g.name == "Task" and g.args.len == 1:
                inner_ty = unsafe: read(g.args.data + 0)
        _:
            pass
    return alloc_expr(ir.Expr.expr_member(receiver = task_expr, member = "value", ty = inner_ty))


function lower_task_constructor(ctx: ref[LowerCtx], type_args: span[ast.TypeArgument], call_args: span[ast.Argument], call_ep: ptr[ast.Expr]) -> ptr[ir.Expr]:
    var task_inner = ctx.void_ty
    if type_args.len >= 1:
        task_inner = resolve_type_ref(ctx, unsafe: read(type_args.data + 0).value)
    let task_ty = make_task_type(task_inner)
    var fields = vec.Vec[ir.AggregateField].create()
    var i: ptr_uint = 0
    while i < call_args.len:
        var arg: ast.Argument
        unsafe:
            arg = read(call_args.data + i)
        var val = lower_expr(ctx, arg.arg_value)
        var fname = if arg.arg_name.is_some(): arg.arg_name.unwrap() else: j2("_", pw1_str(i))
        fields.push(ir.AggregateField(name = fname, value = val))
        i += 1
    return alloc_expr(ir.Expr.expr_aggregate_literal(ty = task_ty, fields = fields.as_span()))


function lower_multi_for(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], bindings: span[ast.ForBinding], iterables: span[ast.Expr], body_ptr: ptr[ast.Stmt]?) -> void:
    let len = bindings.len
    if len == 0 or iterables.len == 0:
        return
    let ptr_uint_ty = types.primitive("ptr_uint")
    # The host's `lower_parallel_collection_for_stmt`: prepare/lower each
    # iterable first, then allocate its `__mt_for_items_N` temp and the shared
    # `__mt_for_index_N` (the fresh-temp counter order).
    var items_names = vec.Vec[str].create()
    var iterable_types = vec.Vec[types.Type].create()
    var elem_types = vec.Vec[types.Type].create()
    var lowered_iterables = vec.Vec[ptr[ir.Expr]].create()
    var bi: ptr_uint = 0
    while bi < len:
        let ib = unsafe: iterables.data + bi
        let iterable_type = index_receiver_type(ctx, ib)
        let element_type = generic_first_arg(iterable_type)
        let lowered = lower_expr(ctx, ib)
        let items_c = fresh_c_temp_name(ctx, "for_items")
        items_names.push(items_c)
        iterable_types.push(iterable_type)
        elem_types.push(element_type)
        lowered_iterables.push(lowered)
        bi += 1
    let index_c = fresh_c_temp_name(ctx, "for_index")

    let saved_break = ctx.loop_break_label
    let saved_continue = ctx.loop_continue_label
    let saved_continue_native = ctx.loop_continue_native
    let saved_break_native = ctx.loop_break_native
    let cl = fresh_c_temp_name(ctx, "loop_continue")
    let bl = fresh_c_temp_name(ctx, "loop_break")
    ctx.loop_break_label = bl
    ctx.loop_continue_label = cl
    ctx.loop_continue_native = true
    ctx.loop_break_native = true

    let saved_loop_depth = ctx.loop_defer_depth
    ctx.loop_defer_depth = ctx.defer_stack.len()
    let body_span = lower_block(ctx, body_ptr)
    let index_ref = alloc_expr(ir.Expr.expr_name(name = index_c, ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))

    var loop_body = vec.Vec[ir.Stmt].create()
    bi = 0
    while bi < len:
        var bname: str
        unsafe:
            bname = read(bindings.data + bi).name
        let binding_c = utils.c_local_name(bname)
        let elem_ptr = elem_types.get(bi) else:
            fatal(c"lower_multi_for: missing elem type")
        let elem_ty = unsafe: read(elem_ptr)
        let items_name_ptr = items_names.get(bi) else:
            fatal(c"lower_multi_for: missing items name")
        let items_name = unsafe: read(items_name_ptr)
        let iterable_ty_ptr = iterable_types.get(bi) else:
            fatal(c"lower_multi_for: missing iterable type")
        let iterable_ty = unsafe: read(iterable_ty_ptr)
        let items_ref = alloc_expr(ir.Expr.expr_name(name = items_name, ty = iterable_ty, pointer = Option[bool].some(value = false)))
        var item_val: ptr[ir.Expr]
        if is_array_type(iterable_ty):
            item_val = alloc_expr(ir.Expr.expr_index(receiver = items_ref, index = index_ref, ty = elem_ty))
        else:
            var ptr_args = vec.Vec[types.Type].create()
            ptr_args.push(elem_ty)
            let data_ty = types.Type.ty_generic(name = "ptr", args = ptr_args.as_span())
            let data_ref = alloc_expr(ir.Expr.expr_member(receiver = items_ref, member = "data", ty = data_ty))
            item_val = alloc_expr(ir.Expr.expr_index(receiver = data_ref, index = index_ref, ty = elem_ty))
        loop_body.push(ir.Stmt.stmt_local(name = bname, linkage_name = binding_c, ty = elem_ty, value = item_val, line = 0, source_path = ""))
        bi += 1
    var si: ptr_uint = 0
    while si < body_span.len:
        unsafe:
            loop_body.push(read(body_span.data + si))
        si += 1
    if contains_label_target(loop_body.as_span(), cl):
        loop_body.push(ir.Stmt.stmt_label(name = cl))

    # The first iterable's length is the loop bound; every other iterable must
    # match it (the host's `length_checks`).
    let first_name_ptr = items_names.get(0) else:
        fatal(c"lower_multi_for: missing first items name")
    let first_ty_ptr = iterable_types.get(0) else:
        fatal(c"lower_multi_for: missing first iterable type")
    let stop_value = multi_for_stop(unsafe: read(first_name_ptr), unsafe: read(first_ty_ptr))
    var length_checks = vec.Vec[ir.Stmt].create()
    bi = 1
    while bi < len:
        let name_ptr = items_names.get(bi) else:
            break
        let ty_ptr = iterable_types.get(bi) else:
            break
        let other_stop = multi_for_stop(unsafe: read(name_ptr), unsafe: read(ty_ptr))
        let cond = alloc_expr(ir.Expr.expr_binary(operator = "!=", left = other_stop, right = stop_value, ty = ctx.bool_ty))
        let msg = alloc_expr(ir.Expr.expr_string_literal(value = "parallel for iterables must have matching lengths", ty = types.Type.ty_str, cstring = false))
        let fatal_call = alloc_expr(ir.Expr.expr_call(callee = "mt_fatal_str", arguments = single_expr_span(msg), ty = ctx.void_ty))
        var then_body = vec.Vec[ir.Stmt].create()
        then_body.push(ir.Stmt.stmt_expression(expression = fatal_call, line = 0, source_path = ""))
        length_checks.push(ir.Stmt.stmt_if(condition = cond, then_body = then_body.as_span(), else_body = Option[span[ir.Stmt]].none))
        bi += 1

    let init = alloc_stmt(ir.Stmt.stmt_local(name = index_c, linkage_name = index_c, ty = ptr_uint_ty, value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = ptr_uint_ty)), line = 0, source_path = ""))
    let condition = alloc_expr(ir.Expr.expr_binary(operator = "<", left = index_ref, right = stop_value, ty = ctx.bool_ty))
    let post_target = alloc_expr(ir.Expr.expr_name(name = index_c, ty = ptr_uint_ty, pointer = Option[bool].some(value = false)))
    let post = alloc_stmt(ir.Stmt.stmt_assignment(target = post_target, operator = "+=", value = alloc_expr(ir.Expr.expr_integer_literal(value = 1, ty = ptr_uint_ty))))
    let for_stmt = ir.Stmt.stmt_for(init = init, condition = condition, post = post, body = loop_body.as_span())

    var block_stmts = vec.Vec[ir.Stmt].create()
    bi = 0
    while bi < len:
        let name_ptr = items_names.get(bi) else:
            break
        let ty_ptr = iterable_types.get(bi) else:
            break
        let val_ptr = lowered_iterables.get(bi) else:
            break
        block_stmts.push(ir.Stmt.stmt_local(name = unsafe: read(name_ptr), linkage_name = unsafe: read(name_ptr), ty = unsafe: read(ty_ptr), value = unsafe: read(val_ptr), line = 0, source_path = ""))
        bi += 1
    var li: ptr_uint = 0
    while li < length_checks.len():
        let lc_ptr = length_checks.get(li) else:
            break
        block_stmts.push(unsafe: read(lc_ptr))
        li += 1
    block_stmts.push(for_stmt)
    if contains_label_target(loop_body.as_span(), bl):
        block_stmts.push(ir.Stmt.stmt_label(name = bl))
    output.push(ir.Stmt.stmt_block(body = block_stmts.as_span()))

    ctx.loop_break_label = saved_break
    ctx.loop_continue_label = saved_continue
    ctx.loop_continue_native = saved_continue_native
    ctx.loop_break_native = saved_break_native
    ctx.loop_defer_depth = saved_loop_depth


## The stop value of a parallel-for entry: an array's length literal or a
## span's `items.len` member.
function multi_for_stop(items_name: str, iterable_type: types.Type) -> ptr[ir.Expr]:
    let ptr_uint_ty = types.primitive("ptr_uint")
    if is_array_type(iterable_type):
        return alloc_expr(ir.Expr.expr_integer_literal(value = array_length_of(iterable_type), ty = ptr_uint_ty))
    let items_ref = alloc_expr(ir.Expr.expr_name(name = items_name, ty = iterable_type, pointer = Option[bool].some(value = false)))
    return alloc_expr(ir.Expr.expr_member(receiver = items_ref, member = "len", ty = ptr_uint_ty))


## True when a span of type parameters contains at least one non-lifetime
## parameter (i.e. the struct/deferred type requires monomorphization).
## Lifetime-only parameters (`@a`) are erased at the C level and the struct
## can be emitted directly without specialization.
function const_values_eq(a: ConstValue, b: ConstValue) -> bool:
    match a:
        ConstValue.cv_int as ai:
            match b:
                ConstValue.cv_int as bi:
                    return ai.value == bi.value
                _:
                    return false
        ConstValue.cv_str as as_:
            match b:
                ConstValue.cv_str as bs:
                    return as_.value == bs.value
                _:
                    return false
        _:
            return false


function has_non_lifetime_type_params(params: span[ast.TypeParam]) -> bool:
    var i: ptr_uint = 0
    while i < params.len:
        unsafe:
            if not read(params.data + i).is_lifetime:
                return true
        i += 1
    return false


# =============================================================================
#  Async CPS — Step 1: frame struct + synthetic functions (with await support)
# =============================================================================

## The host's `@async_binding_counter` (per *compile*, `lowering.rb:129`): a match
## arm with an `as` binding whose body awaits takes the next
## `local_match_binding_<N>` frame-field name, and the lowering advances the
## counter per payload-binding arm (the two `async_match_binding_field_key` call
## sites).  Program-scoped, not per LowerCtx: `lower_module` builds a fresh ctx
## per module while the host's count continues across the whole closure.
var async_binding_cnt: ptr_uint = 0

## The host's async analysis emulation for match bindings
## (`analyze_async_statements!`'s MatchStmt arm, analysis.rb:125-145): an arm
## with an `as` binding whose body awaits takes the next
## `local_match_binding_<N>` name from the shared counter; the host registers
## the field post-order (after the arm body's own locals), so the walk recurses
## into each arm body first.  The host's registration also advances the counter
## for arms whose payload never resolves — the name map simply stays empty for
## them (the lowering pass decides the registration).
function async_prepass_match_bindings(ctx: ref[LowerCtx], body: ptr[ast.Stmt]?) -> void:
    let bp = body else:
        return
    unsafe:
        match read(bp):
            ast.Stmt.stmt_block as blk:
                var i: ptr_uint = 0
                while i < blk.statements.len:
                    async_prepass_stmt_match_bindings(ctx, blk.statements.data + i)
                    i += 1
            _:
                pass


function async_prepass_stmt_match_bindings(ctx: ref[LowerCtx], sp: ptr[ast.Stmt]) -> void:
    unsafe:
        match read(sp):
            ast.Stmt.stmt_local as loc:
                async_prepass_match_bindings(ctx, loc.else_body)
            ast.Stmt.stmt_if as iff:
                var bi: ptr_uint = 0
                while bi < iff.branches.len:
                    async_prepass_match_bindings(ctx, read(iff.branches.data + bi).body)
                    bi += 1
                async_prepass_match_bindings(ctx, iff.else_body)
            ast.Stmt.stmt_while as w:
                async_prepass_match_bindings(ctx, w.body)
            ast.Stmt.stmt_for as f:
                async_prepass_match_bindings(ctx, f.body)
            ast.Stmt.stmt_match as m:
                var ai: ptr_uint = 0
                while ai < m.arms.len:
                    let arm_ptr = m.arms.data + ai
                    let arm = read(arm_ptr)
                    async_prepass_match_bindings(ctx, arm.body)
                    match arm.binding_name:
                        Option.some:
                            if async_mod.stmt_has_await(arm.body):
                                async_binding_cnt += 1
                                ctx.async_match_binding_names.set(reinterpret[ptr_uint](arm_ptr), j2("local_match_binding_", pw1_str(async_binding_cnt)))
                        Option.none:
                            pass
                    ai += 1
            ast.Stmt.stmt_unsafe as u:
                async_prepass_match_bindings(ctx, u.body)
            ast.Stmt.stmt_defer as d:
                async_prepass_match_bindings(ctx, d.body)
            _:
                pass


## True when the arm carries a payload (the host's `scrutinee_type.has_payload?`,
## `fields && !fields.empty?`): the gate for the async match-binding counter
## advance and the (unused) field registration.
function arm_has_payload(info: VariantInfo, arm_name: str) -> bool:
    match variant_arm_info(info, arm_name):
        Option.some as ai:
            return ai.value.field_names.len > 0
        Option.none:
            return false


## The host's param `pointer` value (`analysis.rb:20`):
## `receiver_type && receiver_editable && name == "this"` — nil for a plain
## function's params, `true` for an editable receiver (`this`) and `false` for a
## method's other params.  Used by the async ctor's params and its param-copy
## value Names (`frame_builder.rb:291,296`).
function async_param_pointer(receiver_ty_opt: Option[types.Type], receiver_editable: bool, pname: str) -> Option[bool]:
    match receiver_ty_opt:
        Option.some:
            return Option[bool].some(value = receiver_editable and pname == "this")
        Option.none:
            return Option[bool].none


## The frame-field type of an async parameter.  An editable method's `this`
## keeps its declared type as the *parameter* type and stores a pointer in the
## frame (`field_type = pointer ? pointer_to(param_type) : param_type`, the
## host's `analysis.rb:19-29`), so the constructor param renders `T *this`
## while the frame field is `T*`.
function async_param_field_type(receiver_ty_opt: Option[types.Type], receiver_editable: bool, pname: str, pty: types.Type) -> types.Type:
    match async_param_pointer(receiver_ty_opt, receiver_editable, pname):
        Option.some as ptr_flag:
            if ptr_flag.value:
                return types.Type.ty_generic(name = "ptr", args = single_ty_span(pty))
        Option.none:
            pass
    return pty


## The host's `async_info[:wake_type]` / the Task struct's `wake_fn`:
## `fn(frame: ptr[void]) -> void` (`types.rb:596-600`).
function async_wake_fn_type(ctx: ref[LowerCtx]) -> types.Type:
    return types.Type.ty_function(name = "", params = single_ty_span(ctx.ptr_void_ty), return_type = types.alloc_type(ctx.void_ty), variadic = false, is_proc = false, param_names = sp_str("frame"))


## The type of a `Types::Task` field (`types.rb:601-632`): `frame`, `ready`,
## `set_waiter`, `release`, `take_result` or `cancel`.  Anything else falls back
## to the frame pointer (the unknown field's C shape).
function task_field_type(ctx: ref[LowerCtx], result_ty: types.Type, field: str) -> types.Type:
    let void_ptr = ctx.ptr_void_ty
    if field == "ready":
        return types.Type.ty_function(name = "", params = single_ty_span(void_ptr), return_type = types.alloc_type(ctx.bool_ty), variadic = false, is_proc = false, param_names = sp_str("frame"))
    if field == "take_result":
        return types.Type.ty_function(name = "", params = single_ty_span(void_ptr), return_type = types.alloc_type(result_ty), variadic = false, is_proc = false, param_names = sp_str("frame"))
    if field == "set_waiter":
        var ptypes = vec.Vec[types.Type].create()
        ptypes.push(void_ptr)
        ptypes.push(void_ptr)
        ptypes.push(async_wake_fn_type(ctx))
        var pnames = vec.Vec[str].create()
        pnames.push("frame")
        pnames.push("waiter_frame")
        pnames.push("waiter")
        return types.Type.ty_function(name = "", params = ptypes.as_span(), return_type = types.alloc_type(ctx.void_ty), variadic = false, is_proc = false, param_names = pnames.as_span())
    if field == "release" or field == "cancel":
        return types.Type.ty_function(name = "", params = single_ty_span(void_ptr), return_type = types.alloc_type(ctx.void_ty), variadic = false, is_proc = false, param_names = sp_str("frame"))
    return void_ptr


## The `frame->result` store target (the host's
## `async_frame_field_expression(frame_expr, "result", …)`).
function async_result_target(ctx: ref[LowerCtx], res_ty: types.Type) -> ptr[ir.Expr]:
    let frame_exp = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false)))
    return alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "result", ty = res_ty))


## The host's `async_complete_statements` (`async_lowering.rb:1271`): store the
## result (when one is given), mark the frame ready, wake a registered waiter and
## return.  Emitted inline at every `return` and `?`-failure inside an async
## resume body (the self's replacement for the old completion label).
function async_complete_statements(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], res_ty: types.Type, result_value: Option[ptr[ir.Expr]]) -> void:
    let bool_ty = ctx.bool_ty
    let void_ptr = ctx.ptr_void_ty
    let frame_exp = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false)))
    match result_value:
        Option.some as rv:
            if not is_void_type_lowered(res_ty):
                output.push(ir.Stmt.stmt_assignment(
                    target = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "result", ty = res_ty)),
                    operator = "=",
                    value = rv.value,
                ))
        Option.none:
            pass
    output.push(ir.Stmt.stmt_assignment(
        target = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "ready", ty = bool_ty)),
        operator = "=",
        value = alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = bool_ty)),
    ))
    let waiter_frame_field = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "waiter_frame", ty = void_ptr))
    var wake_body = vec.Vec[ir.Stmt].create()
    wake_body.push(ir.Stmt.stmt_local(name = "waiter_frame", linkage_name = "__mt_waiter_frame", ty = void_ptr, value = waiter_frame_field, line = 0, source_path = ""))
    wake_body.push(ir.Stmt.stmt_assignment(target = waiter_frame_field, operator = "=", value = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr))))
    wake_body.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(
        callee = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "waiter", ty = async_wake_fn_type(ctx))),
        arguments = single_expr_span(alloc_expr(ir.Expr.expr_name(name = "__mt_waiter_frame", ty = void_ptr, pointer = Option[bool].some(value = false)))),
        ty = ctx.void_ty,
    )), line = 0, source_path = ""))
    wake_body.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    let has_waiter = alloc_expr(ir.Expr.expr_binary(
        operator = "!=",
        left = waiter_frame_field,
        right = alloc_expr(ir.Expr.expr_null_literal(ty = void_ptr)),
        ty = bool_ty,
    ))
    output.push(ir.Stmt.stmt_if(condition = has_waiter, then_body = wake_body.as_span(), else_body = Option[span[ir.Stmt]].none))
    output.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))


## True when a lowered statement sequence always transfers control — the IR-level
## mirror of the host's `cfg_block_always_terminates?` (used to decide whether an
## async resume needs a trailing completion for a void result; structured like
## `c_backend.body_terminates`).
function async_block_terminates(stmts: span[ir.Stmt]) -> bool:
    if stmts.len == 0:
        return false
    unsafe:
        return async_stmt_terminates(stmts.data + (stmts.len - 1))


function async_stmt_terminates(sp: ptr[ir.Stmt]) -> bool:
    unsafe:
        match read(sp):
            ir.Stmt.stmt_return:
                return true
            ir.Stmt.stmt_break:
                return true
            ir.Stmt.stmt_continue:
                return true
            ir.Stmt.stmt_goto:
                return true
            ir.Stmt.stmt_block as blk:
                return async_block_terminates(blk.body)
            ir.Stmt.stmt_if as iff:
                match iff.else_body:
                    Option.some as eb:
                        return async_block_terminates(iff.then_body) and async_block_terminates(eb.value)
                    Option.none:
                        return false
            _:
                return false


## Lower an async function: generate frame struct, resume fn, constructor fn,
## and vtable helpers.  Push into the output structs/functions collections.
## Supports both no-await (single-state) and full CPS (state-machine) paths.
function lower_async_fn(ctx: ref[LowerCtx], name: str, link_base: str, receiver_ty_opt: Option[types.Type], receiver_editable: bool, params: span[ast.Param], return_type: ptr[ast.TypeRef]?, body: ptr[ast.Stmt]?, functions: ref[vec.Vec[ir.Function]], synthetic_ctor: bool) -> void:
    # Function-level state starts fresh (the host's per-function env): the
    # fresh-temp counter, format destination and cstr metadata.
    ctx.locals.clear()
    ctx.temp_counter = 0
    ctx.fmt_dest_name = ""
    ctx.fmt_counter.clear()
    ctx.fmt_counter_visible = false
    ctx.cstr_backed_names.clear()
    var saved_current_fn = ctx.current_function_linkage
    ctx.current_function_linkage = link_base
    # Reset async CPS state so a no-await function (or the next function) never
    # inherits a previous has-await function's frame state.
    ctx.async_cps_active = false
    ctx.async_completion_active = false
    ctx.async_await_counter = 0
    ctx.async_tmp_counter = 0
    ctx.async_local_fields = vec.Vec[ir.Field].create()
    ctx.async_await_fields = vec.Vec[ir.Field].create()
    ctx.async_local_seen = map_mod.Map[str, bool].create()
    ctx.async_format_str_fields = vec.Vec[str].create()
    let sig = lookup_fn_sig(ctx, name)
    let res_ty = resolve_return_type(ctx, sig, return_type)
    let bool_ty = ctx.bool_ty
    let int_ty = types.primitive("int")
    let void_t = ctx.void_ty
    let is_void_ret = is_void_type_lowered(res_ty)
    # `link_base` is the constructor's C linkage (e.g. `<mod>_main`, or a method's
    # `<mod>_Type_method`); the frame/resume names derive from it with the
    # host's double underscore (`#{constructor_linkage_name}__frame`,
    # `...__resume`; `functions.rb:199-200`).
    let frame_c = j2(link_base, "__frame")
    let resume_c = j2(link_base, "__resume")
    let task_ty = make_task_type(res_ty)
    let has_await = async_mod.body_has_await(body)
    # The host analyzes the normalized body before lowering it
    # (`analyze_async_function` → `lower_async_function_decl`); its match-binding
    # registrations are what name the frame's `local_match_binding_<N>` fields.
    async_prepass_match_bindings(ctx, body)
    # The host appends the frame struct to `@artifacts.synthetic_structs` before
    # the body's lowering (`functions.rb:210`), so a body-created struct (a proc
    # env) follows it.  The frame's fields are only known after the body, so
    # remember the insertion point and insert the frame there.
    let frame_index = ctx.pending_synthetic_structs.len()
    let ptr_ty = ptr_uint_type()
    let frame_ty = types.Type.ty_named(linkage_name = Option[str].none, module_name = "", name = frame_c)
    let frame_ptr_ty = types.Type.ty_generic(name = "ptr", args = single_ty_span(frame_ty))

    # Common vtable param: void* __mt_frame_raw
    var waiter_fn_ty = types.Type.ty_function(name = "", params = single_ty_span(ctx.ptr_void_ty), return_type = types.alloc_type(ctx.void_ty), variadic = false, is_proc = false, param_names = sp_str("frame"))
    var vparams = vec.Vec[ir.Param].create()
    vparams.push(ir.Param(name = "frame", linkage_name = "__mt_frame_raw", ty = ctx.ptr_void_ty, pointer = Option[bool].some(value = false)))
    let vparam_s = vparams.as_span()
    let raw_expr = alloc_expr(ir.Expr.expr_name(name = "__mt_frame_raw", ty = ctx.ptr_void_ty, pointer = Option[bool].some(value = false)))

    # Param frame-field info.  Fields are named `param_<name>` so they cannot
    # clash with control fields (`state`/`result`/…).  For an async method the
    # receiver is prepended as an implicit `this` param.
    var ctor_param_names = vec.Vec[str].create()
    var ctor_param_tys = vec.Vec[types.Type].create()
    # The frame's field types differ from the constructor's parameter types for
    # an editable receiver (pointer in the frame, value in the signature).
    var ctor_field_tys = vec.Vec[types.Type].create()
    match receiver_ty_opt:
        Option.some as rty:
            ctor_param_names.push("this")
            ctor_param_tys.push(rty.value)
            ctor_field_tys.push(async_param_field_type(receiver_ty_opt, receiver_editable, "this", rty.value))
        Option.none:
            pass
    var pi: ptr_uint = 0
    while pi < params.len:
        var p: ast.Param
        unsafe:
            p = read(params.data + pi)
        let p_ty = resolve_param_type(ctx, sig, pi, p.param_type)
        ctor_param_names.push(p.name)
        ctor_param_tys.push(p_ty)
        ctor_field_tys.push(async_param_field_type(receiver_ty_opt, receiver_editable, p.name, p_ty))
        pi += 1

    # --- resume function body ---
    ctx.locals.clear()
    var resume_body = vec.Vec[ir.Stmt].create()
    resume_body.push(ir.Stmt.stmt_local(name = "__mt_frame", linkage_name = "__mt_frame", ty = frame_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = frame_ptr_ty, expression = raw_expr, ty = frame_ptr_ty)), line = 0, source_path = ""))
    # The pointer lives in the type, not the `Name` (the host's `frame_expr`).
    let frame_exp = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = frame_ptr_ty, pointer = Option[bool].some(value = false)))
    # Register each param as a frame-field binding so references resolve to
    # `__mt_frame->param_<name>` (surviving suspend/resume); no C-local copy.
    var pib: ptr_uint = 0
    while pib < ctor_param_names.len:
        var pname: str
        var pty: types.Type
        unsafe:
            pname = read(ptr[str]<-ctor_param_names.data + pib)
            pty = read(ptr[types.Type]<-ctor_param_tys.data + pib)
        # The binding keeps the declared parameter type; an editable receiver is
        # a pointer-flagged base-typed name (the host's env: `type:
        # param_binding.type, pointer:`), whose frame storage is `ptr[T]`.
        let binding_ptr = async_param_pointer(receiver_ty_opt, receiver_editable, pname)
        ctx.locals.push(LocalBinding(name = pname, c_name = j2("__mt_frame->param_", pname), ty = pty, pointer = binding_ptr))
        pib += 1

    if has_await:
        # Full CPS: spill locals to frame fields, split awaits into a goto state
        # machine.  `lower_function_body` reuses the normal statement lowering;
        # `ctx.async_cps_active` redirects local decls and await-valued statements
        # (see `lower_async_local` / `lower_async_await_into`), and
        # `ctx.async_completion_active` rewrites returns/`?`-failures into the
        # host's inline frame completion.
        ctx.async_cps_active = true
        ctx.async_frame_ptr_ty = frame_ptr_ty
        ctx.async_resume_c = resume_c
        ctx.async_result_ty = res_ty
        ctx.async_result_is_void = is_void_ret
        var saved_completion = ctx.async_completion_active
        ctx.async_completion_active = true
        # Fresh field vecs for this function.
        ctx.async_await_counter = 0
        ctx.async_local_fields = vec.Vec[ir.Field].create()
        ctx.async_await_fields = vec.Vec[ir.Field].create()
        ctx.async_local_seen = map_mod.Map[str, bool].create()
        ctx.async_format_str_fields = vec.Vec[str].create()
        # Create LOCAL vec vars and point to THEM (NOT to ctx fields).  The ctx
        # fields are reassigned by nested lower_async_fn calls; a LOCAL variable
        # is immune to that, so pushes through the pointer always land here.
        var my_await_fields = ctx.async_await_fields
        var my_local_fields = ctx.async_local_fields
        var my_format_str_fields = ctx.async_format_str_fields
        let saved_await_ptr = ctx.async_await_fields_ptr
        let saved_local_ptr = ctx.async_local_fields_ptr
        let saved_format_str_ptr = ctx.async_format_str_fields_ptr
        ctx.async_await_fields_ptr = ptr_of(my_await_fields)
        ctx.async_local_fields_ptr = ptr_of(my_local_fields)
        ctx.async_format_str_fields_ptr = ptr_of(my_format_str_fields)
        var saved_rt = ctx.current_fn_return_type
        ctx.current_fn_return_type = res_ty
        var saved_inside = ctx.inside_async
        ctx.inside_async = true

        var body_stmts = lower_function_body(ctx, body)
        let await_count = ctx.async_await_counter
        # Copy the accumulated fields back to ctx so the frame builder picks them
        # up (ctx fields may have been reassigned by nested lower_async_fn calls).
        ctx.async_local_fields = my_local_fields
        ctx.async_await_fields = my_await_fields
        ctx.async_format_str_fields = my_format_str_fields
        ctx.async_await_fields_ptr = saved_await_ptr
        ctx.async_local_fields_ptr = saved_local_ptr
        ctx.async_format_str_fields_ptr = saved_format_str_ptr

        ctx.async_cps_active = false
        ctx.async_completion_active = saved_completion
        ctx.current_fn_return_type = saved_rt
        ctx.inside_async = saved_inside

        # Dispatch: `switch (state) { case i: goto state_i; } return;`
        var dcases = vec.Vec[ir.SwitchCase].create()
        var ds: ptr_uint = 0
        while ds <= await_count:
            var gbody = vec.Vec[ir.Stmt].create()
            gbody.push(ir.Stmt.stmt_goto(label = async_state_label(resume_c, int<-ds)))
            dcases.push(ir.SwitchCase(is_default = false, value = alloc_expr(ir.Expr.expr_integer_literal(value = long<-ds, ty = int_ty)), body = gbody.as_span()))
            ds += 1
        resume_body.push(ir.Stmt.stmt_switch(expression = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "state", ty = int_ty)), cases = dcases.as_span(), exhaustive = false))
        resume_body.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
        resume_body.push(ir.Stmt.stmt_label(name = async_state_label(resume_c, 0)))
        var bci: ptr_uint = 0
        while bci < body_stmts.len:
            resume_body.push(unsafe: read(body_stmts.data + bci))
            bci += 1
        # A void result whose body can fall through completes the frame at the
        # end (the host's `cfg_block_always_terminates?` guard); every return
        # already completed it inline.
        if is_void_ret and not async_block_terminates(body_stmts):
            async_complete_statements(ctx, ref_of(resume_body), res_ty, Option[ptr[ir.Expr]].none)
    else:
        # No awaits: single-state body.  Returns complete the frame inline (the
        # host's `lower_async_non_await_statements` + `async_complete_statements`).
        # The host's async analysis still records every local declaration's
        # `local_<name>` frame field (the body lowers plain locals, so the field
        # is dead, but the frame carries it).
        var noawait_locals = ctx.async_local_fields
        let saved_nf_ptr = ctx.async_local_fields_ptr
        ctx.async_local_fields_ptr = ptr_of(noawait_locals)
        async_register_normalized_body_fields(ctx, body)
        ctx.async_local_fields = noawait_locals
        ctx.async_local_fields_ptr = saved_nf_ptr
        ctx.async_frame_ptr_ty = frame_ptr_ty
        ctx.async_result_ty = res_ty
        ctx.async_result_is_void = is_void_ret
        ctx.async_completion_active = true
        var saved_rt = ctx.current_fn_return_type
        ctx.current_fn_return_type = res_ty
        var saved_inside = ctx.inside_async
        ctx.inside_async = true
        var body_ir = lower_function_body(ctx, body)
        ctx.async_completion_active = false
        var bi: ptr_uint = 0
        while bi < body_ir.len:
            resume_body.push(unsafe: read(body_ir.data + bi))
            bi += 1
        if is_void_ret and not async_block_terminates(body_ir):
            async_complete_statements(ctx, ref_of(resume_body), res_ty, Option[ptr[ir.Expr]].none)
        ctx.current_fn_return_type = saved_rt
        ctx.inside_async = saved_inside
    # The host's `lower_async_function_decl` appends the resume and the vtable
    # helpers to the program-wide `@artifacts.synthetic_functions` tail (after
    # every module's functions), while the constructor stays in the declaring
    # module's list (`functions.rb:199-215`).
    ctx.pending_synthetic_functions.push(ir.Function(name = j2(name, "__resume"), linkage_name = resume_c, params = vparam_s, return_type = void_t, body = resume_body.as_span(), entry_point = false, public_export = false, method_receiver_param = false))

    # -- frame struct (base + state + result + params + spilled locals + awaits) --
    var ff = vec.Vec[ir.Field].create()
    ff.push(ir.Field(name = "ready",        ty = bool_ty))
    ff.push(ir.Field(name = "cancelled",    ty = bool_ty))
    ff.push(ir.Field(name = "waiter_frame", ty = ctx.ptr_void_ty))
    ff.push(ir.Field(name = "waiter",       ty = waiter_fn_ty))
    if has_await:
        ff.push(ir.Field(name = "state",    ty = int_ty))
    if not is_void_ret:
        ff.push(ir.Field(name = "result",   ty = res_ty))
    var pif: ptr_uint = 0
    while pif < ctor_param_names.len:
        var pfname: str
        var pfty: types.Type
        unsafe:
            pfname = read(ptr[str]<-ctor_param_names.data + pif)
            pfty = read(ptr[types.Type]<-ctor_field_tys.data + pif)
        ff.push(ir.Field(name = j2("param_", pfname), ty = pfty))
        pif += 1
    var lfi: ptr_uint = 0
    while lfi < ctx.async_local_fields.len():
        let lfp = ctx.async_local_fields.get(lfi) else:
            break
        ff.push(unsafe: read(lfp))
        lfi += 1
    var afi: ptr_uint = 0
    while afi < ctx.async_await_fields.len():
        let afp = ctx.async_await_fields.get(afi) else:
            break
        let af = unsafe: read(afp)
        var already_present = false
        var ffi: ptr_uint = 0
        while ffi < ff.len():
            let existing = ff.get(ffi) else:
                break
            if unsafe: read(existing).name == af.name:
                already_present = true
            ffi += 1
        if not already_present:
            ff.push(af)
        afi += 1
    let _inserted = ctx.pending_synthetic_structs.insert(frame_index, ir.StructDecl(name = frame_c, linkage_name = frame_c, fields = ff.as_span(), packed = false, alignment = 0, source_module = Option[str].none))

    # Shared bool exprs for vtable/constructor
    let bool_true = alloc_expr(ir.Expr.expr_boolean_literal(value = true, ty = bool_ty))


    # -- vtable linkage names --
    let ready_lk  = j2(link_base, "__ready")
    let waiter_lk = j2(link_base, "__set_waiter")
    let release_lk = j2(link_base, "__release")
    let take_lk   = j2(link_base, "__take_result")
    let cancel_lk = j2(link_base, "__cancel")

    # -- vtable: ready (fresh vec) --
    var vrdy = vec.Vec[ir.Stmt].create()
    vrdy.push(ir.Stmt.stmt_local(name = "__mt_frame", linkage_name = "__mt_frame", ty = frame_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = frame_ptr_ty, expression = raw_expr, ty = frame_ptr_ty)), line = 0, source_path = ""))
    vrdy.push(ir.Stmt.stmt_return(value = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "ready", ty = bool_ty)), line = 0, source_path = ""))
    ctx.pending_synthetic_functions.push(ir.Function(name = j2(ready_lk, "_fn"), linkage_name = ready_lk, params = vparam_s, return_type = bool_ty, body = vrdy.as_span(), entry_point = false, public_export = false, method_receiver_param = false))

    # -- vtable: set_waiter (fresh vec) --
    let wake_fn_ty = async_wake_fn_type(ctx)
    var vsw = vec.Vec[ir.Stmt].create()
    vsw.push(ir.Stmt.stmt_local(name = "__mt_frame", linkage_name = "__mt_frame", ty = frame_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = frame_ptr_ty, expression = raw_expr, ty = frame_ptr_ty)), line = 0, source_path = ""))
    # If already ready, call the waiter immediately (synchronous completion).
    var sw_rdy = vec.Vec[ir.Stmt].create()
    let sw_waiter_fn = alloc_expr(ir.Expr.expr_name(name = "waiter", ty = wake_fn_ty, pointer = Option[bool].some(value = false)))
    let sw_waiter_frame = alloc_expr(ir.Expr.expr_name(name = "waiter_frame", ty = ctx.ptr_void_ty, pointer = Option[bool].some(value = false)))
    sw_rdy.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(callee = sw_waiter_fn, arguments = single_expr_span(sw_waiter_frame), ty = void_t)), line = 0, source_path = ""))
    sw_rdy.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    let sw_ready_cond = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "ready", ty = bool_ty))
    vsw.push(ir.Stmt.stmt_if(condition = sw_ready_cond, then_body = sw_rdy.as_span(), else_body = Option[span[ir.Stmt]].none))
    vsw.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "waiter_frame", ty = ctx.ptr_void_ty)), operator = "=", value = sw_waiter_frame))
    vsw.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "waiter", ty = wake_fn_ty)), operator = "=", value = sw_waiter_fn))
    vsw.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    var sw_params = vec.Vec[ir.Param].create()
    sw_params.push(ir.Param(name = "frame", linkage_name = "__mt_frame_raw", ty = ctx.ptr_void_ty, pointer = Option[bool].some(value = false)))
    sw_params.push(ir.Param(name = "waiter_frame", linkage_name = "waiter_frame", ty = ctx.ptr_void_ty, pointer = Option[bool].some(value = false)))
    sw_params.push(ir.Param(name = "waiter", linkage_name = "waiter", ty = wake_fn_ty, pointer = Option[bool].some(value = false)))
    ctx.pending_synthetic_functions.push(ir.Function(name = j2(waiter_lk, "_fn"), linkage_name = waiter_lk, params = sw_params.as_span(), return_type = void_t, body = vsw.as_span(), entry_point = false, public_export = false, method_receiver_param = false))

    # -- vtable: release (fresh vec) --
    var vrel = vec.Vec[ir.Stmt].create()
    vrel.push(ir.Stmt.stmt_local(name = "__mt_frame", linkage_name = "__mt_frame", ty = frame_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = frame_ptr_ty, expression = raw_expr, ty = frame_ptr_ty)), line = 0, source_path = ""))
    # If not yet ready, release the pending await tasks and return without
    # freeing (the host's `build_async_release_function`).
    var rel_if_body = vec.Vec[ir.Stmt].create()
    if has_await:
        var afi: ptr_uint = 0
        while afi < ctx.async_await_fields.len():
            let afp = ctx.async_await_fields.get(afi) else:
                break
            let af = unsafe: read(afp)
            let af_task = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = af.name, ty = af.ty))
            let af_frame = alloc_expr(ir.Expr.expr_member(receiver = af_task, member = "frame", ty = task_field_type(ctx, res_ty, "frame")))
            var af_release_body = vec.Vec[ir.Stmt].create()
            let af_release_fn = alloc_expr(ir.Expr.expr_member(receiver = af_task, member = "release", ty = task_field_type(ctx, res_ty, "release")))
            af_release_body.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(callee = af_release_fn, arguments = single_expr_span(af_frame), ty = void_t)), line = 0, source_path = ""))
            rel_if_body.push(ir.Stmt.stmt_if(condition = af_frame, then_body = af_release_body.as_span(), else_body = Option[span[ir.Stmt]].none))
            afi += 1
    rel_if_body.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call(callee = "mt_async_free", arguments = single_expr_span(raw_expr), ty = void_t)), line = 0, source_path = ""))
    rel_if_body.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    let not_ready = alloc_expr(ir.Expr.expr_unary(operator = "not", operand = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "ready", ty = bool_ty)), ty = bool_ty))
    vrel.push(ir.Stmt.stmt_if(condition = not_ready, then_body = rel_if_body.as_span(), else_body = Option[span[ir.Stmt]].none))
    # Proc-storing frame fields release their references before the frame is
    # freed (the host's `frame_builder.rb:455-470`: non-pointer params first,
    # then the spilled locals).
    var rpi: ptr_uint = 0
    while rpi < ctor_param_names.len:
        var rpname: str
        var rpty: types.Type
        unsafe:
            rpname = read(ptr[str]<-ctor_param_names.data + rpi)
            rpty = read(ptr[types.Type]<-ctor_field_tys.data + rpi)
        var rp_is_ptr = false
        match async_param_pointer(receiver_ty_opt, receiver_editable, rpname):
            Option.some as ap:
                rp_is_ptr = ap.value
            Option.none:
                pass
        if not rp_is_ptr and contains_proc_storage_type(ctx, rpty):
            let rp_field = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = j2("param_", rpname), ty = rpty))
            proc_nullable_release_stmts(ctx, rp_field, rpty, ref_of(vrel))
        rpi += 1
    var rli: ptr_uint = 0
    while rli < ctx.async_local_fields.len():
        let rlfp = ctx.async_local_fields.get(rli) else:
            break
        let rlf = unsafe: read(rlfp)
        if contains_proc_storage_type(ctx, rlf.ty):
            let rl_field = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = rlf.name, ty = rlf.ty))
            proc_nullable_release_stmts(ctx, rl_field, rlf.ty, ref_of(vrel))
        rli += 1
    # A dynamic format string stored in the frame is freed when the task is
    # released (`frame_builder.rb:472-481`).
    var rfsi: ptr_uint = 0
    while rfsi < ctx.async_format_str_fields.len():
        let rfsp = ctx.async_format_str_fields.get(rfsi) else:
            break
        let rf_field = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = unsafe: read(rfsp), ty = types.Type.ty_str))
        vrel.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call(callee = "mt_format_str_release", arguments = single_expr_span(rf_field), ty = void_t)), line = 0, source_path = ""))
        rfsi += 1
    # Pointer-lowered params are heap copies; free them before the frame
    # (`frame_builder.rb:483-490`).
    var rppi: ptr_uint = 0
    while rppi < ctor_param_names.len:
        var rpp_name: str
        var rpp_ty: types.Type
        unsafe:
            rpp_name = read(ptr[str]<-ctor_param_names.data + rppi)
            rpp_ty = read(ptr[types.Type]<-ctor_field_tys.data + rppi)
        var rpp_is_ptr = false
        match async_param_pointer(receiver_ty_opt, receiver_editable, rpp_name):
            Option.some as app:
                rpp_is_ptr = app.value
            Option.none:
                pass
        if rpp_is_ptr:
            let rpp_field = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = j2("param_", rpp_name), ty = rpp_ty))
            vrel.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call(callee = "mt_async_free", arguments = single_expr_span(rpp_field), ty = void_t)), line = 0, source_path = ""))
        rppi += 1
    vrel.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call(callee = "mt_async_free", arguments = single_expr_span(raw_expr), ty = void_t)), line = 0, source_path = ""))
    vrel.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    ctx.pending_synthetic_functions.push(ir.Function(name = j2(release_lk, "_fn"), linkage_name = release_lk, params = vparam_s, return_type = void_t, body = vrel.as_span(), entry_point = false, public_export = false, method_receiver_param = false))

    # -- vtable: take_result (fresh vec) --
    # The host emits this vtable entry for every async function; a void result's
    # body is a bare return (`frame_builder.rb build_async_take_result_function`),
    # and the constructor aggregate carries the field either way.
    var vtr = vec.Vec[ir.Stmt].create()
    if is_void_ret:
        vtr.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    else:
        vtr.push(ir.Stmt.stmt_local(name = "__mt_frame", linkage_name = "__mt_frame", ty = frame_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = frame_ptr_ty, expression = raw_expr, ty = frame_ptr_ty)), line = 0, source_path = ""))
        vtr.push(ir.Stmt.stmt_return(value = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "result", ty = res_ty)), line = 0, source_path = ""))
    ctx.pending_synthetic_functions.push(ir.Function(name = j2(take_lk, "_fn"), linkage_name = take_lk, params = vparam_s, return_type = res_ty, body = vtr.as_span(), entry_point = false, public_export = false, method_receiver_param = false))

    # -- vtable: cancel (fresh vec) --
    var vcn = vec.Vec[ir.Stmt].create()
    vcn.push(ir.Stmt.stmt_local(name = "__mt_frame", linkage_name = "__mt_frame", ty = frame_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = frame_ptr_ty, expression = raw_expr, ty = frame_ptr_ty)), line = 0, source_path = ""))
    # An already-ready frame returns without cancelling anything.
    var cn_ready_body = vec.Vec[ir.Stmt].create()
    cn_ready_body.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    vcn.push(ir.Stmt.stmt_if(condition = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "ready", ty = bool_ty)), then_body = cn_ready_body.as_span(), else_body = Option[span[ir.Stmt]].none))
    vcn.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_assignment(target = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "cancelled", ty = bool_ty)), operator = "=", value = bool_true)), line = 0, source_path = ""))
    if has_await:
        var cfi: ptr_uint = 0
        while cfi < ctx.async_await_fields.len():
            let cfp = ctx.async_await_fields.get(cfi) else:
                break
            let cf = unsafe: read(cfp)
            let cf_task = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = cf.name, ty = cf.ty))
            let cf_frame = alloc_expr(ir.Expr.expr_member(receiver = cf_task, member = "frame", ty = task_field_type(ctx, res_ty, "frame")))
            var cf_then = vec.Vec[ir.Stmt].create()
            var cf_cancel_body = vec.Vec[ir.Stmt].create()
            let cf_cancel_fn = alloc_expr(ir.Expr.expr_member(receiver = cf_task, member = "cancel", ty = task_field_type(ctx, res_ty, "cancel")))
            cf_cancel_body.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(callee = cf_cancel_fn, arguments = single_expr_span(cf_frame), ty = void_t)), line = 0, source_path = ""))
            let cf_has_cancel = alloc_expr(ir.Expr.expr_member(receiver = cf_task, member = "cancel", ty = task_field_type(ctx, res_ty, "cancel")))
            cf_then.push(ir.Stmt.stmt_if(condition = cf_has_cancel, then_body = cf_cancel_body.as_span(), else_body = Option[span[ir.Stmt]].none))
            let cf_release_fn = alloc_expr(ir.Expr.expr_member(receiver = cf_task, member = "release", ty = task_field_type(ctx, res_ty, "release")))
            cf_then.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(callee = cf_release_fn, arguments = single_expr_span(cf_frame), ty = void_t)), line = 0, source_path = ""))
            vcn.push(ir.Stmt.stmt_if(condition = cf_frame, then_body = cf_then.as_span(), else_body = Option[span[ir.Stmt]].none))
            cfi += 1
    # Proc-storing frame fields release their references on cancel too (the
    # host's `frame_builder.rb:551-564`, before the ready store).
    var cpi: ptr_uint = 0
    while cpi < ctor_param_names.len:
        var cpname: str
        var cpty: types.Type
        unsafe:
            cpname = read(ptr[str]<-ctor_param_names.data + cpi)
            cpty = read(ptr[types.Type]<-ctor_field_tys.data + cpi)
        var cp_is_ptr = false
        match async_param_pointer(receiver_ty_opt, receiver_editable, cpname):
            Option.some as ap:
                cp_is_ptr = ap.value
            Option.none:
                pass
        if not cp_is_ptr and contains_proc_storage_type(ctx, cpty):
            let cp_field = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = j2("param_", cpname), ty = cpty))
            proc_nullable_release_stmts(ctx, cp_field, cpty, ref_of(vcn))
        cpi += 1
    var cli: ptr_uint = 0
    while cli < ctx.async_local_fields.len():
        let clfp = ctx.async_local_fields.get(cli) else:
            break
        let clf = unsafe: read(clfp)
        if contains_proc_storage_type(ctx, clf.ty):
            let cl_field = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = clf.name, ty = clf.ty))
            proc_nullable_release_stmts(ctx, cl_field, clf.ty, ref_of(vcn))
        cli += 1
    # A dynamic format string stored in the frame is freed on cancel too
    # (`frame_builder.rb:566-575`).
    var cfsi: ptr_uint = 0
    while cfsi < ctx.async_format_str_fields.len():
        let cfsp = ctx.async_format_str_fields.get(cfsi) else:
            break
        let cf_field = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = unsafe: read(cfsp), ty = types.Type.ty_str))
        vcn.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call(callee = "mt_format_str_release", arguments = single_expr_span(cf_field), ty = void_t)), line = 0, source_path = ""))
        cfsi += 1
    # Pointer-lowered params are heap copies; cancel frees them before marking
    # the frame ready (`frame_builder.rb:577-591`).
    var cppi: ptr_uint = 0
    while cppi < ctor_param_names.len:
        var cpp_name: str
        var cpp_ty: types.Type
        unsafe:
            cpp_name = read(ptr[str]<-ctor_param_names.data + cppi)
            cpp_ty = read(ptr[types.Type]<-ctor_field_tys.data + cppi)
        var cpp_is_ptr = false
        match async_param_pointer(receiver_ty_opt, receiver_editable, cpp_name):
            Option.some as ap:
                cpp_is_ptr = ap.value
            Option.none:
                pass
        if cpp_is_ptr:
            let cpp_field = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = j2("param_", cpp_name), ty = cpp_ty))
            vcn.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call(callee = "mt_async_free", arguments = single_expr_span(cpp_field), ty = void_t)), line = 0, source_path = ""))
        cppi += 1
    vcn.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_assignment(target = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "ready", ty = bool_ty)), operator = "=", value = bool_true)), line = 0, source_path = ""))
    let cn_waiter_frame = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "waiter_frame", ty = ctx.ptr_void_ty))
    var cn_wake_body = vec.Vec[ir.Stmt].create()
    cn_wake_body.push(ir.Stmt.stmt_local(name = "waiter_frame", linkage_name = "__mt_waiter_frame", ty = ctx.ptr_void_ty, value = cn_waiter_frame, line = 0, source_path = ""))
    cn_wake_body.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_assignment(target = cn_waiter_frame, operator = "=", value = alloc_expr(ir.Expr.expr_null_literal(ty = ctx.ptr_void_ty)))), line = 0, source_path = ""))
    cn_wake_body.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(
        callee = alloc_expr(ir.Expr.expr_name(name = "__mt_frame->waiter", ty = wake_fn_ty, pointer = Option[bool].some(value = false))),
        arguments = single_expr_span(alloc_expr(ir.Expr.expr_name(name = "__mt_waiter_frame", ty = ctx.ptr_void_ty, pointer = Option[bool].some(value = false)))),
        ty = void_t,
    )), line = 0, source_path = ""))
    vcn.push(ir.Stmt.stmt_if(condition = cn_waiter_frame, then_body = cn_wake_body.as_span(), else_body = Option[span[ir.Stmt]].none))
    vcn.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    ctx.pending_synthetic_functions.push(ir.Function(name = j2(cancel_lk, "_fn"), linkage_name = cancel_lk, params = vparam_s, return_type = void_t, body = vcn.as_span(), entry_point = false, public_export = false, method_receiver_param = false))

    # -- constructor function --
    let size_expr = alloc_expr(ir.Expr.expr_sizeof(target_type = frame_ty, ty = ptr_ty))
    # The frame comes from the host's refcounted `mt_async_alloc`
    # (`frame_builder.rb:270-283`): one `sizeof` argument, the call typed
    # `ptr[void]`, zeroed by the allocator's calloc.
    let alloc_call = alloc_expr(ir.Expr.expr_call(callee = "mt_async_alloc", arguments = pack_single(size_expr), ty = ctx.ptr_void_ty))
    var ctor_body = vec.Vec[ir.Stmt].create()
    ctor_body.push(ir.Stmt.stmt_local(name = "__mt_frame", linkage_name = "__mt_frame", ty = frame_ptr_ty, value = alloc_expr(ir.Expr.expr_cast(target_type = frame_ptr_ty, expression = alloc_call, ty = frame_ptr_ty)), line = 0, source_path = ""))
    # The frame `Name` is not marked as a pointer — the pointer lives in the
    # type (the host's `frame_expr`, `frame_builder.rb:267`) — and the resume
    # call / aggregate carry its `ptr[void]` cast (`raw_frame_expr`).
    let cframe = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = frame_ptr_ty, pointer = Option[bool].some(value = false)))
    let raw_cframe = alloc_expr(ir.Expr.expr_cast(target_type = ctx.ptr_void_ty, expression = cframe, ty = ctx.ptr_void_ty))
    # `ready`/`cancelled`/`state` start zeroed by `mt_async_alloc`'s calloc — the
    # host's ctor stores none of them.
    # Copy constructor params to frame fields.
    var pi3: ptr_uint = 0
    while pi3 < ctor_param_names.len:
        var pname: str
        var pty: types.Type
        var fty: types.Type
        unsafe:
            let rawdata = ctor_param_names.data
            if rawdata == null:
                fatal(c"lowering: async ctor param names missing storage")
            pname = read(ptr[str]<-rawdata + pi3)
            let rawt = ctor_param_tys.data
            if rawt == null:
                fatal(c"lowering: async ctor param types missing storage")
            pty = read(ptr[types.Type]<-rawt + pi3)
            let rawf = ctor_field_tys.data
            if rawf == null:
                fatal(c"lowering: async ctor field types missing storage")
            fty = read(ptr[types.Type]<-rawf + pi3)
        # The store target is typed with the frame field; the value Name carries
        # the declared parameter type with the pointer flag (the host's
        # `param_type` vs `field_type` split).
        let field_expr = alloc_expr(ir.Expr.expr_member(receiver = cframe, member = j2("param_", pname), ty = fty))
        let arg_pointer = async_param_pointer(receiver_ty_opt, receiver_editable, pname)
        let arg_expr = alloc_expr(ir.Expr.expr_name(name = pname, ty = pty, pointer = arg_pointer))
        ctor_body.push(ir.Stmt.stmt_assignment(target = field_expr, operator = "=", value = arg_expr))
        # The frame outlives the call stack, so a proc-storing (non-pointer) param
        # is retained for it (the host's `frame_builder.rb:298-302`).
        var is_pointer_param = false
        match arg_pointer:
            Option.some as ap:
                is_pointer_param = ap.value
            Option.none:
                pass
        if not is_pointer_param and contains_proc_storage_type(ctx, pty):
            proc_contained_retain_stmts(ctx, field_expr, pty, ref_of(ctor_body))
        pi3 += 1
    ctor_body.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call(callee = resume_c, arguments = single_expr_span(raw_cframe), ty = void_t)), line = 0, source_path = ""))
    # The host's task-struct field types (`async_info[:task_type].field(...)`)
    # for the aggregate entries below — the vtable signatures with their
    # parameter names (`frame_builder.rb:313-317`).
    let ready_field_ty = task_field_type(ctx, res_ty, "ready")
    let release_field_ty = task_field_type(ctx, res_ty, "release")
    let cancel_field_ty = task_field_type(ctx, res_ty, "cancel")
    let take_field_ty = task_field_type(ctx, res_ty, "take_result")
    let set_waiter_field_ty = task_field_type(ctx, res_ty, "set_waiter")
    var tf = vec.Vec[ir.AggregateField].create()
    # The host's ctor aggregate carries no `value` field (`frame_builder.rb:
    # 308-318`): the result reaches the task through `take_result` at await time.
    tf.push(ir.AggregateField(name = "frame",       value = raw_cframe))
    tf.push(ir.AggregateField(name = "ready",       value = alloc_expr(ir.Expr.expr_name(name = ready_lk,  ty = ready_field_ty, pointer = Option[bool].some(value = false)))))
    tf.push(ir.AggregateField(name = "set_waiter",  value = alloc_expr(ir.Expr.expr_name(name = waiter_lk, ty = set_waiter_field_ty, pointer = Option[bool].some(value = false)))))
    tf.push(ir.AggregateField(name = "release",     value = alloc_expr(ir.Expr.expr_name(name = release_lk, ty = release_field_ty, pointer = Option[bool].some(value = false)))))
    tf.push(ir.AggregateField(name = "take_result", value = alloc_expr(ir.Expr.expr_name(name = take_lk, ty = take_field_ty, pointer = Option[bool].some(value = false)))))
    tf.push(ir.AggregateField(name = "cancel",      value = alloc_expr(ir.Expr.expr_name(name = cancel_lk, ty = cancel_field_ty, pointer = Option[bool].some(value = false)))))
    ctor_body.push(ir.Stmt.stmt_return(value = alloc_expr(ir.Expr.expr_aggregate_literal(ty = task_ty, fields = tf.as_span())), line = 0, source_path = ""))
    # Build constructor params from the original async function params, with the
    # host's `pointer` value (`async_param_pointer`; the types already render as
    # C pointers for `ptr`/`ref`/`own`).
    var ctor_params = vec.Vec[ir.Param].create()
    var pi4: ptr_uint = 0
    while pi4 < ctor_param_names.len:
        var pname: str
        var pty: types.Type
        unsafe:
            let rawdata = ctor_param_names.data
            if rawdata == null:
                fatal(c"lowering: async ctor params missing storage")
            pname = read(ptr[str]<-rawdata + pi4)
            let rawt = ctor_param_tys.data
            if rawt == null:
                fatal(c"lowering: async ctor params missing storage")
            pty = read(ptr[types.Type]<-rawt + pi4)
        ctor_params.push(ir.Param(name = pname, linkage_name = pname, ty = pty, pointer = async_param_pointer(receiver_ty_opt, receiver_editable, pname)))
        pi4 += 1
    # The host returns the constructor into the declaring module's list, except
    # for the root `async main`, whose constructor joins the synthetic tail
    # (`functions.rb:224-240`).
    # The async constructor is a method when the function has a receiver (the
    # host's `method_receiver_param: !binding.type.receiver_type.nil?`,
    # `frame_builder.rb:329`).
    let ctor_fn = ir.Function(name = name, linkage_name = link_base, params = ctor_params.as_span(), return_type = task_ty, body = ctor_body.as_span(), entry_point = false, public_export = false, method_receiver_param = receiver_ty_opt.is_some())
    if synthetic_ctor:
        ctx.pending_synthetic_functions.push(ctor_fn)
    else:
        functions.push(ctor_fn)
    ctx.current_function_linkage = saved_current_fn


## The C label for async resume state `n` (goto target in the dispatch switch).
function async_state_label(resume_c: str, n: int) -> str:
    return j3(resume_c, "_state_", int_to_str(n))


## True when an AST expression is directly an `await` (not wrapped).
function expr_is_direct_await(ep: ptr[ast.Expr]) -> bool:
    unsafe:
        match read(ep):
            ast.Expr.expr_await:
                return true
            _:
                return false


## The inner (awaited) expression of a direct `await`.
function direct_await_inner(ep: ptr[ast.Expr]) -> ptr[ast.Expr]:
    unsafe:
        match read(ep):
            ast.Expr.expr_await as aw:
                return aw.expression
            _:
                return ep


## Register a spilled async local: add its frame field once and bind its name to
## `__mt_frame->local_<name>` so all references and writes go through the frame.
function async_register_local_field(ctx: ref[LowerCtx], loc_name: str, field_name: str, frame_cname: str, ty: types.Type) -> void:
    async_register_unused_field(ctx, field_name, ty)
    ctx.locals.push(LocalBinding(name = loc_name, c_name = frame_cname, ty = ty, pointer = Option[bool].some(value = false)))


## Register a frame field the host's async analysis recorded but its lowering
## never references (the `local_match_binding_<N>` shape): the field joins
## `async_local_fields` after the arm body's locals, with no local binding.
function async_register_unused_field(ctx: ref[LowerCtx], field_name: str, ty: types.Type) -> void:
    if ctx.async_local_seen.contains(field_name):
        return
    ctx.async_local_seen.set(field_name, true)
    let lfp = ctx.async_local_fields_ptr
    if lfp != null:
        unsafe: read(lfp).push(ir.Field(name = field_name, ty = ty))
    else:
        ctx.async_local_fields.push(ir.Field(name = field_name, ty = ty))


## Lower a `let`/`var` inside an async CPS body: spill to a frame field and, when
## the initializer is a direct `await`, split into suspend/resume.
## Allocate a fresh AST expression node on the heap (for the await-hoisting
## rewrite, which splices synthesized identifier nodes into the source AST).
function alloc_ast_expr(e: ast.Expr) -> ptr[ast.Expr]:
    var p = heap_mod.must_alloc[ast.Expr](1)
    unsafe:
        read(p) = e
    return p


function alloc_ast_stmt(s: ast.Stmt) -> ptr[ast.Stmt]:
    var p = heap_mod.must_alloc[ast.Stmt](1)
    unsafe:
        read(p) = s
    return p


## Hoist embedded `await`s out of an expression: emit each await as a direct
## suspend/resume boundary into a fresh temp frame local, and return a rewritten
## AST expression with each await replaced by an identifier referencing that
## temp.  After this, the returned expression contains no awaits, so it can be
## lowered by the normal expression machinery.  A top-level `?` is preserved (its
## operand is hoisted) so the caller can route it to `lower_propagate_let`.
function async_hoist_awaits(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], ep: ptr[ast.Expr]) -> ptr[ast.Expr]:
    unsafe:
        match read(ep):
            ast.Expr.expr_await as aw:
                let inner = async_hoist_awaits(ctx, output, aw.expression)
                let task_ir = lower_expr(ctx, inner)
                let task_ty = normalize_awaited_task_type(ir_expr_type(task_ir))
                let result_ty = extract_task_element_type(ctx, task_ty)
                ctx.async_tmp_counter += 1
                let tmp = j2("__mt_async_tmp_", pw1_str(ctx.async_tmp_counter))
                let field_name = j2("local_", tmp)
                let frame_cname = j2("__mt_frame->", field_name)
                async_register_local_field(ctx, tmp, field_name, frame_cname, result_ty)
                # The store target is the host's `IR::Member(frame, field)`
                # (`async_frame_field_expression`), not the `__mt_frame->…` text
                # Name (which stays for reads).
                let target = alloc_expr(ir.Expr.expr_member(receiver = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false))), member = field_name, ty = result_ty))
                async_emit_await(ctx, output, task_ir, task_ty, result_ty, Option[ptr[ir.Expr]].some(value = target), inner)
                return alloc_ast_expr(ast.Expr.expr_identifier(name = tmp, line = 0, column = 0))
            ast.Expr.expr_binary_op as b:
                # The host normalizer declares an and/or result temp before the
                # operand setups but numbers it after them, so capture the field
                # slot before recursing into the operands and key it by the
                # rewritten node the lowering will see.
                let is_short_circuit = b.operator == "and" or b.operator == "or"
                if is_short_circuit and ctx.async_structured_setup:
                    # Two-phase normalizer shape: keep each operand's await setup
                    # separate so the lowering can emit
                    # `[temp decl] ++ left_setup ++ IfStmt(...)` in that order.
                    let and_or_field_index = async_local_field_count(ctx)
                    var left_setup = vec.Vec[ir.Stmt].create()
                    var right_setup = vec.Vec[ir.Stmt].create()
                    let l = async_hoist_awaits(ctx, ref_of(left_setup), b.left)
                    let r = async_hoist_awaits(ctx, ref_of(right_setup), b.right)
                    let rewritten = alloc_ast_expr(ast.Expr.expr_binary_op(operator = b.operator, left = l, right = r))
                    let key = reinterpret[ptr_uint](rewritten)
                    ctx.async_and_or_field_indices.set(key, and_or_field_index)
                    ctx.async_and_or_left_setup.set(key, left_setup)
                    ctx.async_and_or_right_setup.set(key, right_setup)
                    return rewritten
                var and_or_field_index: ptr_uint = 0
                if is_short_circuit:
                    and_or_field_index = async_local_field_count(ctx)
                let l = async_hoist_awaits(ctx, output, b.left)
                let r = async_hoist_awaits(ctx, output, b.right)
                let rewritten = alloc_ast_expr(ast.Expr.expr_binary_op(operator = b.operator, left = l, right = r))
                if is_short_circuit:
                    ctx.async_and_or_field_indices.set(reinterpret[ptr_uint](rewritten), and_or_field_index)
                return rewritten
            ast.Expr.expr_unary_op as u:
                let operand = async_hoist_awaits(ctx, output, u.operand)
                return alloc_ast_expr(ast.Expr.expr_unary_op(operator = u.operator, operand = operand))
            ast.Expr.expr_call as c:
                let callee = async_hoist_awaits(ctx, output, c.callee)
                var new_args = vec.Vec[ast.Argument].create()
                var i: ptr_uint = 0
                while i < c.args.len:
                    let arg = read(c.args.data + i)
                    new_args.push(ast.Argument(arg_name = arg.arg_name, arg_value = async_hoist_awaits(ctx, output, arg.arg_value)))
                    i += 1
                return alloc_ast_expr(ast.Expr.expr_call(callee = callee, args = new_args.as_span()))
            ast.Expr.expr_member_access as ma:
                return alloc_ast_expr(ast.Expr.expr_member_access(receiver = async_hoist_awaits(ctx, output, ma.receiver), member_name = ma.member_name, line = ma.line, column = ma.column))
            ast.Expr.expr_index_access as ix:
                return alloc_ast_expr(ast.Expr.expr_index_access(receiver = async_hoist_awaits(ctx, output, ix.receiver), index = async_hoist_awaits(ctx, output, ix.index)))
            ast.Expr.expr_prefix_cast as pc:
                return alloc_ast_expr(ast.Expr.expr_prefix_cast(target_type = pc.target_type, expression = async_hoist_awaits(ctx, output, pc.expression), line = pc.line, column = pc.column))
            ast.Expr.expr_unsafe as us:
                return alloc_ast_expr(ast.Expr.expr_unsafe(expression = async_hoist_awaits(ctx, output, us.expression), line = us.line, column = us.column))
            ast.Expr.expr_if as ie:
                # The host's `normalize_async_expression` IfExpr arm: the
                # condition setup precedes the result temp, and the branch
                # setup lives inside the generated `if` that assigns the temp
                # (`async/normalization.rb:274`).
                if not async_mod.expr_has_await(ep):
                    return ep
                let cond_h = async_hoist_awaits(ctx, output, ie.condition)
                # The branches take the lower temp numbers (`tmp_1`, `tmp_2`)
                # while the result temp registers first in the frame (the
                # host's normalized LocalDecl precedes the generated `if`).
                let field_index = async_local_field_count(ctx)
                var then_setup = vec.Vec[ir.Stmt].create()
                let then_h = async_hoist_awaits(ctx, ref_of(then_setup), ie.then_expr)
                var else_setup = vec.Vec[ir.Stmt].create()
                let else_h = async_hoist_awaits(ctx, ref_of(else_setup), ie.else_expr)
                ctx.async_tmp_counter += 1
                let tmp = j2("__mt_async_tmp_", pw1_str(ctx.async_tmp_counter))
                let field_name = j2("local_", tmp)
                let frame_cname = j2("__mt_frame->", field_name)
                var result_ty = expr_type(ctx, ep)
                if types.is_error(result_ty):
                    result_ty = expr_type(ctx, ie.then_expr)
                async_register_local_field(ctx, tmp, field_name, frame_cname, result_ty)
                async_move_last_local_field_to(ctx, field_index)
                output.push(async_frame_field_assignment(ctx, field_name, result_ty, alloc_expr(ir.Expr.expr_zero_init(ty = result_ty))))
                let cond_ir = lower_expr(ctx, cond_h)
                # The host's normalized branch bodies assign an Identifier bound
                # to the frame local (`__mt_frame->local_X`, an `IR::Name`); only
                # await stores use the `IR::Member` frame-field form.
                let then_target = alloc_expr(ir.Expr.expr_name(name = frame_cname, ty = result_ty, pointer = Option[bool].some(value = false)))
                let else_target = alloc_expr(ir.Expr.expr_name(name = frame_cname, ty = result_ty, pointer = Option[bool].some(value = false)))
                then_setup.push(ir.Stmt.stmt_assignment(target = then_target, operator = "=", value = lower_expr(ctx, then_h)))
                else_setup.push(ir.Stmt.stmt_assignment(target = else_target, operator = "=", value = lower_expr(ctx, else_h)))
                output.push(ir.Stmt.stmt_if(condition = cond_ir, then_body = then_setup.as_span(), else_body = Option[span[ir.Stmt]].some(value = else_setup.as_span())))
                return alloc_ast_expr(ast.Expr.expr_identifier(name = tmp, line = 0, column = 0))
            _:
                return ep


## The frame's current local-field count (the vec the registration helpers use).
function async_local_field_count(ctx: ref[LowerCtx]) -> ptr_uint:
    let lfp = ctx.async_local_fields_ptr
    if lfp != null:
        return unsafe: read(lfp).len()
    return ctx.async_local_fields.len()


## Move the most recently appended frame field to `index` — the host's
## normalized statement order registers an if-expression's result temp before
## the branch temps that were numbered first.
function async_move_last_local_field_to(ctx: ref[LowerCtx], index: ptr_uint) -> void:
    let lfp = ctx.async_local_fields_ptr
    var fields: ptr[vec.Vec[ir.Field]]
    if lfp != null:
        fields = unsafe: ptr[vec.Vec[ir.Field]]<-lfp
    else:
        fields = ptr_of(ctx.async_local_fields)
    let count = unsafe: read(fields).len()
    if count <= index + 1:
        return
    let last = count - 1
    let moved = unsafe: read(fields).remove(last)
    match moved:
        Option.some as f:
            let _ok = unsafe: read(fields).insert(index, f.value)
        Option.none:
            pass


## `__mt_frame-><field> = value` — the host's `async_frame_field_expression`
## assignment target.
function async_frame_field_assignment(ctx: ref[LowerCtx], field_name: str, field_ty: types.Type, value: ptr[ir.Expr]) -> ir.Stmt:
    let frame = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false)))
    let target = alloc_expr(ir.Expr.expr_member(receiver = frame, member = field_name, ty = field_ty))
    return ir.Stmt.stmt_assignment(target = target, operator = "=", value = value)


## One frame field collected by the no-await prepass, in normalized order.
struct AsyncFieldEntry:
    name: str
    ty: types.Type


## Register the frame fields a no-await async body contributes, in the host
## analysis' normalized order: an explicit local's field follows its
## initializer's normalizer temps, and an `and`/`or` temp (the only temp the
## plain lowering creates in an await-free body) precedes the locals of the
## branch bodies it encloses.  The lowering later creates the same temps in the
## same counter order, so its registrations dedup against these and the frame
## order matches the host's analysis walk.
function async_register_normalized_body_fields(ctx: ref[LowerCtx], body: ptr[ast.Stmt]?) -> void:
    let b = body else:
        return
    var entries = vec.Vec[AsyncFieldEntry].create()
    # Predicted temp names start at the lowering's current counter but never
    # advance it: the lowering allocates them itself.
    var counter = ctx.async_tmp_counter
    async_collect_stmt_fields(ctx, unsafe: read(b), ref_of(entries), ref_of(counter))
    var i: ptr_uint = 0
    while i < entries.len():
        let entry_ptr = entries.get(i) else:
            break
        let entry = unsafe: read(entry_ptr)
        async_register_unused_field(ctx, entry.name, entry.ty)
        i += 1
    entries.release()


## Collect a statement's normalized frame fields (see
## `async_register_normalized_body_fields`).  Assignment targets are skipped:
## the plain lowering lowers them before its statement window opens, so a
## target `and`/`or` stays inline there.
function async_collect_stmt_fields(ctx: ref[LowerCtx], stmt: ast.Stmt, sink: ref[vec.Vec[AsyncFieldEntry]], counter: ref[ptr_uint]) -> void:
    match stmt:
        ast.Stmt.stmt_block as blk:
            var i: ptr_uint = 0
            while i < blk.statements.len:
                async_collect_stmt_fields(ctx, unsafe: read(blk.statements.data + i), sink, counter)
                i += 1
        ast.Stmt.stmt_local as l:
            let val = l.value
            if val != null:
                async_collect_expr_fields(ctx, unsafe: ptr[ast.Expr]<-val, sink, counter)
            var is_destructure = false
            match l.destructure_bindings:
                Option.some:
                    is_destructure = true
                Option.none:
                    pass
            if l.name != "_" and not is_destructure:
                var storage_ty = ctx.void_ty
                if l.else_body != null:
                    if val != null:
                        storage_ty = async_local_value_type(ctx, unsafe: ptr[ast.Expr]<-val)
                else if l.stmt_type != null:
                    if val != null:
                        storage_ty = local_decl_type(ctx, l.stmt_type, unsafe: ptr[ast.Expr]<-val)
                    else:
                        storage_ty = resolve_type_ref(ctx, unsafe: ptr[ast.TypeRef]<-l.stmt_type)
                else if val != null:
                    storage_ty = async_local_value_type(ctx, unsafe: ptr[ast.Expr]<-val)
                sink.push(AsyncFieldEntry(name = j2("local_", l.name), ty = storage_ty))
            async_collect_body_fields(ctx, l.else_body, sink, counter)
        ast.Stmt.stmt_if as sif:
            var bi: ptr_uint = 0
            while bi < sif.branches.len:
                var branch: ast.IfBranch
                unsafe:
                    branch = read(sif.branches.data + bi)
                async_collect_expr_fields(ctx, branch.condition, sink, counter)
                async_collect_body_fields(ctx, branch.body, sink, counter)
                bi += 1
            async_collect_body_fields(ctx, sif.else_body, sink, counter)
        ast.Stmt.stmt_while as w:
            async_collect_expr_fields(ctx, w.condition, sink, counter)
            async_collect_body_fields(ctx, w.body, sink, counter)
        ast.Stmt.stmt_for as f:
            var fi: ptr_uint = 0
            while fi < f.iterables.len:
                async_collect_expr_fields(ctx, unsafe: f.iterables.data + fi, sink, counter)
                fi += 1
            async_collect_body_fields(ctx, f.body, sink, counter)
        ast.Stmt.stmt_match as m:
            async_collect_expr_fields(ctx, m.scrutinee, sink, counter)
            var ai: ptr_uint = 0
            while ai < m.arms.len:
                async_collect_body_fields(ctx, unsafe: read(m.arms.data + ai).body, sink, counter)
                ai += 1
        ast.Stmt.stmt_expression as ex:
            async_collect_expr_fields(ctx, ex.expression, sink, counter)
        ast.Stmt.stmt_assignment as asg:
            async_collect_expr_fields(ctx, asg.value, sink, counter)
        ast.Stmt.stmt_ret as r:
            let rv = r.value
            if rv != null:
                async_collect_expr_fields(ctx, unsafe: ptr[ast.Expr]<-rv, sink, counter)
        ast.Stmt.stmt_defer as d:
            let de = d.expression
            if de != null:
                async_collect_expr_fields(ctx, unsafe: ptr[ast.Expr]<-de, sink, counter)
            async_collect_body_fields(ctx, d.body, sink, counter)
        ast.Stmt.stmt_unsafe as u:
            async_collect_body_fields(ctx, u.body, sink, counter)
        ast.Stmt.stmt_when as wn:
            async_collect_body_fields(ctx, wn.else_body, sink, counter)
        _:
            pass


function async_collect_body_fields(ctx: ref[LowerCtx], body: ptr[ast.Stmt]?, sink: ref[vec.Vec[AsyncFieldEntry]], counter: ref[ptr_uint]) -> void:
    let b = body else:
        return
    async_collect_stmt_fields(ctx, unsafe: read(b), sink, counter)


## Collect the temps the plain lowering creates for `ep` in an await-free async
## body, in normalized emission order.  Only `and`/`or` temps exist there: the
## normalizer allocates its temp name after both operand setups but emits the
## temp declaration first, so the entry is emitted before its children's.
## Proc bodies are synchronous and contribute nothing.
function async_collect_expr_fields(ctx: ref[LowerCtx], ep: ptr[ast.Expr], sink: ref[vec.Vec[AsyncFieldEntry]], counter: ref[ptr_uint]) -> void:
    unsafe:
        match read(ep):
            ast.Expr.expr_call as c:
                async_collect_expr_fields(ctx, c.callee, sink, counter)
                var i: ptr_uint = 0
                while i < c.args.len:
                    async_collect_expr_fields(ctx, read(c.args.data + i).arg_value, sink, counter)
                    i += 1
            ast.Expr.expr_specialization as s:
                # Type arguments are type refs, not expressions — no temps.
                async_collect_expr_fields(ctx, s.callee, sink, counter)
            ast.Expr.expr_prefix_cast as pc:
                async_collect_expr_fields(ctx, pc.expression, sink, counter)
            ast.Expr.expr_unary_op as u:
                async_collect_expr_fields(ctx, u.operand, sink, counter)
            ast.Expr.expr_binary_op as b:
                if b.operator == "and" or b.operator == "or":
                    var children = vec.Vec[AsyncFieldEntry].create()
                    async_collect_expr_fields(ctx, b.left, ref_of(children), counter)
                    async_collect_expr_fields(ctx, b.right, ref_of(children), counter)
                    read(counter) = read(counter) + 1
                    let tmp = j2("__mt_async_tmp_", pw1_str(read(counter)))
                    sink.push(AsyncFieldEntry(name = j2("local_", tmp), ty = ctx.bool_ty))
                    var ci: ptr_uint = 0
                    while ci < children.len():
                        let child_ptr = children.get(ci) else:
                            break
                        sink.push(unsafe: read(child_ptr))
                        ci += 1
                    children.release()
                else:
                    async_collect_expr_fields(ctx, b.left, sink, counter)
                    async_collect_expr_fields(ctx, b.right, sink, counter)
            ast.Expr.expr_if as ie:
                async_collect_expr_fields(ctx, ie.condition, sink, counter)
                async_collect_expr_fields(ctx, ie.then_expr, sink, counter)
                async_collect_expr_fields(ctx, ie.else_expr, sink, counter)
            ast.Expr.expr_match as me:
                async_collect_expr_fields(ctx, me.scrutinee, sink, counter)
                var mi: ptr_uint = 0
                while mi < me.arms.len:
                    let arm = read(me.arms.data + mi)
                    let pat = arm.pattern
                    if pat != null:
                        async_collect_expr_fields(ctx, pat, sink, counter)
                    async_collect_expr_fields(ctx, arm.value, sink, counter)
                    mi += 1
            ast.Expr.expr_format_string as fs:
                var pi: ptr_uint = 0
                while pi < fs.parts.len:
                    match read(fs.parts.data + pi):
                        ast.FormatStringPart.fmt_expr as fe:
                            async_collect_expr_fields(ctx, fe.expression, sink, counter)
                        _:
                            pass
                    pi += 1
            ast.Expr.expr_unsafe as u:
                async_collect_expr_fields(ctx, u.expression, sink, counter)
            ast.Expr.expr_await as aw:
                # Not reachable for an await-free body; skip the temp.
                async_collect_expr_fields(ctx, aw.expression, sink, counter)
            _:
                pass


## The storage type of a no-await async local's initializer.  A call through a
## function-typed member (`task.ready(task.frame)`) records the *member's* type
## on the call node (`fn(ptr[void]) -> bool`); the call's value type is that
## function's return type, as the lowering's own call path computes it.  A
## function-returning method call keeps its recorded type.
function async_local_value_type(ctx: ref[LowerCtx], val: ptr[ast.Expr]) -> types.Type:
    unsafe:
        match read(val):
            ast.Expr.expr_call as cl:
                match read(cl.callee):
                    ast.Expr.expr_member_access:
                        match expr_type(ctx, val):
                            types.Type.ty_function as fnt:
                                return unsafe: read(fnt.return_type)
                            _:
                                pass
                    _:
                        pass
            _:
                pass
    return expr_type(ctx, val)


## The host's prepared array-call temp for a value lowered with hoisting off:
## the async statement preparers pass `materialize_array_calls: true` even when
## the destination's own type is an array (the sync statement roots exempt
## their root call instead).  `maybe_materialize_array_call` handles the windowed
## paths; this is the forced form for an already-lowered expression.
function materialize_array_call_value(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], value: ptr[ir.Expr]) -> ptr[ir.Expr]:
    let ty = ir_expr_type(value)
    if not is_array_type(ty):
        return value
    match unsafe: read(value):
        ir.Expr.expr_call:
            pass
        ir.Expr.expr_call_indirect:
            pass
        _:
            return value
    let name = fresh_c_temp_name(ctx, "array_call")
    output.push(ir.Stmt.stmt_local(name = name, linkage_name = name, ty = ty, value = value, line = 0, source_path = ""))
    return alloc_expr(ir.Expr.expr_name(name = name, ty = ty, pointer = Option[bool].some(value = false)))


## Record a frame field whose value is a dynamic format string: the prepared
## temp release is dropped and the frame's release/cancel functions free the
## field instead (the host's `async_info[:format_str_fields]`).  First-encounter
## order, deduplicated by field name.
function async_record_format_str_field(ctx: ref[LowerCtx], field_name: str) -> void:
    let ffp = ctx.async_format_str_fields_ptr
    if ffp != null:
        let fields = unsafe: read(ffp)
        var i: ptr_uint = 0
        while i < fields.len:
            let existing = fields.get(i) else:
                break
            if unsafe: read(existing) == field_name:
                return
            i += 1
        unsafe: read(ffp).push(field_name)
        return
    var j: ptr_uint = 0
    while j < ctx.async_format_str_fields.len:
        let existing = ctx.async_format_str_fields.get(j) else:
            break
        if unsafe: read(existing) == field_name:
            return
        j += 1
    ctx.async_format_str_fields.push(field_name)


function lower_async_local(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], loc_name: str, loc_value: ptr[ast.Expr]?, loc_stmt_type: ptr[ast.TypeRef]?, line: ptr_uint) -> void:
    # `let _ = ...`: the host's analysis registers `local_discard_<line>` for the
    # discard and its lowering stores the (awaited) value there — a dead field,
    # but part of the frame (`async_local_decl_field_name`,
    # `lower_async_await_statement`).  No local binding is introduced.
    if loc_name == "_":
        let dv = loc_value else:
            return
        let field_name = j2("local_discard_", pw1_str(line))
        if expr_is_direct_await(dv):
            let task_ir = lower_expr(ctx, direct_await_inner(dv))
            let task_ty = normalize_awaited_task_type(ir_expr_type(task_ir))
            let result_ty = extract_task_element_type(ctx, task_ty)
            async_register_unused_field(ctx, field_name, result_ty)
            let target = alloc_expr(ir.Expr.expr_member(receiver = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false))), member = field_name, ty = result_ty))
            async_emit_await(ctx, output, task_ir, task_ty, result_ty, Option[ptr[ir.Expr]].some(value = target), direct_await_inner(dv))
        else:
            let value_ir = lower_expr(ctx, dv)
            let value_ty = ir_expr_type(value_ir)
            async_register_unused_field(ctx, field_name, value_ty)
            output.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_member(receiver = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false))), member = field_name, ty = value_ty)), operator = "=", value = value_ir))
        return

    let field_name = j2("local_", loc_name)
    let frame_cname = j2("__mt_frame->", field_name)

    let v = loc_value else:
        # No initializer: reserve the frame field with the declared type.
        var ty0 = ctx.void_ty
        if loc_stmt_type != null:
            ty0 = resolve_type_ref(ctx, unsafe: ptr[ast.TypeRef]<-loc_stmt_type)
        async_register_local_field(ctx, loc_name, field_name, frame_cname, ty0)
        return

    if expr_is_direct_await(v):
        # The host's normalization hoists every await embedded in the awaited
        # expression into a `__mt_async_tmp_<N>` local *before* the analysis
        # registers this local's field (`normalize_async_statement`'s AwaitExpr
        # arm), so the hoist temps precede the local in the frame.
        var inner = direct_await_inner(v)
        if async_mod.expr_has_await(inner):
            inner = async_hoist_awaits(ctx, output, inner)
        let task_ir = lower_expr(ctx, inner)
        let task_ty = normalize_awaited_task_type(ir_expr_type(task_ir))
        let result_ty = extract_task_element_type(ctx, task_ty)
        async_register_local_field(ctx, loc_name, field_name, frame_cname, result_ty)
        let target = alloc_expr(ir.Expr.expr_member(receiver = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false))), member = field_name, ty = result_ty))
        async_emit_await(ctx, output, task_ir, task_ty, result_ty, Option[ptr[ir.Expr]].some(value = target), inner)
        return

    # Hoist any embedded awaits (inside `?`, arithmetic, calls, etc.) into temp
    # frame locals so the remaining expression is await-free.
    var hv = v
    if async_mod.expr_has_await(v):
        hv = async_hoist_awaits(ctx, output, v)

    # `let x = <expr>?` — Result/Option propagation.  Route to the CPS-aware
    # propagate helper (which spills `x` and returns via the frame on failure).
    unsafe:
        match read(hv):
            ast.Expr.expr_unary_op as u:
                if u.operator == "?":
                    lower_propagate_let(ctx, output, loc_name, u.operand, line, false, "")
                    return
            _:
                pass

    # Plain spilled local: `frame->local_<name> = <value>`.  The host prepares
    # every CF local initializer (a dynamic format string, a proc literal, a
    # foreign call, an array call) into the statement stream, so an
    # array-returning call first lands in a `__mt_array_call_<N>` local even
    # when the local's own type is that array.
    let hoist_base = output.len()
    let hoist_saved = begin_stmt_setup(ctx, HoistMode.hm_value)
    ctx.hoist_root_ep = hv
    var val_ir = lower_expr(ctx, hv)
    let hoist_collected = collect_stmt_setup(ctx, hoist_saved)
    emit_hoist_setup(output, hoist_base, hoist_collected)
    var ty = ir_expr_type(val_ir)
    if loc_stmt_type != null:
        let annotated = local_decl_type(ctx, loc_stmt_type, hv)
        if not types.is_error(annotated):
            ty = annotated
    # A literal initializer takes the declared type (the host's CF path lowers
    # the value with `expected_type: storage_type`), so `var offset: ptr_uint = 0`
    # stores a ptr_uint literal.
    val_ir = contextual_value_to_type(
        ctx,
        hv,
        ty,
        val_ir,
        loc_stmt_type != null and types.is_float_type(ty) and not is_foreign_call_initializer(ctx, hv),
        false,
    )
    # Wrap a non-nullable value into a value-type nullable's opt struct (mirrors
    # the normal stmt_local path), so `let m: int? = 5` stores `{has_value,value}`.
    if types.is_nullable_type(ty) and not is_nullable_pointer_like(ty):
        let value_ty = ir_expr_type(val_ir)
        if not types.is_nullable_type(value_ty):
            unsafe:
                match read(val_ir):
                    ir.Expr.expr_null_literal:
                        val_ir = alloc_expr(ir.Expr.expr_zero_init(ty = ty))
                    _:
                        val_ir = nullable_some_literal(ty, val_ir)
    async_register_local_field(ctx, loc_name, field_name, frame_cname, ty)
    let target = alloc_expr(ir.Expr.expr_member(receiver = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false))), member = field_name, ty = ty))
    output.push(ir.Stmt.stmt_assignment(target = target, operator = "=", value = val_ir))
    # A dynamic format string's result is owned by the frame field: drop the
    # prepared temp release and register the field for the frame's
    # release/cancel cleanup (the host's `format_str_fields`).
    var local_cleanups = hoist_collected
    var has_format_release = false
    var fci: ptr_uint = 0
    while fci < hoist_collected.cleanups.len:
        let fcp = hoist_collected.cleanups.get(fci) else:
            break
        if is_format_release_stmt(unsafe: read(fcp)):
            has_format_release = true
        fci += 1
    if has_format_release:
        async_record_format_str_field(ctx, field_name)
        local_cleanups = drop_format_release_cleanups(hoist_collected)
    record_or_emit_local_cleanups(ctx, output, local_cleanups.cleanups)


## Lower an `await` at statement position: lower the task expr, then emit the
## suspend/resume boundary, assigning the result to `target` (or discarding).
function lower_async_await_into(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], task_ep: ptr[ast.Expr], target: Option[ptr[ir.Expr]]) -> void:
    let task_ir = lower_expr(ctx, task_ep)
    let task_ty = normalize_awaited_task_type(ir_expr_type(task_ir))
    let result_ty = extract_task_element_type(ctx, task_ty)
    async_emit_await(ctx, output, task_ir, task_ty, result_ty, target, task_ep)


## The type of an awaited expression, normalized to a `Task[T]`.  A callee whose
## return type was recovered without the async wrap (a stored lowered return type
## rather than the analyzer's binding) yields the bare `Result`/`Option`; an
## `await` always operates on a `Task`, so wrap any non-Task awaited type here.
## `Task[T]` types pass through unchanged.
function normalize_awaited_task_type(t: types.Type) -> types.Type:
    match t:
        types.Type.ty_generic as g:
            if g.name == "Task":
                return t
        _:
            pass
    return make_task_type(t)


## The frame field an awaited task identifier already spills to — the host's
## `reusable_async_await_task_field_name`: `await waited` on a spilled local or a
## parameter reuses that binding's field and skips the `await_<N>` allocation
## (and its store; the value is already there).
function async_reusable_await_field(ctx: ref[LowerCtx], task_ep: ptr[ast.Expr]?) -> str:
    let ep = task_ep else:
        return ""
    unsafe:
        match read(ep):
            ast.Expr.expr_identifier as id:
                var i = ctx.locals.len()
                while i > 0:
                    i -= 1
                    let lb_ptr = ctx.locals.get(i) else:
                        break
                    let lb = read(lb_ptr)
                    if lb.name == id.name:
                        let prefix = "__mt_frame->"
                        if lb.c_name.starts_with(prefix):
                            return lb.c_name.slice(prefix.len, lb.c_name.len - prefix.len)
                        return ""
                return ""
            _:
                return ""


## Core await lowering: store the task in `frame->await_N`, guard on `ready`,
## suspend (register waiter + return) if not ready, then resume at `state_<N+1>`,
## take the result into `target`, and release the child task.
function async_emit_await(ctx: ref[LowerCtx], output: ref[vec.Vec[ir.Stmt]], task_ir: ptr[ir.Expr], task_ty: types.Type, result_ty: types.Type, target: Option[ptr[ir.Expr]], task_ep: ptr[ast.Expr]?) -> void:
    let ptr_void = async_mod.ptr_void_type()
    let bool_ty = ctx.bool_ty
    let int_ty = types.primitive("int")
    let void_ty = ctx.void_ty
    let idx = ctx.async_await_counter
    ctx.async_await_counter = idx + 1
    let reusable = async_reusable_await_field(ctx, task_ep)
    var await_field: str
    if reusable.len > 0:
        await_field = reusable
    else:
        await_field = j2("await_", int_to_str(int<-idx))
    # The host records every await field, including one that reuses a local's
    # storage (`reuse_existing_storage`): the release/cancel builders iterate
    # them all, while the frame type dedups an entry whose field already exists.
    # Push through the pointer when set (immune to ctx reassignment by nested
    # lower_async_fn calls), otherwise push to the ctx vec directly.
    let afp = ctx.async_await_fields_ptr
    if afp != null:
        unsafe: read(afp).push(ir.Field(name = await_field, ty = task_ty))
    else:
        ctx.async_await_fields.push(ir.Field(name = await_field, ty = task_ty))
    let next_state = int<-idx + 1

    let frame_exp = alloc_expr(ir.Expr.expr_name(name = "__mt_frame", ty = ctx.async_frame_ptr_ty, pointer = Option[bool].some(value = false)))
    let await_ref = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = await_field, ty = task_ty))

    # frame->await_N = <task> (skipped when the task already lives in the reused
    # local's field — the host's `unless await_info[:reuse_existing_storage]`).
    if reusable.len == 0:
        output.push(ir.Stmt.stmt_assignment(target = await_ref, operator = "=", value = task_ir))

    # if (!frame->await_N.ready(frame->await_N.frame)) { state=N+1; set_waiter; return; }
    # Task member accesses carry the Task struct's field types (the host's
    # `async_task_call`); the wake argument is the wake function type.
    let task_frame_ty = task_field_type(ctx, result_ty, "frame")
    let ready_fn = alloc_expr(ir.Expr.expr_member(receiver = await_ref, member = "ready", ty = task_field_type(ctx, result_ty, "ready")))
    let ready_call = alloc_expr(ir.Expr.expr_call_indirect(callee = ready_fn, arguments = single_expr_span(alloc_expr(ir.Expr.expr_member(receiver = await_ref, member = "frame", ty = task_frame_ty))), ty = bool_ty))
    let not_ready = alloc_expr(ir.Expr.expr_unary(operator = "not", operand = ready_call, ty = bool_ty))
    var suspend = vec.Vec[ir.Stmt].create()
    suspend.push(ir.Stmt.stmt_assignment(target = alloc_expr(ir.Expr.expr_member(receiver = frame_exp, member = "state", ty = int_ty)), operator = "=", value = alloc_expr(ir.Expr.expr_integer_literal(value = long<-next_state, ty = int_ty))))
    var sw_args = vec.Vec[ir.Expr].create()
    unsafe:
        sw_args.push(read(alloc_expr(ir.Expr.expr_member(receiver = await_ref, member = "frame", ty = task_frame_ty))))
        sw_args.push(read(alloc_expr(ir.Expr.expr_name(name = "__mt_frame_raw", ty = ptr_void, pointer = Option[bool].some(value = false)))))
        sw_args.push(read(alloc_expr(ir.Expr.expr_name(name = ctx.async_resume_c, ty = async_wake_fn_type(ctx), pointer = Option[bool].some(value = false)))))
    let set_waiter_fn = alloc_expr(ir.Expr.expr_member(receiver = await_ref, member = "set_waiter", ty = task_field_type(ctx, result_ty, "set_waiter")))
    suspend.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(callee = set_waiter_fn, arguments = sw_args.as_span(), ty = void_ty)), line = 0, source_path = ""))
    suspend.push(ir.Stmt.stmt_return(value = null, line = 0, source_path = ""))
    output.push(ir.Stmt.stmt_if(condition = not_ready, then_body = suspend.as_span(), else_body = Option[span[ir.Stmt]].none))

    # resume point
    output.push(ir.Stmt.stmt_label(name = async_state_label(ctx.async_resume_c, next_state)))

    let take_fn = alloc_expr(ir.Expr.expr_member(receiver = await_ref, member = "take_result", ty = task_field_type(ctx, result_ty, "take_result")))
    let take_call = alloc_expr(ir.Expr.expr_call_indirect(callee = take_fn, arguments = single_expr_span(alloc_expr(ir.Expr.expr_member(receiver = await_ref, member = "frame", ty = task_frame_ty))), ty = result_ty))
    match target:
        Option.some as t:
            output.push(ir.Stmt.stmt_assignment(target = t.value, operator = "=", value = take_call))
        Option.none:
            # The host takes the result of every await, including a void task
            # (`async_lowering.rb:1213`).
            output.push(ir.Stmt.stmt_expression(expression = take_call, line = 0, source_path = ""))

    let release_fn = alloc_expr(ir.Expr.expr_member(receiver = await_ref, member = "release", ty = task_field_type(ctx, result_ty, "release")))
    output.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(callee = release_fn, arguments = single_expr_span(alloc_expr(ir.Expr.expr_member(receiver = await_ref, member = "frame", ty = task_frame_ty))), ty = void_ty)), line = 0, source_path = ""))


## Async `main` entrypoint — synthesizes the C `main()` function.
## The async main is already CPS-lowered as a constructor returning Task[T] with
## linkage `<module>_main`.  Here we build a root proc from the constructor,
## drive it via `std.async.wait[int]` / `run` for void, and release the proc.
function build_async_main_entrypoint(ctx: ref[LowerCtx], name: str) -> Option[ir.Function]:
    let sig = lookup_fn_sig(ctx, name)
    let task_ret = fn_sig_return_type(sig)
    let inner_ty = extract_task_element_type(ctx, task_ret)
    let is_void_ret = is_void_type_lowered(inner_ty)
    # Supported result types: int (wait[int]) and void (run).
    if not (is_void_ret or is_int_type(inner_ty)):
        return Option[ir.Function].none

    let int_ty = types.primitive("int")
    let void_ty = ctx.void_ty
    let void_ptr = types.Type.ty_generic(name = "ptr", args = sp_type(void_ty))
    let str_ty = types.Type.ty_str
    let char_ty = types.primitive("char")
    let cstr_ty = types.primitive("cstr")
    let ptr_char_ty = types.Type.ty_generic(name = "ptr", args = sp_type(char_ty))
    let raw_argv_ty = types.Type.ty_generic(name = "ptr", args = sp_type(ptr_char_ty))
    var params = span[analyzer.ParamEntry]()
    match sig:
        Option.some as s:
            params = s.value.params
        Option.none:
            pass

    # The host's `root_main_entrypoint_signature` + `build_root_main_entrypoint_bridge`:
    # none, one `span[str]`, `(int, ptr[cstr])`, or `(int, ptr[ptr[char]])`.
    var c_params = vec.Vec[ir.Param].create()
    var setup = vec.Vec[ir.Stmt].create()
    var call_args = vec.Vec[ptr[ir.Expr]].create()
    var cleanup = vec.Vec[ir.Stmt].create()
    if params.len > 0:
        c_params.push(ir.Param(name = "argc", linkage_name = "argc", ty = int_ty, pointer = Option[bool].some(value = false)))
        c_params.push(ir.Param(name = "argv", linkage_name = "argv", ty = raw_argv_ty, pointer = Option[bool].some(value = false)))
        let argc_expr = alloc_expr(ir.Expr.expr_name(name = "argc", ty = int_ty, pointer = Option[bool].some(value = false)))
        let argv_expr = alloc_expr(ir.Expr.expr_name(name = "argv", ty = raw_argv_ty, pointer = Option[bool].some(value = false)))
        if params.len == 1:
            let p0 = unsafe: read(params.data + 0).ty
            if not (is_span_type(p0) and types.type_equals(generic_first_arg(p0), str_ty)):
                return Option[ir.Function].none
            let items_ty = types.Type.ty_generic(name = "ptr", args = sp_type(str_ty))
            let items_ref = alloc_expr(ir.Expr.expr_name(name = "__mt_args_items", ty = items_ty, pointer = Option[bool].some(value = false)))
            setup.push(ir.Stmt.stmt_local(name = "__mt_args_items", linkage_name = "__mt_args_items", ty = items_ty, value = alloc_expr(ir.Expr.expr_null_literal(ty = items_ty)), line = 0, source_path = ""))
            var bridge_args = vec.Vec[ir.Expr].create()
            unsafe:
                bridge_args.push(read(argc_expr))
                bridge_args.push(read(argv_expr))
                bridge_args.push(read(alloc_expr(ir.Expr.expr_address_of(expression = items_ref, ty = types.Type.ty_generic(name = "ptr", args = sp_type(items_ty))))))
            let args_ty = p0
            let args_ref = alloc_expr(ir.Expr.expr_name(name = "__mt_args", ty = args_ty, pointer = Option[bool].some(value = false)))
            setup.push(ir.Stmt.stmt_local(name = "__mt_args", linkage_name = "__mt_args", ty = args_ty, value = alloc_expr(ir.Expr.expr_call(callee = "mt_entry_argv_to_span_str", arguments = bridge_args.as_span(), ty = args_ty)), line = 0, source_path = ""))
            call_args.push(args_ref)
            cleanup.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call(callee = "mt_free_entry_argv_strs", arguments = single_expr_span(items_ref), ty = void_ty)), line = 0, source_path = ""))
        else if params.len == 2:
            let p1 = unsafe: read(params.data + 1).ty
            call_args.push(argc_expr)
            if types.is_raw_pointer(p1) and types.type_equals(types.pointer_element(p1), cstr_ty):
                let cstr_ptr_ty = types.Type.ty_generic(name = "ptr", args = sp_type(cstr_ty))
                call_args.push(alloc_expr(ir.Expr.expr_cast(target_type = cstr_ptr_ty, expression = argv_expr, ty = cstr_ptr_ty)))
            else if types.is_raw_pointer(p1) and types.type_equals(types.pointer_element(p1), ptr_char_ty):
                call_args.push(argv_expr)
            else:
                return Option[ir.Function].none
        else:
            return Option[ir.Function].none

    var body = vec.Vec[ir.Stmt].create()
    var si: ptr_uint = 0
    while si < setup.len():
        let sp = setup.get(si) else:
            break
        body.push(unsafe: read(sp))
        si += 1
    var arg_names = vec.Vec[str].create()
    var ai: ptr_uint = 0
    while ai < params.len:
        let an = j2("__mt_async_main_arg_", int_to_str(int<-ai + 1))
        let pty = unsafe: read(params.data + ai).ty
        let cval = call_args.get(ai) else:
            return Option[ir.Function].none
        body.push(ir.Stmt.stmt_local(name = an, linkage_name = an, ty = pty, value = unsafe: read(cval), line = 0, source_path = ""))
        ctx.locals.push(LocalBinding(name = an, c_name = an, ty = pty, pointer = Option[bool].some(value = false)))
        arg_names.push(an)
        ai += 1

    # The root proc calls the constructor through a synthesized AST body, so the
    # argument locals are captured into the host's `__proc_N__env`.
    var ast_args = vec.Vec[ast.Argument].create()
    ai = 0
    while ai < arg_names.len():
        let an_ptr = arg_names.get(ai) else:
            break
        ast_args.push(ast.Argument(arg_name = Option[str].none, arg_value = alloc_ast_expr(ast.Expr.expr_identifier(name = unsafe: read(an_ptr), line = 0, column = 0))))
        ai += 1
    let call_ast = alloc_ast_expr(ast.Expr.expr_call(callee = alloc_ast_expr(ast.Expr.expr_identifier(name = name, line = 0, column = 0)), args = ast_args.as_span()))
    let ret_ast = alloc_ast_stmt(ast.Stmt.stmt_ret(value = call_ast, line = 0, column = 0, length = 0))
    let proc_fn_ty = types.Type.ty_function(name = "", params = span[types.Type](), return_type = types.alloc_type(task_ret), variadic = false, is_proc = true, param_names = span[str]())
    # The env setup is a prepared expression: hoist it into the C main body
    # (no `__proc_N__setup_env` fallback).
    let proc_base = body.len()
    let proc_saved = begin_stmt_setup(ctx, HoistMode.hm_value)
    # The host lowers the root proc in a fresh env: the env temp is
    # `__mt___mt_async_main_root_env_1` (the counter starts at zero).
    let saved_proc_counter = ctx.temp_counter
    ctx.temp_counter = 0
    let proc_expr = lower_proc_expression_typed_named(ctx, span[ast.Param](), task_ret, ret_ast, proc_fn_ty, "__mt_async_main_root")
    ctx.temp_counter = saved_proc_counter
    let proc_collected = collect_stmt_setup(ctx, proc_saved)
    emit_hoist_setup(ref_of(body), proc_base, proc_collected)
    let proc_named_ty = ir_expr_type(proc_expr)

    let root_name = "__mt_async_main_root"
    body.push(ir.Stmt.stmt_local(name = root_name, linkage_name = root_name, ty = proc_named_ty, value = proc_expr, line = 0, source_path = ""))
    let root_ref = alloc_expr(ir.Expr.expr_name(name = root_name, ty = proc_named_ty, pointer = Option[bool].some(value = false)))

    let result_name = "__mt_result"
    if is_void_ret:
        # `std.async.run(root)` — non-generic, so no specialization is needed.
        let run_cname = naming.qualified_c_name("std.async", "run")
        let run_call = alloc_expr(ir.Expr.expr_call(callee = run_cname, arguments = single_expr_span(root_ref), ty = void_ty))
        body.push(ir.Stmt.stmt_expression(expression = run_call, line = 0, source_path = ""))
    else:
        # `std.async.wait[inner](root)` — specialize the generic on demand and
        # capture the int result.
        let wait_cname = ensure_async_wait_specialization(ctx, inner_ty) else:
            return Option[ir.Function].none
        let wait_call = alloc_expr(ir.Expr.expr_call(callee = wait_cname, arguments = single_expr_span(root_ref), ty = inner_ty))
        body.push(ir.Stmt.stmt_local(name = result_name, linkage_name = result_name, ty = inner_ty, value = wait_call, line = 0, source_path = ""))

    # Release the root proc: `root.release(root.env)`.
    let lifecycle_ty = proc_lifecycle_fn_type()
    let release_member = alloc_expr(ir.Expr.expr_member(receiver = root_ref, member = "release", ty = lifecycle_ty))
    let env_member = alloc_expr(ir.Expr.expr_member(receiver = root_ref, member = "env", ty = void_ptr))
    body.push(ir.Stmt.stmt_expression(expression = alloc_expr(ir.Expr.expr_call_indirect(callee = release_member, arguments = single_expr_span(env_member), ty = void_ty)), line = 0, source_path = ""))
    var ci: ptr_uint = 0
    while ci < cleanup.len():
        let cp = cleanup.get(ci) else:
            break
        body.push(unsafe: read(cp))
        ci += 1

    if is_void_ret:
        body.push(ir.Stmt.stmt_return(value = alloc_expr(ir.Expr.expr_integer_literal(value = 0, ty = int_ty)), line = 0, source_path = ""))
    else:
        body.push(ir.Stmt.stmt_return(value = alloc_expr(ir.Expr.expr_name(name = result_name, ty = int_ty, pointer = Option[bool].some(value = false))), line = 0, source_path = ""))

    return Option[ir.Function].some(value = ir.Function(
        name = name, linkage_name = "main", params = c_params.as_span(),
        return_type = int_ty, body = body.as_span(), entry_point = true, public_export = false, method_receiver_param = false,
    ))


## Ensure `std.async.wait[inner_ty]` is specialized and return its C linkage name.
## Mirrors Ruby's `async_main_runtime_callee_name("wait", type_arguments: [...])`,
## which instantiates the binding declared in `std.async` — the public delegating
## entry, not the deepest backend implementation.  Lowering that instance's body
## then instantiates the rest of the chain (`std.async.runtime.wait`, then
## `std.async.libuv_runtime.wait`/`wait_on`), exactly as the host's walk does.
function ensure_async_wait_specialization(ctx: ref[LowerCtx], inner_ty: types.Type) -> Option[str]:
    let gm = find_generic_function_in_module(ctx, "std.async", "wait") else:
        return Option[str].none
    if not gm.module_name.starts_with("std.async"):
        return Option[str].none

    # Build the substitution `T -> inner_ty` from wait's own type parameter name.
    var sub = map_mod.Map[str, types.Type].create()
    match gm.decl:
        ast.Decl.decl_function as fun:
            if fun.type_params.len == 0:
                return Option[str].none
            let tp_name = unsafe: read(fun.type_params.data + 0).name
            sub.set(tp_name, inner_ty)
        _:
            return Option[str].none

    # Spec key mirrors `try_inferred_generic_call`: `<owner_prefix>_wait__<key>`.
    var key = string.String.create()
    key.append(naming.module_c_prefix(gm.module_name))
    key.append("_wait__")
    key.append(spec_type_key(ctx, inner_ty))
    let spec_key = key.as_str()

    if not ctx.specialization_cache.contains(spec_key) and not ctx.spec_in_progress.contains(spec_key):
        # The async main's `wait` call is synthesized during lowering, not seen
        # by the analyzer, so its instance (and everything its body creates) is
        # creator-gated rather than pre-instantiated.
        lower_and_cache_specialization_with_sub(ctx, gm, ref_of(sub), spec_key, false)
    return Option[str].some(value = spec_key)


## Convert int to string.
function int_to_str(v: int) -> str:
    var buf = string.String.create()
    var n = v
    var is_neg = false
    if n < 0:
        n = 0 - n
        is_neg = true
    if n == 0:
        buf.push_byte(48)  # '0'
    while n > 0:
        let digit_int = n % 10
        buf.push_byte(ubyte<-(48 + digit_int))
        n = n / 10
    # The loop pushes the least-significant digit first; render most-significant
    # first so multi-digit values are not reversed.
    var rendered = string.String.with_capacity(buf.len() + 1)
    if is_neg:
        rendered.push_byte(45)  # '-'
    let digits = buf.as_str()
    var i = digits.len
    while i > 0:
        i -= 1
        rendered.push_byte(digits.byte_at(i))
    return rendered.as_str()


## ptr_uint primitive type (repeated for convenience in async section).
function ptr_uint_type() -> types.Type:
    return types.Type.ty_primitive(name = "ptr_uint")


## ptr[void] type — used for frame pointer in async CPS.
function ptr_void_type() -> types.Type:
    return types.Type.ty_generic(name = "ptr", args = single_ty_span(types.primitive("void")))


## True when `name` is one of the function-pointer fields on the Task[T] struct
## (ready, set_waiter, release, take_result, cancel) that must be accessed via
## struct field access + indirect call rather than treated as methods.
function is_task_fn_field(name: str) -> bool:
    return name == "ready" or name == "set_waiter" or name == "release" or name == "take_result" or name == "cancel"


## Extract the element type from a Task type (`ty_generic("Task", [T])`
## or `ty_named("mt_task_...")`).  Returns `ty_primitive("void")` on failure.
function extract_task_element_type(ctx: ref[LowerCtx], t: types.Type) -> types.Type:
    match t:
        types.Type.ty_generic as tg:
            if tg.name == "Task" and tg.args.len >= 1:
                return unsafe: read(tg.args.data + 0)
        types.Type.ty_named as tn:
            if tn.name.starts_with("mt_task_"):
                let gi_ptr = generic_instance_get(ctx, tn.name)
                if gi_ptr != null:
                    let gi = unsafe: read(gi_ptr)
                    if gi.concrete_args.len >= 1:
                        return unsafe: read(gi.concrete_args.data + 0)
                        pass
        _:
            pass
    return ctx.void_ty


## Build a single-element span of IR expressions (for call arguments).
function single_expr_span(e: ptr[ir.Expr]) -> span[ir.Expr]:
    var v = vec.Vec[ir.Expr].create()
    unsafe:
        v.push(read(e))
    return v.as_span()


## Build a single-element span of types.
function single_ty_span(t: types.Type) -> span[types.Type]:
    var v = vec.Vec[types.Type].create()
    v.push(t)

    return v.as_span()
