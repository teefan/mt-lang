    indices: ptr[int]
    materialIndices: ptr[ubyte]
    weldTolerance: float
    vertexCount: int
    triangleCount: int
    weldVertices: bool
    useMedianSplit: bool
    identifyEdges: bool

enum b3MeshEdgeFlags: int
    b3_concaveEdge1 = 1
    b3_concaveEdge2 = 2
    b3_concaveEdge3 = 4
    b3_inverseConcaveEdge1 = 16
    b3_inverseConcaveEdge2 = 32
    b3_inverseConcaveEdge3 = 64
    b3_allConcaveEdges = 7
    b3_flatEdge1 = 17
    b3_flatEdge2 = 34
    b3_flatEdge3 = 68
    b3_allFlatEdges = 119

struct b3MeshTriangle:
    index1: int
    index2: int
    index3: int

struct b3MeshNode:
    lowerBound: b3Vec3
    data: b3MeshNode_data
    upperBound: b3Vec3
    triangleOffset: uint

struct b3MeshData:
    version: ptr_uint
    hash: ptr_uint
    byteCount: int
    bounds: b3AABB
    surfaceArea: float
    treeHeight: int
    degenerateCount: int
    nodeOffset: int
    nodeCount: int
    vertexOffset: int
    vertexCount: int
    triangleOffset: int
    triangleCount: int
    materialOffset: int
    materialCount: int
    flagsOffset: int
    padding: int

struct b3Mesh:
    data: const_ptr[b3MeshData]
    scale: b3Vec3

struct b3HeightFieldDef:
    heights: ptr[float]
    materialIndices: ptr[ubyte]
    scale: b3Vec3
    countX: int
    countZ: int
    globalMinimumHeight: float
    globalMaximumHeight: float
    clockwiseWinding: bool

struct b3HeightFieldData:
    version: ptr_uint
    hash: ptr_uint
    byteCount: int
    aabb: b3AABB
    minHeight: float
    maxHeight: float
    heightScale: float
    scale: b3Vec3
    columnCount: int
    rowCount: int
    heightsOffset: int
    materialOffset: int
    flagsOffset: int
    clockwise: ubyte
    padding: array[ubyte, 7]

struct b3CompoundCapsuleDef:
    capsule: b3Capsule
    material: b3SurfaceMaterial

struct b3CompoundHullDef:
    hull: const_ptr[b3HullData]
    transform: b3Transform
    material: b3SurfaceMaterial

struct b3CompoundMeshDef:
    meshData: const_ptr[b3MeshData]
    transform: b3Transform
    scale: b3Vec3
    materials: const_ptr[b3SurfaceMaterial]
    materialCount: int

struct b3CompoundSphereDef:
    sphere: b3Sphere
    material: b3SurfaceMaterial

struct b3CompoundDef:
    capsules: ptr[b3CompoundCapsuleDef]
    capsuleCount: int
    hulls: ptr[b3CompoundHullDef]
    hullCount: int
    meshes: ptr[b3CompoundMeshDef]
    meshCount: int
    spheres: ptr[b3CompoundSphereDef]
    sphereCount: int

struct b3CompoundData:
    version: ptr_uint
    byteCount: int
    nodeOffset: int
    tree: b3DynamicTree
    materialOffset: int
    materialCount: int
    capsuleOffset: int
    capsuleCount: int
    hullOffset: int
    hullCount: int
    sharedHullCount: int
    meshOffset: int
    meshCount: int
    sharedMeshCount: int
    sphereOffset: int
    sphereCount: int

struct b3CompoundCapsule:
    capsule: b3Capsule
    materialIndex: int

struct b3CompoundHull:
    hull: const_ptr[b3HullData]
    transform: b3Transform
    materialIndex: int

struct b3CompoundMesh:
    meshData: const_ptr[b3MeshData]
    transform: b3Transform
    scale: b3Vec3
    materialIndices: array[int, 4]

struct b3CompoundSphere:
    sphere: b3Sphere
    materialIndex: int

struct b3ChildShape:
    capsule: b3Capsule
    hull: const_ptr[b3HullData]
    mesh: b3Mesh
    sphere: b3Sphere
    transform: b3Transform
    materialIndices: array[int, 4]
    type: b3ShapeType

type b3CompoundQueryFcn = fn(arg0: const_ptr[b3CompoundData], arg1: int, arg2: ptr[void]) -> bool

struct b3ManifoldPoint:
    anchorA: b3Vec3
    anchorB: b3Vec3
    separation: float
    baseSeparation: float
    normalImpulse: float
    totalNormalImpulse: float
    normalVelocity: float
    featureId: uint
    triangleIndex: int
    persisted: bool

struct b3Manifold:
    points: array[b3ManifoldPoint, 4]
    normal: b3Vec3
    twistImpulse: float
    frictionImpulse: b3Vec3
    rollingImpulse: b3Vec3
    pointCount: int

enum b3SeparatingFeature: int
    b3_invalidAxis = 0
    b3_backsideAxis = 1
    b3_faceAxisA = 2
    b3_faceAxisB = 3
    b3_edgePairAxis = 4
    b3_closestPointsAxis = 5
    b3_manualFaceAxisA = 6
    b3_manualFaceAxisB = 7
    b3_manualEdgePairAxis = 8

enum b3TriangleFeature: int
    b3_featureNone = 0
    b3_featureTriangleFace = 1
    b3_featureHullFace = 2
    b3_featureEdge1 = 3
    b3_featureEdge2 = 4
    b3_featureEdge3 = 5
    b3_featureVertex1 = 6
    b3_featureVertex2 = 7
    b3_featureVertex3 = 8

struct b3SATCache:
    separation: float
    type: ubyte
    indexA: ubyte
    indexB: ubyte
    hit: ubyte

struct b3FeaturePair:
    owner1: ubyte
    index1: ubyte
    owner2: ubyte
    index2: ubyte

struct b3LocalManifoldPoint:
    point: b3Vec3
    separation: float
    pair: b3FeaturePair
    triangleIndex: int

struct b3LocalManifold:
    normal: b3Vec3
    triangleNormal: b3Vec3
    points: ptr[b3LocalManifoldPoint]
    pointCount: int
    triangleIndex: int
    i1: int
    i2: int
    i3: int
    squaredDistance: float
    feature: b3TriangleFeature
    triangleFlags: int

