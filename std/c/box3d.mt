enum b3RecQueryType: int
    b3_recQueryOverlapAABB = 0
    b3_recQueryOverlapShape = 1
    b3_recQueryCastRay = 2
    b3_recQueryCastShape = 3
    b3_recQueryCastRayClosest = 4
    b3_recQueryCastMover = 5
    b3_recQueryCollideMover = 6

