    type: b3RecQueryType
    filter: b3QueryFilter
    aabb: b3AABB
    origin: b3Vec3
    translation: b3Vec3
    hitCount: int
    key: ptr_uint
    id: ptr_uint
    name: cstr

struct b3RecQueryHit:
    shape: b3ShapeId
    point: b3Vec3
    normal: b3Vec3
    fraction: float

