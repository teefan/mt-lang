    b2_replayQueryOverlapAABB = 0
    b2_replayQueryOverlapShape = 1
    b2_replayQueryCastRay = 2
    b2_replayQueryCastShape = 3
    b2_replayQueryCollideMover = 4
    b2_replayQueryCastRayClosest = 5
    b2_replayQueryCastMover = 6

